msgstr "Sa flamme intérieure se meurt."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.FLOWER_EVIL
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.FLOWER_EVIL"
msgid "Ugh, that smells terrible."
msgstr "Pouah ! Quelle odeur épouvantable !"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.FLOWER_WITHERED
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.FLOWER_WITHERED"
msgid "Looks like good kindling."
msgstr "On dirait du bon petit bois."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.FOLIAGE
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.FOLIAGE"
msgid "Fuel for the fire."
msgstr "Combustible pour le feu."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.FOLIAGE_DRIED
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.FOLIAGE_DRIED"
msgid "Mmm... So dry. So flammable."
msgstr "Ooh... c'est tout sec. Et inflammable."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.FOOTBALLHAT
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.FOOTBALLHAT"
msgid "Sports are hard."
msgstr "Le sport c'est dur."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.FORGETMELOTS
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.FORGETMELOTS"
msgid "Some more dumb flowers."
msgstr "Encore des fleurs nulles."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.FORGETMELOTS_DRIED
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.FORGETMELOTS_DRIED"
msgid "Mmm... So dry. So flammable."
msgstr "Ooh... c'est tout sec. Et inflammable."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.FORMAL_BLUEPRINT
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.FORMAL_BLUEPRINT"
