msgstr "On peut désormais tous briller un peu plus."

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.ENDTABLE.GENERIC
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.ENDTABLE.GENERIC"
msgid "I miss table settings."
msgstr "L'argenterie me manque."

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.ENDTABLE.OLDLIGHT
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.ENDTABLE.OLDLIGHT"
msgid "It's looking pretty dim."
msgstr "C'est plutôt tamisé."

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.ENDTABLE.WILTED
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.ENDTABLE.WILTED"
msgid "I hope Maman Angeline is eating well without me."
msgstr "J'espère que maman Angeline mange bien, sans moi."

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.EVERGREEN.BURNING
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.EVERGREEN.BURNING"
