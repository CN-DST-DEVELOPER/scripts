msgstr "Oh non, c'est trop !"

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.WX78_SCANNER.GENERIC
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.WX78_SCANNER.GENERIC"
