#. STRINGS.SKIN_DESCRIPTIONS.boat_wagstaff
msgctxt "STRINGS.SKIN_DESCRIPTIONS.boat_wagstaff"
msgid "Why use wood when you can build a boat with sturdy, dependable metal?"
msgstr "Pourquoi utiliser du bois quand on peut construire un bateau avec du métal fiable et solide ?"

