#. STRINGS.CHARACTERS.WARLY.DESCRIBE.FUMAROLESHOVEL.GENERIC
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.FUMAROLESHOVEL.GENERIC"
msgid "It's beginning to crumble."
msgstr "Elle commence à s'effriter."

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.FUMAROLESHOVEL.HOT
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.FUMAROLESHOVEL.HOT"
msgid "It cuts through dirt like a hot knife through butter!"
msgstr "Elle coupe la terre comme un couteau dans le beurre !"

