msgid "Hey look, fancy kindling!"
msgstr "Hé, regardez, un allume-feu décoré !"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.BATWING
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.BATWING"
msgid "Yuck!"
msgstr "Beurk !"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.BATWING_COOKED
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.BATWING_COOKED"
msgid "Still yuck!"
msgstr "Toujours aussi dégueu !"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.BEARDHAIR
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.BEARDHAIR"
msgid "Clean up your gross hair guys! Ugh!"
msgstr "Nettoyez un peu vos sales poils, les gars ! Beurk !"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.BEARGER
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.BEARGER"
msgid "Whoa! Niiiice bear..."
msgstr "Waouh ! Bel ours..."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.BEARGERCORPSE.BURNING
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.BEARGERCORPSE.BURNING"
msgid "It's so relaxing to watch it burn."
msgstr "C'est vraiment relaxant de le regarder brûler."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.BEARGERCORPSE.GENERIC
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.BEARGERCORPSE.GENERIC"
msgid "I should burn it. Just in case."
msgstr "Je devrais y mettre le feu. Juste au cas où."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.BEARGERCORPSE.REVIVING
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.BEARGERCORPSE.REVIVING"
msgid "I knew I should've burnt it when I had the chance!!"
msgstr "Je savais que j'aurais dû y mettre le feu quand j'en avais l'occasion !"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.BEARGERFUR_SACK
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.BEARGERFUR_SACK"
msgid "Can't believe we made a cooler out of you."
msgstr "J'arrive pas à croire qu'on ait fait un frigo de toi."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.BEARGERVEST
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.BEARGERVEST"
msgid "It's like swimming in fur."
msgstr "C'est comme nager dans la fourrure."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.BEARGER_FUR
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.BEARGER_FUR"
msgid "It's fur all the way down."
msgstr "C'est cent pour cent fourrure."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.BEAST_BLUEPRINT
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.BEAST_BLUEPRINT"
msgid "My beefalo's already a lucky beast. He gets to be my friend!"
msgstr "Mon bœufalo a déjà beaucoup de chance. C'est mon pote !"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.BEDROLL_FURRY
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.BEDROLL_FURRY"
msgid "It's too frilly."
msgstr "C'est trop chichi ce truc-là."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.BEDROLL_STRAW
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.BEDROLL_STRAW"
msgid "Musty."
msgstr "Moisi."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.BEE.GENERIC
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.BEE.GENERIC"
msgid "It's fat, but that stinger looks dangerous."
msgstr "Elle est grosse, mais ce dard a l'air dangereux."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.BEE.HELD
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.BEE.HELD"
msgid "Pocket full of bees!"
msgstr "Une poche pleine d'abeilles !"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.BEEBOX.BURNT
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.BEEBOX.BURNT"
msgid "Smoked you out!"
msgstr "Bien enfumée là !"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.BEEBOX.FULLHONEY
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.BEEBOX.FULLHONEY"
msgid "Yay! Let's steal honey!"
msgstr "Ouais ! Allons voler du miel !"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.BEEBOX.GENERIC
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.BEEBOX.GENERIC"
msgid "Come on fat bees, make honey!"
msgstr "Allez les grosses abeilles, faites du miel !"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.BEEBOX.NOHONEY
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.BEEBOX.NOHONEY"
msgid "Nothing to see here."
msgstr "Y a rien à voir ici."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.BEEBOX.READY
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.BEEBOX.READY"
msgid "Yay! Let's steal honey!"
msgstr "Ouais ! Allons voler du miel !"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.BEEBOX.SOMEHONEY
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.BEEBOX.SOMEHONEY"
msgid "Patience."
msgstr "Patience."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.BEEBOX_HERMIT.BURNT
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.BEEBOX_HERMIT.BURNT"
msgid "Smoked you out!"
msgstr "Bien enfumée là !"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.BEEBOX_HERMIT.FULLHONEY
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.BEEBOX_HERMIT.FULLHONEY"
msgid "She won't be mad if I steal a liiiittle honey, right?"
msgstr "Si je vole un touuut petit peu de miel, elle ne m'en voudra pas, hein ?"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.BEEBOX_HERMIT.GENERIC
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.BEEBOX_HERMIT.GENERIC"
msgid "Wow, her bees are about as friendly as she is."
msgstr "Ouah, ses abeilles sont aussi sympa qu'elle."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.BEEBOX_HERMIT.NOHONEY
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.BEEBOX_HERMIT.NOHONEY"
msgid "Nothing to see here."
msgstr "Y a rien à voir ici."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.BEEBOX_HERMIT.READY
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.BEEBOX_HERMIT.READY"
msgid "She won't be mad if I steal a liiiittle honey, right?"
msgstr "Si je vole un touuut petit peu de miel, elle ne m'en voudra pas, hein ?"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.BEEBOX_HERMIT.SOMEHONEY
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.BEEBOX_HERMIT.SOMEHONEY"
msgid "Patience."
msgstr "Patience."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.BEEFALO.DEAD
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.BEEFALO.DEAD"
msgid "Come on, get up! What's the matter? Oh..."
msgstr "Allez, debout ! Qu'est-ce qui cloche avec toi ? Oh..."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.BEEFALO.DEAD_MYPARTNER
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.BEEFALO.DEAD_MYPARTNER"
msgid "Don't you die on me, you walking hamburger!"
msgstr "Ne meurs pas, espèce de hamburger sur pattes !"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.BEEFALO.DOMESTICATED
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.BEEFALO.DOMESTICATED"
msgid "It's lost the fire from its heart."
msgstr "Il a perdu la flamme."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.BEEFALO.FOLLOWER
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.BEEFALO.FOLLOWER"
msgid "Er, are you following me?"
msgstr "Euh... t'es en train de me suivre ?"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.BEEFALO.GENERIC
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.BEEFALO.GENERIC"
msgid "What a disgusting, hairy beast!"
msgstr "Quelle dégoûtante bête poilue !"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.BEEFALO.MYPARTNER
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.BEEFALO.MYPARTNER"
msgid "It may be a dumb stinky beast, but it's my dumb stinky beast!"
msgstr "C'est peut-être une bestiole stupide qui pue, mais c'est MA bestiole stupide qui pue !"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.BEEFALO.NAKED
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.BEEFALO.NAKED"
msgid "Ha! He's all naked now!"
msgstr "Ha ! Pour le coup il est vraiment à poil !"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.BEEFALO.ORNERY
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.BEEFALO.ORNERY"
msgid "I can see fire in its eyes."
msgstr "Je vois le feu dans ses yeux."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.BEEFALO.PUDGY
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.BEEFALO.PUDGY"
msgid "You need to burn some calories."
msgstr "Tu devrais brûler des calories."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.BEEFALO.RIDER
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.BEEFALO.RIDER"
msgid "Let's go!"
msgstr "C'est parti !"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.BEEFALO.SLEEPING
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.BEEFALO.SLEEPING"
msgid "They look even dumber when they're sleeping."
msgstr "Ils ont l'air encore plus bêtes quand ils dorment."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.BEEFALOFEED
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.BEEFALOFEED"
msgid "Alright smelly, eat up!"
msgstr "Allez, le puant ! Mange !"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.BEEFALOHAT
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.BEEFALOHAT"
msgid "Beast hair to go over people hair!"
msgstr "Les meilleurs poils à se coller sur la tête !"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.BEEFALOTREAT
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.BEEFALOTREAT"
msgid "Beefalo are pretty easy to please."
msgstr "Les bœufalos sont pas compliqués."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.BEEFALOWOOL
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.BEEFALOWOOL"
msgid "Ha! Its owner is probably naked somewhere. Or dead."
msgstr "Ha ! Son propriétaire est probablement à poil quelque part. Ou mort."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.BEEFALO_GROOMER.BURNT
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.BEEFALO_GROOMER.BURNT"
msgid "Heh, well that was fun."
msgstr "Hé hé, c'était marrant."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.BEEFALO_GROOMER.GENERIC
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.BEEFALO_GROOMER.GENERIC"
msgid "Come on beefalo, it's dress-up time!"
msgstr "Allez viens, le bœufalo. C'est l'heure de se déguiser !"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.BEEFALO_GROOMER.OCCUPIED
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.BEEFALO_GROOMER.OCCUPIED"
msgid "Honestly, anything I do will be an improvement."
msgstr "Quoi que je fasse, ça sera mieux que ça."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.BEEFALO_GROOMER_ITEM
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.BEEFALO_GROOMER_ITEM"
msgid "Uuuugh, why is everything so much work?"
msgstr "Raaaah, pourquoi tout est aussi compliquééé ?"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.BEEF_BELL
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.BEEF_BELL"
msgid "Wow, making friends is easy!"
msgstr "Ouah, c'est facile de se faire des potes !"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.BEEGUARD
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.BEEGUARD"
msgid "Puffy flying jerk!"
msgstr "Saleté bouffie qui vole !"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.BEEHAT
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.BEEHAT"
msgid "This will keep the pokeys off of me."
msgstr "Ça me protégera des bestioles qui piquent."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.BEEHIVE
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.BEEHIVE"
msgid "It's full of bees!"
msgstr "C'est plein d'abeilles !"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.BEEMINE
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.BEEMINE"
msgid "Bees inside. Should've put some fire in there for good measure."
msgstr "C'est plein d'abeilles. J'aurais dû y mettre le feu par sécurité."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.BEEMINE_MAXWELL
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.BEEMINE_MAXWELL"
msgid "Mosquitoes inside. They don't sound happy."
msgstr "Il y a des moustiques dedans. Ils n'ont pas l'air contents."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.BEEQUEEN
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.BEEQUEEN"
msgid "No amount of honey is worth THAT!"
msgstr "Même pour plein de miel ça ne vaut pas le coup !"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.BEEQUEENHIVE.GENERIC
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.BEEQUEENHIVE.GENERIC"
msgid "It all came from a bee's butt."
msgstr "Les abeilles font ça avec leurs fesses."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.BEEQUEENHIVE.GROWING
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.BEEQUEENHIVE.GROWING"
msgid "Ew, burn it before it gets any bigger!"
msgstr "Euh... brûle ça avant que ça ne grossisse !"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.BEEQUEENHIVEGROWN
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.BEEQUEENHIVEGROWN"
msgid "Dare you guys to smack it with a hammer."
msgstr "Qui va oser cogner ça à coups de marteau ?"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.BEESWAX
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.BEESWAX"
msgid "That's none of my beeswax."
msgstr "J'en ai rien à cirer."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.BEESWAX_SPRAY
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.BEESWAX_SPRAY"
msgid "The scariest part is how bad it smells."
msgstr "Le pire, c'est l'odeur."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.BEETLETAUR
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.BEETLETAUR"
msgid "Bet you think you're safe in all that armor."
msgstr "Je parie que tu te sens en sécurité avec cette armure."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.BELL
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.BELL"
msgid "Is it New Year's Eve? Are there FIREWORKS?!"
msgstr "C'est la Saint-Sylvestre ? Il y a un feu d'artifice ?"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.BERNIE_ACTIVE
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.BERNIE_ACTIVE"
msgid "Help me, Bernie!"
msgstr "Bernie, à l'aide !"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.BERNIE_BIG
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.BERNIE_BIG"
msgid "GET'EM, BERNIE!!"
msgstr "CHOPE-LES, BERNIE !"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.BERNIE_INACTIVE.BROKEN
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.BERNIE_INACTIVE.BROKEN"
msgid "I need to fix Bernie up."
msgstr "Je dois réparer Bernie."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.BERNIE_INACTIVE.GENERIC
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.BERNIE_INACTIVE.GENERIC"
msgid "My childhood buddy - Bernie!"
msgstr "Mon copain d'enfance ! Bernie !"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.BERRIES
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.BERRIES"
msgid "Red berries taste the best."
msgstr "Les baies rouges sont les meilleures."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.BERRIES_COOKED
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.BERRIES_COOKED"
msgid "Red berries with fire somehow taste even better."
msgstr "Les baies rouges passées au feu ont un peu meilleur goût."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.BERRIES_JUICY
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.BERRIES_JUICY"
msgid "Mmm. They pop in your mouth."
msgstr "Miam. Elles explosent en bouche."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.BERRIES_JUICY_COOKED
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.BERRIES_JUICY_COOKED"
msgid "Fire improves everything."
msgstr "Le feu améliore tout."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.BERRYBUSH.BARREN
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.BERRYBUSH.BARREN"
msgid "Eat poop, stupid plant!"
msgstr "Mange de la crotte, stupide plante !"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.BERRYBUSH.BURNING
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.BERRYBUSH.BURNING"
msgid "Yes!! Burn!!"
msgstr "Oui ! Brûle !"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.BERRYBUSH.DISEASED
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.BERRYBUSH.DISEASED"
msgid "Burn the sick!"
msgstr "Brûlez la maladie !"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.BERRYBUSH.DISEASING
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.BERRYBUSH.DISEASING"
msgid "Blech. You smell."
msgstr "Beurk ! Tu pues !"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.BERRYBUSH.GENERIC
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.BERRYBUSH.GENERIC"
msgid "Mmmmm. Berries."
msgstr "Mmmm... des baies."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.BERRYBUSH.PICKED
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.BERRYBUSH.PICKED"
msgid "But I want more berries!"
msgstr "Je veux plus de baies !"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.BERRYBUSH.WITHERED
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.BERRYBUSH.WITHERED"
msgid "All dried out. Primed for fire!"
msgstr "C'est tout sec. Parfait pour le feu."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.BERRYBUSH_JUICY.BARREN
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.BERRYBUSH_JUICY.BARREN"
msgid "Did I say you could stop growing?!"
msgstr "Est-ce que j'ai dit que tu avais le droit d'arrêter de pousser ?"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.BERRYBUSH_JUICY.BURNING
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.BERRYBUSH_JUICY.BURNING"
msgid "Yes!! Burn!!"
msgstr "Oui ! Brûle !"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.BERRYBUSH_JUICY.DISEASED
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.BERRYBUSH_JUICY.DISEASED"
msgid "Burn the sick!"
msgstr "Brûlez la maladie !"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.BERRYBUSH_JUICY.DISEASING
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.BERRYBUSH_JUICY.DISEASING"
msgid "Blech. You smell."
msgstr "Beurk ! Tu pues !"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.BERRYBUSH_JUICY.GENERIC
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.BERRYBUSH_JUICY.GENERIC"
msgid "Ready for picking!"
msgstr "Prêt pour la cueillette !"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.BERRYBUSH_JUICY.PICKED
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.BERRYBUSH_JUICY.PICKED"
msgid "Make mooooore!"
msgstr "Fais-en plus !"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.BERRYBUSH_JUICY.WITHERED
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.BERRYBUSH_JUICY.WITHERED"
msgid "It's burning up."
msgstr "Ça brûle."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.BERRYSAUCE
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.BERRYSAUCE"
msgid "This is the best part!"
msgstr "C'est ce qu'il y a de meilleur !"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.BIBINGKA
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.BIBINGKA"
msgid "Mmm, I can still smell the fire."
msgstr "Mmh, ça sent encore le feu."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.BIGFOOT
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.BIGFOOT"
msgid "What in the world!"
msgstr "Mais d'où ça sort ça ?"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.BIRCHNUTDRAKE
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.BIRCHNUTDRAKE"
msgid "Aaah! Set it on fire!"
msgstr "Aaah ! Allumez-moi ça !"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.BIRDCAGE.DEAD
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.BIRDCAGE.DEAD"
msgid "At least he's quiet now."
msgstr "Au moins il est plus calme maintenant."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.BIRDCAGE.GENERIC
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.BIRDCAGE.GENERIC"
msgid "Bird prison!"
msgstr "Une prison pour oiseau !"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.BIRDCAGE.HUNGRY
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.BIRDCAGE.HUNGRY"
msgid "What's all the fuss about?"
msgstr "C'est quoi le problème ?"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.BIRDCAGE.OCCUPIED
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.BIRDCAGE.OCCUPIED"
msgid "Ha! Gotcha now!"
msgstr "Ha ! Je t'ai bien eu !"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.BIRDCAGE.SKELETON
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.BIRDCAGE.SKELETON"
msgid "That should probably be cleaned up."
msgstr "Il faudrait sans doute nettoyer ça."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.BIRDCAGE.SLEEPING
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.BIRDCAGE.SLEEPING"
msgid "Stupid bird. Wake up!"
msgstr "Stupide oiseau. Réveille-toi !"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.BIRDCAGE.STARVING
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.BIRDCAGE.STARVING"
msgid "He won't be quiet!"
msgstr "Il ne la fermera donc jamais !"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.BIRDCORPSE.BURNING
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.BIRDCORPSE.BURNING"
msgid "Burn, birdie, burn."
msgstr "Brûle, piou-piou, brûle."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.BIRDCORPSE.GENERIC
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.BIRDCORPSE.GENERIC"
msgid "Shall I do the honors?"
msgstr "À moi l'honneur ?"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.BIRDCORPSE.REVIVING
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.BIRDCORPSE.REVIVING"
msgid "Do I even have to say it?"
msgstr "Est-ce j'ai besoin de le dire ?"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.BIRDTRAP
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.BIRDTRAP"
msgid "Gonna catch those creepy birds."
msgstr "Je vais attraper ces satanés oiseaux."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.BIRD_EGG
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.BIRD_EGG"
msgid "It smells like a bird's butt."
msgstr "Ça sent comme le croupion d'un oiseau."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.BIRD_EGG_COOKED
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.BIRD_EGG_COOKED"
msgid "Yuck. The yellow part is all runny."
msgstr "Beurk ! La partie jaune est toute liquide."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.BIRD_MUTANT
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.BIRD_MUTANT"
msgid "It looks like it wants to take a bite out of me."
msgstr "J'ai l'impression qu'il veut me croquer."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.BIRD_MUTANT_SPITTER
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.BIRD_MUTANT_SPITTER"
msgid "Oh yeah?! Two can play at that game... PTOOEY!"
msgstr "Ah ouais ? On peut être deux à ce jeu-là !! RAH-PTEUH !"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.BISHOP
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.BISHOP"
msgid "It's a bishop!"
msgstr "C'est un évêque !"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.BISHOP_CHARGE_HIT
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.BISHOP_CHARGE_HIT"
msgid "Owwww!"
msgstr "Ouille !"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.BISHOP_NIGHTMARE
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.BISHOP_NIGHTMARE"
msgid "Ahhh!"
msgstr "Ahhh !"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.BLACKFLAG
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.BLACKFLAG"
msgid "Looks like it's already charred."
msgstr "On dirait qu'il est déjà carbonisé."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.BLOWDART_FIRE
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.BLOWDART_FIRE"
msgid "That's my favorite thing in the whole wide world."
msgstr "C'est le truc que je préfère au monde."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.BLOWDART_LAVA
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.BLOWDART_LAVA"
msgid "Ptoo! Now you're dead!"
msgstr "Pfut ! T'es mort !"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.BLOWDART_LAVA2
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.BLOWDART_LAVA2"
msgid "Ooh, the firepower!"
msgstr "Oh, quelle puissance de feu !"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.BLOWDART_PIPE
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.BLOWDART_PIPE"
msgid "Good practice for blowing into a fire."
msgstr "Un bon entraînement pour souffler sur les braises."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.BLOWDART_SLEEP
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.BLOWDART_SLEEP"
msgid "Tranquilized things are easier to light on fire."
msgstr "Une fois tranquillisées, les choses prennent feu plus facilement."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.BLOWDART_YELLOW
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.BLOWDART_YELLOW"
msgid "Lightning is sort of like fire."
msgstr "La foudre c'est un peu comme le feu."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.BLUEAMULET
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.BLUEAMULET"
msgid "Boo to this."
msgstr "Hors de ma vue !"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.BLUEGEM
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.BLUEGEM"
msgid "Ugh. This one is ugly."
msgstr "Beurk ! Celle-là est horrible."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.BLUEMOONEYE
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.BLUEMOONEYE"
msgid "That's not an eyeball! It's a rock!"
msgstr "C'est pas un globe oculaire ! C'est une pierre !"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.BLUEPRINT.COMMON
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.BLUEPRINT.COMMON"
msgid "This will save some experimentation."
msgstr "Ça m'épargnera des expérimentations."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.BLUEPRINT.RARE
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.BLUEPRINT.RARE"
msgid "Woah. It doesn't burn!!"
msgstr "Waouh ! Ça ne brûle pas !"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.BLUE_CAP
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.BLUE_CAP"
msgid "It smells like a gym sock!"
msgstr "Ça sent la chaussette de sport !"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.BLUE_CAP_COOKED
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.BLUE_CAP_COOKED"
msgid "Transformed by fire!"
msgstr "Transformé par le feu !"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.BLUE_MUSHROOM.GENERIC
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.BLUE_MUSHROOM.GENERIC"
msgid "Dumb mushroom."
msgstr "Crétin de champignon."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.BLUE_MUSHROOM.INGROUND
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.BLUE_MUSHROOM.INGROUND"
msgid "Hey! You! Get up here!"
msgstr "Hé ! Toi ! Sors de là !"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.BLUE_MUSHROOM.PICKED
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.BLUE_MUSHROOM.PICKED"
msgid "Maybe it will return some day."
msgstr "Il repoussera peut-être un jour."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.BOARDS
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.BOARDS"
msgid "Boards. They'll burn, same as other wood."
msgstr "Des planches. Ça brûle comme n'importe quel bois."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.BOARON
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.BOARON"
msgid "Keep that snout to yourself!"
msgstr "Vilain museau !"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.BOARRIOR
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.BOARRIOR"
msgid "He looks pretty haggard."
msgstr "Il a la mine défaite."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.BOATFRAGMENT03
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.BOATFRAGMENT03"
msgid "Welp, there goes that."
msgstr "Bon bah. C'est déjà ça."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.BOATFRAGMENT04
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.BOATFRAGMENT04"
msgid "Welp, there goes that."
msgstr "Bon bah. C'est déjà ça."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.BOATFRAGMENT05
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.BOATFRAGMENT05"
msgid "Welp, there goes that."
msgstr "Bon bah. C'est déjà ça."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.BOATPATCH
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.BOATPATCH"
msgid "Fixing stuff is boring, but necessary."
msgstr "Réparer des trucs, c'est ennuyeux, mais nécessaire."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.BOATPATCH_KELP
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.BOATPATCH_KELP"
msgid "At least it'll keep the water out for a bit."
msgstr "Au moins, ça nous protégera de l'eau pendant un moment."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.BOATRACE_CHECKPOINT
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.BOATRACE_CHECKPOINT"
msgid "Yup. That's a checkpoint."
msgstr "Ouais. C'est un point de contrôle."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.BOATRACE_CHECKPOINT_THROWABLE_DEPLOYKIT
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.BOATRACE_CHECKPOINT_THROWABLE_DEPLOYKIT"
msgid "Does this thing even float?"
msgstr "Est-ce que ça flotte, au moins ?"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.BOATRACE_PRIMEMATE
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.BOATRACE_PRIMEMATE"
msgid "That thing better not cheat."
msgstr "Il a pas intérêt à tricher."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.BOATRACE_SEASTACK
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.BOATRACE_SEASTACK"
msgid "Don't you dare hit my boat!"
msgstr "Je t'interdis de heurter mon bateau !"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.BOATRACE_SEASTACK_MONKEY
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.BOATRACE_SEASTACK_MONKEY"
msgid "Don't you dare hit my boat!"
msgstr "Je t'interdis de heurter mon bateau !"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.BOATRACE_SEASTACK_MONKEY_THROWABLE_DEPLOYKIT
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.BOATRACE_SEASTACK_MONKEY_THROWABLE_DEPLOYKIT"
msgid "Maybe I could have some fun with this..."
msgstr "Je pourrais peut-être m'amuser un peu..."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.BOATRACE_SEASTACK_THROWABLE_DEPLOYKIT
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.BOATRACE_SEASTACK_THROWABLE_DEPLOYKIT"
msgid "Maybe I could have some fun with this..."
msgstr "Je pourrais peut-être m'amuser un peu..."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.BOATRACE_SPECTATOR_DRAGONLING
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.BOATRACE_SPECTATOR_DRAGONLING"
msgid "Alright little guy, ready to watch me win?"
msgstr "Alors mon pote, t'es prêt à me voir gagner ?"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.BOATRACE_START
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.BOATRACE_START"
msgid "Let's just get this over with."
msgstr "Finissons-en."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.BOATRACE_START_THROWABLE_DEPLOYKIT
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.BOATRACE_START_THROWABLE_DEPLOYKIT"
msgid "Does it HAVE to go in the water?"
msgstr "Est-ce que ça doit VRAIMENT aller dans l'eau ?"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.BOAT_ANCIENT_CONTAINER
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.BOAT_ANCIENT_CONTAINER"
msgid "I hope all my stuff stays dry in there."
msgstr "J'espère que tout restera au sec là-dedans."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.BOAT_ANCIENT_ITEM
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.BOAT_ANCIENT_ITEM"
msgid "Ew, it smells old!"
msgstr "Beurk, ça pue !"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.BOAT_BUMPER_CRABKING
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.BOAT_BUMPER_CRABKING"
msgid "Sturdy. Let's ram something."
msgstr "C'est solide. On peut foncer dans un truc."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.BOAT_BUMPER_CRABKING_KIT
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.BOAT_BUMPER_CRABKING_KIT"
msgid "I guess building some bumpers is better than sinking."
msgstr "Faire des amortisseurs, c'est toujours mieux que couler."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.BOAT_BUMPER_KELP
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.BOAT_BUMPER_KELP"
msgid "Ewww, it's slimy!"
msgstr "Beeeeerk, c'est gluant !"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.BOAT_BUMPER_KELP_KIT
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.BOAT_BUMPER_KELP_KIT"
msgid "I guess building some bumpers is better than sinking."
msgstr "Faire des amortisseurs, c'est toujours mieux que couler."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.BOAT_BUMPER_SHELL
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.BOAT_BUMPER_SHELL"
msgid "Uh-huh, nothing sturdier than seashells."
msgstr "C'est bien connu, il y a rien de plus solide que des coquillages."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.BOAT_BUMPER_SHELL_KIT
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.BOAT_BUMPER_SHELL_KIT"
msgid "I guess building some bumpers is better than sinking."
msgstr "Faire des amortisseurs, c'est toujours mieux que couler."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.BOAT_BUMPER_YOTD
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.BOAT_BUMPER_YOTD"
msgid "Alright, a boat with teeth is kinda cool."
msgstr "D'accord, un bateau avec des dents, c'est plutôt cool."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.BOAT_BUMPER_YOTD_KIT
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.BOAT_BUMPER_YOTD_KIT"
msgid "I guess building some bumpers is better than sinking."
msgstr "Faire des amortisseurs, c'est toujours mieux que couler."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.BOAT_CANNON.AMMOLOADED
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.BOAT_CANNON.AMMOLOADED"
msgid "The only fun part of sailing is getting to fire the cannon."
msgstr "Le seul truc marrant sur un bateau, c'est de tirer au canon."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.BOAT_CANNON.GENERIC
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.BOAT_CANNON.GENERIC"
msgid "It isn't loaded? Booooring."
msgstr "C'est pas chargé ? C'est nuuuuuul."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.BOAT_CANNON.NOAMMO
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.BOAT_CANNON.NOAMMO"
msgid "Darn it, I'm out... hey Wes, you always wanted to try being a human cannonball right?"
msgstr "Rah zut, je suis à sec... Hé, Wes, tu as toujours voulu tenter de faire le numéro du boulet humain, pas vrai ?"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.BOAT_CANNON_KIT
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.BOAT_CANNON_KIT"
msgid "If I build it, I get to fire it."
msgstr "Si je le fabrique, c'est moi qui tire avec."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.BOAT_GRASS_ITEM
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.BOAT_GRASS_ITEM"
msgid "But it won't be as flammable if I put it in the water!"
msgstr "Mais ce sera plus aussi inflammable si je le mets dans l'eau !"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.BOAT_ITEM
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.BOAT_ITEM"
msgid "That's the boat part of the boat."
msgstr "C'est la partie « bateau » du bateau."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.BOAT_LEAK
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.BOAT_LEAK"
msgid "I only know how to solve fire-based problems."
msgstr "Je ne sais résoudre que les problèmes de feu, moi."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.BOAT_MAGNET.ACTIVATED
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.BOAT_MAGNET.ACTIVATED"
msgid "Okay fiiiiine, I guess it works alright."
msgstr "Boooon, d'accoooord, ça a l'air de marcher."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.BOAT_MAGNET.GENERIC
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.BOAT_MAGNET.GENERIC"
msgid "Great, now I've got a big dumb magnet."
msgstr "Super, j'ai un gros aimant nul, maintenant."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.BOAT_MAGNET_BEACON.ACTIVATED
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.BOAT_MAGNET_BEACON.ACTIVATED"
msgid "I guess that means it's working."
msgstr "Bon, j'imagine que ça veut dire que ça fonctionne."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.BOAT_MAGNET_BEACON.GENERIC
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.BOAT_MAGNET_BEACON.GENERIC"
msgid "Great, now I've got a little dumb magnet."
msgstr "Super, j'ai un petit aimant nul, maintenant."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.BOAT_MAGNET_KIT
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.BOAT_MAGNET_KIT"
msgid "Wilson! How am I supposed to put all this junk together?!"
msgstr "Wilson ! Comment je suis censée fabriquer ce truc ?!"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.BOAT_ROTATOR
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.BOAT_ROTATOR"
msgid "Hehehe, let's see how fast we can spin without getting sick!"
msgstr "Hé hé hé... On va voir qui sera malade en premier quand ça tournera !"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.BOAT_ROTATOR_KIT
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.BOAT_ROTATOR_KIT"
msgid "Fiiiine, I'll put the stupid rudder on the stupid boat."
msgstr "D'accooooord, je vais mettre ce gouvernail tout naze sur le bateau tout naze."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.BODYPILLOW_BEEFALOWOOL
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.BODYPILLOW_BEEFALOWOOL"
msgid "Bernie's cuddlier than a hairy old pillow."
msgstr "Bernie est plus agréable qu'un vieux coussin qui pue."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.BODYPILLOW_KELP
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.BODYPILLOW_KELP"
msgid "Ew, this pillow's full of wet junk!"
msgstr "Eurk, cet oreiller est tout humide !"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.BODYPILLOW_PETALS
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.BODYPILLOW_PETALS"
msgid "I guess that's one use for flowers."
msgstr "C'est une utilisation de fleurs comme une autre."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.BODYPILLOW_STEELWOOL
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.BODYPILLOW_STEELWOOL"
msgid "Pretty sure this is the worst pillow ever."
msgstr "Alors ça, c'est le pire oreiller du monde."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.BOMB_LUNARPLANT
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.BOMB_LUNARPLANT"
msgid "Heh. Think fast!"
msgstr "Hé, attrape !"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.BOMB_LUNARPLANT_WORMWOOD
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.BOMB_LUNARPLANT_WORMWOOD"
msgid "Wormwood must've been messing around with that one."
msgstr "Wormwood a dû s'adonner à de petites expériences ici."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.BONESHARD
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.BONESHARD"
msgid "I don't think they make good tinder."
msgstr "Je crois pas que ça fasse du bon petit bois."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.BONESOUP
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.BONESOUP"
msgid "I would practically INHALE that!"
msgstr "Je pourrais l'aspirer à la paille, quoi !!"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.BONESTEW
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.BONESTEW"
msgid "Just add fire to food and voila!"
msgstr "Il suffit d'ajouter du feu en cuisine, et le tour est joué !"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.BOOKSTATION.BURNT
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.BOOKSTATION.BURNT"
msgid "What's burned is burned, no point thinking about it too much, right?"
msgstr "C'est brûlé, c'est brûlé, pas la peine d'en faire tout un foin."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.BOOKSTATION.GENERIC
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.BOOKSTATION.GENERIC"
msgid "Hey, uh... what library did Ms. Wickerbottom work at, anyway?"
msgstr "Hé, euh... Dans quelle bibliothèque elle bossait, Mme Wickerbottom ?"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.BOOK_BEES
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.BOOK_BEES"
msgid "\"Rule one: don't set beehives on fire\"? This book's stupid!"
msgstr "« Règle n°1 : ne pas mettre le feu aux ruches » ? Mais c'est nul !"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.BOOK_BIRDS
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.BOOK_BIRDS"
msgid "Less reading, more burning!"
msgstr "Moins de lecture, plus de brûlures !"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.BOOK_BRIMSTONE
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.BOOK_BRIMSTONE"
msgid "That's my favorite book!"
msgstr "C'est mon livre préféré !"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.BOOK_ELEMENTAL
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.BOOK_ELEMENTAL"
msgid "Looks interesting, for a book."
msgstr "Ça a l'air intéressant, pour un livre."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.BOOK_FIRE
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.BOOK_FIRE"
msgid "You see something, you set it on fire. I don't need a book to teach me that!"
msgstr "Si ça peut brûler, mettez-y le feu. Pas besoin d'un bouquin pour savoir ça !"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.BOOK_FISH
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.BOOK_FISH"
msgid "The only thing more boring than fishing is reading about fishing."
msgstr "Le seul truc plus ennuyeux que la pêche, c'est lire un bouquin sur la pêche."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.BOOK_FOSSIL
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.BOOK_FOSSIL"
msgid "Looks like kindling to me."
msgstr "Pour moi, c'est du bois d'allumage !"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.BOOK_GARDENING
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.BOOK_GARDENING"
msgid "Ughh, who cares?"
msgstr "Pouah ! Et alors ?"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.BOOK_HORTICULTURE
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.BOOK_HORTICULTURE"
msgid "Ughh, who cares?"
msgstr "Pouah ! Et alors ?"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.BOOK_HORTICULTURE_UPGRADED
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.BOOK_HORTICULTURE_UPGRADED"
msgid "Nice and thick, that should burn for a good while."
msgstr "Il est plutôt épais... Ça devrait brûler un petit moment."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.BOOK_LIGHT
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.BOOK_LIGHT"
msgid "Wow, another book I'll never read!"
msgstr "Ouah, encore un livre que je lirai jamais !"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.BOOK_LIGHT_UPGRADED
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.BOOK_LIGHT_UPGRADED"
msgid "Stop trying to get me to read!"
msgstr "Arrêtez d'essayer de me faire lire !"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.BOOK_MOON
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.BOOK_MOON"
msgid "Another dumb book about whatever."
msgstr "Encore un bouquin débile sur on s'en fiche."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.BOOK_RAIN
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.BOOK_RAIN"
msgid "Ugh, I hate rain!"
msgstr "Argh, je déteste la pluie !"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.BOOK_RESEARCH_STATION
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.BOOK_RESEARCH_STATION"
msgid "How would everything even fit in there?"
msgstr "Comment tout rentre là-dedans ?"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.BOOK_SILVICULTURE
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.BOOK_SILVICULTURE"
msgid "Hey, it's a book about kindling!"
msgstr "Hé, c'est un livre sur des trucs qui brûlent !"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.BOOK_SLEEP
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.BOOK_SLEEP"
msgid "Bo-oring!"
msgstr "Quel ennui !"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.BOOK_TEMPERATURE
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.BOOK_TEMPERATURE"
msgid "Yaaaawwwn."
msgstr "Pffffff..."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.BOOK_TENTACLES
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.BOOK_TENTACLES"
msgid "Looks like kindling to me!"
msgstr "Pour moi, c'est du bois d'allumage !"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.BOOK_WEB
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.BOOK_WEB"
msgid "Ew, who wants to read a book about spiders?"
msgstr "Eurk, mais qui a envie de lire un livre sur les araignées ?"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.BOOMERANG
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.BOOMERANG"
msgid "It's not the most exciting weapon."
msgstr "Pas la plus excitante des armes."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.BOOTLEG
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.BOOTLEG"
msgid "Ugh, it smells like old feet!"
msgstr "Beurk, ça sent les pieds !"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.BROKEN_FORGEDITEM
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.BROKEN_FORGEDITEM"
msgid "Welp, looks like it's busted."
msgstr "Bon, ça a l'air cassé."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.BROKEN_FUMAROLETOOLITEM
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.BROKEN_FUMAROLETOOLITEM"
msgid "Some fire should fix it. Fire fixes everything!"
msgstr "Le feu devrait le réparer. Le feu répare tout !"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.BRUSH
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.BRUSH"
msgid "It smells like burnt hair."
msgstr "Ça sent le poil brûlé."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.BUGNET
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.BUGNET"
msgid "Doesn't fit over Webber's big head."
msgstr "Trop petit pour la grosse tête de Webber."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.BULLKELP_PLANT.GENERIC
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.BULLKELP_PLANT.GENERIC"
msgid "I bet we could eat that."
msgstr "Je parie que ça se mange."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.BULLKELP_PLANT.PICKED
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.BULLKELP_PLANT.PICKED"
msgid "Nothing left to take."
msgstr "Il n'y a plus rien là-dessus."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.BULLKELP_ROOT
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.BULLKELP_ROOT"
msgid "Haha! This thing's great."
msgstr "Ha ha ! C'est trop bien !"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.BUNDLE
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.BUNDLE"
msgid "Now I can burn a bunch of things in one go!"
msgstr "Maintenant je peux brûler plusieurs choses en un coup !"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.BUNDLEWRAP
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.BUNDLEWRAP"
msgid "We could hide some gross things, I guess."
msgstr "J'imagine qu'on pourrait cacher des trucs moches."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.BUNNYMAN
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.BUNNYMAN"
msgid "Ugh. They look so stupid."
msgstr "Pouah ! Ils ont l'air stupide."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.BUNNYSTEW
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.BUNNYSTEW"
msgid "It warms from the inside out."
msgstr "Ça réchauffe de l'intérieur."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.BURNT_MARSH_BUSH
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.BURNT_MARSH_BUSH"
msgid "That burned way too quickly."
msgstr "Ça a brûlé beaucoup trop vite."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.BUSHHAT
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.BUSHHAT"
msgid "Too passive!"
msgstr "Trop passif !"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.BUTTER
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.BUTTER"
msgid "Tasty, and just a little bit insecty."
msgstr "Pas mauvais, mais il y a comme un petit goût d'insecte."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.BUTTERFLY.GENERIC
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.BUTTERFLY.GENERIC"
msgid "Flutter away, butterfly!"
msgstr "Va voler ailleurs, papillon !"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.BUTTERFLY.HELD
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.BUTTERFLY.HELD"
msgid "I want to squish it."
msgstr "J'ai envie de l'écrabouiller."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.BUTTERFLYMUFFIN
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.BUTTERFLYMUFFIN"
msgid "Heehee, look at that butterfly stuck in the muffin."
msgstr "Hi hi ! On dirait que le papillon s'est encastré dans le muffin."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.BUTTERFLYWINGS
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.BUTTERFLYWINGS"
msgid "No more flying for that butterfly!"
msgstr "Ce papillon ne volera plus !"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.BUZZARD
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.BUZZARD"
msgid "Your neck is gross."
msgstr "Pas jojo le cou."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.BUZZARDCORPSE.BURNING
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.BUZZARDCORPSE.BURNING"
msgid "Burn, buzzard, burn."
msgstr "Brûle, vautour, brûle."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.BUZZARDCORPSE.GENERIC
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.BUZZARDCORPSE.GENERIC"
msgid "Shall I do the honors?"
msgstr "À moi l'honneur ?"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.BUZZARDCORPSE.REVIVING
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.BUZZARDCORPSE.REVIVING"
msgid "Do I even have to say it?"
msgstr "Est-ce j'ai besoin de le dire ?"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.CABBAGEROLLS
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.CABBAGEROLLS"
msgid "Yeah, I can roll with these."
msgstr "Ouais, c'est plutôt sympa."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.CACTUS.GENERIC
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.CACTUS.GENERIC"
msgid "Spines! My weakness! How did you know?"
msgstr "Des épines ! Mon point faible ! Comment il a deviné ?"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.CACTUS.PICKED
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.CACTUS.PICKED"
msgid "We'll call it a tie."
msgstr "On dira que ça fait match nul."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.CACTUS_FLOWER
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.CACTUS_FLOWER"
msgid "Yet another flower."
msgstr "Encore une fleur."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.CACTUS_MEAT
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.CACTUS_MEAT"
msgid "It still looks dangerous."
msgstr "Ça a encore l'air dangereux."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.CACTUS_MEAT_COOKED
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.CACTUS_MEAT_COOKED"
msgid "It seems fine now."
msgstr "Ça devrait le faire maintenant."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.CALIFORNIAROLL
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.CALIFORNIAROLL"
msgid "Oh, goody. Fish rolled in seaweed."
msgstr "Oh, mon Dieu ! Du poisson roulé dans des algues."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.CAMPFIRE.EMBERS
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.CAMPFIRE.EMBERS"
msgid "Uh oh. It's almost gone!"
msgstr "Oh oh... presque éteint !"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.CAMPFIRE.GENERIC
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.CAMPFIRE.GENERIC"
msgid "I like fire."
msgstr "J'aime le feu."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.CAMPFIRE.HIGH
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.CAMPFIRE.HIGH"
msgid "BURN! BURN FASTER!"
msgstr "Brûle, brûle ! Plus vite !"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.CAMPFIRE.LOW
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.CAMPFIRE.LOW"
msgid "This fire is small and boring."
msgstr "Un petit feu pas folichon."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.CAMPFIRE.NORMAL
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.CAMPFIRE.NORMAL"
msgid "Burn!"
msgstr "Brûle !"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.CAMPFIRE.OUT
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.CAMPFIRE.OUT"
msgid "Awww. It's all over."
msgstr "Oh... c'est terminé."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.CANARY.GENERIC
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.CANARY.GENERIC"
msgid "If it kicks the bucket I'm outta here."
msgstr "S'il casse sa pipe, je m'en vais."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.CANARY.HELD
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.CANARY.HELD"
msgid "You still breathing? Just checking."
msgstr "Tu respires encore ? C'est juste pour vérifier..."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.CANARY_POISONED
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.CANARY_POISONED"
msgid "Is that infectious? We should burn it."
msgstr "Est-ce que c'est contagieux ? On devrait le brûler."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.CANDYBAG
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.CANDYBAG"
msgid "I'm gonna stuff so much candy in there!"
msgstr "Je vais pouvoir mettre plein de bonbons là-dedans !"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.CANE
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.CANE"
msgid "It's way easier to cover ground with this!"
msgstr "On couvre bien plus de chemin avec ça !"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.CANNONBALL_ROCK_ITEM
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.CANNONBALL_ROCK_ITEM"
msgid "Okay, but I still think fireballs would be better."
msgstr "Bon, d'accord, mais des boules de feu, ce serait carrément plus stylé."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.CARNIVALCANNON.COOLDOWN
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.CARNIVALCANNON.COOLDOWN"
msgid "I only wish it had a more fiery explosion."
msgstr "Si seulement ça explosait davantage."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.CARNIVALCANNON.GENERIC
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.CARNIVALCANNON.GENERIC"
msgid "Let's liven things up a bit!"
msgstr "On va mettre un peu d'ambiance !"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.CARNIVALCANNON_KIT
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.CARNIVALCANNON_KIT"
msgid "Hehehe, this will be fun."
msgstr "Hé hé hé, ça va être marrant."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.CARNIVALDECOR_BANNER
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.CARNIVALDECOR_BANNER"
msgid "Oh yeah, that'll catch the firelight nicely!"
msgstr "Ah ouais, ça prendrait bien feu, ça !"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.CARNIVALDECOR_BANNER_KIT
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.CARNIVALDECOR_BANNER_KIT"
msgid "Can somebody else put it together for me?"
msgstr "Quelqu'un d'autre peut le fabriquer pour moi ?"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.CARNIVALDECOR_EGGRIDE
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.CARNIVALDECOR_EGGRIDE"
msgid "Can you imagine how great that would look if it was on fire?"
msgstr "Comment ce serait encore mieux si c'était en feu !"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.CARNIVALDECOR_EGGRIDE_KIT
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.CARNIVALDECOR_EGGRIDE_KIT"
msgid "Can somebody else put it together for me?"
msgstr "Quelqu'un d'autre peut le fabriquer pour moi ?"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.CARNIVALDECOR_FIGURE.GENERIC
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.CARNIVALDECOR_FIGURE.GENERIC"
msgid "Aww, it's so cute and flammable!"
msgstr "Oooh, c'est trop mignon... et inflammable."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.CARNIVALDECOR_FIGURE.RARE
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.CARNIVALDECOR_FIGURE.RARE"
msgid "Wow, a rare one! I bet it'll burn even better!"
msgstr "Ouah, une rare ! Je parie qu'elle brûlera encore mieux !"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.CARNIVALDECOR_FIGURE.UNCOMMON
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.CARNIVALDECOR_FIGURE.UNCOMMON"
msgid "If I gather enough of these I could make a pretty good bonfire."
msgstr "Si j'en obtiens assez, je pourrais faire un super feu de joie."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.CARNIVALDECOR_FIGURE_KIT
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.CARNIVALDECOR_FIGURE_KIT"
msgid "Ooooh what's in the box?"
msgstr "Ooooh, y'a quoi dans la boîte ?"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.CARNIVALDECOR_FIGURE_KIT_SEASON2
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.CARNIVALDECOR_FIGURE_KIT_SEASON2"
msgid "Ooooh what's in the box?"
msgstr "Ooooh, y'a quoi dans la boîte ?"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.CARNIVALDECOR_LAMP
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.CARNIVALDECOR_LAMP"
msgid "It makes light, but no fire. Creepy."
msgstr "Ça fait de la lumière, mais pas de feu. Trop flippant."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.CARNIVALDECOR_LAMP_KIT
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.CARNIVALDECOR_LAMP_KIT"
msgid "Can somebody else put it together for me?"
msgstr "Quelqu'un d'autre peut le fabriquer pour moi ?"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.CARNIVALDECOR_PLANT
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.CARNIVALDECOR_PLANT"
msgid "Guess this tree never got its growth spurt."
msgstr "J'imagine que cet arbre n'a jamais eu de poussée de croissance."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.CARNIVALDECOR_PLANT_KIT
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.CARNIVALDECOR_PLANT_KIT"
msgid "Can somebody else put it together for me?"
msgstr "Quelqu'un d'autre peut le fabriquer pour moi ?"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.CARNIVALFOOD_CORNTEA
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.CARNIVALFOOD_CORNTEA"
msgid "It keeps getting stuck in my teeth."
msgstr "Ça arrête pas de se coincer entre mes dents."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.CARNIVALGAME_FEEDCHICKS_FOOD
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.CARNIVALGAME_FEEDCHICKS_FOOD"
msgid "They're fake worms, but I could use them to set a real fire!"
msgstr "Ce sont des faux vers, mais je pourrais les utiliser pour faire un vrai feu !"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.CARNIVALGAME_FEEDCHICKS_KIT
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.CARNIVALGAME_FEEDCHICKS_KIT"
msgid "Aw come on, I've got to set it up myself?"
msgstr "Oh, allez... Il faut vraiment que je fasse tout toute seule ?"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.CARNIVALGAME_FEEDCHICKS_NEST
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.CARNIVALGAME_FEEDCHICKS_NEST"
msgid "A little door to nowhere special."
msgstr "Une petite porte qui mène nulle part."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.CARNIVALGAME_FEEDCHICKS_STATION.GENERIC
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.CARNIVALGAME_FEEDCHICKS_STATION.GENERIC"
msgid "I've uh... never actually been to a carnival before. Do I give it something?"
msgstr "Je, euh... J'étais jamais allée à un carnaval. Je dois lui donner quelque chose ?"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.CARNIVALGAME_FEEDCHICKS_STATION.PLAYING
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.CARNIVALGAME_FEEDCHICKS_STATION.PLAYING"
msgid "Heh. This actually looks kinda fun."
msgstr "Hé, ça a l'air marrant, finalement."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.CARNIVALGAME_HERDING_CHICK
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.CARNIVALGAME_HERDING_CHICK"
msgid "Hey! Get back here!"
msgstr "Hé, reviens ici !"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.CARNIVALGAME_HERDING_KIT
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.CARNIVALGAME_HERDING_KIT"
msgid "Aw come on, I've got to set it up myself?"
msgstr "Oh, allez... Il faut vraiment que je fasse tout toute seule ?"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.CARNIVALGAME_HERDING_STATION.GENERIC
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.CARNIVALGAME_HERDING_STATION.GENERIC"
msgid "I've uh... never actually been to a carnival before. Do I give it something?"
msgstr "Je, euh... J'étais jamais allée à un carnaval. Je dois lui donner quelque chose ?"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.CARNIVALGAME_HERDING_STATION.PLAYING
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.CARNIVALGAME_HERDING_STATION.PLAYING"
msgid "Run eggs, run!"
msgstr "Fuyez, les œufs, fuyez !"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.CARNIVALGAME_MEMORY_CARD.GENERIC
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.CARNIVALGAME_MEMORY_CARD.GENERIC"
msgid "A little door to nowhere special."
msgstr "Une petite porte qui mène nulle part."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.CARNIVALGAME_MEMORY_CARD.PLAYING
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.CARNIVALGAME_MEMORY_CARD.PLAYING"
msgid "Yeah, that's the one!"
msgstr "Ouais, c'est celui-là !"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.CARNIVALGAME_MEMORY_KIT
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.CARNIVALGAME_MEMORY_KIT"
msgid "Aw come on, I've got to set it up myself?"
