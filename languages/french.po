msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.YOTB_POST"
msgid "Setting one of these on fire would make the contest way more exciting."
msgstr "Selon moi, y mettre le feu rendrait le concours bien plus intéressant."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.YOTB_POST_ITEM
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.YOTB_POST_ITEM"
msgid "Here's an idea - instead of building it I just set it on fire!"
msgstr "J'ai une idée : et si j'y mettais le feu, plutôt que de l'installer ?"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.YOTB_SEWINGMACHINE
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.YOTB_SEWINGMACHINE"
