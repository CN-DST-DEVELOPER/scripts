msgstr "J'adore voir la forêt illuminée en pleine nuit."

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.WINTER_ORNAMENTPEARL
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.WINTER_ORNAMENTPEARL"
