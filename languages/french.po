msgstr "Une structure antique."

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.ANCIENT_ALTAR_BROKEN
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.ANCIENT_ALTAR_BROKEN"
