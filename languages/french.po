msgstr "C'est un squelette de quoi ?"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.FOSSIL_STALKER.FUNNY
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.FOSSIL_STALKER.FUNNY"
msgid "That was not assembled correctly."
msgstr "C'est mal monté."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.FOSSIL_STALKER.GENERIC
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.FOSSIL_STALKER.GENERIC"
msgid "Some more assembly required."
msgstr "Il faudrait faire plus de montage."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.FRESHFRUITCREPES
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.FRESHFRUITCREPES"
