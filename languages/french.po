msgstr "On construit quelque chose d'amusant !"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.VAULT_PILLAR_GUARD_CONSTR_PLANS
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.VAULT_PILLAR_GUARD_CONSTR_PLANS"
