msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.LOST_TOY_42"
msgid "I get the feeling... that this meant a great deal to someone."
msgstr "J'ai l'impression... que ça comptait beaucoup pour quelqu'un."

