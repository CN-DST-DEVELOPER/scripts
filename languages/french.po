msgstr "Quel étrange petit chapeau."

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.COZY_BUNNYMAN
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.COZY_BUNNYMAN"
