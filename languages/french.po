msgstr "Je baille."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.QUAGMIRE_ALTAR_QUEEN
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.QUAGMIRE_ALTAR_QUEEN"
msgid "What's so great about her?"
msgstr "Qu'a-t-elle de si formidable ?"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.QUAGMIRE_ALTAR_STATUE1
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.QUAGMIRE_ALTAR_STATUE1"
msgid "Haha! Look at this dumb goat statue."
msgstr "Ah, ah ! Regardez-moi cette idiote statue de chèvre !"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.QUAGMIRE_ALTAR_STATUE2
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.QUAGMIRE_ALTAR_STATUE2"
msgid "Ew. It's ugly."
msgstr "Beurk. C'est moche."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.QUAGMIRE_BEEFALO
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.QUAGMIRE_BEEFALO"
msgid "Haha. You're old."
msgstr "Ah, ah ! T'es vieux !"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.QUAGMIRE_BERRYBUSH
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.QUAGMIRE_BERRYBUSH"
msgid "But I want more berries!"
msgstr "Je veux plus de baies !"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.QUAGMIRE_BOWL_SILVER
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.QUAGMIRE_BOWL_SILVER"
msgid "Now I don't have to use my hands."
msgstr "Plus besoin d'utiliser les mains."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.QUAGMIRE_CARROT_SEEDS
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.QUAGMIRE_CARROT_SEEDS"
msgid "It's just a bunch of seeds."
msgstr "C'est juste un paquet de graines."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.QUAGMIRE_CASSEROLEDISH
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.QUAGMIRE_CASSEROLEDISH"
msgid "Fancy."
msgstr "C'est chic."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.QUAGMIRE_CASSEROLEDISH_SMALL
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.QUAGMIRE_CASSEROLEDISH_SMALL"
msgid "It's kinda small."
msgstr "C'est pas très grand."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.QUAGMIRE_COIN1
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.QUAGMIRE_COIN1"
msgid "Wow. A coin. Pfft."
msgstr "Waouh ! Une pièce. Pff..."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.QUAGMIRE_COIN2
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.QUAGMIRE_COIN2"
msgid "I can probably buy something good with this."
msgstr "Je peux sans doute acheter un truc pas mal avec ça."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.QUAGMIRE_COIN3
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.QUAGMIRE_COIN3"
msgid "I'm rich!"
msgstr "Je suis riche !"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.QUAGMIRE_COIN4
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.QUAGMIRE_COIN4"
msgid "Guess that thing liked what we gave it."
msgstr "J'imagine que cette chose a aimé notre offrande."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.QUAGMIRE_CRABMEAT
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.QUAGMIRE_CRABMEAT"
msgid "Needs more fire."
msgstr "Il faudrait le cuire."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.QUAGMIRE_CRABMEAT_COOKED
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.QUAGMIRE_CRABMEAT_COOKED"
msgid "I bet it's tasty."
msgstr "Je parie que c'est bon."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.QUAGMIRE_CRABTRAP
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.QUAGMIRE_CRABTRAP"
msgid "That'll show those crabs."
msgstr "Ça leur apprendra à ces crabes !"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.QUAGMIRE_FERN
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.QUAGMIRE_FERN"
msgid "I can take my pick of them."
msgstr "Je pourrais taper dedans."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.QUAGMIRE_FLOUR
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.QUAGMIRE_FLOUR"
msgid "Can you just eat flour?"
msgstr "Ça se mange la farine ?"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.QUAGMIRE_FOLIAGE_COOKED
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.QUAGMIRE_FOLIAGE_COOKED"
msgid "Leaf this to a professional."
msgstr "C'est un peu dur de la feuille."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.QUAGMIRE_FOOD.GENERIC
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.QUAGMIRE_FOOD.GENERIC"
msgid "Maybe that thing up there'll eat it."
msgstr "Peut-être que cette chose là-haut en mangera..."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.QUAGMIRE_FOOD.MATCH
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.QUAGMIRE_FOOD.MATCH"
msgid "This should shut that thing up for a while."
msgstr "Ça devrait faire taire cette chose un moment."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.QUAGMIRE_FOOD.MATCH_BUT_SNACK
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.QUAGMIRE_FOOD.MATCH_BUT_SNACK"
msgid "This won't shut it up for long."
msgstr "Avec ça, cette chose ne la bouclera pas longtemps."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.QUAGMIRE_FOOD.MISMATCH
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.QUAGMIRE_FOOD.MISMATCH"
msgid "It doesn't want that. Might as well burn it."
msgstr "La chose n'en veut pas. Je ferais aussi bien de tout brûler."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.QUAGMIRE_FOOD_BURNT
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.QUAGMIRE_FOOD_BURNT"
msgid "Looks good to me."
msgstr "Ça m'a l'air bon."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.QUAGMIRE_GARLIC
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.QUAGMIRE_GARLIC"
msgid "It's just a couple cloves of garlic."
msgstr "Quelques gousses d'ail."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.QUAGMIRE_GARLIC_COOKED
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.QUAGMIRE_GARLIC_COOKED"
msgid "Fire made it better."
msgstr "Le feu l'a amélioré."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.QUAGMIRE_GARLIC_SEEDS
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.QUAGMIRE_GARLIC_SEEDS"
msgid "It's just a bunch of seeds."
msgstr "C'est juste un paquet de graines."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.QUAGMIRE_GOATKID
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.QUAGMIRE_GOATKID"
msgid "He'll eat just about anything."
msgstr "Ça mangerait n'importe quoi."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.QUAGMIRE_GOATMILK
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.QUAGMIRE_GOATMILK"
msgid "What? We needed milk."
msgstr "Quoi ? On avait besoin de lait."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.QUAGMIRE_GOATMUM
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.QUAGMIRE_GOATMUM"
msgid "Her eyes creep me out."
msgstr "Ses yeux me foutent les chocottes."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.QUAGMIRE_GRILL
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.QUAGMIRE_GRILL"
msgid "Fire it up!"
msgstr "Allumez le feu !"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.QUAGMIRE_GRILL_ITEM
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.QUAGMIRE_GRILL_ITEM"
msgid "Ugh, I guess I should set it up."
msgstr "Euh, je crois que je devrais l'installer."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.QUAGMIRE_GRILL_SMALL
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.QUAGMIRE_GRILL_SMALL"
msgid "If it was bigger I could use more fire."
msgstr "Si c'était plus grand, je pourrais y mettre plus de feu."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.QUAGMIRE_GRILL_SMALL_ITEM
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.QUAGMIRE_GRILL_SMALL_ITEM"
msgid "I should set it up over the firepit."
msgstr "Je devrais l'installer au-dessus du feu."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.QUAGMIRE_HOE
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.QUAGMIRE_HOE"
msgid "You mean I gotta do work?"
msgstr "Ça veut dire qu'il faut que je travaille ?"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.QUAGMIRE_KEY
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.QUAGMIRE_KEY"
msgid "I'll use this if I can't burn it open."
msgstr "J'utiliserai ça si je n'arrive pas à l'ouvrir avec du feu."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.QUAGMIRE_KEY_PARK
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.QUAGMIRE_KEY_PARK"
msgid "There's more stuff to burn in the park."
msgstr "Il y a plus de trucs à brûler dans le parc."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.QUAGMIRE_LAMP_POST
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.QUAGMIRE_LAMP_POST"
msgid "Just an old lamp post."
msgstr "C'est juste un vieux réverbère."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.QUAGMIRE_LAMP_SHORT
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.QUAGMIRE_LAMP_SHORT"
msgid "Whatever. It's a lamp."
msgstr "Et alors ? C'est une lampe."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.QUAGMIRE_MEALINGSTONE
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.QUAGMIRE_MEALINGSTONE"
msgid "I can smash stuff down with it."
msgstr "Je peux écraser des trucs avec ça."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.QUAGMIRE_MERMHOUSE
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.QUAGMIRE_MERMHOUSE"
msgid "That's what passes for a village around here, I guess."
msgstr "J'imagine que c'est ce qu'on appelle un village par ici."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.QUAGMIRE_MERM_CART1
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.QUAGMIRE_MERM_CART1"
msgid "There's a lot of stuff to burn in there."
msgstr "Il y a plein de trucs à brûler par ici."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.QUAGMIRE_MERM_CART2
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.QUAGMIRE_MERM_CART2"
msgid "I'd burn it, but I need the things in there."
msgstr "Je brûlerais bien ça, mais il me faut les trucs qu'il y a dedans."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.QUAGMIRE_MUSHROOMS
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.QUAGMIRE_MUSHROOMS"
msgid "It's totally raw. Fire could fix that!"
msgstr "C'est super cru. Le feu pourrait régler ça !"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.QUAGMIRE_MUSHROOMSTUMP.GENERIC
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.QUAGMIRE_MUSHROOMSTUMP.GENERIC"
msgid "They're so hideous they're almost cute."
msgstr "Ils sont si horribles qu'ils en sont presque mignons."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.QUAGMIRE_MUSHROOMSTUMP.PICKED
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.QUAGMIRE_MUSHROOMSTUMP.PICKED"
msgid "Hey! Give me more mushrooms!"
msgstr "Eh ! Je veux d'autres champignons !"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.QUAGMIRE_ONION
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.QUAGMIRE_ONION"
msgid "It's so bulbous."
msgstr "C'est trop bulbeux."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.QUAGMIRE_ONION_COOKED
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.QUAGMIRE_ONION_COOKED"
msgid "Roasting. My favorite cooking method."
msgstr "Rôti. Mon mode de cuisson préféré."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.QUAGMIRE_ONION_SEEDS
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.QUAGMIRE_ONION_SEEDS"
msgid "It's just a bunch of seeds."
msgstr "C'est juste un paquet de graines."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.QUAGMIRE_OVEN
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.QUAGMIRE_OVEN"
msgid "Now we're cooking."
msgstr "On va cuisiner."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.QUAGMIRE_OVEN_ITEM
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.QUAGMIRE_OVEN_ITEM"
msgid "I can't wait to use it!"
msgstr "Je suis trop pressée de m'en servir !"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.QUAGMIRE_PARKSPIKE
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.QUAGMIRE_PARKSPIKE"
msgid "That looks sharp."
msgstr "On dirait que ça pique."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.QUAGMIRE_PARK_ANGEL
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.QUAGMIRE_PARK_ANGEL"
msgid "Gross."
msgstr "Dégoûtant."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.QUAGMIRE_PARK_ANGEL2
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.QUAGMIRE_PARK_ANGEL2"
msgid "Ugly."
msgstr "Moche."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.QUAGMIRE_PARK_FOUNTAIN
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.QUAGMIRE_PARK_FOUNTAIN"
msgid "A fountain with no water. Maybe that's a metaphor?"
msgstr "Une fontaine sans eau. Est-ce une métaphore ?"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.QUAGMIRE_PARK_GATE.GENERIC
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.QUAGMIRE_PARK_GATE.GENERIC"
msgid "Didn't even have to melt the locks."
msgstr "Je n'ai même pas eu besoin de faire fondre le verrou."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.QUAGMIRE_PARK_GATE.LOCKED
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.QUAGMIRE_PARK_GATE.LOCKED"
msgid "I can't even burn it open!"
msgstr "Impossible de l'ouvrir avec du feu !"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.QUAGMIRE_PARK_OBELISK
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.QUAGMIRE_PARK_OBELISK"
msgid "It's stone. I can't burn it."
msgstr "De la pierre. Ça brûle pas."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.QUAGMIRE_PARK_URN
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.QUAGMIRE_PARK_URN"
msgid "Cremation is the only way to do it."
msgstr "Rien ne remplace la crémation."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.QUAGMIRE_PEBBLECRAB
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.QUAGMIRE_PEBBLECRAB"
msgid "Don't worry, I won't kick you."
msgstr "T'inquiète pas, je ne te ferai rien."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.QUAGMIRE_PIGEON.DEAD
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.QUAGMIRE_PIGEON.DEAD"
msgid "It's dead."
msgstr "Elle est morte."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.QUAGMIRE_PIGEON.GENERIC
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.QUAGMIRE_PIGEON.GENERIC"
msgid "I haven't got any crumbs for you."
msgstr "J'ai pas de miettes pour toi."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.QUAGMIRE_PIGEON.SLEEPING
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.QUAGMIRE_PIGEON.SLEEPING"
msgid "It's taking a nap."
msgstr "Il fait une sieste."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.QUAGMIRE_PLATE_SILVER
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.QUAGMIRE_PLATE_SILVER"
msgid "Ohh. Look who's fancy now!"
msgstr "Oh ! Regardez qui a la classe maintenant !"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.QUAGMIRE_POND_SALT
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.QUAGMIRE_POND_SALT"
msgid "Blech! Tastes like ocean."
msgstr "Beurk ! C'est le goût de l'océan."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.QUAGMIRE_PORTAL
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.QUAGMIRE_PORTAL"
msgid "I'm just gonna keep jumping through portals til I figure out a way home."
msgstr "Je vais sauter dans tous les portails et je finirai bien par retomber chez moi."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.QUAGMIRE_PORTAL_KEY
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.QUAGMIRE_PORTAL_KEY"
msgid "Fancy key."
msgstr "Jolie clé."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.QUAGMIRE_POT
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.QUAGMIRE_POT"
msgid "I should light a fire under its butt."
msgstr "Je devrais allumer un feu là-dessous."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.QUAGMIRE_POTATO
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.QUAGMIRE_POTATO"
msgid "We grew it in that gross muck."
msgstr "Ça pousse dans une espèce de gadoue."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.QUAGMIRE_POTATO_COOKED
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.QUAGMIRE_POTATO_COOKED"
msgid "Cooking just means sticking stuff in fire."
msgstr "Cuisiner c'est juste balancer des trucs dans le feu."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.QUAGMIRE_POTATO_SEEDS
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.QUAGMIRE_POTATO_SEEDS"
msgid "It's just a bunch of seeds."
msgstr "C'est juste un paquet de graines."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.QUAGMIRE_POT_HANGER
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.QUAGMIRE_POT_HANGER"
msgid "I set it up. Now what?"
msgstr "J'ai installé ça. Et maintenant ?"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.QUAGMIRE_POT_HANGER_ITEM
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.QUAGMIRE_POT_HANGER_ITEM"
msgid "It needs to be set up in a firepit."
msgstr "Ça doit s'installer au-dessus d'un feu."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.QUAGMIRE_POT_SMALL
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.QUAGMIRE_POT_SMALL"
msgid "It goes with the fire."
msgstr "Ça marche avec le feu."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.QUAGMIRE_POT_SYRUP
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.QUAGMIRE_POT_SYRUP"
msgid "Sweet stuff goes in there."
msgstr "C'est pour mettre le truc sucré."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.QUAGMIRE_ROTTEN_CROP
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.QUAGMIRE_ROTTEN_CROP"
msgid "That one stayed in the ground too long."
msgstr "C'est resté trop longtemps dans la terre."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.QUAGMIRE_RUBBLE_BIKE
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.QUAGMIRE_RUBBLE_BIKE"
msgid "Metal doesn't burn well."
msgstr "Le métal brûle mal."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.QUAGMIRE_RUBBLE_CARRIAGE
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.QUAGMIRE_RUBBLE_CARRIAGE"
msgid "It's so busted, I don't even wanna light it on fire."
msgstr "C'est tellement bousillé que j'ai même pas envie d'y mettre le feu."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.QUAGMIRE_RUBBLE_CATHEDRAL
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.QUAGMIRE_RUBBLE_CATHEDRAL"
msgid "What a waste. It could've burned down."
msgstr "Quel gâchis. Elle aurait pu brûler."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.QUAGMIRE_RUBBLE_CHIMNEY
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.QUAGMIRE_RUBBLE_CHIMNEY"
msgid "What's a chimney without a fireplace?"
msgstr "Qu'est-ce qu'une cheminée sans foyer ?"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.QUAGMIRE_RUBBLE_CHIMNEY2
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.QUAGMIRE_RUBBLE_CHIMNEY2"
msgid "Ugh! It won't even burn."
msgstr "Euh... ça brûlera même pas."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.QUAGMIRE_RUBBLE_CLOCK
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.QUAGMIRE_RUBBLE_CLOCK"
msgid "I'd love to burn that to ashes."
msgstr "J'adorerais réduire ça en cendres."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.QUAGMIRE_RUBBLE_CLOCKTOWER
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.QUAGMIRE_RUBBLE_CLOCKTOWER"
msgid "That would look better on fire."
msgstr "Ça serait plus joli en feu."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.QUAGMIRE_RUBBLE_HOUSE.1
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.QUAGMIRE_RUBBLE_HOUSE.1"
msgid "It's like there was a Great Fire, without the fire."
msgstr "C'est comme s'il y avait eu un incendie, sans le feu."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.QUAGMIRE_RUBBLE_HOUSE.2
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.QUAGMIRE_RUBBLE_HOUSE.2"
msgid "There's no one here. Boring."
msgstr "Y a personne ici. Quel ennui !"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.QUAGMIRE_RUBBLE_HOUSE.3
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.QUAGMIRE_RUBBLE_HOUSE.3"
msgid "I wish this would burn."
msgstr "Si seulement ça brûlait."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.QUAGMIRE_RUBBLE_PUBDOOR
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.QUAGMIRE_RUBBLE_PUBDOOR"
msgid "It'd be better if it was burnt."
msgstr "Ça serait mieux si c'était brûlé."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.QUAGMIRE_RUBBLE_ROOF
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.QUAGMIRE_RUBBLE_ROOF"
msgid "The roof isn't on fire."
msgstr "Le toit n'a pas pris feu."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.QUAGMIRE_SAFE.GENERIC
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.QUAGMIRE_SAFE.GENERIC"
msgid "Ha! Cracked it."
msgstr "Ah ! Ouvert !"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.QUAGMIRE_SAFE.LOCKED
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.QUAGMIRE_SAFE.LOCKED"
msgid "I can't get it to open."
msgstr "Impossible de l'ouvrir."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.QUAGMIRE_SALMON
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.QUAGMIRE_SALMON"
msgid "Look at it, flopping around like that."
msgstr "Regardez-le se débattre dans tous les sens."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.QUAGMIRE_SALMON_COOKED
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.QUAGMIRE_SALMON_COOKED"
msgid "All it needed was some fire."
msgstr "Il lui fallait juste du feu."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.QUAGMIRE_SALT
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.QUAGMIRE_SALT"
msgid "I need a pinch or two on all my food."
msgstr "J'en mets une pincée ou deux sur tout ce que je mange."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.QUAGMIRE_SALTROCK
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.QUAGMIRE_SALTROCK"
msgid "I licked one. Had to."
msgstr "J'en ai léché une. Il le fallait."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.QUAGMIRE_SALT_RACK.GENERIC
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.QUAGMIRE_SALT_RACK.GENERIC"
msgid "Grow faster, salt crystals!"
msgstr "Poussez plus vite, cristaux de sel !"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.QUAGMIRE_SALT_RACK.READY
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.QUAGMIRE_SALT_RACK.READY"
msgid "Gotta dredge the salt up."
msgstr "Le sel, ça se drague."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.QUAGMIRE_SALT_RACK_ITEM
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.QUAGMIRE_SALT_RACK_ITEM"
msgid "We can use it to get some cooking salt."
msgstr "Ça peut servir pour obtenir du sel de cuisine."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.QUAGMIRE_SAP
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.QUAGMIRE_SAP"
msgid "Mmm! Pure sugar!"
msgstr "Miam ! Pur sucre !"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.QUAGMIRE_SAPBUCKET
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.QUAGMIRE_SAPBUCKET"
msgid "Now we can get sap out of the trees."
msgstr "Je vais pouvoir récolter de la sève dans les arbres."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.QUAGMIRE_SAPLING
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.QUAGMIRE_SAPLING"
msgid "Well. Might as well burn it now."
msgstr "Ah, je ferais peut-être mieux de brûler ça !"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.QUAGMIRE_SAP_SPOILED
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.QUAGMIRE_SAP_SPOILED"
msgid "Well that's dumb."
msgstr "C'est idiot."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.QUAGMIRE_SEEDPACKET
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.QUAGMIRE_SEEDPACKET"
msgid "Aw...I won't know what these are until I plant them."
msgstr "Je vais devoir en semer si je veux savoir ce que c'est."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.QUAGMIRE_SLAUGHTERTOOL
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.QUAGMIRE_SLAUGHTERTOOL"
msgid "I'd rather burn things."
msgstr "Je préfère brûler."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.QUAGMIRE_SPOTSPICE_GROUND
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.QUAGMIRE_SPOTSPICE_GROUND"
msgid "Spices... the true spice of life."
msgstr "Les épices... le vrai sel de la vie."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.QUAGMIRE_SPOTSPICE_SHRUB.GENERIC
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.QUAGMIRE_SPOTSPICE_SHRUB.GENERIC"
msgid "It smells kind of pepper-y."
msgstr "Ça sent un peu le poivre."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.QUAGMIRE_SPOTSPICE_SHRUB.PICKED
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.QUAGMIRE_SPOTSPICE_SHRUB.PICKED"
msgid "That's not growing back."
msgstr "Ça ne repousse pas."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.QUAGMIRE_SPOTSPICE_SPRIG
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.QUAGMIRE_SPOTSPICE_SPRIG"
msgid "It's a piece of that pepper-y bush."
msgstr "C'est un morceau de ce buisson à poivre."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.QUAGMIRE_SUGARWOODTREE.GENERIC
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.QUAGMIRE_SUGARWOODTREE.GENERIC"
msgid "Aw! It's impervious to fire."
msgstr "Ah ! Ça résiste au feu !"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.QUAGMIRE_SUGARWOODTREE.STUMP
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.QUAGMIRE_SUGARWOODTREE.STUMP"
msgid "It's kinda useless now."
msgstr "Ça ne sert plus à grand-chose."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.QUAGMIRE_SUGARWOODTREE.TAPPED_BUGS
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.QUAGMIRE_SUGARWOODTREE.TAPPED_BUGS"
msgid "Stupid bugs."
msgstr "Stupides insectes."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.QUAGMIRE_SUGARWOODTREE.TAPPED_EMPTY
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.QUAGMIRE_SUGARWOODTREE.TAPPED_EMPTY"
msgid "It's taking forever!"
msgstr "Ça prend une éternité !"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.QUAGMIRE_SUGARWOODTREE.TAPPED_READY
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.QUAGMIRE_SUGARWOODTREE.TAPPED_READY"
msgid "Sap's ready!"
msgstr "La sève est prête !"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.QUAGMIRE_SUGARWOODTREE.WOUNDED
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.QUAGMIRE_SUGARWOODTREE.WOUNDED"
msgid "You don't look so hot, tree."
msgstr "T'as pas l'air si chaud, l'arbre."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.QUAGMIRE_SWAMPIG
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.QUAGMIRE_SWAMPIG"
msgid "Not the prettiest face."
msgstr "J'ai déjà vu plus joli."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.QUAGMIRE_SWAMPIGELDER.GENERIC
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.QUAGMIRE_SWAMPIGELDER.GENERIC"
msgid "They're not so different from the pigs back at our place."
msgstr "Ils sont pas si différents des cochons de chez nous."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.QUAGMIRE_SWAMPIGELDER.SLEEPING
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.QUAGMIRE_SWAMPIGELDER.SLEEPING"
msgid "It's taking a nap."
msgstr "Il fait une sieste."

