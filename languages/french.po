msgstr "Hmm, c'est pas mal vide, par ici."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.CARNIVAL_PLAZA.LEVEL_2
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.CARNIVAL_PLAZA.LEVEL_2"
