msgstr "Il y avait de l'eau ici."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.OASISLAKE.GENERIC
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.OASISLAKE.GENERIC"
msgid "Never seen such a clear lake before."
msgstr "Le lac le plus clair que j'aie jamais vu."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.OCEANFISHABLEFLOTSAM
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.OCEANFISHABLEFLOTSAM"
msgid "Ugh, what sorta mess did I reel in?"
msgstr "Dans quoi j'me suis fourrée ?"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.OCEANFISHINGBOBBER_BALL
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.OCEANFISHINGBOBBER_BALL"
