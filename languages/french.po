msgstr "Je devrais vérifier si ça brûle encore."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.MUSHTREE_TALL_WEBBED.GENERIC
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.MUSHTREE_TALL_WEBBED.GENERIC"
