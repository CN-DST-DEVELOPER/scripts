msgstr "Ça ne restera pas en place !"

#. STRINGS.CHARACTERS.WATHGRITHR.ACTIONFAIL.REPLATE.MISMATCH
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.ACTIONFAIL.REPLATE.MISMATCH"
msgid "This food doth need a different dish."
msgstr "Cette nourriture n'a pas besoin d'une autre assiette."

#. STRINGS.CHARACTERS.WATHGRITHR.ACTIONFAIL.REPLATE.SAMEDISH
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.ACTIONFAIL.REPLATE.SAMEDISH"
