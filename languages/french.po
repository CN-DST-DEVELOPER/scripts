msgctxt "STRINGS.CHARACTERS.WALTER.ANNOUNCE_WOLFGANG_WIMPY_COACHING"
msgid "only_used_by_wolfgang"
msgstr "only_used_by_wolfgang"

#. STRINGS.CHARACTERS.WALTER.ANNOUNCE_WORMHOLE
msgctxt "STRINGS.CHARACTERS.WALTER.ANNOUNCE_WORMHOLE"
msgid "That was amazing!!"
msgstr "C'était trop bien !"

#. STRINGS.CHARACTERS.WALTER.ANNOUNCE_WORMS
msgctxt "STRINGS.CHARACTERS.WALTER.ANNOUNCE_WORMS"
msgid "Something's moving..."
msgstr "Il y a quelque chose qui bouge..."

#. STRINGS.CHARACTERS.WALTER.ANNOUNCE_WORMS_BOSS
msgctxt "STRINGS.CHARACTERS.WALTER.ANNOUNCE_WORMS_BOSS"
msgid "Something's coming. Something big."
msgstr "Quelque chose approche. C'est gros."

#. STRINGS.CHARACTERS.WALTER.ANNOUNCE_WORTOX_REVIVER_FAILTELEPORT
msgctxt "STRINGS.CHARACTERS.WALTER.ANNOUNCE_WORTOX_REVIVER_FAILTELEPORT"
msgid "Aww man!"
msgstr "Oh non !"

#. STRINGS.CHARACTERS.WALTER.ANNOUNCE_WX_SCANNER_NEW_FOUND
msgctxt "STRINGS.CHARACTERS.WALTER.ANNOUNCE_WX_SCANNER_NEW_FOUND"
msgid "only_used_by_wx78"
msgstr "only_used_by_wx78"

#. STRINGS.CHARACTERS.WALTER.ANNOUNCE_YOTB_LEARN_NEW_PATTERN
msgctxt "STRINGS.CHARACTERS.WALTER.ANNOUNCE_YOTB_LEARN_NEW_PATTERN"
msgid "Hey, I think I can make a new beefalo costume!"
msgstr "Hé, je crois que je peux faire un nouveau costume de bœufalo !"

#. STRINGS.CHARACTERS.WALTER.ANNOUNCE_YOTD_NOBOATS
msgctxt "STRINGS.CHARACTERS.WALTER.ANNOUNCE_YOTD_NOBOATS"
msgid "We've got to get closer to the Start Tower, Woby!"
msgstr "On doit se rapprocher de la tour de départ, Woby !"

#. STRINGS.CHARACTERS.WALTER.ANNOUNCE_YOTD_NOCHECKPOINTS
msgctxt "STRINGS.CHARACTERS.WALTER.ANNOUNCE_YOTD_NOCHECKPOINTS"
msgid "Whoops, I might've forgot to set up the checkpoints..."
msgstr "Oups, j'ai peut-être oublié d'installer les points de contrôle..."

#. STRINGS.CHARACTERS.WALTER.ANNOUNCE_YOTD_NOTENOUGHBOATS
msgctxt "STRINGS.CHARACTERS.WALTER.ANNOUNCE_YOTD_NOTENOUGHBOATS"
msgid "We need to make some room for other racers, Woby!"
msgstr "On doit faire de la place pour les autres, Woby !"

#. STRINGS.CHARACTERS.WALTER.ANNOUNCE_YOTH_ONCOOLDOWN
msgctxt "STRINGS.CHARACTERS.WALTER.ANNOUNCE_YOTH_ONCOOLDOWN"
msgid "They must be too busy to come now, Woby girl."
msgstr "Ils doivent être trop occupés pour venir nous aider, Woby."

#. STRINGS.CHARACTERS.WALTER.ANOUNCE_MUTATED_BIRD_ATTACK
msgctxt "STRINGS.CHARACTERS.WALTER.ANOUNCE_MUTATED_BIRD_ATTACK"
msgid "Incoming!"
msgstr "Attention !"

#. STRINGS.CHARACTERS.WALTER.BATTLECRY.DEER
msgctxt "STRINGS.CHARACTERS.WALTER.BATTLECRY.DEER"
msgid "Sorry deer!"
msgstr "Désolé, Bambi !"

#. STRINGS.CHARACTERS.WALTER.BATTLECRY.GENERIC
msgctxt "STRINGS.CHARACTERS.WALTER.BATTLECRY.GENERIC"
msgid "Sorry!!"
msgstr "Désolé !!"

#. STRINGS.CHARACTERS.WALTER.BATTLECRY.PIG
msgctxt "STRINGS.CHARACTERS.WALTER.BATTLECRY.PIG"
msgid "It didn't have to be like this!"
msgstr "Ça aurait pu se passer autrement !"

#. STRINGS.CHARACTERS.WALTER.BATTLECRY.PREY
msgctxt "STRINGS.CHARACTERS.WALTER.BATTLECRY.PREY"
msgid "Sorry, you're going to be dinner for me and Woby!"
msgstr "Désolé, tu vas nous servir de dîner à moi et Woby !"

#. STRINGS.CHARACTERS.WALTER.BATTLECRY.SPIDER
msgctxt "STRINGS.CHARACTERS.WALTER.BATTLECRY.SPIDER"
msgid "This wouldn't be happening if you didn't try to eat me!"
msgstr "Ça n'arriverait pas si tu n'avais pas essayé de me manger !"

#. STRINGS.CHARACTERS.WALTER.BATTLECRY.SPIDER_WARRIOR
msgctxt "STRINGS.CHARACTERS.WALTER.BATTLECRY.SPIDER_WARRIOR"
msgid "Take that! And that!"
msgstr "Prends ça ! Et ça !"

#. STRINGS.CHARACTERS.WALTER.COMBAT_QUIT.GENERIC
msgctxt "STRINGS.CHARACTERS.WALTER.COMBAT_QUIT.GENERIC"
msgid "Y-yeah! You better run!"
msgstr "O-Ouais ! Tu fais bien de déguerpir !"

#. STRINGS.CHARACTERS.WALTER.COMBAT_QUIT.PIG
msgctxt "STRINGS.CHARACTERS.WALTER.COMBAT_QUIT.PIG"
msgid "Let's just take a minute to cool our heads."
msgstr "Prenons un moment pour reprendre nos esprits."

#. STRINGS.CHARACTERS.WALTER.COMBAT_QUIT.PREY
msgctxt "STRINGS.CHARACTERS.WALTER.COMBAT_QUIT.PREY"
msgid "Darnit! They got away."
msgstr "Ah zut ! Il s'est enfui."

#. STRINGS.CHARACTERS.WALTER.COMBAT_QUIT.SPIDER
msgctxt "STRINGS.CHARACTERS.WALTER.COMBAT_QUIT.SPIDER"
msgid "I didn't really want to fight them anyway."
msgstr "De toute façon, j'avais pas trop envie de la combattre."

#. STRINGS.CHARACTERS.WALTER.COMBAT_QUIT.SPIDER_WARRIOR
msgctxt "STRINGS.CHARACTERS.WALTER.COMBAT_QUIT.SPIDER_WARRIOR"
msgid "Nobody likes a bully."
msgstr "Personne n'aime les petites frappes."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.ABIGAIL.LEVEL1.1
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.ABIGAIL.LEVEL1.1"
msgid "Your sister kind of creeps me out, but you're alright!"
msgstr "Ta sœur me file les jetons, mais toi t'es sympa !"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.ABIGAIL.LEVEL1.2
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.ABIGAIL.LEVEL1.2"
msgid "Your sister kind of creeps me out, but you're alright!"
msgstr "Ta sœur me file les jetons, mais toi t'es sympa !"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.ABIGAIL.LEVEL2.1
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.ABIGAIL.LEVEL2.1"
msgid "Your sister kind of creeps me out, but you're alright!"
msgstr "Ta sœur me file les jetons, mais toi t'es sympa !"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.ABIGAIL.LEVEL2.2
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.ABIGAIL.LEVEL2.2"
msgid "Your sister kind of creeps me out, but you're alright!"
msgstr "Ta sœur me file les jetons, mais toi t'es sympa !"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.ABIGAIL.LEVEL3.1
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.ABIGAIL.LEVEL3.1"
msgid "Your sister kind of creeps me out, but you're alright!"
msgstr "Ta sœur me file les jetons, mais toi t'es sympa !"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.ABIGAIL.LEVEL3.2
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.ABIGAIL.LEVEL3.2"
msgid "Your sister kind of creeps me out, but you're alright!"
msgstr "Ta sœur me file les jetons, mais toi t'es sympa !"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.ABIGAIL_FLOWER.GENERIC
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.ABIGAIL_FLOWER.GENERIC"
msgid "Did that flower just whisper something?"
msgstr "Cette fleur vient de murmurer un truc, non ?"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.ABIGAIL_FLOWER.HAUNTED_GROUND
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.ABIGAIL_FLOWER.HAUNTED_GROUND"
msgid "I'd die to find out what it does."
msgstr "Je meurs d'envie de savoir ce que ça fait."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.ABIGAIL_FLOWER.HAUNTED_POCKET
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.ABIGAIL_FLOWER.HAUNTED_POCKET"
msgid "I don't think I should hang on to this."
msgstr "Je crois que je ne devrais pas prendre ça."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.ABIGAIL_FLOWER.LEVEL1
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.ABIGAIL_FLOWER.LEVEL1"
msgid "Oh, Abigail! I didn't recognize you."
msgstr "Oh, Abigail ! Je t'avais pas reconnue."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.ABIGAIL_FLOWER.LEVEL2
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.ABIGAIL_FLOWER.LEVEL2"
msgid "Don't eat the haunted flower, Woby!"
msgstr "Mange pas la fleur hantée, Woby !"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.ABIGAIL_FLOWER.LEVEL3
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.ABIGAIL_FLOWER.LEVEL3"
msgid "You're not really as spooky when you're a flower."
msgstr "Tu es vraiment beaucoup moins flippante quand tu es une fleur."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.ABIGAIL_FLOWER.LONG
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.ABIGAIL_FLOWER.LONG"
msgid "It hurts my soul to look at that thing."
msgstr "Quand je regarde cette chose, mon âme saigne."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.ABIGAIL_FLOWER.MEDIUM
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.ABIGAIL_FLOWER.MEDIUM"
msgid "It's giving me the creeps."
msgstr "Ce truc me fout les chocottes."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.ABIGAIL_FLOWER.SOON
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.ABIGAIL_FLOWER.SOON"
msgid "Something is up with that flower!"
msgstr "Il y a un truc pas normal avec cette fleur !"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.ABYSSPILLAR_MINION.ACTIVATED
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.ABYSSPILLAR_MINION.ACTIVATED"
msgid "Hey, it moves when I move!"
msgstr "Hé, ça bouge en même temps que moi !"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.ABYSSPILLAR_MINION.GENERIC
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.ABYSSPILLAR_MINION.GENERIC"
msgid "So creepy!"
msgstr "C'est glauque !"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.ABYSSPILLAR_TRIAL
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.ABYSSPILLAR_TRIAL"
msgid "Great idea, Woby! Let's pull it!"
msgstr "Super idée, Woby ! Tirons-le !"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.ACCOMPLISHMENT_SHRINE
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.ACCOMPLISHMENT_SHRINE"
msgid "I love checking tasks off a list!"
msgstr "J'adore cocher des trucs à faire dans ma liste !"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.ACORN
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.ACORN"
msgid "I wonder if there's any squirrels around."
msgstr "Je me demande s'il y a des écureuils dans le coin."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.ACORN_COOKED
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.ACORN_COOKED"
msgid "Nutty."
msgstr "Ça a un goût de noisette."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.ACORN_SAPLING
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.ACORN_SAPLING"
msgid "More firewood in the making!"
msgstr "On aura bientôt encore plus de bois de chauffage !"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.ADVENTURE_PORTAL
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.ADVENTURE_PORTAL"
msgid "Don't be scared Woby, we'll do this together!"
msgstr "N'aie pas peur, Woby. On va y aller ensemble !"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.ALTERGUARDIANHAT
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.ALTERGUARDIANHAT"
msgid "It tells me all kinds of stories."
msgstr "Il me raconte toujours des tas d'histoires."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.ALTERGUARDIANHATSHARD
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.ALTERGUARDIANHATSHARD"
msgid "I'm sure we can still find a use for it!"
msgstr "Je suis sûr qu'on peut encore lui trouver une utilité !"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.ALTERGUARDIAN_CONTAINED
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.ALTERGUARDIAN_CONTAINED"
msgid "Wow, we sure are lucky he happened to have that with him!"
msgstr "Ouah, heureusement qu'il avait ça sur lui ! On a eu de la chance !"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.ALTERGUARDIAN_PHASE1.DEAD
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.ALTERGUARDIAN_PHASE1.DEAD"
msgid "Aww, I wanted to ask them what it's like up in space..."
msgstr "Oooh, je voulais lui demander à quoi ça ressemblait, l'espace."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.ALTERGUARDIAN_PHASE1.GENERIC
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.ALTERGUARDIAN_PHASE1.GENERIC"
msgid "Woah, is that a space creature?!"
msgstr "Ouaaah ! C'est une créature de l'espace ?!"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.ALTERGUARDIAN_PHASE1_LUNARRIFT
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.ALTERGUARDIAN_PHASE1_LUNARRIFT"
msgid "It's extra glowy isn't it, Woby?"
msgstr "Ça brille à max, hein, Woby ?"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.ALTERGUARDIAN_PHASE1_LUNARRIFT_GESTALT
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.ALTERGUARDIAN_PHASE1_LUNARRIFT_GESTALT"
msgid "That must be it, Wobes!"
msgstr "Ça doit être ça, Woby !"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.ALTERGUARDIAN_PHASE2.DEAD
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.ALTERGUARDIAN_PHASE2.DEAD"
msgid "At least now I can get a better look at it!"
msgstr "Hé, au moins, je peux le regarder de plus près !"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.ALTERGUARDIAN_PHASE2.GENERIC
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.ALTERGUARDIAN_PHASE2.GENERIC"
msgid "I'm starting to think they might be mad at us, Woby."
msgstr "Je commence à me dire qu'il nous en veut un peu, Woby."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.ALTERGUARDIAN_PHASE2SPIKE
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.ALTERGUARDIAN_PHASE2SPIKE"
msgid "I think they're trying to keep us from getting away!"
msgstr "Je crois qu'il ne veut pas qu'on s'enfuie."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.ALTERGUARDIAN_PHASE3
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.ALTERGUARDIAN_PHASE3"
msgid "If I just get a bit closer... I'm sure I can convince them we just want to be friends!"
msgstr "Si j'arrivais à me rapprocher... je suis sûr qu'on pourrait devenir copains !"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.ALTERGUARDIAN_PHASE3DEAD
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.ALTERGUARDIAN_PHASE3DEAD"
msgid "Well... I guess that's that."
msgstr "Bon... Ça c'est fait."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.ALTERGUARDIAN_PHASE3DEADORB
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.ALTERGUARDIAN_PHASE3DEADORB"
msgid "Do you think they're going to get up again, Woby?"
msgstr "Tu crois qu'il va se relever, Woby ?"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.ALTERGUARDIAN_PHASE3TRAP
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.ALTERGUARDIAN_PHASE3TRAP"
msgid "We should probably stay away from those, Woby."
msgstr "On devrait éviter de s'en approcher, Woby."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.ALTERGUARDIAN_PHASE4_LUNARRIFT
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.ALTERGUARDIAN_PHASE4_LUNARRIFT"
msgid "Has anyone asked why it's so upset?"
msgstr "On sait pourquoi il est si en colère ?"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.AMULET
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.AMULET"
msgid "I'm invincible!!"
msgstr "Je suis invincible !!"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.ANCHOR
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.ANCHOR"
msgid "That's another important boat part."
msgstr "C'est une autre partie importante du bateau."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.ANCHOR_ITEM
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.ANCHOR_ITEM"
msgid "I've got all the supplies ready to build an anchor."
msgstr "J'ai tout ce qu'il faut pour construire une ancre."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.ANCIENTFRUIT_GEM
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.ANCIENTFRUIT_GEM"
msgid "Is this really a fruit? It's as hard as a rock!"
msgstr "C'est vraiment un fruit ? C'est aussi dur qu'un caillou !"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.ANCIENTFRUIT_NIGHTVISION
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.ANCIENTFRUIT_NIGHTVISION"
msgid "Did you ever hear the story about the disembodied heart that kept beating?"
msgstr "Tu as déjà entendu l'histoire du cœur désincarné encore battant ?"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.ANCIENTFRUIT_NIGHTVISION_COOKED
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.ANCIENTFRUIT_NIGHTVISION_COOKED"
msgid "It was more exciting when it was moving."
msgstr "C'était mieux quand ça bougeait."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.ANCIENTTREE_GEM.GENERIC
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.ANCIENTTREE_GEM.GENERIC"
msgid "Neat! I wonder how the tree keeps from catching fire?"
msgstr "Cool ! Je me demande comment l'arbre fait pour pas prendre feu."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.ANCIENTTREE_GEM.STUMP
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.ANCIENTTREE_GEM.STUMP"
msgid "Is that a rock? No wait, it's a stump!"
msgstr "C'est un rocher ? Oh, non, c'est une souche !"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.ANCIENTTREE_NIGHTVISION.GENERIC
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.ANCIENTTREE_NIGHTVISION.GENERIC"
msgid "It looks kind of like a monster... but I think it's just a tree."
msgstr "Ça ressemble un peu à un monstre... mais je crois que c'est juste un arbre."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.ANCIENTTREE_NIGHTVISION.STUMP
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.ANCIENTTREE_NIGHTVISION.STUMP"
msgid "Aww, I liked that tree..."
msgstr "Oh, j'aimais bien cet arbre..."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.ANCIENTTREE_SAPLING.GENERIC
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.ANCIENTTREE_SAPLING.GENERIC"
msgid "I can't wait to see what kind of tree it grows into!"
msgstr "J'ai trop hâte de voir le genre d'arbre que ça va devenir !"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.ANCIENTTREE_SAPLING.WRONG_SEASON
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.ANCIENTTREE_SAPLING.WRONG_SEASON"
msgid "It seems happy there, I guess now I just need to be patient."
msgstr "Elle a l'air contente ici. Il va falloir être patient."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.ANCIENTTREE_SAPLING.WRONG_TILE
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.ANCIENTTREE_SAPLING.WRONG_TILE"
msgid "It just doesn't seem to want to grow here."
msgstr "Je crois qu'elle veut pas pousser ici."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.ANCIENTTREE_SAPLING_ITEM
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.ANCIENTTREE_SAPLING_ITEM"
msgid "Sniff out a good spot for us to plant the tree, Woby!"
msgstr "Trouve-nous un bon endroit où planter l'arbre, Woby !"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.ANCIENTTREE_SEED
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.ANCIENTTREE_SEED"
msgid "I need to find just the right spot for this."
msgstr "Il faut juste que je trouve le bon endroit."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.ANCIENT_ALTAR
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.ANCIENT_ALTAR"
msgid "Do you think aliens helped them make it?"
msgstr "Vous croyez que c'est des extraterrestres qui l'ont fait ?"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.ANCIENT_ALTAR_BROKEN
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.ANCIENT_ALTAR_BROKEN"
msgid "It looks broken to me."
msgstr "Il a l'air cassé."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.ANCIENT_HUSK
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.ANCIENT_HUSK"
msgid "It makes me feel bad too, Woby."
msgstr "Moi aussi, ça me rend triste, Woby."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.ANCIENT_STATUE
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.ANCIENT_STATUE"
msgid "Woah! Is this what they looked like?"
msgstr "Ouah ! C'est à ça qu'ils ressemblaient ?"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.ANIMAL_TRACK
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.ANIMAL_TRACK"
msgid "Tracks! They go this way!"
msgstr "Des traces ! Il est allé par là !"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.ANTCHOVIES
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.ANTCHOVIES"
msgid "I have mixed feelings."
msgstr "J'ai un doute, là."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.ANTLION.GENERIC
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.ANTLION.GENERIC"
msgid "Hi!"
msgstr "Salut !"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.ANTLION.UNHAPPY
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.ANTLION.UNHAPPY"
msgid "It's hard to read her expression..."
msgstr "Difficile de savoir ce qu'elle pense..."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.ANTLION.VERYHAPPY
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.ANTLION.VERYHAPPY"
msgid "We're becoming pals already."
msgstr "On est déjà devenus potes !"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.ANTLIONHAT
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.ANTLIONHAT"
msgid "I've always wanted to look like bug royalty!"
msgstr "J'ai toujours voulu ressembler à un roi des insectes !"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.ANTLIONTRINKET
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.ANTLIONTRINKET"
msgid "Hm, I guess I could give it away as a gift?"
msgstr "Hmm... Je pourrais l'offrir ?"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.ARCHIVE_CENTIPEDE
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.ARCHIVE_CENTIPEDE"
msgid "Maybe it's friendly?"
msgstr "Il est peut-être gentil ?"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.ARCHIVE_CENTIPEDE_HUSK
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.ARCHIVE_CENTIPEDE_HUSK"
msgid "I don't think it's worked in a long time."
msgstr "Je crois que ça n'a pas marché depuis très longtemps."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.ARCHIVE_COOKPOT.BURNT
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.ARCHIVE_COOKPOT.BURNT"
msgid "It's uh... extra done!"
msgstr "C'est, euh... Bien bien cuit !"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.ARCHIVE_COOKPOT.COOKING_LONG
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.ARCHIVE_COOKPOT.COOKING_LONG"
msgid "This might take a while. Wanna see this cool bug I found in the meantime?"
msgstr "Ça risque de prendre du temps. En attendant, vous voulez voir le super insecte que j'ai trouvé ?"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.ARCHIVE_COOKPOT.COOKING_SHORT
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.ARCHIVE_COOKPOT.COOKING_SHORT"
msgid "Almost time to eat!"
msgstr "C'est presque l'heure de manger !"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.ARCHIVE_COOKPOT.DONE
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.ARCHIVE_COOKPOT.DONE"
msgid "Come and get it!"
msgstr "Servez-vous !"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.ARCHIVE_COOKPOT.EMPTY
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.ARCHIVE_COOKPOT.EMPTY"
msgid "They weren't so different from us, were they?"
msgstr "J'ai l'impression qu'on se ressemblait beaucoup, finalement."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.ARCHIVE_LOCKBOX
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.ARCHIVE_LOCKBOX"
msgid "I wish it came with instructions..."
msgstr "J'aurais bien aimé trouver le mode d'emploi..."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.ARCHIVE_LOCKBOX_DISPENCER.GENERIC
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.ARCHIVE_LOCKBOX_DISPENCER.GENERIC"
msgid "That glass part looks kind of familiar."
msgstr "Cette partie en verre me dit un truc."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.ARCHIVE_LOCKBOX_DISPENCER.POWEROFF
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.ARCHIVE_LOCKBOX_DISPENCER.POWEROFF"
msgid "I wonder what they used it for."
msgstr "Je me demande à quoi ça servait."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.ARCHIVE_MOON_STATUE
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.ARCHIVE_MOON_STATUE"
msgid "Well, they look happier than the statues outside... I think."
msgstr "Eh bien... J'ai l'impression qu'ils ont l'air plus contents que les statues qui sont à l'extérieur."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.ARCHIVE_ORCHESTRINA_MAIN
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.ARCHIVE_ORCHESTRINA_MAIN"
msgid "Wanna solve a puzzle, Woby?"
msgstr "Tu veux résoudre une énigme, Woby ?"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.ARCHIVE_PORTAL.GENERIC
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.ARCHIVE_PORTAL.GENERIC"
msgid "Weird, this is the only thing that didn't turn back on."
msgstr "C'est bizarre... C'est le seul truc qui s'est pas réactivé."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.ARCHIVE_PORTAL.POWEROFF
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.ARCHIVE_PORTAL.POWEROFF"
msgid "I wonder what this did?"
msgstr "Je me demande ce que ça faisait."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.ARCHIVE_RESONATOR.GENERIC
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.ARCHIVE_RESONATOR.GENERIC"
msgid "I guess it's kind of like a compass."
msgstr "Ça ressemble à une boussole."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.ARCHIVE_RESONATOR.IDLE
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.ARCHIVE_RESONATOR.IDLE"
msgid "We must've found them all!"
msgstr "On a dû tous les trouver !"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.ARCHIVE_RESONATOR_ITEM
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.ARCHIVE_RESONATOR_ITEM"
msgid "It must do something important."
msgstr "Ça doit faire un truc important."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.ARCHIVE_RUNE_STATUE.LINE_1
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.ARCHIVE_RUNE_STATUE.LINE_1"
msgid "I sure wish I could read it."
msgstr "J'aurais bien aimé pouvoir le lire."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.ARCHIVE_RUNE_STATUE.LINE_2
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.ARCHIVE_RUNE_STATUE.LINE_2"
msgid "I wonder what it says."
msgstr "Je me demande ce que ça dit."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.ARCHIVE_RUNE_STATUE.LINE_3
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.ARCHIVE_RUNE_STATUE.LINE_3"
msgid "I sure wish I could read it."
msgstr "J'aurais bien aimé pouvoir le lire."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.ARCHIVE_RUNE_STATUE.LINE_4
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.ARCHIVE_RUNE_STATUE.LINE_4"
msgid "I wonder what it says."
msgstr "Je me demande ce que ça dit."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.ARCHIVE_RUNE_STATUE.LINE_5
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.ARCHIVE_RUNE_STATUE.LINE_5"
msgid "I sure wish I could read it."
msgstr "J'aurais bien aimé pouvoir le lire."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.ARCHIVE_SECURITY_DESK.GENERIC
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.ARCHIVE_SECURITY_DESK.GENERIC"
msgid "Any respectable ancient ruin should have some kind of traps."
msgstr "Il y a toujours des pièges dans des ruines dignes de ce nom."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.ARCHIVE_SECURITY_DESK.POWEROFF
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.ARCHIVE_SECURITY_DESK.POWEROFF"
msgid "It doesn't seem to work anymore."
msgstr "J'ai l'impression que ça marche plus."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.ARCHIVE_SECURITY_PULSE
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.ARCHIVE_SECURITY_PULSE"
msgid "Come on Woby, let's see where it goes!"
msgstr "Allez viens, Woby ! On va voir où ça mène !"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.ARCHIVE_SWITCH.GEMS
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.ARCHIVE_SWITCH.GEMS"
msgid "There's something missing..."
msgstr "Il manque quelque chose..."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.ARCHIVE_SWITCH.VALID
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.ARCHIVE_SWITCH.VALID"
msgid "I think these gems might be important, Woby!"
msgstr "Je crois que ces gemmes sont importantes, Woby !"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.ARMORDRAGONFLY
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.ARMORDRAGONFLY"
msgid "I still wish we could've been friends..."
msgstr "J'aurais aimé qu'on devienne amis..."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.ARMORDREADSTONE
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.ARMORDREADSTONE"
msgid "It looks like an evil knight's armor. Neat!"
msgstr "On dirait l'armure d'un chevalier maléfique. Trop cool !"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.ARMORGRASS
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.ARMORGRASS"
msgid "Smells like a freshly mowed lawn."
msgstr "Ça sent la pelouse qui vient d'être tondue."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.ARMORMARBLE
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.ARMORMARBLE"
msgid "Will I be able to walk in that?"
msgstr "Je vais pouvoir marcher là-dedans ?"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.ARMORRUINS
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.ARMORRUINS"
msgid "Woah! It's not even heavy!"
msgstr "Ouah ! C'est même pas lourd !"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.ARMORSKELETON
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.ARMORSKELETON"
msgid "Yessss bone armor!!"
msgstr "Wouhouuu ! Une armure d'os !!"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.ARMORSLURPER
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.ARMORSLURPER"
msgid "The smell kind of ruins my appetite."
msgstr "L'odeur me coupe l'appétit."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.ARMORSNURTLESHELL
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.ARMORSNURTLESHELL"
msgid "I'm the terrifying snail boy! Part boy, part snail!"
msgstr "Je suis le terrifiant escarg-homme ! Moitié homme, moitié escargot !"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.ARMORWAGPUNK
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.ARMORWAGPUNK"
msgid "I'll be part boy, part machine!"
msgstr "Je vais devenir moitié garçon, moitié machine !"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.ARMORWOOD
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.ARMORWOOD"
msgid "Trees are pretty useful."
msgstr "Les arbres sont plutôt utiles."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.ARMOR_BRAMBLE
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.ARMOR_BRAMBLE"
msgid "No hugging while you're wearing that."
msgstr "Pas de câlin quand on porte ça."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.ARMOR_CARROTLURE
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.ARMOR_CARROTLURE"
msgid "Nice VESTable! Get it, Woby?"
msgstr "Super GILET-gumes ! T'as compris, Woby ?"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.ARMOR_LUNARPLANT
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.ARMOR_LUNARPLANT"
msgid "It makes me feel so safe, it's scary!"
msgstr "Elle me donne tellement l'impression d'être en sécurité que c'est flippant !"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.ARMOR_LUNARPLANT_HUSK
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.ARMOR_LUNARPLANT_HUSK"
msgid "Aww. Why don't I get to wear it?"
msgstr "Oh. Pourquoi je peux pas la porter ?"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.ARMOR_SANITY
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.ARMOR_SANITY"
msgid "Wait... is this dangerous?"
msgstr "Attendez... c'est dangereux ?"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.ARMOR_VOIDCLOTH
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.ARMOR_VOIDCLOTH"
msgid "It almost looks like it has a face, doesn't it?"
msgstr "On dirait presque qu'elle a un visage, non ?"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.ARMOR_YOTH_KNIGHT
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.ARMOR_YOTH_KNIGHT"
msgid "Now I'm really stallion!"
msgstr "Je suis un vrai cavalier !"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.ARROWSIGN_PANEL.BURNT
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.ARROWSIGN_PANEL.BURNT"
msgid "Hopefully it didn't say anything important."
msgstr "Heureusement que ça n'indiquait rien d'important."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.ARROWSIGN_PANEL.GENERIC
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.ARROWSIGN_PANEL.GENERIC"
msgid "Someone has bad handwriting."
msgstr "Quelqu'un écrit comme un cochon..."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.ARROWSIGN_PANEL.UNWRITTEN
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.ARROWSIGN_PANEL.UNWRITTEN"
msgid "Well... I guess SOMETHING is in that direction."
msgstr "Bon... Il y a sûrement QUELQUE CHOSE par là."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.ARROWSIGN_POST.BURNT
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.ARROWSIGN_POST.BURNT"
msgid "Hopefully it didn't say anything important."
msgstr "Heureusement que ça n'indiquait rien d'important."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.ARROWSIGN_POST.GENERIC
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.ARROWSIGN_POST.GENERIC"
msgid "Someone has bad handwriting."
msgstr "Quelqu'un écrit comme un cochon..."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.ARROWSIGN_POST.UNWRITTEN
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.ARROWSIGN_POST.UNWRITTEN"
msgid "Well... I guess SOMETHING is in that direction."
msgstr "Bon... Il y a sûrement QUELQUE CHOSE par là."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.ASH.GENERIC
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.ASH.GENERIC"
msgid "Did someone have a campfire without me?"
msgstr "Quelqu'un a allumé un feu de camp sans moi ?"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.ASH.REMAINS_EYE_BONE
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.ASH.REMAINS_EYE_BONE"
msgid "Aw, I liked that thing!"
msgstr "Han, mais je l'aimais bien !"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.ASH.REMAINS_GLOMMERFLOWER
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.ASH.REMAINS_GLOMMERFLOWER"
msgid "Too bad."
msgstr "Dommage."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.ASH.REMAINS_THINGIE
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.ASH.REMAINS_THINGIE"
msgid "Now I'll never know what it was..."
msgstr "Je saurai jamais ce que c'était..."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.ASPARAGUS
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.ASPARAGUS"
msgid "It's not my favourite."
msgstr "C'est pas ce que je préfère."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.ASPARAGUSSOUP
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.ASPARAGUSSOUP"
msgid "Asparagus again? Er, not that I'm complaining..."
msgstr "Encore des asperges ? Euh... Non, je me plains pas, hein."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.ASPARAGUS_COOKED
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.ASPARAGUS_COOKED"
msgid "I'll eat my vegetables."
msgstr "Je mangerai tous mes légumes."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.ASPARAGUS_OVERSIZED
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.ASPARAGUS_OVERSIZED"
msgid "Oh... that's a lot of asparagus..."
msgstr "Oh... Euh... Ça fait beaucoup d'asperges..."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.ASPARAGUS_SEEDS
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.ASPARAGUS_SEEDS"
msgid "Where should we plant them, Woby?"
msgstr "Où on devrait les planter, Woby ?"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.ATRIUM_GATE.CHARGING
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.ATRIUM_GATE.CHARGING"
msgid "I guess we'll have to wait for it to power up."
msgstr "Il va falloir qu'on attende que ça se charge."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.ATRIUM_GATE.COOLDOWN
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.ATRIUM_GATE.COOLDOWN"
msgid "I guess I should give it a rest for now."
msgstr "Je pense qu'il faut le laisser tranquille pour le moment."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.ATRIUM_GATE.DESTABILIZING
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.ATRIUM_GATE.DESTABILIZING"
msgid "Is it supposed to be making that sound?"
msgstr "C'est vraiment censé faire ce bruit ?"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.ATRIUM_GATE.OFF
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.ATRIUM_GATE.OFF"
msgid "It looks like it's missing a piece."
msgstr "J'ai l'impression qu'il manque un morceau."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.ATRIUM_GATE.ON
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.ATRIUM_GATE.ON"
msgid "It's working!"
msgstr "Ça marche !"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.ATRIUM_KEY
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.ATRIUM_KEY"
msgid "It's the key to this whole mystery!"
msgstr "C'est la clé de tout ce mystère !"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.ATRIUM_LIGHT.OFF
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.ATRIUM_LIGHT.OFF"
msgid "There's got to be a way to turn it on."
msgstr "Il y a sûrement un moyen de l'allumer."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.ATRIUM_LIGHT.ON
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.ATRIUM_LIGHT.ON"
msgid "Well, we got the lights working!"
msgstr "Bon, les lampes fonctionnent !"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.ATRIUM_OVERGROWTH
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.ATRIUM_OVERGROWTH"
msgid "What does it mean?!"
msgstr "Qu'est-ce que ça veut dire ?!"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.ATRIUM_RUBBLE.LINE_1
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.ATRIUM_RUBBLE.LINE_1"
msgid "It looks like things weren't going so well for the people here."
msgstr "J'ai l'impression que tout se passe pas trop bien pour les gens d'ici."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.ATRIUM_RUBBLE.LINE_2
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.ATRIUM_RUBBLE.LINE_2"
msgid "I can't tell what's happening in this one, the picture's worn off."
msgstr "Je sais pas ce qu'il se passe dans celui-là. C'est tout usé."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.ATRIUM_RUBBLE.LINE_3
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.ATRIUM_RUBBLE.LINE_3"
msgid "There's... a shadow? Or something... they took some artistic liberties."
msgstr "Il y a... une ombre ? Ou un... truc... Ils ont pris des libertés artistiques."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.ATRIUM_RUBBLE.LINE_4
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.ATRIUM_RUBBLE.LINE_4"
msgid "Woah, looks like they all started changing."
msgstr "Ouah, apparemment, ils se sont tous mis à changer."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.ATRIUM_RUBBLE.LINE_5
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.ATRIUM_RUBBLE.LINE_5"
msgid "That must be what the city looked like a long time ago."
msgstr "La ville devait ressembler à ça, il y a très longtemps."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.ATRIUM_STATUE
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.ATRIUM_STATUE"
msgid "If it could speak, I wonder what it would tell us."
msgstr "Si elle pouvait parler, je me demande ce qu'elle nous raconterait."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.AXE
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.AXE"
msgid "The favoured tool of axe murderers and loggers."
msgstr "L'outil préféré des assassins à la hache et aux bûcherons."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.BABYBEEFALO.GENERIC
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.BABYBEEFALO.GENERIC"
msgid "Hey little guy!"
msgstr "Salut, petit !"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.BABYBEEFALO.SLEEPING
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.BABYBEEFALO.SLEEPING"
msgid "Shhh! Woby, they're sleeping!"
msgstr "Chut, Woby ! Il dort !"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.BACKPACK
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.BACKPACK"
msgid "Perfect for carrying supplies! And bugs!"
msgstr "C'est parfait pour y mettre des provisions. Et des insectes !"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.BACONEGGS
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.BACONEGGS"
msgid "A good camping breakfast."
msgstr "Un bon petit-déjeuner de camping."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.BALATRO_MACHINE
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.BALATRO_MACHINE"
msgid "Woby, let's take paws and play a few hands. Oh, Walter!"
msgstr "Woby, au lieu de traîner la patte, jouons quelques mains. Oh, Walter !"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.BALLOON
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.BALLOON"
msgid "My keen tracking senses are telling me there's a clown nearby."
msgstr "Mes sens de traqueur me disent qu'il y a un clown près d'ici."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.BALLOONHAT
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.BALLOONHAT"
msgid "I'm a bit too old for this kind of thing."
msgstr "Je suis un peu trop vieux pour ce genre de truc."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.BALLOONPARTY
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.BALLOONPARTY"
msgid "Is someone having a party?"
msgstr "Il y a une fête quelque part ?"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.BALLOONSPEED.DEFLATED
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.BALLOONSPEED.DEFLATED"
msgid "It's pretty much just a regular balloon now."
msgstr "Bon ben, c'est juste un ballon, maintenant."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.BALLOONSPEED.GENERIC
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.BALLOONSPEED.GENERIC"
msgid "Clowns have strange and mysterious ways..."
msgstr "Les voies des clowns sont impénétrables..."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.BALLOONS_EMPTY
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.BALLOONS_EMPTY"
msgid "Someone left litter here!"
msgstr "Quelqu'un a laissé des ordures ici !"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.BALLOONVEST
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.BALLOONVEST"
msgid "I guess it's better than not having a life jacket at all..."
msgstr "J'imagine que c'est mieux que de pas avoir de gilet de sauvetage du tout..."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.BANANABUSH
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.BANANABUSH"
msgid "Wait, I thought bananas grew on trees around here?"
msgstr "Attendez, je croyais que les bananes poussaient sur les arbres, ici !"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.BANANAJUICE
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.BANANAJUICE"
msgid "Mmm, it's even better than the ones they made at the malted shop!"
msgstr "Mmh, c'est encore meilleur que ceux de la boutique au coin de ma rue !"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.BANANAPOP
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.BANANAPOP"
msgid "Those are for little kids. But bananas are healthy so I guess it's alright."
msgstr "C'est pour les enfants. Mais les bananes sont bonnes pour la santé, alors ça va."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.BANDAGE
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.BANDAGE"
msgid "You can never be too prepared when you're out in the wilderness."
msgstr "On n'est jamais trop préparé pour aller dans la nature."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.BANDAGE_BUTTERFLYWINGS
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.BANDAGE_BUTTERFLYWINGS"
msgid "It's made from butterfly wings! Cute! And a little sad."
msgstr "C'est fait avec des ailes de papillon ! Trop mignon ! Et triste."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.BARNACLE
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.BARNACLE"
msgid "Foraged from the sea!"
msgstr "Récolté dans la mer !"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.BARNACLEPITA
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.BARNACLEPITA"
msgid "Further proof that anything can be a sandwich."
msgstr "Encore une preuve que tout peut se manger en sandwich."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.BARNACLESTUFFEDFISHHEAD
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.BARNACLESTUFFEDFISHHEAD"
msgid "Uhh Woby? Do you want this one?"
msgstr "Euh... Woby ? Tu veux ça ?"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.BARNACLESUSHI
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.BARNACLESUSHI"
msgid "It's... interesting."
msgstr "C'est... intéressant."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.BARNACLE_COOKED
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.BARNACLE_COOKED"
msgid "Hmm, it's not bad!"
msgstr "Hmm, c'est pas mal !"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.BARNACLINGUINE
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.BARNACLINGUINE"
msgid "Just about anything tastes good with pasta."
msgstr "Tout est bon avec des pâtes."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.BASALT
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.BASALT"
msgid "I don't think we'll be able to break through that."
msgstr "Je ne pense pas qu'on réussira à briser ce truc."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.BAT
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.BAT"
msgid "Maybe if we're lucky it'll turn into a vampire!"
msgstr "Avec un peu de chance, elle se transformera en vampire !"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.BATBAT
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.BATBAT"
msgid "Bat 'er up!"
msgstr "Je suis batte-man !"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.BATCAVE
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.BATCAVE"
msgid "Looks like they're sleeping. Should we wake them up?"
msgstr "On dirait qu'elles dorment. On les réveille ?"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.BATHBOMB
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.BATHBOMB"
msgid "It smells pretty good."
msgstr "Ça sent bon."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.BATNOSE
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.BATNOSE"
msgid "Looks like someone got a bit nosy. Get it? Because it's a nose?"
msgstr "On dirait que quelqu'un met son nez partout... En même temps, vu la taille du nez..."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.BATNOSEHAT
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.BATNOSEHAT"
msgid "Milk is good for your skeleton!"
msgstr "Le lait renforce les os !"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.BATNOSE_COOKED
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.BATNOSE_COOKED"
msgid "It sure doesn't smell so good now..."
msgstr "Ça sent quand même pas terrible..."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.BATTLESONG_CONTAINER
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.BATTLESONG_CONTAINER"
msgid "It's like a special backpack for songs!"
msgstr "On dirait un sac à dos spécial pour chansons !"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.BATTLESONG_DURABILITY
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.BATTLESONG_DURABILITY"
msgid "This seems a bit more complicated than the songs I learned in the Pioneers."
msgstr "Ça a l'air un peu plus compliqué que les chansons qu'on apprenait chez les Scouts toujours."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.BATTLESONG_FIRERESISTANCE
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.BATTLESONG_FIRERESISTANCE"
msgid "This seems a bit more complicated than the songs I learned in the Pioneers."
msgstr "Ça a l'air un peu plus compliqué que les chansons qu'on apprenait chez les Scouts toujours."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.BATTLESONG_HEALTHGAIN
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.BATTLESONG_HEALTHGAIN"
msgid "This seems a bit more complicated than the songs I learned in the Pioneers."
msgstr "Ça a l'air un peu plus compliqué que les chansons qu'on apprenait chez les Scouts toujours."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.BATTLESONG_INSTANT_PANIC
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.BATTLESONG_INSTANT_PANIC"
msgid "This story could use a few more monsters."
msgstr "Cette histoire manque de monstres."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.BATTLESONG_INSTANT_REVIVE
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.BATTLESONG_INSTANT_REVIVE"
msgid "This seems a bit more complicated than the songs I learned in the Pioneers."
msgstr "Ça a l'air un peu plus compliqué que les chansons qu'on apprenait chez les Scouts toujours."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.BATTLESONG_INSTANT_TAUNT
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.BATTLESONG_INSTANT_TAUNT"
msgid "This story could use a few more monsters."
msgstr "Cette histoire manque de monstres."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.BATTLESONG_LUNARALIGNED
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.BATTLESONG_LUNARALIGNED"
msgid "This seems a bit more complicated than the songs I learned in the Pioneers."
msgstr "Ça a l'air un peu plus compliqué que les chansons qu'on apprenait chez les Scouts toujours."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.BATTLESONG_SANITYAURA
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.BATTLESONG_SANITYAURA"
msgid "This seems a bit more complicated than the songs I learned in the Pioneers."
msgstr "Ça a l'air un peu plus compliqué que les chansons qu'on apprenait chez les Scouts toujours."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.BATTLESONG_SANITYGAIN
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.BATTLESONG_SANITYGAIN"
msgid "This seems a bit more complicated than the songs I learned in the Pioneers."
msgstr "Ça a l'air un peu plus compliqué que les chansons qu'on apprenait chez les Scouts toujours."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.BATTLESONG_SHADOWALIGNED
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.BATTLESONG_SHADOWALIGNED"
msgid "This seems a bit more complicated than the songs I learned in the Pioneers."
msgstr "Ça a l'air un peu plus compliqué que les chansons qu'on apprenait chez les Scouts toujours."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.BATWING
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.BATWING"
msgid "Where did the rest of the bat go?"
msgstr "Où est le reste de la chauve-souris ?"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.BATWING_COOKED
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.BATWING_COOKED"
msgid "Uh... Woby, do you want this?"
msgstr "Euh... Woby, tu en veux ?"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.BEARDHAIR
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.BEARDHAIR"
msgid "Aw, I thought it was yeti fur..."
msgstr "Han, j'ai cru que c'était de la fourrure de yéti."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.BEARGER
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.BEARGER"
msgid "Look at those razor sharp claws! I need to get a closer view!"
msgstr "Regardez ces griffes acérées ! Il faut que je les regarde de plus près !"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.BEARGERCORPSE.BURNING
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.BEARGERCORPSE.BURNING"
msgid "This isn't a fun campfire..."
msgstr "Ce feu de camp est vraiment pas drôle..."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.BEARGERCORPSE.GENERIC
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.BEARGERCORPSE.GENERIC"
msgid "I'm sorry..."
msgstr "Désolé..."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.BEARGERCORPSE.REVIVING
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.BEARGERCORPSE.REVIVING"
msgid "Back from the dead!"
msgstr "De retour d'entre les morts !"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.BEARGERFUR_SACK
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.BEARGERFUR_SACK"
msgid "We can keep our snacks cold when we go exploring, Woby!"
msgstr "Woby, on va pouvoir garder notre goûter au frais pendant nos explorations !"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.BEARGERVEST
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.BEARGERVEST"
msgid "Hey Woby, we match!"
msgstr "Hé, on est assortis, Woby !"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.BEARGER_FUR
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.BEARGER_FUR"
msgid "It's so soft!"
msgstr "C'est tout doux !"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.BEAST_BLUEPRINT
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.BEAST_BLUEPRINT"
msgid "I wonder what kind of animal this costume is based off of?"
msgstr "Je me demande sur quelle bestiole se base ce costume."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.BEDROLL_FURRY
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.BEDROLL_FURRY"
msgid "It feels nice, like cuddling up with Woby."
msgstr "C'est agréable. C'est comme faire un câlin à Woby."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.BEDROLL_STRAW
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.BEDROLL_STRAW"
msgid "You make due with what you have out in the wilderness."
msgstr "Il faut faire avec ce qu'on a dans la nature."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.BEE.GENERIC
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.BEE.GENERIC"
msgid "Heh... sure wish I wasn't deathly allergic to them!"
msgstr "Hé... J'aimerais vraiment ne pas y être mortellement allergique."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.BEE.HELD
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.BEE.HELD"
msgid "Ha ha... you wouldn't sting me... right little guy?"
msgstr "Ha ha... Tu me piquerais pas, quand même ? Hein, petite ?"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.BEEBOX.BURNT
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.BEEBOX.BURNT"
msgid "What! Who burned the hive?"
msgstr "Hein ?! Qui a brûlé la ruche ?"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.BEEBOX.FULLHONEY
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.BEEBOX.FULLHONEY"
msgid "Look at all that honey!"
msgstr "Regardez tout ce miel !"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.BEEBOX.GENERIC
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.BEEBOX.GENERIC"
msgid "Oh bees, why can't we be friends..."
msgstr "Oh, pourquoi on peut pas être amis, petites abeilles ?"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.BEEBOX.NOHONEY
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.BEEBOX.NOHONEY"
msgid "They need a bit more time."
msgstr "Elles ont besoin d'un peu plus de temps."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.BEEBOX.READY
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.BEEBOX.READY"
msgid "Look at all that honey!"
msgstr "Regardez tout ce miel !"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.BEEBOX.SOMEHONEY
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.BEEBOX.SOMEHONEY"
msgid "They're still busy making honey."
msgstr "Elles sont encore occupées à faire du miel."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.BEEBOX_HERMIT.BURNT
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.BEEBOX_HERMIT.BURNT"
msgid "It burned up!"
msgstr "Ça a brûlé !"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.BEEBOX_HERMIT.FULLHONEY
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.BEEBOX_HERMIT.FULLHONEY"
msgid "M-ma'am, I think your honey is ready."
msgstr "M-Madame ? Je crois que votre miel est prêt."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.BEEBOX_HERMIT.GENERIC
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.BEEBOX_HERMIT.GENERIC"
msgid "Don't panic Walter, the bees smell your fear..."
msgstr "Panique pas, Walter. Les abeilles sentent la peur..."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.BEEBOX_HERMIT.NOHONEY
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.BEEBOX_HERMIT.NOHONEY"
msgid "It doesn't look like they've made any honey."
msgstr "J'ai pas l'impression qu'elles ont fait du miel."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.BEEBOX_HERMIT.READY
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.BEEBOX_HERMIT.READY"
msgid "M-ma'am, I think your honey is ready."
msgstr "M-Madame ? Je crois que votre miel est prêt."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.BEEBOX_HERMIT.SOMEHONEY
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.BEEBOX_HERMIT.SOMEHONEY"
msgid "There's some honey, but not enough to be worth the stings."
msgstr "Il y a un peu de miel, mais pas assez pour risquer de se faire piquer."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.BEEFALO.DEAD
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.BEEFALO.DEAD"
msgid "Poor beefalo."
msgstr "Pauvre bœufalo."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.BEEFALO.DEAD_MYPARTNER
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.BEEFALO.DEAD_MYPARTNER"
msgid "D-don't worry! I know first aid!"
msgstr "T-t'en fais pas, je sais procurer les premiers soins !"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.BEEFALO.DOMESTICATED
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.BEEFALO.DOMESTICATED"
msgid "He's almost as friendly as Woby now."
msgstr "Il est presque aussi gentil que Woby, maintenant."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.BEEFALO.FOLLOWER
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.BEEFALO.FOLLOWER"
msgid "Look Woby, we made a new friend!"
msgstr "Regarde, Woby. On s'est fait un nouvel ami !"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.BEEFALO.GENERIC
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.BEEFALO.GENERIC"
msgid "He's almost as big as you are, Woby!"
msgstr "Il est presque aussi gros que toi, Woby !"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.BEEFALO.MYPARTNER
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.BEEFALO.MYPARTNER"
msgid "I'm glad you and Woby get along so well. We're like a team!"
msgstr "Je suis content que Woby et toi vous entendiez bien. On forme une super équipe !"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.BEEFALO.NAKED
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.BEEFALO.NAKED"
msgid "Don't worry Woby, I'd never do that to you... unless you had mats."
msgstr "Ne t'en fais pas, Woby, je ne te ferai jamais ça... Sauf si tu as des touillons."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.BEEFALO.ORNERY
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.BEEFALO.ORNERY"
msgid "Hey, what's wrong?"
msgstr "Hé, qu'y a-t-il ?"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.BEEFALO.PUDGY
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.BEEFALO.PUDGY"
msgid "We might need to cut back on the treats..."
msgstr "Il va falloir qu'on se calme sur les friandises..."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.BEEFALO.RIDER
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.BEEFALO.RIDER"
msgid "Wanna go for a ride?"
msgstr "Envie de faire un tour ?"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.BEEFALO.SLEEPING
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.BEEFALO.SLEEPING"
msgid "They're snoozing."
msgstr "Ça pionce."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.BEEFALOFEED
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.BEEFALOFEED"
msgid "Come here, beefalo! Dinner time!"
msgstr "Viens là, le bœufalo ! C'est l'heure de manger !"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.BEEFALOHAT
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.BEEFALOHAT"
msgid "It sure smells like beefalo..."
msgstr "Ça sent le bœufalo..."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.BEEFALOTREAT
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.BEEFALOTREAT"
msgid "Don't worry Woby, I'll get a treat for you too."
msgstr "T'en fais pas, Woby. Toi aussi tu auras une friandise."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.BEEFALOWOOL
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.BEEFALOWOOL"
msgid "Sorry, beefalo."
msgstr "Désolé, bœufalo."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.BEEFALO_GROOMER.BURNT
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.BEEFALO_GROOMER.BURNT"
msgid "We all need to be much more careful with fire."
msgstr "Il faut tous qu'on soit plus prudents avec le feu."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.BEEFALO_GROOMER.GENERIC
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.BEEFALO_GROOMER.GENERIC"
msgid "Woby doesn't like getting dressed up, but beefalo seem to!"
msgstr "Woby n'aime pas qu'on le déguise... Mais ce bœufalo, si !"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.BEEFALO_GROOMER.OCCUPIED
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.BEEFALO_GROOMER.OCCUPIED"
msgid "You're going to look great when we're done, just you wait!"
msgstr "Tu vas voir, tu seras super beau quand j'aurai fini !"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.BEEFALO_GROOMER_ITEM
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.BEEFALO_GROOMER_ITEM"
msgid "Better get this all set up."
msgstr "Va falloir installer tout ça d'abord."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.BEEF_BELL
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.BEEF_BELL"
msgid "The beefalo seem to really like the sound it makes!"
msgstr "Ce bœufalo a vraiment l'air d'apprécier quand je la fais sonner !"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.BEEGUARD
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.BEEGUARD"
msgid "They're just trying to protect their queen."
msgstr "Elles essaient juste de protéger leur reine."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.BEEHAT
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.BEEHAT"
msgid "I can finally walk among the bees!"
msgstr "Je peux enfin me promener parmi les abeilles !"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.BEEHIVE
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.BEEHIVE"
msgid "I reeaally shouldn't get closer..."
msgstr "Je ferais mieux de ne pas m'approcher..."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.BEEMINE
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.BEEMINE"
msgid "W-what could go wrong?"
msgstr "T-Tout ne peut que bien se passer, hein ?"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.BEEMINE_MAXWELL
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.BEEMINE_MAXWELL"
msgid "How do I get the mosquitoes out?"
msgstr "Comment je peux faire sortir les moustiques ?"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.BEEQUEEN
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.BEEQUEEN"
msgid "If I make friends with their queen, maybe the bees won't sting me!"
msgstr "Si je deviens ami avec leur reine, les abeilles ne me piqueront peut-être pas ?"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.BEEQUEENHIVE.GENERIC
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.BEEQUEENHIVE.GENERIC"
msgid "I shouldn't walk on that, I'll get my shoes sticky."
msgstr "Je ne devrais pas marcher là-dessus, mes chaussures vont être toutes collantes."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.BEEQUEENHIVE.GROWING
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.BEEQUEENHIVE.GROWING"
msgid "It looks bigger than it did yesterday..."
msgstr "Ça a l'air plus gros qu'hier..."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.BEEQUEENHIVEGROWN
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.BEEQUEENHIVEGROWN"
msgid "Woah, it's huge!"
msgstr "Ouah, c'est énorme !"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.BEESWAX
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.BEESWAX"
msgid "It's none of my beeswax. Heh..."
msgstr "J'en ai rien à cirer... Hé hé."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.BEESWAX_SPRAY
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.BEESWAX_SPRAY"
msgid "It looks kind of like my mom's perfume, but it sure doesn't smell like it."
msgstr "Ça ressemble au parfum de ma mère, mais ça sent pas du tout pareil."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.BEETLETAUR
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.BEETLETAUR"
msgid "I can smell him from here!"
msgstr "Je peux le sentir d'ici !"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.BELL
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.BELL"
msgid "What if we put it on your collar Woby?"
msgstr "Et si on la mettait au collier de Woby ?"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.BERNIE_ACTIVE
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.BERNIE_ACTIVE"
msgid "Woah! Is your bear haunted? Cursed?"
msgstr "Ouah ! Ton ours est hanté ? Ou maudit ?"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.BERNIE_BIG
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.BERNIE_BIG"
msgid "If you play with fire, you're gonna get Bernie'd. Heh..."
msgstr "Bernie vous regarde pendant que vous dormez..."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.BERNIE_INACTIVE.BROKEN
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.BERNIE_INACTIVE.BROKEN"
msgid "I-I'm sure we can fix him."
msgstr "J-Je suis sûr qu'on peut le réparer."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.BERNIE_INACTIVE.GENERIC
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.BERNIE_INACTIVE.GENERIC"
msgid "He burnt himself out."
msgstr "Il s'est épuisé."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.BERRIES
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.BERRIES"
msgid "They're not in the poisonous section of my handbook, must be safe!"
msgstr "Elles sont pas dans la catégorie « vénéneuse » dans mon manuel. Ça devrait être bon !"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.BERRIES_COOKED
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.BERRIES_COOKED"
msgid "Well, now I have hot berries."
msgstr "Bon ben, j'ai des baies chaudes."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.BERRIES_JUICY
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.BERRIES_JUICY"
msgid "Yes! These are the best kind!"
msgstr "Ouais, c'est les meilleures !"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.BERRIES_JUICY_COOKED
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.BERRIES_JUICY_COOKED"
msgid "I should eat these fast."
msgstr "Je devrais les manger vite."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.BERRYBUSH.BARREN
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.BERRYBUSH.BARREN"
msgid "My handbook says some kind of fertilizer should help."
msgstr "Selon mon manuel, de l'engrais devrait arranger les choses."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.BERRYBUSH.BURNING
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.BERRYBUSH.BURNING"
msgid "That's not a campfire..."
msgstr "Ce n'est pas un feu de camp..."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.BERRYBUSH.DISEASED
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.BERRYBUSH.DISEASED"
msgid "Uh, something's definitely wrong with it."
msgstr "Euh, il a un souci, je crois."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.BERRYBUSH.DISEASING
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.BERRYBUSH.DISEASING"
msgid "Is something wrong with it?"
msgstr "Il a un problème, non ?"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.BERRYBUSH.GENERIC
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.BERRYBUSH.GENERIC"
msgid "Foraging is an important wilderness skill!"
msgstr "La cueillette, c'est important pour survivre dans la nature !"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.BERRYBUSH.PICKED
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.BERRYBUSH.PICKED"
msgid "If I wait long enough, they'll grow back."
msgstr "Si j'attends assez longtemps, ça va repousser."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.BERRYBUSH.WITHERED
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.BERRYBUSH.WITHERED"
msgid "It's way too hot out for anything to grow."
msgstr "Il faut trop chaud pour que ça pousse."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.BERRYBUSH_JUICY.BARREN
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.BERRYBUSH_JUICY.BARREN"
msgid "It won't be making more berries anytime soon."
msgstr "Ça fera plus de baies pour un long moment."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.BERRYBUSH_JUICY.BURNING
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.BERRYBUSH_JUICY.BURNING"
msgid "That's not a campfire..."
msgstr "Ce n'est pas un feu de camp..."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.BERRYBUSH_JUICY.DISEASED
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.BERRYBUSH_JUICY.DISEASED"
msgid "Uh, something's definitely wrong with it."
msgstr "Euh, il a un souci, je crois."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.BERRYBUSH_JUICY.DISEASING
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.BERRYBUSH_JUICY.DISEASING"
msgid "Is something wrong with it?"
msgstr "Il a un problème, non ?"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.BERRYBUSH_JUICY.GENERIC
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.BERRYBUSH_JUICY.GENERIC"
msgid "They look so tasty..."
msgstr "Ça a l'air délicieux..."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.BERRYBUSH_JUICY.PICKED
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.BERRYBUSH_JUICY.PICKED"
msgid "More will grow soon."
msgstr "Ça repoussera bientôt."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.BERRYBUSH_JUICY.WITHERED
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.BERRYBUSH_JUICY.WITHERED"
msgid "I guess this isn't the season for berries."
msgstr "Ça doit pas être la saison des baies."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.BERRYSAUCE
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.BERRYSAUCE"
msgid "It somehow tastes even better than regular berries!"
msgstr "Bizarrement, c'est encore meilleur que les baies normales !"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.BIBINGKA
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.BIBINGKA"
msgid "Woah... where did we get the shaved coconut from?"
msgstr "Ouah... Où est-ce qu'on a trouvé de la noix de coco ?"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.BIGFOOT
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.BIGFOOT"
msgid "I knew he was real!"
msgstr "Je savais qu'il existait !"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.BIRCHNUTDRAKE
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.BIRCHNUTDRAKE"
msgid "Hey little guy! What's got you all worked up?"
msgstr "Hé, petit ! Qu'est-ce qui te contrarie comme ça ?"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.BIRDCAGE.DEAD
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.BIRDCAGE.DEAD"
msgid "I'm... a terrible pet owner..."
msgstr "Je suis... horrible."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.BIRDCAGE.GENERIC
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.BIRDCAGE.GENERIC"
msgid "Now we just need to catch a bird!"
msgstr "Il n'y a plus qu'à attraper un oiseau !"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.BIRDCAGE.HUNGRY
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.BIRDCAGE.HUNGRY"
msgid "We need some bird food!"
msgstr "On a besoin de nourriture pour oiseaux !"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.BIRDCAGE.OCCUPIED
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.BIRDCAGE.OCCUPIED"
msgid "Aw, you miss the trees don't you?"
msgstr "Oh, les arbres te manquent, non ?"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.BIRDCAGE.SKELETON
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.BIRDCAGE.SKELETON"
msgid "Someone should bury it."
msgstr "Il faudrait l'enterrer."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.BIRDCAGE.SLEEPING
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.BIRDCAGE.SLEEPING"
msgid "Are you sleeping?"
msgstr "Tu dors ?"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.BIRDCAGE.STARVING
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.BIRDCAGE.STARVING"
msgid "Oh no! Did we forget to feed you?"
msgstr "Oh non ! On a oublié de te donner à manger ?"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.BIRDCORPSE.BURNING
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.BIRDCORPSE.BURNING"
msgid "Smells kinda yummy."
msgstr "Ça me donne presque faim."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.BIRDCORPSE.GENERIC
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.BIRDCORPSE.GENERIC"
msgid "Stay away from it, Woby!"
msgstr "T'en approche pas, Woby !"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.BIRDCORPSE.REVIVING
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.BIRDCORPSE.REVIVING"
msgid "Yes! I knew it!"
msgstr "Ah, j'en étais sûr !"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.BIRDTRAP
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.BIRDTRAP"
msgid "A bird trap! Classic survival stuff!"
msgstr "Un piège à oiseaux ! C'est un truc classique de survie !"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.BIRD_EGG
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.BIRD_EGG"
msgid "Egg-cellent! Get it? Because... egg...?"
msgstr "Hmm, c'est délici-œuf ! Ha ha !"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.BIRD_EGG_COOKED
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.BIRD_EGG_COOKED"
msgid "Smells like breakfast is ready!"
msgstr "Le petit-déjeuner est prêt !"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.BIRD_MUTANT
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.BIRD_MUTANT"
msgid "Woah! That doesn't look like any of the birds in my handbook!"
msgstr "Ouah ! Ça ne ressemble pas aux oiseaux de mon manuel !"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.BIRD_MUTANT_SPITTER
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.BIRD_MUTANT_SPITTER"
msgid "Maybe it's a cardinal? A... really sick cardinal?"
msgstr "C'est peut-être un cardinal ? Qui serait... très malade ?"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.BISHOP
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.BISHOP"
msgid "It's a Martian!"
msgstr "C'est un martien !"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.BISHOP_CHARGE_HIT
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.BISHOP_CHARGE_HIT"
msgid "Ah!! Why?!"
msgstr "Ah ! Pourquoi ?!"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.BISHOP_NIGHTMARE
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.BISHOP_NIGHTMARE"
msgid "Oooh, look at that! What's that stuff oozing out of it?"
msgstr "Oooh, regardez ça ! C'est quoi ce truc qui en coule ?"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.BLACKFLAG
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.BLACKFLAG"
msgid "I should paint something friendly on it, so people know we're helpful pirates."
msgstr "Je devrais peindre quelque chose de gentil, dessus. Les gens verront qu'on est des pirates sympas !"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.BLOWDART_FIRE
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.BLOWDART_FIRE"
msgid "It's not as good as my slingshot, but it'll do the trick."
msgstr "C'est pas aussi bien que mon lance-pierres, mais ça fera l'affaire."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.BLOWDART_LAVA
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.BLOWDART_LAVA"
msgid "That's a weapon I could use from range."
msgstr "C'est une arme dont je pourrais me servir à distance."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.BLOWDART_LAVA2
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.BLOWDART_LAVA2"
msgid "It uses a strong blast of air to propel a projectile."
msgstr "Il faut souffler fort pour envoyer un projectile."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.BLOWDART_PIPE
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.BLOWDART_PIPE"
msgid "It's not as good as my slingshot, but it'll do the trick."
msgstr "C'est pas aussi bien que mon lance-pierres, mais ça fera l'affaire."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.BLOWDART_SLEEP
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.BLOWDART_SLEEP"
msgid "It's not as good as my slingshot, but it'll do the trick."
msgstr "C'est pas aussi bien que mon lance-pierres, mais ça fera l'affaire."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.BLOWDART_YELLOW
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.BLOWDART_YELLOW"
msgid "It's not as good as my slingshot, but it'll do the trick."
msgstr "C'est pas aussi bien que mon lance-pierres, mais ça fera l'affaire."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.BLUEAMULET
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.BLUEAMULET"
msgid "Brr... how does it stay so cold?"
msgstr "Brr... Comment ça reste froid ?"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.BLUEGEM
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.BLUEGEM"
msgid "A magic blue gem!"
msgstr "Une gemme bleue magique !"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.BLUEMOONEYE
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.BLUEMOONEYE"
msgid "You don't come across one of these very often."
msgstr "On n'en trouve pas souvent."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.BLUEPRINT.COMMON
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.BLUEPRINT.COMMON"
msgid "I'm great at following directions!"
msgstr "Suivre des instructions, c'est ma spécialité !"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.BLUEPRINT.RARE
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.BLUEPRINT.RARE"
msgid "I think I found something interesting!"
msgstr "Je crois que j'ai trouvé un truc intéressant !"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.BLUE_CAP
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.BLUE_CAP"
msgid "I'm preeetty sure this isn't the poisonous kind..."
msgstr "Je suis presque sûr qu'il est pas vénéneux. Presque."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.BLUE_CAP_COOKED
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.BLUE_CAP_COOKED"
msgid "Nothing ventured, nothing gained!"
msgstr "On a rien sans rien !"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.BLUE_MUSHROOM.GENERIC
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.BLUE_MUSHROOM.GENERIC"
msgid "Hm... there's no blue mushrooms in my handbook..."
msgstr "Hmm... Y'a pas de champignon bleu dans mon manuel..."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.BLUE_MUSHROOM.INGROUND
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.BLUE_MUSHROOM.INGROUND"
msgid "Woby, do you think you could dig it up? Guess not."
msgstr "Woby, tu crois que tu pourrais le déterrer ? Apparemment, non."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.BLUE_MUSHROOM.PICKED
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.BLUE_MUSHROOM.PICKED"
msgid "Maybe it will grow back eventually."
msgstr "Ça finira peut-être par repousser."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.BOARDS
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.BOARDS"
msgid "Some boards."
msgstr "Des planches."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.BOARON
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.BOARON"
msgid "I can take him!"
msgstr "Je peux m'en occuper !"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.BOARRIOR
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.BOARRIOR"
msgid "You sure are big!"
msgstr "On peut dire que t'es gros !"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.BOATFRAGMENT03
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.BOATFRAGMENT03"
msgid "Looks like a sea monster got them."
msgstr "On dirait que c'est un monstre marin qui a fait ça."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.BOATFRAGMENT04
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.BOATFRAGMENT04"
msgid "Looks like a sea monster got them."
msgstr "On dirait que c'est un monstre marin qui a fait ça."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.BOATFRAGMENT05
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.BOATFRAGMENT05"
msgid "Looks like a sea monster got them."
msgstr "On dirait que c'est un monstre marin qui a fait ça."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.BOATPATCH
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.BOATPATCH"
msgid "Better to be prepared."
msgstr "Mieux vaut se préparer à tout."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.BOATPATCH_KELP
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.BOATPATCH_KELP"
msgid "I knew it was a good idea to pick all that kelp!"
msgstr "Je savais que c'était une bonne idée de récupérer tout ce varech !"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.BOATRACE_CHECKPOINT
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.BOATRACE_CHECKPOINT"
msgid "Hope it doesn't float away."
msgstr "J'espère qu'il partira pas à la dérive."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.BOATRACE_CHECKPOINT_THROWABLE_DEPLOYKIT
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.BOATRACE_CHECKPOINT_THROWABLE_DEPLOYKIT"
msgid "Where should we toss this, Woby?"
msgstr "Où est-ce qu'on pourrait jeter ça, Woby ?"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.BOATRACE_PRIMEMATE
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.BOATRACE_PRIMEMATE"
msgid "We're not afraid of a little friendly competition. Right, Woby?"
msgstr "On a pas peur d'une petite compétition à l'amiable. Pas vrai, Woby ?"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.BOATRACE_SEASTACK
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.BOATRACE_SEASTACK"
msgid "Buoy off the port side! Er, I mean starboard! I'll double check my handbook..."
msgstr "À bâbord ! Euh, non, à tribord ! Je vais regarder mon manuel..."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.BOATRACE_SEASTACK_MONKEY
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.BOATRACE_SEASTACK_MONKEY"
msgid "Buoy off the port side! Er, I mean starboard! I'll double check my handbook..."
msgstr "À bâbord ! Euh, non, à tribord ! Je vais regarder mon manuel..."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.BOATRACE_SEASTACK_MONKEY_THROWABLE_DEPLOYKIT
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.BOATRACE_SEASTACK_MONKEY_THROWABLE_DEPLOYKIT"
msgid "I'll have it in the water in a jiffy!"
msgstr "Ça sera dans l'eau dans un instant !"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.BOATRACE_SEASTACK_THROWABLE_DEPLOYKIT
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.BOATRACE_SEASTACK_THROWABLE_DEPLOYKIT"
msgid "I'll have it in the water in a jiffy!"
msgstr "Ça sera dans l'eau dans un instant !"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.BOATRACE_SPECTATOR_DRAGONLING
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.BOATRACE_SPECTATOR_DRAGONLING"
msgid "Look Woby! I think he's rooting for us!"
msgstr "Regarde, Woby ! Il nous encourage !"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.BOATRACE_START
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.BOATRACE_START"
msgid "So this is where we start the race."
msgstr "C'est donc ici que la course commence."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.BOATRACE_START_THROWABLE_DEPLOYKIT
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.BOATRACE_START_THROWABLE_DEPLOYKIT"
msgid "Hmm, I wonder where we should start the race."
msgstr "Hmm, où est-ce qu'on devrait commencer la course ?"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.BOAT_ANCIENT_CONTAINER
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.BOAT_ANCIENT_CONTAINER"
msgid "This should keep our supplies safe, Woby."
msgstr "Ça devrait garder nos réserves en sécurité, Woby."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.BOAT_ANCIENT_ITEM
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.BOAT_ANCIENT_ITEM"
msgid "Is this really how they used to build boats in the olden days?"
msgstr "C'est vraiment comme ça qu'ils construisaient des bateaux avant ?"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.BOAT_BUMPER_CRABKING
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.BOAT_BUMPER_CRABKING"
msgid "Don't worry Woby, I'm really good at sailing. That's just a precaution!"
msgstr "T'en fais pas, Woby. Je sais piloter un bateau. C'est juste par précaution !"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.BOAT_BUMPER_CRABKING_KIT
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.BOAT_BUMPER_CRABKING_KIT"
msgid "It's always best to be prepared!"
msgstr "Vaut mieux prévenir que guérir !"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.BOAT_BUMPER_KELP
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.BOAT_BUMPER_KELP"
msgid "Don't worry Woby, I'm really good at sailing. That's just a precaution!"
msgstr "T'en fais pas, Woby. Je sais piloter un bateau. C'est juste par précaution !"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.BOAT_BUMPER_KELP_KIT
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.BOAT_BUMPER_KELP_KIT"
msgid "It's always best to be prepared!"
msgstr "Vaut mieux prévenir que guérir !"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.BOAT_BUMPER_SHELL
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.BOAT_BUMPER_SHELL"
msgid "Don't worry Woby, I'm really good at sailing. That's just a precaution!"
msgstr "T'en fais pas, Woby. Je sais piloter un bateau. C'est juste par précaution !"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.BOAT_BUMPER_SHELL_KIT
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.BOAT_BUMPER_SHELL_KIT"
msgid "It's always best to be prepared!"
msgstr "Vaut mieux prévenir que guérir !"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.BOAT_BUMPER_YOTD
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.BOAT_BUMPER_YOTD"
msgid "Neat! Are those real dragon teeth?"
msgstr "Super ! C'est des vraies dents de dragon ?"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.BOAT_BUMPER_YOTD_KIT
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.BOAT_BUMPER_YOTD_KIT"
msgid "It's always best to be prepared!"
msgstr "Vaut mieux prévenir que guérir !"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.BOAT_CANNON.AMMOLOADED
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.BOAT_CANNON.AMMOLOADED"
msgid "It's kind of like a giant slingshot, if you think about it."
msgstr "C'est un peu comme un lance-pierre géant, quand on y pense."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.BOAT_CANNON.GENERIC
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.BOAT_CANNON.GENERIC"
msgid "I'll load the cannonball!"
msgstr "Je vais charger les boulets de canon !"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.BOAT_CANNON.NOAMMO
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.BOAT_CANNON.NOAMMO"
msgid "I forgot the cannonballs! This won't make me lose points toward my badge, right?"
msgstr "J'ai oublié les boulets de canon ! J'espère que ça va pas me faire rater mon badge."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.BOAT_CANNON_KIT
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.BOAT_CANNON_KIT"
msgid "I've got all the supplies I need to build a cannon."
msgstr "J'ai tout ce qu'il faut pour faire un canon."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.BOAT_GRASS_ITEM
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.BOAT_GRASS_ITEM"
msgid "You have to make do with what you have out in the wilderness!"
msgstr "Il faut bien se débrouiller avec ce qu'on a dans la nature !"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.BOAT_ITEM
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.BOAT_ITEM"
msgid "Let's get building, Woby!"
msgstr "Au travail, Woby !"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.BOAT_LEAK
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.BOAT_LEAK"
msgid "Don't worry! I have a badge in sailing, I know what to do!"
msgstr "T'en fais pas, j'ai un badge de navigation. Je sais quoi faire !"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.BOAT_MAGNET.ACTIVATED
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.BOAT_MAGNET.ACTIVATED"
msgid "It's definitely pulling us toward something!"
msgstr "En tout cas, ça nous attire quelque part !"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.BOAT_MAGNET.GENERIC
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.BOAT_MAGNET.GENERIC"
msgid "Woah, I've never seen a magnet that big!"
msgstr "Ouah, j'ai jamais vu un aimant aussi gros !"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.BOAT_MAGNET_BEACON.ACTIVATED
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.BOAT_MAGNET_BEACON.ACTIVATED"
msgid "It's blinking! I think that means it's working?"
msgstr "Ça clignote ! Ça veut dire que ça fonctionne ?"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.BOAT_MAGNET_BEACON.GENERIC
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.BOAT_MAGNET_BEACON.GENERIC"
msgid "I don't really get how it works, but it sure looks neat!"
msgstr "Je sais pas comment ça marche, mais c'est trop chouette !"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.BOAT_MAGNET_KIT
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.BOAT_MAGNET_KIT"
msgid "I hope I get Mr. Wilson's instructions right... he kind of muttered through a lot of it."
msgstr "J'espère que j'ai compris les instructions de monsieur Wilson... C'est qu'il était quand même pas très clair."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.BOAT_ROTATOR
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.BOAT_ROTATOR"
msgid "Rudders are very important for sailing!"
msgstr "Faut absolument un gouvernail pour naviguer !"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.BOAT_ROTATOR_KIT
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.BOAT_ROTATOR_KIT"
msgid "A rudder might come in handy."
msgstr "Un gouvernail nous serait bien utile."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.BODYPILLOW_BEEFALOWOOL
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.BODYPILLOW_BEEFALOWOOL"
msgid "It's almost as good of a pillow as Woby!"
msgstr "C'est presque aussi moelleux que Woby !"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.BODYPILLOW_KELP
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.BODYPILLOW_KELP"
msgid "Well, um... I guess there are worse things to use for a pillow?"
msgstr "Euh... Bon, j'imagine qu'on peut utiliser pire pour faire un oreiller, hein ?"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.BODYPILLOW_PETALS
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.BODYPILLOW_PETALS"
msgid "Don't worry, I already checked it for bees."
msgstr "Pas de problème, j'ai déjà vérifié qu'il y avait pas d'abeilles dedans."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.BODYPILLOW_STEELWOOL
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.BODYPILLOW_STEELWOOL"
msgid "It's not so bad, I once made a bed out of pine needles."
msgstr "C'est pas si mal. Un jour, j'ai fait un lit avec des épines de pin."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.BOMB_LUNARPLANT
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.BOMB_LUNARPLANT"
msgid "If only I could use it in my slingshot."
msgstr "Si seulement je pouvais l'utiliser avec ma fronde."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.BOMB_LUNARPLANT_WORMWOOD
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.BOMB_LUNARPLANT_WORMWOOD"
msgid "Woah, it looks a lot stronger now!"
msgstr "Ouah, ça a l'air bien plus puissant maintenant !"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.BONESHARD
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.BONESHARD"
msgid "It's a bone!"
msgstr "C'est un os !"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.BONESOUP
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.BONESOUP"
msgid "It really fills you up."
msgstr "Ça cale bien."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.BONESTEW
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.BONESTEW"
msgid "Tasty!"
msgstr "Bon !"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.BOOKSTATION.BURNT
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.BOOKSTATION.BURNT"
msgid "Poor Ms. Wickerbottom..."
msgstr "Pauvre Mme Wickerbottom..."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.BOOKSTATION.GENERIC
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.BOOKSTATION.GENERIC"
msgid "If you read the books out loud it's almost like listening to a radio play."
msgstr "Lire des livres tout haut, c'est comme écouter une histoire à la radio."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.BOOK_BEES
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.BOOK_BEES"
msgid "There aren't real bees inside, right? Heh, no, that would be silly."
msgstr "Il y a pas de vraies abeilles dedans, hein ? Hé hé, nan, ce serait stupide."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.BOOK_BIRDS
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.BOOK_BIRDS"
msgid "I don't want to brag... but I do have a badge in birdwatching."
msgstr "Je veux pas me vanter... mais j'ai un badge en ornithologie."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.BOOK_BRIMSTONE
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.BOOK_BRIMSTONE"
msgid "Wendy already spoiled the ending for me..."
msgstr "Wendy m'a déjà gâché la fin..."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.BOOK_ELEMENTAL
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.BOOK_ELEMENTAL"
msgid "I can't make out the text."
msgstr "Je ne peux rien lire."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.BOOK_FIRE
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.BOOK_FIRE"
msgid "There's a lot of good fire safety tips in here! Um... has Willow read it?"
msgstr "Il y a des tas d'astuces de sécurité incendie, dedans ! Hum... Est-ce que Willow l'a déjà lu ?"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.BOOK_FISH
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.BOOK_FISH"
msgid "Fishing is a reel-y important part of wilderness survival. Get it? Reel-y?"
msgstr "Savoir pêcher est très important ! La survie ne tient qu'à un fil... de pêche, ha ha !"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.BOOK_FOSSIL
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.BOOK_FOSSIL"
msgid "This'll keep those monsters held for a little while."
msgstr "Ça va calmer ces monstres un moment."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.BOOK_GARDENING
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.BOOK_GARDENING"
msgid "I already have my gardening badge."
msgstr "J'ai déjà mon badge de jardinage."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.BOOK_HORTICULTURE
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.BOOK_HORTICULTURE"
msgid "I already have my gardening badge."
msgstr "J'ai déjà mon badge de jardinage."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.BOOK_HORTICULTURE_UPGRADED
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.BOOK_HORTICULTURE_UPGRADED"
msgid "Maybe I can get another gardening badge?"
msgstr "Je pourrai peut-être gagner un autre badge de jardinage ?"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.BOOK_LIGHT
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.BOOK_LIGHT"
msgid "Sounds pretty mysterious!"
msgstr "Ça a l'air sacrément mystérieux !"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.BOOK_LIGHT_UPGRADED
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.BOOK_LIGHT_UPGRADED"
msgid "This one sounds extra mysterious."
msgstr "Celui-là a l'air encore plus mystérieux !"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.BOOK_MOON
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.BOOK_MOON"
msgid "Aww, it doesn't even mention aliens!"
msgstr "Pff... ça parle même pas des extraterrestres !"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.BOOK_RAIN
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.BOOK_RAIN"
msgid "I wonder what impractical rain rituals look like?"
msgstr "Je me demande à quoi ça ressemble, un rituel de la pluie pas pratique ?"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.BOOK_RESEARCH_STATION
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.BOOK_RESEARCH_STATION"
msgid "It's almost as useful as my Pinetree Pioneer handbook."
msgstr "C'est presque aussi utile que mon manuel des Scouts toujours."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.BOOK_SILVICULTURE
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.BOOK_SILVICULTURE"
msgid "There's so much to learn about the woods!"
msgstr "Il y a tellement à apprendre sur les forêts !"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.BOOK_SLEEP
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.BOOK_SLEEP"
msgid "My idea of a bedtime story has a lot more monsters in it..."
msgstr "Pour moi, une histoire avant de se coucher doit avoir plein de monstres..."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.BOOK_TEMPERATURE
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.BOOK_TEMPERATURE"
msgid "I hope it works on Woby, I worry about her in the summer with all that fur..."
msgstr "J'espère que ça va marcher sur Woby. J'ai peur qu'elle ait trop chaud en été, avec sa fourrure..."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.BOOK_TENTACLES
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.BOOK_TENTACLES"
msgid "Oooh, this reminds me of a radio play where a ship gets eaten by a giant squid!"
msgstr "Oooh, ça me rappelle une histoire à la radio où un bateau se fait décorer par un calmar géant !"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.BOOK_WEB
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.BOOK_WEB"
msgid "Maybe I should give this book to Mr. Wolfgang."
msgstr "Je devrais peut-être donner ce livre à M. Wolfgang."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.BOOMERANG
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.BOOMERANG"
msgid "Fetch, Woby!"
msgstr "Va chercher, Woby !"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.BOOTLEG
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.BOOTLEG"
msgid "Sorry Woby, that bone isn't for you."
msgstr "Désolé, Woby. Cet os n'est pas pour toi."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.BROKEN_FORGEDITEM
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.BROKEN_FORGEDITEM"
msgid "Woby! Were you playing with that?"
msgstr "Woby ! C'est toi qui as joué avec ça ?"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.BROKEN_FUMAROLETOOLITEM
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.BROKEN_FUMAROLETOOLITEM"
msgid "I bet I could melt it back together with a little heat."
msgstr "Je suis sûr que je pourrais ressouder ça avec un peu de chaleur."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.BRUSH
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.BRUSH"
msgid "Woby loves getting her fur brushed."
msgstr "Woby adore qu'on la brosse."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.BUGNET
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.BUGNET"
msgid "I'm an expert at catching bugs."
msgstr "Attraper des insectes est ma spécialité."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.BULLKELP_PLANT.GENERIC
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.BULLKELP_PLANT.GENERIC"
msgid "It's kelp... or a sea monster DISGUISING themselves as kelp."
msgstr "C'est du varech... Ou un monstre qui se déguise en varech !"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.BULLKELP_PLANT.PICKED
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.BULLKELP_PLANT.PICKED"
msgid "I guess it's just kelp."
msgstr "C'est juste du varech, on dirait."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.BULLKELP_ROOT
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.BULLKELP_ROOT"
msgid "I could plant this back in the ocean."
msgstr "Je pourrais les replanter dans l'océan."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.BUNDLE
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.BUNDLE"
msgid "It's packed full of provisions."
msgstr "C'est plein de provisions."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.BUNDLEWRAP
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.BUNDLEWRAP"
msgid "Efficient packing is truly an overlooked art in camping."
msgstr "Bien faire son paquetage est un talent sous-estimé en camping."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.BUNNYMAN
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.BUNNYMAN"
msgid "I've never heard of the Bunnyman before! Better make a note."
msgstr "J'avais jamais entendu parler des hommes-lapins, avant. Je vais noter ça."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.BUNNYSTEW
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.BUNNYSTEW"
msgid "There's no Pioneer that could say no to this!"
msgstr "Aucun Scout toujours pourrait refuser ça !"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.BURNT_MARSH_BUSH
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.BURNT_MARSH_BUSH"
msgid "Guess it wasn't a bog monster after all."
msgstr "C'était pas un monstre des marais, finalement..."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.BUSHHAT
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.BUSHHAT"
msgid "Camouflage!"
msgstr "Camouflage !"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.BUTTER
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.BUTTER"
msgid "This makes far more sense, honestly."
msgstr "Ça n'a aucun sens..."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.BUTTERFLY.GENERIC
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.BUTTERFLY.GENERIC"
msgid "I wonder if I can catch it."
msgstr "Je me demande si je peux l'attraper."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.BUTTERFLY.HELD
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.BUTTERFLY.HELD"
msgid "Gotcha!"
msgstr "Je t'ai eu !"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.BUTTERFLYMUFFIN
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.BUTTERFLYMUFFIN"
msgid "I feel kind of bad about the butterfly."
msgstr "Je me sens un peu coupable pour le papillon."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.BUTTERFLYWINGS
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.BUTTERFLYWINGS"
msgid "Nature's pretty amazing, isn't it?"
msgstr "La nature est incroyable, pas vrai ?"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.BUZZARD
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.BUZZARD"
msgid "That seems like a bad sign."
msgstr "C'est pas bon signe."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.BUZZARDCORPSE.BURNING
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.BUZZARDCORPSE.BURNING"
msgid "Smells kinda yummy."
msgstr "Ça me donne presque faim."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.BUZZARDCORPSE.GENERIC
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.BUZZARDCORPSE.GENERIC"
msgid "Stay away from it, Woby!"
msgstr "T'en approche pas, Woby !"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.BUZZARDCORPSE.REVIVING
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.BUZZARDCORPSE.REVIVING"
msgid "Yes! I knew it!"
msgstr "Ah, j'en étais sûr !"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.CABBAGEROLLS
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.CABBAGEROLLS"
msgid "This would make great camping food!"
msgstr "Ce serait de la super nourriture de camping !"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.CACTUS.GENERIC
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.CACTUS.GENERIC"
msgid "That's one prickly plant."
msgstr "Cette plante pique grave !"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.CACTUS.PICKED
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.CACTUS.PICKED"
msgid "You'd better be tasty."
msgstr "T'as intérêt à être bon."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.CACTUS_FLOWER
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.CACTUS_FLOWER"
msgid "It looks nice, but getting it was a pain."
msgstr "C'est joli, mais elle a été douloureuse à cueillir."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.CACTUS_MEAT
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.CACTUS_MEAT"
msgid "Maybe I should take out the spines first."
msgstr "Je devrais peut-être commencer par enlever les épines."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.CACTUS_MEAT_COOKED
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.CACTUS_MEAT_COOKED"
msgid "At least it's safe to eat now."
msgstr "Au moins maintenant, on peut le manger sans danger."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.CALIFORNIAROLL
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.CALIFORNIAROLL"
msgid "Is that raw fish?"
msgstr "C'est du poisson cru ?"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.CAMPFIRE.EMBERS
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.CAMPFIRE.EMBERS"
msgid "We need more fuel for the fire!"
msgstr "On a besoin de combustible pour le feu !"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.CAMPFIRE.GENERIC
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.CAMPFIRE.GENERIC"
msgid "Anyone want to hear a scary story?"
msgstr "Quelqu'un veut une histoire qui fait peur ?"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.CAMPFIRE.HIGH
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.CAMPFIRE.HIGH"
msgid "Woah! I don't think that's safe..."
msgstr "Ouah ! Je pense pas que ce soit très sûr..."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.CAMPFIRE.LOW
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.CAMPFIRE.LOW"
msgid "It might need some more fuel."
msgstr "Il faut peut-être plus de combustible."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.CAMPFIRE.NORMAL
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.CAMPFIRE.NORMAL"
msgid "It's the perfect temperature for roasting marshmallows!"
msgstr "C'est la température idéale pour faire griller des marshmallows !"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.CAMPFIRE.OUT
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.CAMPFIRE.OUT"
msgid "Over already?"
msgstr "Oh, déjà fini ?"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.CANARY.GENERIC
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.CANARY.GENERIC"
msgid "Did you get lost too?"
msgstr "Toi aussi, tu t'es perdu ?"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.CANARY.HELD
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.CANARY.HELD"
msgid "Hey, no pecking!"
msgstr "Hé, me picore pas !"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.CANARY_POISONED
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.CANARY_POISONED"
msgid "This bird needs first aid!"
msgstr "Cet oiseau a besoin de soins !"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.CANDYBAG
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.CANDYBAG"
msgid "I'm too old for that stuff. But maybe I'll help out the younger kids..."
msgstr "Je suis trop vieux pour ça. Mais ça plaira peut-être à des enfants..."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.CANE
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.CANE"
msgid "Nothing like a good walking stick! Just don't chew on it this time, Woby."
msgstr "Rien de mieux qu'un bon bâton de marche ! Évite de le mâchouiller cette fois, Woby."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.CANNONBALL_ROCK_ITEM
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.CANNONBALL_ROCK_ITEM"
msgid "That goes in the cannon."
msgstr "Ça va dans le canon."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.CARNIVALCANNON.COOLDOWN
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.CARNIVALCANNON.COOLDOWN"
msgid "Don't worry Ms. Wickerbottom, I'll clean this all up later!"
msgstr "Vous en faites pas, Mme Wickerbottom. Je rangerai tout ensuite !"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.CARNIVALCANNON.GENERIC
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.CARNIVALCANNON.GENERIC"
msgid "We should probably test it out. You know, for safety."
msgstr "On devrait peut-être le tester avant. Genre, pour des raisons de sécurité, et tout."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.CARNIVALCANNON_KIT
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.CARNIVALCANNON_KIT"
msgid "I just hope it doesn't startle Woby."
msgstr "J'espère juste que ça fera pas peur à Woby."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.CARNIVALDECOR_BANNER
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.CARNIVALDECOR_BANNER"
msgid "Wait a minute... I think it's made with cardboard and foil!"
msgstr "Une minute... Je crois que c'est fait en carton et en alu !"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.CARNIVALDECOR_BANNER_KIT
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.CARNIVALDECOR_BANNER_KIT"
msgid "I'll have that up in a jiffy!"
msgstr "Je vais le faire en un rien d'temps !"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.CARNIVALDECOR_EGGRIDE
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.CARNIVALDECOR_EGGRIDE"
msgid "I kind of wish they had a bigger one."
msgstr "J'aurais bien aimé qu'ils en aient des plus gros."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.CARNIVALDECOR_EGGRIDE_KIT
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.CARNIVALDECOR_EGGRIDE_KIT"
msgid "I'll have that up in a jiffy!"
msgstr "Je vais le faire en un rien d'temps !"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.CARNIVALDECOR_FIGURE.GENERIC
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.CARNIVALDECOR_FIGURE.GENERIC"
msgid "Neat! I love collecting things!"
msgstr "Trop cool ! J'adore collectionner des trucs !"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.CARNIVALDECOR_FIGURE.RARE
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.CARNIVALDECOR_FIGURE.RARE"
msgid "Oooh, I got an extra rare one!"
msgstr "Oooh ! J'en ai trouvé une super rare !"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.CARNIVALDECOR_FIGURE.UNCOMMON
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.CARNIVALDECOR_FIGURE.UNCOMMON"
msgid "I'm adding it to my collection!"
msgstr "Je l'ajoute à ma collec' !"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.CARNIVALDECOR_FIGURE_KIT
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.CARNIVALDECOR_FIGURE_KIT"
msgid "The suspense is killing me!"
msgstr "Aaah, y a trop de suspens !"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.CARNIVALDECOR_FIGURE_KIT_SEASON2
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.CARNIVALDECOR_FIGURE_KIT_SEASON2"
msgid "The suspense is killing me!"
msgstr "Aaah, y a trop de suspens !"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.CARNIVALDECOR_LAMP
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.CARNIVALDECOR_LAMP"
msgid "Do you think it's powered by magic?"
msgstr "Vous croyez que ça marche grâce à la magie ?"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.CARNIVALDECOR_LAMP_KIT
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.CARNIVALDECOR_LAMP_KIT"
msgid "I'll have that up in a jiffy!"
msgstr "Je vais le faire en un rien d'temps !"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.CARNIVALDECOR_PLANT
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.CARNIVALDECOR_PLANT"
msgid "I'm going to take good care of it!"
msgstr "Je vais bien m'en occuper !"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.CARNIVALDECOR_PLANT_KIT
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.CARNIVALDECOR_PLANT_KIT"
msgid "I'll have that up in a jiffy!"
msgstr "Je vais le faire en un rien d'temps !"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.CARNIVALFOOD_CORNTEA
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.CARNIVALFOOD_CORNTEA"
msgid "Yum...?"
msgstr "Euh... miam ?"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.CARNIVALGAME_FEEDCHICKS_FOOD
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.CARNIVALGAME_FEEDCHICKS_FOOD"
msgid "Aww, they're not real worms!"
msgstr "Oooh, c'est pas des vrais vers !"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.CARNIVALGAME_FEEDCHICKS_KIT
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.CARNIVALGAME_FEEDCHICKS_KIT"
msgid "It can't be much harder than setting up a tent."
msgstr "C'est sûrement pas plus dur que de monter une tente."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.CARNIVALGAME_FEEDCHICKS_NEST
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.CARNIVALGAME_FEEDCHICKS_NEST"
msgid "I'd sure love to see what's down there."
msgstr "J'aimerais bien voir ce qu'il y a en bas."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.CARNIVALGAME_FEEDCHICKS_STATION.GENERIC
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.CARNIVALGAME_FEEDCHICKS_STATION.GENERIC"
msgid "I think it wants me to give it a token."
msgstr "Je crois qu'il veut me donner un jeton."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.CARNIVALGAME_FEEDCHICKS_STATION.PLAYING
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.CARNIVALGAME_FEEDCHICKS_STATION.PLAYING"
msgid "This doesn't look too hard!"
msgstr "Ça a pas l'air trop dur !"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.CARNIVALGAME_HERDING_CHICK
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.CARNIVALGAME_HERDING_CHICK"
msgid "Go to the center, please!"
msgstr "Allez, tout le monde au milieu, s'il vous plaît !"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.CARNIVALGAME_HERDING_KIT
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.CARNIVALGAME_HERDING_KIT"
msgid "I'll have that up in a jiffy!"
msgstr "Je vais le faire en un rien d'temps !"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.CARNIVALGAME_HERDING_STATION.GENERIC
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.CARNIVALGAME_HERDING_STATION.GENERIC"
msgid "I think it wants me to give it a token."
msgstr "Je crois qu'il veut me donner un jeton."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.CARNIVALGAME_HERDING_STATION.PLAYING
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.CARNIVALGAME_HERDING_STATION.PLAYING"
msgid "I wonder if Woby's part sheepdog..."
msgstr "Je me demande si Woby est à moitié chien de berger..."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.CARNIVALGAME_MEMORY_CARD.GENERIC
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.CARNIVALGAME_MEMORY_CARD.GENERIC"
msgid "I'd sure love to see what's down there."
msgstr "J'aimerais bien voir ce qu'il y a en bas."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.CARNIVALGAME_MEMORY_CARD.PLAYING
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.CARNIVALGAME_MEMORY_CARD.PLAYING"
msgid "I'm pretty sure it was this one..."
msgstr "Je crois que c'était celui-là..."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.CARNIVALGAME_MEMORY_KIT
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.CARNIVALGAME_MEMORY_KIT"
msgid "This doesn't look hard to set up."
msgstr "Ça a pas l'air trop dur à faire."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.CARNIVALGAME_MEMORY_STATION.GENERIC
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.CARNIVALGAME_MEMORY_STATION.GENERIC"
msgid "I think it wants me to give it a token."
msgstr "Je crois qu'il veut me donner un jeton."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.CARNIVALGAME_MEMORY_STATION.PLAYING
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.CARNIVALGAME_MEMORY_STATION.PLAYING"
msgid "I bet I'd be pretty good at that!"
msgstr "J'suis sûr que je vais tout rafler !"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.CARNIVALGAME_PUCKDROP_KIT
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.CARNIVALGAME_PUCKDROP_KIT"
msgid "I'll have that up in a jiffy!"
msgstr "Je vais le faire en un rien d'temps !"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.CARNIVALGAME_PUCKDROP_STATION.GENERIC
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.CARNIVALGAME_PUCKDROP_STATION.GENERIC"
msgid "I think it wants me to give it a token."
msgstr "Je crois qu'il veut me donner un jeton."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.CARNIVALGAME_PUCKDROP_STATION.PLAYING
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.CARNIVALGAME_PUCKDROP_STATION.PLAYING"
msgid "I saw a marble game once back home, I always wanted to try it!"
msgstr "J'ai déjà vu un jeu de billes, chez moi. J'ai toujours voulu essayer !"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.CARNIVALGAME_SHOOTING_BUTTON.GENERIC
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.CARNIVALGAME_SHOOTING_BUTTON.GENERIC"
msgid "I think it wants me to give it a token."
msgstr "Je crois qu'il veut me donner un jeton."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.CARNIVALGAME_SHOOTING_BUTTON.PLAYING
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.CARNIVALGAME_SHOOTING_BUTTON.PLAYING"
msgid "I just need to hit it at the right time..."
msgstr "Il faut que j'appuie au bon moment..."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.CARNIVALGAME_SHOOTING_KIT
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.CARNIVALGAME_SHOOTING_KIT"
msgid "I'll have that up in a jiffy!"
msgstr "Je vais le faire en un rien d'temps !"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.CARNIVALGAME_SHOOTING_STATION.GENERIC
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.CARNIVALGAME_SHOOTING_STATION.GENERIC"
msgid "I think it wants me to give it a token."
msgstr "Je crois qu'il veut me donner un jeton."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.CARNIVALGAME_SHOOTING_STATION.PLAYING
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.CARNIVALGAME_SHOOTING_STATION.PLAYING"
msgid "All that slingshot practice should come in handy!"
msgstr "Je savais bien que tirer au lance-pierres finirait par être utile !"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.CARNIVALGAME_SHOOTING_TARGET.GENERIC
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.CARNIVALGAME_SHOOTING_TARGET.GENERIC"
msgid "I'd sure love to see what's down there."
msgstr "J'aimerais bien voir ce qu'il y a en bas."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.CARNIVALGAME_SHOOTING_TARGET.PLAYING
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.CARNIVALGAME_SHOOTING_TARGET.PLAYING"
msgid "I wonder what kind of bug that is?"
msgstr "Je me demande quel genre d'insecte c'est."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.CARNIVALGAME_WHEELSPIN_KIT
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.CARNIVALGAME_WHEELSPIN_KIT"
msgid "I'll have that up in a jiffy!"
msgstr "Je vais le faire en un rien d'temps !"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.CARNIVALGAME_WHEELSPIN_STATION.GENERIC
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.CARNIVALGAME_WHEELSPIN_STATION.GENERIC"
msgid "I think it wants me to give it a token."
msgstr "Je crois qu'il veut me donner un jeton."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.CARNIVALGAME_WHEELSPIN_STATION.PLAYING
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.CARNIVALGAME_WHEELSPIN_STATION.PLAYING"
msgid "It almost feels too easy."
msgstr "C'est presque trop facile."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.CARNIVAL_BALL
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.CARNIVAL_BALL"
msgid "Get the ball Woby! Uh... I guess we'll work on that later."
msgstr "Attrape la balle, Woby ! Euh... Bon, on réessaiera plus tard."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.CARNIVAL_CROWKID
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.CARNIVAL_CROWKID"
msgid "Tiny bird men! Bird kids?"
msgstr "Des p'tits hommes-oiseaux ! Des enfants-oiseaux, du coup ?"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.CARNIVAL_GAMETOKEN
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.CARNIVAL_GAMETOKEN"
msgid "What game should I play first? It's so hard to decide!"
msgstr "À quoi je vais jouer en premier ? C'est dur de décider !"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.CARNIVAL_HOST
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.CARNIVAL_HOST"
msgid "Woah! A real bird man!"
msgstr "Waouh ! Un vrai homme-oiseau !"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.CARNIVAL_PLAZA.GENERIC
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.CARNIVAL_PLAZA.GENERIC"
msgid "Maybe if we decorate around it, more birds will come!"
msgstr "Si on décorait un peu les environs, y aurait peut-être plus d'oiseaux qui viendraient !"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.CARNIVAL_PLAZA.LEVEL_2
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.CARNIVAL_PLAZA.LEVEL_2"
msgid "It's looking good, but I think we can do even better."
msgstr "C'est pas mal, mais j'pense qu'on peut faire encore mieux !"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.CARNIVAL_PLAZA.LEVEL_3
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.CARNIVAL_PLAZA.LEVEL_3"
msgid "I've got a real talon for decorating! Get it? Because crows have talons?"
msgstr "J'ai un vrai don pour la décoration !"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.CARNIVAL_PLAZA_KIT
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.CARNIVAL_PLAZA_KIT"
msgid "I'm good at planting trees, we did it all the time in the Pioneers!"
msgstr "Je suis doué pour planter des arbres. On le faisait sans arrêt chez les scouts !"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.CARNIVAL_PRIZEBOOTH.GENERIC
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.CARNIVAL_PRIZEBOOTH.GENERIC"
msgid "Is there a badge for winning all the prizes?"
msgstr "Y'a un badge quand on gagne tous les prix ?"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.CARNIVAL_PRIZEBOOTH_KIT
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.CARNIVAL_PRIZEBOOTH_KIT"
msgid "I'll have this set up right away!"
msgstr "Je vais installer ça sans traîner !"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.CARNIVAL_PRIZETICKET.GENERIC
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.CARNIVAL_PRIZETICKET.GENERIC"
msgid "We're off to a good start Woby, but we can do better!"
msgstr "On commence plutôt bien, Woby. Mais on peut faire mieux !"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.CARNIVAL_PRIZETICKET.GENERIC_LARGESTACK
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.CARNIVAL_PRIZETICKET.GENERIC_LARGESTACK"
msgid "That's got to be worth a really good prize!"
msgstr "Ça doit valoir une belle récompense, ça !"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.CARNIVAL_PRIZETICKET.GENERIC_SMALLSTACK
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.CARNIVAL_PRIZETICKET.GENERIC_SMALLSTACK"
msgid "Should I go get a prize now? Or save up for something really good..."
msgstr "Je sais pas si je dois aller chercher un prix maintenant ou attendre de décrocher le gros lot..."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.CARNIVAL_SEEDPACKET
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.CARNIVAL_SEEDPACKET"
msgid "I guess it's sort of like trail mix. Sort of."
msgstr "C'est un genre de mélange de graines..."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.CARNIVAL_VEST_A
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.CARNIVAL_VEST_A"
msgid "I wonder if those bird kids would want to join my Pioneer troop..."
msgstr "Je me demande si ces gamins oiseaux ont envie de devenir scouts, eux aussi."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.CARNIVAL_VEST_B
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.CARNIVAL_VEST_B"
msgid "I can blend in with the trees!"
msgstr "Je peux me camoufler en forêt !"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.CARNIVAL_VEST_C
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.CARNIVAL_VEST_C"
msgid "It really helps in hot weather!"
msgstr "C'est top quand il fait chaud !"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.CARPENTRY_BLADE_MOONGLASS
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.CARPENTRY_BLADE_MOONGLASS"
msgid "Lookin' sharp! Heh."
msgstr "Ça me scie ! Hé hé."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.CARPENTRY_STATION.BURNT
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.CARPENTRY_STATION.BURNT"
msgid "I guess my carpentry badge will have to wait."
msgstr "J'imagine que mon badge de menuiserie devra attendre."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.CARPENTRY_STATION.GENERIC
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.CARPENTRY_STATION.GENERIC"
msgid "Now I can work towards my carpentry badge!"
msgstr "Je peux enfin essayer de décrocher mon badge de menuiserie !"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.CARRAT.DEAD
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.CARRAT.DEAD"
msgid "Poor little thing."
msgstr "Oh, pauvre petite."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.CARRAT.GENERIC
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.CARRAT.GENERIC"
msgid "Vegetables are much more interesting here than back home."
msgstr "Les légumes d'ici sont beaucoup plus intéressants que chez moi."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.CARRAT.HELD
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.CARRAT.HELD"
msgid "Please don't nibble a hole in my pocket."
msgstr "Évite de faire un trou dans ma poche."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.CARRAT.SLEEPING
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.CARRAT.SLEEPING"
msgid "What do carrots dream about?"
msgstr "De quoi rêvent les carottes ?"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.CARRAT_GHOSTRACER
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.CARRAT_GHOSTRACER"
msgid "Where can I get a shadow carrat?"
msgstr "Où je peux trouver une carate d'ombre ?"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.CARROT
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.CARROT"
msgid "I get kind of disappointed when it doesn't turn out to be a rat."
msgstr "J'étais un peu déçu de découvrir que c'était pas un rat."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.CARROT_COOKED
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.CARROT_COOKED"
msgid "Yup. It's a cooked carrot."
msgstr "Ouais, c'est une carotte cuite."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.CARROT_OVERSIZED
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.CARROT_OVERSIZED"
msgid "I was hoping it would sprout ears and whiskers too... oh well."
msgstr "J'espérais qu'il lui pousse des oreilles et des moustaches... Tant pis."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.CARROT_PLANTED
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.CARROT_PLANTED"
msgid "Now we'll have more carrots. Yay."
msgstr "On aura plus de carottes maintenant, youpi !"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.CARROT_SEEDS
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.CARROT_SEEDS"
msgid "Yep, those are seeds!"
msgstr "Ouais, c'est des graines !"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.CARTOGRAPHYDESK.BURNING
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.CARTOGRAPHYDESK.BURNING"
msgid "That's not a proper campfire!"
msgstr "C'est pas un feu de camp digne de ce nom !"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.CARTOGRAPHYDESK.BURNT
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.CARTOGRAPHYDESK.BURNT"
msgid "Someone wasn't practicing fire safety."
msgstr "Quelqu'un a pas suivi les consignes de sécurité incendie."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.CARTOGRAPHYDESK.GENERIC
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.CARTOGRAPHYDESK.GENERIC"
msgid "We're mapping out the wilderness!"
msgstr "On cartographie la nature !"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.CATCOON
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.CATCOON"
msgid "You're a weird looking raccoon."
msgstr "T'es bizarre, comme raton laveur."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.CATCOONDEN.EMPTY
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.CATCOONDEN.EMPTY"
msgid "Nobody's home."
msgstr "Il y a personne."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.CATCOONDEN.GENERIC
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.CATCOONDEN.GENERIC"
msgid "I think something lives in there!"
msgstr "Je crois que quelque chose vit là-dedans."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.CATCOONHAT
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.CATCOONHAT"
msgid "Now this is a hat made for the wilderness!"
msgstr "C'est un chapeau fait pour vivre dans la nature !"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.CATTOY_MOUSE
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.CATTOY_MOUSE"
msgid "Sorry Woby, that's for the kits to play with."
msgstr "Désolé, Woby. C'est un jouet pour les fatons."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.CAVEIN_BOULDER.GENERIC
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.CAVEIN_BOULDER.GENERIC"
msgid "Come on Woby, give me a hand moving this!"
msgstr "Allez, Woby ! Aide-moi à bouger ça !"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.CAVEIN_BOULDER.RAISED
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.CAVEIN_BOULDER.RAISED"
msgid "I can't get to it!"
msgstr "J'arrive pas à l'atteindre !"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.CAVE_BANANA
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.CAVE_BANANA"
msgid "I wouldn't mind stopping for a snack."
msgstr "Je ferais bien une pause goûter."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.CAVE_BANANA_BURNT
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.CAVE_BANANA_BURNT"
msgid "Whoops..."
msgstr "Oups..."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.CAVE_BANANA_COOKED
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.CAVE_BANANA_COOKED"
msgid "Well... it's a hot banana."
msgstr "Eh bien... C'est une banane flambée."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.CAVE_BANANA_TREE
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.CAVE_BANANA_TREE"
msgid "I didn't know bananas could grow in caves."
msgstr "Je savais pas que les bananes pouvaient pousser dans les grottes."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.CAVE_ENTRANCE
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.CAVE_ENTRANCE"
msgid "That rock's blocking the entrance!"
msgstr "Ce rocher bloque l'entrée !"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.CAVE_ENTRANCE_OPEN.FULL
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.CAVE_ENTRANCE_OPEN.FULL"
msgid "There's too many people in there... I'll just wait."
msgstr "Il y a trop de gens là-dedans. Je vais attendre."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.CAVE_ENTRANCE_OPEN.GENERIC
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.CAVE_ENTRANCE_OPEN.GENERIC"
msgid "Why can't we go in?"
msgstr "Pourquoi on peut pas entrer ?"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.CAVE_ENTRANCE_OPEN.OPEN
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.CAVE_ENTRANCE_OPEN.OPEN"
msgid "Come on Woby! Let's take a look around!"
msgstr "Viens, Woby ! Allons y jeter un œil !"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.CAVE_ENTRANCE_RUINS
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.CAVE_ENTRANCE_RUINS"
msgid "There's probably tons of good stuff in there."
msgstr "Il y a sûrement plein de trucs sympas, ici."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.CAVE_EXIT.FULL
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.CAVE_EXIT.FULL"
msgid "There's too many people outside... let's just wait here."
msgstr "Il y a trop de gens dehors... On va attendre un peu ici."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.CAVE_EXIT.GENERIC
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.CAVE_EXIT.GENERIC"
msgid "Guess we're stuck here Woby."
msgstr "Je crois que Woby et moi, on est coincés ici."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.CAVE_EXIT.OPEN
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.CAVE_EXIT.OPEN"
msgid "Alright, let's go!"
msgstr "Allez, c'est parti !"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.CAVE_FERN
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.CAVE_FERN"
msgid "There's some weird plants growing down here."
msgstr "Il y a des plantes bizarres qui poussent, en bas."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.CAVE_FERN_WITHERED
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.CAVE_FERN_WITHERED"
msgid "These weird plants don't do well down here."
msgstr "Ces plantes étranges ont du mal à survivre ici."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.CAVE_VENT_MITE.DEAD
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.CAVE_VENT_MITE.DEAD"
msgid "Yup. It's dead."
msgstr "Oui, elle est morte."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.CAVE_VENT_MITE.GENERIC
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.CAVE_VENT_MITE.GENERIC"
msgid "Careful Woby! It's gassy."
msgstr "Attention Woby ! Elle a des gaz."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.CAVE_VENT_MITE.SLEEPING
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.CAVE_VENT_MITE.SLEEPING"
msgid "Shh... don't wake it, Woby."
msgstr "Chut... Faut pas la réveiller, Woby."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.CAVE_VENT_MITE.VENTING
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.CAVE_VENT_MITE.VENTING"
msgid "It's blowing off steam! Get it, Woby?"
msgstr "Elle relâche la pression ! Tu saisis, Woby ?"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.CAVE_VENT_ROCK.GAS
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.CAVE_VENT_ROCK.GAS"
msgid "Yuck! Stay back, Woby girl!"
msgstr "Beurk ! Écarte-toi, Woby !"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.CAVE_VENT_ROCK.GENERIC
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.CAVE_VENT_ROCK.GENERIC"
msgid "Not too close, Wobes."
msgstr "Pas trop près, Woby."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.CAVE_VENT_ROCK.HOT
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.CAVE_VENT_ROCK.HOT"
msgid "It's just blowing off steam! Get it, Woby?"
msgstr "Elle relâche juste la pression ! Tu saisis, Woby ?"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.CAVE_VENT_ROCK.MIASMA
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.CAVE_VENT_ROCK.MIASMA"
msgid "Steer clear, Wobers!"
msgstr "T'en approche pas, Woby !"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.CEILING_ROPE
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.CEILING_ROPE"
msgid "Good thing I have my climbing badge!"
msgstr "Heureusement que j'ai mon badge d'escalade !"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.CEVICHE
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.CEVICHE"
msgid "Mushy, but tasty."
msgstr "Un peu gluant, mais appétissant !"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.CHARCOAL
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.CHARCOAL"
msgid "You find a lot of these in fire pits."
msgstr "On en trouve des tas dans les braseros."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.CHARLIERESIDUE
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.CHARLIERESIDUE"
msgid "only_used_by_winona"
msgstr "only_used_by_winona"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.CHARLIEROSE
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.CHARLIEROSE"
msgid "only_used_by_winona"
msgstr "only_used_by_winona"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.CHARLIE_HAND
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.CHARLIE_HAND"
msgid "We should give it a hand! Heh. Good one, Walter."
msgstr "On devrait lui donner un coup de main ! Hé hé, bien joué Walter."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.CHARLIE_HECKLER
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.CHARLIE_HECKLER"
msgid "What mean birds! At least I think they're birds."
msgstr "Vilains oiseaux ! Enfin... je crois que ce sont des oiseaux ?"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.CHARLIE_LECTURN
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.CHARLIE_LECTURN"
msgid "I wonder who'll be playing the characters?"
msgstr "Je me demande qui va jouer les personnages."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.CHARLIE_NPC
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.CHARLIE_NPC"
msgid "Excuse me, ma'am! It's dangerous here, do you need any assistance?"
msgstr "Pardon, madame, mais c'est dangereux ici ! Je peux vous venir en aide ?"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.CHARLIE_STAGE_POST
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.CHARLIE_STAGE_POST"
msgid "Are we doing a talent show?"
msgstr "On fait un concours de talents, c'est ça ?"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.CHESSJUNK1
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.CHESSJUNK1"
msgid "I don't think they're going to get up anytime soon."
msgstr "Je crois que ça va pas se relever tout de suite."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.CHESSJUNK2
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.CHESSJUNK2"
msgid "I don't think they're going to get up anytime soon."
msgstr "Je crois que ça va pas se relever tout de suite."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.CHESSJUNK3
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.CHESSJUNK3"
msgid "I don't think they're going to get up anytime soon."
msgstr "Je crois que ça va pas se relever tout de suite."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.CHESSPIECE_ANCHOR
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.CHESSPIECE_ANCHOR"
msgid "Technically this could still work as a real anchor."
msgstr "Techniquement, ça pourrait toujours servir d'ancre."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.CHESSPIECE_ANTLION
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.CHESSPIECE_ANTLION"
msgid "She really shook you up, didn't she Woby?"
msgstr "Elle t'a vraiment secouée, pas vrai Woby ?"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.CHESSPIECE_BEARGER
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.CHESSPIECE_BEARGER"
msgid "It looks just like him!"
msgstr "On dirait le vrai !"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.CHESSPIECE_BEARGER_MUTATED
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.CHESSPIECE_BEARGER_MUTATED"
msgid "We bearly escaped! Get it?"
msgstr "Il pouvait clairement pas nous blairer. Hé hé, pigé ?"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.CHESSPIECE_BEEFALO
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.CHESSPIECE_BEEFALO"
msgid "Aw don't be jealous Woby, you deserve a statue too!"
msgstr "Oh, sois pas jaloux, Woby. Toi aussi, tu mérites une statue !"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.CHESSPIECE_BEEQUEEN
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.CHESSPIECE_BEEQUEEN"
msgid "At least I'm not allergic to bees made out of stone."
msgstr "Au moins, je suis pas allergique aux abeilles en pierre."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.CHESSPIECE_BISHOP.GENERIC
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.CHESSPIECE_BISHOP.GENERIC"
msgid "Woby doesn't seem to like it."
msgstr "Woby n'a pas l'air de l'apprécier."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.CHESSPIECE_BISHOP.STRUGGLE
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.CHESSPIECE_BISHOP.STRUGGLE"
msgid "It's coming to life!"
msgstr "Il revient à la vie !"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.CHESSPIECE_BUTTERFLY
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.CHESSPIECE_BUTTERFLY"
msgid "It's not quite as good as a real bug collection, but close!"
msgstr "C'est pas aussi chouette qu'une vraie collection d'insectes, mais c'est pas mal !"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.CHESSPIECE_CARRAT
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.CHESSPIECE_CARRAT"
msgid "I usually prefer badges to trophies, but I might make an exception."
msgstr "En général, je préfère les badges aux trophées. Mais je veux bien faire une exception."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.CHESSPIECE_CATCOON
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.CHESSPIECE_CATCOON"
msgid "It's not quite as exciting as a monster statue, is it?"
msgstr "C'est moins marrant quand c'est une statue, quand même."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.CHESSPIECE_CLAYHOUND
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.CHESSPIECE_CLAYHOUND"
msgid "He wasn't a very good dog."
msgstr "C'était pas un bon chien."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.CHESSPIECE_CLAYWARG
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.CHESSPIECE_CLAYWARG"
msgid "Poor Woby. She never seems to get along with the other dogs."
msgstr "Pauvre Woby. Elle s'entend jamais avec les autres chiens."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.CHESSPIECE_CRABKING
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.CHESSPIECE_CRABKING"
msgid "The crabbiest sea monster I've ever met!"
msgstr "C'est le monstre marin le plus pince-sans-rire que je connaisse !"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.CHESSPIECE_DAYWALKER
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.CHESSPIECE_DAYWALKER"
msgid "I sure hope we get to see him again!"
msgstr "J'espère qu'on le reverra !"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.CHESSPIECE_DAYWALKER2
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.CHESSPIECE_DAYWALKER2"
msgid "We did see him again!"
msgstr "On l'a revu, finalement !"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.CHESSPIECE_DEERCLOPS
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.CHESSPIECE_DEERCLOPS"
msgid "I like this one!"
msgstr "Je l'aime bien, lui !"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.CHESSPIECE_DEERCLOPS_MUTATED
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.CHESSPIECE_DEERCLOPS_MUTATED"
msgid "I still feel kind of bad for her."
msgstr "Je m'en veux un peu pour lui."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.CHESSPIECE_DEPTHWORM
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.CHESSPIECE_DEPTHWORM"
msgid "The carving somehow still feels slithery!"
msgstr "Il a encore un air de serpent !"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.CHESSPIECE_DRAGONFLY
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.CHESSPIECE_DRAGONFLY"
msgid "If only we could've gotten along."
msgstr "Si seulement on était devenus amis..."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.CHESSPIECE_EYEOFTERROR
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.CHESSPIECE_EYEOFTERROR"
msgid "Nothing to see here, folks! Ha ha, get it Woby?"
msgstr "Circulez, y a rien à voir ! Ha ha ! Woby, j'ai fait une blague !"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.CHESSPIECE_FORMAL
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.CHESSPIECE_FORMAL"
msgid "Ugh. Who would want to be stuck wearing a suit forever?"
msgstr "Argh. Personne a envie de rester coincé dans un costume pour toujours !"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.CHESSPIECE_GUARDIANPHASE3
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.CHESSPIECE_GUARDIANPHASE3"
msgid "It's so lifelike, I feel like they're staring right at me!"
msgstr "C'est plus vrai que nature ! J'ai l'impression qu'il me fixe..."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.CHESSPIECE_HORNUCOPIA
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.CHESSPIECE_HORNUCOPIA"
msgid "I'm starting to get hungry just looking at it..."
msgstr "Ça me donne faim..."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.CHESSPIECE_KITCOON
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.CHESSPIECE_KITCOON"
msgid "They're pretty cute, but not as cute as you Woby."
msgstr "Ils sont mignons, mais pas autant que toi, Woby."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.CHESSPIECE_KLAUS
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.CHESSPIECE_KLAUS"
msgid "Aw, it reminds me of the holidays."
msgstr "Oh, ça me fait penser aux fêtes."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.CHESSPIECE_KNIGHT.GENERIC
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.CHESSPIECE_KNIGHT.GENERIC"
msgid "What are you so worried about Woby? It's just a statue."
msgstr "Qu'est-ce qui t'inquiète autant, Woby ? C'est juste une statue."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.CHESSPIECE_KNIGHT.STRUGGLE
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.CHESSPIECE_KNIGHT.STRUGGLE"
msgid "Alright Woby, I stand corrected."
msgstr "D'accord, Woby. J'ai rien dit."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.CHESSPIECE_MALBATROSS
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.CHESSPIECE_MALBATROSS"
msgid "She was pretty angry at us, wasn't she Woby?"
msgstr "Elle était fâchée contre nous... Hein, Woby ?"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.CHESSPIECE_MANRABBIT
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.CHESSPIECE_MANRABBIT"
msgid "He looks so happy! And hoppy!"
msgstr "Il a l'air super content ! Il pourrait sauter de joie !"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.CHESSPIECE_MINOTAUR
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.CHESSPIECE_MINOTAUR"
msgid "This statue is... a-maze-ing! Get it?"
msgstr "Cette statue est quand même vachement belle ! Hé hé."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.CHESSPIECE_MOON
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.CHESSPIECE_MOON"
msgid "It tells folks to be-were! Get it?"
msgstr "Au clair de la lune-euh..."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.CHESSPIECE_MOOSEGOOSE.1
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.CHESSPIECE_MOOSEGOOSE.1"
msgid "It's a shame things had to end the way they did."
msgstr "Dommage que ça ait fini comme ça..."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.CHESSPIECE_MUSE
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.CHESSPIECE_MUSE"
msgid "It's just a statue."
msgstr "C'est juste une statue."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.CHESSPIECE_PAWN
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.CHESSPIECE_PAWN"
msgid "Pawns don't seem like statue material."
msgstr "On fait vraiment des statues de pions ?"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.CHESSPIECE_PIPE
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.CHESSPIECE_PIPE"
msgid "It looks like one of those joke pipes you can mail in for."
msgstr "On dirait les fausses pipes qu'on peut avoir dans des magazines."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.CHESSPIECE_ROOK.GENERIC
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.CHESSPIECE_ROOK.GENERIC"
msgid "It's so lifelike!"
msgstr "C'est plus vrai que nature !"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.CHESSPIECE_ROOK.STRUGGLE
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.CHESSPIECE_ROOK.STRUGGLE"
msgid "Hey, I think it's moving!"
msgstr "Hé, je crois qu'elle bouge !"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.CHESSPIECE_SHARKBOI
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.CHESSPIECE_SHARKBOI"
msgid "Your bark was worse than their bite, Woby!"
msgstr "Chien qui aboie, requin qui ne mord pas, Woby !"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.CHESSPIECE_STALKER
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.CHESSPIECE_STALKER"
msgid "Definitely on my top five list of skeletons."
msgstr "C'est dans mon top cinq des meilleurs squelettes."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.CHESSPIECE_TOADSTOOL
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.CHESSPIECE_TOADSTOOL"
msgid "At least this version doesn't smell like old mushrooms."
msgstr "Au moins, celui-là ne sent pas le vieux moisi."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.CHESSPIECE_TWINSOFTERROR
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.CHESSPIECE_TWINSOFTERROR"
msgid "Is this one of those sculptures where the eyes follow you around the room?"
msgstr "C'est une de ces sculptures qui vous suivent du regard, c'est ça ?"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.CHESSPIECE_VAULT_PILLAR_GUARD
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.CHESSPIECE_VAULT_PILLAR_GUARD"
msgid "Don't even think about it, Woby!"
msgstr "N'y pense même pas, Woby !"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.CHESSPIECE_WAGBOSS_LUNAR
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.CHESSPIECE_WAGBOSS_LUNAR"
msgid "Like a robot possessed!"
msgstr "On dirait un robot possédé !"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.CHESSPIECE_WAGBOSS_ROBOT
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.CHESSPIECE_WAGBOSS_ROBOT"
msgid "My very own model robot!"
msgstr "Mon propre robot miniature !"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.CHESSPIECE_WARG_MUTATED
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.CHESSPIECE_WARG_MUTATED"
msgid "They weren't nearly as nice as you, Woby."
msgstr "Ils n'étaient vraiment pas aussi gentils que toi, Woby."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.CHESSPIECE_WORMBOSS
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.CHESSPIECE_WORMBOSS"
msgid "It was gross inside and out!"
msgstr "Il était dégueu, à l'intérieur comme à l'extérieur !"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.CHESSPIECE_YOTD
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.CHESSPIECE_YOTD"
msgid "Racing was fun, even if I didn't get a badge for it..."
msgstr "C'était marrant, la course, même si j'ai pas eu de badge..."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.CHESSPIECE_YOTH
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.CHESSPIECE_YOTH"
msgid "It's a chess piece of a chess piece!"
msgstr "C'est une pièce d'échecs de pièce d'échecs !"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.CHESSPIECE_YOTS
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.CHESSPIECE_YOTS"
msgid "The carving still looks slithery!"
msgstr "Il a encore l'air gluant !"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.CHESTER
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.CHESTER"
msgid "Who's a good little monster? You are!"
msgstr "C'est qui le plus mignon des monstres ? C'est toi !"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.CHESTER_EYEBONE.GENERIC
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.CHESTER_EYEBONE.GENERIC"
msgid "No chewing on this bone, okay Woby?"
msgstr "Tu ne mâchouilles pas cet os ! D'accord, Woby ?"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.CHESTER_EYEBONE.WAITING
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.CHESTER_EYEBONE.WAITING"
msgid "Getting some well deserved shut-eye."
msgstr "Il prend un repos bien mérité."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.CHESTUPGRADE_STACKSIZE
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.CHESTUPGRADE_STACKSIZE"
msgid "I can make more room for supplies!"
msgstr "Je peux faire de la place pour des réserves !"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.CHEST_MIMIC_REVEALED
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.CHEST_MIMIC_REVEALED"
msgid "And I was right! It's a box monster, Woby!"
msgstr "J'avais raison ! C'est une boîte-monstre, Woby !"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.CHUM
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.CHUM"
msgid "You use it to lure the fish in."
msgstr "Ça permet d'attirer les poissons."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.CLAYHOUND.GENERIC
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.CLAYHOUND.GENERIC"
msgid "Who's a good boy?"
msgstr "C'est qui le plus beau ?"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.CLAYHOUND.STATUE
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.CLAYHOUND.STATUE"
msgid "I wonder who made these statues? They look so real!"
msgstr "Je me demande qui a fait ces statues. Elles ont l'air si réelles !"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.CLAYWARG.GENERIC
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.CLAYWARG.GENERIC"
msgid "Don't worry, I'm good with dogs!"
msgstr "Vous en faites pas, les chiens m'adorent."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.CLAYWARG.STATUE
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.CLAYWARG.STATUE"
msgid "Woby's sure sniffing around this statue a lot."
msgstr "Woby renifle beaucoup cette statue."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.COLDFIRE.EMBERS
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.COLDFIRE.EMBERS"
msgid "We need more fuel for the fire!"
msgstr "On a besoin de combustible pour le feu !"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.COLDFIRE.GENERIC
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.COLDFIRE.GENERIC"
msgid "Anyone want to hear a scary story?"
msgstr "Quelqu'un veut une histoire qui fait peur ?"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.COLDFIRE.HIGH
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.COLDFIRE.HIGH"
msgid "Woah! I don't think that's safe..."
msgstr "Ouah ! Je pense pas que ce soit très sûr..."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.COLDFIRE.LOW
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.COLDFIRE.LOW"
msgid "It might need some more fuel."
msgstr "Il faut peut-être plus de combustible."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.COLDFIRE.NORMAL
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.COLDFIRE.NORMAL"
msgid "It's the perfect temperature for... cold marshmallows?"
msgstr "C'est la température idéale pour... faire des marshmallows froids ?"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.COLDFIRE.OUT
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.COLDFIRE.OUT"
msgid "Over already?"
msgstr "Oh, déjà fini ?"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.COLDFIREPIT.EMBERS
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.COLDFIREPIT.EMBERS"
msgid "We need more fuel for the fire!"
msgstr "On a besoin de combustible pour le feu !"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.COLDFIREPIT.GENERIC
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.COLDFIREPIT.GENERIC"
msgid "Anyone want to hear a scary story?"
msgstr "Quelqu'un veut une histoire qui fait peur ?"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.COLDFIREPIT.HIGH
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.COLDFIREPIT.HIGH"
msgid "Woah! I don't think that's safe..."
msgstr "Ouah ! Je pense pas que ce soit très sûr..."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.COLDFIREPIT.LOW
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.COLDFIREPIT.LOW"
msgid "I might need to feed the fire a bit."
msgstr "Je crois qu'il faut alimenter le feu."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.COLDFIREPIT.NORMAL
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.COLDFIREPIT.NORMAL"
msgid "It's the perfect temperature for... cold marshmallows?"
msgstr "C'est la température idéale pour... faire des marshmallows froids ?"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.COLDFIREPIT.OUT
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.COLDFIREPIT.OUT"
msgid "The fire pit's already built, all we need is more wood!"
msgstr "Le feu est prêt, il n'y a plus qu'à y mettre du bois !"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.COLLAPSEDCHEST
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.COLLAPSEDCHEST"
msgid "It looks pretty messed-up... but I think I could fix it!"
msgstr "C'est complètement bousillé, mais je crois pouvoir réparer ça !"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.COMPASS.E
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.COMPASS.E"
msgid "East."
msgstr "Est."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.COMPASS.GENERIC
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.COMPASS.GENERIC"
msgid "The Pinetree Pioneer handbook says to always bring a compass!"
msgstr "Le manuel des Scouts toujours dit qu'il faut jamais sortir sans boussole !"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.COMPASS.N
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.COMPASS.N"
msgid "North."
msgstr "Nord."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.COMPASS.NE
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.COMPASS.NE"
msgid "Northeast."
msgstr "Nord-est."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.COMPASS.NW
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.COMPASS.NW"
msgid "Northwest."
msgstr "Nord-ouest."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.COMPASS.S
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.COMPASS.S"
msgid "South."
msgstr "Sud."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.COMPASS.SE
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.COMPASS.SE"
msgid "Southeast."
msgstr "Sud-est."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.COMPASS.SW
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.COMPASS.SW"
msgid "Southwest."
msgstr "Sud-ouest."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.COMPASS.W
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.COMPASS.W"
msgid "West."
msgstr "Ouest."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.COMPOST
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.COMPOST"
msgid "Nothing goes to waste!"
msgstr "On gâche rien !"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.COMPOSTINGBIN.BALANCED
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.COMPOSTINGBIN.BALANCED"
msgid "That looks pretty good!"
msgstr "C'est pas mal, tout ça !"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.COMPOSTINGBIN.BURNT
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.COMPOSTINGBIN.BURNT"
msgid "We should all really be more careful with fire!"
msgstr "On devrait faire plus attention, ça brûle !"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.COMPOSTINGBIN.DRY
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.COMPOSTINGBIN.DRY"
msgid "Hm... does that look a bit too dry, Woby?"
msgstr "Hmm... Woby, tu trouves pas qu'on sèche un peu là ? Hé hé..."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.COMPOSTINGBIN.GENERIC
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.COMPOSTINGBIN.GENERIC"
msgid "Oooh, compost bins usually have all kinds of interesting bugs in them!"
msgstr "Oooh, il y a toujours des tas d'insectes trop cools, dans les composts !"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.COMPOSTINGBIN.WET
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.COMPOSTINGBIN.WET"
msgid "This might be a bit too wet."
msgstr "C'est p'têt un peu trop humide..."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.COMPOSTWRAP
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.COMPOSTWRAP"
msgid "Oh, uh... that's alright, I'm not hungry."
msgstr "Oh euh... C'est pas grave. J'ai pas faim."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.CONSTRUCTION_PLANS
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.CONSTRUCTION_PLANS"
msgid "I'm good at following instructions! I have a badge for it!"
msgstr "Je suis doué pour suivre des instructions ! J'ai même un badge, pour ça !"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.COOKBOOK
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.COOKBOOK"
msgid "Looks like I've got a new guide to memorize!"
msgstr "J'ai un nouveau manuel à apprendre, on dirait !"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.COOKEDMANDRAKE
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.COOKEDMANDRAKE"
msgid "Sorry little buddy."
msgstr "Désolé, petite."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.COOKEDMEAT
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.COOKEDMEAT"
msgid "You can't beat cooking outdoors!"
msgstr "Y a rien de mieux que de cuisiner en extérieur !"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.COOKEDMONSTERMEAT
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.COOKEDMONSTERMEAT"
msgid "Is it supposed to have that weird aftertaste?"
msgstr "C'est vraiment censé avoir cet arrière-goût bizarre ?"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.COOKEDSMALLMEAT
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.COOKEDSMALLMEAT"
msgid "A little meat is better than none."
msgstr "Un peu de viande, c'est mieux que rien."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.COOKIECUTTER
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.COOKIECUTTER"
msgid "They're smiling! Wait, I think I was looking at them upside-down."
msgstr "Il sourit ! Ah non, je crois que je le regarde à l'envers."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.COOKIECUTTERHAT
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.COOKIECUTTERHAT"
msgid "It's a shellmet! Because it's a helmet, but a shell-- you get it."
msgstr "C'est une carapace-chapeau... Une carapeau ?"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.COOKIECUTTERSHELL
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.COOKIECUTTERSHELL"
msgid "These guys have tough armor!"
msgstr "Il a une sacrée armure !"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.COOKINGRECIPECARD.GENERIC
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.COOKINGRECIPECARD.GENERIC"
msgid "Woby, I can't read the recipe if you chew on the cards!"
msgstr "Woby, je peux pas lire la recette si tu mâchouilles les cartes !"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.COOKPOT.BURNT
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.COOKPOT.BURNT"
msgid "It's uh... extra done!"
msgstr "C'est, euh... Bien bien cuit !"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.COOKPOT.COOKING_LONG
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.COOKPOT.COOKING_LONG"
msgid "This might take a while. Wanna see this cool bug I found in the meantime?"
msgstr "Ça risque de prendre du temps. En attendant, vous voulez voir le super insecte que j'ai trouvé ?"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.COOKPOT.COOKING_SHORT
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.COOKPOT.COOKING_SHORT"
msgid "Almost time to eat!"
msgstr "C'est presque l'heure de manger !"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.COOKPOT.DONE
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.COOKPOT.DONE"
msgid "Come and get it!"
msgstr "Servez-vous !"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.COOKPOT.EMPTY
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.COOKPOT.EMPTY"
msgid "Sure wish there was food in it."
msgstr "J'aimerais vraiment qu'il y ait à manger, dedans."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.COOLANT
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.COOLANT"
msgid "I don't know what that stuff is, but I love it."
msgstr "Je sais pas ce que c'est, mais j'adore."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.COONTAIL
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.COONTAIL"
msgid "It's a tall tail! Or, I guess more of a bushy one... never mind."
msgstr "Il a une grande queue ! Et toute duveteuse... Ça l'air doux."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.CORN
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.CORN"
msgid "Some corn on the cob sounds pretty good right about now."
msgstr "Je mangerais bien un épi de maïs, là."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.CORN_COOKED
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.CORN_COOKED"
msgid "I don't have anything to fund-raise for out here..."
msgstr "Avec un peu de beurre, ce serait parfait..."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.CORN_OVERSIZED
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.CORN_OVERSIZED"
msgid "Imagine all the popcorn we could make with that!"
msgstr "Imagine tout le pop-corn que ça ferait !"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.CORN_SEEDS
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.CORN_SEEDS"
msgid "We should plant these."
msgstr "On devrait les planter."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.COSTUME_BLACKSMITH_BODY
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.COSTUME_BLACKSMITH_BODY"
msgid "Who would leave such a nice costume out in the wilderness?"
msgstr "Qui laisserait un aussi joli costume en pleine nature ?"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.COSTUME_DOLL_BODY
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.COSTUME_DOLL_BODY"
msgid "Who would leave such a nice costume out in the wilderness?"
msgstr "Qui laisserait un aussi joli costume en pleine nature ?"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.COSTUME_FOOL_BODY
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.COSTUME_FOOL_BODY"
msgid "Who would leave such a nice costume out in the wilderness?"
msgstr "Qui laisserait un aussi joli costume en pleine nature ?"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.COSTUME_KING_BODY
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.COSTUME_KING_BODY"
msgid "Who would leave such a nice costume out in the wilderness?"
msgstr "Qui laisserait un aussi joli costume en pleine nature ?"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.COSTUME_MIRROR_BODY
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.COSTUME_MIRROR_BODY"
msgid "Who would leave such a nice costume out in the wilderness?"
msgstr "Qui laisserait un aussi joli costume en pleine nature ?"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.COSTUME_PRINCESS_BODY
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.COSTUME_PRINCESS_BODY"
msgid "Someone ponied up for this outfit."
msgstr "Quelqu'un a raqué pour cette tenue."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.COSTUME_QUEEN_BODY
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.COSTUME_QUEEN_BODY"
msgid "Who would leave such a nice costume out in the wilderness?"
msgstr "Qui laisserait un aussi joli costume en pleine nature ?"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.COSTUME_TREE_BODY
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.COSTUME_TREE_BODY"
msgid "Who would leave such a nice costume out in the wilderness?"
msgstr "Qui laisserait un aussi joli costume en pleine nature ?"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.COTL_TABERNACLE_LEVEL1.GENERIC
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.COTL_TABERNACLE_LEVEL1.GENERIC"
msgid "Come on Woby, we need to find some kindling!"
msgstr "Allez, Woby, il faut qu'on trouve du petit bois !"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.COTL_TABERNACLE_LEVEL1.LIT
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.COTL_TABERNACLE_LEVEL1.LIT"
msgid "That's one neat way to have a campfire!"
msgstr "C'est une chouette façon de faire un feu de camp !"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.COTL_TABERNACLE_LEVEL2.GENERIC
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.COTL_TABERNACLE_LEVEL2.GENERIC"
msgid "Come on Woby, we need to find some kindling!"
msgstr "Allez, Woby, il faut qu'on trouve du petit bois !"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.COTL_TABERNACLE_LEVEL2.LIT
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.COTL_TABERNACLE_LEVEL2.LIT"
msgid "Wow, it looks so nice it's kind of hard to leave!"
msgstr "Waouh, c'est tellement beau que ça fait presque de la peine de s'en aller !"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.COTL_TABERNACLE_LEVEL3.GENERIC
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.COTL_TABERNACLE_LEVEL3.GENERIC"
msgid "Come on Woby, we need to find some kindling!"
msgstr "Allez, Woby, il faut qu'on trouve du petit bois !"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.COTL_TABERNACLE_LEVEL3.LIT
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.COTL_TABERNACLE_LEVEL3.LIT"
msgid "I think I'll stay here and watch it... just a bit longer."
msgstr "Je crois que je vais rester ici et admirer ça encore un peu... juste un tout petit peu."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.COTL_TRINKET
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.COTL_TRINKET"
msgid "I hope whoever lost it isn't missing it too much."
msgstr "J'espère que ça manque pas trop à son ancien propriétaire."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.COZY_BUNNYMAN
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.COZY_BUNNYMAN"
msgid "They seem friendly!"
msgstr "Ils ont l'air gentils !"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.CRABKING.GENERIC
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.CRABKING.GENERIC"
msgid "YES!! Now that's a proper sea monster!"
msgstr "OUI !! Un vrai monstre marin !"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.CRABKING.INERT
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.CRABKING.INERT"
msgid "Who built this giant sand castle in the middle of the ocean?"
msgstr "Qui a construit cet immense château de sable en plein océan ?"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.CRABKING_CANNONTOWER
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.CRABKING_CANNONTOWER"
msgid "Incoming!"
msgstr "Attention !"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.CRABKING_CLAW
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.CRABKING_CLAW"
msgid "Woah! Look at the size of those claws!"
msgstr "Ouah ! Regardez-moi ces griffes !"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.CRABKING_ICEWALL
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.CRABKING_ICEWALL"
msgid "Just have to chip away at it."
msgstr "Il faut que je mine tout ça."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.CRABKING_MOB
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.CRABKING_MOB"
msgid "Watch out for those pinchers, Woby!"
msgstr "Attention aux pinces, Woby !"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.CRABKING_MOB_KNIGHT
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.CRABKING_MOB_KNIGHT"
msgid "Whoa! Cool crab!"
msgstr "Ouah ! Trop cool, ce crabe !"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.CRITTERLAB
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.CRITTERLAB"
msgid "What's wrong Woby? Is something in there?"
msgstr "Qu'est-ce qu'il y a, Woby ? Tu sens quelque chose, là-dedans ?"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.CRITTER_BULBIN
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.CRITTER_BULBIN"
msgid "I didn't know vegetables could be monsters too!"
msgstr "Je savais pas que les légumes pouvaient être des monstres !"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.CRITTER_DRAGONLING
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.CRITTER_DRAGONLING"
msgid "Play nice with Woby, okay?"
msgstr "Sois gentil avec Woby, d'accord ?"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.CRITTER_EETS
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.CRITTER_EETS"
msgid "Woah! You can jump REALLY high!"
msgstr "Ouah ! Tu sautes VRAIMENT haut !"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.CRITTER_EYEOFTERROR
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.CRITTER_EYEOFTERROR"
msgid "What is it, boy? Do you see something?"
msgstr "Qu'est-ce qu'il y a ? Tu as vu quelque chose ?"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.CRITTER_GLOMLING
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.CRITTER_GLOMLING"
msgid "It's small for a monster, but big for a bug."
msgstr "Il est petit pour un monstre, mais gros pour un insecte."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.CRITTER_KITTEN
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.CRITTER_KITTEN"
msgid "I'm usually more of a dog person, but you're so cute!"
msgstr "Je préfère les chiens d'habitude, mais t'es trop mignon !"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.CRITTER_LAMB
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.CRITTER_LAMB"
msgid "Aww, you're like a dust bunny that came to life!"
msgstr "Oooh, on dirait un mouton de poussière vivant !"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.CRITTER_LUNARMOTHLING
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.CRITTER_LUNARMOTHLING"
msgid "Mom would never let me keep a pet bug this big!"
msgstr "Maman m'aurait jamais laissé avoir un insecte de compagnie."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.CRITTER_PERDLING
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.CRITTER_PERDLING"
msgid "What a funny little turkey."
msgstr "Elle est marrante, cette dinde."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.CRITTER_PUPPY
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.CRITTER_PUPPY"
msgid "You and Woby will get along great!"
msgstr "Woby et toi vous entendriez super bien !"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.CROW.GENERIC
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.CROW.GENERIC"
msgid "Finally, something I recognize from my bird guide!"
msgstr "Enfin un oiseau qui est dans mon manuel !"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.CROW.HELD
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.CROW.HELD"
msgid "A pocket isn't really the best place for a bird."
msgstr "Une poche est pas l'endroit idéal pour y mettre un oiseau."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.CRUMBS
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.CRUMBS"
msgid "Maybe they dropped them to find their way home?"
msgstr "Ils en ont peut-être semé pour retrouver le chemin de la maison ?"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.CURSED_MONKEY_TOKEN
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.CURSED_MONKEY_TOKEN"
msgid "This is definitely going in my collection."
msgstr "Ça, ça va finir dans ma collection."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.CUTGRASS
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.CUTGRASS"
msgid "Look, I can make a whistle with it! PHHWEEEE!"
msgstr "Regardez, on peut siffler avec ! PFIIIIIIII !"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.CUTLESS
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.CUTLESS"
msgid "Toy swords are for little kids."
msgstr "C'est un jouet pour enfant."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.CUTLICHEN
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.CUTLICHEN"
msgid "This won't keep for long."
msgstr "Ça se gardera pas longtemps."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.CUTREEDS
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.CUTREEDS"
msgid "Ms. Wickerbottom might need some more... reed-ing material."
msgstr "Mme Wickerbottom voudra peut-être en faire du papier ?"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.CUTSTONE
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.CUTSTONE"
msgid "It wasn't too hard!"
msgstr "C'était pas si dur !"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.DAYWALKER.GENERIC
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.DAYWALKER.GENERIC"
msgid "I thought he'd be a bit happier to be free..."
msgstr "Je croyais qu'il serait content d'être libre, pourtant..."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.DAYWALKER.IMPRISONED
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.DAYWALKER.IMPRISONED"
msgid "We can't just leave him like that, Woby! We've gotta help him!"
msgstr "On peut pas le laisser comme ça, Woby ! Il faut qu'on l'aide !"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.DAYWALKER2.BURIED
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.DAYWALKER2.BURIED"
msgid "Should we help him, Woby?"
msgstr "Tu crois qu'on devrait l'aider, Woby ?"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.DAYWALKER2.GENERIC
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.DAYWALKER2.GENERIC"
msgid "Don't worry, Woby. I think I can gain his trust."
msgstr "Ne t'en fais pas, Woby. Je peux gagner sa confiance."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.DAYWALKER2.HOSTILE
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.DAYWALKER2.HOSTILE"
msgid "I still think we can be friends."
msgstr "Je pense qu'on peut être amis."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.DAYWALKER_PILLAR.EXPOSED
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.DAYWALKER_PILLAR.EXPOSED"
msgid "Oh, it's just a different kind of rock."
msgstr "Oh, c'est juste un autre genre de caillou en fait."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.DAYWALKER_PILLAR.GENERIC
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.DAYWALKER_PILLAR.GENERIC"
msgid "Hey, what's that stuff inside?"
msgstr "Hé, c'est quoi, dedans ?"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.DEADLYFEAST
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.DEADLYFEAST"
msgid "Someone could get sick from eating that!"
msgstr "Quelqu'un pourrait tomber malade en mangeant ça !"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.DEAD_SEA_BONES
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.DEAD_SEA_BONES"
msgid "These are definitely sea monster bones!"
msgstr "Ce sont des os de monstre marin, c'est sûr !"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.DECIDUOUSTREE.BURNING
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.DECIDUOUSTREE.BURNING"
msgid "You're supposed to chop the tree first, THEN build the fire!"
msgstr "On est censés d'abord couper l'arbre, et ENSUITE, faire un feu."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.DECIDUOUSTREE.BURNT
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.DECIDUOUSTREE.BURNT"
msgid "That tree just couldn't wait to be a campfire..."
msgstr "Cet arbre avait trop hâte de devenir un feu de camp..."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.DECIDUOUSTREE.CHOPPED
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.DECIDUOUSTREE.CHOPPED"
msgid "This tree looks stumped. Heh, nice one Walter."
msgstr "Cet arbre va dormir comme une souche. Hé hé !"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.DECIDUOUSTREE.GENERIC
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.DECIDUOUSTREE.GENERIC"
msgid "Did you know the word deciduous means to \"fall off\"?"
msgstr "Vous saviez que « caduc » ça voulait dire « qui tombe » ?"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.DECIDUOUSTREE.POISON
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.DECIDUOUSTREE.POISON"
msgid "Woah! I've never seen a tree with teeth before!"
msgstr "Ouah ! J'avais jamais vu d'arbre avec des dents !"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.DECK_OF_CARDS
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.DECK_OF_CARDS"
msgid "Woby! Pick a card, any card!"
msgstr "Woby ! Choisis une carte, n'importe laquelle !"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.DECOR_CENTERPIECE
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.DECOR_CENTERPIECE"
msgid "It's cool. I guess."
msgstr "C'est plutôt cool, je suppose."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.DECOR_FLOWERVASE.EMPTY
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.DECOR_FLOWERVASE.EMPTY"
msgid "Woby, did you eat the flower?"
msgstr "Woby, c'est toi qui as mangé la fleur ?"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.DECOR_FLOWERVASE.FRESHLIGHT
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.DECOR_FLOWERVASE.FRESHLIGHT"
msgid "Oooh, useful."
msgstr "Oh, voilà qui est utile."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.DECOR_FLOWERVASE.GENERIC
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.DECOR_FLOWERVASE.GENERIC"
msgid "Careful with that, Woby."
msgstr "Attention avec ça, Woby."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.DECOR_FLOWERVASE.OLDLIGHT
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.DECOR_FLOWERVASE.OLDLIGHT"
msgid "We should find a fresh one, Woby!"
msgstr "On devrait trouver une fleur fraîche, Woby !"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.DECOR_FLOWERVASE.WILTED
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.DECOR_FLOWERVASE.WILTED"
msgid "It looks sad."
msgstr "Elle a l'air triste."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.DECOR_LAMP
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.DECOR_LAMP"
msgid "Turn it off when we tell ghost stories."
msgstr "À éteindre quand on raconte des histoires effrayantes."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.DECOR_PICTUREFRAME.GENERIC
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.DECOR_PICTUREFRAME.GENERIC"
msgid "Is it upside down?"
msgstr "C'est à l'envers ?"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.DECOR_PICTUREFRAME.UNDRAWN
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.DECOR_PICTUREFRAME.UNDRAWN"
msgid "Woby, wanna do a pawprint painting?"
msgstr "Woby, tu veux peindre avec tes petites pattes ?"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.DECOR_PORTRAITFRAME
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.DECOR_PORTRAITFRAME"
msgid "It really looks like them! Right, Woby?"
msgstr "C'est hyper ressemblant ! Tu trouves pas, Woby ?"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.DEER.ANTLER
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.DEER.ANTLER"
msgid "You could poke an eye out with those! Maybe he already did?"
msgstr "C'est un coup à se crever un œil, ce truc ! C'est peut-être déjà arrivé."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.DEER.GENERIC
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.DEER.GENERIC"
msgid "Hey Woby, do you guys go to the same barber?"
msgstr "Hé, Woby ? Vous allez chez le même coiffeur, tu crois ?"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.DEERCLOPS
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.DEERCLOPS"
msgid "Woah! It's you!"
msgstr "Ouah ! Mais c'est toi !"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.DEERCLOPSCORPSE.BURNING
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.DEERCLOPSCORPSE.BURNING"
msgid "I'm going to miss her."
msgstr "Il va me manquer."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.DEERCLOPSCORPSE.GENERIC
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.DEERCLOPSCORPSE.GENERIC"
msgid "Poor Deerclops..."
msgstr "Pauvre cerf-clope..."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.DEERCLOPSCORPSE.REVIVING
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.DEERCLOPSCORPSE.REVIVING"
msgid "Look Woby, she's okay!"
msgstr "Regarde, Woby, il va bien !"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.DEERCLOPSEYEBALL_SENTRYWARD.GENERIC
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.DEERCLOPSEYEBALL_SENTRYWARD.GENERIC"
msgid "The way it just stares at me is so creepy. I love it."
msgstr "La façon dont ce machin me regarde est vraiment flippante. J'adore ça."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.DEERCLOPSEYEBALL_SENTRYWARD.NOEYEBALL
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.DEERCLOPSEYEBALL_SENTRYWARD.NOEYEBALL"
msgid "Something is missing. Woby, that eyeball is not a toy!"
msgstr "Il manque quelque chose. Woby, cet œil n'est pas un jouet !"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.DEERCLOPSEYEBALL_SENTRYWARD_KIT
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.DEERCLOPSEYEBALL_SENTRYWARD_KIT"
msgid "Woby, wanna help me put this together?"
msgstr "Woby, tu veux m'aider à assembler ça ?"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.DEERCLOPS_EYEBALL
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.DEERCLOPS_EYEBALL"
msgid "At least we got this souvenir."
msgstr "Au moins, on a récupéré un souvenir."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.DEER_ANTLER
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.DEER_ANTLER"
msgid "Hey, you dropped this!"
msgstr "Hé, tu as laissé tomber ça !"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.DEER_GEMMED
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.DEER_GEMMED"
msgid "It can't be comfortable having a gem stuck in your forehead."
msgstr "Ça doit pas être très confortable d'avoir une gemme dans le front."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.DEPLETED_GRASS.GENERIC
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.DEPLETED_GRASS.GENERIC"
msgid "It hasn't grown back yet."
msgstr "Ça n'a pas encore repoussé."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.DESERTHAT
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.DESERTHAT"
msgid "It's important to dress appropriately for the environment."
msgstr "C'est important d'avoir une tenue adaptée à l'environnement."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.DESICCANT
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.DESICCANT"
msgid "No more wet dog smell for you, Woby!"
msgstr "Tu sentiras plus jamais le chien mouillé, Woby !"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.DESICCANTBOOSTED
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.DESICCANTBOOSTED"
msgid "It sure keeps me nice and dry."
msgstr "Je reste au sec, comme ça."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.DEVTOOL
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.DEVTOOL"
msgid "Weird! It looks like an axe, but..."
msgstr "Bizarre. On dirait une hache, mais..."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.DEVTOOL_NODEV
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.DEVTOOL_NODEV"
msgid "Guess I haven't earned that badge yet."
msgstr "Je pense que j'ai pas encore décroché ce badge."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.DIRTPILE
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.DIRTPILE"
msgid "Woby, did you dig something up?"
msgstr "Woby, tu as déterré quelque chose ?"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.DIVININGROD.COLD
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.DIVININGROD.COLD"
msgid "Getting colder... must've taken a wrong turn."
msgstr "Ça refroidit... Je dois pas aller dans la bonne direction."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.DIVININGROD.GENERIC
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.DIVININGROD.GENERIC"
msgid "Hey! This looks a lot like that radio!"
msgstr "Hé ! Ça me fait penser à cette radio..."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.DIVININGROD.HOT
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.DIVININGROD.HOT"
msgid "We're hot on the trail, Woby!"
msgstr "On chauffe, Woby !"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.DIVININGROD.WARM
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.DIVININGROD.WARM"
msgid "Getting warm..."
msgstr "Ça chauffe..."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.DIVININGROD.WARMER
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.DIVININGROD.WARMER"
msgid "Warmer..."
msgstr "Ça chauffe encore..."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.DIVININGRODBASE.GENERIC
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.DIVININGRODBASE.GENERIC"
msgid "This looks important."
msgstr "Ça a l'air important."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.DIVININGRODBASE.READY
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.DIVININGRODBASE.READY"
msgid "Maybe I can unlock it with something..."
msgstr "Je peux peut-être la débloquer grâce à quelque chose..."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.DIVININGRODBASE.UNLOCKED
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.DIVININGRODBASE.UNLOCKED"
msgid "It worked!"
msgstr "Ça a marché !"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.DIVININGRODSTART
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.DIVININGRODSTART"
msgid "Hey! This looks a lot like that radio!"
msgstr "Hé ! Ça me fait penser à cette radio..."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.DOCK_KIT
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.DOCK_KIT"
msgid "Neat, I can build a dock for my boat!"
msgstr "Super, je vais pouvoir faire un quai pour mon bateau !"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.DOCK_WOODPOSTS_ITEM
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.DOCK_WOODPOSTS_ITEM"
msgid "Some posts will make the dock look even more... dock-y."
msgstr "Quelques poteaux et le quai sera... o-quai !"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.DOLL_BLUEPRINT
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.DOLL_BLUEPRINT"
msgid "Aww, it's cute!"
msgstr "Oooh, trop chou !"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.DRAGONBOAT_KIT
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.DRAGONBOAT_KIT"
msgid "Stand back everyone, this looks like a job for a Pinetree Pioneer."
msgstr "Reculez, c'est une mission pour un Scout toujours."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.DRAGONBOAT_PACK
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.DRAGONBOAT_PACK"
msgid "Wow, how did they pack this all up so tightly?"
msgstr "Ouah, comment est-ce qu'ils ont emballé tout ça comme ça ?"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.DRAGONBODYHAT
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.DRAGONBODYHAT"
msgid "I think I'd be better in the lead."
msgstr "Je pense que je ferais mieux de prendre la tête."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.DRAGONCHILISALAD
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.DRAGONCHILISALAD"
msgid "Is it made from real dragons?"
msgstr "C'est fait de vrais dragons ?"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.DRAGONFLY
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.DRAGONFLY"
msgid "Woah! It's a giant bug!"
msgstr "Ouah, c'est un insecte géant !"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.DRAGONFLYCHEST.GENERIC
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.DRAGONFLYCHEST.GENERIC"
msgid "We'll have to find something worthy of going in there."
msgstr "Il faut qu'on trouve quelque chose qui mérite d'aller là-dedans."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.DRAGONFLYCHEST.UPGRADED_STACKSIZE
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.DRAGONFLYCHEST.UPGRADED_STACKSIZE"
msgid "The more supplies we can keep safe from fire, the better!"
msgstr "Plus on protège des réserves du feu, mieux c'est !"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.DRAGONFLYFURNACE.GENERIC
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.DRAGONFLYFURNACE.GENERIC"
msgid "Can I cook marshmallows over it though?"
msgstr "Je peux y cuire des marshmallows ou pas ?"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.DRAGONFLYFURNACE.HAMMERED
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.DRAGONFLYFURNACE.HAMMERED"
msgid "...That didn't fix it."
msgstr "... Ça l'a pas réparé."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.DRAGONFLYFURNACE.HIGH
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.DRAGONFLYFURNACE.HIGH"
msgid "Roasty!"
msgstr "Il est rôti."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.DRAGONFLYFURNACE.NORMAL
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.DRAGONFLYFURNACE.NORMAL"
msgid "Toasty!"
msgstr "Mmh, tout juste grillé !"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.DRAGONFRUIT
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.DRAGONFRUIT"
msgid "Looks tasty."
msgstr "Ça a l'air bon."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.DRAGONFRUIT_COOKED
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.DRAGONFRUIT_COOKED"
msgid "It makes sense that Dragon Fruit tastes better with fire."
msgstr "Un fruit du dragon, c'est meilleur une fois passé à la flamme. Forcément."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.DRAGONFRUIT_OVERSIZED
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.DRAGONFRUIT_OVERSIZED"
msgid "Unfortunately, not a real dragon."
msgstr "C'est malheureusement pas un vrai dragon..."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.DRAGONFRUIT_SEEDS
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.DRAGONFRUIT_SEEDS"
msgid "Let's find some place to plant these."
msgstr "Trouvons un endroit pour les planter."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.DRAGONHEADHAT
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.DRAGONHEADHAT"
msgid "I'll be the leader!"
msgstr "C'est moi le chef !"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.DRAGONPIE
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.DRAGONPIE"
msgid "Is it made from actual dragons?"
msgstr "C'est fait avec de vrais dragons ?"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.DRAGONTAILHAT
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.DRAGONTAILHAT"
msgid "I don't want the back end..."
msgstr "Je veux pas être à l'arrière..."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.DRAGON_SCALES
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.DRAGON_SCALES"
msgid "Was she a bug or a lizard?"
msgstr "C'était un insecte ou un lézard ?"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.DREADSTONE
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.DREADSTONE"
msgid "It's just a rock, what's so scary about a rock?"
msgstr "C'est juste un caillou. Ça fait pas peur, un caillou."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.DREADSTONEHAT
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.DREADSTONEHAT"
msgid "Never forget to wear your dark helmet."
msgstr "Ne jamais oublier de porter un casque... de ténèbres."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.DREADSTONE_STACK
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.DREADSTONE_STACK"
msgid "I bet there's more buried deep underground!"
msgstr "Je parie qu'il y en a encore plus sous terre !"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.DRIFTWOOD_LOG
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.DRIFTWOOD_LOG"
msgid "You'll float too, if you hold onto it!"
msgstr "On peut flotter dessus !"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.DRIFTWOOD_TREE.BURNING
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.DRIFTWOOD_TREE.BURNING"
msgid "You're supposed to make a pit, gather the firewood and THEN make a fire!"
msgstr "On est censé mettre des bûches d'abord et ENSUITE allumer un feu !"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.DRIFTWOOD_TREE.BURNT
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.DRIFTWOOD_TREE.BURNT"
msgid "That could've been bad."
msgstr "Ça aurait pu mal se passer."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.DRIFTWOOD_TREE.CHOPPED
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.DRIFTWOOD_TREE.CHOPPED"
msgid "Thanks for the firewood, tree!"
msgstr "Merci pour le bois, monsieur l'arbre !"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.DRIFTWOOD_TREE.GENERIC
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.DRIFTWOOD_TREE.GENERIC"
msgid "Looks kind of eerie, doesn't it?"
msgstr "Ça a l'air plutôt étrange, non ?"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.DRUMSTICK
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.DRUMSTICK"
msgid "Is it a good idea to eat raw meat...?"
msgstr "C'est vraiment une bonne idée de manger de la viande crue ?"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.DRUMSTICK_COOKED
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.DRUMSTICK_COOKED"
msgid "That's better!"
msgstr "C'est mieux !"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.DUG_BANANABUSH
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.DUG_BANANABUSH"
msgid "Wait, I thought bananas grew on trees around here?"
msgstr "Attendez, je croyais que les bananes poussaient sur les arbres, ici !"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.DUG_BERRYBUSH
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.DUG_BERRYBUSH"
msgid "Come on berry bush, we're going on an adventure!"
msgstr "Allez, petit buisson. On part à l'aventure !"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.DUG_BERRYBUSH_JUICY
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.DUG_BERRYBUSH_JUICY"
msgid "Come on berry bush, we're going on an adventure!"
msgstr "Allez, petit buisson. On part à l'aventure !"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.DUG_GRASS
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.DUG_GRASS"
msgid "Now I can plant it closer to camp."
msgstr "Maintenant, je peux la planter plus près de mon camp."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.DUG_MARSH_BUSH
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.DUG_MARSH_BUSH"
msgid "Hey Woby, do you see a good spot to plant this?"
msgstr "Hé, Woby, tu sais où on pourrait le planter ?"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.DUG_MONKEYTAIL
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.DUG_MONKEYTAIL"
msgid "I wonder if there's any real monkeys hiding in there?"
msgstr "Je me demande s'il y a de vrais singes qui se cache, par ici."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.DUG_SAPLING
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.DUG_SAPLING"
msgid "Hey Woby, do you see a good spot to plant this?"
msgstr "Hé, Woby, tu sais où on pourrait le planter ?"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.DUG_TRAP_STARFISH
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.DUG_TRAP_STARFISH"
msgid "I'm putting them in time out."
msgstr "Je vais m'en débarrasser."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.DUMBBELL
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.DUMBBELL"
msgid "I can do it! I just... need to get a good grip on it!"
msgstr "J'vais y arriver ! Il faut juste... que je respire un grand coup !"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.DUMBBELL_BLUEGEM
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.DUMBBELL_BLUEGEM"
msgid "You'll get a really n-ice workout with that! Heh. Good one, Walter."
msgstr "Avec ça, on peut devenir taillé comme une armoire à glace ! Haha, sacrée vanne, je suis trop fort."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.DUMBBELL_GEM
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.DUMBBELL_GEM"
msgid "Time to hit the gem! Get it? Because gem sounds like gym?"
msgstr "Faire du sport, ça rend joyau ! Joyeux, joyau... t'as compris ?"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.DUMBBELL_GOLDEN
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.DUMBBELL_GOLDEN"
msgid "Uh, m-maybe I should start with something a bit lighter."
msgstr "Euuuh, je devrais peut-être commencer par quelque chose de plus léger."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.DUMBBELL_HEAT
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.DUMBBELL_HEAT"
msgid "I can warm up without lifting anything! N-not that I can't!"
msgstr "J'ai pas besoin de faire de la muscu pour me réchauffer ! Et je dis pas ça parce que c'est trop lourd pour moi !"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.DUMBBELL_MARBLE
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.DUMBBELL_MARBLE"
msgid "Oh... when he said it was made of marble, I kind of hoped he meant the tiny ones."
msgstr "Oh... quand il disait que c'était marbré, je pensais qu'il parlait du gâteau..."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.DUMBBELL_REDGEM
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.DUMBBELL_REDGEM"
msgid "I don't think your muscles should be burning THAT much..."
msgstr "Ouah, c'est pas normal d'avoir autant les muscles en feu..."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.DURIAN
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.DURIAN"
msgid "Yuck! What is that?"
msgstr "Argh ! C'est quoi ce truc ?"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.DURIAN_COOKED
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.DURIAN_COOKED"
msgid "No thank you."
msgstr "Non, merci."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.DURIAN_OVERSIZED
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.DURIAN_OVERSIZED"
msgid "Why did this one have to grow so big?"
msgstr "Pourquoi celui-là est aussi gros, franchement ?"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.DURIAN_SEEDS
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.DURIAN_SEEDS"
msgid "Yep, those are seeds!"
msgstr "Ouais, c'est des graines !"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.DUSTMERINGUE
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.DUSTMERINGUE"
msgid "Uh... no thanks. Maybe the moths will like it?"
msgstr "Euh... Non merci. Ça plaira peut-être aux papillons ?"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.DUSTMOTH
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.DUSTMOTH"
msgid "Can I keep them? Pleeeaaaase?"
msgstr "J'peux les garder ? Alleeeeeez !"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.DUSTMOTHDEN
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.DUSTMOTHDEN"
msgid "Woah, so that's where that weird material comes from!"
msgstr "Ouah... C'est donc de là que vient ce matériau bizarre !"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.EARMUFFSHAT
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.EARMUFFSHAT"
msgid "Some of us don't have ear fluff of our own, Woby."
msgstr "Certains d'entre nous n'ont pas de fourrure sur les oreilles, Woby."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.EEL
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.EEL"
msgid "Look at the teeth it has!"
msgstr "Vous avez vu ces dents ?!"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.EEL_COOKED
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.EEL_COOKED"
msgid "That actually smells pretty good!"
msgstr "Ça sent bon !"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.EGGPLANT
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.EGGPLANT"
msgid "Even in the wilderness you have to eat your vegetables."
msgstr "Il faut toujours manger ses légumes, même dans la nature."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.EGGPLANT_COOKED
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.EGGPLANT_COOKED"
msgid "Oh, it's much better cooked!"
msgstr "Oh, c'est bien meilleur quand c'est cuit !"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.EGGPLANT_OVERSIZED
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.EGGPLANT_OVERSIZED"
msgid "Oh... great! I guess we're eating eggplant for the next week..."
msgstr "Oh... eh ben cool ! On mange de l'aubergine toute la semaine, on dirait..."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.EGGPLANT_SEEDS
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.EGGPLANT_SEEDS"
msgid "We should find a place to plant these."
msgstr "On devrait trouver un endroit pour les planter."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.ELIXIR_CONTAINER
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.ELIXIR_CONTAINER"
msgid "Contents not safe for human consumption!"
msgstr "Ce n'est pas destiné à la consommation humaine !"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.EMBERLIGHT
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.EMBERLIGHT"
msgid "There's no wood in this campfire. Oh well."
msgstr "Il n'y a même pas de bois dans ce feu de camp. Bah..."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.ENDTABLE.BURNT
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.ENDTABLE.BURNT"
msgid "That's how forest fires get started!"
msgstr "C'est comme ça que les feux de forêt commencent !"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.ENDTABLE.EMPTY
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.ENDTABLE.EMPTY"
msgid "Hey... I think I saw something move under there."
msgstr "Hé... Je crois que j'ai vu un truc bouger, là-dessous."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.ENDTABLE.FRESHLIGHT
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.ENDTABLE.FRESHLIGHT"
msgid "Ta-da! Light!"
msgstr "Tadaaam ! Et la lumière fut !"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.ENDTABLE.GENERIC
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.ENDTABLE.GENERIC"
msgid "Is somebody decorating out here?"
msgstr "Quelqu'un veut décorer cet endroit ?"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.ENDTABLE.OLDLIGHT
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.ENDTABLE.OLDLIGHT"
msgid "Looks like we need to replace a bulb."
msgstr "Je crois qu'on doit remplacer une ampoule."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.ENDTABLE.WILTED
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.ENDTABLE.WILTED"
msgid "Those flowers are looking pretty sad."
msgstr "Ces fleurs ont l'air toutes tristes."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.EVERGREEN.BURNING
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.EVERGREEN.BURNING"
msgid "You're supposed to chop the tree first, THEN build the fire!"
msgstr "On est censés d'abord couper l'arbre, et ENSUITE, faire un feu."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.EVERGREEN.BURNT
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.EVERGREEN.BURNT"
msgid "That tree just couldn't wait to be a campfire..."
msgstr "Cet arbre avait trop hâte de devenir un feu de camp..."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.EVERGREEN.CHOPPED
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.EVERGREEN.CHOPPED"
msgid "This tree looks stumped. Heh, nice one Walter."
msgstr "Cet arbre va dormir comme une souche. Hé hé !"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.EVERGREEN.GENERIC
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.EVERGREEN.GENERIC"
msgid "They're called \"evergreen\" because... well you get the idea."
msgstr "On dit que ces arbres sont à « feuillage persistant » parce que... Enfin, c'est clair, quoi."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.EVERGREEN_SPARSE.BURNING
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.EVERGREEN_SPARSE.BURNING"
msgid "You're supposed to chop the tree first, THEN build the fire!"
msgstr "On est censés d'abord couper l'arbre, et ENSUITE, faire un feu."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.EVERGREEN_SPARSE.BURNT
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.EVERGREEN_SPARSE.BURNT"
msgid "That tree just couldn't wait to be a campfire..."
msgstr "Cet arbre avait trop hâte de devenir un feu de camp..."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.EVERGREEN_SPARSE.CHOPPED
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.EVERGREEN_SPARSE.CHOPPED"
msgid "This tree looks stumped. Heh, nice one Walter."
msgstr "Cet arbre va dormir comme une souche. Hé hé !"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.EVERGREEN_SPARSE.GENERIC
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.EVERGREEN_SPARSE.GENERIC"
msgid "What a scraggly tree."
msgstr "Cet arbre est miteux."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.EYEBRELLAHAT
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.EYEBRELLAHAT"
msgid "It keeps an eye on me. Get it? Because it's a giant eyeball?"
msgstr "Il me tient à l'œil... Hé hé ! C'est parce que c'est un œil géant."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.EYEMASKHAT
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.EYEMASKHAT"
msgid "Don't worry Woby. It's just a hat, see?"
msgstr "T'en fais pas, Woby. C'est juste un chapeau. Tu vois ?"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.EYEOFTERROR
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.EYEOFTERROR"
msgid "Wow! Do you think it escaped from a giant head?"
msgstr "Ouah ! Tu crois que ça vient d'une tête géante ?"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.EYEOFTERROR_MINI
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.EYEOFTERROR_MINI"
msgid "Would you say they're... multipl-eying? Heh. Good one, Walter."
msgstr "Je crois qu'on peut dire que je lui ai tapé... dans l'œil ! Hé hé, t'es trop drôle, Walter."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.EYEOFTERROR_MINI_GROUNDED
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.EYEOFTERROR_MINI_GROUNDED"
msgid "Ohh, so that's how baby eyeballs are made."
msgstr "Oooh, c'est de là que viennent les bébés yeux, alors !"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.EYEPLANT
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.EYEPLANT"
msgid "Eye bet it's friendly!"
msgstr "Je suis sûr qu'il est très amical."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.EYETURRET
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.EYETURRET"
msgid "It's keeping an eye on me! Get it? Because it's... you know..."
msgstr "Il me tient à l'œil... Hé hé ! C'est parce que... Enfin vous voyez."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.EYETURRET_ITEM
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.EYETURRET_ITEM"
msgid "Come on Woby, let's find a good place to put this!"
msgstr "Viens, Woby. Trouvons où on peut mettre ça !"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.FARMPLOT.BURNT
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.FARMPLOT.BURNT"
msgid "Darnit, now I have to start all over!"
msgstr "Ah zut, il va falloir que je recommence tout !"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.FARMPLOT.GENERIC
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.FARMPLOT.GENERIC"
msgid "Mom never let me in her garden... not since the Slug Incident."
msgstr "Maman ne me laisse jamais aller dans son jardin... depuis l'incident des limaces."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.FARMPLOT.GROWING
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.FARMPLOT.GROWING"
msgid "Hey! I'm pretty good at this!"
msgstr "Hé, je suis plutôt doué !"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.FARMPLOT.NEEDSFERTILIZER
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.FARMPLOT.NEEDSFERTILIZER"
msgid "It needs something to help it grow..."
msgstr "Il lui faut un truc pour l'aider à pousser..."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.FARM_HOE
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.FARM_HOE"
msgid "We'll need that to plant seeds."
msgstr "Ça nous servira à planter des graines."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.FARM_PLANT.BURNING
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.FARM_PLANT.BURNING"
msgid "They uh... might need some water."
msgstr "Euh... Je crois qu'elle manque d'eau."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.FARM_PLANT.FULL
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.FARM_PLANT.FULL"
msgid "I think it's ready to pick!"
msgstr "Je pense que c'est l'heure de la récolte !"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.FARM_PLANT.FULL_OVERSIZED
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.FARM_PLANT.FULL_OVERSIZED"
msgid "Woah, what a monster!"
msgstr "Ouah, quel monstre !"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.FARM_PLANT.FULL_WEED
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.FARM_PLANT.FULL_WEED"
msgid "Hey, you're not a vegetable!"
msgstr "Hé, t'es pas un légume, toi !"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.FARM_PLANT.GENERIC
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.FARM_PLANT.GENERIC"
msgid "That's one of our plants."
msgstr "C'est une de nos plantes."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.FARM_PLANT.GROWING
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.FARM_PLANT.GROWING"
msgid "I'll take good care of you, don't you worry."
msgstr "Je vais bien m'occuper de toi, tu verras."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.FARM_PLANT.ROTTEN
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.FARM_PLANT.ROTTEN"
msgid "Whoops... I probably should've picked that sooner."
msgstr "Oups... J'aurais dû la cueillir plus tôt."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.FARM_PLANT.ROTTEN_OVERSIZED
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.FARM_PLANT.ROTTEN_OVERSIZED"
msgid "It's all rotten!"
msgstr "C'est tout pourri !"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.FARM_PLANT.SEED
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.FARM_PLANT.SEED"
msgid "Look Woby, it's growing!"
msgstr "Regarde, Woby ! Ça pousse !"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.FARM_PLOW
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.FARM_PLOW"
msgid "Hey, farming doesn't seem too hard!"
msgstr "C'est pas si dur, l'agriculture !"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.FARM_PLOW_ITEM
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.FARM_PLOW_ITEM"
msgid "Want to help me find a good place for the garden, Woby?"
msgstr "Tu m'aides à trouver un bon endroit pour mettre notre jardin, Woby ?"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.FARM_SOIL_DEBRIS
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.FARM_SOIL_DEBRIS"
msgid "We'd better clean that up."
msgstr "On ferait mieux de nettoyer tout ça."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.FEATHERFAN
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.FEATHERFAN"
msgid "I'm a big fan of staying cool. Get it, because it's a fan?"
msgstr "Moi je suis pour rester toujours au frais. Un éventail, c'est parfait !"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.FEATHERHAT
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.FEATHERHAT"
msgid "And I thought my bird watching badge was a feather in my cap!"
msgstr "Je ressemble à Robin des bois !"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.FEATHERPENCIL
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.FEATHERPENCIL"
msgid "I feel like I should write something poetic with this..."
msgstr "J'ai envie d'écrire de la poésie avec ça..."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.FEATHER_CANARY
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.FEATHER_CANARY"
msgid "Looks like a canary feather."
msgstr "Ça ressemble à une plume de canari."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.FEATHER_CROW
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.FEATHER_CROW"
msgid "Looks like a black bird feather."
msgstr "Ça ressemble à une plume de corbeau."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.FEATHER_ROBIN
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.FEATHER_ROBIN"
msgid "Looks like a redbird feather."
msgstr "Ça ressemble à une plume de cardinal."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.FEATHER_ROBIN_WINTER
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.FEATHER_ROBIN_WINTER"
msgid "Looks like a snowbird feather."
msgstr "Ça ressemble à une plume d'un oiseau des neiges."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.FEM_PUPPET
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.FEM_PUPPET"
msgid "Don't worry, a Pinetree Pioneer always helps those in need!"
msgstr "Vous en faites pas, un Scout toujours aide toujours ceux dans le besoin !"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.FENCE
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.FENCE"
msgid "Why do we need fences? It's the great outdoors!"
msgstr "Qui a besoin de clôtures quand on est aussi bien dehors !"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.FENCE_ELECTRIC.GENERIC
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.FENCE_ELECTRIC.GENERIC"
msgid "Don't worry, Wobes. It's not connected."
msgstr "T'inquiète, Woby. C'est pas connecté."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.FENCE_ELECTRIC.LINKED
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.FENCE_ELECTRIC.LINKED"
msgid "Stay back, Woby!"
msgstr "Recule, Woby !"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.FENCE_ELECTRIC_ITEM
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.FENCE_ELECTRIC_ITEM"
msgid "We have to plant it first."
msgstr "On doit d'abord le planter."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.FENCE_GATE
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.FENCE_GATE"
msgid "It's open-and-shut."
msgstr "Ça s'ouvre. Et ça se ferme !"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.FENCE_GATE_ITEM
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.FENCE_GATE_ITEM"
msgid "I guess I should find someplace to put that."
msgstr "Il faudrait que je trouve où mettre ça."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.FENCE_ITEM
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.FENCE_ITEM"
msgid "Why fence in nature?"
msgstr "Pourquoi mettre des clôtures dans la nature ?"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.FENCE_JUNK
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.FENCE_JUNK"
msgid "I guess it's better than just leaving all that scrap metal lying around."
msgstr "J'imagine qu'il vaut mieux ça que laisser cette ferraille par terre."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.FENCE_ROTATOR
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.FENCE_ROTATOR"
msgid "Huh. I didn't know people used swords to fix their fences."
msgstr "Ha, je savais pas que les gens utilisaient des épées pour réparer leurs clôtures."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.FERTILIZER
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.FERTILIZER"
msgid "Plants love poop."
msgstr "Les plantes adorent le caca."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.FESTIVEFISH
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.FESTIVEFISH"
msgid "Fish with some special seasonal seasonings."
msgstr "Du poisson assaisonné spécialement pour la saison."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.FESTIVE_BLUEPRINT
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.FESTIVE_BLUEPRINT"
msgid "I wish I could make one for Woby, but her measurements keep changing..."
msgstr "J'aimerais bien en faire un pour Woby, mais elle arrête pas de changer de taille..."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.FIG
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.FIG"
msgid "I don't really like figs..."
msgstr "J'aime pas trop les figues..."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.FIGATONI
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.FIGATONI"
msgid "At least the fig's hidden inside."
msgstr "Au moins, on sent pas trop la figue."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.FIGKABAB
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.FIGKABAB"
msgid "Aw, did it have to be figs?"
msgstr "Pfff... Des figues ? Vraiment ?"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.FIG_COOKED
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.FIG_COOKED"
msgid "I don't really like cooked figs any better..."
msgstr "J'aime pas non plus les figues cuites..."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.FIREBALLSTAFF
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.FIREBALLSTAFF"
msgid "It calls a meteor from above."
msgstr "Ça fait tomber une météorite."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.FIRECRACKERS
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.FIRECRACKERS"
msgid "You're not supposed to set those off in the woods."
msgstr "On est pas censé en tirer dans les bois."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.FIREFLIES.GENERIC
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.FIREFLIES.GENERIC"
msgid "I wish I had a jar."
msgstr "J'aimerais trop avoir un bocal."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.FIREFLIES.HELD
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.FIREFLIES.HELD"
msgid "Hope they get along with the other bugs in my pockets."
msgstr "J'espère qu'elles s'entendront bien avec les autres insectes dans mes poches."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.FIREHOUND
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.FIREHOUND"
msgid "Who's a good boy?"
msgstr "C'est qui le plus beau ?"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.FIRENETTLES
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.FIRENETTLES"
msgid "They're even worse than poison oak!"
msgstr "C'est encore pire que des fleurs vénéneuses !"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.FIRENETTLES_DRIED
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.FIRENETTLES_DRIED"
msgid "Dried perfectly!"
msgstr "Séché à la perfection !"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.FIREPEN
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.FIREPEN"
msgid "I had no idea writing was so dangerous."
msgstr "Je savais pas qu'écrire était aussi dangereux."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.FIREPIT.EMBERS
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.FIREPIT.EMBERS"
msgid "We need more fuel for the fire!"
msgstr "On a besoin de combustible pour le feu !"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.FIREPIT.GENERIC
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.FIREPIT.GENERIC"
msgid "Anyone want to hear a scary story?"
msgstr "Quelqu'un veut une histoire qui fait peur ?"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.FIREPIT.HIGH
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.FIREPIT.HIGH"
msgid "Woah! I don't think that's safe..."
msgstr "Ouah ! Je pense pas que ce soit très sûr..."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.FIREPIT.LOW
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.FIREPIT.LOW"
msgid "I might need to feed the fire a bit."
msgstr "Il faut que j'attise un peu le feu."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.FIREPIT.NORMAL
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.FIREPIT.NORMAL"
msgid "It's the perfect temperature for roasting marshmallows!"
msgstr "C'est la température idéale pour faire griller des marshmallows !"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.FIREPIT.OUT
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.FIREPIT.OUT"
msgid "The fire pit's already built, all we need is more wood!"
msgstr "Le feu est prêt, il n'y a plus qu'à y mettre du bois !"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.FIRESTAFF
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.FIRESTAFF"
msgid "I'd better keep this away from the younger kids... and Willow."
msgstr "Je ferais mieux de garder ça loin des enfants... et de Willow."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.FIRESUPPRESSOR.LOWFUEL
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.FIRESUPPRESSOR.LOWFUEL"
msgid "We'd better give it some more fuel."
msgstr "On ferait mieux de lui donner un peu plus de carburant."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.FIRESUPPRESSOR.OFF
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.FIRESUPPRESSOR.OFF"
msgid "It's conserving its energy."
msgstr "Il conserve son énergie."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.FIRESUPPRESSOR.ON
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.FIRESUPPRESSOR.ON"
msgid "That should keep us from setting the camp on fire... hopefully."
msgstr "Ça devrait éviter de mettre le feu au camp. Enfin j'espère."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.FISH
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.FISH"
msgid "I'm great at catching fish! I got a badge and everything!"
msgstr "Je suis super doué pour pêcher ! J'ai un badge, et tout !"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.FISHINGNET
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.FISHINGNET"
msgid "Hey Woby, want to go fishing?"
msgstr "Eh, Woby ? Tu veux aller pêcher ?"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.FISHINGROD
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.FISHINGROD"
msgid "It's a fishing rod, you use it for fishing."
msgstr "C'est une canne à pêche, ça permet de pêcher du poisson."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.FISHMEAT
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.FISHMEAT"
msgid "Is it okay to eat it raw?"
msgstr "C'est bon si je le mange cru ?"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.FISHMEAT_COOKED
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.FISHMEAT_COOKED"
msgid "Catching your own fish and eating it, real survivor stuff!"
msgstr "Pêcher son propre poisson pour le manger, ça c'est de la survie !"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.FISHMEAT_DRIED
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.FISHMEAT_DRIED"
msgid "That's some good fish jerky!"
msgstr "Ça, c'est du bon poisson séché !"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.FISHMEAT_SMALL
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.FISHMEAT_SMALL"
msgid "Maybe I could use it as bait for a bigger fish."
msgstr "Je pourrais peut-être l'utiliser comme appât pour de plus gros poissons."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.FISHMEAT_SMALL_COOKED
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.FISHMEAT_SMALL_COOKED"
msgid "It smells good!"
msgstr "Ça sent bon !"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.FISHMEAT_SMALL_DRIED
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.FISHMEAT_SMALL_DRIED"
msgid "A little jerky is better than none."
msgstr "Un peu de poisson, c'est mieux que rien."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.FISHSTICKS
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.FISHSTICKS"
msgid "Delicious, nutritious and full of fishes."
msgstr "Délicieux, nutritif et plein de poisson !"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.FISHTACOS
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.FISHTACOS"
msgid "The s'more of fish dishes!"
msgstr "C'est mon plat de poisson préféré !"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.FISH_BOX
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.FISH_BOX"
msgid "That'll keep our fish fresh!"
msgstr "Ça gardera nos poissons au frais !"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.FISH_COOKED
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.FISH_COOKED"
msgid "Catching and cooking your own fish is what camping is all about!"
msgstr "Le vrai camping, c'est pêcher et cuisiner son propre poisson !"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.FLINT
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.FLINT"
msgid "This should come in handy!"
msgstr "Ça devrait être utile !"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.FLOATINGLANTERN.DEFLATED
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.FLOATINGLANTERN.DEFLATED"
msgid "Aw, it was nice while it lasted."
msgstr "C'était bien, mais c'est fini."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.FLOATINGLANTERN.GENERIC
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.FLOATINGLANTERN.GENERIC"
msgid "Look up, Woby!"
msgstr "Regarde, Woby !"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.FLOATINGLANTERN.HELD
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.FLOATINGLANTERN.HELD"
msgid "Should we brighten the mood, Wobes?"
msgstr "Égayons l'atmosphère, Woby !"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.FLOTATIONCUSHION
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.FLOTATIONCUSHION"
msgid "We love water safety! Don't we, Wobes?"
msgstr "On aime la sécurité aquatique ! Pas vrai, Woby ?"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.FLOWER.GENERIC
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.FLOWER.GENERIC"
msgid "Are there any bugs on it?"
msgstr "Il y a des insectes, dessus ?"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.FLOWER.ROSE
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.FLOWER.ROSE"
msgid "Funny, this isn't the type of rose you usually see in the wild."
msgstr "C'est marrant, on voit pas ce genre de rose dans la nature, d'habitude."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.FLOWERHAT
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.FLOWERHAT"
msgid "Hey, that looks swell!"
msgstr "Hé, ça a l'air trop bien !"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.FLOWERSALAD
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.FLOWERSALAD"
msgid "Even scavenged leaves can be food in the wilderness!"
msgstr "Même les feuilles peuvent servir de nourriture, dans la nature !"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.FLOWER_CAVE
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.FLOWER_CAVE"
msgid "Pretty swell of those flowers to light the way for us!"
msgstr "C'est sympa de la part de ces fleurs de nous montrer le chemin !"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.FLOWER_CAVE_WITHERED
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.FLOWER_CAVE_WITHERED"
msgid "I wonder why it's dying."
msgstr "Je me demande pourquoi ça meurt."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.FLOWER_EVIL
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.FLOWER_EVIL"
msgid "Woby, what's wrong? It's just a flower."
msgstr "Qu'est-ce qu'il y a, Woby ? C'est juste une fleur."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.FLOWER_WITHERED
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.FLOWER_WITHERED"
msgid "Should I water it more? Or water it less?!"
msgstr "Est-ce qu'il faut que je l'arrose plus ? Ou moins ?"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.FOLIAGE
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.FOLIAGE"
msgid "This would be great for starting a campfire."
msgstr "Ce serait parfait pour allumer un feu."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.FOLIAGE_DRIED
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.FOLIAGE_DRIED"
msgid "Dried perfectly!"
msgstr "Séché à la perfection !"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.FOOTBALLHAT
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.FOOTBALLHAT"
msgid "Oh, football! Yeah I'm uh... great at football..."
msgstr "Oh, du football ! Euh, je... Je joue très bien au foot."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.FORGETMELOTS
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.FORGETMELOTS"
msgid "I keep forgetting to look them up in my handbook."
msgstr "Je sais jamais si c'est une bonne idée de les laisser pousser."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.FORGETMELOTS_DRIED
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.FORGETMELOTS_DRIED"
msgid "Dried perfectly!"
msgstr "Séché à la perfection !"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.FORMAL_BLUEPRINT
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.FORMAL_BLUEPRINT"
msgid "This doesn't seem very practical for the outdoors."
msgstr "Ça a pas l'air super pratique en extérieur."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.FOSSIL_PIECE
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.FOSSIL_PIECE"
msgid "The bones of an ancient creature!"
msgstr "Des os d'une créature ancienne !"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.FOSSIL_STALKER.COMPLETE
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.FOSSIL_STALKER.COMPLETE"
msgid "I think we figured it out Woby!"
msgstr "Je crois qu'on a trouvé, Woby !"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.FOSSIL_STALKER.FUNNY
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.FOSSIL_STALKER.FUNNY"
msgid "\"The arm bone's connected to the...\" which bone was it..."
msgstr "« L'os du bras est lié au... » Attends, c'est quel os ?"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.FOSSIL_STALKER.GENERIC
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.FOSSIL_STALKER.GENERIC"
msgid "It's still missing something."
msgstr "Il manque encore quelque chose..."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.FRESHFRUITCREPES
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.FRESHFRUITCREPES"
msgid "With fresh-picked wild fruits."
msgstr "Avec des fruits fraîchement cueillis !"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.FRIENDLYFRUITFLY
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.FRIENDLYFRUITFLY"
msgid "I'm going to call you Buzzy!"
msgstr "Je vais t'appeler... Bzz !"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.FROG.DEAD
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.FROG.DEAD"
msgid "Poor little guy."
msgstr "Pauvre petit bonhomme"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.FROG.GENERIC
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.FROG.GENERIC"
msgid "That doesn't look like the frogs in my handbook..."
msgstr "Ça ne ressemble pas aux grenouilles de mon manuel..."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.FROG.SLEEPING
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.FROG.SLEEPING"
msgid "Have sweet, fly-filled dreams."
msgstr "Rêve bien de plein de mouches."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.FROGFISHBOWL
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.FROGFISHBOWL"
msgid "Er... maybe Woby wants some."
msgstr "Euh... peut-être que Woby en veut ?"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.FROGGLEBUNWICH
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.FROGGLEBUNWICH"
msgid "You can make anything into a sandwich if you try hard enough."
msgstr "Tout peut finir en sandwich avec un peu de courage."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.FROGLEGS
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.FROGLEGS"
msgid "I don't think they're ripe yet, they're still green."
msgstr "Je suis pas sûr que ce soit mûr. Elles sont encore vertes."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.FROGLEGS_COOKED
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.FROGLEGS_COOKED"
msgid "It doesn't look as fancy as I imagined."
msgstr "C'est pas aussi chic que ce que j'avais imaginé."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.FROGNEWTON
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.FROGNEWTON"
msgid "Hey, that's pretty good! What's in it?"
msgstr "Hé, c'est pas mauvais ! C'est fait avec quoi ?"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.FROZENBANANADAIQUIRI
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.FROZENBANANADAIQUIRI"
msgid "Don't drink it too fast or you'll get a headache."
msgstr "Faut pas le boire trop vite, sinon ça fait mal à la tête."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.FRUITDRAGON.GENERIC
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.FRUITDRAGON.GENERIC"
msgid "It's a little lizard thing!"
msgstr "C'est un petit truc-lézard !"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.FRUITDRAGON.RIPE
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.FRUITDRAGON.RIPE"
msgid "I could've sworn it was green a second ago."
msgstr "J'aurais juré que c'était encore vert il y a deux secondes."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.FRUITDRAGON.SLEEPING
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.FRUITDRAGON.SLEEPING"
msgid "They're even cuter when they're sleeping."
msgstr "Il est encore plus mignon quand il dort."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.FRUITFLY
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.FRUITFLY"
msgid "They're just doing what bugs do! I wish they wouldn't do it to my plants though..."
msgstr "Ils font juste des trucs d'insectes. J'aurais préféré qu'ils fassent pas ça à mes plantes, mais bon..."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.FRUITFLYFRUIT
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.FRUITFLYFRUIT"
msgid "The Fruit Flies seem to like following it around."
msgstr "Les mouchafruits ont l'air ravies de le suivre."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.FRUITMEDLEY
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.FRUITMEDLEY"
msgid "It's good for you!"
msgstr "C'est bon pour la santé !"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.FUMAROLEAXE.GENERIC
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.FUMAROLEAXE.GENERIC"
msgid "Uh oh. Looks like it's about to break..."
msgstr "Oh oh. On dirait qu'elle va casser..."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.FUMAROLEAXE.HOT
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.FUMAROLEAXE.HOT"
msgid "Wow, I can feel the heat from here!"
msgstr "Ouah, je sens la chaleur d'ici !"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.FUMAROLEAXE.LUKEWARM
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.FUMAROLEAXE.LUKEWARM"
msgid "It's barely warm."
msgstr "Elle est légèrement chaude."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.FUMAROLEAXE.WARM
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.FUMAROLEAXE.WARM"
msgid "It'll keep me warm while I chop wood!"
msgstr "Elle me tiendra au chaud quand je couperai du bois !"

