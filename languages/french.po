msgstr "Tön art n'est pöint celui que je cönvöite."

#. STRINGS.CHARACTERS.WATHGRITHR.ACTIONFAIL.PICKUP.NOTMINE_YOTC.2
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.ACTIONFAIL.PICKUP.NOTMINE_YOTC.2"
