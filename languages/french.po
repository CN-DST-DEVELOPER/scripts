msgstr "Quelle impolitesse !"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.CAVE_VENT_ROCK.GAS
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.CAVE_VENT_ROCK.GAS"
