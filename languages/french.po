msgstr "Je ne veux pas le réveiller."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.MUTATOR_DROPPER
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.MUTATOR_DROPPER"
msgid "Eww, there's legs sticking out of it!"
msgstr "Baaaah, y a des pattes qui dépassent !"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.MUTATOR_HEALER
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.MUTATOR_HEALER"
msgid "Eww, there's legs sticking out of it!"
msgstr "Baaaah, y a des pattes qui dépassent !"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.MUTATOR_HIDER
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.MUTATOR_HIDER"
msgid "Give one to Wilson, I'm sure he'd loooove to try it! Heheh."
msgstr "Il faut en donner une à Wilson, je suis sûre qu'il va adorer. Hé hé hé."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.MUTATOR_MOON
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.MUTATOR_MOON"
msgid "Give one to Wilson, I'm sure he'd loooove to try it! Heheh."
msgstr "Il faut en donner une à Wilson, je suis sûre qu'il va adorer. Hé hé hé."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.MUTATOR_SPITTER
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.MUTATOR_SPITTER"
msgid "Eww, there's legs sticking out of it!"
msgstr "Baaaah, y a des pattes qui dépassent !"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.MUTATOR_WARRIOR
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.MUTATOR_WARRIOR"
msgid "Give one to Wilson, I'm sure he'd loooove to try it! Heheh."
msgstr "Il faut en donner une à Wilson, je suis sûre qu'il va adorer. Hé hé hé."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.MUTATOR_WATER
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.MUTATOR_WATER"
msgid "Give one to Wilson, I'm sure he'd loooove to try it! Heheh."
msgstr "Il faut en donner une à Wilson, je suis sûre qu'il va adorer. Hé hé hé."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.NATURE_BLUEPRINT
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.NATURE_BLUEPRINT"
msgid "Once the flowers dry out they'll make nice kindling."
msgstr "Une fois séchées, les fleurs feront un bon allume-feu."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.NIGHTCAPHAT
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.NIGHTCAPHAT"
msgid "I've got a nightcap, now where's my candlestick?"
msgstr "J'ai un bonnet de nuit... où est ma chandelle ?"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.NIGHTLIGHT
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.NIGHTLIGHT"
msgid "It's like fire, but purple!"
msgstr "C'est comme le feu, mais en pourpre !"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.NIGHTMAREFUEL
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.NIGHTMAREFUEL"
msgid "Eww, it's still warm!"
msgstr "Hou ! C'est encore chaud !"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.NIGHTMAREGROWTH
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.NIGHTMAREGROWTH"
msgid "That's probably not... great..."
msgstr "C'est... pas top."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.NIGHTMARELIGHT
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.NIGHTMARELIGHT"
msgid "Light without fire is unnatural."
msgstr "La lumière sans feu c'est pas normal."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.NIGHTMAREPIE
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.NIGHTMAREPIE"
msgid "I'm sure he wouldn't mind if I stole a nibble."
msgstr "Je suis sûr qu'il ne m'en voudra pas si j'en prends un morceau."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.NIGHTMARE_TIMEPIECE.CALM
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.NIGHTMARE_TIMEPIECE.CALM"
msgid "Looks normal to me."
msgstr "Ça m'a l'air normal."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.NIGHTMARE_TIMEPIECE.DAWN
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.NIGHTMARE_TIMEPIECE.DAWN"
msgid "I guess it's nearly over."
msgstr "Je crois que c'est presque fini."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.NIGHTMARE_TIMEPIECE.NOMAGIC
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.NIGHTMARE_TIMEPIECE.NOMAGIC"
msgid "I don't think it's working."
msgstr "Je crois que ça ne marche pas."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.NIGHTMARE_TIMEPIECE.STEADY
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.NIGHTMARE_TIMEPIECE.STEADY"
msgid "It's almost humming."
msgstr "Il vrombit presque."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.NIGHTMARE_TIMEPIECE.WANING
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.NIGHTMARE_TIMEPIECE.WANING"
msgid "I think it's turning off."
msgstr "Je crois qu'il s'éteint."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.NIGHTMARE_TIMEPIECE.WARN
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.NIGHTMARE_TIMEPIECE.WARN"
msgid "It's warning me."
msgstr "Il m'avertit."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.NIGHTMARE_TIMEPIECE.WAXING
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.NIGHTMARE_TIMEPIECE.WAXING"
msgid "The fuel is coming to life!"
msgstr "L'essence prend vie !"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.NIGHTSTICK
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.NIGHTSTICK"
msgid "It'd be way cooler if it was on fire..."
msgstr "Elle serait bien plus cool avec du feu..."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.NIGHTSWORD
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.NIGHTSWORD"
