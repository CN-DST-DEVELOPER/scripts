msgstr "On y est presque !"

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_MOONALTAR_MINE.GLASS_MED
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_MOONALTAR_MINE.GLASS_MED"
msgid "We'll get you out."
msgstr "On va te sortir de là."

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_MOONALTAR_MINE.GLASS_REVEAL
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_MOONALTAR_MINE.GLASS_REVEAL"
msgid "You're free!"
msgstr "Tu es libre !"

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_MOONALTAR_MINE.IDOL_LOW
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_MOONALTAR_MINE.IDOL_LOW"
msgid "Almost!"
msgstr "On y est presque !"

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_MOONALTAR_MINE.IDOL_MED
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_MOONALTAR_MINE.IDOL_MED"
msgid "We'll get you out."
msgstr "On va te sortir de là."

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_MOONALTAR_MINE.IDOL_REVEAL
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_MOONALTAR_MINE.IDOL_REVEAL"
msgid "You're free!"
msgstr "Tu es libre !"

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_MOONALTAR_MINE.SEED_LOW
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_MOONALTAR_MINE.SEED_LOW"
msgid "Almost!"
msgstr "On y est presque !"

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_MOONALTAR_MINE.SEED_MED
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_MOONALTAR_MINE.SEED_MED"
msgid "We'll get you out."
msgstr "On va te sortir de là."

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_MOONALTAR_MINE.SEED_REVEAL
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_MOONALTAR_MINE.SEED_REVEAL"
msgid "You're free!"
msgstr "Tu es libre !"

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_MOONPOTION_FAILED
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_MOONPOTION_FAILED"
msgid "Whoops!"
msgstr "Mince !"

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_MOSQUITOS
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_MOSQUITOS"
msgid "Suck someone else's blood!"
msgstr "Va sucer du sang ailleurs !"

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_MOUNT_LOWHEALTH
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_MOUNT_LOWHEALTH"
msgid "Our hairy friend is hurt!"
msgstr "Notre copain poilu est blessé !"

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_MUTATED_BUZZARD_ARRIVAL
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_MUTATED_BUZZARD_ARRIVAL"
msgid "Buzzards! Hey, they look strange."
msgstr "Des vautours ! Ils sont bizarres."

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_NODANGERGIFT
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_NODANGERGIFT"
msgid "We'll open it later as a celebration of surviving this!"
msgstr "On l'ouvrira plus tard, pour fêter notre survie à tout ça !"

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_NODANGERSIESTA
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_NODANGERSIESTA"
msgid "Can't nap with monsters nearby!"
msgstr "Impossible de faire la sieste avec des monstres à côté !"

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_NODANGERSLEEP
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_NODANGERSLEEP"
msgid "Can't sleep with monsters nearby!"
msgstr "Impossible de dormir avec des monstres à côté !"

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_NODAYSLEEP
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_NODAYSLEEP"
msgid "It's daytime, not bedtime."
msgstr "Il fait jour, c'est pas l'heure du lit."

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_NODAYSLEEP_CAVE
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_NODAYSLEEP_CAVE"
msgid "We're not ready for bed."
msgstr "On n'est pas prêts pour dormir."

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_NOHUNGERSIESTA
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_NOHUNGERSIESTA"
msgid "Won't be able to nap with a rumbling tummy."
msgstr "Je ne pourrai pas faire la sieste l'estomac vide."

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_NOHUNGERSLEEP
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_NOHUNGERSLEEP"
msgid "Our tummy is rumbling, we can't sleep."
msgstr "On a l'estomac dans les talons, on ne peut pas dormir."

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_NOMOUNTEDGIFT
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_NOMOUNTEDGIFT"
msgid "I promise I'll ride you again after I open my present!"
msgstr "Je te promets que je remonte dès que j'ai ouvert mon cadeau !"

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_NONIGHTSIESTA
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_NONIGHTSIESTA"
msgid "We can't take a nap, it's nighttime!"
msgstr "On ne peut pas faire la sieste, il fait nuit !"

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_NONIGHTSIESTA_CAVE
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_NONIGHTSIESTA_CAVE"
msgid "No naps til daybreak!"
msgstr "Pas de sieste avant la lumière du jour !"

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_NOPUMPKINCARVINGONFIRE
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_NOPUMPKINCARVINGONFIRE"
msgid "Haha! Again!"
msgstr "Ha, ha ! Encore !"

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_NOSLEEPHASPERMANENTLIGHT
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_NOSLEEPHASPERMANENTLIGHT"
msgid "We can't sleep with such a bright nightlight..."
msgstr "On peut pas dormir avec une lumière aussi forte."

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_NOSLEEPONFIRE
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_NOSLEEPONFIRE"
msgid "Mum always said \"Don't sleep in a burning building.\""
msgstr "Maman disait toujours : « Ne dors pas dans une maison qui brûle ! »"

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_NOWARDROBEONFIRE
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_NOWARDROBEONFIRE"
msgid "I can't! It's all burny!"
msgstr "Impossible ! C'est tout brûlé !"

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_NO_ABIGAIL_FLOWER
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_NO_ABIGAIL_FLOWER"
msgid "only_used_by_wendy"
msgstr "only_used_by_wendy"

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_NO_TRAP
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_NO_TRAP"
msgid "Easy peasy."
msgstr "Trop fastoche."

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_OCEANFISHING_BADCAST
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_OCEANFISHING_BADCAST"
msgid "Whoops! Let's try that again."
msgstr "Oups ! On va réessayer."

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_OCEANFISHING_GOTAWAY
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_OCEANFISHING_GOTAWAY"
msgid "Aww, it got away..."
msgstr "Oooh, il est parti."

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_OCEANFISHING_IDLE_QUOTE.1
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_OCEANFISHING_IDLE_QUOTE.1"
msgid "Was that a nibble? Nope."
msgstr "Ça mord ? Ah non."

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_OCEANFISHING_IDLE_QUOTE.2
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_OCEANFISHING_IDLE_QUOTE.2"
msgid "Come on out, fishies!"
msgstr "Allez, venez, les poissons !"

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_OCEANFISHING_IDLE_QUOTE.3
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_OCEANFISHING_IDLE_QUOTE.3"
msgid "This is getting kinda boring..."
msgstr "Ça devient nul..."

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_OCEANFISHING_IDLE_QUOTE.4
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_OCEANFISHING_IDLE_QUOTE.4"
msgid "I thought fishing would be a bit more exciting."
msgstr "Je pensais que la pêche, c'était plus fun."

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_OCEANFISHING_LINESNAP
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_OCEANFISHING_LINESNAP"
msgid "Ah! Aww, our line snapped..."
msgstr "Ah ! Oooh, la ligne a cassé."

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_OCEANFISHING_LINETOOLOOSE
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_OCEANFISHING_LINETOOLOOSE"
msgid "Should we reel it in a bit?"
msgstr "On devrait p'têt le remonter un peu ?"

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_OCEAN_SILHOUETTE_INCOMING
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_OCEAN_SILHOUETTE_INCOMING"
msgid "Don't eat us!"
msgstr "Nous mangez pas !"

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_OFF_SCRIPT
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_OFF_SCRIPT"
msgid "Is that how the play is supposed to go?"
msgstr "C'est comme ça que c'est censé se passer ?"

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_OTTERBOAT_DENBROKEN
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_OTTERBOAT_DENBROKEN"
msgid "We really shouldn't have broken that den!"
msgstr "On n'aurait pas dû casser ce nid !"

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_OTTERBOAT_OUTOFSHALLOWS
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_OTTERBOAT_OUTOFSHALLOWS"
msgid "Uh-oh... maybe we shouldn't have rowed out so far."
msgstr "Oh oh... on n'aurait pas dû ramer aussi loin."

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_PECKED
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_PECKED"
msgid "Bad bird!"
msgstr "Sale volatile !"

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_PETRIFED_TREES
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_PETRIFED_TREES"
msgid "The trees are yelling at us!!"
msgstr "Les arbres nous hurlent dessus !"

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_PICK_DISEASE_WARNING
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_PICK_DISEASE_WARNING"
msgid "Yuck!"
msgstr "Beurk !"

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_PIRATES_ARRIVE
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_PIRATES_ARRIVE"
msgid "Uh oh... we're not sure we like the sound of that."
msgstr "Oh oh... On aime pas trop ce bruit."

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_PLANT_RANDOMSEED
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_PLANT_RANDOMSEED"
msgid "We can't wait to see what it is!"
msgstr "On a hâte de voir ce que c'est !"

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_PLANT_RESEARCHED.1
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_PLANT_RESEARCHED.1"
msgid "We're learning so much about this plant!"
msgstr "On apprend plein de trucs sur cette plante !"

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_POCKETWATCH_PORTAL
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_POCKETWATCH_PORTAL"
msgid "Wheeeeee--OOF!"
msgstr "YouhouuuuuuOUTCH !"

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_PREFALLINVOID
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_PREFALLINVOID"
msgid "Let's get out of here!"
msgstr "Partons d'ici !"

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_QUAKE
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_QUAKE"
msgid "I don't think that was our tummy."
msgstr "Je ne crois pas que c'était notre ventre."

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_RABBITKINGHORN_BADSPAWNPOINT
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_RABBITKINGHORN_BADSPAWNPOINT"
msgid "Aw, wrong spot!"
msgstr "Oh, c'est pas le bon endroit !"

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_RABBITKING_AGGRESSIVE
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_RABBITKING_AGGRESSIVE"
msgid "We hear something coming! And it sounds grouchy!"
msgstr "On entend un truc qui vient ! Ça a l'air ronchon !"

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_RABBITKING_LUCKY
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_RABBITKING_LUCKY"
msgid "We see a weird rabbit!"
msgstr "On voit un lapin bizarre !"

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_RABBITKING_LUCKYCAUGHT
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_RABBITKING_LUCKYCAUGHT"
msgid "We caught it!"
msgstr "On l'a attrapé !"

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_RABBITKING_PASSIVE
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_RABBITKING_PASSIVE"
msgid "Something's burrowing around us!"
msgstr "Quelque chose creuse autour de nous !"

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_REPELLED
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_REPELLED"
msgid "We can't hit it."
msgstr "On peut pas l'atteindre."

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_RESEARCH
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_RESEARCH"
msgid "It's almost like being back in school."
msgstr "C'est presque comme revenir à l'école."

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_REVIVED_FROM_CORPSE
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_REVIVED_FROM_CORPSE"
msgid "All better!"
msgstr "Ça va bien mieux !"

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_REVIVED_OTHER_CORPSE
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_REVIVED_OTHER_CORPSE"
msgid "There you go!"
msgstr "Et voilà !"

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_REVIVING_CORPSE
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_REVIVING_CORPSE"
msgid "Hold on, we'll help!"
msgstr "Attends, on va t'aider !"

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_ROYALTY.1
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_ROYALTY.1"
msgid "Our Liege!"
msgstr "Notre Seigneur !"

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_ROYALTY.2
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_ROYALTY.2"
msgid "Nice crown!"
msgstr "Jolie couronne !"

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_ROYALTY.3
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_ROYALTY.3"
msgid "Your wish is our command!"
msgstr "À vos ordres !"

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_ROYALTY_JOKER.1
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_ROYALTY_JOKER.1"
msgid "Our \"Liege\"!"
msgstr "Notre « Seigneur » !"

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_ROYALTY_JOKER.2
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_ROYALTY_JOKER.2"
msgid "Nice \"crown\"!"
msgstr "Jolie « couronne » !"

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_ROYALTY_JOKER.3
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_ROYALTY_JOKER.3"
msgid "Tell us a joke!"
msgstr "Raconte-nous une blague !"

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_RUINS_RESET
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_RUINS_RESET"
msgid "Everything's back!"
msgstr "Tout est revenu !"

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_SACREDCHEST_NO
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_SACREDCHEST_NO"
msgid "But those were presents!"
msgstr "Mais c'était des cadeaux !"

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_SACREDCHEST_YES
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_SACREDCHEST_YES"
msgid "It likes us!"
msgstr "Il nous aime bien !"

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_SCRAPBOOK_FULL
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_SCRAPBOOK_FULL"
msgid "We already filled up our scrapbook."
msgstr "On a déjà rempli notre album."

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_SECURITY_PULSE_FOLLOWING
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_SECURITY_PULSE_FOLLOWING"
msgid "Hey! It's following us!"
msgstr "Hé ! Il nous suit !"

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_SHADOWTHRALL_STEALTH
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_SHADOWTHRALL_STEALTH"
msgid "Ouch! No fair! We can't see you!"
msgstr "Aïe ! C'est pas juste ! On te voit pas !"

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_SHADOW_RIFT_MAX
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_SHADOW_RIFT_MAX"
msgid "What was that creepy light?"
msgstr "C'était quoi cette lumière qui fait peur ?"

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_SHELTER
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_SHELTER"
msgid "Protect us, tree!"
msgstr "Arbre, protège-nous !"

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_SISTURN_FULL_BLOSSOM
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_SISTURN_FULL_BLOSSOM"
msgid "only_used_by_wendy"
msgstr "only_used_by_wendy"

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_SISTURN_FULL_EVIL
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_SISTURN_FULL_EVIL"
msgid "only_used_by_wendy"
msgstr "only_used_by_wendy"

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_SNARED
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_SNARED"
msgid "Hey! Meanie!"
msgstr "Hé ! Méchant !"

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_SNARED_IVY
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_SNARED_IVY"
msgid "Hey! Let go!"
msgstr "Hé ! Lâche-nous !"

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_SNOWBALL_NO_SNOW
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_SNOWBALL_NO_SNOW"
msgid "Where's more snow?"
msgstr "Il y a pas de neige ?"

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_SNOWBALL_TOO_BIG
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_SNOWBALL_TOO_BIG"
msgid "We can't roll it any bigger!"
msgstr "On peut pas faire plus gros !"

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_SOAKED
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_SOAKED"
msgid "We're drenched!"
msgstr "On est trempés !"

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_SPOOKED
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_SPOOKED"
msgid "Hey, that's not nice!"
msgstr "Hé, c'est pas gentil !"

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_TALK_TO_PLANTS.1
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_TALK_TO_PLANTS.1"
msgid "Hi plants! How do you do today?"
msgstr "Coucou les plantes ! Ça va bien ?"

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_TALK_TO_PLANTS.2
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_TALK_TO_PLANTS.2"
msgid "Aww, are you lonely? We'll keep you company!"
msgstr "Oooh, tu te sens seule ? On va te tenir compagnie !"

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_TALK_TO_PLANTS.3
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_TALK_TO_PLANTS.3"
msgid "One day you're going to grow up big and strong... and then we'll eat you!"
msgstr "Un jour, tu seras grande et forte... et on te mangera !"

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_TALK_TO_PLANTS.4
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_TALK_TO_PLANTS.4"
msgid "You are a very good plant."
msgstr "Tu es une très gentille plante."

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_TALK_TO_PLANTS.5
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_TALK_TO_PLANTS.5"
msgid "We're always here when you need somebody to talk to!"
msgstr "Tu sais où nous trouver, si tu as envie de parler !"

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_THORNS
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_THORNS"
msgid "Yowch!"
msgstr "Ouille !"

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_THURIBLE_OUT
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_THURIBLE_OUT"
msgid "Aw, there goes our lure."
msgstr "Ah, c'est notre leurre."

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_TICOON_ABANDONED
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_TICOON_ABANDONED"
msgid "We felt like using him was a bit like cheating anyway."
msgstr "On avait un peu l'impression de tricher, grâce à lui."

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_TICOON_DEAD
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_TICOON_DEAD"
msgid "Oh no... where are we supposed to go now?"
msgstr "Oh non... Où on doit aller, maintenant ?"

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_TICOON_GET_LEADER_ATTENTION
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_TICOON_GET_LEADER_ATTENTION"
msgid "They want to get back to finding the kitcoons."
msgstr "Il veut retourner chercher les fatons laveurs."

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_TICOON_LOST_KITCOON
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_TICOON_LOST_KITCOON"
msgid "Either someone else found them, or this one is a lot tinier."
msgstr "Soit quelqu'un d'autre l'a trouvé, soit celui-là est vraiment tout petit."

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_TICOON_NEAR_KITCOON
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_TICOON_NEAR_KITCOON"
msgid "We must be getting close!"
msgstr "On se rapproche !"

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_TICOON_NOTHING_TO_TRACK
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_TICOON_NOTHING_TO_TRACK"
msgid "Doesn't look like he found any clues here."
msgstr "Il a trouvé aucun indice par ici, on dirait."

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_TICOON_START_TRACKING
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_TICOON_START_TRACKING"
msgid "Wow! He's leading us right to the kitcoons! ...Is that cheating?"
msgstr "Ouah ! Il nous mène droit vers les fatons laveurs ! C'est... triché, non ?"

