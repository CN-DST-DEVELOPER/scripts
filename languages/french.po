msgstr "Ha, ha !"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.SCULPTINGTABLE.EMPTY
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.SCULPTINGTABLE.EMPTY"
