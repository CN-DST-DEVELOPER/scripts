msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.CARNIVALGAME_FEEDCHICKS_NEST"
msgid "It's a little bird door."
msgstr "Il y a même une petite porte pour les oiseaux."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.CARNIVALGAME_FEEDCHICKS_STATION.GENERIC
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.CARNIVALGAME_FEEDCHICKS_STATION.GENERIC"
