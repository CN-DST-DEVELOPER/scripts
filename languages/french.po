msgstr "Ils ont oublié de mettre le bas ?"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.CARPENTRY_BLADE_MOONGLASS
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.CARPENTRY_BLADE_MOONGLASS"
