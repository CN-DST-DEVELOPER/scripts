msgstr "Ça vaut quelque chose."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.QUAGMIRE_COIN4
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.QUAGMIRE_COIN4"
