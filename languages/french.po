msgstr "Il se passe manifestement quelque chose de dangereux."

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.ATRIUM_GATE.OFF
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.ATRIUM_GATE.OFF"
msgid "All the pieces are back in place."
msgstr "Toutes les pièces ont retrouvé leur place."

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.ATRIUM_GATE.ON
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.ATRIUM_GATE.ON"
msgid "It's ready."
msgstr "C'est prêt."

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.ATRIUM_KEY
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.ATRIUM_KEY"
msgid "This seems very precious."
msgstr "Ça semble très précieux."

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.ATRIUM_LIGHT.OFF
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.ATRIUM_LIGHT.OFF"
msgid "Off, for now."
msgstr "C'est éteint. Pour l'instant."

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.ATRIUM_LIGHT.ON
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.ATRIUM_LIGHT.ON"
msgid "There's a strange force behind this."
msgstr "Une force étrange agit derrière tout cela."

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.ATRIUM_OVERGROWTH
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.ATRIUM_OVERGROWTH"
msgid "Is this a language of some sort?"
msgstr "Est-ce un genre de langage ?"

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.ATRIUM_RUBBLE.LINE_1
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.ATRIUM_RUBBLE.LINE_1"
