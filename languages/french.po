msgstr "Elle s'appelle « Flambadou » et elle est adorable."

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.CRITTER_EETS
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.CRITTER_EETS"
