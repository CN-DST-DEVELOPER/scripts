#. STRINGS.CHARACTERS.WARLY.DESCRIBE.WINONA_TELEPORT_PAD_ITEM.OFF
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.WINONA_TELEPORT_PAD_ITEM.OFF"
