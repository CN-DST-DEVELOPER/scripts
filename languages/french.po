msgstr "Alors ça, ça va me servir !"

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.ICESTAFF
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.ICESTAFF"
msgid "It flash freezes poulet!"
msgstr "Ça congèle le poulet en un éclair !"

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.ICESTAFF2
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.ICESTAFF2"
msgid "Prepare for a frosting!"
msgstr "C'est l'heure de la congélation !"

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.ICESTAFF3
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.ICESTAFF3"
msgid "A portable freezer!"
msgstr "Un congélateur portable !"

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.ICE_BLUEPRINT
