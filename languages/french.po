msgstr "only_used_by_wx78"

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.WX78_MODULEREMOVER
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.WX78_MODULEREMOVER"
msgid "Ah, I believe this utensil belongs to our metal friend."
msgstr "Ha, je crois que cet ustensile appartient à notre ami de métal."

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.WX78_POSSESSEDBODY
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.WX78_POSSESSEDBODY"
