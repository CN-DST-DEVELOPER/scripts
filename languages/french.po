msgid "\"Whaddya say we get the gang together for some carols?\""
msgstr "« Si on chantait des chants de Noël ? »"

#. STRINGS.SKIN_QUOTES.wolfgang_ancient
msgctxt "STRINGS.SKIN_QUOTES.wolfgang_ancient"
msgid "\"Wolfgang is learning much about history.\""
msgstr "« Wolfgang apprend beaucoup sur l'histoire. »"

#. STRINGS.SKIN_QUOTES.wolfgang_combatant
msgctxt "STRINGS.SKIN_QUOTES.wolfgang_combatant"
msgid "\"Mighty Wolfgang cannot wait to step into ring!\""
msgstr "« Le puissant Wolfgang est pressé d'entrer sur le ring ! »"

#. STRINGS.SKIN_QUOTES.wolfgang_cook
msgctxt "STRINGS.SKIN_QUOTES.wolfgang_cook"
msgid "\"Wolfgang will cook for you!\""
msgstr "« Wolfgang va cuisiner pour vous ! »"

#. STRINGS.SKIN_QUOTES.wolfgang_formal
msgctxt "STRINGS.SKIN_QUOTES.wolfgang_formal"
msgid "\"I used my special moustache wax.\""
msgstr "« J'ai utilisé ma graisse à moustache spéciale. »"

#. STRINGS.SKIN_QUOTES.wolfgang_formalp
msgctxt "STRINGS.SKIN_QUOTES.wolfgang_formalp"
msgid "\"I used my special moustache wax.\""
msgstr "« J'ai utilisé ma graisse à moustache spéciale. »"

#. STRINGS.SKIN_QUOTES.wolfgang_gladiator
msgctxt "STRINGS.SKIN_QUOTES.wolfgang_gladiator"
msgid "\"You will kneel before might of Wolfgang!\""
msgstr "« Vous allez plier devant la puissance de Wolfgang ! »"

#. STRINGS.SKIN_QUOTES.wolfgang_hazard
msgctxt "STRINGS.SKIN_QUOTES.wolfgang_hazard"
msgid "\"Hrrm... mff! Mmmf!\""
msgstr "« Hurrm... mff ! Mmmf ! »"

#. STRINGS.SKIN_QUOTES.wolfgang_ice
msgctxt "STRINGS.SKIN_QUOTES.wolfgang_ice"
msgid "\"Cold does not bother Wolfgang!\""
msgstr "« Le froid ne gêne pas Wolfgang ! »"

#. STRINGS.SKIN_QUOTES.wolfgang_lunar
msgctxt "STRINGS.SKIN_QUOTES.wolfgang_lunar"
msgid "\"Wolfgang will carry moon to victory!\""
msgstr "« Wolfgang va mener la lune à la victoire ! »"

#. STRINGS.SKIN_QUOTES.wolfgang_magma
msgctxt "STRINGS.SKIN_QUOTES.wolfgang_magma"
msgid "\"Wolfgang is on the fire.\""
msgstr "« Wolfgang est sur le feu. »"

#. STRINGS.SKIN_QUOTES.wolfgang_nature
msgctxt "STRINGS.SKIN_QUOTES.wolfgang_nature"
msgid "\"The hills will ring with Wolfgang's mighty yodels!\""
msgstr "« Le puissant yodel à Wolfgang résonnera dans les collines ! »"

#. STRINGS.SKIN_QUOTES.wolfgang_pirate
msgctxt "STRINGS.SKIN_QUOTES.wolfgang_pirate"
msgid "\"Wolfgang is mightiest pirate on the sea!\""
msgstr "« Wolfgang est le plus puissant pirate de l'océan ! »"

#. STRINGS.SKIN_QUOTES.wolfgang_rose
msgctxt "STRINGS.SKIN_QUOTES.wolfgang_rose"
msgid "\"Dainty rose make Wolfgang strong, cultured man.\""
msgstr "« La rose délicate fait de Wolfgang un homme fort et cultivé. »"

#. STRINGS.SKIN_QUOTES.wolfgang_rosep
msgctxt "STRINGS.SKIN_QUOTES.wolfgang_rosep"
msgid "\"Dainty rose make Wolfgang strong, cultured man.\""
msgstr "« La rose délicate fait de Wolfgang un homme fort et cultivé. »"

#. STRINGS.SKIN_QUOTES.wolfgang_shadow
msgctxt "STRINGS.SKIN_QUOTES.wolfgang_shadow"
msgid "\"Do not challenge the Mighty Wolfgang!\""
msgstr "« Ne viens pas défier le puissant Wolfgang ! »"

#. STRINGS.SKIN_QUOTES.wolfgang_shadowp
msgctxt "STRINGS.SKIN_QUOTES.wolfgang_shadowp"
msgid "\"Do not challenge the Mighty Wolfgang!\""
msgstr "« Ne viens pas défier le puissant Wolfgang ! »"

#. STRINGS.SKIN_QUOTES.wolfgang_strongman
msgctxt "STRINGS.SKIN_QUOTES.wolfgang_strongman"
msgid "\"Wolfgang is strongest there ever was!\""
msgstr "« Wolfgang est plus fort que jamais ! »"

#. STRINGS.SKIN_QUOTES.wolfgang_survivor
msgctxt "STRINGS.SKIN_QUOTES.wolfgang_survivor"
msgid "\"Wolfgang is tough. Lots of muscle.\""
msgstr "« Wolfgang est costaud. Plein de muscles. »"

#. STRINGS.SKIN_QUOTES.wolfgang_survivorp
msgctxt "STRINGS.SKIN_QUOTES.wolfgang_survivorp"
msgid "\"Wolfgang is tough. Lots of muscle.\""
msgstr "« Wolfgang est costaud. Plein de muscles. »"

#. STRINGS.SKIN_QUOTES.wolfgang_victorian
msgctxt "STRINGS.SKIN_QUOTES.wolfgang_victorian"
msgid "\"Sir Wolfgang is strongest boxer!\""
msgstr "« Sir Wolfgang est le plus fort des boxeurs ! »"

#. STRINGS.SKIN_QUOTES.wolfgang_walrus
msgctxt "STRINGS.SKIN_QUOTES.wolfgang_walrus"
msgid "\"Wolfgang is large moustache man! Ha ha!\""
msgstr "« Wolfgang a une grosse moustache ! Ah, ah ! »"

#. STRINGS.SKIN_QUOTES.wolfgang_walrus_d
msgctxt "STRINGS.SKIN_QUOTES.wolfgang_walrus_d"
msgid "\"Wolfgang is large moustache man! Ha ha!\""
msgstr "« Wolfgang a une grosse moustache ! Ah, ah ! »"

#. STRINGS.SKIN_QUOTES.wolfgang_walrus_p
msgctxt "STRINGS.SKIN_QUOTES.wolfgang_walrus_p"
msgid "\"Wolfgang is large moustache man! Ha ha!\""
msgstr "« Wolfgang a une grosse moustache ! Ah, ah ! »"

#. STRINGS.SKIN_QUOTES.wolfgang_western
msgctxt "STRINGS.SKIN_QUOTES.wolfgang_western"
msgid "\"Wolfgang is mighty man of the land!\""
msgstr "« Wolfgang est un puissant homme des plaines ! »"

#. STRINGS.SKIN_QUOTES.wolfgang_wolfman
msgctxt "STRINGS.SKIN_QUOTES.wolfgang_wolfman"
msgid "\"Something is different... Wolfgang's head feels fuzzy...\""
msgstr "« Wolfgang se sent bizarre... La tête à Wolfgang tourne... »"

#. STRINGS.SKIN_QUOTES.wolfgang_wrestler
msgctxt "STRINGS.SKIN_QUOTES.wolfgang_wrestler"
msgid "\"Mightiest Wolfgang is no heel!\""
msgstr "« Le puissant Wolfgang n'est pas en toc ! »"

#. STRINGS.SKIN_QUOTES.wolfgang_yule
msgctxt "STRINGS.SKIN_QUOTES.wolfgang_yule"
msgid "\"Winter Feast is Wolfgang favorite time of year.\""
msgstr "« Wolfgang adore le Festin d'hiver. »"

#. STRINGS.SKIN_QUOTES.woodie_ancient
msgctxt "STRINGS.SKIN_QUOTES.woodie_ancient"
msgid "\"These old threads I dug up aren't half bad, eh?\""
msgstr "« Les vieilles fringues que j'ai déterrées sont pas pires, hein ? »"

#. STRINGS.SKIN_QUOTES.woodie_combatant
msgctxt "STRINGS.SKIN_QUOTES.woodie_combatant"
msgid "\"I've been in scraps before, eh?\""
msgstr "« C'est pas ma première castagne, hein ? »"

#. STRINGS.SKIN_QUOTES.woodie_cook
msgctxt "STRINGS.SKIN_QUOTES.woodie_cook"
msgid "\"Lucy is my sous chef.\""
msgstr "« Lucy est ma sous-cheffe. »"

#. STRINGS.SKIN_QUOTES.woodie_formal
msgctxt "STRINGS.SKIN_QUOTES.woodie_formal"
msgid "\"I clean up pretty good, eh?\""
msgstr "« Je nettoie plutôt bien, hein ? »"

#. STRINGS.SKIN_QUOTES.woodie_formalp
msgctxt "STRINGS.SKIN_QUOTES.woodie_formalp"
msgid "\"I clean up pretty good, eh?\""
msgstr "« Je nettoie plutôt bien, hein ? »"

#. STRINGS.SKIN_QUOTES.woodie_gladiator
msgctxt "STRINGS.SKIN_QUOTES.woodie_gladiator"
msgid "\"Don't start a tussle you can't finish.\""
msgstr "« Quand on commence à se battre, faut aller jusqu'au bout. »"

#. STRINGS.SKIN_QUOTES.woodie_hazard
msgctxt "STRINGS.SKIN_QUOTES.woodie_hazard"
msgid "\"Hrrm... mff! Mmmf!\""
msgstr "« Hurrm... mff ! Mmmf ! »"

#. STRINGS.SKIN_QUOTES.woodie_hippie
msgctxt "STRINGS.SKIN_QUOTES.woodie_hippie"
msgid "\"Well, at least Lucy thinks it's scary!\""
msgstr "« Au moins, Lucy trouve ça effrayant ! »"

#. STRINGS.SKIN_QUOTES.woodie_hockey
msgctxt "STRINGS.SKIN_QUOTES.woodie_hockey"
msgid "\"It's the best game you can name!\""
msgstr "« C'est la meilleure des parties ! »"

#. STRINGS.SKIN_QUOTES.woodie_ice
msgctxt "STRINGS.SKIN_QUOTES.woodie_ice"
msgid "\"Snowy peaks are a Canadian's natural habitat.\""
msgstr "« Les pics enneigés sont ma deuxième maison. »"

#. STRINGS.SKIN_QUOTES.woodie_lunar
msgctxt "STRINGS.SKIN_QUOTES.woodie_lunar"
msgid "Arrrooooooooo... eh?"
msgstr "Baouuun... euh ?"

#. STRINGS.SKIN_QUOTES.woodie_magma
msgctxt "STRINGS.SKIN_QUOTES.woodie_magma"
msgid "\"Hope I don't burn the trees.\""
msgstr "« Pourvu que je ne brûle pas les arbres. »"

#. STRINGS.SKIN_QUOTES.woodie_masquerade
msgctxt "STRINGS.SKIN_QUOTES.woodie_masquerade"
msgid "\"If Lucy's the belle of the ball, I guess that makes me the beast.\""
msgstr "« Si Lucy est la belle, alors ça fait de moi la bête. »"

#. STRINGS.SKIN_QUOTES.woodie_nature
msgctxt "STRINGS.SKIN_QUOTES.woodie_nature"
msgid "\"Even the most majestic tree's gotta start as a seed.\""
msgstr "« Le plus majestueux des arbres commence aussi par une graine. »"

#. STRINGS.SKIN_QUOTES.woodie_pirate
msgctxt "STRINGS.SKIN_QUOTES.woodie_pirate"
msgid "\"It takes a lot of lumber to keep a boat ship-shape, eh?\""
msgstr "« Il faut un paquet de bois pour garder un bateau en bon état. »"

#. STRINGS.SKIN_QUOTES.woodie_rose
msgctxt "STRINGS.SKIN_QUOTES.woodie_rose"
msgid "\"I grow, untamed and untended.\""
msgstr "« Je grandis, indompté et sans entretien. »"

#. STRINGS.SKIN_QUOTES.woodie_rosep
msgctxt "STRINGS.SKIN_QUOTES.woodie_rosep"
msgid "\"I grow, untamed and untended.\""
msgstr "« Je grandis, indompté et sans entretien. »"

#. STRINGS.SKIN_QUOTES.woodie_shadow
msgctxt "STRINGS.SKIN_QUOTES.woodie_shadow"
msgid "\"Forests are full of shadows, eh?\""
msgstr "« Les forêts sont pleines d'ombres, hein ? »"

#. STRINGS.SKIN_QUOTES.woodie_shadowp
msgctxt "STRINGS.SKIN_QUOTES.woodie_shadowp"
msgid "\"Forests are full of shadows, eh?\""
msgstr "« Les forêts sont pleines d'ombres, hein ? »"

#. STRINGS.SKIN_QUOTES.woodie_survivor
msgctxt "STRINGS.SKIN_QUOTES.woodie_survivor"
msgid "\"I could do with a haircut and a cup of tea, eh?\""
msgstr "« Je dirais pas non à une coupe de cheveux et une tasse de thé, hein ? »"

#. STRINGS.SKIN_QUOTES.woodie_survivorp
msgctxt "STRINGS.SKIN_QUOTES.woodie_survivorp"
msgid "\"I could do with a haircut and a cup of tea, eh?\""
msgstr "« Je dirais pas non à une coupe de cheveux et une tasse de thé, hein ? »"

#. STRINGS.SKIN_QUOTES.woodie_treeguard
msgctxt "STRINGS.SKIN_QUOTES.woodie_treeguard"
msgid "\"To chop the tree, you must be the tree.\""
msgstr "« Pour couper l'arbre, il faut être l'arbre. »"

#. STRINGS.SKIN_QUOTES.woodie_treeguard_d
msgctxt "STRINGS.SKIN_QUOTES.woodie_treeguard_d"
msgid "\"To chop the tree, you must be the tree.\""
msgstr "« Pour couper l'arbre, il faut être l'arbre. »"

#. STRINGS.SKIN_QUOTES.woodie_treeguard_p
msgctxt "STRINGS.SKIN_QUOTES.woodie_treeguard_p"
msgid "\"To chop the tree, you must be the tree.\""
msgstr "« Pour couper l'arbre, il faut être l'arbre. »"

#. STRINGS.SKIN_QUOTES.woodie_victorian
msgctxt "STRINGS.SKIN_QUOTES.woodie_victorian"
msgid "\"They ain't beaver pelts, I'll tell ya that much.\""
msgstr "« C'est pas des peaux de castors, je peux vous le dire ! »"

#. STRINGS.SKIN_QUOTES.woodie_yule
msgctxt "STRINGS.SKIN_QUOTES.woodie_yule"
msgid "\"Quiet your voice here. The trees slumber.\""
msgstr "« Baisse d'un ton, les arbres se reposent. »"

#. STRINGS.SKIN_QUOTES.wormwood_ancient
msgctxt "STRINGS.SKIN_QUOTES.wormwood_ancient"
msgid "\"New grown from old\""
msgstr "« Du neuf cultivé avec du vieux. »"

#. STRINGS.SKIN_QUOTES.wormwood_cactus
msgctxt "STRINGS.SKIN_QUOTES.wormwood_cactus"
msgid "\"Hug?\""
msgstr "« Câlin ? »"

#. STRINGS.SKIN_QUOTES.wormwood_formal
msgctxt "STRINGS.SKIN_QUOTES.wormwood_formal"
msgid "\"Much, much handsome\""
msgstr "« Beaucoup, beaucoup beau »"

#. STRINGS.SKIN_QUOTES.wormwood_hazard
msgctxt "STRINGS.SKIN_QUOTES.wormwood_hazard"
msgid "\"Hrrm... mff! Mmmf!\""
msgstr "« Hurrm... mff ! Mmmf ! »"

#. STRINGS.SKIN_QUOTES.wormwood_ice
msgctxt "STRINGS.SKIN_QUOTES.wormwood_ice"
msgid "\"Ch-chilly...\""
msgstr "« Brrrr ! »"

#. STRINGS.SKIN_QUOTES.wormwood_lunar
msgctxt "STRINGS.SKIN_QUOTES.wormwood_lunar"
msgid "\"Ahhh. Home\""
msgstr "« Aaah. Chez moi. »"

#. STRINGS.SKIN_QUOTES.wormwood_mushroom
msgctxt "STRINGS.SKIN_QUOTES.wormwood_mushroom"
msgid "\"Cave lonely\""
msgstr "« Une grotte pour les solitaires. »"

#. STRINGS.SKIN_QUOTES.wormwood_nature
msgctxt "STRINGS.SKIN_QUOTES.wormwood_nature"
msgid "\"Into woods, follow!\""
msgstr "« Vite, allons dans les bois ! »"

#. STRINGS.SKIN_QUOTES.wormwood_pumpkin
msgctxt "STRINGS.SKIN_QUOTES.wormwood_pumpkin"
