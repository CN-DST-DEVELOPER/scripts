msgstr "En voilà un très inflammable."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.CARNIVAL_PRIZETICKET.GENERIC_SMALLSTACK
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.CARNIVAL_PRIZETICKET.GENERIC_SMALLSTACK"
