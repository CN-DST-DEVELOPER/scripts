msgstr "Je ne pense pas qu'il puisse porter ça."

#. STRINGS.CHARACTERS.GENERIC.ACTIONFAIL.ACTIVATE.NOCARNIVAL
msgctxt "STRINGS.CHARACTERS.GENERIC.ACTIONFAIL.ACTIVATE.NOCARNIVAL"
msgid "It looks like those birds flew the coop."
msgstr "On dirait que ces oiseaux se sont carapatés à tire d'aile."

