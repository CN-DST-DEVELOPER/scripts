#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.CARNIVAL_HOST
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.CARNIVAL_HOST"
msgid "I like him."
msgstr "Je l'aime bien, lui."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.CARNIVAL_PLAZA.GENERIC
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.CARNIVAL_PLAZA.GENERIC"
