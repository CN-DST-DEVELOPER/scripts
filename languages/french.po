msgstr "Ça fait un bruit atroce."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.YOTC_CARRAT_SCALE.BURNT
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.YOTC_CARRAT_SCALE.BURNT"
