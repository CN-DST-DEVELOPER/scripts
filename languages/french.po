msgstr "Bien mieux comme ça."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.SPIDERCORPSE.GENERIC
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.SPIDERCORPSE.GENERIC"
