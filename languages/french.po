msgid "Strong brainlady Wickerbottom maybe need for repair cardigans."
msgstr "La Wickerbottom au cerveau puissant en aura peut-être besoin pour réparer des cardigans."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.TROPHYSCALE_FISH.BURNING
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.TROPHYSCALE_FISH.BURNING"
msgid "Little scale is burning!"
msgstr "La balance riquiqui est en train de cramer !"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.TROPHYSCALE_FISH.BURNT
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.TROPHYSCALE_FISH.BURNT"
msgid "Little scale is all burned away."
msgstr "La balance riquiqui est toute cramée !"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.TROPHYSCALE_FISH.GENERIC
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.TROPHYSCALE_FISH.GENERIC"
msgid "Is scale to measure mightiness of fish!"
msgstr "Une balance pour peser les poissons !"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.TROPHYSCALE_FISH.HAS_ITEM
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.TROPHYSCALE_FISH.HAS_ITEM"
msgid "Weight: {weight}\nCaught by: {owner}"
msgstr "Poids : {weight}\nPêché par : {owner}"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.TROPHYSCALE_FISH.HAS_ITEM_HEAVY
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.TROPHYSCALE_FISH.HAS_ITEM_HEAVY"
msgid "Weight: {weight}\nCaught by: {owner}\nIs very impressive."
msgstr "Poids : {weight}\nPêché par : {owner}\nTrès impressionnant."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.TROPHYSCALE_FISH.OWNER
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.TROPHYSCALE_FISH.OWNER"
msgid "Weight: {weight}\nCaught by: {owner}\nOf course Wolfgang's fish is mightiest!"
msgstr "Poids : {weight}\nPêché par : {owner}\nLe poisson de Wolfgang est costaud !"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.TROPHYSCALE_FISH.OWNER_HEAVY
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.TROPHYSCALE_FISH.OWNER_HEAVY"
msgid "Weight: {weight}\nCaught by: {owner}\nCome see mighty fish caught by Wolfgang!"
msgstr "Poids : {weight}\nPêché par : {owner}\nRegardez les poissons costauds pêchés par Wolfgang !"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.TROPHYSCALE_OVERSIZEDVEGGIES.BURNING
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.TROPHYSCALE_OVERSIZEDVEGGIES.BURNING"
msgid "Not good!"
msgstr "Pas bon !"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.TROPHYSCALE_OVERSIZEDVEGGIES.BURNT
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.TROPHYSCALE_OVERSIZEDVEGGIES.BURNT"
msgid "Cooked."
msgstr "C'est cuit."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.TROPHYSCALE_OVERSIZEDVEGGIES.GENERIC
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.TROPHYSCALE_OVERSIZEDVEGGIES.GENERIC"
msgid "Whose fruit or veggie will be mightiest?"
msgstr "Quel fruit ou légume sera le plus fort ?"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.TROPHYSCALE_OVERSIZEDVEGGIES.HAS_ITEM
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.TROPHYSCALE_OVERSIZEDVEGGIES.HAS_ITEM"
msgid "Weight: {weight}\nHarvested on day: {day}\nWolfgang could lift with only one finger."
msgstr "Poids : {weight}\nRécolte effectuée le jour : {day}\nWolfgang pourrait le porter avec un seul doigt !"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.TROPHYSCALE_OVERSIZEDVEGGIES.HAS_ITEM_HEAVY
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.TROPHYSCALE_OVERSIZEDVEGGIES.HAS_ITEM_HEAVY"
msgid "Weight: {weight}\nHarvested on day: {day}\nHa! Very mighty indeed!"
msgstr "Poids : {weight}\nRécolte effectuée le jour : {day}\nHa ! C'est très très fort !"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.TROPHYSCALE_OVERSIZEDVEGGIES.HAS_ITEM_LIGHT
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.TROPHYSCALE_OVERSIZEDVEGGIES.HAS_ITEM_LIGHT"
msgid "Is too puny for scale to work."
msgstr "C'est trop petit pour que la balance marche."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.TRUNKVEST_SUMMER
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.TRUNKVEST_SUMMER"
