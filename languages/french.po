msgstr "T'as pas l'air si costaud !"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.BOATFRAGMENT03
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.BOATFRAGMENT03"
