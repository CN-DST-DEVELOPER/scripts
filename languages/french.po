msgstr "Cette image est recouverte d'une substance visqueuse noire."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.ATRIUM_RUBBLE.LINE_4
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.ATRIUM_RUBBLE.LINE_4"
