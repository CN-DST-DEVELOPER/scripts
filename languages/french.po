msgstr "Je vais tout manger !"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.YOTP_FOOD2
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.YOTP_FOOD2"
msgid "Nah. I'll feed it to something."
msgstr "Non. Je vais nourrir quelque chose avec ça."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.YOTP_FOOD3
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.YOTP_FOOD3"
msgid "A little snack to fill my belly."
msgstr "Un petit encas pour se remplir le ventre."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.YOTR_DECOR_1.GENERAL
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.YOTR_DECOR_1.GENERAL"
