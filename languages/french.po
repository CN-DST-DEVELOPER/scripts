msgstr "Je ne sais pas si c'est très sûr..."

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.BANANABUSH
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.BANANABUSH"
