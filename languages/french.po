msgstr "Je parie qu'il n'y a rien là-dedans."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.PORTABLECOOKPOT_ITEM.GENERIC
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.PORTABLECOOKPOT_ITEM.GENERIC"
msgid "Now we're cookin'!"
msgstr "Là, on cause cuisine !"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.PORTABLEFIREPIT_ITEM
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.PORTABLEFIREPIT_ITEM"
