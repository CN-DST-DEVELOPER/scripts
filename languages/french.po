msgstr "On dirait... on dirait que c'est en feu."

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.WINONA_TELEPORT_PAD_ITEM.BURNT
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.WINONA_TELEPORT_PAD_ITEM.BURNT"
