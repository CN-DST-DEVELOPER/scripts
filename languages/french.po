msgstr "Qu'est-ce que tu veux ?"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.YOTH_KNIGHTSHRINE.GENERIC
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.YOTH_KNIGHTSHRINE.GENERIC"
