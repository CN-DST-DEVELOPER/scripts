#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.YOTC_CARRAT_GYM_DIRECTION.RAT
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.YOTC_CARRAT_GYM_DIRECTION.RAT"
msgid "They're getting the hang of it!"
msgstr "Elle commence à avoir le coup de main !"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.YOTC_CARRAT_GYM_DIRECTION_ITEM
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.YOTC_CARRAT_GYM_DIRECTION_ITEM"
msgid "We should find someplace to put this."
msgstr "On devrait trouver un endroit pour mettre ça."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.YOTC_CARRAT_GYM_REACTION.BURNT
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.YOTC_CARRAT_GYM_REACTION.BURNT"
msgid "Uh oh..."
msgstr "Oh oh..."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.YOTC_CARRAT_GYM_REACTION.GENERIC
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.YOTC_CARRAT_GYM_REACTION.GENERIC"
msgid "We need to be ready for anything."
msgstr "Il faut qu'on soit prêts à tout."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.YOTC_CARRAT_GYM_REACTION.RAT
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.YOTC_CARRAT_GYM_REACTION.RAT"
msgid "That looks kind of fun!"
msgstr "Ça a l'air drôle !"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.YOTC_CARRAT_GYM_REACTION_ITEM
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.YOTC_CARRAT_GYM_REACTION_ITEM"
msgid "All the things we need to build a gym for our Carrat."
msgstr "Il nous faut tout ça pour construire un caratelier pour notre carate."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.YOTC_CARRAT_GYM_SPEED.BURNT
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.YOTC_CARRAT_GYM_SPEED.BURNT"
msgid "Uh oh..."
msgstr "Oh oh..."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.YOTC_CARRAT_GYM_SPEED.GENERIC
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.YOTC_CARRAT_GYM_SPEED.GENERIC"
msgid "\"The wheel on the gym goes round and round.\""
msgstr "Et la roue tourne et tourne et tourne..."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.YOTC_CARRAT_GYM_SPEED.RAT
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.YOTC_CARRAT_GYM_SPEED.RAT"
msgid "Look at it go!"
msgstr "Regardez-la courir !"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.YOTC_CARRAT_GYM_SPEED_ITEM
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.YOTC_CARRAT_GYM_SPEED_ITEM"
msgid "This should help make our Carrat faster!"
msgstr "Ça permettra à notre carate d'aller plus vite !"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.YOTC_CARRAT_GYM_STAMINA.BURNT
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.YOTC_CARRAT_GYM_STAMINA.BURNT"
msgid "Uh oh..."
msgstr "Oh oh..."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.YOTC_CARRAT_GYM_STAMINA.GENERIC
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.YOTC_CARRAT_GYM_STAMINA.GENERIC"
msgid "Look! It's got a little jump rope!"
msgstr "Regardez ! Elle a une toute petite corde à sauter !"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.YOTC_CARRAT_GYM_STAMINA.RAT
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.YOTC_CARRAT_GYM_STAMINA.RAT"
msgid "Aww, it's so cute!"
msgstr "C'est trop mignon !"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.YOTC_CARRAT_GYM_STAMINA_ITEM
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.YOTC_CARRAT_GYM_STAMINA_ITEM"
msgid "This'll be fun!"
msgstr "Ça va être marrant !"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.YOTC_CARRAT_RACE_CHECKPOINT
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.YOTC_CARRAT_RACE_CHECKPOINT"
msgid "Check out this checkpoint!"
msgstr "Regardez, un point de contrôle !"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.YOTC_CARRAT_RACE_CHECKPOINT_ITEM
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.YOTC_CARRAT_RACE_CHECKPOINT_ITEM"
msgid "Might get lost without these markers."
msgstr "Ils pourraient se perdre sans ces repères."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.YOTC_CARRAT_RACE_FINISH.BURNT
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.YOTC_CARRAT_RACE_FINISH.BURNT"
msgid "The firecrackers might have been a bad idea after all..."
msgstr "Les pétards étaient peut-être une mauvaise idée..."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.YOTC_CARRAT_RACE_FINISH.GENERIC
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.YOTC_CARRAT_RACE_FINISH.GENERIC"
msgid "We hope our little friend doesn't get lost on the way."
msgstr "J'espère que notre amie ne se perdra pas en route."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.YOTC_CARRAT_RACE_FINISH.I_WON
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.YOTC_CARRAT_RACE_FINISH.I_WON"
msgid "We did it! We won!!"
msgstr "On a réussi ! On a gagné !!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.YOTC_CARRAT_RACE_FINISH.SOMEONE_ELSE_WON
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.YOTC_CARRAT_RACE_FINISH.SOMEONE_ELSE_WON"
msgid "Woah, {winner}! How did you teach your Carrat to race like that?"
msgstr "Ouah, {winner} ! Comment vous avez appris à votre carate à courir comme ça ?"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.YOTC_CARRAT_RACE_FINISH_ITEM
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.YOTC_CARRAT_RACE_FINISH_ITEM"
msgid "We can't wait to see who crosses the finish line first!"
msgstr "On a trop hâte de voir qui va franchir la ligne d'arrivée en premier !"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.YOTC_CARRAT_RACE_START
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.YOTC_CARRAT_RACE_START"
msgid "We'll win for sure!"
msgstr "On va gagner, c'est sûr !"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.YOTC_CARRAT_RACE_START_ITEM
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.YOTC_CARRAT_RACE_START_ITEM"
msgid "Where should the race start?"
msgstr "Où va commencer la course ?"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.YOTC_CARRAT_SCALE.BURNT
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.YOTC_CARRAT_SCALE.BURNT"
msgid "I don't think we can use it anymore..."
msgstr "Je pense qu'on ne peut plus l'utiliser."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.YOTC_CARRAT_SCALE.CARRAT
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.YOTC_CARRAT_SCALE.CARRAT"
msgid "We still believe in you, no matter what the scale says."
msgstr "On croit en toi. On se fiche de ce que dit la balance !"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.YOTC_CARRAT_SCALE.CARRAT_GOOD
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.YOTC_CARRAT_SCALE.CARRAT_GOOD"
msgid "Wow! You've been training hard!"
msgstr "Ouah ! Tu t'es entraînée dur !"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.YOTC_CARRAT_SCALE.GENERIC
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.YOTC_CARRAT_SCALE.GENERIC"
msgid "We already know our Carrat's the best!"
msgstr "On sait déjà que notre carate est la meilleure !"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.YOTC_CARRAT_SCALE_ITEM
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.YOTC_CARRAT_SCALE_ITEM"
msgid "We can't wait to see how good our Carrat is."
msgstr "J'ai hâte de voir notre carate faire des étincelles."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.YOTC_SEEDPACKET
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.YOTC_SEEDPACKET"
msgid "Hm, where should we plant them?"
msgstr "Où est-ce qu'on va les planter ?"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.YOTC_SEEDPACKET_RARE
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.YOTC_SEEDPACKET_RARE"
msgid "We wonder what's gonna grow!"
msgstr "On se demande ce qui va pousser !"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.YOTD_ANCHOR
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.YOTD_ANCHOR"
msgid "Grab onto the sea floor real tight, okay?"
msgstr "Accroche-toi bien au fond de la mer, d'accord ?"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.YOTD_ANCHOR_ITEM
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.YOTD_ANCHOR_ITEM"
msgid "That's for making an anchor."
msgstr "C'est pour faire une ancre."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.YOTD_DRAGONSHRINE.BURNT
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.YOTD_DRAGONSHRINE.BURNT"
msgid "This makes us sad."
msgstr "Ça nous rend tristes..."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.YOTD_DRAGONSHRINE.EMPTY
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.YOTD_DRAGONSHRINE.EMPTY"
msgid "We think it wants burnt stuff!"
msgstr "On croit qu'il veut brûler des trucs !"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.YOTD_DRAGONSHRINE.GENERIC
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.YOTD_DRAGONSHRINE.GENERIC"
msgid "We love making things!"
msgstr "On adore fabriquer des trucs !"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.YOTD_OAR
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.YOTD_OAR"
msgid "We wish our claws were this big."
msgstr "On aimerait bien avoir des griffes comme ça."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.YOTD_STEERINGWHEEL
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.YOTD_STEERINGWHEEL"
msgid "Can we steer for the race? Pleeeaase?"
msgstr "On peut prendre la barre ? S'il te plaîîît ?"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.YOTD_STEERINGWHEEL_ITEM
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.YOTD_STEERINGWHEEL_ITEM"
msgid "That's for making a steering wheel."
msgstr "C'est pour faire un gouvernail."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.YOTH_CHAIR_ROCKING_ITEM
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.YOTH_CHAIR_ROCKING_ITEM"
msgid "Do we get two turns on it?"
msgstr "On a le droit à deux essais ?"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.YOTH_KNIGHTHAT
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.YOTH_KNIGHTHAT"
msgid "We can be a horse!"
msgstr "On peut être un cheval !"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.YOTH_KNIGHTSHRINE.BURNT
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.YOTH_KNIGHTSHRINE.BURNT"
msgid "Aww! It's all burnt!"
msgstr "Oh ! C'est tout brûlé !"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.YOTH_KNIGHTSHRINE.EMPTY
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.YOTH_KNIGHTSHRINE.EMPTY"
msgid "We have to give it something first!"
msgstr "On doit d'abord lui donner quelque chose !"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.YOTH_KNIGHTSHRINE.GENERIC
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.YOTH_KNIGHTSHRINE.GENERIC"
msgid "Now we wait for our present!"
msgstr "Plus qu'à attendre notre cadeau !"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.YOTH_KNIGHTSTICK
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.YOTH_KNIGHTSTICK"
msgid "We'll run fast as a horse!"
msgstr "On va courir aussi vite qu'un cheval !"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.YOTH_LANCE
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.YOTH_LANCE"
msgid "We are supposed to run with this sharp object!"
msgstr "On peut courir avec cet objet pointu !"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.YOTP_FOOD1
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.YOTP_FOOD1"
msgid "Yummy!"
msgstr "Miam !"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.YOTP_FOOD2
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.YOTP_FOOD2"
msgid "Mmmmmm."
msgstr "Miam !"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.YOTP_FOOD3
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.YOTP_FOOD3"
msgid "Smells good."
msgstr "Ça sent bon."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.YOTR_DECOR_1.GENERAL
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.YOTR_DECOR_1.GENERAL"
msgid "It makes us feel safe and cozy."
msgstr "Ça donne l'impression d'être en sécurité."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.YOTR_DECOR_1.OUT
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.YOTR_DECOR_1.OUT"
msgid "We still like it, even without the light!"
msgstr "On l'aime quand même, même quand c'est pas allumé !"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.YOTR_DECOR_1_ITEM
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.YOTR_DECOR_1_ITEM"
msgid "It'd be a good night light."
msgstr "Ce serait chouette, comme veilleuse."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.YOTR_DECOR_2.GENERAL
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.YOTR_DECOR_2.GENERAL"
msgid "It makes us feel safe and cozy."
msgstr "Ça donne l'impression d'être en sécurité."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.YOTR_DECOR_2.OUT
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.YOTR_DECOR_2.OUT"
msgid "We still like it, even without the light!"
msgstr "On l'aime quand même, même quand c'est pas allumé !"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.YOTR_DECOR_2_ITEM
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.YOTR_DECOR_2_ITEM"
msgid "It'd be a good night light."
msgstr "Ce serait chouette, comme veilleuse."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.YOTR_FIGHTRING_BELL.GENERIC
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.YOTR_FIGHTRING_BELL.GENERIC"
msgid "Let's start a pillow fight!"
msgstr "Que la bataille de polochons commence !"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.YOTR_FIGHTRING_BELL.PLAYING
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.YOTR_FIGHTRING_BELL.PLAYING"
msgid "We want to play too!"
msgstr "Nous aussi, on veut jouer !"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.YOTR_FIGHTRING_KIT
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.YOTR_FIGHTRING_KIT"
msgid "It's okay Ms. Wickerbottom, we'll only be fighting with pillows!"
msgstr "Tout va bien, Mme Wickerbottom. On se bat qu'avec des oreillers !"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.YOTR_FOOD1
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.YOTR_FOOD1"
msgid "It looks like cake, but it smells like veggies..."
msgstr "On dirait du gâteau, mais ça sent les légumes..."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.YOTR_FOOD2
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.YOTR_FOOD2"
msgid "Mmm, the moon is tasty!"
msgstr "Mmh, c'est bon, la lune !"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.YOTR_FOOD3
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.YOTR_FOOD3"
msgid "We kinda want to poke it."
msgstr "On a envie de la faire bouger."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.YOTR_FOOD4
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.YOTR_FOOD4"
msgid "We can eat one puff, and share the rest with our friends!"
msgstr "On peut manger un bout et partager le reste avec nos copains !"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.YOTR_RABBITSHRINE.BURNT
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.YOTR_RABBITSHRINE.BURNT"
msgid "Oh no!"
msgstr "Oh no !"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.YOTR_RABBITSHRINE.EMPTY
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.YOTR_RABBITSHRINE.EMPTY"
msgid "Please don't bite us, we'll find something tastier for you to eat!"
msgstr "Nous mordez pas ! On va trouver quelque chose de bon à manger à vous donner !"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.YOTR_RABBITSHRINE.GENERIC
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.YOTR_RABBITSHRINE.GENERIC"
msgid "Do you have any fun things for us to play with?"
msgstr "Vous avez des trucs marrants pour qu'on puisse jouer ?"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.YOTR_TOKEN
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.YOTR_TOKEN"
msgid "We shouldn't start fights... but do pillow fights count?"
msgstr "Il faut jamais provoquer des bagarres... mais les batailles de polochons, ça compte ?"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.YOTS_LANTERN_POST.BURNT
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.YOTS_LANTERN_POST.BURNT"
msgid "Aw. It burned."
msgstr "Oh... ça a brûlé."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.YOTS_LANTERN_POST.GENERIC
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.YOTS_LANTERN_POST.GENERIC"
msgid "Fancy!"
msgstr "Beau !"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.YOTS_LANTERN_POST_ITEM
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.YOTS_LANTERN_POST_ITEM"
msgid "We can build it!"
msgstr "On peut le monter !"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.YOTS_SNAKESHRINE.BURNT
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.YOTS_SNAKESHRINE.BURNT"
msgid "It wasn't us."
msgstr "C'est pas nous."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.YOTS_SNAKESHRINE.EMPTY
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.YOTS_SNAKESHRINE.EMPTY"
msgid "What do we give it?"
msgstr "Qu'est-ce qu'on peut lui donner ?"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.YOTS_SNAKESHRINE.GENERIC
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.YOTS_SNAKESHRINE.GENERIC"
msgid "A surprise for us!"
msgstr "Une surprise !"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.YOTS_WORM
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.YOTS_WORM"
msgid "You'll never catch us, worm!"
msgstr "Tu nous attraperas pas, le ver !"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.YOT_CATCOONSHRINE.BURNT
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.YOT_CATCOONSHRINE.BURNT"
msgid "I guess not everyone likes catcoons..."
msgstr "Tout le monde aime pas les chatons laveurs, il faut croire..."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.YOT_CATCOONSHRINE.EMPTY
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.YOT_CATCOONSHRINE.EMPTY"
msgid "What could we offer it? Something from a bird?"
msgstr "Qu'est-ce qu'on pourrait lui offrir ? Un truc d'oiseau ?"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.YOT_CATCOONSHRINE.GENERIC
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.YOT_CATCOONSHRINE.GENERIC"
msgid "What a nice tribute!"
msgstr "Quelle jolie offrande !"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE_GENERIC
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE_GENERIC"
msgid "Can we play with it?"
msgstr "On peut s'amuser avec ?"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE_PLANTHAPPY
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE_PLANTHAPPY"
msgid "A happy plant."
msgstr "Une plante très contente."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE_PLANTSTRESSED
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE_PLANTSTRESSED"
msgid "Aw, this plant doesn't look very happy..."
msgstr "Ooh, cette plante n'a pas l'air très contente."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE_PLANTSTRESSORFAMILY
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE_PLANTSTRESSORFAMILY"
msgid "Maybe it would be happier if it wasn't alone?"
msgstr "Elle serait peut-être plus heureuse si elle avait des copines ?"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE_PLANTSTRESSORHAPPINESS
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE_PLANTSTRESSORHAPPINESS"
msgid "Aww, do you need someone to talk to?"
msgstr "Ooh, tu as besoin de quelqu'un à qui parler ?"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE_PLANTSTRESSORKILLJOYS
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE_PLANTSTRESSORKILLJOYS"
msgid "We should do some weeding... even if we don't like to."
msgstr "On devrait désherber un peu... Même si on a pas envie."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE_PLANTSTRESSORMOISTURE
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE_PLANTSTRESSORMOISTURE"
msgid "We should give it some water."
msgstr "On devrait lui donner un peu d'eau."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE_PLANTSTRESSORNUTRIENTS
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE_PLANTSTRESSORNUTRIENTS"
msgid "Maybe it needs some better dirt?"
msgstr "Il lui faut peut-être une meilleure terre ?"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE_PLANTSTRESSOROVERCROWDING
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE_PLANTSTRESSOROVERCROWDING"
msgid "We packed too many plants too close together!"
msgstr "On a mis trop de plantes au même endroit !"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE_PLANTSTRESSORSEASON
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE_PLANTSTRESSORSEASON"
msgid "We don't think it likes this weather very much."
msgstr "On pense qu'elle n'aime pas trop ce climat."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE_PLANTVERYSTRESSED
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE_PLANTVERYSTRESSED"
msgid "This plant looks miserable!"
msgstr "Cette plante a l'air super triste !"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE_SMOLDERING
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE_SMOLDERING"
msgid "Uh-oh. I smell burning!"
msgstr "Oh oh ! Ça sent le brûlé !"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE_TOODARK
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE_TOODARK"
msgid "All our eyes stopped working!"
msgstr "Tous nos yeux ont cessé de fonctionner !"

#. STRINGS.CHARACTERS.WEBBER.EAT_FOOD.TALLBIRDEGG_CRACKED
msgctxt "STRINGS.CHARACTERS.WEBBER.EAT_FOOD.TALLBIRDEGG_CRACKED"
msgid "What if it hatches in our belly?"
msgstr "Et s'il éclot dans notre ventre ?"

#. STRINGS.CHARACTERS.WEBBER.EAT_FOOD.WINTERSFEASTFUEL
msgctxt "STRINGS.CHARACTERS.WEBBER.EAT_FOOD.WINTERSFEASTFUEL"
msgid "It... reminds me of mom's cooking..."
msgstr "Ça... me fait penser à la cuisine de maman."

#. STRINGS.CHARACTERS.WEBBER.QUAGMIRE_ANNOUNCE_LOSE
msgctxt "STRINGS.CHARACTERS.WEBBER.QUAGMIRE_ANNOUNCE_LOSE"
msgid "Don't eat us!"
msgstr "Nous mangez pas !"

#. STRINGS.CHARACTERS.WEBBER.QUAGMIRE_ANNOUNCE_MEALBURNT
msgctxt "STRINGS.CHARACTERS.WEBBER.QUAGMIRE_ANNOUNCE_MEALBURNT"
msgid "Oh no! We burnt it!"
msgstr "Oh, non ! On l'a brûlé !"

#. STRINGS.CHARACTERS.WEBBER.QUAGMIRE_ANNOUNCE_NOTRECIPE
msgctxt "STRINGS.CHARACTERS.WEBBER.QUAGMIRE_ANNOUNCE_NOTRECIPE"
msgid "Oh no! That wasn't a recipe!"
msgstr "Oh, non ! C'était pas une recette !"

#. STRINGS.CHARACTERS.WEBBER.QUAGMIRE_ANNOUNCE_WIN
msgctxt "STRINGS.CHARACTERS.WEBBER.QUAGMIRE_ANNOUNCE_WIN"
msgid "I'm ready to go home now!"
msgstr "Je suis prêt à rentrer à la maison maintenant !"

#. STRINGS.CHARACTERS.WEBBER.WENDY_SKILLTREE_EASTEREGG
msgctxt "STRINGS.CHARACTERS.WEBBER.WENDY_SKILLTREE_EASTEREGG"
msgid "only_used_by_wendy"
msgstr "only_used_by_wendy"

#. STRINGS.CHARACTERS.WENDY.ACTIONFAIL.ACTIVATE.CARNIVAL_HOST_HERE
msgctxt "STRINGS.CHARACTERS.WENDY.ACTIONFAIL.ACTIVATE.CARNIVAL_HOST_HERE"
msgid "Mr. Raven? Are you here?"
msgstr "Monsieur le corbeau ? Vous êtes là ?"

#. STRINGS.CHARACTERS.WENDY.ACTIONFAIL.ACTIVATE.EMPTY_CATCOONDEN
msgctxt "STRINGS.CHARACTERS.WENDY.ACTIONFAIL.ACTIVATE.EMPTY_CATCOONDEN"
msgid "Abandoned. Left to the flies."
msgstr "Laissé à l'abandon et aux mouches."

#. STRINGS.CHARACTERS.WENDY.ACTIONFAIL.ACTIVATE.HOSTBUSY
msgctxt "STRINGS.CHARACTERS.WENDY.ACTIONFAIL.ACTIVATE.HOSTBUSY"
msgid "I suppose he has more important things to do."
msgstr "J'imagine qu'il a mieux à faire."

#. STRINGS.CHARACTERS.WENDY.ACTIONFAIL.ACTIVATE.KITCOON_HIDEANDSEEK_NOT_ENOUGH_HIDERS
msgctxt "STRINGS.CHARACTERS.WENDY.ACTIONFAIL.ACTIVATE.KITCOON_HIDEANDSEEK_NOT_ENOUGH_HIDERS"
msgid "If we play now, they will stand no chance at winning."
msgstr "Si nous jouons maintenant, ils n'auront aucune chance de gagner."

#. STRINGS.CHARACTERS.WENDY.ACTIONFAIL.ACTIVATE.KITCOON_HIDEANDSEEK_NOT_ENOUGH_HIDING_SPOTS
msgctxt "STRINGS.CHARACTERS.WENDY.ACTIONFAIL.ACTIVATE.KITCOON_HIDEANDSEEK_NOT_ENOUGH_HIDING_SPOTS"
msgid "If we play now, they won't find a place to hide."
msgstr "Si nous jouons maintenant, ils n'auront nulle part où se cacher."

#. STRINGS.CHARACTERS.WENDY.ACTIONFAIL.ACTIVATE.KITCOON_HIDEANDSEEK_ONE_GAME_PER_DAY
msgctxt "STRINGS.CHARACTERS.WENDY.ACTIONFAIL.ACTIVATE.KITCOON_HIDEANDSEEK_ONE_GAME_PER_DAY"
msgid "If we play more, Abigail will get tired."
msgstr "Si nous jouons encore, Abigail sera fatiguée."

#. STRINGS.CHARACTERS.WENDY.ACTIONFAIL.ACTIVATE.LOCKED_GATE
msgctxt "STRINGS.CHARACTERS.WENDY.ACTIONFAIL.ACTIVATE.LOCKED_GATE"
msgid "I can't open it without a key."
msgstr "Impossible à ouvrir sans clé."

#. STRINGS.CHARACTERS.WENDY.ACTIONFAIL.ACTIVATE.MANNEQUIN_EQUIPSWAPFAILED
msgctxt "STRINGS.CHARACTERS.WENDY.ACTIONFAIL.ACTIVATE.MANNEQUIN_EQUIPSWAPFAILED"
