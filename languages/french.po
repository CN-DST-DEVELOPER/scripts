msgid "n/a"
msgstr "n/a"

#. STRINGS.SKIN_DESCRIPTIONS.meatrack_victorian
msgctxt "STRINGS.SKIN_DESCRIPTIONS.meatrack_victorian"
msgid "A distinguished display for fine dried meats."
msgstr "Un assortiment de charcuterie raffinée."

#. STRINGS.SKIN_DESCRIPTIONS.mermhat_clown
msgctxt "STRINGS.SKIN_DESCRIPTIONS.mermhat_clown"
msgid "So so incognito!"
msgstr "Pour passer inaperçu !"

#. STRINGS.SKIN_DESCRIPTIONS.mermhouse_crafted_fantasy
msgctxt "STRINGS.SKIN_DESCRIPTIONS.mermhouse_crafted_fantasy"
msgid "This charming home doesn't leave mushroom for improvement."
msgstr "Cette charmante maison sent un peu la moisissure, quand même."

#. STRINGS.SKIN_DESCRIPTIONS.mermhouse_crafted_mystical
msgctxt "STRINGS.SKIN_DESCRIPTIONS.mermhouse_crafted_mystical"
msgid "The wisdom of the Merms is beyond our understanding, and theirs too."
msgstr "La sagesse des Merms dépasse votre entendement comme le leur."

#. STRINGS.SKIN_DESCRIPTIONS.mermhouse_crafted_swamp
msgctxt "STRINGS.SKIN_DESCRIPTIONS.mermhouse_crafted_swamp"
msgid "When visiting the swamp, these cute little houses are a mossy."
msgstr "N'oubliez pas de visiter ces petites maisons moussues dans le marécage."

#. STRINGS.SKIN_DESCRIPTIONS.mermwatchtower_mystical
msgctxt "STRINGS.SKIN_DESCRIPTIONS.mermwatchtower_mystical"
msgid "Home of the King's Special Florpces."
msgstr "Demeure des Florpces spéciaux de Sa Majesté."

#. STRINGS.SKIN_DESCRIPTIONS.mermwatchtower_swamp
msgctxt "STRINGS.SKIN_DESCRIPTIONS.mermwatchtower_swamp"
msgid "For the glort-y of the King!"
msgstr "Pour la gloirp du roi !"

#. STRINGS.SKIN_DESCRIPTIONS.mighty_gym_ancient
msgctxt "STRINGS.SKIN_DESCRIPTIONS.mighty_gym_ancient"
msgid "Master the ancient art of lifting heavy objects."
msgstr "Maîtrisez l'art antique qui consiste à soulever des objets lourds."

#. STRINGS.SKIN_DESCRIPTIONS.minerhat_bonnet
msgctxt "STRINGS.SKIN_DESCRIPTIONS.minerhat_bonnet"
msgid "Nothing improves a design like adding more ruffles."
msgstr "C'est toujours mieux avec un ravissant petit volant."

