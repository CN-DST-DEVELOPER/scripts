msgstr "Ça ferait pas de mal de fouiller un peu par ici."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.JUNK_PILE_BIG.BLUEPRINT
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.JUNK_PILE_BIG.BLUEPRINT"
