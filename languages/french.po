msgstr "Ça m'a l'air à point !"

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.SUPPORT_PILLAR_DREADSTONE_SCAFFOLD
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.SUPPORT_PILLAR_DREADSTONE_SCAFFOLD"
