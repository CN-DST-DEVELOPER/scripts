msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.MEATRACK_HERMIT_MULTI.DONE_SALT"
msgid "Food without salt is like life without..."
msgstr "La nourriture sans sel, c'est comme la vie sans..."

