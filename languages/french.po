msgstr "Croustillant, non ?"

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.WINONA_TELEPORT_PAD_ITEM.GENERIC
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.WINONA_TELEPORT_PAD_ITEM.GENERIC"
