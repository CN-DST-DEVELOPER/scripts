msgstr "« Sinistre ! »"

#. STRINGS.SKIN_QUOTES.wormwood_rose
msgctxt "STRINGS.SKIN_QUOTES.wormwood_rose"
msgid "\"Feel big fancy\""
msgstr "« Je me sens important. »"

#. STRINGS.SKIN_QUOTES.wormwood_saladmander
msgctxt "STRINGS.SKIN_QUOTES.wormwood_saladmander"
msgid "\"Hot bath sound nice...\""
msgstr "Moi aussi je prendrais bien un bain chaud..."

#. STRINGS.SKIN_QUOTES.wormwood_saladmander_d
msgctxt "STRINGS.SKIN_QUOTES.wormwood_saladmander_d"
msgid "\"Hot bath sound nice...\""
msgstr "Moi aussi je prendrais bien un bain chaud..."

#. STRINGS.SKIN_QUOTES.wormwood_saladmander_p
msgctxt "STRINGS.SKIN_QUOTES.wormwood_saladmander_p"
msgid "\"Hot bath sound nice...\""
msgstr "Moi aussi je prendrais bien un bain chaud..."

#. STRINGS.SKIN_QUOTES.wormwood_shadow
msgctxt "STRINGS.SKIN_QUOTES.wormwood_shadow"
msgid "\"All... will rot...\""
msgstr "« Tout... pourrira... »"

#. STRINGS.SKIN_QUOTES.wormwood_survivor
msgctxt "STRINGS.SKIN_QUOTES.wormwood_survivor"
msgid "\"Here much long... much long\""
msgstr "« Ici bien longtemps... bien longtemps »"

#. STRINGS.SKIN_QUOTES.wormwood_victorian
msgctxt "STRINGS.SKIN_QUOTES.wormwood_victorian"
msgid "\"Swirly shiny!\""
msgstr "« Un tourbillon qui brille ! »"

#. STRINGS.SKIN_QUOTES.wormwood_yule
msgctxt "STRINGS.SKIN_QUOTES.wormwood_yule"
msgid "\"Feel pretty\""
msgstr "« Je suis si joli »"

#. STRINGS.SKIN_QUOTES.wortox_ancient
msgctxt "STRINGS.SKIN_QUOTES.wortox_ancient"
msgid "\"I've been told, my blood can run cold!\""
msgstr "« On me dit parfois que j'ai le sang-froid ! »"

#. STRINGS.SKIN_QUOTES.wortox_dragon
msgctxt "STRINGS.SKIN_QUOTES.wortox_dragon"
msgid "\"Don't get between me and my hoard of souls.\""
msgstr "« Ne vous dressez pas entre mes âmes et moi. »"

#. STRINGS.SKIN_QUOTES.wortox_formal
msgctxt "STRINGS.SKIN_QUOTES.wortox_formal"
msgid "\"Charmed, I'm sure.\""
msgstr "« Je sens bon le charisme. »"

#. STRINGS.SKIN_QUOTES.wortox_hazard
msgctxt "STRINGS.SKIN_QUOTES.wortox_hazard"
msgid "\"Hrrm... mff! Mmmf!\""
msgstr "« Hurrm... mff ! Mmmf ! »"

#. STRINGS.SKIN_QUOTES.wortox_ice
msgctxt "STRINGS.SKIN_QUOTES.wortox_ice"
msgid "\"Don't slip up or you might get a face full of snow, hyuyu!\""
msgstr "« Ne glissez pas, ou vous allez tomber la tête la première dans la neige, houhou ! »"

#. STRINGS.SKIN_QUOTES.wortox_lunar
msgctxt "STRINGS.SKIN_QUOTES.wortox_lunar"
msgid "\"A princely guise, with moonlit ties!\""
msgstr "« Une tenue lunaire, de lueur claire ! »"

#. STRINGS.SKIN_QUOTES.wortox_masquerade
msgctxt "STRINGS.SKIN_QUOTES.wortox_masquerade"
msgid "\"These masked events are the playgrounds of merry mischief-makers!\""
msgstr "« Ces événements masqués sont le moment rêvé pour des tours pendables bien joués ! »"

#. STRINGS.SKIN_QUOTES.wortox_minotaur
msgctxt "STRINGS.SKIN_QUOTES.wortox_minotaur"
msgid "\"Won't you visit me at the heart of the labyrinth?\""
msgstr "« Me rendrez-vous visite au cœur du labyrinthe ? »"

#. STRINGS.SKIN_QUOTES.wortox_nature
msgctxt "STRINGS.SKIN_QUOTES.wortox_nature"
msgid "\"Follow me into the forest deep, where impish sorts frolic and play!\""
msgstr "« Suivez-moi dans les confins de la forêt, où les diablotins se cachent pour jouer ! »"

#. STRINGS.SKIN_QUOTES.wortox_noeyeddeer
msgctxt "STRINGS.SKIN_QUOTES.wortox_noeyeddeer"
msgid "\"Oh dear, I have no idea where I'm going.\""
msgstr "Oh là là... Je ne sais pas du tout où je vais."

#. STRINGS.SKIN_QUOTES.wortox_noeyeddeer_d
msgctxt "STRINGS.SKIN_QUOTES.wortox_noeyeddeer_d"
msgid "\"Oh dear, I have no idea where I'm going.\""
msgstr "Oh là là... Je ne sais pas du tout où je vais."

#. STRINGS.SKIN_QUOTES.wortox_noeyeddeer_p
msgctxt "STRINGS.SKIN_QUOTES.wortox_noeyeddeer_p"
msgid "\"Oh dear, I have no idea where I'm going.\""
msgstr "Oh là là... Je ne sais pas du tout où je vais."

#. STRINGS.SKIN_QUOTES.wortox_original
msgctxt "STRINGS.SKIN_QUOTES.wortox_original"
msgid "\"Ol'Kramps says my powers should grow in soon. Hyuyu!\""
msgstr "« Le vieux Krampus dit que mes pouvoirs augmenteront bientôt. Houhou ! »"

#. STRINGS.SKIN_QUOTES.wortox_pirate
msgctxt "STRINGS.SKIN_QUOTES.wortox_pirate"
msgid "\"We impish sorts do love our gold, hyuyu!\""
msgstr "« Les diablotins adorent l'or, en général, houhou ! »"

#. STRINGS.SKIN_QUOTES.wortox_rose
msgctxt "STRINGS.SKIN_QUOTES.wortox_rose"
msgid "\"I'm simply tickled pink, hyuyu!\""
msgstr "« Je vois la vie en rose et en prose, houhou ! »"

#. STRINGS.SKIN_QUOTES.wortox_shadow
msgctxt "STRINGS.SKIN_QUOTES.wortox_shadow"
msgid "\"I let in darkness once before, what's the harm in a little more?\""
msgstr "« J'ai déjà accueilli les ténèbres entre mes mains, alors un peu plus un peu moins... »"

#. STRINGS.SKIN_QUOTES.wortox_survivor
msgctxt "STRINGS.SKIN_QUOTES.wortox_survivor"
msgid "\"Try not to cower in fear, my dear!\""
msgstr "« Ne vous laissez pas racornir par la peur, les amis ! »"

#. STRINGS.SKIN_QUOTES.wortox_victorian
msgctxt "STRINGS.SKIN_QUOTES.wortox_victorian"
msgid "\"Ol'Kramps did always say; if I kept making a funny face it'd get stuck that way.\""
msgstr "« Le vieux Krampus avait l'habitude dire, que si je continue à faire des grimaces, mon visage ne retiendra que la pire. »"

#. STRINGS.SKIN_QUOTES.wortox_yule
msgctxt "STRINGS.SKIN_QUOTES.wortox_yule"
msgid "\"I'm absolutely adorable!\""
msgstr "« Je suis à croquer ! »"

#. STRINGS.SKIN_QUOTES.wurt_ancient
msgctxt "STRINGS.SKIN_QUOTES.wurt_ancient"
msgid "\"Mermfolk ancestors definitely look like this, florp!\""
msgstr "« Mes ancêtres ressemblaient à ça, florp ! »"

#. STRINGS.SKIN_QUOTES.wurt_cave
msgctxt "STRINGS.SKIN_QUOTES.wurt_cave"
msgid "\"It called bye-oh-loomy...loominess...loomin-essence... GLOWY!\""
msgstr "« Ça s'appelle la bi-yo... lumi... luminess... lumin-essence... Ça brille ! »"

#. STRINGS.SKIN_QUOTES.wurt_formal
msgctxt "STRINGS.SKIN_QUOTES.wurt_formal"
msgid "\"Frilly and gilly, florp!\""
msgstr "« Plein de franfreluches, florp ! »"

#. STRINGS.SKIN_QUOTES.wurt_hazard
msgctxt "STRINGS.SKIN_QUOTES.wurt_hazard"
msgid "\"Hrrm... mff! Mmmf!\""
msgstr "« Hurrm... mff ! Mmmf ! »"

#. STRINGS.SKIN_QUOTES.wurt_ice
msgctxt "STRINGS.SKIN_QUOTES.wurt_ice"
msgid "\"Maybe fluff okay for wintertime, but scales better all other times!\""
msgstr "« La fourrure, c'est bien pour l'hiver. Mais les écailles, c'est mieux le reste du temps ! »"

#. STRINGS.SKIN_QUOTES.wurt_lunar
msgctxt "STRINGS.SKIN_QUOTES.wurt_lunar"
msgid "\"Me look radiant on moonlit swim.\""
msgstr "« Moi, briller de mille feux en nageant sous la lune. »"

#. STRINGS.SKIN_QUOTES.wurt_masquerade
msgctxt "STRINGS.SKIN_QUOTES.wurt_masquerade"
msgid "\"Me feel fancy, florp!\""
msgstr "« J'ai l'air chic, florp ! »"

#. STRINGS.SKIN_QUOTES.wurt_nature
msgctxt "STRINGS.SKIN_QUOTES.wurt_nature"
msgid "\"Me scary dragon! Gonna gobble up all the princesses, hee-hee!\""
msgstr "« Je suis un dragon qui fait peur ! Je vais gober toutes les princesses hé hé ! »"

#. STRINGS.SKIN_QUOTES.wurt_pirate
msgctxt "STRINGS.SKIN_QUOTES.wurt_pirate"
msgid "\"Glurgh, no call me shrimp! Me big scary pirate!!\""
msgstr "« Glurg ! Je suis pas une crevette ! Je suis une pirate qui fait peur !! »"

#. STRINGS.SKIN_QUOTES.wurt_rose
msgctxt "STRINGS.SKIN_QUOTES.wurt_rose"
msgid "\"Dressing up not so bad sometimes.\""
msgstr "« C'est rigolo de bien s'habiller, de temps en temps. »"

#. STRINGS.SKIN_QUOTES.wurt_shadow
msgctxt "STRINGS.SKIN_QUOTES.wurt_shadow"
msgid "\"Come closer... won't bite! (Hee-hee...)\""
msgstr "« Approche... Je ne mords pas ! (Hé hé...) »"

#. STRINGS.SKIN_QUOTES.wurt_squid
msgctxt "STRINGS.SKIN_QUOTES.wurt_squid"
