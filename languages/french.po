msgstr "La balance"

#. STRINGS.SKILLTREE.WORTOX.WORTOX_INCLINATION_NAUGHTY_DESC
msgctxt "STRINGS.SKILLTREE.WORTOX.WORTOX_INCLINATION_NAUGHTY_DESC"
msgid "Your greed stops you from overloading of Soul power, for a moment.\nEating or releasing Souls will no longer change sanity. Souls heal you for less."
msgstr "Votre gourmandise vous empêche une surcharge de puissance d'âmes, pendant un certain temps.\nDévorer ou libérer des âmes n'altèrera plus la santé mentale. Les âmes restaurent moins de santé."

#. STRINGS.SKILLTREE.WORTOX.WORTOX_INCLINATION_NAUGHTY_TITLE
msgctxt "STRINGS.SKILLTREE.WORTOX.WORTOX_INCLINATION_NAUGHTY_TITLE"
msgid "Naughty Inclination"
msgstr "Penchant méchant"

#. STRINGS.SKILLTREE.WORTOX.WORTOX_INCLINATION_NICE_DESC
msgctxt "STRINGS.SKILLTREE.WORTOX.WORTOX_INCLINATION_NICE_DESC"
msgid "Your kindness has made your monster side no longer stir up trouble.\nEating or releasing Souls will change sanity at an increased amount."
msgstr "Votre gentillesse a apaisé votre côté monstrueux.\nDévorer ou libérer des âmes altèrera davantage la santé mentale."

#. STRINGS.SKILLTREE.WORTOX.WORTOX_INCLINATION_NICE_TITLE
msgctxt "STRINGS.SKILLTREE.WORTOX.WORTOX_INCLINATION_NICE_TITLE"
msgid "Nice Inclination"
msgstr "Penchant gentil"

#. STRINGS.SKILLTREE.WORTOX.WORTOX_LIFEBRINGER_1_DESC
msgctxt "STRINGS.SKILLTREE.WORTOX.WORTOX_LIFEBRINGER_1_DESC"
msgid "Learn how to channel Souls into a Twintailed Heart, a creation used to revive ghostly friends."
msgstr "Apprenez à canaliser les âmes dans un cœur à queue, une création permettant de redonner vie aux amis fantômes."

#. STRINGS.SKILLTREE.WORTOX.WORTOX_LIFEBRINGER_1_TITLE
msgctxt "STRINGS.SKILLTREE.WORTOX.WORTOX_LIFEBRINGER_1_TITLE"
msgid "Lifebringer I"
msgstr "Souffleur de vie I"

#. STRINGS.SKILLTREE.WORTOX.WORTOX_LIFEBRINGER_2_DESC
msgctxt "STRINGS.SKILLTREE.WORTOX.WORTOX_LIFEBRINGER_2_DESC"
msgid "Your ghostly friends will no longer suffer health penalties when you revive them with a Twintailed Heart."
msgstr "Vos amis fantômes ne subiront plus de pénalité de santé quand vous les ranimerez avec un cœur à queue."

#. STRINGS.SKILLTREE.WORTOX.WORTOX_LIFEBRINGER_2_TITLE
msgctxt "STRINGS.SKILLTREE.WORTOX.WORTOX_LIFEBRINGER_2_TITLE"
msgid "Lifebringer II"
msgstr "Souffleur de vie II"

#. STRINGS.SKILLTREE.WORTOX.WORTOX_LIFEBRINGER_3_DESC
msgctxt "STRINGS.SKILLTREE.WORTOX.WORTOX_LIFEBRINGER_3_DESC"
msgid "Allow the Twintailed Heart to be used by another which will pull them to you from near or afar.\nUsing it yourself will free the Souls inside."
msgstr "Le cœur à queue peut être utilisé par une autre personne qui sera attirée à vous de près ou de loin.\nSi vous l'utilisez vous-même, vous libèrerez les âmes à l'intérieur."

#. STRINGS.SKILLTREE.WORTOX.WORTOX_LIFEBRINGER_3_TITLE
msgctxt "STRINGS.SKILLTREE.WORTOX.WORTOX_LIFEBRINGER_3_TITLE"
msgid "Lifebringer III"
msgstr "Souffleur de vie III"

#. STRINGS.SKILLTREE.WORTOX.WORTOX_LIFTEDSPIRITS_1_DESC
msgctxt "STRINGS.SKILLTREE.WORTOX.WORTOX_LIFTEDSPIRITS_1_DESC"
msgid "Souls waiting to be freed in a Soul Echo will enhance your movement speed."
msgstr "Les âmes attendant d'être libérées d'un écho d'âme augmenteront votre vitesse de déplacement."

#. STRINGS.SKILLTREE.WORTOX.WORTOX_LIFTEDSPIRITS_1_TITLE
msgctxt "STRINGS.SKILLTREE.WORTOX.WORTOX_LIFTEDSPIRITS_1_TITLE"
msgid "Lifted Spirits I"
msgstr "Esprits élevés I"

#. STRINGS.SKILLTREE.WORTOX.WORTOX_LIFTEDSPIRITS_2_DESC
msgctxt "STRINGS.SKILLTREE.WORTOX.WORTOX_LIFTEDSPIRITS_2_DESC"
msgid "Soul Echo duration is increased."
msgstr "La durée de l'écho d'âme augmente."

#. STRINGS.SKILLTREE.WORTOX.WORTOX_LIFTEDSPIRITS_2_TITLE
msgctxt "STRINGS.SKILLTREE.WORTOX.WORTOX_LIFTEDSPIRITS_2_TITLE"
msgid "Lifted Spirits II"
msgstr "Esprits élevés II"

#. STRINGS.SKILLTREE.WORTOX.WORTOX_LIFTEDSPIRITS_3_DESC
msgctxt "STRINGS.SKILLTREE.WORTOX.WORTOX_LIFTEDSPIRITS_3_DESC"
msgid "Soul Echo will happen a second time.\nThis does not decrease Soul Hop costs from the Map."
msgstr "L'écho d'âme se produira une deuxième fois.\nCeci ne réduit pas le coût du saut d'âme sur la carte."

#. STRINGS.SKILLTREE.WORTOX.WORTOX_LIFTEDSPIRITS_3_TITLE
msgctxt "STRINGS.SKILLTREE.WORTOX.WORTOX_LIFTEDSPIRITS_3_TITLE"
msgid "Reverberation"
msgstr "Réverbération"

#. STRINGS.SKILLTREE.WORTOX.WORTOX_LIFTEDSPIRITS_4_DESC
msgctxt "STRINGS.SKILLTREE.WORTOX.WORTOX_LIFTEDSPIRITS_4_DESC"
msgid "Soul Hop cost from the Map will be reduced by how much of the current world's land has been explored."
msgstr "Le coût des sauts d'âme sur la carte sera réduit en fonction de la quantité du monde exploré."

#. STRINGS.SKILLTREE.WORTOX.WORTOX_LIFTEDSPIRITS_4_TITLE
msgctxt "STRINGS.SKILLTREE.WORTOX.WORTOX_LIFTEDSPIRITS_4_TITLE"
msgid "Capricious Movement"
msgstr "Caprice de déplacement"

#. STRINGS.SKILLTREE.WORTOX.WORTOX_NABBAG_DESC
msgctxt "STRINGS.SKILLTREE.WORTOX.WORTOX_NABBAG_DESC"
msgid "You've hung around Krampus enough to create a Knabsack for your own item stealing desires. Packs a punch depending on how full your inventory is."
msgstr "Vous avez passé suffisamment de temps avec Krampus pour créer un sac de chipeur et satisfaire vos désirs de voleur. Il peut aussi faire mal si votre inventaire est plein."

#. STRINGS.SKILLTREE.WORTOX.WORTOX_NABBAG_TITLE
msgctxt "STRINGS.SKILLTREE.WORTOX.WORTOX_NABBAG_TITLE"
msgid "Knabsacker"
msgstr "Chipeur à sac"

#. STRINGS.SKILLTREE.WORTOX.WORTOX_NAUGHTY_LOCK_DESC
msgctxt "STRINGS.SKILLTREE.WORTOX.WORTOX_NAUGHTY_LOCK_DESC"
msgid "Requires the skill below and 5 total Naughty and/or Neutral skills to unlock."
msgstr "Nécessite la compétence ci-dessous et 5 compétences totales Méchant et/ou Neutre pour le débloquer."

#. STRINGS.SKILLTREE.WORTOX.WORTOX_NICE_LOCK_DESC
msgctxt "STRINGS.SKILLTREE.WORTOX.WORTOX_NICE_LOCK_DESC"
msgid "Requires the skill below and 5 total Nice and/or Neutral skills to unlock."
msgstr "Nécessite la compétence ci-dessous et 5 compétences totales Gentil et/ou Neutre pour le débloquer."

#. STRINGS.SKILLTREE.WORTOX.WORTOX_PANFLUTE_FORGET_DESC
msgctxt "STRINGS.SKILLTREE.WORTOX.WORTOX_PANFLUTE_FORGET_DESC"
msgid "Things waking up after your Pan Flute playing will not be able to become hostile towards you for a moment."
msgstr "Les créatures qui se réveillent quand vous jouez de la flûte de Pan ne pourront pas vous attaquer pendant un certain temps."

#. STRINGS.SKILLTREE.WORTOX.WORTOX_PANFLUTE_FORGET_TITLE
msgctxt "STRINGS.SKILLTREE.WORTOX.WORTOX_PANFLUTE_FORGET_TITLE"
msgid "Cloudy Carmen"
msgstr "Mélodie protectrice"

#. STRINGS.SKILLTREE.WORTOX.WORTOX_PANFLUTE_PLAYING_DESC
msgctxt "STRINGS.SKILLTREE.WORTOX.WORTOX_PANFLUTE_PLAYING_DESC"
msgid "You periodically feel a musical pull to play your flute. Pan Flutes will not lose durability one time when feeling this urge to play."
msgstr "Vous ressentez régulièrement l'envie de jouer de la flûte. Les flûtes de Pan ne perdront pas de durabilité lorsque ce désir vous prendra (une fois)."

#. STRINGS.SKILLTREE.WORTOX.WORTOX_PANFLUTE_PLAYING_TITLE
msgctxt "STRINGS.SKILLTREE.WORTOX.WORTOX_PANFLUTE_PLAYING_TITLE"
msgid "Impromptu Flautist"
msgstr "Flûtiste impromptu"

#. STRINGS.SKILLTREE.WORTOX.WORTOX_PANFLUTE_SOULCALLER_DESC
msgctxt "STRINGS.SKILLTREE.WORTOX.WORTOX_PANFLUTE_SOULCALLER_DESC"
msgid "Playing your Pan Flute with such pleasing notes will bring lost Souls around for a listen."
msgstr "Jouer des notes si plaisantes à la flûte de Pan attirera une audience d'âmes perdues."

#. STRINGS.SKILLTREE.WORTOX.WORTOX_PANFLUTE_SOULCALLER_TITLE
msgctxt "STRINGS.SKILLTREE.WORTOX.WORTOX_PANFLUTE_SOULCALLER_TITLE"
msgid "Pleasant Pastorale"
msgstr "Pastorale plaisante"

#. STRINGS.SKILLTREE.WORTOX.WORTOX_SOULDECOY_1_DESC
msgctxt "STRINGS.SKILLTREE.WORTOX.WORTOX_SOULDECOY_1_DESC"
msgid "Soul Hopping creates a Soul Decoy to draw the attention of attacking creatures that possess Souls. It will not create one for a Soul Echo."
msgstr "Le saut d'âme crée une âme leurre pour attirer l'attention des créatures hostiles ayant des âmes. N'en créera pas pour un écho d'âme."

#. STRINGS.SKILLTREE.WORTOX.WORTOX_SOULDECOY_1_TITLE
msgctxt "STRINGS.SKILLTREE.WORTOX.WORTOX_SOULDECOY_1_TITLE"
msgid "Soul Decoy I"
msgstr "Âme leurre I"

#. STRINGS.SKILLTREE.WORTOX.WORTOX_SOULDECOY_2_DESC
msgctxt "STRINGS.SKILLTREE.WORTOX.WORTOX_SOULDECOY_2_DESC"
msgid "Soul Decoys will stay around for a bit longer if they are unharmed, and damage the thing that hit the Decoy."
msgstr "Les âmes leurres resteront un peu plus longtemps si elles sont intactes et infligeront des dégâts à la créature qui attaque le leurre."

#. STRINGS.SKILLTREE.WORTOX.WORTOX_SOULDECOY_2_TITLE
msgctxt "STRINGS.SKILLTREE.WORTOX.WORTOX_SOULDECOY_2_TITLE"
msgid "Soul Decoy II"
msgstr "Âme leurre II"

#. STRINGS.SKILLTREE.WORTOX.WORTOX_SOULDECOY_3_DESC
msgctxt "STRINGS.SKILLTREE.WORTOX.WORTOX_SOULDECOY_3_DESC"
msgid "Soul Decoys will now explode and inflict damage on things lured by it or attacking you upon expiration."
msgstr "À leur expiration, les âmes leurres explosent et infligent des dégâts aux créatures qu'elles ont attirées ou qui vous attaquent."

#. STRINGS.SKILLTREE.WORTOX.WORTOX_SOULDECOY_3_TITLE
msgctxt "STRINGS.SKILLTREE.WORTOX.WORTOX_SOULDECOY_3_TITLE"
msgid "Soul Decoy III"
msgstr "Âme leurre III"

#. STRINGS.SKILLTREE.WORTOX.WORTOX_SOULJAR_1_DESC
msgctxt "STRINGS.SKILLTREE.WORTOX.WORTOX_SOULJAR_1_DESC"
msgid "Learn how to craft and use a Soul Jar to store Souls for later use.\nSoul Jars will leak Souls over time when not in your inventory."
msgstr "Apprenez à fabriquer et utiliser un pot d'âmes afin de conserver des âmes pour plus tard.\nLes pots d'âmes hors de l'inventaire laissent échapper des âmes au fil du temps."

#. STRINGS.SKILLTREE.WORTOX.WORTOX_SOULJAR_1_TITLE
msgctxt "STRINGS.SKILLTREE.WORTOX.WORTOX_SOULJAR_1_TITLE"
msgid "Soul Jar"
msgstr "Pot d'âmes"

#. STRINGS.SKILLTREE.WORTOX.WORTOX_SOULJAR_2_DESC
msgctxt "STRINGS.SKILLTREE.WORTOX.WORTOX_SOULJAR_2_DESC"
msgid "Holding Soul Jars increases your maximum Souls allowed to be held at once by 5 each, stopping you from overloading of Soul power."
msgstr "Chaque pot d'âmes vous permet de conserver jusqu'à 5 âmes supplémentaires à la fois, ce qui vous évite une surcharge de puissance d'âmes."

#. STRINGS.SKILLTREE.WORTOX.WORTOX_SOULJAR_2_TITLE
msgctxt "STRINGS.SKILLTREE.WORTOX.WORTOX_SOULJAR_2_TITLE"
msgid "Overflowing Greed"
msgstr "Gourmandise débordante"

#. STRINGS.SKILLTREE.WORTOX.WORTOX_SOULJAR_3_DESC
msgctxt "STRINGS.SKILLTREE.WORTOX.WORTOX_SOULJAR_3_DESC"
msgid "Held Souls and Souls inside of Soul Jars increases both the damage of the Knabsack and the damage of Souls, up to 100 total Souls collected."
msgstr "Les âmes que vous détenez et celles en pot augmentent les dégâts du sac de chipeur et des âmes, jusqu'à un total de 100 âmes obtenues."

#. STRINGS.SKILLTREE.WORTOX.WORTOX_SOULJAR_3_TITLE
msgctxt "STRINGS.SKILLTREE.WORTOX.WORTOX_SOULJAR_3_TITLE"
msgid "Covetous Collector"
msgstr "Collectionneur cupide"

#. STRINGS.SKILLTREE.WORTOX.WORTOX_SOULPROTECTOR_1_DESC
msgctxt "STRINGS.SKILLTREE.WORTOX.WORTOX_SOULPROTECTOR_1_DESC"
msgid "Dropped Souls will heal at an increased range."
msgstr "La portée des âmes lâchées augmente."

#. STRINGS.SKILLTREE.WORTOX.WORTOX_SOULPROTECTOR_1_TITLE
msgctxt "STRINGS.SKILLTREE.WORTOX.WORTOX_SOULPROTECTOR_1_TITLE"
msgid "Reaching Souls I"
msgstr "Âmes de contact I"

#. STRINGS.SKILLTREE.WORTOX.WORTOX_SOULPROTECTOR_2_DESC
msgctxt "STRINGS.SKILLTREE.WORTOX.WORTOX_SOULPROTECTOR_2_DESC"
msgid "Dropped Souls will move towards hurt players, and heal at an increased range."
msgstr "Les âmes lâchées s'approchent des joueurs blessés, et les soignent à une portée accrue."

#. STRINGS.SKILLTREE.WORTOX.WORTOX_SOULPROTECTOR_2_TITLE
msgctxt "STRINGS.SKILLTREE.WORTOX.WORTOX_SOULPROTECTOR_2_TITLE"
msgid "Reaching Souls II"
msgstr "Âmes de contact II"

#. STRINGS.SKILLTREE.WORTOX.WORTOX_SOULPROTECTOR_3_DESC
msgctxt "STRINGS.SKILLTREE.WORTOX.WORTOX_SOULPROTECTOR_3_DESC"
msgid "Dropped Souls will do a second healing wave for a lower amount after a delay."
msgstr "Les âmes lâchées effectuent une deuxième vague de soin pour un coût moins élevé après un délai."

#. STRINGS.SKILLTREE.WORTOX.WORTOX_SOULPROTECTOR_3_TITLE
msgctxt "STRINGS.SKILLTREE.WORTOX.WORTOX_SOULPROTECTOR_3_TITLE"
msgid "Soul Bastion I"
msgstr "Bastion des âmes I"

#. STRINGS.SKILLTREE.WORTOX.WORTOX_SOULPROTECTOR_4_DESC
msgctxt "STRINGS.SKILLTREE.WORTOX.WORTOX_SOULPROTECTOR_4_DESC"
msgid "Dropped Souls will move faster towards hurt players, the second healing wave will happen quicker, and Souls are more efficient at healing multiple players."
msgstr "Les âmes lâchées avancent plus vite vers les joueurs blessés, la seconde vague de soin se produit plus tôt et les âmes soignent plusieurs joueurs avec plus d'efficacité."

#. STRINGS.SKILLTREE.WORTOX.WORTOX_SOULPROTECTOR_4_TITLE
msgctxt "STRINGS.SKILLTREE.WORTOX.WORTOX_SOULPROTECTOR_4_TITLE"
msgid "Soul Bastion II"
msgstr "Bastion des âmes II"

#. STRINGS.SKILLTREE.WORTOX.WORTOX_THIEF_1_DESC
msgctxt "STRINGS.SKILLTREE.WORTOX.WORTOX_THIEF_1_DESC"
msgid "Souls are created and attracted to you from further away."
msgstr "Des âmes sont créées et attirées à vous de plus loin."

#. STRINGS.SKILLTREE.WORTOX.WORTOX_THIEF_1_TITLE
msgctxt "STRINGS.SKILLTREE.WORTOX.WORTOX_THIEF_1_TITLE"
msgid "Soul Thief I"
msgstr "Voleur d'âmes I"

#. STRINGS.SKILLTREE.WORTOX.WORTOX_THIEF_2_DESC
msgctxt "STRINGS.SKILLTREE.WORTOX.WORTOX_THIEF_2_DESC"
msgid "Souls will last longer while being attracted to you."
msgstr "Les âmes durent plus longtemps tant qu'elles sont attirées à vous."

#. STRINGS.SKILLTREE.WORTOX.WORTOX_THIEF_2_TITLE
msgctxt "STRINGS.SKILLTREE.WORTOX.WORTOX_THIEF_2_TITLE"
msgid "Soul Thief II"
msgstr "Voleur d'âmes II"

#. STRINGS.SKILLTREE.WORTOX.WORTOX_THIEF_3_DESC
msgctxt "STRINGS.SKILLTREE.WORTOX.WORTOX_THIEF_3_DESC"
msgid "Souls attracted to you will hurt other creatures with Souls along its path."
msgstr "Les âmes attirées à vous infligeront des dégâts aux créatures dotées d'une âme sur leur chemin."

#. STRINGS.SKILLTREE.WORTOX.WORTOX_THIEF_3_TITLE
msgctxt "STRINGS.SKILLTREE.WORTOX.WORTOX_THIEF_3_TITLE"
msgid "Soul Pierce I"
msgstr "Âme blessée I"

#. STRINGS.SKILLTREE.WORTOX.WORTOX_THIEF_4_DESC
msgctxt "STRINGS.SKILLTREE.WORTOX.WORTOX_THIEF_4_DESC"
msgid "Souls attracted to you will repel away initially before coming towards you."
msgstr "Les âmes attirées à vous s'éloigneront d'abord avant de venir vers vous."

#. STRINGS.SKILLTREE.WORTOX.WORTOX_THIEF_4_TITLE
msgctxt "STRINGS.SKILLTREE.WORTOX.WORTOX_THIEF_4_TITLE"
msgid "Soul Pierce II"
msgstr "Âme blessée II"

#. STRINGS.SKILLTREE.WURT.WURT_ALLEGIANCE_LOCK_1_DESC
msgctxt "STRINGS.SKILLTREE.WURT.WURT_ALLEGIANCE_LOCK_1_DESC"
msgid "Learn 12 skills to unlock."
msgstr "Apprenez 12 compétences pour le débloquer."

#. STRINGS.SKILLTREE.WURT.WURT_AMPHIBIAN_HEALING_1_DESC
msgctxt "STRINGS.SKILLTREE.WURT.WURT_AMPHIBIAN_HEALING_1_DESC"
msgid "Slowly regenerate health when wet. The more wet you are, the more health you regenerate."
msgstr "Régénérez lentement la santé grâce à l'humidité. Plus vous avez d'eau sur vous, plus vous régénérez de la santé."

#. STRINGS.SKILLTREE.WURT.WURT_AMPHIBIAN_HEALING_1_TITLE
msgctxt "STRINGS.SKILLTREE.WURT.WURT_AMPHIBIAN_HEALING_1_TITLE"
msgid "Hydrous Healing I"
msgstr "Soin aqueux I"

#. STRINGS.SKILLTREE.WURT.WURT_AMPHIBIAN_HEALING_2_DESC
msgctxt "STRINGS.SKILLTREE.WURT.WURT_AMPHIBIAN_HEALING_2_DESC"
msgid "Regenerate health when wet more effectively. It also make you slowly get wet as you step through the corrupted or mutated marsh turfs."
msgstr "Régénérez mieux la santé grâce à l'eau. Vous trempe petit à petit lorsque vous traversez des marécages corrompus ou mutants."

#. STRINGS.SKILLTREE.WURT.WURT_AMPHIBIAN_HEALING_2_TITLE
msgctxt "STRINGS.SKILLTREE.WURT.WURT_AMPHIBIAN_HEALING_2_TITLE"
msgid "Hydrous Healing II"
msgstr "Soin aqueux II"

#. STRINGS.SKILLTREE.WURT.WURT_AMPHIBIAN_SANITY_1_DESC
msgctxt "STRINGS.SKILLTREE.WURT.WURT_AMPHIBIAN_SANITY_1_DESC"
msgid "Restore some sanity over time when wet. The more wet you are, the more sanity you restore."
msgstr "Restaurez un peu de santé mentale grâce à l'eau. Plus vous avez d'eau sur vous, plus vous régénérez de santé mentale."

#. STRINGS.SKILLTREE.WURT.WURT_AMPHIBIAN_SANITY_1_TITLE
msgctxt "STRINGS.SKILLTREE.WURT.WURT_AMPHIBIAN_SANITY_1_TITLE"
msgid "Mental Fluidity I"
msgstr "Fluidité mentale I"

#. STRINGS.SKILLTREE.WURT.WURT_AMPHIBIAN_SANITY_2_DESC
msgctxt "STRINGS.SKILLTREE.WURT.WURT_AMPHIBIAN_SANITY_2_DESC"
msgid "Restore a fair amount of sanity over time when wet."
msgstr "Restaurez une bonne quantité de santé mentale au fil du temps grâce à l'eau."

#. STRINGS.SKILLTREE.WURT.WURT_AMPHIBIAN_SANITY_2_TITLE
msgctxt "STRINGS.SKILLTREE.WURT.WURT_AMPHIBIAN_SANITY_2_TITLE"
msgid "Mental Fluidity II"
msgstr "Fluidité mentale II"

#. STRINGS.SKILLTREE.WURT.WURT_AMPHIBIAN_TEMPERATURE_DESC
msgctxt "STRINGS.SKILLTREE.WURT.WURT_AMPHIBIAN_TEMPERATURE_DESC"
msgid "Greatly reduce the effect of wetness on body temperature. It also fairly reduces wetness loss due to heat sources."
msgstr "Réduisez considérablement l'effet de l'humidité sur la chaleur corporelle. Réduit également l'humidité perdue à cause des sources de chaleur."

#. STRINGS.SKILLTREE.WURT.WURT_AMPHIBIAN_TEMPERATURE_TITLE
msgctxt "STRINGS.SKILLTREE.WURT.WURT_AMPHIBIAN_TEMPERATURE_TITLE"
msgid "All-Weather Scales"
msgstr "Écailles thermiques"

#. STRINGS.SKILLTREE.WURT.WURT_AMPHIBIAN_THICKSKIN_1_DESC
msgctxt "STRINGS.SKILLTREE.WURT.WURT_AMPHIBIAN_THICKSKIN_1_DESC"
msgid "Use wetness as protection. Damage will consume wetness instead of health."
msgstr "Utilisez l'humidité en tant que protection. Les dégâts consommeront l'humidité au lieu de la santé."

#. STRINGS.SKILLTREE.WURT.WURT_AMPHIBIAN_THICKSKIN_1_TITLE
msgctxt "STRINGS.SKILLTREE.WURT.WURT_AMPHIBIAN_THICKSKIN_1_TITLE"
msgid "Slippery Hide I"
msgstr "Peau glissante I"

#. STRINGS.SKILLTREE.WURT.WURT_AMPHIBIAN_THICKSKIN_2_DESC
msgctxt "STRINGS.SKILLTREE.WURT.WURT_AMPHIBIAN_THICKSKIN_2_DESC"
msgid "Use wetness as protection more effectively. It also make you slowly get wet as you step through the corrupted or mutated marsh turfs."
msgstr "Utilisez mieux l'humidité en tant que protection. Vous trempe petit à petit lorsque vous traversez des marécages corrompus ou mutants."

#. STRINGS.SKILLTREE.WURT.WURT_AMPHIBIAN_THICKSKIN_2_TITLE
msgctxt "STRINGS.SKILLTREE.WURT.WURT_AMPHIBIAN_THICKSKIN_2_TITLE"
msgid "Slippery Hide II"
msgstr "Peau glissante II"

#. STRINGS.SKILLTREE.WURT.WURT_CIV_1_2_DESC
msgctxt "STRINGS.SKILLTREE.WURT.WURT_CIV_1_2_DESC"
msgid "Learn to craft the Superior Communal Kelp Dish, it holds more kelp for even faster merm growth and calling in merms for action."
msgstr "Apprenez à fabriquer le plat de varech communautaire supérieur, qui contient plus de varech pour développer les merms et les appeler encore plus rapidement."

#. STRINGS.SKILLTREE.WURT.WURT_CIV_1_2_TITLE
msgctxt "STRINGS.SKILLTREE.WURT.WURT_CIV_1_2_TITLE"
msgid "Community Feeder II"
msgstr "Mangeoire communautaire II"

#. STRINGS.SKILLTREE.WURT.WURT_CIV_1_DESC
msgctxt "STRINGS.SKILLTREE.WURT.WURT_CIV_1_DESC"
msgid "Learn to craft the Communal Kelp Dish to entice faster merm growth and to call in merms for action."
msgstr "Apprenez à fabriquer le plat de varech communautaire pour inciter la croissance des merms et les appeler à l'action."

#. STRINGS.SKILLTREE.WURT.WURT_CIV_1_TITLE
msgctxt "STRINGS.SKILLTREE.WURT.WURT_CIV_1_TITLE"
msgid "Community Feeder I"
msgstr "Mangeoire communautaire I"

#. STRINGS.SKILLTREE.WURT.WURT_CIV_2_2_DESC
msgctxt "STRINGS.SKILLTREE.WURT.WURT_CIV_2_2_DESC"
msgid "Learn to craft the Slightly Less Shoddy Tool shed, it provides Slightly Less Shoddy Tools."
msgstr "Apprenez à fabriquer la cabane à outils légèrement moins bâclée, qui fournit des outils légèrement moins bâclés."

#. STRINGS.SKILLTREE.WURT.WURT_CIV_2_2_TITLE
msgctxt "STRINGS.SKILLTREE.WURT.WURT_CIV_2_2_TITLE"
msgid "Industrious Merm II"
msgstr "Merm travailleur II"

#. STRINGS.SKILLTREE.WURT.WURT_CIV_2_DESC
msgctxt "STRINGS.SKILLTREE.WURT.WURT_CIV_2_DESC"
msgid "Learn to craft the Shoddy Tool Shed to equip your merm workers with Shoddy Tools."
msgstr "Apprenez à fabriquer la cabane à outils bâclée pour équiper vos travailleurs merms avec des outils bâclés."

#. STRINGS.SKILLTREE.WURT.WURT_CIV_2_TITLE
msgctxt "STRINGS.SKILLTREE.WURT.WURT_CIV_2_TITLE"
msgid "Industrious Merm I"
msgstr "Merm travailleur I"

#. STRINGS.SKILLTREE.WURT.WURT_CIV_3_2_DESC
msgctxt "STRINGS.SKILLTREE.WURT.WURT_CIV_3_2_DESC"
msgid "Learn to craft the Superior Armermry, it provides Swamp Warrior Helmets."
msgstr "Apprenez à fabriquer l'armermerie supérieure, qui fournit des casques de guerrier du marécage."

#. STRINGS.SKILLTREE.WURT.WURT_CIV_3_2_TITLE
msgctxt "STRINGS.SKILLTREE.WURT.WURT_CIV_3_2_TITLE"
msgid "Hardheaded II"
msgstr "Tête dure II"

#. STRINGS.SKILLTREE.WURT.WURT_CIV_3_DESC
msgctxt "STRINGS.SKILLTREE.WURT.WURT_CIV_3_DESC"
msgid "Learn to craft the Armermry to equip your Loyal Merm Guards with Swamp Brawler Helmets."
msgstr "Apprenez à fabriquer l'armermerie pour équiper vos gardes merms loyaux avec des casques de bagarreur du marécage."

#. STRINGS.SKILLTREE.WURT.WURT_CIV_3_TITLE
msgctxt "STRINGS.SKILLTREE.WURT.WURT_CIV_3_TITLE"
msgid "Hardheaded I"
msgstr "Tête dure I"

#. STRINGS.SKILLTREE.WURT.WURT_LUNAR_ALLEGIANCE_1_DESC
msgctxt "STRINGS.SKILLTREE.WURT.WURT_LUNAR_ALLEGIANCE_1_DESC"
msgid "Grant your loyal merms the wondrous gift of Lunar mutation by feeding them Moon Shards.\nEmpower your mutant merms with Planar power using Pure Brilliance."
msgstr "Octroie le merveilleux cadeau de la mutation lunaire à vos fidèles merms en leur donnant des éclats de lune.\nRenforcez votre merm mutant avec une puissance planaire grâce à la lumière pure."

#. STRINGS.SKILLTREE.WURT.WURT_LUNAR_ALLEGIANCE_1_TITLE
msgctxt "STRINGS.SKILLTREE.WURT.WURT_LUNAR_ALLEGIANCE_1_TITLE"
msgid "Lunar Mutated Merm"
msgstr "Merm mutant lunaire"

#. STRINGS.SKILLTREE.WURT.WURT_LUNAR_ALLEGIANCE_2_DESC
msgctxt "STRINGS.SKILLTREE.WURT.WURT_LUNAR_ALLEGIANCE_2_DESC"
msgid "Morph any piece of land into sweet sweet Marsh."
msgstr "Transformez une parcelle de terre en superbe marécage."

#. STRINGS.SKILLTREE.WURT.WURT_LUNAR_ALLEGIANCE_2_TITLE
msgctxt "STRINGS.SKILLTREE.WURT.WURT_LUNAR_ALLEGIANCE_2_TITLE"
msgid "Terra Mutation"
msgstr "Mutation du terrain"

#. STRINGS.SKILLTREE.WURT.WURT_MERMKINGCROWN_DESC
msgctxt "STRINGS.SKILLTREE.WURT.WURT_MERMKINGCROWN_DESC"
msgid "Gift him a crown worn by kings long passed, and your merms will fight smarter so their lives may last."
msgstr "Offrez-lui une couronne portée par les rois d'antan, et vos merms combattront plus intelligemment pour vivre plus longtemps."

#. STRINGS.SKILLTREE.WURT.WURT_MERMKINGCROWN_TITLE
msgctxt "STRINGS.SKILLTREE.WURT.WURT_MERMKINGCROWN_TITLE"
msgid "The King's Crown Quest"
msgstr "La quête de la couronne du roi"

#. STRINGS.SKILLTREE.WURT.WURT_MERMKINGSHOULDERS_DESC
msgctxt "STRINGS.SKILLTREE.WURT.WURT_MERMKINGSHOULDERS_DESC"
msgid "Add stony armor to the King's statuesque shoulders for greater stoutness in your merm soldiers."
msgstr "Ajoutez une armure rocailleuse aux épaules sculpturales du roi pour encourager vos soldats merms."

#. STRINGS.SKILLTREE.WURT.WURT_MERMKINGSHOULDERS_TITLE
msgctxt "STRINGS.SKILLTREE.WURT.WURT_MERMKINGSHOULDERS_TITLE"
msgid "The King's Pauldron Quest"
msgstr "La quête de l'épaulière du roi"

#. STRINGS.SKILLTREE.WURT.WURT_MERMKINGTRIDENT_DESC
msgctxt "STRINGS.SKILLTREE.WURT.WURT_MERMKINGTRIDENT_DESC"
msgid "Offer this weapon best wielded at sea, and your merms will attack with the deftness of three."
msgstr "Offrez cette arme adaptée aux combats en mer, et vos merms attaqueront avec trois fois plus d'efficacité."

#. STRINGS.SKILLTREE.WURT.WURT_MERMKINGTRIDENT_TITLE
msgctxt "STRINGS.SKILLTREE.WURT.WURT_MERMKINGTRIDENT_TITLE"
msgid "The King's Trident Quest"
msgstr "La quête du trident du roi"

#. STRINGS.SKILLTREE.WURT.WURT_MERM_FLEE_DESC
msgctxt "STRINGS.SKILLTREE.WURT.WURT_MERM_FLEE_DESC"
msgid "Merm Guards will retreat from combat when low on health, and wait to be healed."
msgstr "Les gardes merms battront en retraite lorsque leur santé est basse, et attendront d'être soignés."

#. STRINGS.SKILLTREE.WURT.WURT_MERM_FLEE_TITLE
msgctxt "STRINGS.SKILLTREE.WURT.WURT_MERM_FLEE_TITLE"
msgid "Sensible Swamp Fighter"
msgstr "Combattant raisonnable du marécage"

#. STRINGS.SKILLTREE.WURT.WURT_MERM_KING_HUNGER_1_DESC
msgctxt "STRINGS.SKILLTREE.WURT.WURT_MERM_KING_HUNGER_1_DESC"
msgid "Increase the Merm King's maximum hunger."
msgstr "Augmentez la faim maximale du roi merm."

#. STRINGS.SKILLTREE.WURT.WURT_MERM_KING_HUNGER_1_TITLE
msgctxt "STRINGS.SKILLTREE.WURT.WURT_MERM_KING_HUNGER_1_TITLE"
msgid "Sated Sovereign I"
msgstr "Souverain rassasié I"

#. STRINGS.SKILLTREE.WURT.WURT_MERM_KING_HUNGER_2_DESC
msgctxt "STRINGS.SKILLTREE.WURT.WURT_MERM_KING_HUNGER_2_DESC"
msgid "Increase the Merm King's maximum hunger even more."
msgstr "Augmentez encore plus la faim maximale du roi merm."

#. STRINGS.SKILLTREE.WURT.WURT_MERM_KING_HUNGER_2_TITLE
msgctxt "STRINGS.SKILLTREE.WURT.WURT_MERM_KING_HUNGER_2_TITLE"
msgid "Sated Sovereign II"
msgstr "Souverain rassasié II"

#. STRINGS.SKILLTREE.WURT.WURT_MERM_KING_HUNGER_3_DESC
msgctxt "STRINGS.SKILLTREE.WURT.WURT_MERM_KING_HUNGER_3_DESC"
msgid "Slow the Merm King's digestion, so he takes longer to get hungry."
msgstr "Ralentissez la digestion du roi merm pour qu'il mette plus de temps à avoir faim."

#. STRINGS.SKILLTREE.WURT.WURT_MERM_KING_HUNGER_3_TITLE
msgctxt "STRINGS.SKILLTREE.WURT.WURT_MERM_KING_HUNGER_3_TITLE"
msgid "Sated Sovereign III"
msgstr "Souverain rassasié III"

#. STRINGS.SKILLTREE.WURT.WURT_MOSQUITO_CRAFT_1_DESC
msgctxt "STRINGS.SKILLTREE.WURT.WURT_MOSQUITO_CRAFT_1_DESC"
msgid "Learn to craft a cuddly buddy making Mosquitoes neutral to you."
msgstr "Apprenez à fabriquer une peluche qui rend les moustiques neutres autour de vous."

#. STRINGS.SKILLTREE.WURT.WURT_MOSQUITO_CRAFT_1_TITLE
msgctxt "STRINGS.SKILLTREE.WURT.WURT_MOSQUITO_CRAFT_1_TITLE"
msgid "Mosquito Incognito"
msgstr "Moustique incognito"

#. STRINGS.SKILLTREE.WURT.WURT_MOSQUITO_CRAFT_2_DESC
msgctxt "STRINGS.SKILLTREE.WURT.WURT_MOSQUITO_CRAFT_2_DESC"
msgid "Learn to craft Mosquito based items: Skeeter Bomb, Fertilizzzer and Blood Shot."
msgstr "Apprenez à fabriquer des objets basés sur les moustiques : la bombe moustique, le fertilizzzant et la piqûre."

#. STRINGS.SKILLTREE.WURT.WURT_MOSQUITO_CRAFT_2_TITLE
msgctxt "STRINGS.SKILLTREE.WURT.WURT_MOSQUITO_CRAFT_2_TITLE"
msgid "Itchcraft I"
msgstr "Moustiquerie I"

#. STRINGS.SKILLTREE.WURT.WURT_MOSQUITO_CRAFT_3_DESC
msgctxt "STRINGS.SKILLTREE.WURT.WURT_MOSQUITO_CRAFT_3_DESC"
msgid "Master the use of the Mosquito based items.\n\nWith the help of Lil' Itchy, catch mosquitos right from the air."
msgstr "Maîtrisez l'utilisation des objets basés sur les moustiques.\n\nGrâce à Sagratte, attrapez les moustiques dans les airs."

#. STRINGS.SKILLTREE.WURT.WURT_MOSQUITO_CRAFT_3_TITLE
msgctxt "STRINGS.SKILLTREE.WURT.WURT_MOSQUITO_CRAFT_3_TITLE"
msgid "Itchcraft II"
msgstr "Moustiquerie II"

#. STRINGS.SKILLTREE.WURT.WURT_PATHFINDER_DESC
msgctxt "STRINGS.SKILLTREE.WURT.WURT_PATHFINDER_DESC"
msgid "Survivors near Wurt will move like her through the Marsh."
msgstr "Les survivants près de Wurt se déplaceront comme elle dans les marais."

#. STRINGS.SKILLTREE.WURT.WURT_PATHFINDER_TITLE
msgctxt "STRINGS.SKILLTREE.WURT.WURT_PATHFINDER_TITLE"
msgid "Swamp Pathfinder"
msgstr "Éclaireuse du marécage"

#. STRINGS.SKILLTREE.WURT.WURT_SHADOW_ALLEGIANCE_1_DESC
msgctxt "STRINGS.SKILLTREE.WURT.WURT_SHADOW_ALLEGIANCE_1_DESC"
msgid "Your merm followers may die, but their shadows live on.\nInfuse fallen merms' shadows with Planar power using Pure Horror."
msgstr "Vos adeptes merms peuvent mourir, mais pas leurs ombres.\nInfusez les ombres de merms morts avec une puissance planaire grâce à l'horreur pure."

#. STRINGS.SKILLTREE.WURT.WURT_SHADOW_ALLEGIANCE_1_TITLE
msgctxt "STRINGS.SKILLTREE.WURT.WURT_SHADOW_ALLEGIANCE_1_TITLE"
msgid "Shadow Resurrection Merm"
msgstr "Merm ressuscité des ombres"

#. STRINGS.SKILLTREE.WURT.WURT_SHADOW_ALLEGIANCE_2_DESC
msgctxt "STRINGS.SKILLTREE.WURT.WURT_SHADOW_ALLEGIANCE_2_DESC"
msgid "No land shall be safe from the dark and beautiful corruption of the Marsh."
msgstr "Aucune terre n'échappera à la corruption belle et sombre du marais."

#. STRINGS.SKILLTREE.WURT.WURT_SHADOW_ALLEGIANCE_2_TITLE
msgctxt "STRINGS.SKILLTREE.WURT.WURT_SHADOW_ALLEGIANCE_2_TITLE"
msgid "Terra Corruption"
msgstr "Corruption du terrain"

#. STRINGS.SKILLTREE.WX78.WX78_ALLEGIANCE_LUNAR_DESC
msgctxt "STRINGS.SKILLTREE.WX78.WX78_ALLEGIANCE_LUNAR_DESC"
msgid "Using \"borrowed\" technology from the Cryptic Founder, allow Gestalts to possess your Backup Chassis and become your spectrobotic minions."
msgstr "Utilise de la technologie « empruntée » à l'énigmatique fondateur. Permet aux gestalts de posséder votre châssis de rechange et de devenir votre assistant spectrobotique."

#. STRINGS.SKILLTREE.WX78.WX78_ALLEGIANCE_LUNAR_TITLE
msgctxt "STRINGS.SKILLTREE.WX78.WX78_ALLEGIANCE_LUNAR_TITLE"
msgid "Lunar Vessel"
msgstr "Réceptacle lunaire"

#. STRINGS.SKILLTREE.WX78.WX78_ALLEGIANCE_SHADOW_DESC
msgctxt "STRINGS.SKILLTREE.WX78.WX78_ALLEGIANCE_SHADOW_DESC"
msgid "Allows insertion of select shadow components into your circuitry, granting your Chassis various abilities in both inhabited and uninhabited states."
msgstr "Permet l'insertion de certains composants d'ombre dans vos circuits, octroyant diverses capacités à votre châssis, qu'il soit habité ou non."

#. STRINGS.SKILLTREE.WX78.WX78_ALLEGIANCE_SHADOW_TITLE
msgctxt "STRINGS.SKILLTREE.WX78.WX78_ALLEGIANCE_SHADOW_TITLE"
msgid "Shadow Servitor"
msgstr "Serviteur d'ombre"

#. STRINGS.SKILLTREE.WX78.WX78_ALPHA_CIRCUIT_BUFFS_1_DESC
msgctxt "STRINGS.SKILLTREE.WX78.WX78_ALPHA_CIRCUIT_BUFFS_1_DESC"
msgid "Processing Circuits gain a new effect in addition to their original effect. Gastrogain Circuits are boosted."
msgstr "Les circuits processeurs obtiennent un nouvel effet en plus de leur effet d'origine. Les circuits morfals sont boostés."

#. STRINGS.SKILLTREE.WX78.WX78_ALPHA_CIRCUIT_BUFFS_1_TITLE
msgctxt "STRINGS.SKILLTREE.WX78.WX78_ALPHA_CIRCUIT_BUFFS_1_TITLE"
msgid "Alpha Circuits Tinkering I"
msgstr "Bricolage de circuits alpha I"

#. STRINGS.SKILLTREE.WX78.WX78_ALPHA_CIRCUIT_BUFFS_2_DESC
msgctxt "STRINGS.SKILLTREE.WX78.WX78_ALPHA_CIRCUIT_BUFFS_2_DESC"
msgid "Hardy Circuits, Processing Circuits, and Beanbooster Circuit gain a new effect in addition to their original effect. Gastrogain Circuits are boosted."
msgstr "Les circuits robustes, les circuits processeurs et le circuit restauration obtiennent un nouvel effet en plus de leur effet d'origine. Les circuits morfals sont boostés."

#. STRINGS.SKILLTREE.WX78.WX78_ALPHA_CIRCUIT_BUFFS_2_TITLE
msgctxt "STRINGS.SKILLTREE.WX78.WX78_ALPHA_CIRCUIT_BUFFS_2_TITLE"
msgid "Alpha Circuits Tinkering II"
msgstr "Bricolage de circuits alpha II"

#. STRINGS.SKILLTREE.WX78.WX78_BETA_CIRCUIT_BUFFS_1_DESC
msgctxt "STRINGS.SKILLTREE.WX78.WX78_BETA_CIRCUIT_BUFFS_1_DESC"
msgid "Thermal Circuit, Refrigerant Circuit, Optoelectronic Circuit, Chorusbox Circuit, and Rangebooster Circuit gain a new effect in addition to their original effect."
msgstr "Le circuit thermique, le circuit réfrigérant, le circuit optiélectronique, le circuit concerto et le circuit portée améliorée obtiennent un nouvel effet en plus de leur effet d'origine."

#. STRINGS.SKILLTREE.WX78.WX78_BETA_CIRCUIT_BUFFS_1_TITLE
msgctxt "STRINGS.SKILLTREE.WX78.WX78_BETA_CIRCUIT_BUFFS_1_TITLE"
msgid "Beta Circuits Tinkering I"
msgstr "Bricolage de circuits bêta I"

#. STRINGS.SKILLTREE.WX78.WX78_BETA_CIRCUIT_BUFFS_2_DESC
msgctxt "STRINGS.SKILLTREE.WX78.WX78_BETA_CIRCUIT_BUFFS_2_DESC"
msgid "Acceleration Circuits, Electrification Circuit, and Illumination Circuits gain a new effect in addition to their original effect."
msgstr "Les circuits accélération, le circuit électrification et les circuits lumineux obtiennent un nouvel effet en plus de leur effet d'origine."

#. STRINGS.SKILLTREE.WX78.WX78_BETA_CIRCUIT_BUFFS_2_TITLE
msgctxt "STRINGS.SKILLTREE.WX78.WX78_BETA_CIRCUIT_BUFFS_2_TITLE"
msgid "Beta Circuits Tinkering II"
msgstr "Bricolage de circuits bêta II"

#. STRINGS.SKILLTREE.WX78.WX78_BETTER_CHARGE_DESC
msgctxt "STRINGS.SKILLTREE.WX78.WX78_BETTER_CHARGE_DESC"
msgid "Passive charge regeneration is much faster, and lose one less charge when unplugging a charged circuit with two or more slots."
msgstr "La régénération de charge passive est beaucoup plus rapide. Vous perdez une charge en moins lorsque vous débranchez un circuit chargé avec deux emplacements ou plus."

#. STRINGS.SKILLTREE.WX78.WX78_BETTER_CHARGE_TITLE
msgctxt "STRINGS.SKILLTREE.WX78.WX78_BETTER_CHARGE_TITLE"
msgid "Watts Up"
msgstr "Pile électrique"

#. STRINGS.SKILLTREE.WX78.WX78_BETTER_UNPLUG_DESC
msgctxt "STRINGS.SKILLTREE.WX78.WX78_BETTER_UNPLUG_DESC"
msgid "Gain the ability to unplug any circuit in the bar stack, and circuits will lose half the usual amount of durability when unplugged."
msgstr "Obtenez la capacité de décharger un circuit dans la pile de barres. Les circuits perdront la moitié de la durabilité habituelle lorsqu'ils sont débranchés."

#. STRINGS.SKILLTREE.WX78.WX78_BETTER_UNPLUG_TITLE
msgctxt "STRINGS.SKILLTREE.WX78.WX78_BETTER_UNPLUG_TITLE"
msgid "Right To Modify"
msgstr "Personnalisation"

#. STRINGS.SKILLTREE.WX78.WX78_BODYCIRCUITS_DESC
msgctxt "STRINGS.SKILLTREE.WX78.WX78_BODYCIRCUITS_DESC"
msgid "Backup Chassis keep their Beta Circuits active even when powered down."
msgstr "Les châssis de rechange conservent leurs circuits bêta même lorsqu'ils ne sont pas alimentés."

#. STRINGS.SKILLTREE.WX78.WX78_BODYCIRCUITS_TITLE
msgctxt "STRINGS.SKILLTREE.WX78.WX78_BODYCIRCUITS_TITLE"
msgid "Warm Standby"
msgstr "Veille active"

#. STRINGS.SKILLTREE.WX78.WX78_CIRCUITRY_SLOT_1_DESC
msgctxt "STRINGS.SKILLTREE.WX78.WX78_CIRCUITRY_SLOT_1_DESC"
msgid "Grant an additional slot to all of your circuit bars."
msgstr "Octroie un emplacement supplémentaire à toutes vos barres de circuit."

#. STRINGS.SKILLTREE.WX78.WX78_CIRCUITRY_SLOT_1_TITLE
msgctxt "STRINGS.SKILLTREE.WX78.WX78_CIRCUITRY_SLOT_1_TITLE"
msgid "Off By One"
msgstr "À un près"

#. STRINGS.SKILLTREE.WX78.WX78_DELIVERYDRONE_1_DESC
msgctxt "STRINGS.SKILLTREE.WX78.WX78_DELIVERYDRONE_1_DESC"
msgid "Learn to craft a Portable Storage Unit to send items to any mapped location."
msgstr "Apprenez à fabriquer une unité de stockage portative pour envoyer des objets vers n'importe quel emplacement cartographié."

#. STRINGS.SKILLTREE.WX78.WX78_DELIVERYDRONE_1_TITLE
msgctxt "STRINGS.SKILLTREE.WX78.WX78_DELIVERYDRONE_1_TITLE"
msgid "Transport I"
msgstr "Transport I"

#. STRINGS.SKILLTREE.WX78.WX78_DELIVERYDRONE_2_DESC
msgctxt "STRINGS.SKILLTREE.WX78.WX78_DELIVERYDRONE_2_DESC"
msgid "Learn to craft a larger Portable Storage Unit."
msgstr "Apprenez à fabriquer une plus grande unité de stockage portative."

#. STRINGS.SKILLTREE.WX78.WX78_DELIVERYDRONE_2_TITLE
msgctxt "STRINGS.SKILLTREE.WX78.WX78_DELIVERYDRONE_2_TITLE"
msgid "Transport II"
msgstr "Transport II"

#. STRINGS.SKILLTREE.WX78.WX78_EXTRABODY_1_DESC
msgctxt "STRINGS.SKILLTREE.WX78.WX78_EXTRABODY_1_DESC"
msgid "Learn to craft a reliable Backup Chassis."
msgstr "Apprenez à fabriquer un châssis de rechange fiable."

#. STRINGS.SKILLTREE.WX78.WX78_EXTRABODY_1_TITLE
msgctxt "STRINGS.SKILLTREE.WX78.WX78_EXTRABODY_1_TITLE"
msgid "Cold Standby I"
msgstr "Veille froide I"

#. STRINGS.SKILLTREE.WX78.WX78_EXTRABODY_2_DESC
msgctxt "STRINGS.SKILLTREE.WX78.WX78_EXTRABODY_2_DESC"
msgid "Build up to two Backup Chassis."
msgstr "Fabriquez jusqu'à deux châssis de rechange."

#. STRINGS.SKILLTREE.WX78.WX78_EXTRABODY_2_TITLE
msgctxt "STRINGS.SKILLTREE.WX78.WX78_EXTRABODY_2_TITLE"
msgid "Cold Standby II"
msgstr "Veille froide II"

#. STRINGS.SKILLTREE.WX78.WX78_EXTRABODY_3_DESC
msgctxt "STRINGS.SKILLTREE.WX78.WX78_EXTRABODY_3_DESC"
msgid "Build up to three Backup Chassis."
msgstr "Fabriquez jusqu'à trois châssis de rechange."

#. STRINGS.SKILLTREE.WX78.WX78_EXTRABODY_3_TITLE
msgctxt "STRINGS.SKILLTREE.WX78.WX78_EXTRABODY_3_TITLE"
msgid "Cold Standby III"
msgstr "Veille froide III"

#. STRINGS.SKILLTREE.WX78.WX78_EXTRADRONERANGE_DESC
msgctxt "STRINGS.SKILLTREE.WX78.WX78_EXTRADRONERANGE_DESC"
msgid "Expands the Bio Scanalyzer's scan radius, and extends the range of the Roto-Mapper, Zaptrocuter, Auto-Grabber, and Exploiterator."
msgstr "Agrandit le rayon de scan du scanalyseur biologique et la portée du roto-traceur, de l'électrozappeur, du récupérateur automatique et de l'exploitateur."

#. STRINGS.SKILLTREE.WX78.WX78_EXTRADRONERANGE_TITLE
msgctxt "STRINGS.SKILLTREE.WX78.WX78_EXTRADRONERANGE_TITLE"
msgid "Signal Booster"
msgstr "Booster de signal"

#. STRINGS.SKILLTREE.WX78.WX78_GAMMA_CIRCUIT_BUFFS_1_DESC
msgctxt "STRINGS.SKILLTREE.WX78.WX78_GAMMA_CIRCUIT_BUFFS_1_DESC"
msgid "Chessmaster Circuit, Redigestion Circuit, and Sonic-Invoker Circuit gain a new effect in addition to their original effect."
msgstr "Le circuit maître des échecs, le circuit redigestion et le circuit invocation sonore obtiennent un nouvel effet en plus de leur effet d'origine."

#. STRINGS.SKILLTREE.WX78.WX78_GAMMA_CIRCUIT_BUFFS_1_TITLE
msgctxt "STRINGS.SKILLTREE.WX78.WX78_GAMMA_CIRCUIT_BUFFS_1_TITLE"
msgid "Gamma Circuits Tinkering I"
msgstr "Bricolage de circuits gamma I"

#. STRINGS.SKILLTREE.WX78.WX78_GAMMA_CIRCUIT_BUFFS_2_DESC
msgctxt "STRINGS.SKILLTREE.WX78.WX78_GAMMA_CIRCUIT_BUFFS_2_DESC"
msgid "Blocking Circuit and Spin-Cycle Circuit gain a new effect in addition to their original effect."
msgstr "Le circuit blocage et le circuit tourbillon obtiennent un nouvel effet en plus de leur effet d'origine."

#. STRINGS.SKILLTREE.WX78.WX78_GAMMA_CIRCUIT_BUFFS_2_TITLE
msgctxt "STRINGS.SKILLTREE.WX78.WX78_GAMMA_CIRCUIT_BUFFS_2_TITLE"
msgid "Gamma Circuits Tinkering II"
msgstr "Bricolage de circuits gamma II"

#. STRINGS.SKILLTREE.WX78.WX78_GHOSTREVIVE_1_DESC
msgctxt "STRINGS.SKILLTREE.WX78.WX78_GHOSTREVIVE_1_DESC"
msgid "Haunting a Backup Chassis transfers your consciousness into it, consuming all of the chassis' charge units."
msgstr "Hanter un châssis de rechange transfère votre conscience dans celui-ci et consomme toutes les unités de charge du châssis."

#. STRINGS.SKILLTREE.WX78.WX78_GHOSTREVIVE_1_TITLE
msgctxt "STRINGS.SKILLTREE.WX78.WX78_GHOSTREVIVE_1_TITLE"
msgid "Inhabited Machine I"
msgstr "Machine habitée I"

#. STRINGS.SKILLTREE.WX78.WX78_GHOSTREVIVE_2_DESC
msgctxt "STRINGS.SKILLTREE.WX78.WX78_GHOSTREVIVE_2_DESC"
msgid "If you die with full charge and have not yet reached your maximum number of Backup Chassis, one is left behind."
msgstr "Si vous mourez avec une charge complète et n'avez pas encore atteint le nombre maximum de châssis de rechange, l'un d'entre eux est conservé."

#. STRINGS.SKILLTREE.WX78.WX78_GHOSTREVIVE_2_TITLE
msgctxt "STRINGS.SKILLTREE.WX78.WX78_GHOSTREVIVE_2_TITLE"
msgid "Inhabited Machine II"
msgstr "Machine habitée II"

#. STRINGS.SKILLTREE.WX78.WX78_GHOSTREVIVE_3_DESC
msgctxt "STRINGS.SKILLTREE.WX78.WX78_GHOSTREVIVE_3_DESC"
msgid "Reviving with a Backup Chassis fully restores your health."
msgstr "Être réanimé avec un châssis de rechange restaure complètement votre vie."

#. STRINGS.SKILLTREE.WX78.WX78_GHOSTREVIVE_3_TITLE
msgctxt "STRINGS.SKILLTREE.WX78.WX78_GHOSTREVIVE_3_TITLE"
msgid "Inhabited Machine III"
msgstr "Machine habitée III"

#. STRINGS.SKILLTREE.WX78.WX78_LUNAR_ALLEGIANCE_LOCK_1_DESC
msgctxt "STRINGS.SKILLTREE.WX78.WX78_LUNAR_ALLEGIANCE_LOCK_1_DESC"
msgid "Find and defeat the Celestial Champion.\nHave no shadow affinity.\nBe able to craft a Backup Chassis."
msgstr "Trouvez et éliminez le Champion céleste.\nN'ayez aucune affinité obscure.\nSoyez capable de fabriquer un châssis de rechange."

#. STRINGS.SKILLTREE.WX78.WX78_REMOTEBODYSWAP_DESC
msgctxt "STRINGS.SKILLTREE.WX78.WX78_REMOTEBODYSWAP_DESC"
msgid "Remotely Transfer Consciousness to any Backup Chassis on the map."
msgstr "Transférez votre conscience à distance vers n'importe quel châssis de rechange sur la carte."

#. STRINGS.SKILLTREE.WX78.WX78_REMOTEBODYSWAP_TITLE
msgctxt "STRINGS.SKILLTREE.WX78.WX78_REMOTEBODYSWAP_TITLE"
msgid "Remote Transfer"
msgstr "Transfert à distance"

#. STRINGS.SKILLTREE.WX78.WX78_SCOUTDRONE_1_DESC
msgctxt "STRINGS.SKILLTREE.WX78.WX78_SCOUTDRONE_1_DESC"
msgid "Learn to craft a Roto-Mapper to explore and map unknown areas."
msgstr "Apprenez à fabriquer un roto-traceur pour explorer et cartographier des zones inconnues."

#. STRINGS.SKILLTREE.WX78.WX78_SCOUTDRONE_1_TITLE
msgctxt "STRINGS.SKILLTREE.WX78.WX78_SCOUTDRONE_1_TITLE"
msgid "Field Survey"
msgstr "Enquête sur le terrain"

#. STRINGS.SKILLTREE.WX78.WX78_SHADOW_ALLEGIANCE_LOCK_1_DESC
msgctxt "STRINGS.SKILLTREE.WX78.WX78_SHADOW_ALLEGIANCE_LOCK_1_DESC"
msgid "Find and defeat the Ancient Fuelweaver.\nHave no lunar affinity.\nBe able to craft a Backup Chassis."
msgstr "Trouvez et éliminez l'Ancien trameur d'essence.\nN'ayez aucune affinité lunaire.\nSoyez capable de fabriquer un châssis de rechange."

#. STRINGS.SKILLTREE.WX78.WX78_ZAPDRONE_1_DESC
msgctxt "STRINGS.SKILLTREE.WX78.WX78_ZAPDRONE_1_DESC"
msgid "Learn to craft a Zaptrocuter to zap enemies remotely."
msgstr "Apprenez à fabriquer un électrozappeur pour électrocuter les ennemis à distance."

#. STRINGS.SKILLTREE.WX78.WX78_ZAPDRONE_1_TITLE
msgctxt "STRINGS.SKILLTREE.WX78.WX78_ZAPDRONE_1_TITLE"
msgid "Telemechanical Enthusiast I"
msgstr "Amateur télémécanique I"

#. STRINGS.SKILLTREE.WX78.WX78_ZAPDRONE_2_DESC
msgctxt "STRINGS.SKILLTREE.WX78.WX78_ZAPDRONE_2_DESC"
msgid "Learn to craft a Zaptrocuter with greater capacity."
msgstr "Apprenez à fabriquer un électrozappeur avec une meilleure capacité."

#. STRINGS.SKILLTREE.WX78.WX78_ZAPDRONE_2_TITLE
msgctxt "STRINGS.SKILLTREE.WX78.WX78_ZAPDRONE_2_TITLE"
msgid "Telemechanical Enthusiast II"
msgstr "Amateur télémécanique II"

