#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.QUAGMIRE_FOLIAGE_COOKED
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.QUAGMIRE_FOLIAGE_COOKED"
