msgstr "Ah, j'ai trouvé des bananes bien mûres !"

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.BANANAJUICE
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.BANANAJUICE"
