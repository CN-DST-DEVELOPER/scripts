msgstr "C'en est fini."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.YOTH_KNIGHTSHRINE.EMPTY
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.YOTH_KNIGHTSHRINE.EMPTY"
