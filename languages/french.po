msgstr "C'est mangé par les flammes !"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WINONA_TELEPORT_PAD_ITEM.BURNT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WINONA_TELEPORT_PAD_ITEM.BURNT"
msgid "'Twas devoured by Hel's fire!"
msgstr "Dévorée par le feu d'Hel !"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WINONA_TELEPORT_PAD_ITEM.GENERIC
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WINONA_TELEPORT_PAD_ITEM.GENERIC"
msgid "Bring home the spoils of war!"
msgstr "Ramenez les butins de la guerre !"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WINONA_TELEPORT_PAD_ITEM.OFF
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WINONA_TELEPORT_PAD_ITEM.OFF"
msgid "It has no fighting spirit."
msgstr "Elle n'estoy aucune combativité."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WINTERHAT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WINTERHAT"
msgid "Warm, but not suited for combat."
msgstr "Chaud, mais pas idéal pour le combat."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WINTEROMETER.BURNT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WINTEROMETER.BURNT"
msgid "The measuring device has been slain by Loge."
msgstr "L'appareil de mesure s'est fait massacrer par Logi."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WINTEROMETER.GENERIC
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WINTEROMETER.GENERIC"
msgid "If only it measured the heat of battle."
msgstr "S'il pouvait mesurer la température du combat !"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WINTERSFEASTFUEL
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WINTERSFEASTFUEL"
msgid "The essence of Jol!"
msgstr "L'essence de Jöl !"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WINTERSFEASTOVEN.ALMOST_DONE_COOKING
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WINTERSFEASTOVEN.ALMOST_DONE_COOKING"
msgid "The wait is almost at an end."
msgstr "L'attente prendra bientôt fin."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WINTERSFEASTOVEN.COOKING
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WINTERSFEASTOVEN.COOKING"
msgid "Locked in a glorious cooking battle."
msgstr "La bataille d'icelle cuissön fait rage."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WINTERSFEASTOVEN.DISH_READY
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WINTERSFEASTOVEN.DISH_READY"
msgid "At long last, we feast!"
msgstr "Enfin, nöus allöns festöyer !"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WINTERSFEASTOVEN.GENERIC
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WINTERSFEASTOVEN.GENERIC"
msgid "A hearth for cooking a glorious feast!"
msgstr "Un föyer pöur y cuisiner quelque glörieux festin !"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WINTER_FOOD1
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WINTER_FOOD1"
msgid "How dost I free you from the bread, man of ginger??"
msgstr "Comment te libérer du pain, homme de gingembre ?"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WINTER_FOOD2
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WINTER_FOOD2"
msgid "Like a snowflake, it is a gift from the heavens!"
msgstr "Tel un flocon de neige, c'est un cadeau des cieux !"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WINTER_FOOD3
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WINTER_FOOD3"
msgid "T'would look as divine on the tree as in mine mouth!"
msgstr "Ça serait aussi divin sur l'arbre que dans ma bouche !"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WINTER_FOOD4
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WINTER_FOOD4"
msgid "Stay back, foul creation!"
msgstr "N'approche pas, création du Malin !"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WINTER_FOOD5
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WINTER_FOOD5"
msgid "We feast tonight!"
msgstr "Ce soir c'est un festin !"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WINTER_FOOD6
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WINTER_FOOD6"
msgid "'Twas plucked straight from my nightmares!"
msgstr "Ça vient directement de mes cauchemars !"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WINTER_FOOD7
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WINTER_FOOD7"
msgid "Something so foul shall never pass my lips!"
msgstr "Une chose aussi horrible ne passera jamais entre mes lèvres !"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WINTER_FOOD8
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WINTER_FOOD8"
msgid "Warms the soul."
msgstr "Ça réchauffe l'âme."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WINTER_FOOD9
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WINTER_FOOD9"
msgid "Imbibable eggs!"
msgstr "Des œufs à boire !"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WINTER_ORNAMENT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WINTER_ORNAMENT"
msgid "A fragile beauty that must be protected."
msgstr "Une beauté fragile à protéger."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WINTER_ORNAMENTBOSS
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WINTER_ORNAMENTBOSS"
msgid "Tis not a celebration without a good battle!"
msgstr "On ne peut rien fêter sans un bon combat !"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WINTER_ORNAMENTFORGE
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WINTER_ORNAMENTFORGE"
msgid "Hath been forged in fires."
msgstr "Ça a été forgé par le feu."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WINTER_ORNAMENTGORGE
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WINTER_ORNAMENTGORGE"
msgid "It feeds the festive spirit."
msgstr "Ça nourrit l'esprit de la fête."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WINTER_ORNAMENTLIGHT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WINTER_ORNAMENTLIGHT"
msgid "Tis a light enchantment, trapped inside a glass ball."
msgstr "C'est une charmante lumière prisonnière d'une boule de verre."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WINTER_ORNAMENTPEARL
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WINTER_ORNAMENTPEARL"
msgid "Normally I careth not for baubels. But these doth stir my heart most sweetly."
msgstr "Les brimborions ne m'intéressent point. Pourtant icelle-là me réchauffe le cœur."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WINTER_TREE.BURNING
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WINTER_TREE.BURNING"
msgid "Woe! Misery!"
msgstr "Malheur ! Misère !"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WINTER_TREE.BURNT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WINTER_TREE.BURNT"
msgid "Its beauty lives on in our hearts."
msgstr "Sa beauté vit encore dans nos cœurs."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WINTER_TREE.CANDECORATE
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WINTER_TREE.CANDECORATE"
msgid "A majestic pine, worthy of celebration!"
msgstr "Un pin majestueux, qui vaut d'être célébré !"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WINTER_TREE.YOUNG
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WINTER_TREE.YOUNG"
msgid "Grow strong, young one! It is your destiny!"
msgstr "Pousse bien, mon petit ! C'est ton destin !"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WINTER_TREESTAND.BURNT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WINTER_TREESTAND.BURNT"
msgid "Its beauty lives on in our hearts."
msgstr "Sa beauté vit encore dans nos cœurs."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WINTER_TREESTAND.GENERIC
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WINTER_TREESTAND.GENERIC"
msgid "It awaits a grand tree!"
msgstr "Il attend un grand arbre !"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WOBSTER_DEN
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WOBSTER_DEN"
msgid "The lair of the pinchy beasts."
msgstr "La tanière de bestes à pinces."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WOBSTER_MOONGLASS
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WOBSTER_MOONGLASS"
msgid "The little beasties have acquired new armor!"
msgstr "Ces petites bestes önt revêtu une nöuvelle armure !"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WOBSTER_SHELLER
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WOBSTER_SHELLER"
msgid "Have at thee, morsel!"
msgstr "Prends garde, viande !"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WOBSTER_SHELLER_DEAD
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WOBSTER_SHELLER_DEAD"
msgid "Sleep in Valhalla, armored one."
msgstr "Va dormir au Walhalla avec ton armure."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WOBSTER_SHELLER_DEAD_COOKED
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WOBSTER_SHELLER_DEAD_COOKED"
msgid "Your armor hides tasty meat."
msgstr "Ton armure cache une viande savoureuse."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WOBYBIG.1
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WOBYBIG.1"
msgid "Hail, beastie!"
msgstr "Salutatiöns, puissante beste !"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WOBYBIG.2
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WOBYBIG.2"
msgid "Hail, beastie!"
msgstr "Salutatiöns, puissante beste !"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WOBYSMALL.1
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WOBYSMALL.1"
msgid "Wouldst thou like a skritch behind thine ears?"
msgstr "Désires-tu quelques frictiöns derrière tiennes esgöurdes ?"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WOBYSMALL.2
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WOBYSMALL.2"
msgid "Wouldst thou like a skritch behind thine ears?"
msgstr "Désires-tu quelques frictiöns derrière tiennes esgöurdes ?"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WOBY_TREAT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WOBY_TREAT"
msgid "Woby doth deserve all manner of fine victuals and sweetmeats."
msgstr "Woby mérite töutes les victuailles et tous les régals pössibles."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WOLFGANG.ATTACKER
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WOLFGANG.ATTACKER"
msgid "%s packs a punch to rival a frost giant."
msgstr "%s cogne aussi fort qu'un géant des glaces."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WOLFGANG.FIRESTARTER
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WOLFGANG.FIRESTARTER"
msgid "%s seems to have mistakenly fumbled a torch."
msgstr "%s semble avoir laissé tomber une torche par inadvertance."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WOLFGANG.GENERIC
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WOLFGANG.GENERIC"
msgid "Health and strength to you, %s!"
msgstr "Santé et force pour toi, %s !"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WOLFGANG.GHOST
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WOLFGANG.GHOST"
msgid "A valiant warrior should not be wasted. A heart, a heart!"
msgstr "Il ne faut pas gâcher un brave guerrier. Un cœur, un cœur !"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WOLFGANG.MURDERER
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WOLFGANG.MURDERER"
msgid "You will pay for your heinous deeds, brute!"
msgstr "Tu vas payer pour tes actes odieux, brute !"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WOLFGANG.REVIVER
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WOLFGANG.REVIVER"
msgid "%s, son of Magni."
msgstr "%s, fils de Magni."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WOLFGANG_WHISTLE
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WOLFGANG_WHISTLE"
msgid "My ally will get our forces fighting fit!"
msgstr "Mien allié saura forger l'esprit de nostres forces combattantes !"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WONKEY.ATTACKER
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WONKEY.ATTACKER"
msgid "Thou hast revealed thine true nature, beast!"
msgstr "Tu révèles enfin ta vraie nature, sale beste !"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WONKEY.FIRESTARTER
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WONKEY.FIRESTARTER"
msgid "Monkey trickery!"
msgstr "Cesse donc ces singeries !"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WONKEY.GENERIC
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WONKEY.GENERIC"
msgid "Hail, monkey!"
msgstr "Salutations, primate !"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WONKEY.GHOST
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WONKEY.GHOST"
msgid "It seems you have not fared well, beastie."
msgstr "Il semblerait que tu ne t'en sois point sorti, petite beste."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WONKEY.MURDERER
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WONKEY.MURDERER"
msgid "Foul beast! The hunt is on!"
msgstr "Ignoble beste ! Que la chasse commence !"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WONKEY.REVIVER
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WONKEY.REVIVER"
msgid "Thou art a most noble creature."
msgstr "Tu es une créature des plus nobles."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WOODCARVEDHAT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WOODCARVEDHAT"
msgid "A helm of the forest."
msgstr "Un heaume de la forêt."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WOODIE.ATTACKER
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WOODIE.ATTACKER"
msgid "I could fell you like so many trees, %s."
msgstr "Je pourrais te faire tomber comme tant d'arbres, %s."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WOODIE.BEAVER
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WOODIE.BEAVER"
msgid "I did not know %s possessed such power!"
msgstr "J'ignorais que %s était d'une telle puissance !"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WOODIE.BEAVERGHOST
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WOODIE.BEAVERGHOST"
msgid "You went out in a blaze of glory, %s."
msgstr "Tu as disparu dans un éclat de gloire, %s."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WOODIE.FIRESTARTER
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WOODIE.FIRESTARTER"
msgid "Did he mistake \"Loge\" for \"log\"?"
msgstr "A-t-il confondu « rondin » et « Odin » ?"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WOODIE.GENERIC
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WOODIE.GENERIC"
msgid "May Yggdrasil bind us as the nine worlds, %s!"
msgstr "Qu'Yggdrasil nous unisse comme les neuf mondes, %s !"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WOODIE.GHOST
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WOODIE.GHOST"
msgid "The worldtree watches over you, %s."
msgstr "L'Arbre du Monde te surveille, %s."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WOODIE.GOOSE
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WOODIE.GOOSE"
msgid "%s, you've become a fowl beast!"
msgstr "%s, vöus êtes devenu bien vile beste !"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WOODIE.GOOSEGHOST
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WOODIE.GOOSEGHOST"
msgid "Worry not, I won't let you leave for Valhalla looking like that!"
msgstr "Ne vöus en faites pöint, pöint ne vöus laisserai-je partir ainsi au Valhalla !"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WOODIE.MOOSE
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WOODIE.MOOSE"
msgid "By the gods, I mistook you for a jötunn!"
msgstr "Par les dieux, je vöus pris pöur un jötunn !"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WOODIE.MOOSEGHOST
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WOODIE.MOOSEGHOST"
msgid "Never fear, I'll return you to this realm!"
msgstr "N'ayez pöint peur, je vöus ramènerai en ce röyaume !"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WOODIE.MURDERER
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WOODIE.MURDERER"
msgid "By Yggdrasil, I will cut you down!"
msgstr "Par Yggdrasil, je vais te découper !"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WOODIE.REVIVER
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WOODIE.REVIVER"
msgid "%s's heart is as mighty as his beard."
msgstr "%s a le cœur aussi puissant que sa barbe."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WOOD_CHAIR.BURNT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WOOD_CHAIR.BURNT"
msgid "The gods hath no need for chairs."
msgstr "Les dieux n'ont que faire d'une futile chaise."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WOOD_CHAIR.GENERIC
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WOOD_CHAIR.GENERIC"
msgid "A warrior doth not sit."
msgstr "Un véritable guerrier oncques ne s'assied."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WOOD_CHAIR.OCCUPIED
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WOOD_CHAIR.OCCUPIED"
msgid "On your feet, soldier!"
msgstr "Garde à vous, soldat !"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WOOD_TABLE.BURNT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WOOD_TABLE.BURNT"
msgid "The gods need not more tables."
msgstr "Les dieux disposent déjà de bien assez de tables."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WOOD_TABLE.GENERIC
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WOOD_TABLE.GENERIC"
msgid "No sorrier sight than a bare table. Let us plunder!"
msgstr "Nulle chose ne saurait être plus triste qu'une table nue. Place au pillage !"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WOOD_TABLE.HAS_ITEM
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WOOD_TABLE.HAS_ITEM"
msgid "Not the most impressive piece of loot."
msgstr "Ce n'est point le meilleur butin qu'il m'ait été donné de voir."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WORM.DIRT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WORM.DIRT"
msgid "What's under that dirt?"
msgstr "Que cache ce tas de terre ?"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WORM.PLANT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WORM.PLANT"
msgid "I smell a trap."
msgstr "Je sens le piège !"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WORM.WORM
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WORM.WORM"
msgid "A snake beast from the depths!"
msgstr "Une bête serpent des profondeurs !"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WORMHOLE.GENERIC
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WORMHOLE.GENERIC"
msgid "Does it swallow those fallen in battle?"
msgstr "Est-ce qu'il avale ceux qui tombent au combat ?"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WORMHOLE.OPEN
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WORMHOLE.OPEN"
msgid "Its maw welcomes me."
msgstr "Sa gueule m'invite."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WORMHOLE_LIMITED
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WORMHOLE_LIMITED"
msgid "It is sickly and weak."
msgstr "C'est faible et tout maladif."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WORMLIGHT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WORMLIGHT"
msgid "Glowing treasure, I can't resist!"
msgstr "Trésor luisant, je craque !"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WORMLIGHT_LESSER
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WORMLIGHT_LESSER"
msgid "Glow! Glow with all your might!"
msgstr "Brille ! Brille autant que tu peux !"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WORMLIGHT_PLANT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WORMLIGHT_PLANT"
msgid "I smell a trap."
msgstr "Je sens le piège !"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WORMWOOD.ATTACKER
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WORMWOOD.ATTACKER"
msgid "Rumors of %s's terrible act have spread like weeds."
msgstr "L'acte ödieux de %s s'est répandu cömme traînée de pöudre !"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WORMWOOD.FIRESTARTER
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WORMWOOD.FIRESTARTER"
msgid "%s is sure to be scalded by Hel's flames!"
msgstr "%s finira dévöré par les flammes de Hel !"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WORMWOOD.GENERIC
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WORMWOOD.GENERIC"
msgid "Greetings, %s, touched by Yggdrasil!"
msgstr "Salutatiöns, %s, béni par Yggdrasil !"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WORMWOOD.GHOST
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WORMWOOD.GHOST"
msgid "My dear friend hath fallen in battle!"
msgstr "Mön cher ami a été vaincu en cömbat !"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WORMWOOD.MURDERER
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WORMWOOD.MURDERER"
msgid "I will root you out, monstrous plant!"
msgstr "Je te déracinerai, vile plante mönstrueuse !"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WORMWOOD.REVIVER
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WORMWOOD.REVIVER"
msgid "%s is a kind and formidable healer."
msgstr "%s est un söigneur extraördinaire."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WORMWOOD_MUTANTPROXY_CARRAT.DEAD
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WORMWOOD_MUTANTPROXY_CARRAT.DEAD"
msgid "It has breathed its last."
msgstr "Elle a rendu son dernier soupir."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WORMWOOD_MUTANTPROXY_CARRAT.GENERIC
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WORMWOOD_MUTANTPROXY_CARRAT.GENERIC"
msgid "Vegetables are not to be trusted!"
msgstr "Ön ne peut pöint faire cönfiance à un légume !"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WORMWOOD_MUTANTPROXY_CARRAT.HELD
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WORMWOOD_MUTANTPROXY_CARRAT.HELD"
msgid "I have you now, wicked vegetable."
msgstr "Je te tiens, gueux de légume."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WORMWOOD_MUTANTPROXY_CARRAT.SLEEPING
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WORMWOOD_MUTANTPROXY_CARRAT.SLEEPING"
msgid "A deceptive vegetable with no honor."
msgstr "Un légume föurbe et sans hönneur."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WORMWOOD_MUTANTPROXY_FRUITDRAGON.GENERIC
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WORMWOOD_MUTANTPROXY_FRUITDRAGON.GENERIC"
msgid "Meat impostor!"
msgstr "Impösteur viandeux !"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WORMWOOD_MUTANTPROXY_FRUITDRAGON.RIPE
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WORMWOOD_MUTANTPROXY_FRUITDRAGON.RIPE"
msgid "I have no need for your fake meat."
msgstr "Peu me chaut ta fausse viande."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WORMWOOD_MUTANTPROXY_FRUITDRAGON.SLEEPING
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WORMWOOD_MUTANTPROXY_FRUITDRAGON.SLEEPING"
msgid "Grabbest thy shut eye!"
msgstr "Il s'est assöupi !"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WORMWOOD_MUTANTPROXY_LIGHTFLIER
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WORMWOOD_MUTANTPROXY_LIGHTFLIER"
msgid "Light the way, noble insect."
msgstr "Passe devant, nöble insecte."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WORM_BOSS
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WORM_BOSS"
msgid "A snake beast worthy of mine spear!"
msgstr "Une bête serpentine digne de mienne pique !"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WORTOX.ATTACKER
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WORTOX.ATTACKER"
msgid "Back! Back, beast!"
msgstr "Arrière ! Arrière, bête !"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WORTOX.FIRESTARTER
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WORTOX.FIRESTARTER"
msgid "%s stepped forth from Hel's flames!"
msgstr "%s a succombé aux flammes de Hel !"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WORTOX.GENERIC
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WORTOX.GENERIC"
msgid "Hail, fire giant %s!"
msgstr "Salut, monstre de feu %s !"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WORTOX.GHOST
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WORTOX.GHOST"
msgid "An honorable Viking leaves no one behind!"
msgstr "Une honorable Viking n'abandonne personne !"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WORTOX.MURDERER
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WORTOX.MURDERER"
msgid "%s will pay for his trespasses!"
msgstr "%s paiera pour son intrusion !"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WORTOX.REVIVER
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WORTOX.REVIVER"
msgid "%s abides by a warrior's code."
msgstr "%s obéit à un code du guerrier."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WORTOX_NABBAG
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WORTOX_NABBAG"
msgid "The tool of a plunderer."
msgstr "L'outil d'un pillard."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WORTOX_REVIVER
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WORTOX_REVIVER"
msgid "Impish magic has power over death?"
msgstr "La magie de diablötin a une emprise sur la mört ?"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WORTOX_SOULJAR
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WORTOX_SOULJAR"
msgid "He doth keep souls of the slain."
msgstr "Il cönserve les âmes des öccis."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WURT.ATTACKER
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WURT.ATTACKER"
msgid "Ah, you wish to test your mettle in combat? As you wish!"
msgstr "Ah, vöus söuhaitez me défier ? Estöit brave !"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WURT.FIRESTARTER
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WURT.FIRESTARTER"
msgid "%s toys with Hel's flames!"
msgstr "%s jöue avec les flammes de Hel !"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WURT.GENERIC
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WURT.GENERIC"
msgid "Hail, %s, small beastie of the marshlands!"
msgstr "Salutatiöns, %s, petite beste des marécages !"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WURT.GHOST
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WURT.GHOST"
msgid "You've a warrior's spirit, but you're not ready for Valhalla yet!"
msgstr "Vötre esprit est intrépide, mais vöus n'êtes pöint encöre prêt pöur le Valhalla."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WURT.MURDERER
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WURT.MURDERER"
msgid "I will not be defeated so easily, beastie!"
msgstr "Je ne me laisserai pas vaincre aussi facilement, vile beste !"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WURT.REVIVER
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WURT.REVIVER"
msgid "It seems you have a kind heart 'neath that scaly hide."
msgstr "Il semblerait y avöir un cœur, ci-dessöus de ces écailles."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WURT_SWAMPITEM_LUNAR
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WURT_SWAMPITEM_LUNAR"
msgid "The small beastie seems keen to expand her kingdom."
msgstr "La petite bête semble vouloir étendre sien royaume."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WURT_SWAMPITEM_SHADOW
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WURT_SWAMPITEM_SHADOW"
msgid "The small beastie seems keen to expand her kingdom."
msgstr "La petite bête semble vouloir étendre sien royaume."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WX78.ATTACKER
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WX78.ATTACKER"
msgid "%s! You insult my honor!"
msgstr "%s ! Tu insultes mon honneur !"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WX78.FIRESTARTER
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WX78.FIRESTARTER"
msgid "That metal warrior would see this world burn."
msgstr "Ce guerrier de métal voudrait voir brûler ce monde."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WX78.GENERIC
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WX78.GENERIC"
msgid "May Thor's bolts energize you, %s!"
msgstr "Que les éclairs de Thor t'apportent leur énergie, %s !"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WX78.GHOST
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WX78.GHOST"
msgid "Metal warrior, it is not your time. A heart!"
msgstr "Guerrier de métal, ton heure n'est pas venue. Un cœur !"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WX78.MURDERER
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WX78.MURDERER"
msgid "We shall see whose steel is stronger, %s!"
msgstr "On va voir qui a l'acier le plus résistant, %s !"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WX78.REVIVER
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WX78.REVIVER"
msgid "%s is brimming with honor."
msgstr "%s déborde d'honneur."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WX78MODULE_BEE
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.WX78MODULE_BEE"
msgid "These boons shall empower our metal warrior."
msgstr "Icels présents devraient renförcer nöstre guerrier d'acier."

