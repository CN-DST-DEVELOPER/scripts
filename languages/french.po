#. STRINGS.CHARACTERS.WANDA.DESCRIBE.WINONA_SPOTLIGHT.SLEEP
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.WINONA_SPOTLIGHT.SLEEP"
msgid "That young lady is a genius!"
msgstr "Cette jeune femme est un génie !"

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.WINONA_STORAGE_ROBOT.CHARGED
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.WINONA_STORAGE_ROBOT.CHARGED"
msgid "It sure takes a lot of breaks."
msgstr "Il fait beaucoup de pauses."

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.WINONA_STORAGE_ROBOT.CHARGING
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.WINONA_STORAGE_ROBOT.CHARGING"
msgid "It sure takes a lot of breaks."
msgstr "Il fait beaucoup de pauses."

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.WINONA_STORAGE_ROBOT.GENERIC
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.WINONA_STORAGE_ROBOT.GENERIC"
msgid "Aren't you a good little helper?"
msgstr "Quel bon assistant !"

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.WINONA_STORAGE_ROBOT.OFF
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.WINONA_STORAGE_ROBOT.OFF"
