msgstr "Ugh, seu babaca sorrateiro!!"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.HEDGEHOUND_BUSH
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.HEDGEHOUND_BUSH"
