msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.BOAT_BUMPER_KELP"
msgid "Some friendly help from fronds of kelp."
msgstr "Uma amigável ajudinha das folhas de alguinha."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.BOAT_BUMPER_KELP_KIT
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.BOAT_BUMPER_KELP_KIT"
msgid "But idle hands are such good playthings!"
msgstr "Mas mãos ociosas são tão legais de brincar!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.BOAT_BUMPER_SHELL
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.BOAT_BUMPER_SHELL"
msgid "We shell be well protected, hyuyu!"
msgstr "Estaremos aconchegados, huehue!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.BOAT_BUMPER_SHELL_KIT
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.BOAT_BUMPER_SHELL_KIT"
msgid "But idle hands are such good playthings!"
msgstr "Mas mãos ociosas são tão legais de brincar!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.BOAT_BUMPER_YOTD
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.BOAT_BUMPER_YOTD"
msgid "Ever been bitten by a boat before?"
msgstr "Já viu barco fazer nhac nhac?"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.BOAT_BUMPER_YOTD_KIT
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.BOAT_BUMPER_YOTD_KIT"
msgid "But idle hands are such good playthings!"
msgstr "Mas mãos ociosas são tão legais de brincar!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.BOAT_CANNON.AMMOLOADED
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.BOAT_CANNON.AMMOLOADED"
msgid "Ready to fire and brimstone!"
msgstr "Pronto para soltar fogo e lava!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.BOAT_CANNON.GENERIC
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.BOAT_CANNON.GENERIC"
msgid "Rounded stones are required for this cannon to fire."
msgstr "Preciso de pedras redondas para esse canhão disparar."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.BOAT_CANNON.NOAMMO
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.BOAT_CANNON.NOAMMO"
msgid "This cannon cannot fire."
msgstr "Esse canhão não consegue disparar."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.BOAT_CANNON_KIT
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.BOAT_CANNON_KIT"
msgid "I'll build it quick, then put it on the ship."
msgstr "Vou construir isso rápido e botar no navio."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.BOAT_GRASS_ITEM
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.BOAT_GRASS_ITEM"
msgid "This grass will pass for a boat, hyuyu!"
msgstr "Essa grama não é madeira, mas quebra um galho, huehue!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.BOAT_ITEM
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.BOAT_ITEM"
msgid "Let's craft a raft!"
msgstr "Uma jangada será criada!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.BOAT_LEAK
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.BOAT_LEAK"
msgid "Things look bleak - we have a leak!"
msgstr "Esperem um momento... temos um vazamento!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.BOAT_MAGNET.ACTIVATED
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.BOAT_MAGNET.ACTIVATED"
msgid "I'll just sit back while it keeps me on track."
msgstr "Vou montar um prato enquanto ele me mantém no rastro."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.BOAT_MAGNET.GENERIC
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.BOAT_MAGNET.GENERIC"
msgid "Why would I row when I can be towed?"
msgstr "Por que remar quando podem me puxar?"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.BOAT_MAGNET_BEACON.ACTIVATED
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.BOAT_MAGNET_BEACON.ACTIVATED"
msgid "It brought me here, so it must attract trouble, hyuyu!"
msgstr "Me trouxe aqui, então deve atrair encrenca, huehue!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.BOAT_MAGNET_BEACON.GENERIC
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.BOAT_MAGNET_BEACON.GENERIC"
msgid "Mortals come up with the funniest things."
msgstr "Os mortais inventam cada coisa engraçada."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.BOAT_MAGNET_KIT
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.BOAT_MAGNET_KIT"
msgid "The troubling toil never ends."
msgstr "A labuta importuna nunca acaba."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.BOAT_ROTATOR
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.BOAT_ROTATOR"
msgid "One good turn deserves another, hyuyu!"
msgstr "Uma boa rodada merece outra, huehue!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.BOAT_ROTATOR_KIT
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.BOAT_ROTATOR_KIT"
msgid "It's something or rudder!"
msgstr "Um timão bobão."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.BODYPILLOW_BEEFALOWOOL
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.BODYPILLOW_BEEFALOWOOL"
msgid "The beefiest pillow I ever did see."
msgstr "O travesseiro mais bifalado que já vi."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.BODYPILLOW_KELP
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.BODYPILLOW_KELP"
msgid "I'd never wish to sleep like a fish."
msgstr "Jamais esperei dormir como um peixe."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.BODYPILLOW_PETALS
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.BODYPILLOW_PETALS"
msgid "Armor doesn't often smell so nice!"
msgstr "Armadura raramente tem um cheiro tão bom!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.BODYPILLOW_STEELWOOL
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.BODYPILLOW_STEELWOOL"
msgid "A nasty thing, it'll do well in the ring!"
msgstr "Um travesseiro baita nojento, pra no ringue bater nos avarentos!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.BOMB_LUNARPLANT
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.BOMB_LUNARPLANT"
msgid "This will be the start of some wonderful pranks."
msgstr "Esse será o começo de travessuras maravilhosas."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.BOMB_LUNARPLANT_WORMWOOD
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.BOMB_LUNARPLANT_WORMWOOD"
msgid "That plant has a mischievous streak after all, hyuyu!"
msgstr "Aquela planta tem um lado malicioso, afinal. Huehue!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.BONESHARD
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.BONESHARD"
msgid "Fragmented, like my thoughts!"
msgstr "Fragmentado, como os meus pensamentos!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.BONESOUP
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.BONESOUP"
msgid "They spend all day cooking and then devour it in minutes."
msgstr "Eles passam o dia todo cozinhando e devoram tudo em minutos."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.BONESTEW
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.BONESTEW"
msgid "Mortals like drinking goop like this."
msgstr "Os mortais gostam de beber melecas como esta."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.BOOKSTATION.BURNT
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.BOOKSTATION.BURNT"
msgid "What a shame, it went up in flames."
msgstr "Que peninha, virou fumacinha."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.BOOKSTATION.GENERIC
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.BOOKSTATION.GENERIC"
msgid "Her entire collection for our inspection."
msgstr "A coleção dela inteira, pra nossa inspeção."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.BOOK_BEES
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.BOOK_BEES"
msgid "I think I'll beekeeping my distance, hyuyu!"
msgstr "Eu sou abelhudo, mas não desse jeito, huehue!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.BOOK_BIRDS
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.BOOK_BIRDS"
msgid "Humans share their knowledge so freely."
msgstr "Os humanos compartilham seu conhecimento tão livremente."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.BOOK_BRIMSTONE
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.BOOK_BRIMSTONE"
msgid "Who would leave such precious knowledge lying here?"
msgstr "Quem deixaria um conhecimento tão precioso jogado por aí assim?"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.BOOK_ELEMENTAL
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.BOOK_ELEMENTAL"
msgid "Well, it won't summon an imp!"
msgstr "Ora, não vai invocar um diabrete!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.BOOK_FIRE
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.BOOK_FIRE"
msgid "We've no use for tomes from where I roam."
msgstr "Donde venho, jogo tomos nos mordomos."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.BOOK_FISH
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.BOOK_FISH"
msgid "This one's a bit fishy."
msgstr "Hali-êu-tico esse da minha lista."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.BOOK_FOSSIL
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.BOOK_FOSSIL"
msgid "Rock their socks off."
msgstr "Bota pra quebrar."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.BOOK_GARDENING
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.BOOK_GARDENING"
msgid "Secret knowledge of vegetables."
msgstr "O conhecimento secreto dos vegetais."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.BOOK_HORTICULTURE
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.BOOK_HORTICULTURE"
msgid "Secret knowledge of vegetables."
msgstr "O conhecimento secreto dos vegetais."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.BOOK_HORTICULTURE_UPGRADED
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.BOOK_HORTICULTURE_UPGRADED"
msgid "Always something to learn where gardens are concerned."
msgstr "Quando se trata de jardinagem, ela tem muita bagagem."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.BOOK_LIGHT
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.BOOK_LIGHT"
msgid "Shall I sit and read for a spell?"
msgstr "Devo sentar e um feitiço conjurar?"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.BOOK_LIGHT_UPGRADED
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.BOOK_LIGHT_UPGRADED"
msgid "It's quite heavy for a light book, hyuyu!"
msgstr "E pensar que luz não pesa, huehue!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.BOOK_MOON
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.BOOK_MOON"
msgid "Hyuyuyu how cute! The mortals think they can hold sway over the moon!"
msgstr "Huehue, que fofinho! Os mortais acham que podem controlar a lua!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.BOOK_RAIN
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.BOOK_RAIN"
msgid "Mortals can take the fun out of anything."
msgstr "Os mortais conseguem tirar a diversão de qualquer coisa."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.BOOK_RESEARCH_STATION
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.BOOK_RESEARCH_STATION"
msgid "So much knowledge, and none of it forbidden!"
msgstr "Tanto conhecimento, e nada dele é proibido!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.BOOK_SILVICULTURE
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.BOOK_SILVICULTURE"
msgid "Why not read it to the reeds? Hyuyuyu!"
msgstr "Por que não o ler para os lírios? Huehue!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.BOOK_SLEEP
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.BOOK_SLEEP"
msgid "Knowledge is power. Literally."
msgstr "Conhecimento é poder. Literalmente."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.BOOK_TEMPERATURE
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.BOOK_TEMPERATURE"
msgid "Hyuyuyu, mortals have such funny ideas."
msgstr "Huehue, os mortais têm ideias tão engraçadas."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.BOOK_TENTACLES
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.BOOK_TENTACLES"
msgid "Imps don't disseminate precious knowledge so carelessly."
msgstr "Diabretes não disseminam conhecimentos preciosos tão descuidadamente."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.BOOK_WEB
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.BOOK_WEB"
msgid "Oh what a tangled web we read."
msgstr "Ah, que leitura emaranhada."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.BOOMERANG
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.BOOMERANG"
msgid "What goes around comes around, they say, they say!"
msgstr "Tudo que vai, volta, eles dizem, dizem sim!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.BOOTLEG
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.BOOTLEG"
msgid "Hyuyu! Who cobbled this together?"
msgstr "Huehue! Quem fez esse remendo?"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.BROKEN_FORGEDITEM
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.BROKEN_FORGEDITEM"
msgid "This broken pile might still be worthwhile."
msgstr "Este item quebrado ainda pode valer um bocado."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.BROKEN_FUMAROLETOOLITEM
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.BROKEN_FUMAROLETOOLITEM"
msgid "To make it like new, some heat will do!"
msgstr "Pra ferramenta ficar novinha, um pouco de calor resolve direitinho!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.BRUSH
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.BRUSH"
msgid "Keeps imp chest tufts plush."
msgstr "Mantém a pelagem peitoral dos diabretes macia."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.BUGNET
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.BUGNET"
msgid "I'll bind those bugs."
msgstr "Vou prender esses insetos."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.BULLKELP_PLANT.GENERIC
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.BULLKELP_PLANT.GENERIC"
msgid "And so it grows from out the sea."
msgstr "E assim, no mar ela crescia."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.BULLKELP_PLANT.PICKED
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.BULLKELP_PLANT.PICKED"
msgid "The mortals picked it with such glee."
msgstr "Os mortais a pegaram com muita alegria."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.BULLKELP_ROOT
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.BULLKELP_ROOT"
msgid "We plucked this whip from the side of the ship."
msgstr "Colhemos essa porção na lateral da embarcação."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.BUNDLE
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.BUNDLE"
msgid "Does a nice surprise await inside?"
msgstr "Será que uma bela surpresa está me esperando lá dentro?"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.BUNDLEWRAP
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.BUNDLEWRAP"
msgid "Bind all cursed objects!"
msgstr "Objetos amaldiçoado, uni-vos!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.BUNNYMAN
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.BUNNYMAN"
msgid "You hop just like me!"
msgstr "Você saltita exatamente como eu!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.BUNNYSTEW
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.BUNNYSTEW"
msgid "Are mortals attracted to this smell?"
msgstr "Os mortais se sentem atraídos por esse cheiro?"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.BURNT_MARSH_BUSH
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.BURNT_MARSH_BUSH"
msgid "Farewell, little bristles."
msgstr "Adeus, pelos."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.BUSHHAT
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.BUSHHAT"
msgid "Now you see me, now you don't! Hyuyu!"
msgstr "Aparece, desaparece! Huehue!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.BUTTER
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.BUTTER"
msgid "Essence of slipperiness."
msgstr "A essência da escorregacência."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.BUTTERFLY.GENERIC
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.BUTTERFLY.GENERIC"
msgid "Flutter, flutter, dearest butter!"
msgstr "Borboleteie, linda borboleta!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.BUTTERFLY.HELD
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.BUTTERFLY.HELD"
msgid "I'll try not to suck your soul out."
msgstr "Vou tentar não sugar a sua alma."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.BUTTERFLYMUFFIN
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.BUTTERFLYMUFFIN"
msgid "Muffin to see here, my dear."
msgstr "Está mais pra bolindo."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.BUTTERFLYWINGS
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.BUTTERFLYWINGS"
msgid "Fly away, sweet soul."
msgstr "Voe, doce alma."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.BUZZARD
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.BUZZARD"
msgid "It doesn't want to feed on death. It just has to."
msgstr "Não quer se alimentar da alma. Mas precisa."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.BUZZARDCORPSE.BURNING
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.BUZZARDCORPSE.BURNING"
msgid "Cremation to curb mutation!"
msgstr "Cremação para conter a mutação!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.BUZZARDCORPSE.GENERIC
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.BUZZARDCORPSE.GENERIC"
msgid "It's dead but not done."
msgstr "Está morto, mas não é o fim."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.BUZZARDCORPSE.REVIVING
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.BUZZARDCORPSE.REVIVING"
msgid "It's changing and deranging."
msgstr "Está mudando e deturbando."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.CABBAGEROLLS
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.CABBAGEROLLS"
msgid "They look so real!"
msgstr "Parecem muito reais!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.CACTUS.GENERIC
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.CACTUS.GENERIC"
msgid "Spiny and mean, just how I like them."
msgstr "Espinhoso e malvado, do jeito que eu gosto."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.CACTUS.PICKED
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.CACTUS.PICKED"
msgid "To pick a cactus, you just need some prac-tus!"
msgstr "Um cacto pego no acto!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.CACTUS_FLOWER
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.CACTUS_FLOWER"
msgid "How pretty! I fear to touch it."
msgstr "Que linda! Tenho medo de tocar nela."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.CACTUS_MEAT
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.CACTUS_MEAT"
msgid "I don't want to eat anything prickly."
msgstr "Não quero comer nada espinhoso."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.CACTUS_MEAT_COOKED
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.CACTUS_MEAT_COOKED"
msgid "The prickles are gone, but I still don't want to eat it."
msgstr "Não tem mais espinhos, mas ainda não quero comer."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.CALIFORNIAROLL
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.CALIFORNIAROLL"
msgid "We're on a roll! Hyuyu!"
msgstr "O que tá rolando? Huehue!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.CAMPFIRE.EMBERS
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.CAMPFIRE.EMBERS"
msgid "Soon to extinguish."
msgstr "Logo se extinguirá."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.CAMPFIRE.GENERIC
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.CAMPFIRE.GENERIC"
msgid "This fire will slake my thirst for warmth."
msgstr "Esse fogo vai satisfazer minha sede de calor."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.CAMPFIRE.HIGH
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.CAMPFIRE.HIGH"
msgid "Those are some spicy flames."
msgstr "Por que me chamas?"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.CAMPFIRE.LOW
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.CAMPFIRE.LOW"
msgid "It burns so low, so low!"
msgstr "Me chama baixinho agora!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.CAMPFIRE.NORMAL
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.CAMPFIRE.NORMAL"
msgid "When I roam, camp feels like home."
msgstr "Quando ando por aí, um acampamento é como minha casa."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.CAMPFIRE.OUT
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.CAMPFIRE.OUT"
msgid "And out it goes."
msgstr "E lá se vai."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.CANARY.GENERIC
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.CANARY.GENERIC"
msgid "Let's look out for each other, you and I."
msgstr "Vamos procurar por outro, você e eu."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.CANARY.HELD
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.CANARY.HELD"
msgid "Mind my paws now."
msgstr "Cuidado com as minhas patas."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.CANARY_POISONED
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.CANARY_POISONED"
msgid "Mortals don't usually look like that."
msgstr "Mortais normalmente não têm essa aparência."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.CANDYBAG
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.CANDYBAG"
msgid "It's a Wortox Sack!"
msgstr "É um saco de Wortox!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.CANE
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.CANE"
msgid "Is it walking me, or am I walking it?"
msgstr "Está me ajudando a caminhar ou eu que estou ajudando ele a caminhar?"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.CANNONBALL_ROCK_ITEM
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.CANNONBALL_ROCK_ITEM"
msgid "Oh what a sinking feeling it brings!"
msgstr "Nossa, que sensação pesada que isso traz!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.CARNIVALCANNON.COOLDOWN
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.CARNIVALCANNON.COOLDOWN"
msgid "Hyuyuyu, what fun!"
msgstr "Huehue, que divertido!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.CARNIVALCANNON.GENERIC
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.CARNIVALCANNON.GENERIC"
msgid "Oh the pranks I could pull with this!"
msgstr "Ah, as brincadeiras que eu poderia fazer com isso!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.CARNIVALCANNON_KIT
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.CARNIVALCANNON_KIT"
msgid "Let's start things off with a bang, shall we? Hyuyuyu!"
msgstr "Vamos começar as comemorações com tudo! Huehue!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.CARNIVALDECOR_BANNER
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.CARNIVALDECOR_BANNER"
msgid "Is that the glint of fairy gold?"
msgstr "Esse é o brilho de ouro das fadas?"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.CARNIVALDECOR_BANNER_KIT
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.CARNIVALDECOR_BANNER_KIT"
msgid "Nearly there."
msgstr "Quase lá."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.CARNIVALDECOR_EGGRIDE
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.CARNIVALDECOR_EGGRIDE"
msgid "On and on and on it goes!"
msgstr "Ele vai, vai e não para!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.CARNIVALDECOR_EGGRIDE_KIT
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.CARNIVALDECOR_EGGRIDE_KIT"
msgid "Nearly there."
msgstr "Quase lá."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.CARNIVALDECOR_FIGURE.GENERIC
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.CARNIVALDECOR_FIGURE.GENERIC"
msgid "Mortals do love their trinkets."
msgstr "Os mortais adoram quinquilharias."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.CARNIVALDECOR_FIGURE.RARE
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.CARNIVALDECOR_FIGURE.RARE"
msgid "The rarest of trinkets!"
msgstr "A mais rara das quinquilharias."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.CARNIVALDECOR_FIGURE.UNCOMMON
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.CARNIVALDECOR_FIGURE.UNCOMMON"
msgid "Hyuyu, a fine find indeed!"
msgstr "Huehue, um belo achado, sem dúvida!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.CARNIVALDECOR_FIGURE_KIT
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.CARNIVALDECOR_FIGURE_KIT"
msgid "Hyuyu, how very mysterious!"
msgstr "Huehue, que misteriosa!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.CARNIVALDECOR_FIGURE_KIT_SEASON2
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.CARNIVALDECOR_FIGURE_KIT_SEASON2"
msgid "Hyuyu, how very mysterious!"
msgstr "Huehue, que misteriosa!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.CARNIVALDECOR_LAMP
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.CARNIVALDECOR_LAMP"
msgid "A fairy light to glow in the night."
msgstr "Uma luz mágica para iluminar a noite trágica."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.CARNIVALDECOR_LAMP_KIT
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.CARNIVALDECOR_LAMP_KIT"
msgid "Nearly there."
msgstr "Quase lá."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.CARNIVALDECOR_PLANT
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.CARNIVALDECOR_PLANT"
msgid "We can take a small bit of the Cawnival wherever we go."
msgstr "Podemos levar um pedacinho do Crasnaval para onde formos."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.CARNIVALDECOR_PLANT_KIT
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.CARNIVALDECOR_PLANT_KIT"
msgid "Nearly there."
msgstr "Quase lá."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.CARNIVALFOOD_CORNTEA
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.CARNIVALFOOD_CORNTEA"
msgid "I think I'll go find a nice refreshing soul instead."
msgstr "Não, acho que vou procurar uma alma boa e refrescante."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.CARNIVALGAME_FEEDCHICKS_FOOD
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.CARNIVALGAME_FEEDCHICKS_FOOD"
msgid "Imagine what a fun prank it would be to replace these with real worms..."
msgstr "Imagine que pegadinha divertida seria substituí-las por minhocas de verdade..."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.CARNIVALGAME_FEEDCHICKS_KIT
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.CARNIVALGAME_FEEDCHICKS_KIT"
msgid "We're almost ready for the fun to begin!"
msgstr "Estamos quase prontos para a diversão começar!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.CARNIVALGAME_FEEDCHICKS_NEST
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.CARNIVALGAME_FEEDCHICKS_NEST"
msgid "A small trap door is set in the floor."
msgstr "Há um pequeno alçapão instalado no chão."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.CARNIVALGAME_FEEDCHICKS_STATION.GENERIC
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.CARNIVALGAME_FEEDCHICKS_STATION.GENERIC"
msgid "Allow me to propose a trade: one shiny trinket to play your game."
msgstr "Eis uma troca que me faria sorrir: um item reluzente pelo direito de me divertir."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.CARNIVALGAME_FEEDCHICKS_STATION.PLAYING
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.CARNIVALGAME_FEEDCHICKS_STATION.PLAYING"
msgid "You must be quick to feed the chicks."
msgstr "É preciso ser rápido para alimentar os pintinhos."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.CARNIVALGAME_HERDING_CHICK
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.CARNIVALGAME_HERDING_CHICK"
msgid "To the center, if you please."
msgstr "Para o centro, por favor."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.CARNIVALGAME_HERDING_KIT
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.CARNIVALGAME_HERDING_KIT"
msgid "We're almost ready for the fun to begin!"
msgstr "Estamos quase prontos para a diversão começar!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.CARNIVALGAME_HERDING_STATION.GENERIC
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.CARNIVALGAME_HERDING_STATION.GENERIC"
msgid "Allow me to propose a trade: one shiny trinket to play your game."
msgstr "Eis uma troca que me faria sorrir: um item reluzente pelo direito de me divertir."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.CARNIVALGAME_HERDING_STATION.PLAYING
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.CARNIVALGAME_HERDING_STATION.PLAYING"
msgid "It's quite fun, or so I herd. Hyuyuyu!"
msgstr "É bem divertido, se estiver aborrecido. Huehue!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.CARNIVALGAME_MEMORY_CARD.GENERIC
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.CARNIVALGAME_MEMORY_CARD.GENERIC"
msgid "A small trap door is set in the floor."
msgstr "Há um pequeno alçapão instalado no chão."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.CARNIVALGAME_MEMORY_CARD.PLAYING
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.CARNIVALGAME_MEMORY_CARD.PLAYING"
msgid "This one or that one?"
msgstr "Este aqui ou aquele ali?"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.CARNIVALGAME_MEMORY_KIT
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.CARNIVALGAME_MEMORY_KIT"
msgid "We're almost ready for the fun to begin!"
msgstr "Estamos quase prontos para a diversão começar!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.CARNIVALGAME_MEMORY_STATION.GENERIC
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.CARNIVALGAME_MEMORY_STATION.GENERIC"
msgid "Allow me to propose a trade: one shiny trinket to play your game."
msgstr "Eis uma troca que me faria sorrir: um item reluzente pelo direito de me divertir."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.CARNIVALGAME_MEMORY_STATION.PLAYING
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.CARNIVALGAME_MEMORY_STATION.PLAYING"
msgid "This game is sure to test one's brain."
msgstr "Este jogo é um teste para o cérebro."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.CARNIVALGAME_PUCKDROP_KIT
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.CARNIVALGAME_PUCKDROP_KIT"
msgid "We're almost ready for the fun to begin!"
msgstr "Estamos quase prontos para a diversão começar!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.CARNIVALGAME_PUCKDROP_STATION.GENERIC
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.CARNIVALGAME_PUCKDROP_STATION.GENERIC"
msgid "Allow me to propose a trade: one shiny trinket to play your game."
msgstr "Eis uma troca que me faria sorrir: um item reluzente pelo direito de me divertir."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.CARNIVALGAME_PUCKDROP_STATION.PLAYING
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.CARNIVALGAME_PUCKDROP_STATION.PLAYING"
msgid "There goes the ball, where will it fall?"
msgstr "Lá se foi a bola, onde vai cair agora?"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.CARNIVALGAME_SHOOTING_BUTTON.GENERIC
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.CARNIVALGAME_SHOOTING_BUTTON.GENERIC"
msgid "Allow me to propose a trade: one shiny trinket to play your game."
msgstr "Eis uma troca que me faria sorrir: um item reluzente pelo direito de me divertir."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.CARNIVALGAME_SHOOTING_BUTTON.PLAYING
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.CARNIVALGAME_SHOOTING_BUTTON.PLAYING"
msgid "Hyuyuyu! What does it do?"
msgstr "Huehuehue! O que isso faz?"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.CARNIVALGAME_SHOOTING_KIT
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.CARNIVALGAME_SHOOTING_KIT"
msgid "We're almost ready for the fun to begin!"
msgstr "Estamos quase prontos para a diversão começar!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.CARNIVALGAME_SHOOTING_STATION.GENERIC
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.CARNIVALGAME_SHOOTING_STATION.GENERIC"
msgid "Allow me to propose a trade: one shiny trinket to play your game."
msgstr "Eis uma troca que me faria sorrir: um item reluzente pelo direito de me divertir."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.CARNIVALGAME_SHOOTING_STATION.PLAYING
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.CARNIVALGAME_SHOOTING_STATION.PLAYING"
msgid "For this merry game, squashing bugs is the aim."
msgstr "Nesse jogo divertido, matar insetos é o objetivo."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.CARNIVALGAME_SHOOTING_TARGET.GENERIC
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.CARNIVALGAME_SHOOTING_TARGET.GENERIC"
msgid "A small trap door is set in the floor."
msgstr "Há um pequeno alçapão instalado no chão."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.CARNIVALGAME_SHOOTING_TARGET.PLAYING
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.CARNIVALGAME_SHOOTING_TARGET.PLAYING"
msgid "I can't rest until I finish those pests!"
msgstr "Não posso descansar até as pestes eu amassar!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.CARNIVALGAME_WHEELSPIN_KIT
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.CARNIVALGAME_WHEELSPIN_KIT"
msgid "We're almost ready for the fun to begin!"
msgstr "Estamos quase prontos para a diversão começar!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.CARNIVALGAME_WHEELSPIN_STATION.GENERIC
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.CARNIVALGAME_WHEELSPIN_STATION.GENERIC"
msgid "Allow me to propose a trade: one shiny trinket to play your game."
msgstr "Eis uma troca que me faria sorrir: um item reluzente pelo direito de me divertir."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.CARNIVALGAME_WHEELSPIN_STATION.PLAYING
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.CARNIVALGAME_WHEELSPIN_STATION.PLAYING"
msgid "It's easy to win, just give it a spin!"
msgstr "É fácil ganhar, é só saber girar!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.CARNIVAL_BALL
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.CARNIVAL_BALL"
msgid "It goes quite nicely with my fur!"
msgstr "Combina muito bem com o meu pelo!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.CARNIVAL_CROWKID
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.CARNIVAL_CROWKID"
msgid "Hyuyu, so nice to see these fine folk out and about!"
msgstr "Huehue, é muito legal ver essa gente bacana por aí!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.CARNIVAL_GAMETOKEN
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.CARNIVAL_GAMETOKEN"
msgid "Who could resist such a shiny trinket?"
msgstr "Quem poderia resistir a uma quinquilharia tão reluzente?"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.CARNIVAL_HOST
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.CARNIVAL_HOST"
msgid "How now, spirit? Whither wander you?"
msgstr "Olá, espírito! Aonde você vai?"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.CARNIVAL_PLAZA.GENERIC
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.CARNIVAL_PLAZA.GENERIC"
msgid "This place could use some sprucing up, don't you think?"
msgstr "Este lugar precisa de uns enfeites, não acha?"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.CARNIVAL_PLAZA.LEVEL_2
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.CARNIVAL_PLAZA.LEVEL_2"
msgid "It's fine, but this place could use more sparkle and shine."
msgstr "Está legal, mas um pouco mais de brilho cairia bem."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.CARNIVAL_PLAZA.LEVEL_3
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.CARNIVAL_PLAZA.LEVEL_3"
msgid "Fittingly fancified for our fine feathered friends."
msgstr "Árvore adequada às aspirações de nossas adoráveis aves amigas."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.CARNIVAL_PLAZA_KIT
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.CARNIVAL_PLAZA_KIT"
msgid "Now if I were a crow, where would I think it should go?"
msgstr "Se eu fosse um corvo, onde será que eu a colocaria?"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.CARNIVAL_PRIZEBOOTH.GENERIC
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.CARNIVAL_PRIZEBOOTH.GENERIC"
msgid "What to choose, what to choose..."
msgstr "O que escolher, o que escolher..."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.CARNIVAL_PRIZEBOOTH_KIT
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.CARNIVAL_PRIZEBOOTH_KIT"
msgid "What kind of goodies will it have, I wonder?"
msgstr "Quais tipos de prêmios será que tem?"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.CARNIVAL_PRIZETICKET.GENERIC
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.CARNIVAL_PRIZETICKET.GENERIC"
msgid "One ticket please, hyuyu!"
msgstr "Um tíquete, por favor, huehue!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.CARNIVAL_PRIZETICKET.GENERIC_LARGESTACK
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.CARNIVAL_PRIZETICKET.GENERIC_LARGESTACK"
msgid "I can almost see the prize before my eyes."
msgstr "Quase consigo ver o prêmio diante dos meus olhos."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.CARNIVAL_PRIZETICKET.GENERIC_SMALLSTACK
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.CARNIVAL_PRIZETICKET.GENERIC_SMALLSTACK"
msgid "A pretty pile of prize tickets."
msgstr "Uma bela pilha de tíquetes premiados."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.CARNIVAL_SEEDPACKET
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.CARNIVAL_SEEDPACKET"
msgid "I'm sure they won't be offended if I dump these on the ground."
msgstr "Tenho certeza de que eles não ficarão ofendidos se eu jogar isso no chão."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.CARNIVAL_VEST_A
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.CARNIVAL_VEST_A"
msgid "I'm quite partial to the style."
msgstr "Tenho um fraco por este estilo."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.CARNIVAL_VEST_B
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.CARNIVAL_VEST_B"
msgid "A cloak of leaves to drape around my impish frame."
msgstr "Um manto folhoso para vestir um diabrete orgulhoso."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.CARNIVAL_VEST_C
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.CARNIVAL_VEST_C"
msgid "Short and sweet, hyuyu!"
msgstr "Curto e grosso, huehue!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.CARPENTRY_BLADE_MOONGLASS
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.CARPENTRY_BLADE_MOONGLASS"
msgid "But what does it cut?"
msgstr "Mas o que ela corta?"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.CARPENTRY_STATION.BURNT
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.CARPENTRY_STATION.BURNT"
msgid "Who misunderstood it would be good to build it all of wood?"
msgstr "Quem resolveu fazê-lo todo de madeira só podia estar de brincadeira."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.CARPENTRY_STATION.GENERIC
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.CARPENTRY_STATION.GENERIC"
msgid "The mortal need to feel productive, if I may be so reductive."
msgstr "A necessidade de produzir dos mortais é o que me faz rir mais."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.CARRAT.DEAD
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.CARRAT.DEAD"
msgid "Ding-dong, the carrot's dead."
msgstr "Blim, blom, a cenoura morreu."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.CARRAT.GENERIC
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.CARRAT.GENERIC"
msgid "Does it have a soul, one wonders?"
msgstr "Será que ele tem uma alma?"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.CARRAT.HELD
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.CARRAT.HELD"
msgid "Hello hello, strange orange soul."
msgstr "Olá, olá, estranha alma laranja."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.CARRAT.SLEEPING
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.CARRAT.SLEEPING"
msgid "Good night, sleep tight, don't let the humans bite."
msgstr "Boa noite, durma bem, cuidado que os humanos te mordem."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.CARRAT_GHOSTRACER
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.CARRAT_GHOSTRACER"
msgid "I had a feeling she liked to play games too, hyuyu!"
msgstr "Tive a sensação de que ela também gostava de jogar, huehue!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.CARROT
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.CARROT"
msgid "Non-imps like to eat things like this."
msgstr "Não-diabretes gostam de comer coisas como essa."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.CARROT_COOKED
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.CARROT_COOKED"
msgid "I think non-imps like it better cooked."
msgstr "Acho que não-diabretes gostam mais assado."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.CARROT_OVERSIZED
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.CARROT_OVERSIZED"
msgid "I suppose the mortals might enjoy something like that."
msgstr "Pode ser que os mortais gostem de uma coisa dessas."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.CARROT_PLANTED
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.CARROT_PLANTED"
msgid "There's a plant underneath."
msgstr "Tem uma planta embaixo."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.CARROT_SEEDS
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.CARROT_SEEDS"
msgid "Grow a seed and you shall feed!"
msgstr "Se uma semente cultivar, poderá se alimentar!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.CARTOGRAPHYDESK.BURNING
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.CARTOGRAPHYDESK.BURNING"
msgid "Someone's been up to some mischief."
msgstr "Alguém estava aprontando por aqui."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.CARTOGRAPHYDESK.BURNT
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.CARTOGRAPHYDESK.BURNT"
msgid "That's all she wrote."
msgstr "Isso foi tudo que ela escreveu."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.CARTOGRAPHYDESK.GENERIC
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.CARTOGRAPHYDESK.GENERIC"
msgid "I could make maps to anywhere and nowhere."
msgstr "Eu poderia fazer mapas para qualquer lugar e lugar nenhum."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.CATCOON
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.CATCOON"
msgid "I prefer playing with smarter mortals."
msgstr "Prefiro brincar com mortais mais espertos."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.CATCOONDEN.EMPTY
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.CATCOONDEN.EMPTY"
msgid "Yoohoo! Anybody home?"
msgstr "Ooi! Tem alguém em casa?"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.CATCOONDEN.GENERIC
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.CATCOONDEN.GENERIC"
msgid "A home for friends."
msgstr "Um lar para os amigos."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.CATCOONHAT
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.CATCOONHAT"
msgid "It's a stripey horn concealer."
msgstr "É um escondedor de chifres listrado."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.CATTOY_MOUSE
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.CATTOY_MOUSE"
msgid "Wind the bobbin up, pull, pull!"
msgstr "Carrega a bobina, puxa, puxa!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.CAVEIN_BOULDER.GENERIC
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.CAVEIN_BOULDER.GENERIC"
msgid "I could move it if I pleased!"
msgstr "Eu poderia movê-la se eu quisesse!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.CAVEIN_BOULDER.RAISED
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.CAVEIN_BOULDER.RAISED"
msgid "A hop, skip and a jump too far!"
msgstr "Um salto e um pulo longe demais!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.CAVE_BANANA
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.CAVE_BANANA"
msgid "One of the least offensive mortal food flavors."
msgstr "Um dos sabores alimentares mortais menos ofensivos."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.CAVE_BANANA_BURNT
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.CAVE_BANANA_BURNT"
msgid "I don't think anyone wants it now."
msgstr "Não acho que alguém vá querer agora."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.CAVE_BANANA_COOKED
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.CAVE_BANANA_COOKED"
msgid "It's cooked now."
msgstr "Agora está pronto."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.CAVE_BANANA_TREE
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.CAVE_BANANA_TREE"
msgid "What do I see? An underground tree!"
msgstr "O que estou vendo? Uma árvore subterrânea!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.CAVE_ENTRANCE
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.CAVE_ENTRANCE"
msgid "Clear the way I say!"
msgstr "Estou dizendo, abram alas!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.CAVE_ENTRANCE_OPEN.FULL
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.CAVE_ENTRANCE_OPEN.FULL"
msgid "A party rages down below!"
msgstr "Tem uma festança lá embaixo!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.CAVE_ENTRANCE_OPEN.GENERIC
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.CAVE_ENTRANCE_OPEN.GENERIC"
msgid "No spelunking for this little imp!"
msgstr "Nada de espeleologia pra este diabretezinho aqui!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.CAVE_ENTRANCE_OPEN.OPEN
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.CAVE_ENTRANCE_OPEN.OPEN"
msgid "Away I go, hyuyu!"
msgstr "Vá embora, huehue!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.CAVE_ENTRANCE_RUINS
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.CAVE_ENTRANCE_RUINS"
msgid "Let me have a peek inside!"
msgstr "Deixe eu dar uma olhadinha lá dentro!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.CAVE_EXIT.FULL
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.CAVE_EXIT.FULL"
msgid "A party rages up above!"
msgstr "Tem uma festança lá em cima!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.CAVE_EXIT.GENERIC
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.CAVE_EXIT.GENERIC"
msgid "I like it here in the deep dark."
msgstr "Gosto daqui dessa escuridão profunda."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.CAVE_EXIT.OPEN
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.CAVE_EXIT.OPEN"
msgid "Away I go, hyuyu!"
msgstr "Vá embora, huehue!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.CAVE_FERN
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.CAVE_FERN"
msgid "It prefers the dark."
msgstr "Prefere a escuridão."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.CAVE_FERN_WITHERED
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.CAVE_FERN_WITHERED"
msgid "Looks dead, I said."
msgstr "Parece morto, eu exorto."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.CAVE_VENT_MITE.DEAD
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.CAVE_VENT_MITE.DEAD"
msgid "It's gassed its last!"
msgstr "Soltou seu último gás!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.CAVE_VENT_MITE.GENERIC
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.CAVE_VENT_MITE.GENERIC"
msgid "Don't make light of that mite!"
msgstr "Esse ácaro é trágico!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.CAVE_VENT_MITE.SLEEPING
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.CAVE_VENT_MITE.SLEEPING"
msgid "Not a peep, it's fast asleep."
msgstr "Nem um pio, que ele dorme macio."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.CAVE_VENT_MITE.VENTING
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.CAVE_VENT_MITE.VENTING"
msgid "Heehee! How crass to pester with gas!"
msgstr "Hi, hi, hi! Que grosseria soltar gás todo dia!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.CAVE_VENT_ROCK.GAS
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.CAVE_VENT_ROCK.GAS"
msgid "Rather stinks, me thinks."
msgstr "Cheira mal, que péssimo sinal."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.CAVE_VENT_ROCK.GENERIC
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.CAVE_VENT_ROCK.GENERIC"
msgid "What will rise, shall be a surprise!"
msgstr "O que virá, o que virá? Quem saberá?"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.CAVE_VENT_ROCK.HOT
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.CAVE_VENT_ROCK.HOT"
msgid "Fear not, team! Just hot steam."
msgstr "Equipe, não tema! Vapor quente não é problema."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.CAVE_VENT_ROCK.MIASMA
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.CAVE_VENT_ROCK.MIASMA"
msgid "Inhale that plume, embrace your doom!"
msgstr "Se inalar a fumaça, deu para a sua raça!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.CEILING_ROPE
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.CEILING_ROPE"
msgid "For when it's time to climb!"
msgstr "Um instrumento para quando chegar o momento!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.CEVICHE
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.CEVICHE"
msgid "I'd rather leave this for the humans."
msgstr "Vou deixar isso para os humanos."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.CHARCOAL
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.CHARCOAL"
msgid "Pre-burnt tree."
msgstr "Árvore pré-queimada."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.CHARLIERESIDUE
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.CHARLIERESIDUE"
msgid "only_used_by_winona"
msgstr "only_used_by_winona"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.CHARLIEROSE
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.CHARLIEROSE"
msgid "only_used_by_winona"
msgstr "only_used_by_winona"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.CHARLIE_HAND
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.CHARLIE_HAND"
msgid "It seeks a stone of dread."
msgstr "Busca uma pedra do pavor."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.CHARLIE_HECKLER
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.CHARLIE_HECKLER"
msgid "Hyuyu, what a funny pair!"
msgstr "Huehue, que par engraçadinho!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.CHARLIE_LECTURN
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.CHARLIE_LECTURN"
msgid "Hmm, what part to play today?"
msgstr "Hmm, que papel vou fazer hoje?"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.CHARLIE_NPC
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.CHARLIE_NPC"
msgid "The Shadow Queen is finally seen!"
msgstr "A Rainha das Sombras é finalmente revelada!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.CHARLIE_STAGE_POST
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.CHARLIE_STAGE_POST"
msgid "What a treat, a front-row seat!"
msgstr "Na frente do palco, que alento, o meu assento!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.CHESSJUNK1
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.CHESSJUNK1"
msgid "It looks quite broke, and that's no joke!"
msgstr "Parece bem quebrada, e não é piada!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.CHESSJUNK2
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.CHESSJUNK2"
msgid "It looks quite broke, and that's no joke!"
msgstr "Parece bem quebrada, e não é piada!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.CHESSJUNK3
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.CHESSJUNK3"
msgid "It looks quite broke, and that's no joke!"
msgstr "Parece bem quebrada, e não é piada!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.CHESSPIECE_ANCHOR
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.CHESSPIECE_ANCHOR"
msgid "So heavy, heavy, dreary, dreary."
msgstr "É tão pesada e sem graça."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.CHESSPIECE_ANTLION
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.CHESSPIECE_ANTLION"
msgid "An anti Ant Lion, formerly furry. Hyuyu!"
msgstr "Um Leormigo amigo, antigamente peludo. Huehue!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.CHESSPIECE_BEARGER
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.CHESSPIECE_BEARGER"
msgid "I'll say a prayer for this slain bear."
msgstr "Vou fazer uma oração para derrotar esse urso."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.CHESSPIECE_BEARGER_MUTATED
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.CHESSPIECE_BEARGER_MUTATED"
msgid "It bears a strong resemblance."
msgstr "Ganharia um concurso."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.CHESSPIECE_BEEFALO
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.CHESSPIECE_BEEFALO"
msgid "This beefalo is even more hard-headed than most!"
msgstr "A cabeça deste bífalo é ainda mais dura que a dos outros!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.CHESSPIECE_BEEQUEEN
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.CHESSPIECE_BEEQUEEN"
msgid "Stationary majesty. Static insect."
msgstr "Majestade estacionária. Inseto estático."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.CHESSPIECE_BISHOP.GENERIC
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.CHESSPIECE_BISHOP.GENERIC"
msgid "Bishop made of polished stone."
msgstr "Bispo feito de pedra polida."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.CHESSPIECE_BISHOP.STRUGGLE
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.CHESSPIECE_BISHOP.STRUGGLE"
msgid "Yes, yes, come play!"
msgstr "Sim, sim, vem brincar!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.CHESSPIECE_BUTTERFLY
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.CHESSPIECE_BUTTERFLY"
msgid "It does not float, nor does it sting."
msgstr "Não flutua nem ferroa."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.CHESSPIECE_CARRAT
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.CHESSPIECE_CARRAT"
msgid "Not so light on its feet now, hyuyu!"
msgstr "Já não consegue correr, huehue!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.CHESSPIECE_CATCOON
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.CHESSPIECE_CATCOON"
msgid "This little guy and I don't see eye to eye, hyuyu."
msgstr "Não me dou tão bem com esse alguém, huehue."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.CHESSPIECE_CLAYHOUND
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.CHESSPIECE_CLAYHOUND"
msgid "A clay hound made from that sketch we found!"
msgstr "Um sabujo de barro feito a partir do desenho que a gente encontrou!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.CHESSPIECE_CLAYWARG
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.CHESSPIECE_CLAYWARG"
msgid "So scary, rendered still in stone."
msgstr "Muito assustador, esculpido em pedra."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.CHESSPIECE_CRABKING
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.CHESSPIECE_CRABKING"
msgid "He was better at sinking than being a sea king."
msgstr "Ele era melhor em afundar do que sendo um rei do mar."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.CHESSPIECE_DAYWALKER
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.CHESSPIECE_DAYWALKER"
msgid "A boorish boar's bust!"
msgstr "Um busto de um varão bravão!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.CHESSPIECE_DAYWALKER2
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.CHESSPIECE_DAYWALKER2"
msgid "The hog heaved through heaps of junk."
msgstr "O suíno saltava sossegado sobre sua sucata."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.CHESSPIECE_DEERCLOPS
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.CHESSPIECE_DEERCLOPS"
msgid "That was such a fun day!"
msgstr "Que dia bem divertido!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.CHESSPIECE_DEERCLOPS_MUTATED
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.CHESSPIECE_DEERCLOPS_MUTATED"
msgid "She got quite the eyeful."
msgstr "Perto dela, me sinto um pimpolho."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.CHESSPIECE_DEPTHWORM
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.CHESSPIECE_DEPTHWORM"
msgid "Make no error facing this writhing terror."
msgstr "Melhor não vacilar, ou esse verme vai te pegar."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.CHESSPIECE_DRAGONFLY
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.CHESSPIECE_DRAGONFLY"
msgid "Bye bye, dear dragonfly."
msgstr "Tchauzinho, libelulazinha."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.CHESSPIECE_EYEOFTERROR
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.CHESSPIECE_EYEOFTERROR"
msgid "He's gone, no matter how you look at it, hyuyu!"
msgstr "Ele se foi, não importa como quiser olhar isso, huehue!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.CHESSPIECE_FORMAL
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.CHESSPIECE_FORMAL"
msgid "You've a much too competitive spirit, sir."
msgstr "Você tem um espírito competitivo demais, meu senhor."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.CHESSPIECE_GUARDIANPHASE3
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.CHESSPIECE_GUARDIANPHASE3"
msgid "In all its selenic splendour!"
msgstr "Em todo seu esplendor selênico!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.CHESSPIECE_HORNUCOPIA
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.CHESSPIECE_HORNUCOPIA"
msgid "What a funny use for a horn!"
msgstr "Que jeito engraçado de usar um chifre!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.CHESSPIECE_KITCOON
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.CHESSPIECE_KITCOON"
msgid "They'll reach the sky on high!"
msgstr "Vocês vão cair assim, meus bons xanins!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.CHESSPIECE_KLAUS
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.CHESSPIECE_KLAUS"
msgid "A stagnant stag."
msgstr "Um veado estagnado."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.CHESSPIECE_KNIGHT.GENERIC
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.CHESSPIECE_KNIGHT.GENERIC"
msgid "Let's play a game, you and I!"
msgstr "Vamos jogar um jogo, você e eu!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.CHESSPIECE_KNIGHT.STRUGGLE
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.CHESSPIECE_KNIGHT.STRUGGLE"
msgid "Yes, yes, come play!"
msgstr "Sim, sim, vem brincar!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.CHESSPIECE_MALBATROSS
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.CHESSPIECE_MALBATROSS"
msgid "Oh my word, that was a feisty bird!"
msgstr "Cruzes, esse pássaro era terrível!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.CHESSPIECE_MANRABBIT
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.CHESSPIECE_MANRABBIT"
msgid "Looking at it fills me with hoppiness, hyuyu!"
msgstr "Olhar para isso me deixa saltitante, huehue!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.CHESSPIECE_MINOTAUR
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.CHESSPIECE_MINOTAUR"
msgid "It's as though the Minotaur met Medusa."
msgstr "É como se o Minotauro tivesse encontrado a Medusa."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.CHESSPIECE_MOON
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.CHESSPIECE_MOON"
msgid "The mortals thought it was made of cheese! Hyuyu!"
msgstr "Os mortais achavam que ela era feita de queijo! Huehue!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.CHESSPIECE_MOOSEGOOSE.1
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.CHESSPIECE_MOOSEGOOSE.1"
msgid "We've established a stone goose truce."
msgstr "Estabelecemos uma trégua com a ansa de pedra."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.CHESSPIECE_MOOSEGOOSE.2
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.CHESSPIECE_MOOSEGOOSE.2"
msgid "We've established a stone moose truce."
msgstr "Estabelecemos uma trégua com o galce de pedra."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.CHESSPIECE_MUSE
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.CHESSPIECE_MUSE"
msgid "How whimsically elegant."
msgstr "Que engraçadamente elegante."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.CHESSPIECE_PAWN
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.CHESSPIECE_PAWN"
msgid "Would you like to play?"
msgstr "Quer brincar comigo?"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.CHESSPIECE_PIPE
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.CHESSPIECE_PIPE"
msgid "Bubble, bubble, no such trouble."
msgstr "Sem problemas."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.CHESSPIECE_ROOK.GENERIC
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.CHESSPIECE_ROOK.GENERIC"
msgid "We carved this from the rock ourselves."
msgstr "Esculpi sozinho na própria rocha."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.CHESSPIECE_ROOK.STRUGGLE
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.CHESSPIECE_ROOK.STRUGGLE"
msgid "Yes, yes, come play!"
msgstr "Sim, sim, vem brincar!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.CHESSPIECE_SHARKBOI
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.CHESSPIECE_SHARKBOI"
msgid "We avoided the maw of the rowdy Frostjaw."
msgstr "Escapamos de uma enrascada: sobrevivemos ao Queixadagelada."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.CHESSPIECE_STALKER
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.CHESSPIECE_STALKER"
msgid "No more rattlin' bones."
msgstr "Os ossos dele não estão estalando."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.CHESSPIECE_TOADSTOOL
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.CHESSPIECE_TOADSTOOL"
msgid "A fine piece of art, especially the warts."
msgstr "Uma bela obra de arte, especialmente as verrugas."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.CHESSPIECE_TWINSOFTERROR
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.CHESSPIECE_TWINSOFTERROR"
msgid "What an eye-catching statue, hyuyu!"
msgstr "Essa estátua ressalta aos olhos, huehue!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.CHESSPIECE_VAULT_PILLAR_GUARD
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.CHESSPIECE_VAULT_PILLAR_GUARD"
msgid "It was tall, now small."
msgstr "Era grandinha, agora pequenininha."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.CHESSPIECE_WAGBOSS_LUNAR
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.CHESSPIECE_WAGBOSS_LUNAR"
msgid "What error caused such a terror?"
msgstr "Que erro causou tamanho medo?"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.CHESSPIECE_WAGBOSS_ROBOT
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.CHESSPIECE_WAGBOSS_ROBOT"
msgid "That bot was a lot."
msgstr "Esse robô era um pavor."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.CHESSPIECE_WARG_MUTATED
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.CHESSPIECE_WARG_MUTATED"
msgid "Must we memorialize the mutated mutt?"
msgstr "Cá de nós chorar pelo cão convertido?"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.CHESSPIECE_WORMBOSS
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.CHESSPIECE_WORMBOSS"
msgid "Its jaws were near, but I disappeared! Hyuyu!"
msgstr "A bocarra dele chegou perto, mas fugi porque fui mais esperto! Huehue!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.CHESSPIECE_YOTD
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.CHESSPIECE_YOTD"
msgid "From hot to stone cold."
msgstr "De chapa quente à peça resfriada."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.CHESSPIECE_YOTH
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.CHESSPIECE_YOTH"
msgid "This little knight put up quite the fight."
msgstr "Esse cavalinho impressionou, pois com coragem ele lutou."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.CHESSPIECE_YOTS
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.CHESSPIECE_YOTS"
msgid "Make no error facing this writhing terror."
msgstr "Melhor não vacilar, ou esse verme vai te pegar."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.CHESTER
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.CHESTER"
msgid "Greetings! Sorry, I can't pet you."
msgstr "Saudações! Desculpe, não posso acariciar você."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.CHESTER_EYEBONE.GENERIC
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.CHESTER_EYEBONE.GENERIC"
msgid "My, my, what do you see?"
msgstr "Ora, ora, o que você está vendo?"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.CHESTER_EYEBONE.WAITING
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.CHESTER_EYEBONE.WAITING"
msgid "There's no soul attuned to it."
msgstr "Não tem nenhuma alma em sintonia com ele."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.CHESTUPGRADE_STACKSIZE
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.CHESTUPGRADE_STACKSIZE"
msgid "Now that's bending the rules a little, hyuyu!"
msgstr "Isso é que eu chamo de aumentar a tolerância, huehue!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.CHEST_MIMIC_REVEALED
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.CHEST_MIMIC_REVEALED"
msgid "Why did we open it?!"
msgstr "Por que abrimos isso?!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.CHUM
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.CHUM"
msgid "Shall we try to get chummy with the fish? Hyuyu!"
msgstr "Que tal a gente criar intimidade com os peixes? Huehue!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.CLAYHOUND.GENERIC
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.CLAYHOUND.GENERIC"
msgid "Yip yap yelp, I need help!"
msgstr "Di, du, da, preciso de ajuda!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.CLAYHOUND.STATUE
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.CLAYHOUND.STATUE"
msgid "Petrified from toe to tip!"
msgstr "Petrificado dos pés à cabeça!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.CLAYWARG.GENERIC
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.CLAYWARG.GENERIC"
msgid "Growl and bark, teeth like a shark!"
msgstr "Uiva e late, e vem pro embate!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.CLAYWARG.STATUE
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.CLAYWARG.STATUE"
msgid "Petrified from toe to tip!"
msgstr "Petrificado dos pés à cabeça!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.COLDFIRE.EMBERS
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.COLDFIRE.EMBERS"
msgid "Soon to extinguish."
msgstr "Logo se extinguirá."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.COLDFIRE.GENERIC
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.COLDFIRE.GENERIC"
msgid "Brrrning brrrright."
msgstr "Brrrrilhando forrrte."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.COLDFIRE.HIGH
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.COLDFIRE.HIGH"
msgid "Chilly! So chilly."
msgstr "Frio! Muito frio."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.COLDFIRE.LOW
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.COLDFIRE.LOW"
msgid "It burns so low, so low!"
msgstr "Me chama baixinho agora!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.COLDFIRE.NORMAL
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.COLDFIRE.NORMAL"
msgid "Brisk fire. That's new."
msgstr "Fogo cintilante. Essa é nova."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.COLDFIRE.OUT
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.COLDFIRE.OUT"
msgid "And out it goes."
msgstr "E lá se vai."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.COLDFIREPIT.EMBERS
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.COLDFIREPIT.EMBERS"
msgid "Soon to extinguish."
msgstr "Logo se extinguirá."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.COLDFIREPIT.GENERIC
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.COLDFIREPIT.GENERIC"
msgid "Brrrning brrrright."
msgstr "Brrrrilhando forrrte."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.COLDFIREPIT.HIGH
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.COLDFIREPIT.HIGH"
msgid "Chilly! So chilly."
msgstr "Frio! Muito frio."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.COLDFIREPIT.LOW
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.COLDFIREPIT.LOW"
msgid "It burns so low, so low!"
msgstr "Me chama baixinho agora!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.COLDFIREPIT.NORMAL
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.COLDFIREPIT.NORMAL"
msgid "Brisk fire. That's new."
msgstr "Fogo cintilante. Essa é nova."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.COLDFIREPIT.OUT
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.COLDFIREPIT.OUT"
msgid "And out it goes."
msgstr "E lá se vai."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.COLLAPSEDCHEST
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.COLLAPSEDCHEST"
msgid "Infinite space, gone without a trace?"
msgstr "O espaço sem fim desapareceu enfim?"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.COMPASS.E
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.COMPASS.E"
msgid "East!"
msgstr "Leste!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.COMPASS.GENERIC
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.COMPASS.GENERIC"
msgid "For when up is down and down is out."
msgstr "Pra quando o lado de cima estiver pra baixo e o lado de baixo estiver pra fora."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.COMPASS.N
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.COMPASS.N"
msgid "North!"
msgstr "Norte!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.COMPASS.NE
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.COMPASS.NE"
msgid "Northeast!"
msgstr "Nordeste!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.COMPASS.NW
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.COMPASS.NW"
msgid "Northwest!"
msgstr "Noroeste!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.COMPASS.S
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.COMPASS.S"
msgid "South!"
msgstr "Sul!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.COMPASS.SE
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.COMPASS.SE"
msgid "Southeast!"
msgstr "Sudeste!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.COMPASS.SW
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.COMPASS.SW"
msgid "Southwest!"
msgstr "Sudoeste!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.COMPASS.W
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.COMPASS.W"
msgid "West!"
msgstr "Oeste!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.COMPOST
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.COMPOST"
msgid "Oh, I could pull some fun pranks with this."
msgstr "Ah, eu poderia pregar peças divertidíssimas com isto."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.COMPOSTINGBIN.BALANCED
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.COMPOSTINGBIN.BALANCED"
msgid "What a delight, it turned out just right!"
msgstr "Que prazer, adubo pra dar e vender!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.COMPOSTINGBIN.BURNT
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.COMPOSTINGBIN.BURNT"
msgid "How silly!"
msgstr "Que tolice!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.COMPOSTINGBIN.DRY
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.COMPOSTINGBIN.DRY"
msgid "Nice try, but it's too dry."
msgstr "Ai, meus sais! Está seco demais."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.COMPOSTINGBIN.GENERIC
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.COMPOSTINGBIN.GENERIC"
msgid "Not exactly a barrel of laughs."
msgstr "Não é exatamente um barril de risos."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.COMPOSTINGBIN.WET
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.COMPOSTINGBIN.WET"
msgid "I tried and yet, it's far too wet."
msgstr "Tentei de tudo, mas continua úmido."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.COMPOSTWRAP
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.COMPOSTWRAP"
msgid "It's poop. So the plants won't droop."
msgstr "Cocô de montão. Para as plantas não caírem no chão."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.CONSTRUCTION_PLANS
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.CONSTRUCTION_PLANS"
msgid "But it's more fun to wing it!"
msgstr "Mas é mais divertido improvisar!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.COOKBOOK
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.COOKBOOK"
msgid "Oh what shall I cook up next? Hyuyu!"
msgstr "O que será que vou cozinhar agora? Huehue!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.COOKEDMANDRAKE
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.COOKEDMANDRAKE"
msgid "It's at peace now."
msgstr "Agora está em paz."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.COOKEDMEAT
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.COOKEDMEAT"
msgid "I don't really like having food in my stomach."
msgstr "Não gosto muito de quando tem comida no meu estômago."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.COOKEDMONSTERMEAT
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.COOKEDMONSTERMEAT"
msgid "I'd still rather not eat it."
msgstr "Ainda prefiro não comer."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.COOKEDSMALLMEAT
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.COOKEDSMALLMEAT"
msgid "At least it smells better now."
msgstr "Pelo menos o cheiro está melhor agora."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.COOKIECUTTER
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.COOKIECUTTER"
msgid "Well, aren't you a funny fellow!"
msgstr "Como você é engraçadinho!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.COOKIECUTTERHAT
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.COOKIECUTTERHAT"
msgid "With this spiny gear, I've nothing to fear!"
msgstr "Com esse acessório espinhoso, ninguém me chamará de medroso!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.COOKIECUTTERSHELL
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.COOKIECUTTERSHELL"
msgid "The creature fell, now I take its shell!"
msgstr "Vou pegar a concha da criatura, agora que ela caiu dura!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.COOKINGRECIPECARD.GENERIC
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.COOKINGRECIPECARD.GENERIC"
msgid "How mysterious, the card is blank!"
msgstr "Que misterioso, o cartão está em branco!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.COOKPOT.BURNT
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.COOKPOT.BURNT"
msgid "I don't understand how to make mortal food."
msgstr "Não entendo como fazer comida de mortal."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.COOKPOT.COOKING_LONG
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.COOKPOT.COOKING_LONG"
msgid "It will take quite some time."
msgstr "Vai demorar bastante."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.COOKPOT.COOKING_SHORT
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.COOKPOT.COOKING_SHORT"
msgid "I'm shivering with anticipation!"
msgstr "Estou tremendo de ansiedade!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.COOKPOT.DONE
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.COOKPOT.DONE"
msgid "Looks like my treat is ready to eat!"
msgstr "Parece que minha delícia está pronta pra ser devorada!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.COOKPOT.EMPTY
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.COOKPOT.EMPTY"
msgid "Can souls simmer?"
msgstr "Almas podem fervilhar?"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.COOLANT
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.COOLANT"
msgid "All that trouble for these bubbles."
msgstr "Tantos problemas por bolhas pequenas."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.COONTAIL
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.COONTAIL"
msgid "Better yours than mine."
msgstr "Antes a sua do que a minha."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.CORN
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.CORN"
msgid "I prefer not to ingest food."
msgstr "Prefiro não ingerir comida."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.CORN_COOKED
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.CORN_COOKED"
msgid "I thought it was supposed to pop."
msgstr "Achei que devia estourar."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.CORN_OVERSIZED
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.CORN_OVERSIZED"
msgid "Lend me your ear, hyuyu!"
msgstr "Eu poderia morar num espigão, huehue!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.CORN_SEEDS
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.CORN_SEEDS"
msgid "Grow a seed and you shall feed!"
msgstr "Se uma semente cultivar, poderá se alimentar!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.COSTUME_BLACKSMITH_BODY
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.COSTUME_BLACKSMITH_BODY"
msgid "Hyuyuyu, oh this is a fun game!"
msgstr "Huehuehue, ah, essa é uma brincadeira divertida!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.COSTUME_DOLL_BODY
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.COSTUME_DOLL_BODY"
msgid "Hyuyuyu, oh this is a fun game!"
msgstr "Huehuehue, ah, essa é uma brincadeira divertida!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.COSTUME_FOOL_BODY
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.COSTUME_FOOL_BODY"
msgid "Hyuyuyu, oh this is a fun game!"
msgstr "Huehuehue, ah, essa é uma brincadeira divertida!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.COSTUME_KING_BODY
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.COSTUME_KING_BODY"
msgid "Hyuyuyu, oh this is a fun game!"
msgstr "Huehuehue, ah, essa é uma brincadeira divertida!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.COSTUME_MIRROR_BODY
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.COSTUME_MIRROR_BODY"
msgid "Hyuyuyu, oh this is a fun game!"
msgstr "Huehuehue, ah, essa é uma brincadeira divertida!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.COSTUME_PRINCESS_BODY
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.COSTUME_PRINCESS_BODY"
msgid "A princess must dress for success!"
msgstr "Uma fantasia de princesa digna da realeza!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.COSTUME_QUEEN_BODY
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.COSTUME_QUEEN_BODY"
msgid "Hyuyuyu, oh this is a fun game!"
msgstr "Huehuehue, ah, essa é uma brincadeira divertida!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.COSTUME_TREE_BODY
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.COSTUME_TREE_BODY"
msgid "Hyuyuyu, oh this is a fun game!"
msgstr "Huehuehue, ah, essa é uma brincadeira divertida!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.COTL_TABERNACLE_LEVEL1.GENERIC
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.COTL_TABERNACLE_LEVEL1.GENERIC"
msgid "How it yearns for something to burn."
msgstr "Como isso anseia por algo para queimar."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.COTL_TABERNACLE_LEVEL1.LIT
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.COTL_TABERNACLE_LEVEL1.LIT"
msgid "Let's linger by the light of this little lamb."
msgstr "Vamos nos deter na luz desse carneirinho."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.COTL_TABERNACLE_LEVEL2.GENERIC
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.COTL_TABERNACLE_LEVEL2.GENERIC"
msgid "How it yearns for something to burn."
msgstr "Como isso anseia por algo para queimar."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.COTL_TABERNACLE_LEVEL2.LIT
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.COTL_TABERNACLE_LEVEL2.LIT"
msgid "The lamb is lit, why not stay for a bit?"
msgstr "O carneiro está iluminado, por que não ficar um pouco ao seu lado?"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.COTL_TABERNACLE_LEVEL3.GENERIC
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.COTL_TABERNACLE_LEVEL3.GENERIC"
msgid "How it yearns for something to burn."
msgstr "Como isso anseia por algo para queimar."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.COTL_TABERNACLE_LEVEL3.LIT
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.COTL_TABERNACLE_LEVEL3.LIT"
msgid "The lamb of gold, what a sight to behold."
msgstr "O carneiro de ouro é um verdadeiro tesouro!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.COTL_TRINKET
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.COTL_TRINKET"
msgid "Hyuyu, how tempting!"
msgstr "Huehue, que tentação!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.COZY_BUNNYMAN
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.COZY_BUNNYMAN"
msgid "How have you found your time above-ground?"
msgstr "O que você achou do seu tempo na superfície?"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.CRABKING.GENERIC
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.CRABKING.GENERIC"
msgid "Another cursed soul."
msgstr "Outra alma amaldiçoada."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.CRABKING.INERT
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.CRABKING.INERT"
msgid "This castle is missing its crown jewels."
msgstr "Este castelo está sem suas joias da coroa."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.CRABKING_CANNONTOWER
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.CRABKING_CANNONTOWER"
msgid "Well don't go ballistic, hyuyu!"
msgstr "Vê se não estoura por qualquer coisa, huehue!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.CRABKING_CLAW
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.CRABKING_CLAW"
msgid "Now that's claws for alarm, hyuyuyu!"
msgstr "Quem você pinça que é?! Huehuehue!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.CRABKING_ICEWALL
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.CRABKING_ICEWALL"
msgid "Nothing nice about a wall of ice."
msgstr "Não há muito apelo numa parede de gelo."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.CRABKING_MOB
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.CRABKING_MOB"
msgid "Stay back, bottom feeder!"
msgstr "Pra trás, aproveitador!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.CRABKING_MOB_KNIGHT
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.CRABKING_MOB_KNIGHT"
msgid "I'm surely shell-shocked!"
msgstr "Uma ameaça de carapaça!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.CRITTERLAB
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.CRITTERLAB"
msgid "Ooo, I'd like a partner in pranks."
msgstr "Uuh, eu queria um parceiro para as pegadinhas."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.CRITTER_BULBIN
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.CRITTER_BULBIN"
msgid "Once you dwelt in a rotten wood, now it seems you're here for good!"
msgstr "Depois de numa floresta decadente morar, agora parece que você está aqui para ficar!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.CRITTER_DRAGONLING
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.CRITTER_DRAGONLING"
msgid "Look at you, little firebreather!"
msgstr "Olha só pra você, cuspidorzinho de fogo!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.CRITTER_EETS
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.CRITTER_EETS"
msgid "Jumped a little too far from home now, haven't you mortal?"
msgstr "Pulou um pouco longe de casa, não é mesmo, mortal?"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.CRITTER_EYEOFTERROR
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.CRITTER_EYEOFTERROR"
msgid "I'm glad we could make amends, my ocular friend!"
msgstr "Que bom que conseguimos nos entender, meu amigo ocular!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.CRITTER_GLOMLING
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.CRITTER_GLOMLING"
msgid "What a cute little munchkin you are."
msgstr "Que lindinho que você é."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.CRITTER_KITTEN
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.CRITTER_KITTEN"
msgid "What should our next prank be, little kitty?"
msgstr "Qual vai ser a nossa próxima pegadinha, gatinho?"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.CRITTER_LAMB
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.CRITTER_LAMB"
msgid "Just know that I'm petting you in my mind."
msgstr "Fique sabendo que estou acariciando você na minha mente."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.CRITTER_LUNARMOTHLING
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.CRITTER_LUNARMOTHLING"
msgid "On wings alight comes a fuzzy delight!"
msgstr "Asas que brilham são coisas que me animam!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.CRITTER_PERDLING
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.CRITTER_PERDLING"
msgid "You're so sweet, I could just gobble you up."
msgstr "Que lindeza, eu poderia engolir você."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.CRITTER_PUPPY
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.CRITTER_PUPPY"
msgid "Sorry I can't pet you, little friend."
msgstr "Desculpe, não posso acariciar você, amiguinho."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.CROW.GENERIC
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.CROW.GENERIC"
msgid "Clever trickster."
msgstr "Vigarista espertinho."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.CROW.HELD
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.CROW.HELD"
msgid "Careful, don't touch my hands."
msgstr "Cuidado, não posso tocar com as minhas mãos."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.CRUMBS
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.CRUMBS"
msgid "That's the way the cookie crumbles, hyuyu!"
msgstr "Acabou-se o que era doce, huehue!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.CURSED_MONKEY_TOKEN
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.CURSED_MONKEY_TOKEN"
msgid "Oh me oh my, I couldn't leave it if I tried!"
msgstr "Bada bum, bada bim, isso só quer a mim!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.CUTGRASS
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.CUTGRASS"
msgid "Oh, what I could weave!"
msgstr "Ah, quantas coisas eu poderia tecer!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.CUTLESS
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.CUTLESS"
msgid "It's a cut below the rest."
msgstr "Meus inimigos estão lascados."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.CUTLICHEN
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.CUTLICHEN"
msgid "I'd really rather not eat it."
msgstr "Prefiro mesmo não comer."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.CUTREEDS
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.CUTREEDS"
msgid "One swift yank was all it took."
msgstr "Só foi preciso um puxão rápido."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.CUTSTONE
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.CUTSTONE"
msgid "Brick by brick, they say, they say."
msgstr "Você é o tijolinho que faltava na minha construção."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.DAYWALKER.GENERIC
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.DAYWALKER.GENERIC"
msgid "I'm sensing the answer is foe."
msgstr "Sinto que a resposta é \"inimigo\"."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.DAYWALKER.IMPRISONED
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.DAYWALKER.IMPRISONED"
msgid "Friend or foe?"
msgstr "Amigo ou inimigo?"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.DAYWALKER2.BURIED
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.DAYWALKER2.BURIED"
msgid "Just my luck to find him stuck... again."
msgstr "Outra vez ele atolado, a sorte anda mesmo do meu lado."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.DAYWALKER2.GENERIC
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.DAYWALKER2.GENERIC"
msgid "Freed indeed."
msgstr "Bicho solto."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.DAYWALKER2.HOSTILE
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.DAYWALKER2.HOSTILE"
msgid "Not to belabor, but you've a pattern of behavior."
msgstr "Não é falando mal, mas sua conduta é sempre igual."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.DAYWALKER_PILLAR.EXPOSED
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.DAYWALKER_PILLAR.EXPOSED"
msgid "Why hide this stone inside?"
msgstr "Por que esconder essa pedra dentro?"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.DAYWALKER_PILLAR.GENERIC
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.DAYWALKER_PILLAR.GENERIC"
msgid "A terrible fate, to be locked in this state."
msgstr "É terrível assim ser destinado, a ser trancado e confinado."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.DEADLYFEAST
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.DEADLYFEAST"
msgid "I desire this even less than regular food."
msgstr "Desejo isso ainda menos que comida normal."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.DEAD_SEA_BONES
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.DEAD_SEA_BONES"
msgid "Bones from the sea, these look to be!"
msgstr "Ossos do mar, coisa estranha de se achar!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.DECIDUOUSTREE.BURNING
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.DECIDUOUSTREE.BURNING"
msgid "Twiddle dee dee, a burning tree!"
msgstr "Olhe meu povo, uma árvore pegando fogo!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.DECIDUOUSTREE.BURNT
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.DECIDUOUSTREE.BURNT"
msgid "Well, that was fun."
msgstr "Bem, isso foi divertido."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.DECIDUOUSTREE.CHOPPED
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.DECIDUOUSTREE.CHOPPED"
msgid "A funny tree prank."
msgstr "Uma pegadinha divertida na árvore."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.DECIDUOUSTREE.GENERIC
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.DECIDUOUSTREE.GENERIC"
msgid "Fanciful tree of papery bark."
msgstr "Uma árvore exótica com casca de papel."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.DECIDUOUSTREE.POISON
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.DECIDUOUSTREE.POISON"
msgid "It is no longer bound to the earth!"
msgstr "Não está mais ligada à terra!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.DECK_OF_CARDS
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.DECK_OF_CARDS"
msgid "One sec, who shuffled this deck?"
msgstr "Espera aí, quem embaralhou isso aqui?"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.DECOR_CENTERPIECE
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.DECOR_CENTERPIECE"
msgid "How wonderfully useless!"
msgstr "É maravilhosamente inútil!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.DECOR_FLOWERVASE.EMPTY
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.DECOR_FLOWERVASE.EMPTY"
msgid "There's nothing placed within the vase."
msgstr "Não há nada dentro do vaso."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.DECOR_FLOWERVASE.FRESHLIGHT
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.DECOR_FLOWERVASE.FRESHLIGHT"
msgid "A light so bright I might still see at night!"
msgstr "Uma luz tão brilhante que eu ainda consigo enxergar à noite!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.DECOR_FLOWERVASE.GENERIC
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.DECOR_FLOWERVASE.GENERIC"
msgid "The space in the vase is filled with flowers."
msgstr "O espaço dentro do vaso está repleto de flores."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.DECOR_FLOWERVASE.OLDLIGHT
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.DECOR_FLOWERVASE.OLDLIGHT"
msgid "I'll try not to pout when that light soon goes out."
msgstr "Vou tentar não chorar quando a luz se apagar."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.DECOR_FLOWERVASE.WILTED
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.DECOR_FLOWERVASE.WILTED"
msgid "Tiny flower on the table... you aren't looking very stable."
msgstr "Pequena flor sobre a mesa, não vou ser sua sobremesa."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.DECOR_LAMP
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.DECOR_LAMP"
msgid "This little lamp's light is quite a delight."
msgstr "Esta luminária pequena vale mesmo a pena."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.DECOR_PICTUREFRAME.GENERIC
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.DECOR_PICTUREFRAME.GENERIC"
msgid "A limited edition artist's rendition!"
msgstr "Uma edição limitada de arte premiada!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.DECOR_PICTUREFRAME.UNDRAWN
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.DECOR_PICTUREFRAME.UNDRAWN"
msgid "What a shame, just an empty frame."
msgstr "Quem diria, é só uma moldura vazia."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.DECOR_PORTRAITFRAME
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.DECOR_PORTRAITFRAME"
msgid "A picture perfect portrait."
msgstr "Um retrato perfeito!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.DEER.ANTLER
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.DEER.ANTLER"
msgid "My, what a lovely horn you have!"
msgstr "Nossa, que lindo chifre você tem!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.DEER.GENERIC
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.DEER.GENERIC"
msgid "Greetings, dearest!"
msgstr "Saudações, meu caro!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.DEERCLOPS
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.DEERCLOPS"
msgid "So large, so rude, so full of 'tude!"
msgstr "Tão grande, tão rude, tão cheio de atitude!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.DEERCLOPSCORPSE.BURNING
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.DEERCLOPSCORPSE.BURNING"
msgid "I was just yearning for the smell of burning."
msgstr "Estava ansiando pelo cheiro de algo queimando."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.DEERCLOPSCORPSE.GENERIC
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.DEERCLOPSCORPSE.GENERIC"
msgid "Ol' One-Eyed has gone and died!"
msgstr "O caolho morreu: antes ele do que eu!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.DEERCLOPSCORPSE.REVIVING
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.DEERCLOPSCORPSE.REVIVING"
msgid "A refund? I'm stunned."
msgstr "Uma devolução? Não faço questão."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.DEERCLOPSEYEBALL_SENTRYWARD.GENERIC
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.DEERCLOPSEYEBALL_SENTRYWARD.GENERIC"
msgid "What the eye sees stays icy! Hyuyu!"
msgstr "O que o olho vê fica gelado! Huehue!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.DEERCLOPSEYEBALL_SENTRYWARD.NOEYEBALL
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.DEERCLOPSEYEBALL_SENTRYWARD.NOEYEBALL"
msgid "It turned a blind eye!"
msgstr "Xi, ele fez vista grossa!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.DEERCLOPSEYEBALL_SENTRYWARD_KIT
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.DEERCLOPSEYEBALL_SENTRYWARD_KIT"
msgid "I'll keep my eye on the prize, hyuyu!"
msgstr "Vou ficar de olho no prêmio, huehue!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.DEERCLOPS_EYEBALL
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.DEERCLOPS_EYEBALL"
msgid "Apologies, dear sir."
msgstr "Peço desculpas, meu senhor."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.DEER_ANTLER
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.DEER_ANTLER"
msgid "I like mine better."
msgstr "Gosto mais do meu."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.DEER_GEMMED
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.DEER_GEMMED"
msgid "That's a good look for you!"
msgstr "Estas roupas lhe caem bem!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.DEPLETED_GRASS.GENERIC
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.DEPLETED_GRASS.GENERIC"
msgid "It's gone away for now."
msgstr "Não tem mais por enquanto."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.DESERTHAT
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.DESERTHAT"
msgid "I do so dislike having sand in my face fur."
msgstr "Eu não gosto nada de areia nos pelos do meu rosto."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.DESICCANT
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.DESICCANT"
msgid "Don't cry! It will dry!"
msgstr "Nada de chorar! Isso vai secar!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.DESICCANTBOOSTED
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.DESICCANTBOOSTED"
msgid "A real champ against the damp!"
msgstr "Uma unanimidade quando o assunto é umidade!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.DEVTOOL
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.DEVTOOL"
msgid "It's a prank-maker."
msgstr "É um fazedor de pegadinhas."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.DEVTOOL_NODEV
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.DEVTOOL_NODEV"
msgid "Whoops-a-doodle!"
msgstr "Upa lelê."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.DIRTPILE
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.DIRTPILE"
msgid "I could get my claws in there."
msgstr "Eu poderia enfiar minhas garras aí."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.DIVININGROD.COLD
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.DIVININGROD.COLD"
msgid "The trail's gone cold, I feel cajoled."
msgstr "Isso não é justro, perdi o seu rastro."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.DIVININGROD.GENERIC
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.DIVININGROD.GENERIC"
msgid "It will guide me where I wish to go."
msgstr "Vai me guiar para onde eu quero ir."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.DIVININGROD.HOT
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.DIVININGROD.HOT"
msgid "Red hot! We're near the spot!"
msgstr "Está bem quente! Estamos perto do local!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.DIVININGROD.WARM
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.DIVININGROD.WARM"
msgid "Hey, hey, hey! We're on our way!"
msgstr "Ei, ei, ei! Estamos no caminho certo!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.DIVININGROD.WARMER
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.DIVININGROD.WARMER"
msgid "I have to boast, we're getting close!"
msgstr "Preciso me gabar, estamos perto!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.DIVININGRODBASE.GENERIC
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.DIVININGRODBASE.GENERIC"
msgid "How very, very curious!"
msgstr "É bem interessante mesmo!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.DIVININGRODBASE.READY
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.DIVININGRODBASE.READY"
msgid "Let's hop, skip and jump out of here!"
msgstr "Vamos saltar, pular e sair daqui!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.DIVININGRODBASE.UNLOCKED
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.DIVININGRODBASE.UNLOCKED"
msgid "Ooo, my fur's standing on end in anticipation!"
msgstr "Uhh, estou com os pelos arrepiados esperando ansioso!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.DIVININGRODSTART
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.DIVININGRODSTART"
msgid "And now begins a thrilling game!"
msgstr "E agora começa um jogo emocionante!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.DOCK_KIT
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.DOCK_KIT"
msgid "It would a-pier I have some work to do."
msgstr "Tanto trabalho que cais na minha mão."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.DOCK_WOODPOSTS_ITEM
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.DOCK_WOODPOSTS_ITEM"
msgid "I'll fix it in post, hyuyu!"
msgstr "Vou postar isso no lugar, huehue!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.DOLL_BLUEPRINT
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.DOLL_BLUEPRINT"
msgid "Oh what a dollight! Hyuyu!"
msgstr "Ah, vou poder embonecar meu bífalo, huehue!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.DRAGONBOAT_KIT
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.DRAGONBOAT_KIT"
msgid "Whereabouts to set this boat afloat?"
msgstr "Onde botar o barco a bordo?"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.DRAGONBOAT_PACK
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.DRAGONBOAT_PACK"
msgid "A fully-stocked boat, ready to float!"
msgstr "Um barco completo, pronto pra navegar!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.DRAGONBODYHAT
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.DRAGONBODYHAT"
msgid "Let's play imp in the middle!"
msgstr "Vamos brincar de diabrete bobinho!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.DRAGONCHILISALAD
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.DRAGONCHILISALAD"
msgid "Warly spends a lot of time on this stuff."
msgstr "O Warly passa muito tempo fazendo essa coisa."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.DRAGONFLY
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.DRAGONFLY"
msgid "Fear me! I'm a scary imp!"
msgstr "Temam-me! Sou um diabrete assustador!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.DRAGONFLYCHEST.GENERIC
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.DRAGONFLYCHEST.GENERIC"
msgid "Chest to impress."
msgstr "Baú da libelicidade."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.DRAGONFLYCHEST.UPGRADED_STACKSIZE
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.DRAGONFLYCHEST.UPGRADED_STACKSIZE"
msgid "Scaled-up storage, hyuyu!"
msgstr "Armazenamento extrapolado, huehue!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.DRAGONFLYFURNACE.GENERIC
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.DRAGONFLYFURNACE.GENERIC"
msgid "A cage to hold the dragon's rage."
msgstr "Uma gaiola para prender a fúria da libélula."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.DRAGONFLYFURNACE.HAMMERED
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.DRAGONFLYFURNACE.HAMMERED"
msgid "It lost its glamor to the hammer."
msgstr "Essa martelada não foi piada."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.DRAGONFLYFURNACE.HIGH
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.DRAGONFLYFURNACE.HIGH"
msgid "It burns so bright both day and night."
msgstr "O fogo brilha tanto durante o dia quanto durante a noite."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.DRAGONFLYFURNACE.NORMAL
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.DRAGONFLYFURNACE.NORMAL"
msgid "It burns the right amount, I'd say."
msgstr "Está queimando na medida certa, eu diria."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.DRAGONFRUIT
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.DRAGONFRUIT"
msgid "Plucked fresh from the dragon. Hyuyu!"
msgstr "É pífito o esforço dessa fruta de se manter no solo. Huehue!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.DRAGONFRUIT_COOKED
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.DRAGONFRUIT_COOKED"
msgid "It's been cooked in dragonfire."
msgstr "Assada no fogo cacto."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.DRAGONFRUIT_OVERSIZED
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.DRAGONFRUIT_OVERSIZED"
msgid "A giant fruit, and a dragon's to boot!"
msgstr "Uma fruta gigante e ainda por cima um dragão!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.DRAGONFRUIT_SEEDS
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.DRAGONFRUIT_SEEDS"
msgid "Grow a seed and you shall feed!"
msgstr "Se uma semente cultivar, poderá se alimentar!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.DRAGONHEADHAT
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.DRAGONHEADHAT"
msgid "Me and my horns should be the head!"
msgstr "Eu e meus chifres devemos ser os líderes!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.DRAGONPIE
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.DRAGONPIE"
msgid "Chock full of genuine dragon."
msgstr "Cheinho de vitaminas."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.DRAGONTAILHAT
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.DRAGONTAILHAT"
msgid "Put my tail at the tail end!"
msgstr "Coloque minha cauda bem no fim!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.DRAGON_SCALES
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.DRAGON_SCALES"
msgid "I prefer fur to scales."
msgstr "Prefiro pelo a escamas."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.DREADSTONE
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.DREADSTONE"
msgid "A stone as black as night."
msgstr "Uma pedra sombria como a noite."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.DREADSTONEHAT
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.DREADSTONEHAT"
msgid "A stone fortress for my brain."
msgstr "Uma fortaleza de pedra para meu cérebro."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.DREADSTONE_STACK
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.DREADSTONE_STACK"
msgid "Who knows where it grows from?"
msgstr "Quem sabe de onde isso cresce?"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.DRIFTWOOD_LOG
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.DRIFTWOOD_LOG"
msgid "Naught but a log."
msgstr "Nada além de uma tora."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.DRIFTWOOD_TREE.BURNING
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.DRIFTWOOD_TREE.BURNING"
msgid "Burning, burning, burning down."
msgstr "Queimando, queimando, queimando."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.DRIFTWOOD_TREE.BURNT
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.DRIFTWOOD_TREE.BURNT"
msgid "So much tinder, burnt to cinder."
msgstr "Madeira ressecada acaba carbonizada."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.DRIFTWOOD_TREE.CHOPPED
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.DRIFTWOOD_TREE.CHOPPED"
msgid "It is no more."
msgstr "Já era."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.DRIFTWOOD_TREE.GENERIC
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.DRIFTWOOD_TREE.GENERIC"
msgid "An old, dead tree, beached and bleached."
msgstr "Uma árvore velha e morta, encalhada e desbotada."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.DRUMSTICK
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.DRUMSTICK"
msgid "Ba-dum-chhh!"
msgstr "Mantenha-se à direita!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.DRUMSTICK_COOKED
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.DRUMSTICK_COOKED"
msgid "It's been cooked now."
msgstr "Agora está pronto."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.DUG_BANANABUSH
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.DUG_BANANABUSH"
msgid "Hyuyu, little shrub, are you waving at me?"
msgstr "Huehue, arbustinho, cê tá dando tchau pra mim?"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.DUG_BERRYBUSH
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.DUG_BERRYBUSH"
msgid "A bush out of dirt is like a fish out of water."
msgstr "Um arbusto fora do solo é como um peixe fora d'água."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.DUG_BERRYBUSH_JUICY
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.DUG_BERRYBUSH_JUICY"
msgid "A bush out of dirt is like a fish out of water."
msgstr "Um arbusto fora do solo é como um peixe fora d'água."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.DUG_GRASS
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.DUG_GRASS"
msgid "Put it back in the dirt, before it gets hurt!"
msgstr "Coloque de volta no solo antes que se machuque!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.DUG_MARSH_BUSH
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.DUG_MARSH_BUSH"
msgid "Put it back in the dirt, before it gets hurt!"
msgstr "Coloque de volta no solo antes que se machuque!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.DUG_MONKEYTAIL
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.DUG_MONKEYTAIL"
msgid "How funny, a plant that apes monkeys!"
msgstr "Que engraçado, um caco de macaco!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.DUG_SAPLING
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.DUG_SAPLING"
msgid "Put it back in the dirt, before it gets hurt!"
msgstr "Coloque de volta no solo antes que se machuque!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.DUG_TRAP_STARFISH
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.DUG_TRAP_STARFISH"
msgid "Planting this would be a devilish trick."
msgstr "Armar isso seria uma pegadinha diabólica."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.DUMBBELL
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.DUMBBELL"
msgid "It's neither dumb, nor a bell. Mortals are strange, indeed."
msgstr "Pesos no espeto. Os mortais são criaturas realmente estranhas."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.DUMBBELL_BLUEGEM
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.DUMBBELL_BLUEGEM"
msgid "It'll knock you out cold, hyuyuyu!"
msgstr "Vou te derrubar a sangue-frio, huehue!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.DUMBBELL_GEM
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.DUMBBELL_GEM"
msgid "He's turned those gemstones into gymstones, hyuyu!"
msgstr "Ele transformou as pedras preciosas em pesos preciosos, huehue!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.DUMBBELL_GOLDEN
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.DUMBBELL_GOLDEN"
msgid "It's neither dumb, nor a bell. Mortals are strange, indeed."
msgstr "Pesos no espeto. Os mortais são criaturas realmente estranhas."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.DUMBBELL_HEAT
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.DUMBBELL_HEAT"
msgid "A warm stone for muscle tone."
msgstr "Esta pedra quente fortalece a gente."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.DUMBBELL_MARBLE
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.DUMBBELL_MARBLE"
msgid "Marbellous, simply marbellous!"
msgstr "Uma escultura de pesos no espeto."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.DUMBBELL_REDGEM
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.DUMBBELL_REDGEM"
msgid "Fire and gym stone!"
msgstr "Pedra chamejante de academia!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.DURIAN
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.DURIAN"
msgid "I love a good stink!"
msgstr "Gosto de um fedorzinho!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.DURIAN_COOKED
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.DURIAN_COOKED"
msgid "Don't mind if I do-rian."
msgstr "Sua vida deve ser bem dúria."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.DURIAN_OVERSIZED
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.DURIAN_OVERSIZED"
msgid "It gives off such a stink, it's hard to think!"
msgstr "Com esse fedor de arrasar fica difícil pensar!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.DURIAN_SEEDS
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.DURIAN_SEEDS"
msgid "Let's give them some soil, before they spoil."
msgstr "Vamos colocar no solo, antes que estrague."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.DUSTMERINGUE
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.DUSTMERINGUE"
msgid "Hyuyuyu! The pranks I could pull with these!"
msgstr "Huehue! As brincadeiras que eu poderia fazer com isso!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.DUSTMOTH
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.DUSTMOTH"
msgid "That charming creature nearly swept me off my feet, hyuyu!"
msgstr "Essa criatura levanta, sacode a poeira e dá a volta por cima, huehue!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.DUSTMOTHDEN
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.DUSTMOTHDEN"
msgid "I'm afraid their nest has something I wish to possess."
msgstr "O ninho delas, eu receio, tem algo pelo qual anseio."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.EARMUFFSHAT
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.EARMUFFSHAT"
msgid "They weren't made for floppy ears."
msgstr "Não foram feitas para orelhas grandes."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.EEL
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.EEL"
msgid "A slippery soul, that one."
msgstr "Uma alma escorregadia, essa aí."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.EEL_COOKED
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.EEL_COOKED"
msgid "I'd rather not put that in my flesh body."
msgstr "Prefiro não colocar isso no meu corpo de carne."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.EGGPLANT
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.EGGPLANT"
msgid "I've never seen such a thing before!"
msgstr "Nunca vi uma coisa dessas antes."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.EGGPLANT_COOKED
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.EGGPLANT_COOKED"
msgid "My favorite treat... it can't be beat!"
msgstr "Minha delícia favorita... nada supera!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.EGGPLANT_OVERSIZED
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.EGGPLANT_OVERSIZED"
msgid "How strange!"
msgstr "Que estranho!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.EGGPLANT_SEEDS
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.EGGPLANT_SEEDS"
msgid "Let's give them some soil, before they spoil."
msgstr "Vamos colocar no solo, antes que estrague."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.ELIXIR_CONTAINER
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.ELIXIR_CONTAINER"
msgid "Any mixers for those elixirs?"
msgstr "Que tal mexer esses elixires?"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.EMBERLIGHT
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.EMBERLIGHT"
msgid "Aren't you a bit big for a will-o'-the-wisp?"
msgstr "Você não é meio grandinho pra um fogo-fátuo?"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.ENDTABLE.BURNT
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.ENDTABLE.BURNT"
msgid "That was hardly necessary."
msgstr "Não tinha nenhuma necessidade disso."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.ENDTABLE.EMPTY
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.ENDTABLE.EMPTY"
msgid "Now now, let's set the table."
msgstr "Pronto, vamos botar a mesa."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.ENDTABLE.FRESHLIGHT
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.ENDTABLE.FRESHLIGHT"
msgid "A light so bright I might still see at night!"
msgstr "Uma luz tão brilhante que eu ainda consigo enxergar à noite!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.ENDTABLE.GENERIC
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.ENDTABLE.GENERIC"
msgid "I never learned my table manners."
msgstr "Nunca aprendi como me comportar à mesa."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.ENDTABLE.OLDLIGHT
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.ENDTABLE.OLDLIGHT"
msgid "I'll try not to pout when that light soon goes out."
msgstr "Vou tentar não chorar quando a luz se apagar."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.ENDTABLE.WILTED
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.ENDTABLE.WILTED"
msgid "Tiny flower on the table... you aren't looking very stable."
msgstr "Pequena flor sobre a mesa, não vou ser sua sobremesa."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.EVERGREEN.BURNING
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.EVERGREEN.BURNING"
msgid "Twiddle dee dee, a burning tree!"
msgstr "Olhe meu povo, uma árvore pegando fogo!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.EVERGREEN.BURNT
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.EVERGREEN.BURNT"
msgid "Well, that was fun."
msgstr "Bem, isso foi divertido."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.EVERGREEN.CHOPPED
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.EVERGREEN.CHOPPED"
msgid "A funny tree prank."
msgstr "Uma pegadinha divertida na árvore."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.EVERGREEN.GENERIC
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.EVERGREEN.GENERIC"
msgid "A hearty tree of dark green leaves."
msgstr "Uma árvore sadia com folhas verdes escuras."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.EVERGREEN_SPARSE.BURNING
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.EVERGREEN_SPARSE.BURNING"
msgid "Twiddle dee dee, a burning tree!"
msgstr "Olhe meu povo, uma árvore pegando fogo!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.EVERGREEN_SPARSE.BURNT
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.EVERGREEN_SPARSE.BURNT"
msgid "Well, that was fun."
msgstr "Bem, isso foi divertido."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.EVERGREEN_SPARSE.CHOPPED
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.EVERGREEN_SPARSE.CHOPPED"
msgid "A funny tree prank."
msgstr "Uma pegadinha divertida na árvore."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.EVERGREEN_SPARSE.GENERIC
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.EVERGREEN_SPARSE.GENERIC"
msgid "A mournful tree full of lumps and bumps."
msgstr "Uma árvore triste cheia de caroços e protuberâncias."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.EYEBRELLAHAT
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.EYEBRELLAHAT"
msgid "A cyclops' sight stretched mighty thin."
msgstr "A visão de um ciclope esticada ao máximo."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.EYEMASKHAT
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.EYEMASKHAT"
msgid "Well, isn't this a sight for sore eyes. Hyuyuyu!"
msgstr "Olha só que colírio para os olhos. Huehuehue!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.EYEOFTERROR
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.EYEOFTERROR"
msgid "Whatever he says I did, it's a lie!"
msgstr "Se ele disse que me viu fazendo algo, é mentira!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.EYEOFTERROR_MINI
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.EYEOFTERROR_MINI"
msgid "I feel positively terror eyes'd!"
msgstr "Me sinto absolutamente aterrorizóio!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.EYEOFTERROR_MINI_GROUNDED
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.EYEOFTERROR_MINI_GROUNDED"
msgid "Oh my, won't you open your eye?"
msgstr "Ei, pimpolho, não vai abrir seu olho?"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.EYEPLANT
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.EYEPLANT"
msgid "My oh my, what a lovely eye."
msgstr "Puxa vida, que olho mais lindo."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.EYETURRET
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.EYETURRET"
msgid "Oh me oh my, look at that eye!"
msgstr "Oh, puxa, olha só esse olho!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.EYETURRET_ITEM
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.EYETURRET_ITEM"
msgid "To build it would be all it took to fell my foes by deadly look."
msgstr "Eu só precisaria construir isso para derrubar meus inimigos com um olhar mortal."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.FARMPLOT.BURNT
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.FARMPLOT.BURNT"
msgid "A silly prank to be sure."
msgstr "Uma brincadeira sem graça com certeza."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.FARMPLOT.GENERIC
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.FARMPLOT.GENERIC"
msgid "Mortal food maker."
msgstr "Fazedor de comida de mortais."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.FARMPLOT.GROWING
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.FARMPLOT.GROWING"
msgid "The mortals are making mortal food."
msgstr "Os mortais estão fazendo comida de mortal."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.FARMPLOT.NEEDSFERTILIZER
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.FARMPLOT.NEEDSFERTILIZER"
msgid "The semi-formed food is hungry."
msgstr "A comida semi-formada está com fome."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.FARM_HOE
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.FARM_HOE"
msgid "I've about had my fill of tilling and toiling."
msgstr "Já estou farto de arar e labutar."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.FARM_PLANT.BURNING
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.FARM_PLANT.BURNING"
msgid "Hyuyuyu, whoopsie!"
msgstr "Huehue, ops!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.FARM_PLANT.FULL
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.FARM_PLANT.FULL"
msgid "Oh what a sight, the crops are ripe!"
msgstr "Ah, que belezura, a plantação está madura!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.FARM_PLANT.FULL_OVERSIZED
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.FARM_PLANT.FULL_OVERSIZED"
msgid "If only I cared to eat mortal food!"
msgstr "Quem dera eu gostasse das comidas dos mortais!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.FARM_PLANT.FULL_WEED
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.FARM_PLANT.FULL_WEED"
msgid "It's a weed indeed! Hyuyuyu!"
msgstr "E não é que tinha erva-daninha? Huehue!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.FARM_PLANT.GENERIC
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.FARM_PLANT.GENERIC"
msgid "A plant!"
msgstr "Uma planta!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.FARM_PLANT.GROWING
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.FARM_PLANT.GROWING"
msgid "Grow big and tall, or not at all."
msgstr "Fique grande e forte, ou não terá boa sorte."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.FARM_PLANT.ROTTEN
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.FARM_PLANT.ROTTEN"
msgid "Even the mortals won't eat this one."
msgstr "Nem os mortais vão comer isso."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.FARM_PLANT.ROTTEN_OVERSIZED
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.FARM_PLANT.ROTTEN_OVERSIZED"
msgid "This one's spoiled rotten!"
msgstr "Apodreceu totalmente!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.FARM_PLANT.SEED
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.FARM_PLANT.SEED"
msgid "Come out and join us, little one!"
msgstr "Saia e junte-se a nós, pequenina!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.FARM_PLOW
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.FARM_PLOW"
msgid "Plowing a plot for picky plants."
msgstr "Arando uma área altamente auspiciosa à agricultura."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.FARM_PLOW_ITEM
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.FARM_PLOW_ITEM"
msgid "All work and no play makes for one unhappy imp."
msgstr "Tanto trabalho e nenhuma diversão deixa qualquer diabrete em depressão."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.FARM_SOIL_DEBRIS
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.FARM_SOIL_DEBRIS"
msgid "I'm afraid I'll have to banish it from the garden."
msgstr "Receio que terei que bani-lo do jardim."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.FEATHERFAN
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.FEATHERFAN"
msgid "It makes a big gust. What's all the fuss?"
msgstr "Produz uma rajada forte. Será minha sorte?"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.FEATHERHAT
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.FEATHERHAT"
msgid "Feathers and horns go well together."
msgstr "Penas e chifres combinam bem."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.FEATHERPENCIL
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.FEATHERPENCIL"
msgid "Use this quill, I will, I will."
msgstr "Use este lápis, não tenha pena."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.FEATHER_CANARY
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.FEATHER_CANARY"
msgid "A token, to remember its sweet song by."
msgstr "Um símbolo, para lembrar de sua doce canção."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.FEATHER_CROW
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.FEATHER_CROW"
msgid "A memento of my jet feathered friend."
msgstr "Uma lembrança de meu amigo de penas negras."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.FEATHER_ROBIN
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.FEATHER_ROBIN"
msgid "To remind myself of its sweet beaky face."
msgstr "Para eu me lembrar de seu lindo rosto bicoso."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.FEATHER_ROBIN_WINTER
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.FEATHER_ROBIN_WINTER"
msgid "A keepsake of a gentle blue friend."
msgstr "Uma lembrança de um amigo azul gentil."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.FEM_PUPPET
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.FEM_PUPPET"
msgid "Greetings and salutations, ma'am."
msgstr "Cumprimentos e saudações, senhora."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.FENCE
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.FENCE"
msgid "To keep you out, or keep me in?"
msgstr "Para prender você aí dentro, ou para me deixar aqui fora?"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.FENCE_ELECTRIC.GENERIC
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.FENCE_ELECTRIC.GENERIC"
msgid "Don't think it's linked."
msgstr "Conectado, não parece estar."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.FENCE_ELECTRIC.LINKED
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.FENCE_ELECTRIC.LINKED"
msgid "Think it's linked."
msgstr "Acho que está conectado."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.FENCE_ELECTRIC_ITEM
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.FENCE_ELECTRIC_ITEM"
msgid "Yet to set."
msgstr "Ainda não se põe."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.FENCE_GATE
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.FENCE_GATE"
msgid "For temporary visiting."
msgstr "Para uma visita temporária."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.FENCE_GATE_ITEM
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.FENCE_GATE_ITEM"
msgid "It's of no use there on the ground."
msgstr "Não tem utilidade no chão."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.FENCE_ITEM
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.FENCE_ITEM"
msgid "It's of no use there on the ground."
msgstr "Não tem utilidade no chão."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.FENCE_JUNK
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.FENCE_JUNK"
msgid "A metal fence for our defense."
msgstr "Uma cerca de metal com proteção total."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.FENCE_ROTATOR
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.FENCE_ROTATOR"
msgid "A sword against fences... we've all lost our senses!"
msgstr "Uma espada contra cercas... que minha cabeça eu não perca!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.FERTILIZER
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.FERTILIZER"
msgid "Hyuyu! That's some poo!"
msgstr "Huehue! Que cocozão!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.FESTIVEFISH
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.FESTIVEFISH"
msgid "Nothing fishy here at all, hyuyu!"
msgstr "Nem tem cheiro forte de peixe aqui, huehue!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.FESTIVE_BLUEPRINT
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.FESTIVE_BLUEPRINT"
msgid "My friend can frolic in this festive frock!"
msgstr "Meu amigo vai ficar mais efusivo neste traje festivo!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.FIG
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.FIG"
msgid "They say the low hanging fruit is the sweetest!"
msgstr "Dizem que a fruta mais doce é a que está mais embaixo!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.FIGATONI
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.FIGATONI"
msgid "I'll pass."
msgstr "Passo."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.FIGKABAB
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.FIGKABAB"
msgid "Food on a stick won't do the trick."
msgstr "Comida no espeto não me tira do aperto."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.FIG_COOKED
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.FIG_COOKED"
msgid "The mortals seem to prefer it this way."
msgstr "Os mortais parecem preferir deste jeito."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.FIREBALLSTAFF
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.FIREBALLSTAFF"
msgid "Ooohoo, how delightfully chaotic!"
msgstr "Uuhuu!, que deliciosamente caótico!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.FIRECRACKERS
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.FIRECRACKERS"
msgid "Pop, pop!"
msgstr "Bum, bum!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.FIREFLIES.GENERIC
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.FIREFLIES.GENERIC"
msgid "Some natural light to grant me sight."
msgstr "Uma luz natural para me dar a visão."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.FIREFLIES.HELD
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.FIREFLIES.HELD"
msgid "Little jittery, fluttery souls."
msgstr "Almas flutuantes agitadas."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.FIREHOUND
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.FIREHOUND"
msgid "Hyuyu, fiery!"
msgstr "Huehue, fogoso!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.FIRENETTLES
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.FIRENETTLES"
msgid "Oh ho! Fiery indeed!"
msgstr "Oh, ho! É mesmo ardente!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.FIRENETTLES_DRIED
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.FIRENETTLES_DRIED"
msgid "I'd eyed it'd dried."
msgstr "Será que as sequei quando eu olhei?"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.FIREPEN
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.FIREPEN"
msgid "Hyuyuyu, the old flaming pen prank!"
msgstr "Huehuehue, o velho truque da caneta flamejante!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.FIREPIT.EMBERS
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.FIREPIT.EMBERS"
msgid "Soon to extinguish."
msgstr "Logo se extinguirá."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.FIREPIT.GENERIC
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.FIREPIT.GENERIC"
msgid "This fire will slake my thirst for warmth."
msgstr "Esse fogo vai satisfazer minha sede de calor."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.FIREPIT.HIGH
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.FIREPIT.HIGH"
msgid "Those are some spicy flames."
msgstr "Por que me chamas?"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.FIREPIT.LOW
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.FIREPIT.LOW"
msgid "It burns so low, so low!"
msgstr "Me chama baixinho agora!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.FIREPIT.NORMAL
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.FIREPIT.NORMAL"
msgid "When I roam, camp feels like home."
msgstr "Quando ando por aí, um acampamento é como minha casa."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.FIREPIT.OUT
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.FIREPIT.OUT"
msgid "And out it goes."
msgstr "E lá se vai."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.FIRESTAFF
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.FIRESTAFF"
msgid "It makes fire by its own magic."
msgstr "Faz fogo com sua magia própria."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.FIRESUPPRESSOR.LOWFUEL
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.FIRESUPPRESSOR.LOWFUEL"
msgid "It hungers for souls! Or fuel."
msgstr "Tem fome de almas! Ou combustível."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.FIRESUPPRESSOR.OFF
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.FIRESUPPRESSOR.OFF"
msgid "Dead to the world."
msgstr "Morto para o mundo."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.FIRESUPPRESSOR.ON
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.FIRESUPPRESSOR.ON"
msgid "It is ready to fling at a moment's notice."
msgstr "Está pronto para funcionar assim que preciso."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.FISH
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.FISH"
msgid "You are quite fragrant."
msgstr "Você tem um cheiro bem característico."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.FISHINGNET
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.FISHINGNET"
msgid "A riddle! What might one cast that's not a spell?"
msgstr "Uma charada! O que se pode lançar e não é um feitiço?"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.FISHINGROD
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.FISHINGROD"
msgid "A mortal pastime."
msgstr "Um passatempo de mortal."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.FISHMEAT
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.FISHMEAT"
msgid "Looks like the soul's already left this one."
msgstr "Parece que esse daqui já não tem mais alma."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.FISHMEAT_COOKED
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.FISHMEAT_COOKED"
msgid "I do not wish to eat this fish."
msgstr "Nem que me deixe eu vou comer esse peixe."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.FISHMEAT_DRIED
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.FISHMEAT_DRIED"
msgid "So delish, this dried fish!"
msgstr "Tão gostosinho esse peixe sequinho!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.FISHMEAT_SMALL
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.FISHMEAT_SMALL"
msgid "Looks like the soul's already left this one."
msgstr "Parece que esse daqui já não tem mais alma."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.FISHMEAT_SMALL_COOKED
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.FISHMEAT_SMALL_COOKED"
msgid "I do not wish to eat this fish."
msgstr "Nem que me deixe eu vou comer esse peixe."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.FISHMEAT_SMALL_DRIED
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.FISHMEAT_SMALL_DRIED"
msgid "So delish, this dried fish!"
msgstr "Tão gostosinho esse peixe sequinho!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.FISHSTICKS
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.FISHSTICKS"
msgid "No thank-you."
msgstr "Não, agradeço."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.FISHTACOS
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.FISHTACOS"
msgid "More mortal food."
msgstr "Mais comida de mortal."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.FISH_BOX
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.FISH_BOX"
msgid "Fill it to the brim with bream!"
msgstr "Encha isso de pescados!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.FISH_COOKED
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.FISH_COOKED"
msgid "At least it isn't suffering anymore."
msgstr "Pelo menos não está mais sofrendo."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.FLINT
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.FLINT"
msgid "My eye was caught by its dull glint."
msgstr "Meu olho foi capturado por seu brilho fastidioso."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.FLOATINGLANTERN.DEFLATED
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.FLOATINGLANTERN.DEFLATED"
msgid "On the ground, no more floating around."
msgstr "No chão, acabou a flutuação."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.FLOATINGLANTERN.GENERIC
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.FLOATINGLANTERN.GENERIC"
msgid "I spy with my impish eye, something glowing high in the sky!"
msgstr "Vislumbro com meu olho de diabrete algo brilhando no alto da abóbada celeste!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.FLOATINGLANTERN.HELD
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.FLOATINGLANTERN.HELD"
msgid "Shall I say goodbye and let it fly?"
msgstr "Devo me despedir e deixar ele partir?"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.FLOTATIONCUSHION
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.FLOTATIONCUSHION"
msgid "Because there's no time to think, when you're plunged in the drink!"
msgstr "Porque não há tempo para pensar, quando se está submerso no mar!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.FLOWER.GENERIC
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.FLOWER.GENERIC"
msgid "Perfumed petals to pick and pluck."
msgstr "Pétalas perfumadas para colher e arrancar."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.FLOWER.ROSE
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.FLOWER.ROSE"
msgid "It's as red as I am."
msgstr "É tão vermelha quanto eu."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.FLOWERHAT
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.FLOWERHAT"
msgid "I'll place a crown upon my head to ward away the growing dread."
msgstr "Uma coroa na minha cabeça vou colocar, para o pavor crescente afastar."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.FLOWERSALAD
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.FLOWERSALAD"
msgid "I don't really like eating."
msgstr "Não gosto muito de comer."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.FLOWER_CAVE
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.FLOWER_CAVE"
msgid "How kind of you to light my way."
msgstr "Que generosidade a sua iluminar o meu caminho."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.FLOWER_CAVE_WITHERED
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.FLOWER_CAVE_WITHERED"
msgid "The light will not last."
msgstr "A luz não vai durar."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.FLOWER_EVIL
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.FLOWER_EVIL"
msgid "It's not its fault it's evil."
msgstr "Não é culpa sua ser mau."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.FLOWER_WITHERED
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.FLOWER_WITHERED"
msgid "Farewell sweet petals."
msgstr "Adeus, queridas pétalas."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.FOLIAGE
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.FOLIAGE"
msgid "Purpled leaves from down below."
msgstr "Folhas roxas das profundezas."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.FOLIAGE_DRIED
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.FOLIAGE_DRIED"
msgid "I'd eyed it'd dried."
msgstr "Será que a sequei quando eu olhei?"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.FOOTBALLHAT
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.FOOTBALLHAT"
msgid "I hope I don't get helmet horns."
msgstr "Espero não ganhar chifres de capacete."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.FORGETMELOTS
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.FORGETMELOTS"
msgid "They seems to have a tinge of magic about them."
msgstr "Elas parecem ter um toque de magia."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.FORGETMELOTS_DRIED
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.FORGETMELOTS_DRIED"
msgid "I'd eyed it'd dried."
msgstr "Será que a sequei quando eu olhei?"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.FORMAL_BLUEPRINT
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.FORMAL_BLUEPRINT"
msgid "But will it really suit my beefalo? Hyuyu!"
msgstr "Agora é que meu bífalo não vai pro brejo! Huehue!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.FOSSIL_PIECE
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.FOSSIL_PIECE"
msgid "A little piece of a great big beast."
msgstr "Um pedacinho de uma grande fera."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.FOSSIL_STALKER.COMPLETE
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.FOSSIL_STALKER.COMPLETE"
msgid "That looks right as rain, it does it does!"
msgstr "Parece que está certinho, aham, está!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.FOSSIL_STALKER.FUNNY
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.FOSSIL_STALKER.FUNNY"
msgid "A silly look, that's to be sure!"
msgstr "Uma aparência boba, bem boba!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.FOSSIL_STALKER.GENERIC
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.FOSSIL_STALKER.GENERIC"
msgid "Still could use a piece or two."
msgstr "Acho que encaixaria uma peça ou duas."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.FRESHFRUITCREPES
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.FRESHFRUITCREPES"
msgid "Fruits and berries put to bed."
msgstr "Frutas e bagas enroladas num cobertor."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.FRIENDLYFRUITFLY
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.FRIENDLYFRUITFLY"
msgid "This fly has a much more tempered temper."
msgstr "Esta mosca tem um temperamento temperante."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.FROG.DEAD
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.FROG.DEAD"
msgid "I am sorry! So sorry!"
msgstr "Desculpe! Me desculpe!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.FROG.GENERIC
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.FROG.GENERIC"
msgid "I hop, you hop. Friends til the end!"
msgstr "Eu salto, você salta. Amigos até o fim!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.FROG.SLEEPING
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.FROG.SLEEPING"
msgid "Sleep fast little hopper."
msgstr "Durma bem, saltadorzinho."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.FROGFISHBOWL
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.FROGFISHBOWL"
msgid "I'd rather have a nice fresh soul."
msgstr "Eu preferia uma alma fresquinha."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.FROGGLEBUNWICH
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.FROGGLEBUNWICH"
msgid "Mortals are weird."
msgstr "Os mortais são estranhos."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.FROGLEGS
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.FROGLEGS"
msgid "To hop no more."
msgstr "Não mais saltará."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.FROGLEGS_COOKED
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.FROGLEGS_COOKED"
msgid "Definitely no more hopping."
msgstr "Definitivamente, não saltará mais."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.FROGNEWTON
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.FROGNEWTON"
msgid "How do the mortals come up with these things?"
msgstr "Como os mortais inventam essas coisas?"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.FROZENBANANADAIQUIRI
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.FROZENBANANADAIQUIRI"
msgid "Don't the mortals like to innovate? Hyuyu."
msgstr "Os mortais gostam de inovar, não é? Huehue."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.FRUITDRAGON.GENERIC
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.FRUITDRAGON.GENERIC"
msgid "Little lizard, sharp and pointy!"
msgstr "Lagartinho afiado e pontudo!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.FRUITDRAGON.RIPE
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.FRUITDRAGON.RIPE"
msgid "That color looks great on you, hyuyu!"
msgstr "Essa cor fica ótima em você, huehue!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.FRUITDRAGON.SLEEPING
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.FRUITDRAGON.SLEEPING"
msgid "Hyuyu, catching some shuteye are we?"
msgstr "Huehue, tirando uma soneca, hein?"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.FRUITFLY
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.FRUITFLY"
msgid "Pulling pranks on the plants, I see!"
msgstr "Vejo que está pregando peças nas plantas!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.FRUITFLYFRUIT
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.FRUITFLYFRUIT"
msgid "I'll just put that in my pocket and see what happens!"
msgstr "Vou botar isso no meu bolso e ver o que acontece!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.FRUITMEDLEY
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.FRUITMEDLEY"
msgid "The mortals threw a bunch of plants together."
msgstr "Os mortais juntaram um monte de plantas."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.FUMAROLEAXE.GENERIC
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.FUMAROLEAXE.GENERIC"
msgid "The cracks are beginning to show, hyuyu!"
msgstr "As rachaduras estão começando a aparecer, huehue!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.FUMAROLEAXE.HOT
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.FUMAROLEAXE.HOT"
msgid "Its heat can't be beat."
msgstr "Com esse calor, só resta a dor."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.FUMAROLEAXE.LUKEWARM
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.FUMAROLEAXE.LUKEWARM"
msgid "What's the harm? It's barely warm!"
msgstr "Quem é que riu? Ficou quase frio!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.FUMAROLEAXE.WARM
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.FUMAROLEAXE.WARM"
msgid "It keeps the cold from taking hold."
msgstr "Impede o gelo com esmero."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.FUMAROLEHAMMER.GENERIC
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.FUMAROLEHAMMER.GENERIC"
msgid "The cracks are beginning to show, hyuyu!"
msgstr "As rachaduras estão começando a aparecer, huehue!"

