msgstr "only_used_by_warly"

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_FREEDOM
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_FREEDOM"
msgid "Freedom, at last!"
msgstr "Liberdade, finalmente!"

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_GATHER_MERM
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_GATHER_MERM"
msgid "only_used_by_wurt"
msgstr "only_used_by_wurt"

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_GHOSTDRAIN
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_GHOSTDRAIN"
msgid "They're whispering through the core of my mind...!"
msgstr "Estão sussurrando através do centro da minha mente...!"

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_GHOST_QUEST
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_GHOST_QUEST"
msgid "only_used_by_wendy"
msgstr "only_used_by_wendy"

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_GOT_DECON_MISTED
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_GOT_DECON_MISTED"
msgid "Ugh! It burns!"
msgstr "Ugh! Isso queima."

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_HEALINGSALVE_ACIDBUFF_DONE
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_HEALINGSALVE_ACIDBUFF_DONE"
msgid "I'd better not take a stroll in the acid rain anytime soon."
msgstr "Melhor eu não sair debaixo de chuva ácida tão cedo."

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_HEALINGSALVE_FUMAROLEBUFF_DONE
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_HEALINGSALVE_FUMAROLEBUFF_DONE"
msgid "There goes my protection against the fire."
msgstr "Lá se foi minha proteção contra o fogo."

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_HERMITCRAB_SHELL_ARRIVE
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_HERMITCRAB_SHELL_ARRIVE"
msgid "I can't believe it worked."
msgstr "Não acredito que deu certo."

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_HERMITCRAB_SHELL_BADTELEPORTPOINT
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_HERMITCRAB_SHELL_BADTELEPORTPOINT"
msgid "Surprise, surprise."
msgstr "Surpresa, surpresa."

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_HIGHRESEARCH
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_HIGHRESEARCH"
msgid "My brain swells with power!"
msgstr "Meu cérebro incha com poder!"

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_HOT
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_HOT"
msgid "My heart can't stand the heat!"
msgstr "Meu coração não aguenta o calor!"

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_HOUNDS
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_HOUNDS"
msgid "The hounds are growing restless."
msgstr "Os cães estão ficando inquietos."

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_HUNGRY
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_HUNGRY"
msgid "I am empty inside."
msgstr "Estou vazio por dentro."

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_HUNT_AVOID_FORK
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_HUNT_AVOID_FORK"
msgid "I'll stick to hunting less dangerous game."
msgstr "Prefiro caçar presas menos perigosas."

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_HUNT_BEAST_NEARBY
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_HUNT_BEAST_NEARBY"
msgid "I smell dung and beast sweat."
msgstr "Sinto cheiro de estrume e suor de bicho."

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_HUNT_LOST_TRAIL
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_HUNT_LOST_TRAIL"
msgid "Drat! It got away."
msgstr "Droga! Conseguiu fugiu."

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_HUNT_LOST_TRAIL_SPRING
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_HUNT_LOST_TRAIL_SPRING"
msgid "I can't follow it in these conditions!"
msgstr "Não posso segui-lo nessas condições!"

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_HUNT_START_FORK
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_HUNT_START_FORK"
msgid "Those vicious claw marks do not bode well..."
msgstr "Essas marcas de garra terríveis não são um bom presságio..."

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_HUNT_SUCCESSFUL_FORK
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_HUNT_SUCCESSFUL_FORK"
msgid "The creature is unaware it's being pursued. Now, to strike."
msgstr "A criatura não sabe que está sendo perseguida. Agora, ao ataque."

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_HUNT_WRONG_FORK
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_HUNT_WRONG_FORK"
msgid "I fear I might have underestimated my prey..."
msgstr "Receio ter subestimado minha presa..."

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_INSUFFICIENTFERTILIZER
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_INSUFFICIENTFERTILIZER"
msgid "It perked up just a tiny bit."
msgstr "Deu uma levantadinha de leve."

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_INV_FULL
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_INV_FULL"
msgid "My pockets are full."
msgstr "Meus bolsos estão cheios."

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_IS_FEASTING
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_IS_FEASTING"
msgid "At last, a decent meal."
msgstr "Até que enfim, uma refeição decente."

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_KITCOON_FOUND_IN_THE_WILD
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_KITCOON_FOUND_IN_THE_WILD"
msgid "So you're the source of that pathetic mewling. I'll have to apologize to the strongman."
msgstr "Então você era a fonte daquele choramingo patético. Vou ter que me desculpar ao halterofilista."

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_KITCOON_HIDANDSEEK_FOUND.1
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_KITCOON_HIDANDSEEK_FOUND.1"
msgid "A-ha! Not sneaky enough!"
msgstr "A-ha! Você não foi sorrateiro o bastante!"

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_KITCOON_HIDANDSEEK_FOUND.2
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_KITCOON_HIDANDSEEK_FOUND.2"
msgid "Found you!"
msgstr "Achei!"

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_KITCOON_HIDANDSEEK_FOUND.3
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_KITCOON_HIDANDSEEK_FOUND.3"
msgid "You were not clever enough to best the great Maxwell!!"
msgstr "Você não foi sagaz o bastante para superar o grande Maxwell!"

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_KITCOON_HIDANDSEEK_FOUND.4
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_KITCOON_HIDANDSEEK_FOUND.4"
msgid "Your attempt to escape me has been thwarted, child!"
msgstr "Sua tentativa de fugir de mim foi frustrada, criança!"

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_KITCOON_HIDANDSEEK_FOUND_LAST_ONE
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_KITCOON_HIDANDSEEK_FOUND_LAST_ONE"
msgid "A-ha! That was the last one! I win!!!"
msgstr "A-ha! Esse era o último! Eu venci!!!"

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_KITCOON_HIDANDSEEK_FOUND_LAST_ONE_TEAM
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_KITCOON_HIDANDSEEK_FOUND_LAST_ONE_TEAM"
msgid "I had seen it already, but {name} got to it first, I suppose."
msgstr "Eu já havia visto ele, mas suponho que {name} chegou nele primeiro."

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_KITCOON_HIDANDSEEK_FOUND_ONE_MORE
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_KITCOON_HIDANDSEEK_FOUND_ONE_MORE"
msgid "Only one remains."
msgstr "Só resta um."

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_KITCOON_HIDANDSEEK_LOSEGAME
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_KITCOON_HIDANDSEEK_LOSEGAME"
msgid "Blast it!"
msgstr "Que droga!"

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_KITCOON_HIDANDSEEK_TIME_ALMOST_UP
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_KITCOON_HIDANDSEEK_TIME_ALMOST_UP"
