msgstr "Oh, as coisas que vou aprender!"

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.RESEARCHLAB3.BURNT
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.RESEARCHLAB3.BURNT"
