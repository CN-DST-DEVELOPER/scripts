msgstr "O roxo é o meu sabor favorito."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.HERMITCRABTEA_FORGETMELOTS
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.HERMITCRABTEA_FORGETMELOTS"
