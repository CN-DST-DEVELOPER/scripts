msgid "Hyuyu, what fun!"
msgstr "Huehue, que divertido!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.YOTC_CARRAT_RACE_START_ITEM
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.YOTC_CARRAT_RACE_START_ITEM"
msgid "Let the races begin!"
msgstr "Que as corridas comecem!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.YOTC_CARRAT_SCALE.BURNT
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.YOTC_CARRAT_SCALE.BURNT"
msgid "Hyuyu, what fun!"
msgstr "Huehue, que divertido!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.YOTC_CARRAT_SCALE.CARRAT
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.YOTC_CARRAT_SCALE.CARRAT"
msgid "I think we can do better than that."
msgstr "Acho que podemos nos esforçar mais."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.YOTC_CARRAT_SCALE.CARRAT_GOOD
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.YOTC_CARRAT_SCALE.CARRAT_GOOD"
msgid "A veritable virtuoso of a vegetable!"
msgstr "Um vegetal verdadeiramente virtuoso!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.YOTC_CARRAT_SCALE.GENERIC
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.YOTC_CARRAT_SCALE.GENERIC"
msgid "I hope I get a high score, hyuyu!"
msgstr "Tomara que eu receba uma boa pontuação, huehue!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.YOTC_CARRAT_SCALE_ITEM
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.YOTC_CARRAT_SCALE_ITEM"
msgid "To win the race, I need a Carrat that can keep up the pace!"
msgstr "Para vencer a competição, preciso de um cenourrato com boa aceleração!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.YOTC_SEEDPACKET
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.YOTC_SEEDPACKET"
msgid "A packet of seeds, to do with as I please."
msgstr "Um pacote de sementes para eu fazer o que quiser."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.YOTC_SEEDPACKET_RARE
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.YOTC_SEEDPACKET_RARE"
msgid "Perhaps it contains magic beans? Hyuyu!"
msgstr "Talvez ele contenha feijões mágicos? Huehue!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.YOTD_ANCHOR
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.YOTD_ANCHOR"
msgid "Dipped in gold, now dropped in the drink."
msgstr "Banhado em ouro, mas o mergulho agora é outro."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.YOTD_ANCHOR_ITEM
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.YOTD_ANCHOR_ITEM"
msgid "Such funny ship things I could build."
msgstr "Poderia construir coisas de navio bem legais."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.YOTD_DRAGONSHRINE.BURNT
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.YOTD_DRAGONSHRINE.BURNT"
msgid "Someone went and started the fun without me!"
msgstr "Alguém veio antes e fez a algazarra sem mim!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.YOTD_DRAGONSHRINE.EMPTY
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.YOTD_DRAGONSHRINE.EMPTY"
msgid "Rumble and grumble, it wants charcoal!"
msgstr "Sua barriga tá chorona, ela quer carvão!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.YOTD_DRAGONSHRINE.GENERIC
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.YOTD_DRAGONSHRINE.GENERIC"
msgid "What delightful surprises are you hoarding?"
msgstr "Que surpresas deliciosas abrigas?"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.YOTD_OAR
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.YOTD_OAR"
msgid "I'll win today, even if I must claw my way. Hyuyu!"
msgstr "Hoje vou vencer usando muita garra. Huehue!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.YOTD_STEERINGWHEEL
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.YOTD_STEERINGWHEEL"
msgid "I'll give the wheel a spin and see if I win!"
msgstr "Vou girar a roda e ver se ela dá fortuna!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.YOTD_STEERINGWHEEL_ITEM
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.YOTD_STEERINGWHEEL_ITEM"
msgid "I can see the appeal of a steering wheel."
msgstr "Compreendo a atração causada por um timão."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.YOTH_CHAIR_ROCKING_ITEM
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.YOTH_CHAIR_ROCKING_ITEM"
msgid "Quit talkin' and start rockin'."
msgstr "Para de falar e começa a balançar!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.YOTH_KNIGHTHAT
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.YOTH_KNIGHTHAT"
msgid "Of course that horse hat!"
msgstr "É disso que eu falo: um elmo de cavalo!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.YOTH_KNIGHTSHRINE.BURNT
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.YOTH_KNIGHTSHRINE.BURNT"
msgid "Burnt? We never learnt."
msgstr "Queimou de repente? A gente nunca aprende."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.YOTH_KNIGHTSHRINE.EMPTY
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.YOTH_KNIGHTSHRINE.EMPTY"
msgid "I hears it wants gears... or something."
msgstr "Acredite se quiser: engrenagens ele quer... ou algo do tipo."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.YOTH_KNIGHTSHRINE.GENERIC
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.YOTH_KNIGHTSHRINE.GENERIC"
msgid "That's enough stuff!"
msgstr "Pronto, isso é seu, mas agora deu!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.YOTH_KNIGHTSTICK
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.YOTH_KNIGHTSTICK"
msgid "Not a real horse, of course."
msgstr "Que infelicidade, não é um cavalo de verdade."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.YOTH_LANCE
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.YOTH_LANCE"
msgid "Give this lance a chance!"
msgstr "Há esperança, dê uma chance a essa lança!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.YOTP_FOOD1
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.YOTP_FOOD1"
msgid "I'll take a little tiny nibble."
msgstr "Vou dar uma mordiscadinha."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.YOTP_FOOD2
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.YOTP_FOOD2"
msgid "I'll try it, if you insist."
msgstr "Vou experimentar, já que insiste."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.YOTP_FOOD3
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.YOTP_FOOD3"
msgid "Maybe just a little bite."
msgstr "Quem sabe só uma mordidinha?"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.YOTR_DECOR_1.GENERAL
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.YOTR_DECOR_1.GENERAL"
msgid "It's my favorite light, but only by a hare."
msgstr "É minha luz favorita, claridade bem lebre."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.YOTR_DECOR_1.OUT
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.YOTR_DECOR_1.OUT"
msgid "The bunny burns no more."
msgstr "O coelhinho perdeu a vida."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.YOTR_DECOR_1_ITEM
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.YOTR_DECOR_1_ITEM"
msgid "I should place this rabbit now that I've nabbed it."
msgstr "Melhor botar esse coelho em algum lugar agora que surrupiei ele."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.YOTR_DECOR_2.GENERAL
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.YOTR_DECOR_2.GENERAL"
msgid "It's my favorite light, but only by a hare."
msgstr "É minha luz favorita, claridade bem lebre."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.YOTR_DECOR_2.OUT
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.YOTR_DECOR_2.OUT"
msgid "The bunny burns no more."
msgstr "O coelhinho perdeu a vida."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.YOTR_DECOR_2_ITEM
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.YOTR_DECOR_2_ITEM"
msgid "I should place this rabbit now that I've nabbed it."
msgstr "Melhor botar esse coelho em algum lugar agora que surrupiei ele."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.YOTR_FIGHTRING_BELL.GENERIC
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.YOTR_FIGHTRING_BELL.GENERIC"
msgid "Not a fight in sight."
msgstr "Nem com lupa se vê aqui uma luta."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.YOTR_FIGHTRING_BELL.PLAYING
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.YOTR_FIGHTRING_BELL.PLAYING"
msgid "Pummeling pillows on parade, hyuyu!"
msgstr "Desfile de travesseiros espancadores, huehue!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.YOTR_FIGHTRING_KIT
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.YOTR_FIGHTRING_KIT"
msgid "I'm pondering a place to put the pit."
msgstr "Estou pensando num ponto para posicionar o poço."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.YOTR_FOOD1
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.YOTR_FOOD1"
msgid "A funny shape for carrot cake."
msgstr "Um formato engraçado pra um bolo de cenoura."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.YOTR_FOOD2
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.YOTR_FOOD2"
msgid "Once in a blue moon I'll sample mortal food... but not today, hyuyu."
msgstr "Nos dias de lua azul no céu, na minha boca comidas mortais fazem aluguel... mas hoje não, huehue."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.YOTR_FOOD3
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.YOTR_FOOD3"
msgid "A jelly ball. That is all."
msgstr "Uma bola de gelatina. Só isso."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.YOTR_FOOD4
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.YOTR_FOOD4"
msgid "This doughy treat, I will not eat."
msgstr "Esse capricho pastoso para mim não é gostoso."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.YOTR_RABBITSHRINE.BURNT
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.YOTR_RABBITSHRINE.BURNT"
msgid "That's that."
msgstr "É isso, então."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.YOTR_RABBITSHRINE.EMPTY
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.YOTR_RABBITSHRINE.EMPTY"
msgid "Rumble and grumble, it wants a carrot!"
msgstr "Sua barriga tá chorona, ela quer uma chenoura!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.YOTR_RABBITSHRINE.GENERIC
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.YOTR_RABBITSHRINE.GENERIC"
msgid "Let us celebrate!"
msgstr "Vamos comemorar!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.YOTR_TOKEN
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.YOTR_TOKEN"
msgid "A duel, a duel! To arms!"
msgstr "Um duelo, um duelo! Às armas!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.YOTS_LANTERN_POST.BURNT
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.YOTS_LANTERN_POST.BURNT"
msgid "Who cares! We have spares! Right?"
msgstr "Tanto faz, pois temos mais! Certo?"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.YOTS_LANTERN_POST.GENERIC
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.YOTS_LANTERN_POST.GENERIC"
msgid "A post with the most to boast!"
msgstr "Um poste majestoso para deixar o lugar mais vistoso!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.YOTS_LANTERN_POST_ITEM
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.YOTS_LANTERN_POST_ITEM"
msgid "It will stand tall with them all!"
msgstr "Vou me destacar com estas luzes a me iluminar!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.YOTS_SNAKESHRINE.BURNT
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.YOTS_SNAKESHRINE.BURNT"
msgid "My head was turned, and it was burned."
msgstr "Nem vi como começou, só sei que queimou."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.YOTS_SNAKESHRINE.EMPTY
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.YOTS_SNAKESHRINE.EMPTY"
msgid "On what does the beast wish to feast?"
msgstr "A fera está à espera de uma refeição, pois não?"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.YOTS_SNAKESHRINE.GENERIC
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.YOTS_SNAKESHRINE.GENERIC"
msgid "The worm's terms are met!"
msgstr "Realizei mais um feito: o verme está satisfeito!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.YOTS_WORM
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.YOTS_WORM"
msgid "Stand firm against the squirm of the worm!"
msgstr "Não se deixe abater, e o verme não poderá te vencer!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.YOT_CATCOONSHRINE.BURNT
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.YOT_CATCOONSHRINE.BURNT"
msgid "Well, that's that."
msgstr "Bem, é isso."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.YOT_CATCOONSHRINE.EMPTY
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.YOT_CATCOONSHRINE.EMPTY"
msgid "Whatever was here, disappeared!"
msgstr "O que quer que aqui compareceu, desapareceu!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.YOT_CATCOONSHRINE.GENERIC
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.YOT_CATCOONSHRINE.GENERIC"
msgid "Such a pretty little kitty!"
msgstr "Que gatinho tão bonitinho!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE_GENERIC
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE_GENERIC"
msgid "Ooo, a mystery!"
msgstr "Uuh, um mistério!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE_PLANTHAPPY
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE_PLANTHAPPY"
msgid "Well well, this plant looks swell!"
msgstr "Mas o que é isso? Essa planta está cheia de viço!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE_PLANTSTRESSED
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE_PLANTSTRESSED"
msgid "Something's bothering our budding buddy."
msgstr "Tem algo incomodando nossa amiguinha florescente."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE_PLANTSTRESSORFAMILY
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE_PLANTSTRESSORFAMILY"
msgid "It's feeling quite down with no plants like it around."
msgstr "Esta planta sente a melancolia de não ter outras como ela para lhe fazer companhia."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE_PLANTSTRESSORHAPPINESS
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE_PLANTSTRESSORHAPPINESS"
msgid "What's that? You'd like to chat?"
msgstr "O que foi? Quer conversar?"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE_PLANTSTRESSORKILLJOYS
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE_PLANTSTRESSORKILLJOYS"
msgid "Something around needs to be pulled from the ground."
msgstr "Aquilo que perturba a plantação precisa ser arrancado do chão."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE_PLANTSTRESSORMOISTURE
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE_PLANTSTRESSORMOISTURE"
msgid "It needs a drink, I think."
msgstr "Esta planta tímida precisa de uma bebida."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE_PLANTSTRESSORNUTRIENTS
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE_PLANTSTRESSORNUTRIENTS"
msgid "It needs better soil or our hard work will be spoiled!"
msgstr "Ela precisa de solo melhorado, ou nosso esforço será desperdiçado!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE_PLANTSTRESSOROVERCROWDING
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE_PLANTSTRESSOROVERCROWDING"
msgid "From the looks of this place, I'd say it needs more space."
msgstr "Preciso apertar o passo para dar a estas plantas mais espaço."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE_PLANTSTRESSORSEASON
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE_PLANTSTRESSORSEASON"
msgid "This plant could be better, it doesn't like the weather."
msgstr "Esta planta poderia estar melhor, mas o clima a deixa pior."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE_PLANTVERYSTRESSED
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE_PLANTVERYSTRESSED"
msgid "With much regret, I'd say this plant is upset."
msgstr "Lamento muito dizer, mas esta planta só faz sofrer."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE_SMOLDERING
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE_SMOLDERING"
msgid "Some fiery fun is about to begin!"
msgstr "Uma diversão chamejante está prestes a começar!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE_TOODARK
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE_TOODARK"
msgid "I can't see the physical plane!"
msgstr "Não consigo ver o plano físico!"

#. STRINGS.CHARACTERS.WORTOX.EAT_FOOD.TALLBIRDEGG_CRACKED
msgctxt "STRINGS.CHARACTERS.WORTOX.EAT_FOOD.TALLBIRDEGG_CRACKED"
msgid "Doing that hurt my feelings."
msgstr "Fazer isso me magoa."

#. STRINGS.CHARACTERS.WORTOX.EAT_FOOD.WINTERSFEASTFUEL
msgctxt "STRINGS.CHARACTERS.WORTOX.EAT_FOOD.WINTERSFEASTFUEL"
msgid "Hyuyu, how fun!"
msgstr "Huehue, que divertido!"

#. STRINGS.CHARACTERS.WORTOX.QUAGMIRE_ANNOUNCE_LOSE
msgctxt "STRINGS.CHARACTERS.WORTOX.QUAGMIRE_ANNOUNCE_LOSE"
msgid "Oh dear."
msgstr "Oh, meu santo!"

#. STRINGS.CHARACTERS.WORTOX.QUAGMIRE_ANNOUNCE_MEALBURNT
msgctxt "STRINGS.CHARACTERS.WORTOX.QUAGMIRE_ANNOUNCE_MEALBURNT"
msgid "Well it's not raw! Hyuyu!"
msgstr "Bem, não está cru! Huehue!"

#. STRINGS.CHARACTERS.WORTOX.QUAGMIRE_ANNOUNCE_NOTRECIPE
msgctxt "STRINGS.CHARACTERS.WORTOX.QUAGMIRE_ANNOUNCE_NOTRECIPE"
msgid "That was nothing! Nothing!"
msgstr "Isso não foi nada! Nada!"

#. STRINGS.CHARACTERS.WORTOX.QUAGMIRE_ANNOUNCE_WIN
msgctxt "STRINGS.CHARACTERS.WORTOX.QUAGMIRE_ANNOUNCE_WIN"
msgid "Must be off now!"
msgstr "Preciso ir embora!"

#. STRINGS.CHARACTERS.WORTOX.WENDY_SKILLTREE_EASTEREGG
msgctxt "STRINGS.CHARACTERS.WORTOX.WENDY_SKILLTREE_EASTEREGG"
msgid "only_used_by_wendy"
msgstr "only_used_by_wendy"

#. STRINGS.CHARACTERS.WURT.ACTIONFAIL.ACTIVATE.CARNIVAL_HOST_HERE
msgctxt "STRINGS.CHARACTERS.WURT.ACTIONFAIL.ACTIVATE.CARNIVAL_HOST_HERE"
msgid "Fancy Birdfolk over here!"
msgstr "Povo-pássaro chique tá aqui!"

#. STRINGS.CHARACTERS.WURT.ACTIONFAIL.ACTIVATE.EMPTY_CATCOONDEN
msgctxt "STRINGS.CHARACTERS.WURT.ACTIONFAIL.ACTIVATE.EMPTY_CATCOONDEN"
msgid "Glargh... no stuff in there, where they hide it?!"
msgstr "Glargh... não tem coisa aqui, onde eles esconderam tudo?!"

#. STRINGS.CHARACTERS.WURT.ACTIONFAIL.ACTIVATE.HASMERMLEADER
msgctxt "STRINGS.CHARACTERS.WURT.ACTIONFAIL.ACTIVATE.HASMERMLEADER"
msgid "Glurgh. Gotta wait, other Mermfolk using it."
msgstr "Glurgh. Tem que esperar, outro povo-peixe tá usando."

#. STRINGS.CHARACTERS.WURT.ACTIONFAIL.ACTIVATE.HOSTBUSY
msgctxt "STRINGS.CHARACTERS.WURT.ACTIONFAIL.ACTIVATE.HOSTBUSY"
msgid "Hey! Trying to talk to you!"
msgstr "Ei! Tô tentando falar com você!"

#. STRINGS.CHARACTERS.WURT.ACTIONFAIL.ACTIVATE.KITCOON_HIDEANDSEEK_NOT_ENOUGH_HIDERS
msgctxt "STRINGS.CHARACTERS.WURT.ACTIONFAIL.ACTIVATE.KITCOON_HIDEANDSEEK_NOT_ENOUGH_HIDERS"
msgid "Need more scratchy fluffies to play!"
msgstr "Preciso de mais fofinhos coçadores pra brincar!"

#. STRINGS.CHARACTERS.WURT.ACTIONFAIL.ACTIVATE.KITCOON_HIDEANDSEEK_NOT_ENOUGH_HIDING_SPOTS
msgctxt "STRINGS.CHARACTERS.WURT.ACTIONFAIL.ACTIVATE.KITCOON_HIDEANDSEEK_NOT_ENOUGH_HIDING_SPOTS"
msgid "Hmm, no good hidey spots here."
msgstr "Hmm, não tem lugares escondidos bons aqui."

#. STRINGS.CHARACTERS.WURT.ACTIONFAIL.ACTIVATE.KITCOON_HIDEANDSEEK_ONE_GAME_PER_DAY
msgctxt "STRINGS.CHARACTERS.WURT.ACTIONFAIL.ACTIVATE.KITCOON_HIDEANDSEEK_ONE_GAME_PER_DAY"
msgid "Glurgh. Bored of this game."
msgstr "Glurgh. Cansei dessa brincadeira."

#. STRINGS.CHARACTERS.WURT.ACTIONFAIL.ACTIVATE.LOCKED_GATE
msgctxt "STRINGS.CHARACTERS.WURT.ACTIONFAIL.ACTIVATE.LOCKED_GATE"
msgid "Grrr... want in!"
msgstr "Grrr... quero entrar!"

#. STRINGS.CHARACTERS.WURT.ACTIONFAIL.ACTIVATE.MANNEQUIN_EQUIPSWAPFAILED
msgctxt "STRINGS.CHARACTERS.WURT.ACTIONFAIL.ACTIVATE.MANNEQUIN_EQUIPSWAPFAILED"
msgid "Not supposed to put that there."
msgstr "Não devo colocar isso aí."

#. STRINGS.CHARACTERS.WURT.ACTIONFAIL.ACTIVATE.NOCARNIVAL
msgctxt "STRINGS.CHARACTERS.WURT.ACTIONFAIL.ACTIVATE.NOCARNIVAL"
msgid "Huh? Where the Birdfolk go?"
msgstr "Hã? Aonde foi povo-pássaro?"

#. STRINGS.CHARACTERS.WURT.ACTIONFAIL.ACTIVATE.NOKELP
msgctxt "STRINGS.CHARACTERS.WURT.ACTIONFAIL.ACTIVATE.NOKELP"
msgid "Needs more snacks."
msgstr "Precisa de mais petiscos."

#. STRINGS.CHARACTERS.WURT.ACTIONFAIL.ACTIVATE.NOTAROBOT
msgctxt "STRINGS.CHARACTERS.WURT.ACTIONFAIL.ACTIVATE.NOTAROBOT"
msgid "Ironfolk only."
msgstr "Só pra povo-ferro."

#. STRINGS.CHARACTERS.WURT.ACTIONFAIL.ACTIVATE.NOTMERM
msgctxt "STRINGS.CHARACTERS.WURT.ACTIONFAIL.ACTIVATE.NOTMERM"
msgid "Florp?"
msgstr "Florp?"

#. STRINGS.CHARACTERS.WURT.ACTIONFAIL.ACTIVATE.NOTMYBERNIE
msgctxt "STRINGS.CHARACTERS.WURT.ACTIONFAIL.ACTIVATE.NOTMYBERNIE"
msgid "Where fire lady? Big bear not listen!"
msgstr "Cadê moça do fogo? Ursão não escuta!"

#. STRINGS.CHARACTERS.WURT.ACTIONFAIL.ACTIVATE.PILLOWFIGHT_NO_HANDPILLOW
msgctxt "STRINGS.CHARACTERS.WURT.ACTIONFAIL.ACTIVATE.PILLOWFIGHT_NO_HANDPILLOW"
msgid "WAIT!! Forgot pillow!"
