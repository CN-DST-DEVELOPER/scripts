#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.BIRD_MUTANT_SPITTER
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.BIRD_MUTANT_SPITTER"
msgid "Stop spitting at us!"
msgstr "Para de cuspir na gente!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.BISHOP
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.BISHOP"
msgid "You don't play by the chess rules grandpa taught me."
msgstr "Você não segue as regras de xadrez que o vovô me ensinou."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.BISHOP_CHARGE_HIT
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.BISHOP_CHARGE_HIT"
msgid "Owie!"
msgstr "Oui!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.BISHOP_NIGHTMARE
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.BISHOP_NIGHTMARE"
msgid "Bishop of bad dreams."
msgstr "Bispo de sonhos ruins."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.BLACKFLAG
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.BLACKFLAG"
msgid "We drew a scary skull on it! But we used black ink..."
msgstr "Desenhamos uma caveira assustadora nela! Mas usamos tinta preta..."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.BLOWDART_FIRE
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.BLOWDART_FIRE"
msgid "One step above blowing hot air."
msgstr "Um passo acima de soprar ar quente."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.BLOWDART_LAVA
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.BLOWDART_LAVA"
msgid "We like fighting from far away."
msgstr "A gente gosta de lutar de longe."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.BLOWDART_LAVA2
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.BLOWDART_LAVA2"
msgid "Those look like fun!"
msgstr "Isso parece divertido!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.BLOWDART_PIPE
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.BLOWDART_PIPE"
msgid "Same as blowing bubbles."
msgstr "Igual a fazer bolinhas de sabão."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.BLOWDART_SLEEP
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.BLOWDART_SLEEP"
msgid "Airborne sleeping agent."
msgstr "Agente do sono transportado pelo ar."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.BLOWDART_YELLOW
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.BLOWDART_YELLOW"
msgid "It's a shock to the system."
msgstr "É um choque no sistema."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.BLUEAMULET
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.BLUEAMULET"
msgid "I guess it's nice."
msgstr "Acho que é bacana."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.BLUEGEM
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.BLUEGEM"
msgid "Glittering and cool."
msgstr "Cintilante e bacana."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.BLUEMOONEYE
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.BLUEMOONEYE"
msgid "Hey! Did anyone lose an eye?"
msgstr "Ei! Mais alguém perdeu um olho?"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.BLUEPRINT.COMMON
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.BLUEPRINT.COMMON"
msgid "\"Follow the instructions\", mum always said."
msgstr "\"Siga as instruções\", a mamãe sempre dizia."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.BLUEPRINT.RARE
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.BLUEPRINT.RARE"
msgid "This one feels special."
msgstr "Parece especial."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.BLUE_CAP
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.BLUE_CAP"
msgid "You'd have to be crazy..."
msgstr "Você teria que ser maluco..."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.BLUE_CAP_COOKED
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.BLUE_CAP_COOKED"
msgid "Good thing we're feeling healthy."
msgstr "Ainda bem que estamos nos sentindo saudáveis."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.BLUE_MUSHROOM.GENERIC
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.BLUE_MUSHROOM.GENERIC"
msgid "Vroom vroom, mushroom."
msgstr "Cogumelo sem chinelo."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.BLUE_MUSHROOM.INGROUND
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.BLUE_MUSHROOM.INGROUND"
msgid "Hiding, are we?"
msgstr "Estamos nos escondendo, é?"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.BLUE_MUSHROOM.PICKED
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.BLUE_MUSHROOM.PICKED"
msgid "Maybe it will regrow."
msgstr "Talvez cresça de novo."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.BOARDS
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.BOARDS"
msgid "Logs, but flat."
msgstr "Toras, mas achatadas."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.BOARON
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.BOARON"
msgid "Leave us alone!"
msgstr "Deixe a gente em paz!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.BOARRIOR
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.BOARRIOR"
msgid "You don't look so tough!"
msgstr "Você não parece muito durão!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.BOATFRAGMENT03
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.BOATFRAGMENT03"
msgid "Oh no, someone had an accident!"
msgstr "Ah, não. Alguém se acidentou!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.BOATFRAGMENT04
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.BOATFRAGMENT04"
msgid "Oh no, someone had an accident!"
msgstr "Ah, não. Alguém se acidentou!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.BOATFRAGMENT05
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.BOATFRAGMENT05"
msgid "Oh no, someone had an accident!"
msgstr "Ah, não. Alguém se acidentou!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.BOATPATCH
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.BOATPATCH"
msgid "It makes the boat feel better."
msgstr "Isso faz o barco se sentir melhor."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.BOATPATCH_KELP
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.BOATPATCH_KELP"
msgid "It's for fixing up boat booboos!"
msgstr "É pra fazer curativo em dodói de barco!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.BOATRACE_CHECKPOINT
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.BOATRACE_CHECKPOINT"
msgid "Check! It's a checkpoint!"
msgstr "Veja! Um ponto de marco!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.BOATRACE_CHECKPOINT_THROWABLE_DEPLOYKIT
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.BOATRACE_CHECKPOINT_THROWABLE_DEPLOYKIT"
msgid "We get to decide where it goes?"
msgstr "A gente que decide onde colocar?"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.BOATRACE_PRIMEMATE
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.BOATRACE_PRIMEMATE"
msgid "Hi! Wanna race?"
msgstr "Olá! Quer disputar corrida?"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.BOATRACE_SEASTACK
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.BOATRACE_SEASTACK"
msgid "Careful! Don't hit the floaty!"
msgstr "Cuidado! Não se bata na boia!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.BOATRACE_SEASTACK_MONKEY
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.BOATRACE_SEASTACK_MONKEY"
msgid "Careful! Don't hit the floaty!"
msgstr "Cuidado! Não se bata na boia!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.BOATRACE_SEASTACK_MONKEY_THROWABLE_DEPLOYKIT
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.BOATRACE_SEASTACK_MONKEY_THROWABLE_DEPLOYKIT"
msgid "Where should we throw the floaty?"
msgstr "Onde jogaremos a boia?"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.BOATRACE_SEASTACK_THROWABLE_DEPLOYKIT
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.BOATRACE_SEASTACK_THROWABLE_DEPLOYKIT"
msgid "Where should we throw the floaty?"
msgstr "Onde jogaremos a boia?"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.BOATRACE_SPECTATOR_DRAGONLING
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.BOATRACE_SPECTATOR_DRAGONLING"
msgid "It's nice of him to cheer us on."
msgstr "Que legal da parte dele nos incentivar."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.BOATRACE_START
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.BOATRACE_START"
msgid "Last one back here is a rotten egg!"
msgstr "Quem chegar por último é a mulher do padre!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.BOATRACE_START_THROWABLE_DEPLOYKIT
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.BOATRACE_START_THROWABLE_DEPLOYKIT"
msgid "Should we start here? How about there? Or there?"
msgstr "Vamos começar aqui? Que tal lá? Ou ali?"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.BOAT_ANCIENT_CONTAINER
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.BOAT_ANCIENT_CONTAINER"
msgid "That's where we hide all our favorite toys."
msgstr "É aí que a gente esconde os nossos brinquedos favoritos."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.BOAT_ANCIENT_ITEM
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.BOAT_ANCIENT_ITEM"
msgid "Building a new boat to look old? We don't get it..."
msgstr "Construir um novo barco pra parecer velho? A gente não entende..."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.BOAT_BUMPER_CRABKING
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.BOAT_BUMPER_CRABKING"
msgid "Now we will win bumper boats!"
msgstr "Agora a gente vai ganhar nos barquinhos de bate-bate!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.BOAT_BUMPER_CRABKING_KIT
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.BOAT_BUMPER_CRABKING_KIT"
msgid "Now we can play bumper boats!"
msgstr "Agora podemos brincar de barquinho de bate-bate!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.BOAT_BUMPER_KELP
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.BOAT_BUMPER_KELP"
msgid "It keeps the boat from getting hurt."
msgstr "Impede o navio de se machucar."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.BOAT_BUMPER_KELP_KIT
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.BOAT_BUMPER_KELP_KIT"
msgid "Now we can play bumper boats!"
msgstr "Agora podemos brincar de barquinho de bate-bate!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.BOAT_BUMPER_SHELL
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.BOAT_BUMPER_SHELL"
msgid "It keeps the boat from getting hurt."
msgstr "Impede o navio de se machucar."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.BOAT_BUMPER_SHELL_KIT
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.BOAT_BUMPER_SHELL_KIT"
msgid "Now we can play bumper boats!"
msgstr "Agora podemos brincar de barquinho de bate-bate!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.BOAT_BUMPER_YOTD
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.BOAT_BUMPER_YOTD"
msgid "Now our boat has fangs too!"
msgstr "Agora o nosso barco também tem presas!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.BOAT_BUMPER_YOTD_KIT
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.BOAT_BUMPER_YOTD_KIT"
msgid "Now we can play bumper boats!"
msgstr "Agora podemos brincar de barquinho de bate-bate!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.BOAT_CANNON.AMMOLOADED
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.BOAT_CANNON.AMMOLOADED"
msgid "We know we shouldn't play with it, but Willow says it's so much fun..."
msgstr "Sabemos que não devíamos brincar com isso, mas a Willow diz que é tão divertido..."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.BOAT_CANNON.GENERIC
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.BOAT_CANNON.GENERIC"
msgid "Ms. Wickerbottom said we could play with it as long as there's no cannonballs inside."
msgstr "A Sra. Wickerbottom disse que podemos brincar com ele desde que não tenha bolas de canhão dentro."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.BOAT_CANNON.NOAMMO
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.BOAT_CANNON.NOAMMO"
msgid "Oh, we forgot to bring the cannonballs!"
msgstr "Ah, esquecemos de trazer as bolas de canhão!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.BOAT_CANNON_KIT
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.BOAT_CANNON_KIT"
msgid "If we build it, can we play with it?"
msgstr "Se construirmos ele, podemos brincar com ele?"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.BOAT_GRASS_ITEM
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.BOAT_GRASS_ITEM"
msgid "Weaving a grass boat probably isn't much harder than weaving webs."
msgstr "Tecer um barco de grama provavelmente não é mais difícil do que tecer teias."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.BOAT_ITEM
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.BOAT_ITEM"
msgid "That's for building a boat."
msgstr "Isso é para construir um barco."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.BOAT_LEAK
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.BOAT_LEAK"
msgid "Quick, plug it up!"
msgstr "Depressa, tape isso aí!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.BOAT_MAGNET.ACTIVATED
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.BOAT_MAGNET.ACTIVATED"
msgid "Wheee!"
msgstr "Eeeba!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.BOAT_MAGNET.GENERIC
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.BOAT_MAGNET.GENERIC"
msgid "We didn't know magnets grew that big!"
msgstr "Não sabíamos que ímãs podem ser tão grandes!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.BOAT_MAGNET_BEACON.ACTIVATED
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.BOAT_MAGNET_BEACON.ACTIVATED"
msgid "It's blinking! That's good, right?"
msgstr "Está piscando! Isso é bom, né?"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.BOAT_MAGNET_BEACON.GENERIC
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.BOAT_MAGNET_BEACON.GENERIC"
msgid "What a funny little machine."
msgstr "Que maquininha engraçada."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.BOAT_MAGNET_KIT
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.BOAT_MAGNET_KIT"
msgid "Now how did Mr. Wilson say those pieces went together...?"
msgstr "Como foi que o Sr. Wilson disse que as peças encaixavam...?"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.BOAT_ROTATOR
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.BOAT_ROTATOR"
msgid "We can turn the boat like a merry-go-round!"
msgstr "Podemos virar o barco que nem um gira-gira!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.BOAT_ROTATOR_KIT
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.BOAT_ROTATOR_KIT"
msgid "We're good at spinning things!"
msgstr "Somos bons em girar as coisas!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.BODYPILLOW_BEEFALOWOOL
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.BODYPILLOW_BEEFALOWOOL"
msgid "A fluffy puffy pillow!"
msgstr "Um travesseiro tão fofinho!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.BODYPILLOW_KELP
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.BODYPILLOW_KELP"
msgid "Is that pillow... dripping?"
msgstr "Esse travesseiro está... pingando?"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.BODYPILLOW_PETALS
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.BODYPILLOW_PETALS"
msgid "It's the nicest pillow we've ever smelled!"
msgstr "É o melhor travesseiro que eu já cheirei!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.BODYPILLOW_STEELWOOL
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.BODYPILLOW_STEELWOOL"
msgid "Ah! This one's really scratchy..."
msgstr "Ah! Esse aqui é bem áspero..."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.BOMB_LUNARPLANT
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.BOMB_LUNARPLANT"
msgid "Catch!"
msgstr "Pega!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.BOMB_LUNARPLANT_WORMWOOD
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.BOMB_LUNARPLANT_WORMWOOD"
msgid "Wormwood did something special to it!"
msgstr "O Wormwood fez algo especial nela!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.BONESHARD
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.BONESHARD"
msgid "Boney bits."
msgstr "Pedaços ossudos."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.BONESOUP
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.BONESOUP"
msgid "Warly makes really good stuff."
msgstr "O Warly sabe mesmo cozinhar."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.BONESTEW
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.BONESTEW"
msgid "Smells like Sunday supper."
msgstr "Tem cheiro de jantar de domingo."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.BOOKSTATION.BURNT
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.BOOKSTATION.BURNT"
msgid "Oh no! We worked so hard on that doily!"
msgstr "Ah, não! Trabalhamos tanto naquela teia!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.BOOKSTATION.GENERIC
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.BOOKSTATION.GENERIC"
msgid "We helped make the doily!"
msgstr "Ajudamos a fazer o guardanapo!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.BOOK_BEES
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.BOOK_BEES"
msgid "We thought we heard it buzzing!"
msgstr "Achamos que dava pra ouvir zumbidos mesmo!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.BOOK_BIRDS
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.BOOK_BIRDS"
msgid "This one has pictures!"
msgstr "Este tem figuras!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.BOOK_BRIMSTONE
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.BOOK_BRIMSTONE"
msgid "We don't like how that one ends!"
msgstr "Não gostamos do final desse!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.BOOK_ELEMENTAL
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.BOOK_ELEMENTAL"
msgid "Are those even words in there?"
msgstr "Mas são palavras mesmo aí dentro?"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.BOOK_FIRE
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.BOOK_FIRE"
msgid "Willow keeps trying to burn it... we thought she'd like it!"
msgstr "Willow fica tentando queimar ele... achamos que ela ia gostar dele!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.BOOK_FISH
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.BOOK_FISH"
msgid "Will reading really make us better at fishing?"
msgstr "Será que ler ele vai nos tornar melhores na pesca?"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.BOOK_FOSSIL
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.BOOK_FOSSIL"
msgid "We can read the words but we can't make them work."
msgstr "A gente consegue ler as palavras, mas não entende o sentido."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.BOOK_GARDENING
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.BOOK_GARDENING"
msgid "Why should we read about flowers when we can pick them?"
msgstr "Por que a gente tem que ler sobre flores quando a gente pode colhê-las?"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.BOOK_HORTICULTURE
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.BOOK_HORTICULTURE"
msgid "Reading about veggies is almost as bad as eating them!"
msgstr "Ler sobre legumes é quase tão ruim quanto comer eles!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.BOOK_HORTICULTURE_UPGRADED
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.BOOK_HORTICULTURE_UPGRADED"
msgid "It'll take us forever to read that!"
msgstr "Vai levar pra sempre para ler isso!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.BOOK_LIGHT
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.BOOK_LIGHT"
msgid "Ms. Wickerbottom, could you make a nightlight for us?"
msgstr "Sra. Wickerbottom, você poderia fazer uma luz noturna pra gente?"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.BOOK_LIGHT_UPGRADED
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.BOOK_LIGHT_UPGRADED"
msgid "It makes the brightest nightlight we've ever seen!"
msgstr "É a luz noturna mais forte que a gente já viu!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.BOOK_MOON
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.BOOK_MOON"
msgid "We try not to think about the moon too much..."
msgstr "Nós tentamos não pensar muito sobre a lua..."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.BOOK_RAIN
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.BOOK_RAIN"
msgid "\"One of the simplest ways to invite rain is to kill a-\" oh..."
msgstr "\"Uma das maneiras mais simples de convidar a chuva é matar u-\". Ah..."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.BOOK_RESEARCH_STATION
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.BOOK_RESEARCH_STATION"
msgid "Seeing someone pick up a heavy book makes us nervous, somehow..."
msgstr "Ver alguém pegar um livro pesado nos deixa agitados, por algum motivo..."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.BOOK_SILVICULTURE
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.BOOK_SILVICULTURE"
msgid "What else is there to know about trees?"
msgstr "O que mais há para saber sobre árvores?"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.BOOK_SLEEP
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.BOOK_SLEEP"
msgid "It's... beddy-bye time..."
msgstr "É... Hora de caminha..."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.BOOK_TEMPERATURE
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.BOOK_TEMPERATURE"
msgid "Not too hot, not too cold, just right! Have we heard this story before?"
msgstr "Nem tão quente, nem tão frio, certinho! Já ouvimos essa história antes?"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.BOOK_TENTACLES
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.BOOK_TENTACLES"
msgid "Why are the pages all slimy?"
msgstr "Por que as páginas são tão gosmentas?"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.BOOK_WEB
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.BOOK_WEB"
msgid "Why would anyone be afraid of spiders?"
msgstr "Por que alguém teria medo de aranhas?"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.BOOMERANG
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.BOOMERANG"
msgid "Boomerangarangarang!"
msgstr "Bumerangue, rangue, rangue!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.BOOTLEG
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.BOOTLEG"
msgid "Someone forgot their foot inside!"
msgstr "Alguém esqueceu o pé aqui dentro!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.BROKEN_FORGEDITEM
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.BROKEN_FORGEDITEM"
msgid "Oh no! Maybe we can fix it?"
msgstr "Ah, não! Talvez a gente possa consertar?"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.BROKEN_FUMAROLETOOLITEM
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.BROKEN_FUMAROLETOOLITEM"
msgid "We could fix it with some heat!"
msgstr "A gente podia consertar isso com um pouco de calor!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.BRUSH
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.BRUSH"
msgid "It's more scratchy than anything."
msgstr "É áspero de mais."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.BUGNET
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.BUGNET"
msgid "I'm not a bug! We're an arachnid!"
msgstr "Não sou um inseto! Somos um aracnídeo!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.BULLKELP_PLANT.GENERIC
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.BULLKELP_PLANT.GENERIC"
msgid "There's some kelp floating in the water!"
msgstr "Tem umas algas flutuando na água!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.BULLKELP_PLANT.PICKED
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.BULLKELP_PLANT.PICKED"
msgid "We gave it a haircut."
msgstr "A gente cortou o cabelo dela."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.BULLKELP_ROOT
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.BULLKELP_ROOT"
msgid "It would be happier if we planted it."
msgstr "Ela ficaria mais feliz se a gente a plantasse."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.BUNDLE
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.BUNDLE"
msgid "That's one of my favorite things!"
msgstr "Essa é uma das minhas coisas favoritas."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.BUNDLEWRAP
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.BUNDLEWRAP"
msgid "Let's cocoon something for later!"
msgstr "Vamos encasular algo pra mais tarde!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.BUNNYMAN
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.BUNNYMAN"
msgid "Hop along, lil bunny."
msgstr "Continue saltitando, coelhinho."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.BUNNYSTEW
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.BUNNYSTEW"
msgid "We were told we can't lick it clean..."
msgstr "Nos disseram que não podemos lamber isso..."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.BURNT_MARSH_BUSH
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.BURNT_MARSH_BUSH"
msgid "All burned up."
msgstr "Completamente queimado."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.BUSHHAT
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.BUSHHAT"
msgid "For looking bushier!"
msgstr "Pra ficar mais arbustoso!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.BUTTER
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.BUTTER"
msgid "Butter is better."
msgstr "Manteiga é melhor."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.BUTTERFLY.GENERIC
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.BUTTERFLY.GENERIC"
msgid "Look at it, flitting around happily."
msgstr "Olha só para ela, voando por aí feliz."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.BUTTERFLY.HELD
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.BUTTERFLY.HELD"
msgid "Not so happy now, are we?"
msgstr "Não está tão feliz agora, né?"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.BUTTERFLYMUFFIN
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.BUTTERFLYMUFFIN"
msgid "Do you know the muffin spider?"
msgstr "Você conhece a aranha bolinho?"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.BUTTERFLYWINGS
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.BUTTERFLYWINGS"
msgid "Pick our teeth with butterfly bones."
msgstr "Podemos limpar os dentes com ossos de borboleta."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.BUZZARD
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.BUZZARD"
msgid "You won't find any carrion here. We're stuck like this."
msgstr "Não você não vai encontrar carniça por aqui. Estamos grudados assim."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.BUZZARDCORPSE.BURNING
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.BUZZARDCORPSE.BURNING"
msgid "We love that smell!"
msgstr "A gente adora esse cheiro!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.BUZZARDCORPSE.GENERIC
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.BUZZARDCORPSE.GENERIC"
msgid "Poke it!"
msgstr "Cutuca!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.BUZZARDCORPSE.REVIVING
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.BUZZARDCORPSE.REVIVING"
msgid "What's happening to it?"
msgstr "O que tá acontecendo?"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.CABBAGEROLLS
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.CABBAGEROLLS"
msgid "We hope Ms. Wickerbottom doesn't find out we didn't eat the cabbage..."
msgstr "Tomara que a Sra. Wickerbottom não descubra que a gente não comeu repolho..."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.CACTUS.GENERIC
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.CACTUS.GENERIC"
msgid "It's got more things coming out of it than we do."
msgstr "Tem mais coisas saindo dele do que nós."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.CACTUS.PICKED
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.CACTUS.PICKED"
msgid "It's got no meat left in it."
msgstr "Não tem mais nada de carne."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.CACTUS_FLOWER
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.CACTUS_FLOWER"
msgid "This part is nice."
msgstr "Essa parte é boa."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.CACTUS_MEAT
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.CACTUS_MEAT"
msgid "Haven't had enough, huh?"
msgstr "Não foi o suficiente, hein?"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.CACTUS_MEAT_COOKED
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.CACTUS_MEAT_COOKED"
msgid "Take that, pokey things!"
msgstr "Toma essa, coisas pontudas!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.CALIFORNIAROLL
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.CALIFORNIAROLL"
msgid "Hmm, something smells fishy about this!"
msgstr "Hmm, algo está estranho nisso!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.CAMPFIRE.EMBERS
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.CAMPFIRE.EMBERS"
msgid "We should put something on the fire before it goes out."
msgstr "Precisamos colocar alguma coisa no fogo antes que apague."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.CAMPFIRE.GENERIC
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.CAMPFIRE.GENERIC"
msgid "Sure beats the cold. And darkness."
msgstr "Com certeza, isso vai dar um jeito no frio. E na escuridão."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.CAMPFIRE.HIGH
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.CAMPFIRE.HIGH"
msgid "That fire is huge!"
msgstr "Esse fogo está enorme!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.CAMPFIRE.LOW
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.CAMPFIRE.LOW"
msgid "The fire's getting a touch low."
msgstr "O fogo está ficando um pouquinho baixo."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.CAMPFIRE.NORMAL
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.CAMPFIRE.NORMAL"
msgid "Nice and warm."
msgstr "Quentinho e confortável."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.CAMPFIRE.OUT
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.CAMPFIRE.OUT"
msgid "Well, that's done."
msgstr "Bem, já era."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.CANARY.GENERIC
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.CANARY.GENERIC"
msgid "That's a yellow bird."
msgstr "É um pássaro amarelo."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.CANARY.HELD
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.CANARY.HELD"
msgid "Caught you!"
msgstr "Te peguei!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.CANARY_POISONED
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.CANARY_POISONED"
msgid "Uh, are you feeling okay?"
msgstr "Uh, está se sentindo bem?"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.CANDYBAG
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.CANDYBAG"
msgid "Treats, treats, treats!"
msgstr "Doces, doces e mais doces!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.CANE
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.CANE"
msgid "One more point of contact couldn't slow us down."
msgstr "Mais um ponto de contato não nos atrasaria."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.CANNONBALL_ROCK_ITEM
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.CANNONBALL_ROCK_ITEM"
msgid "Mr. Wolfgang says to lift with your legs, and we've got lots!"
msgstr "O Sr. Wolfgang diz que é pra levantar com suas pernas, e nós temos muitas!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.CARNIVALCANNON.COOLDOWN
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.CARNIVALCANNON.COOLDOWN"
msgid "Yay!!"
msgstr "Viva!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.CARNIVALCANNON.GENERIC
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.CARNIVALCANNON.GENERIC"
msgid "Can we turn it on? Pretty please?"
msgstr "A gente pode ligar? Por favor?"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.CARNIVALCANNON_KIT
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.CARNIVALCANNON_KIT"
msgid "We can't wait to play with it!"
msgstr "A gente mal pode esperar pra brincar com ele!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.CARNIVALDECOR_BANNER
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.CARNIVALDECOR_BANNER"
msgid "Crows sure like shiny things, don't they?"
msgstr "Os corvos gostam mesmo de coisas brilhantes, não é?"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.CARNIVALDECOR_BANNER_KIT
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.CARNIVALDECOR_BANNER_KIT"
msgid "We can put it together!"
msgstr "A gente pode montar tudo!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.CARNIVALDECOR_EGGRIDE
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.CARNIVALDECOR_EGGRIDE"
msgid "We wish it was a little bigger so we could ride too!"
msgstr "A gente queria que fosse um pouco maior pra poder andar nele também!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.CARNIVALDECOR_EGGRIDE_KIT
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.CARNIVALDECOR_EGGRIDE_KIT"
msgid "We can put it together!"
msgstr "A gente pode montar tudo!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.CARNIVALDECOR_FIGURE.GENERIC
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.CARNIVALDECOR_FIGURE.GENERIC"
msgid "It's a little wooden statue."
msgstr "É uma estátua pequena de madeira."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.CARNIVALDECOR_FIGURE.RARE
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.CARNIVALDECOR_FIGURE.RARE"
msgid "Oooh, we got an extra special one!"
msgstr "Aaah, a gente tem uma extraespecial!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.CARNIVALDECOR_FIGURE.UNCOMMON
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.CARNIVALDECOR_FIGURE.UNCOMMON"
msgid "We're going to collect all of them!"
msgstr "A gente vai coletar todas elas!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.CARNIVALDECOR_FIGURE_KIT
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.CARNIVALDECOR_FIGURE_KIT"
msgid "We can't wait to see what's inside!"
msgstr "A gente mal pode esperar pra ver o que tem dentro!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.CARNIVALDECOR_FIGURE_KIT_SEASON2
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.CARNIVALDECOR_FIGURE_KIT_SEASON2"
msgid "We can't wait to see what's inside!"
msgstr "A gente mal pode esperar pra ver o que tem dentro!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.CARNIVALDECOR_LAMP
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.CARNIVALDECOR_LAMP"
msgid "Night lights make the dark a little less scary."
msgstr "As luzes noturnas deixam o escuro um pouco menos apavorante."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.CARNIVALDECOR_LAMP_KIT
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.CARNIVALDECOR_LAMP_KIT"
msgid "We can put it together!"
msgstr "A gente pode montar tudo!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.CARNIVALDECOR_PLANT
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.CARNIVALDECOR_PLANT"
msgid "This tree is so small!"
msgstr "Essa árvore é tão pequena!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.CARNIVALDECOR_PLANT_KIT
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.CARNIVALDECOR_PLANT_KIT"
msgid "We can put it together!"
msgstr "A gente pode montar tudo!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.CARNIVALFOOD_CORNTEA
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.CARNIVALFOOD_CORNTEA"
msgid "Is Ms. Wickerbottom trying to trick us into eating our vegetables again?"
msgstr "A Sra. Wickerbottom tá tentando outro truque pra fazer a gente comer legumes?"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.CARNIVALGAME_FEEDCHICKS_FOOD
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.CARNIVALGAME_FEEDCHICKS_FOOD"
msgid "We think Wurt might eat these too."
msgstr "A gente acha que a Wurt também poderia comer isso."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.CARNIVALGAME_FEEDCHICKS_KIT
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.CARNIVALGAME_FEEDCHICKS_KIT"
