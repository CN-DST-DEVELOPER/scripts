msgstr "Não adianta tentar, só um autômato pode controlar."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.WX78_FOODBRICK.GENERIC
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.WX78_FOODBRICK.GENERIC"
