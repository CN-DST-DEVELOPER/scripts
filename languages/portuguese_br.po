msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.TURF_DRAGONFLY"
msgid "This might actually be useful."
msgstr "Isto pode ser útil de verdade."

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.TURF_FOREST
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.TURF_FOREST"
