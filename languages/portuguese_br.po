msgstr "Eca!"

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_PIRATES_ARRIVE
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_PIRATES_ARRIVE"
msgid "Uh oh... we're not sure we like the sound of that."
msgstr "Ô-ou... não temos certeza se gostamos de como isso soa."

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_PLANT_RANDOMSEED
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_PLANT_RANDOMSEED"
