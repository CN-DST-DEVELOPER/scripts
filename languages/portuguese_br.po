msgstr "É bem pequenininho, né?"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.OCEANFISH_SMALL_3
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.OCEANFISH_SMALL_3"
