msgstr "Acho que é importado."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.HERMITCRABTEA_PETALS
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.HERMITCRABTEA_PETALS"
