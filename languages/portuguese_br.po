msgstr "Tem alguma coisa espreitando aí dentro..."

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.WOBSTER_MOONGLASS
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.WOBSTER_MOONGLASS"
