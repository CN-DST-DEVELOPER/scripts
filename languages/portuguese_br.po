msgstr "Isso era... sabe? Uma coisa."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.ASPARAGUS
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.ASPARAGUS"
msgid "Makes ya big and strong."
msgstr "Te deixa grande e forte."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.ASPARAGUSSOUP
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.ASPARAGUSSOUP"
msgid "Huh. Interesting choice but I ain't complainin'!"
msgstr "Hã. Escolha interessante, mas não estou reclamando!"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.ASPARAGUS_COOKED
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.ASPARAGUS_COOKED"
