msgstr "Só mais algumas flores e tudo deve funcionar."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.SKELETON
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.SKELETON"
msgid "Better you than me."
msgstr "Antes você do que eu!"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.SKELETONHAT
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.SKELETONHAT"
msgid "It gives me terrible visions."
msgstr "Estou tendo visões horríveis com isso."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.SKELETON_NOTPLAYER
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.SKELETON_NOTPLAYER"
msgid "These are not human bones."
