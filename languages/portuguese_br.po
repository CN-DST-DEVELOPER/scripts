msgstr "only_used_by_wolfgang"

#. STRINGS.CHARACTERS.WANDA.ANNOUNCE_WOLFGANG_MIGHTY_COACHING
msgctxt "STRINGS.CHARACTERS.WANDA.ANNOUNCE_WOLFGANG_MIGHTY_COACHING"
msgid "only_used_by_wolfgang"
msgstr "only_used_by_wolfgang"

#. STRINGS.CHARACTERS.WANDA.ANNOUNCE_WOLFGANG_NOTEAM.1
msgctxt "STRINGS.CHARACTERS.WANDA.ANNOUNCE_WOLFGANG_NOTEAM.1"
msgid "only_used_by_wolfgang"
msgstr "only_used_by_wolfgang"

#. STRINGS.CHARACTERS.WANDA.ANNOUNCE_WOLFGANG_NOTEAM.2
msgctxt "STRINGS.CHARACTERS.WANDA.ANNOUNCE_WOLFGANG_NOTEAM.2"
msgid "only_used_by_wolfgang"
msgstr "only_used_by_wolfgang"

#. STRINGS.CHARACTERS.WANDA.ANNOUNCE_WOLFGANG_NOTEAM.3
msgctxt "STRINGS.CHARACTERS.WANDA.ANNOUNCE_WOLFGANG_NOTEAM.3"
msgid "only_used_by_wolfgang"
msgstr "only_used_by_wolfgang"

#. STRINGS.CHARACTERS.WANDA.ANNOUNCE_WOLFGANG_WIMPY_COACHING
msgctxt "STRINGS.CHARACTERS.WANDA.ANNOUNCE_WOLFGANG_WIMPY_COACHING"
msgid "only_used_by_wolfgang"
msgstr "only_used_by_wolfgang"

#. STRINGS.CHARACTERS.WANDA.ANNOUNCE_WORMHOLE
msgctxt "STRINGS.CHARACTERS.WANDA.ANNOUNCE_WORMHOLE"
msgid "I can't believe I just did that..."
msgstr "Não acredito que fiz isso..."

#. STRINGS.CHARACTERS.WANDA.ANNOUNCE_WORMS
msgctxt "STRINGS.CHARACTERS.WANDA.ANNOUNCE_WORMS"
msgid "That rumble felt... ominous."
msgstr "Esse estrondo foi... sinistro."

#. STRINGS.CHARACTERS.WANDA.ANNOUNCE_WORMS_BOSS
msgctxt "STRINGS.CHARACTERS.WANDA.ANNOUNCE_WORMS_BOSS"
msgid "It's coming..."
msgstr "Está chegando..."

#. STRINGS.CHARACTERS.WANDA.ANNOUNCE_WORTOX_REVIVER_FAILTELEPORT
msgctxt "STRINGS.CHARACTERS.WANDA.ANNOUNCE_WORTOX_REVIVER_FAILTELEPORT"
msgid "Botheration!"
msgstr "Que amolação!"

#. STRINGS.CHARACTERS.WANDA.ANNOUNCE_WX_SCANNER_NEW_FOUND
msgctxt "STRINGS.CHARACTERS.WANDA.ANNOUNCE_WX_SCANNER_NEW_FOUND"
msgid "only_used_by_wx78"
msgstr "only_used_by_wx78"

#. STRINGS.CHARACTERS.WANDA.ANNOUNCE_YOTB_LEARN_NEW_PATTERN
msgctxt "STRINGS.CHARACTERS.WANDA.ANNOUNCE_YOTB_LEARN_NEW_PATTERN"
msgid "Something new, how exciting!"
msgstr "Uma coisa nova, que emocionante!"

#. STRINGS.CHARACTERS.WANDA.ANNOUNCE_YOTD_NOBOATS
msgctxt "STRINGS.CHARACTERS.WANDA.ANNOUNCE_YOTD_NOBOATS"
msgid "I should scootch my boat a bit closer to the starting point."
msgstr "Preciso aproximar mais meu barco da largada."

#. STRINGS.CHARACTERS.WANDA.ANNOUNCE_YOTD_NOCHECKPOINTS
msgctxt "STRINGS.CHARACTERS.WANDA.ANNOUNCE_YOTD_NOCHECKPOINTS"
msgid "Oh botheration, the checkpoints need to be set up before the race, not after!"
msgstr "Ai, que amolação, precisa pôr os pontos de marco antes da corrida, e não depois!"

#. STRINGS.CHARACTERS.WANDA.ANNOUNCE_YOTD_NOTENOUGHBOATS
msgctxt "STRINGS.CHARACTERS.WANDA.ANNOUNCE_YOTD_NOTENOUGHBOATS"
msgid "I should clear some space. If I'm not mistaken, a competitor will be dropping in."
msgstr "Devo deixar espaço vago. Se não me engano, vai entrar alguém para competir."

#. STRINGS.CHARACTERS.WANDA.ANNOUNCE_YOTH_ONCOOLDOWN
msgctxt "STRINGS.CHARACTERS.WANDA.ANNOUNCE_YOTH_ONCOOLDOWN"
msgid "The knights must be preoccupied. Hardly an excuse, if you ask me."
msgstr "Os cavalos devem estar preocupados. Pra mim, isso não serve de desculpa."

#. STRINGS.CHARACTERS.WANDA.ANOUNCE_MUTATED_BIRD_ATTACK
msgctxt "STRINGS.CHARACTERS.WANDA.ANOUNCE_MUTATED_BIRD_ATTACK"
msgid "Heads up!"
msgstr "Atenção!"

#. STRINGS.CHARACTERS.WANDA.BATTLECRY.DEER
msgctxt "STRINGS.CHARACTERS.WANDA.BATTLECRY.DEER"
msgid "This won't go well for you!"
msgstr "Você vai se dar mal!"

#. STRINGS.CHARACTERS.WANDA.BATTLECRY.GENERIC
msgctxt "STRINGS.CHARACTERS.WANDA.BATTLECRY.GENERIC"
msgid "You ruffian! I'll clean your clock!"
msgstr "Seu rufião! Vou acabar com você!"

#. STRINGS.CHARACTERS.WANDA.BATTLECRY.PIG
msgctxt "STRINGS.CHARACTERS.WANDA.BATTLECRY.PIG"
msgid "Your time ends now, pig!"
msgstr "Sua hora chegou, porco!"

#. STRINGS.CHARACTERS.WANDA.BATTLECRY.PREY
msgctxt "STRINGS.CHARACTERS.WANDA.BATTLECRY.PREY"
msgid "It's nothing personal!"
msgstr "Não é nada pessoal!"

#. STRINGS.CHARACTERS.WANDA.BATTLECRY.SPIDER
msgctxt "STRINGS.CHARACTERS.WANDA.BATTLECRY.SPIDER"
msgid "Dial it back a notch, would you?"
msgstr "É melhor baixar a bola, viu?"

#. STRINGS.CHARACTERS.WANDA.BATTLECRY.SPIDER_WARRIOR
msgctxt "STRINGS.CHARACTERS.WANDA.BATTLECRY.SPIDER_WARRIOR"
msgid "Did I insult you in some other timeline?"
msgstr "Eu ofendi você em outra linha do tempo?"

#. STRINGS.CHARACTERS.WANDA.COMBAT_QUIT.GENERIC
msgctxt "STRINGS.CHARACTERS.WANDA.COMBAT_QUIT.GENERIC"
msgid "I've got better things to do."
msgstr "Tenho coisas melhores para fazer."

#. STRINGS.CHARACTERS.WANDA.COMBAT_QUIT.PIG
msgctxt "STRINGS.CHARACTERS.WANDA.COMBAT_QUIT.PIG"
msgid "At least they're gone now."
msgstr "Pelo menos já foram embora."

#. STRINGS.CHARACTERS.WANDA.COMBAT_QUIT.PREY
msgctxt "STRINGS.CHARACTERS.WANDA.COMBAT_QUIT.PREY"
msgid "All that time I spent, down the drain."
msgstr "Tanto tempo pra nada."

#. STRINGS.CHARACTERS.WANDA.COMBAT_QUIT.SPIDER
msgctxt "STRINGS.CHARACTERS.WANDA.COMBAT_QUIT.SPIDER"
msgid "I hope I don't run into him again."
msgstr "Espero não encontrá-la de novo."

#. STRINGS.CHARACTERS.WANDA.COMBAT_QUIT.SPIDER_WARRIOR
msgctxt "STRINGS.CHARACTERS.WANDA.COMBAT_QUIT.SPIDER_WARRIOR"
msgid "And don't come back!"
msgstr "E não volte mais!"

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.ABIGAIL.LEVEL1.1
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.ABIGAIL.LEVEL1.1"
msgid "Poor thing. Her time came too soon."
msgstr "Coitadinha. A hora dela chegou cedo demais."

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.ABIGAIL.LEVEL1.2
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.ABIGAIL.LEVEL1.2"
msgid "Poor thing. Her time came too soon."
msgstr "Coitadinha. A hora dela chegou cedo demais."

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.ABIGAIL.LEVEL2.1
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.ABIGAIL.LEVEL2.1"
msgid "Poor thing. Her time came too soon."
msgstr "Coitadinha. A hora dela chegou cedo demais."

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.ABIGAIL.LEVEL2.2
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.ABIGAIL.LEVEL2.2"
msgid "Poor thing. Her time came too soon."
msgstr "Coitadinha. A hora dela chegou cedo demais."

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.ABIGAIL.LEVEL3.1
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.ABIGAIL.LEVEL3.1"
msgid "Poor thing. Her time came too soon."
msgstr "Coitadinha. A hora dela chegou cedo demais."

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.ABIGAIL.LEVEL3.2
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.ABIGAIL.LEVEL3.2"
msgid "Poor thing. Her time came too soon."
msgstr "Coitadinha. A hora dela chegou cedo demais."

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.ABIGAIL_FLOWER.GENERIC
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.ABIGAIL_FLOWER.GENERIC"
msgid "There's something about that flower..."
msgstr "Essa flor... tem algo diferente nela..."

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.ABIGAIL_FLOWER.HAUNTED_GROUND
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.ABIGAIL_FLOWER.HAUNTED_GROUND"
msgid "I'd die to find out what it does."
msgstr "Eu morreria pra descobrir o que isso faz."

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.ABIGAIL_FLOWER.HAUNTED_POCKET
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.ABIGAIL_FLOWER.HAUNTED_POCKET"
msgid "I don't think I should hang on to this."
msgstr "Acho que não devo ficar com isso."

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.ABIGAIL_FLOWER.LEVEL1
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.ABIGAIL_FLOWER.LEVEL1"
msgid "There's something about that flower..."
msgstr "Essa flor... tem algo diferente nela..."

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.ABIGAIL_FLOWER.LEVEL2
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.ABIGAIL_FLOWER.LEVEL2"
msgid "There's energy building around it."
msgstr "Há um acúmulo de energia ao redor dela."

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.ABIGAIL_FLOWER.LEVEL3
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.ABIGAIL_FLOWER.LEVEL3"
msgid "Something's about to happen!"
msgstr "Algo está prestes a acontecer!"

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.ABIGAIL_FLOWER.LONG
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.ABIGAIL_FLOWER.LONG"
msgid "It hurts my soul to look at that thing."
msgstr "Minha alma dói quando olho pra isso."

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.ABIGAIL_FLOWER.MEDIUM
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.ABIGAIL_FLOWER.MEDIUM"
msgid "It's giving me the creeps."
msgstr "Está me dando arrepios."

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.ABIGAIL_FLOWER.SOON
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.ABIGAIL_FLOWER.SOON"
msgid "Something is up with that flower!"
msgstr "Tem algo errado com essa flor!"

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.ABYSSPILLAR_MINION.ACTIVATED
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.ABYSSPILLAR_MINION.ACTIVATED"
msgid "Yes, they follow a pattern..."
msgstr "Sim, seguem um padrão..."

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.ABYSSPILLAR_MINION.GENERIC
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.ABYSSPILLAR_MINION.GENERIC"
msgid "There's something about it..."
msgstr "Isso tem alguma coisa..."

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.ABYSSPILLAR_TRIAL
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.ABYSSPILLAR_TRIAL"
msgid "Is it my choice to pull the lever now if I already know what I'm going to do?"
msgstr "Será que eu tenho escolha de puxar a alavanca se já sei o que vou fazer?"

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.ACCOMPLISHMENT_SHRINE
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.ACCOMPLISHMENT_SHRINE"
msgid "I want to use it, and I want the world to know that I did."
msgstr "Quero usá-lo, e quero que o mundo saiba o que eu fiz."

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.ACORN
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.ACORN"
msgid "In time, it'll be a new tree."
msgstr "Com o tempo, ela se tornará uma árvore."

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.ACORN_COOKED
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.ACORN_COOKED"
msgid "Maybe in another timeline it grew to be a tree."
msgstr "Talvez ela vire uma árvore em outra linha do tempo."

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.ACORN_SAPLING
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.ACORN_SAPLING"
msgid "Trees are so painfully slow to grow."
msgstr "As árvores crescem muito devagar."

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.ADVENTURE_PORTAL
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.ADVENTURE_PORTAL"
msgid "What's the worst that could happen?"
msgstr "O que poderia acontecer de pior?"

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.ALTERGUARDIANHAT
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.ALTERGUARDIANHAT"
msgid "I-I can see now! The timelines are untangling before my eyes!"
msgstr "A-agora eu entendo! As linhas do tempo estão se desembaraçando diante dos meus olhos!"

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.ALTERGUARDIANHATSHARD
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.ALTERGUARDIANHATSHARD"
msgid "I wonder what else I could fashion with this."
msgstr "O que mais eu poderia fazer com isto?"

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.ALTERGUARDIAN_CONTAINED
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.ALTERGUARDIAN_CONTAINED"
msgid "I should have known it would happen like this again."
msgstr "Eu já devia saber que isso iria acontecer de novo."

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.ALTERGUARDIAN_PHASE1.DEAD
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.ALTERGUARDIAN_PHASE1.DEAD"
msgid "It's down... for the time being."
msgstr "Foi derrotado... por enquanto."

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.ALTERGUARDIAN_PHASE1.GENERIC
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.ALTERGUARDIAN_PHASE1.GENERIC"
msgid "Oh botheration, not you..."
msgstr "Ai, que amolação! Você não..."

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.ALTERGUARDIAN_PHASE1_LUNARRIFT
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.ALTERGUARDIAN_PHASE1_LUNARRIFT"
msgid "There's something different about you."
msgstr "Tem algo diferente em você."

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.ALTERGUARDIAN_PHASE1_LUNARRIFT_GESTALT
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.ALTERGUARDIAN_PHASE1_LUNARRIFT_GESTALT"
msgid "He's waiting for it."
msgstr "Ele está esperando por isso."

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.ALTERGUARDIAN_PHASE2.DEAD
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.ALTERGUARDIAN_PHASE2.DEAD"
msgid "Just give me a moment to catch my breath..."
msgstr "Só me dá um instante, preciso recuperar o fôlego..."

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.ALTERGUARDIAN_PHASE2.GENERIC
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.ALTERGUARDIAN_PHASE2.GENERIC"
msgid "I'm already at the dizzy age, all that spinning is just making it worse!"
msgstr "Já estou numa idade avançada. Esses giros só estão piorando minha labirintite!"

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.ALTERGUARDIAN_PHASE2SPIKE
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.ALTERGUARDIAN_PHASE2SPIKE"
msgid "Nice try, but not even time can trap me!"
msgstr "Bela tentativa, mas nem o tempo pode me pegar!"

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.ALTERGUARDIAN_PHASE3
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.ALTERGUARDIAN_PHASE3"
msgid "Third time's a charm!"
msgstr "A terceira é a que vale!"

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.ALTERGUARDIAN_PHASE3DEAD
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.ALTERGUARDIAN_PHASE3DEAD"
msgid "There isn't so much as a spark of possibility left in it."
msgstr "Não resta mais do que uma fagulha de possibilidade nele."

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.ALTERGUARDIAN_PHASE3DEADORB
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.ALTERGUARDIAN_PHASE3DEADORB"
msgid "The air around it is still crackling with potential."
msgstr "O ar em torno dele ainda está repleto de potencial."

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.ALTERGUARDIAN_PHASE3TRAP
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.ALTERGUARDIAN_PHASE3TRAP"
msgid "I can't let myself fall asleep at a time like this!"
msgstr "Não posso dormir num momento como este!"

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.ALTERGUARDIAN_PHASE4_LUNARRIFT
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.ALTERGUARDIAN_PHASE4_LUNARRIFT"
msgid "I'll never get used to that!"
msgstr "Eu nunca vou me acostumar com isso!"

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.AMULET
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.AMULET"
msgid "I'll breathe easier knowing I have a backup plan."
msgstr "Vou ficar mais tranquila sabendo que tenho um plano b."

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.ANCHOR
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.ANCHOR"
msgid "I'm more suited to fine-tuning than heavy lifting."
msgstr "Levo mais jeito pra ajustes delicados do que trabalhos pesados."

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.ANCHOR_ITEM
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.ANCHOR_ITEM"
msgid "I guess it might be useful... but I'd rather not to stay in one place for too long."
msgstr "Acho que pode ser útil... mas prefiro não ficar num único lugar por muito tempo."

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.ANCIENTFRUIT_GEM
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.ANCIENTFRUIT_GEM"
msgid "I'd rather not break my teeth on that, thank you."
msgstr "Obrigada, mas prefiro não quebrar meus dentes com isso."

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.ANCIENTFRUIT_NIGHTVISION
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.ANCIENTFRUIT_NIGHTVISION"
msgid "Not exactly appetizing, but useful in the dark."
msgstr "Não é exatamente apetitosa, mas é útil no escuro."

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.ANCIENTFRUIT_NIGHTVISION_COOKED
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.ANCIENTFRUIT_NIGHTVISION_COOKED"
msgid "That's a bit better. I think."
msgstr "Assim ficou um pouco melhor. Eu acho."

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.ANCIENTTREE_GEM.GENERIC
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.ANCIENTTREE_GEM.GENERIC"
msgid "It burns with an everlasting fire... how inspiring."
msgstr "Arde com uma chama eterna... que inspiradora."

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.ANCIENTTREE_GEM.STUMP
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.ANCIENTTREE_GEM.STUMP"
msgid "Ah. I suppose that fire wasn't so everlasting after all."
msgstr "Ah. Suponho que aquela chama não era tão eterna assim, afinal."

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.ANCIENTTREE_NIGHTVISION.GENERIC
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.ANCIENTTREE_NIGHTVISION.GENERIC"
msgid "What a terribly off-putting tree."
msgstr "Que árvore terrivelmente desconcertante."

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.ANCIENTTREE_NIGHTVISION.STUMP
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.ANCIENTTREE_NIGHTVISION.STUMP"
msgid "Good riddance."
msgstr "Já vai tarde."

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.ANCIENTTREE_SAPLING.GENERIC
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.ANCIENTTREE_SAPLING.GENERIC"
msgid "Only marginally more exciting than watching grass grow."
msgstr "Ligeiramente mais eletrizante que assistir à grama crescer."

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.ANCIENTTREE_SAPLING.WRONG_SEASON
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.ANCIENTTREE_SAPLING.WRONG_SEASON"
msgid "I suppose I'll just have to... ugh... wait."
msgstr "Suponho que terei que... ugh... esperar."

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.ANCIENTTREE_SAPLING.WRONG_TILE
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.ANCIENTTREE_SAPLING.WRONG_TILE"
msgid "Oh botheration, it doesn't seem to like this type of soil."
msgstr "Ai, que amolação, parece que ela não gosta desse tipo de solo."

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.ANCIENTTREE_SAPLING_ITEM
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.ANCIENTTREE_SAPLING_ITEM"
msgid "Now, if I could only remember what type of soil it likes..."
msgstr "Se eu pelo menos conseguisse me lembrar do tipo de solo que ela gosta..."

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.ANCIENTTREE_SEED
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.ANCIENTTREE_SEED"
msgid "Maybe I could skip ahead and take a peek at what it grows into..."
msgstr "Talvez eu possa avançar no tempo e dar uma olhada em como vai ficar quando crescer..."

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.ANCIENT_ALTAR
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.ANCIENT_ALTAR"
msgid "It seems like they were a clever bunch. Just not clever enough."
msgstr "Parece que eles eram muito inteligentes, mas não o bastante."

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.ANCIENT_ALTAR_BROKEN
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.ANCIENT_ALTAR_BROKEN"
msgid "Time has worn it away."
msgstr "Foi desgastado pelo tempo."

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.ANCIENT_HUSK
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.ANCIENT_HUSK"
msgid "How awful."
msgstr "Que coisa horrível."

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.ANCIENT_STATUE
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.ANCIENT_STATUE"
msgid "What's left from a time long ago."
msgstr "O que resta de uma época remota."

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.ANIMAL_TRACK
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.ANIMAL_TRACK"
msgid "Something went that way... hopefully something tasty."
msgstr "Algo foi praquele lado... tomara que seja algo gostoso."

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.ANTCHOVIES
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.ANTCHOVIES"
msgid "Yeesh. Can I toss it back?"
msgstr "Eita. Será que posso jogá-la de volta?"

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.ANTLION.GENERIC
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.ANTLION.GENERIC"
msgid "Oh botheration, I hope I remembered to bring a gift."
msgstr "Ai, que amolação! Espero ter me lembrado de trazer um presente."

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.ANTLION.UNHAPPY
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.ANTLION.UNHAPPY"
msgid "There's no need to get yourself so worked up!"
msgstr "Não precisa ficar tão nervoso!"

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.ANTLION.VERYHAPPY
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.ANTLION.VERYHAPPY"
msgid "Oh now you're in a good mood?"
msgstr "Ah, agora você está de bom humor?"

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.ANTLIONHAT
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.ANTLIONHAT"
msgid "Oh my, what a splendidly strange hat!"
msgstr "Ah, nossa, que esplêndido chapéu esquisito!"

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.ANTLIONTRINKET
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.ANTLIONTRINKET"
msgid "This might make a good gift for someone."
msgstr "Isso pode virar um bom presente pra alguém."

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.ARCHIVE_CENTIPEDE
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.ARCHIVE_CENTIPEDE"
msgid "You mechanical menace!"
msgstr "Sua ameaça mecânica!"

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.ARCHIVE_CENTIPEDE_HUSK
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.ARCHIVE_CENTIPEDE_HUSK"
msgid "Not one usable bit of clockwork to be found."
msgstr "Não tem um único mecanismo que possa ser aproveitado."

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.ARCHIVE_COOKPOT.BURNT
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.ARCHIVE_COOKPOT.BURNT"
msgid "Well that's a setback."
msgstr "Bom, sofri um revés."

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.ARCHIVE_COOKPOT.COOKING_LONG
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.ARCHIVE_COOKPOT.COOKING_LONG"
msgid "This is why I hate cooking. Cooking takes forever!"
msgstr "É por isso que odeio cozinhar. É demorado demais!"

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.ARCHIVE_COOKPOT.COOKING_SHORT
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.ARCHIVE_COOKPOT.COOKING_SHORT"
msgid "It has to be almost done by now, right?"
msgstr "Já deve estar quase pronto, né?"

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.ARCHIVE_COOKPOT.DONE
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.ARCHIVE_COOKPOT.DONE"
msgid "At long last, food!"
msgstr "Até que enfim, comida!"

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.ARCHIVE_COOKPOT.EMPTY
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.ARCHIVE_COOKPOT.EMPTY"
msgid "I'd say it's been a few centuries since this was last used."
msgstr "Diria que faz alguns séculos que ninguém usa este forno."

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.ARCHIVE_LOCKBOX
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.ARCHIVE_LOCKBOX"
msgid "It's quite a puzzling piece, isn't it?"
msgstr "É um item bastante intrigante, não é?"

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.ARCHIVE_LOCKBOX_DISPENCER.GENERIC
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.ARCHIVE_LOCKBOX_DISPENCER.GENERIC"
msgid "How delightfully odd!"
msgstr "É de uma estranheza adorável!"

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.ARCHIVE_LOCKBOX_DISPENCER.POWEROFF
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.ARCHIVE_LOCKBOX_DISPENCER.POWEROFF"
msgid "It looks like it needs a good winding."
msgstr "Acho que alguém precisa dar corda nela."

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.ARCHIVE_MOON_STATUE
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.ARCHIVE_MOON_STATUE"
msgid "Relics from a distant time."
msgstr "Relíquias de uma época remota."

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.ARCHIVE_ORCHESTRINA_MAIN
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.ARCHIVE_ORCHESTRINA_MAIN"
msgid "What an intricate design."
msgstr "Que design complexo."

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.ARCHIVE_PORTAL.GENERIC
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.ARCHIVE_PORTAL.GENERIC"
msgid "Well, it was worth a try."
msgstr "Bom, valeu a tentativa."

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.ARCHIVE_PORTAL.POWEROFF
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.ARCHIVE_PORTAL.POWEROFF"
msgid "Hm, maybe this time..."
msgstr "Hm, talvez desta vez..."

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.ARCHIVE_RESONATOR.GENERIC
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.ARCHIVE_RESONATOR.GENERIC"
msgid "Finally, something to point me in the right direction!"
msgstr "Até que enfim, algo pra me apontar a direção certa!"

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.ARCHIVE_RESONATOR.IDLE
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.ARCHIVE_RESONATOR.IDLE"
msgid "It's finally found something!"
msgstr "Ele finalmente encontrou algo!"

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.ARCHIVE_RESONATOR_ITEM
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.ARCHIVE_RESONATOR_ITEM"
msgid "I think I took it to the surface before, or maybe I'll do that soon."
msgstr "Acho que já o levei pra superfície antes, ou quem sabe o farei em breve?"

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.ARCHIVE_RUNE_STATUE.LINE_1
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.ARCHIVE_RUNE_STATUE.LINE_1"
msgid "I won't waste my time trying to decipher this gibberish."
msgstr "Não vou perder meu tempo tentando decifrar esta baboseira."

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.ARCHIVE_RUNE_STATUE.LINE_2
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.ARCHIVE_RUNE_STATUE.LINE_2"
msgid "I'd go back and ask what it means, but this time period is a bit beyond my reach."
msgstr "Eu voltaria no tempo pra perguntar o que significa, mas a época disto está além do meu alcance."

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.ARCHIVE_RUNE_STATUE.LINE_3
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.ARCHIVE_RUNE_STATUE.LINE_3"
msgid "I won't waste my time trying to decipher this gibberish."
msgstr "Não vou perder meu tempo tentando decifrar esta baboseira."

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.ARCHIVE_RUNE_STATUE.LINE_4
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.ARCHIVE_RUNE_STATUE.LINE_4"
msgid "I'd go back and ask what it means, but this time period is a bit beyond my reach."
msgstr "Eu voltaria no tempo pra perguntar o que significa, mas a época disto está além do meu alcance."

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.ARCHIVE_RUNE_STATUE.LINE_5
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.ARCHIVE_RUNE_STATUE.LINE_5"
msgid "I won't waste my time trying to decipher this gibberish."
msgstr "Não vou perder meu tempo tentando decifrar esta baboseira."

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.ARCHIVE_SECURITY_DESK.GENERIC
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.ARCHIVE_SECURITY_DESK.GENERIC"
msgid "Oh botheration, I think I just remembered something..."
msgstr "Ai, que amolação! Acho que acabo de me lembrar de algo..."

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.ARCHIVE_SECURITY_DESK.POWEROFF
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.ARCHIVE_SECURITY_DESK.POWEROFF"
msgid "What a curious relic."
msgstr "Que relíquia curiosa."

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.ARCHIVE_SECURITY_PULSE
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.ARCHIVE_SECURITY_PULSE"
msgid "Hurry, someone catch it before-!"
msgstr "Depressa, alguém tem que apanhá-lo antes que...!"

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.ARCHIVE_SWITCH.GEMS
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.ARCHIVE_SWITCH.GEMS"
msgid "There's something missing here."
msgstr "Está faltando alguma coisa aqui."

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.ARCHIVE_SWITCH.VALID
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.ARCHIVE_SWITCH.VALID"
msgid "Oh good, we got the lights working."
msgstr "Que bom, a gente conseguiu acender as luzes."

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.ARMORDRAGONFLY
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.ARMORDRAGONFLY"
msgid "I think it looks better on me than it did on the bug."
msgstr "Acho que ficou melhor em mim do que no inseto."

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.ARMORDREADSTONE
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.ARMORDREADSTONE"
msgid "It should keep me well protected, at least."
msgstr "Deve me manter bem protegida, pelo menos."

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.ARMORGRASS
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.ARMORGRASS"
msgid "Isn't there anything a bit more sturdy?"
msgstr "Não tem nada um pouco mais resistente?"

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.ARMORMARBLE
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.ARMORMARBLE"
msgid "Well it's definitely sturdy, but why does it have to be so heavy?!"
msgstr "Bom, sem dúvida é resistente, mas por que precisa ser tão pesada?"

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.ARMORRUINS
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.ARMORRUINS"
msgid "I'm all for anything that'll keep me safe."
msgstr "Sou a favor de qualquer coisa que me mantenha a salvo."

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.ARMORSKELETON
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.ARMORSKELETON"
msgid "Nope. Nope nope nope."
msgstr "Negativo. Não, não, não."

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.ARMORSLURPER
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.ARMORSLURPER"
msgid "I guess I'll swallow my pride and wear it..."
msgstr "Acho que vou engolir meu orgulho e vesti-la..."

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.ARMORSNURTLESHELL
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.ARMORSNURTLESHELL"
msgid "It's not pleasant, but I do feel a bit safer."
msgstr "Não é agradável, mas me sinto um pouco mais segura."

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.ARMORWAGPUNK
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.ARMORWAGPUNK"
msgid "You can always rely on clockwork."
msgstr "Você sempre pode confiar em mecanismos."

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.ARMORWOOD
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.ARMORWOOD"
msgid "Good enough for now."
msgstr "Boa o bastante por enquanto."

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.ARMOR_BRAMBLE
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.ARMOR_BRAMBLE"
msgid "Sometimes it pays to have a prickly exterior."
msgstr "Às vezes vale a pena ter um exterior espinhoso."

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.ARMOR_CARROTLURE
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.ARMOR_CARROTLURE"
msgid "I can see why the bunnies love it."
msgstr "Entendo por que os coelhinhos adoram."

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.ARMOR_LUNARPLANT
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.ARMOR_LUNARPLANT"
msgid "Some extra protection is always welcome."
msgstr "Proteção extra é sempre bem-vinda."

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.ARMOR_LUNARPLANT_HUSK
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.ARMOR_LUNARPLANT_HUSK"
msgid "It kills while it protects. Rather efficient."
msgstr "Mata ao mesmo tempo que protege. Deveras eficiente."

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.ARMOR_SANITY
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.ARMOR_SANITY"
msgid "Shadow magic is just a tool after all, I can use it to my advantage."
msgstr "No fim, a magia das sombras é apenas uma ferramenta que posso usar a meu favor."

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.ARMOR_VOIDCLOTH
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.ARMOR_VOIDCLOTH"
msgid "I prefer chains that have a pocket watch at the end of them."
msgstr "Prefiro correntes que têm relógios de bolso na ponta."

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.ARMOR_YOTH_KNIGHT
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.ARMOR_YOTH_KNIGHT"
msgid "This should offer some protection."
msgstr "Isso deve oferecer um pouco de proteção."

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.ARROWSIGN_PANEL.BURNT
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.ARROWSIGN_PANEL.BURNT"
msgid "That's a bad sign."
msgstr "Essa placa é um mau sinal."

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.ARROWSIGN_PANEL.GENERIC
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.ARROWSIGN_PANEL.GENERIC"
msgid "That must be some kind of sign."
msgstr "Deve ser algum tipo de placa."

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.ARROWSIGN_PANEL.UNWRITTEN
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.ARROWSIGN_PANEL.UNWRITTEN"
msgid "There's nothing written here. What an unhelpful sign!"
msgstr "Não tem nada escrito aqui. Que placa inútil!"

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.ARROWSIGN_POST.BURNT
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.ARROWSIGN_POST.BURNT"
msgid "That's a bad sign."
msgstr "Essa placa é um mau sinal."

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.ARROWSIGN_POST.GENERIC
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.ARROWSIGN_POST.GENERIC"
msgid "That must be some kind of sign."
msgstr "Deve ser algum tipo de placa."

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.ARROWSIGN_POST.UNWRITTEN
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.ARROWSIGN_POST.UNWRITTEN"
msgid "There's nothing written here. What an unhelpful sign!"
msgstr "Não tem nada escrito aqui. Que placa inútil!"

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.ASH.GENERIC
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.ASH.GENERIC"
msgid "What a mess."
msgstr "Que bagunça."

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.ASH.REMAINS_EYE_BONE
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.ASH.REMAINS_EYE_BONE"
msgid "It couldn't withstand the trip."
msgstr "Não resistiu à viagem."

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.ASH.REMAINS_GLOMMERFLOWER
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.ASH.REMAINS_GLOMMERFLOWER"
msgid "It couldn't withstand the trip."
msgstr "Não resistiu à viagem."

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.ASH.REMAINS_THINGIE
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.ASH.REMAINS_THINGIE"
msgid "Oh. I don't even remember what that was."
msgstr "Ah. Nem lembro o que era isso."

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.ASPARAGUS
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.ASPARAGUS"
msgid "One must stay healthy if they want to live to a ripe old age."
msgstr "Quem quer viver muitos anos precisa cuidar bem da saúde."

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.ASPARAGUSSOUP
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.ASPARAGUSSOUP"
msgid "A nice warm bowl of soup."
msgstr "Uma boa tigela de sopa quente."

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.ASPARAGUS_COOKED
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.ASPARAGUS_COOKED"
msgid "Not quite as crisp anymore."
msgstr "Não está mais tão crocante."

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.ASPARAGUS_OVERSIZED
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.ASPARAGUS_OVERSIZED"
msgid "That might be altogether too much asparagus, even for me."
msgstr "É aspargo demais, até mesmo pra mim."

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.ASPARAGUS_SEEDS
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.ASPARAGUS_SEEDS"
msgid "Why waste time growing them when I can just eat them now?"
msgstr "Pra que perder tempo plantando estas sementes se posso comê-las agora?"

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.ATRIUM_GATE.CHARGING
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.ATRIUM_GATE.CHARGING"
msgid "Does anyone else feel a crackle of magic in the air?"
msgstr "Alguém mais está sentindo a magia crepitando no ar?"

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.ATRIUM_GATE.COOLDOWN
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.ATRIUM_GATE.COOLDOWN"
msgid "For the time being, I think it should be left alone."
msgstr "Por enquanto, acho melhor não mexer nesse negócio."

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.ATRIUM_GATE.DESTABILIZING
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.ATRIUM_GATE.DESTABILIZING"
msgid "The magical field is collapsing!"
msgstr "O campo mágico está desmoronando!"

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.ATRIUM_GATE.OFF
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.ATRIUM_GATE.OFF"
msgid "With a bit of tinkering, I could get it working again."
msgstr "Com alguns ajustes, posso fazer com que volte a funcionar."

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.ATRIUM_GATE.ON
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.ATRIUM_GATE.ON"
msgid "It's radiating a strange energy, almost like..."
msgstr "Está irradiando uma energia estranha, quase como..."

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.ATRIUM_KEY
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.ATRIUM_KEY"
msgid "Am I sure I want to take this?"
msgstr "Será que quero mesmo pegar isso?"

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.ATRIUM_LIGHT.OFF
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.ATRIUM_LIGHT.OFF"
msgid "I don't know if I want those lights to turn on..."
msgstr "Não sei se quero que essas luzes se acendam..."

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.ATRIUM_LIGHT.ON
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.ATRIUM_LIGHT.ON"
msgid "I should keep my distance."
msgstr "É melhor eu manter a distância."

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.ATRIUM_OVERGROWTH
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.ATRIUM_OVERGROWTH"
msgid "It probably says something like \"turn back while you can\"."
msgstr "É provável que diga algo como \"vá embora enquanto ainda pode\"."

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.ATRIUM_RUBBLE.LINE_1
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.ATRIUM_RUBBLE.LINE_1"
msgid "A mural of an ancient civilization, but something is wrong..."
msgstr "Um mural de uma antiga civilização, mas tem alguma coisa errada..."

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.ATRIUM_RUBBLE.LINE_2
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.ATRIUM_RUBBLE.LINE_2"
msgid "Whatever was here has been lost to time."
msgstr "Seja lá o que havia aqui se perdeu no tempo."

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.ATRIUM_RUBBLE.LINE_3
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.ATRIUM_RUBBLE.LINE_3"
msgid "It shows shadows descending on the city."
msgstr "Mostra sombras descendo sobre a cidade."

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.ATRIUM_RUBBLE.LINE_4
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.ATRIUM_RUBBLE.LINE_4"
msgid "The people weren't quick enough to escape. They paid a price..."
msgstr "As pessoas não conseguiram escapar. Elas pagaram o preço..."

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.ATRIUM_RUBBLE.LINE_5
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.ATRIUM_RUBBLE.LINE_5"
msgid "They had the right idea for a while, but they must have made a mistake."
msgstr "Sua perspectiva estava correta até certo momento, mas devem ter cometido um erro."

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.ATRIUM_STATUE
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.ATRIUM_STATUE"
msgid "A frozen moment in ancient history."
msgstr "Um momento congelado na história antiga."

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.AXE
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.AXE"
msgid "I'm used to using more delicate tools."
msgstr "Estou acostumada a usar ferramentas mais delicadas."

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.BABYBEEFALO.GENERIC
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.BABYBEEFALO.GENERIC"
msgid "So young, so full of life."
msgstr "Tão jovem, tão cheio de vida."

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.BABYBEEFALO.SLEEPING
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.BABYBEEFALO.SLEEPING"
msgid "Who has time to sleep?"
msgstr "Quem tem tempo pra dormir?"

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.BACKPACK
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.BACKPACK"
msgid "I could always use the extra pocket space."
msgstr "Espaço extra nunca é demais."

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.BACONEGGS
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.BACONEGGS"
msgid "Who has time to sit and eat breakfast?"
msgstr "Quem tem tempo pra tomar café da manhã?"

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.BALATRO_MACHINE
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.BALATRO_MACHINE"
msgid "Perhaps I have time for a round or two."
msgstr "Talvez eu tenha tempo pra uma rodada ou duas."

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.BALLOON
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.BALLOON"
msgid "Balloons have such a short lifespan."
msgstr "Os balões tem uma vida útil muito curta."

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.BALLOONHAT
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.BALLOONHAT"
msgid "Ha, I'd look ridiculous in that! Let me try it on."
msgstr "Ha, eu ficaria ridícula com isso! Vou experimentar."

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.BALLOONPARTY
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.BALLOONPARTY"
msgid "Balloons within balloons."
msgstr "Balões dentro de balões."

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.BALLOONSPEED.DEFLATED
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.BALLOONSPEED.DEFLATED"
msgid "Well, that was short-lived."
msgstr "Bom, durou pouco."

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.BALLOONSPEED.GENERIC
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.BALLOONSPEED.GENERIC"
msgid "Just the extra bit of speed I've been looking for!"
msgstr "Era exatamente este acréscimo de velocidade que eu estava procurando!"

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.BALLOONS_EMPTY
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.BALLOONS_EMPTY"
msgid "Everyone has their forte. Some bend time, others bend balloons."
msgstr "Todo mundo tem seu ponto forte. Alguns manipulam o tempo, outros, balões."

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.BALLOONVEST
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.BALLOONVEST"
msgid "If it keeps me from drowning, I'll wear it."
msgstr "Se impedir que eu me afogue, vou usá-lo."

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.BANANABUSH
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.BANANABUSH"
msgid "They're much easier to pick this way."
msgstr "Elas ficam muito mais fáceis de colher assim."

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.BANANAJUICE
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.BANANAJUICE"
msgid "I suppose I can spare a moment to enjoy a sip or two."
msgstr "Acho que posso gastar um segundo pra um gole ou dois."

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.BANANAPOP
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.BANANAPOP"
msgid "There's nothing quicker and simpler than fruit on a stick."
msgstr "Não tem nada mais rápido e simples do que fruta num espeto."

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.BANDAGE
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.BANDAGE"
msgid "I just need a little time and I'll be right as rain."
msgstr "Só preciso de um tempinho pra ficar bem."

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.BANDAGE_BUTTERFLYWINGS
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.BANDAGE_BUTTERFLYWINGS"
msgid "This will heal it up in no time at all."
msgstr "Isso vai curar o ferimento num piscar de olhos."

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.BARNACLE
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.BARNACLE"
msgid "I had quite the time prying them free."
msgstr "Me diverti muito observando-as livremente."

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.BARNACLEPITA
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.BARNACLEPITA"
msgid "The barnacles fit quite nicely in that bread pocket."
msgstr "As cracas ficam muito boas nesse bolso de pão."

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.BARNACLESTUFFEDFISHHEAD
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.BARNACLESTUFFEDFISHHEAD"
msgid "I'm starting to feel bad for the fish..."
msgstr "Estou começando a me sentir mal pelo peixe..."

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.BARNACLESUSHI
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.BARNACLESUSHI"
msgid "All wrapped up with a little bow."
msgstr "Prontinho e amarrado com uma fita."

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.BARNACLE_COOKED
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.BARNACLE_COOKED"
msgid "Only marginally better than raw barnacles."
msgstr "Ligeiramente melhor que cracas cruas."

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.BARNACLINGUINE
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.BARNACLINGUINE"
msgid "That should keep me fed for a good while."
msgstr "Isso deve me manter alimentada por um bom tempo."

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.BASALT
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.BASALT"
msgid "That's too strong to break through!"
msgstr "É muito duro para quebrar!"

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.BAT
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.BAT"
msgid "Stay out of my hair, it's enough of a bat's nest already!"
msgstr "Sai pra lá, meu cabelo não precisa de mais nada pra parecer um ninho de morcego!"

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.BATBAT
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.BATBAT"
msgid "The bat won't be needing it anymore, I might as well put it to good use."
msgstr "O morcego não precisará mais disso, então é melhor fazer uso dele."

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.BATCAVE
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.BATCAVE"
msgid "Don't mind me... just passing through..."
msgstr "Não ligue pra mim... estou só de passagem..."

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.BATHBOMB
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.BATHBOMB"
msgid "It might be nice to have a warm bath and unwind for a moment or two."
msgstr "Seria ótimo tomar um banho quente e relaxar por alguns instantes."

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.BATNOSE
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.BATNOSE"
msgid "That should teach it not to stick its nose where it doesn't belong!"
msgstr "Isso vai ensinar a ele a não meter o nariz onde não é chamado!"

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.BATNOSEHAT
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.BATNOSEHAT"
msgid "What a wonderful, time-saving design!"
msgstr "Esse design é maravilhoso e permite poupar tempo."

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.BATNOSE_COOKED
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.BATNOSE_COOKED"
msgid "It hardly makes a difference whether it's raw or cooked."
msgstr "Quase não faz diferença se está cru ou cozido."

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.BATTLESONG_CONTAINER
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.BATTLESONG_CONTAINER"
msgid "Wonderfully efficient song storage."
msgstr "Um armazenamento de músicas maravilhosamente eficiente."

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.BATTLESONG_DURABILITY
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.BATTLESONG_DURABILITY"
msgid "Oh, you wouldn't want to hear me sing... would you?"
msgstr "Ah, você não ia querer me ouvir cantar... né?"

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.BATTLESONG_FIRERESISTANCE
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.BATTLESONG_FIRERESISTANCE"
msgid "Oh, you wouldn't want to hear me sing... would you?"
msgstr "Ah, você não ia querer me ouvir cantar... né?"

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.BATTLESONG_HEALTHGAIN
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.BATTLESONG_HEALTHGAIN"
msgid "Oh, you wouldn't want to hear me sing... would you?"
msgstr "Ah, você não ia querer me ouvir cantar... né?"

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.BATTLESONG_INSTANT_PANIC
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.BATTLESONG_INSTANT_PANIC"
msgid "It's her delivery that really scares the Dickens out of you."
msgstr "É a interpretação dela que provoca medo."

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.BATTLESONG_INSTANT_REVIVE
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.BATTLESONG_INSTANT_REVIVE"
msgid "Oh, you wouldn't want to hear me sing... would you?"
msgstr "Ah, você não ia querer me ouvir cantar... né?"

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.BATTLESONG_INSTANT_TAUNT
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.BATTLESONG_INSTANT_TAUNT"
msgid "Insults are so much more scathing when they rhyme."
msgstr "Os insultos ficam muito mais mordazes quando rimam."

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.BATTLESONG_LUNARALIGNED
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.BATTLESONG_LUNARALIGNED"
msgid "Oh, you wouldn't want to hear me sing... would you?"
msgstr "Ah, você não ia querer me ouvir cantar... né?"

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.BATTLESONG_SANITYAURA
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.BATTLESONG_SANITYAURA"
msgid "Oh, you wouldn't want to hear me sing... would you?"
msgstr "Ah, você não ia querer me ouvir cantar... né?"

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.BATTLESONG_SANITYGAIN
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.BATTLESONG_SANITYGAIN"
msgid "Oh, you wouldn't want to hear me sing... would you?"
msgstr "Ah, você não ia querer me ouvir cantar... né?"

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.BATTLESONG_SHADOWALIGNED
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.BATTLESONG_SHADOWALIGNED"
msgid "Oh, you wouldn't want to hear me sing... would you?"
msgstr "Ah, você não ia querer me ouvir cantar... né?"

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.BATWING
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.BATWING"
msgid "That'll teach those bats."
msgstr "Isso vai dar uma lição naqueles morcegos."

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.BATWING_COOKED
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.BATWING_COOKED"
msgid "I don't know what flavor I expected, but it wasn't that."
msgstr "Não sei que sabor eu esperava, mas não era isso."

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.BEARDHAIR
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.BEARDHAIR"
msgid "I know it's the wilderness, but does he have to leave whiskers everywhere?"
msgstr "Eu sei que estamos em meio à natureza, mas ele precisa deixar bigodes por tudo?"

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.BEARGER
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.BEARGER"
msgid "All the worst parts of a bear and a badger rolled into one."
msgstr "O pior de um urso e de um texugo misturados numa só criatura."

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.BEARGERCORPSE.BURNING
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.BEARGERCORPSE.BURNING"
msgid "You're not coming back this time."
msgstr "Você não vai voltar desta vez."

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.BEARGERCORPSE.GENERIC
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.BEARGERCORPSE.GENERIC"
msgid "Finally, it's over!"
msgstr "Até que enfim, acabou!"

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.BEARGERCORPSE.REVIVING
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.BEARGERCORPSE.REVIVING"
msgid "Oh botheration! I have to deal with you again?!"
msgstr "Ai, que amolação! Vou ter que te enfrentar de novo?!"

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.BEARGERFUR_SACK
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.BEARGERFUR_SACK"
msgid "It can keep my perishables cold anywhere, anytime."
msgstr "Pode manter meus produtos perecíveis refrigerados em qualquer lugar, a qualquer hora."

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.BEARGERVEST
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.BEARGERVEST"
msgid "It reminds me of that time I was almost eaten by a Bearger, but it's cozy."
msgstr "Me faz lembrar daquela vez em que quase fui devorada por um Texurso, mas é confortável."

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.BEARGER_FUR
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.BEARGER_FUR"
msgid "It was either him or me."
msgstr "Era ele ou eu."

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.BEAST_BLUEPRINT
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.BEAST_BLUEPRINT"
msgid "If it's so lucky, maybe I'll keep it for myself."
msgstr "Se dá tanta sorte, talvez eu fique com ela pra mim."

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.BEDROLL_FURRY
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.BEDROLL_FURRY"
msgid "If I have to spend time sleeping, at least I can do it comfortably."
msgstr "Se eu tiver que dormir, ao menos posso fazê-lo de maneira confortável."

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.BEDROLL_STRAW
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.BEDROLL_STRAW"
msgid "That doesn't look comfortable at all."
msgstr "Isso não parece nada confortável."

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.BEE.GENERIC
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.BEE.GENERIC"
msgid "It's thinking about stinging me, I can see it in its beady eyes."
msgstr "Está pensando em me dar uma ferroada, posso ver em seus olhos redondos."

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.BEE.HELD
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.BEE.HELD"
msgid "It seemed like a good idea at the time."
msgstr "Pareceu uma boa ideia na hora."

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.BEEBOX.BURNT
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.BEEBOX.BURNT"
msgid "It looks like its honey making days are behind it."
msgstr "Parece que seus dias de produção de mel acabaram."

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.BEEBOX.FULLHONEY
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.BEEBOX.FULLHONEY"
msgid "Finally!"
msgstr "Finalmente!"

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.BEEBOX.GENERIC
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.BEEBOX.GENERIC"
msgid "I thought I heard some buzzing coming from over here."
msgstr "Acho que ouvi um zumbido vindo daqui."

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.BEEBOX.NOHONEY
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.BEEBOX.NOHONEY"
msgid "Not even a drop of honey inside."
msgstr "Não tem nenhuma gota de mel aqui dentro."

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.BEEBOX.READY
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.BEEBOX.READY"
msgid "Finally!"
msgstr "Finalmente!"

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.BEEBOX.SOMEHONEY
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.BEEBOX.SOMEHONEY"
msgid "Why does honey take so long to make?"
msgstr "Por que o mel demora tanto pra ser produzido?"

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.BEEBOX_HERMIT.BURNT
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.BEEBOX_HERMIT.BURNT"
msgid "It looks like its honey making days are behind it."
msgstr "Parece que seus dias de produção de mel acabaram."

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.BEEBOX_HERMIT.FULLHONEY
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.BEEBOX_HERMIT.FULLHONEY"
msgid "Finally!"
msgstr "Finalmente!"

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.BEEBOX_HERMIT.GENERIC
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.BEEBOX_HERMIT.GENERIC"
msgid "She's quite creative with her limited materials."
msgstr "Ela é bastante criativa com seus materiais limitados."

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.BEEBOX_HERMIT.NOHONEY
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.BEEBOX_HERMIT.NOHONEY"
msgid "Not even a drop of honey inside."
msgstr "Não tem nenhuma gota de mel aqui dentro."

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.BEEBOX_HERMIT.READY
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.BEEBOX_HERMIT.READY"
msgid "Finally!"
msgstr "Finalmente!"

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.BEEBOX_HERMIT.SOMEHONEY
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.BEEBOX_HERMIT.SOMEHONEY"
msgid "Why does honey take so long to make?"
msgstr "Por que o mel demora tanto pra ser produzido?"

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.BEEFALO.DEAD
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.BEEFALO.DEAD"
msgid "His time is up. Or is it?"
msgstr "O tempo dele acabou. Ou será que não?"

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.BEEFALO.DEAD_MYPARTNER
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.BEEFALO.DEAD_MYPARTNER"
msgid "I wish I could give you more time."
msgstr "Queria poder te dar mais tempo."

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.BEEFALO.DOMESTICATED
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.BEEFALO.DOMESTICATED"
msgid "We've come to an understanding."
msgstr "Chegamos a um entendimento."

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.BEEFALO.FOLLOWER
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.BEEFALO.FOLLOWER"
msgid "It took long enough, but we're finally getting along."
msgstr "Demorou bastante, mas finalmente estamos nos entendendo."

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.BEEFALO.GENERIC
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.BEEFALO.GENERIC"
msgid "Not exactly majestic, are they?"
msgstr "Não são exatamente majestosos, né?"

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.BEEFALO.MYPARTNER
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.BEEFALO.MYPARTNER"
msgid "He seems to like me."
msgstr "Ele parece gostar de mim."

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.BEEFALO.NAKED
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.BEEFALO.NAKED"
msgid "Sorry, I needed that fur."
msgstr "Desculpe, eu precisava dessa pele."

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.BEEFALO.ORNERY
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.BEEFALO.ORNERY"
msgid "I don't like the look on his face..."
msgstr "Não gosto da cara que ele está fazendo..."

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.BEEFALO.PUDGY
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.BEEFALO.PUDGY"
msgid "He's gotten a little soft around the edges."
msgstr "Ele cresceu um pouco para os lados."

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.BEEFALO.RIDER
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.BEEFALO.RIDER"
msgid "With his help, I'll shave precious minutes off my traveling time!"
msgstr "Com a ajuda dele, vou poupar minutos preciosos do meu tempo de viagem!"

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.BEEFALO.SLEEPING
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.BEEFALO.SLEEPING"
msgid "Look at him, snoring away precious hours!"
msgstr "Olha só pra ele, desperdiçando preciosas horas roncando!"

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.BEEFALOFEED
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.BEEFALOFEED"
msgid "Did I remember to feed my beefalo today?"
msgstr "Será que lembrei de alimentar meu bífalo hoje?"

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.BEEFALOHAT
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.BEEFALOHAT"
msgid "I kind of imagined a fur hat would feel fancier."
msgstr "Já imaginava que um chapéu de pele ficaria mais chique."

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.BEEFALOTREAT
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.BEEFALOTREAT"
msgid "It's probably better for them than candy from my pockets..."
msgstr "É provavelmente melhor para eles do que os doces dos meus bolsos..."

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.BEEFALOWOOL
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.BEEFALOWOOL"
msgid "The beefalo will grow it back."
msgstr "O bífalo vai produzir mais."

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.BEEFALO_GROOMER.BURNT
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.BEEFALO_GROOMER.BURNT"
msgid "Oh botheration, not again."
msgstr "Ai, que amolação! De novo não."

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.BEEFALO_GROOMER.GENERIC
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.BEEFALO_GROOMER.GENERIC"
msgid "Oh! I almost forgot to bring the beefalo!"
msgstr "Ah! Quase me esqueci de trazer o bífalo!"

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.BEEFALO_GROOMER.OCCUPIED
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.BEEFALO_GROOMER.OCCUPIED"
msgid "You'll be the most smartly dressed creature around!"
msgstr "Você vai ser a criatura mais bem vestida do pedaço!"

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.BEEFALO_GROOMER_ITEM
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.BEEFALO_GROOMER_ITEM"
msgid "Did I not set that up already?"
msgstr "Eu já não instalei isso?"

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.BEEF_BELL
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.BEEF_BELL"
msgid "It makes taming beefalo so much faster!"
msgstr "Ele acelera muito o adestramento de bífalos!"

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.BEEGUARD
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.BEEGUARD"
msgid "If only I had a little army that would protect me this fiercely!"
msgstr "Se ao menos eu tivesse um pequeno exército que me protegesse com tanta intensidade!"

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.BEEHAT
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.BEEHAT"
msgid "I like having a layer of netting between the bees and my face."
msgstr "Gosto de ter uma camada de rede entre as abelhas e meu rosto."

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.BEEHIVE
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.BEEHIVE"
msgid "I'm sure the bees are working like clockwork in there."
msgstr "Tenho certeza de que as abelhas estão trabalhando como um relógio ali dentro."

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.BEEMINE
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.BEEMINE"
msgid "You come after me, you get the bees!"
msgstr "Se vier atrás de mim, vai ter que enfrentar as abelhas!"

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.BEEMINE_MAXWELL
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.BEEMINE_MAXWELL"
msgid "Bottled mosquito rage!"
msgstr "Raiva de mosquito engarrafada!"

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.BEEQUEEN
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.BEEQUEEN"
msgid "This was a terrible idea!"
msgstr "Essa foi uma péssima ideia!"

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.BEEQUEENHIVE.GENERIC
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.BEEQUEENHIVE.GENERIC"
msgid "I'm done messing around with beehives."
msgstr "Cansei de brincar com colmeias."

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.BEEQUEENHIVE.GROWING
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.BEEQUEENHIVE.GROWING"
msgid "Has it grown since I last saw it?"
msgstr "Ela cresceu desde a última vez que a vi?"

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.BEEQUEENHIVEGROWN
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.BEEQUEENHIVEGROWN"
msgid "This is giving me a bad feeling..."
msgstr "Isto está me dando um mau pressentimento..."

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.BEESWAX
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.BEESWAX"
msgid "If only I knew how to make candles."
msgstr "Quem dera eu soubesse fazer velas."

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.BEESWAX_SPRAY
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.BEESWAX_SPRAY"
msgid "If only I could make use of its unique preservation effects..."
msgstr "Se ao menos desse para aproveitar os peculiares efeitos de preservação..."

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.BEETLETAUR
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.BEETLETAUR"
msgid "I can smell him from here!"
msgstr "Posso sentir seu cheiro daqui!"

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.BELL
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.BELL"
msgid "What's the worst that could happen?"
msgstr "O que poderia acontecer de pior?"

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.BERNIE_ACTIVE
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.BERNIE_ACTIVE"
msgid "How incredible that this isn't even the strangest thing I've seen."
msgstr "É incrível que essa não seja a coisa mais estranha que já vi."

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.BERNIE_BIG
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.BERNIE_BIG"
msgid "I could've sworn you were smaller..."
msgstr "Eu podia jurar que você era menor..."

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.BERNIE_INACTIVE.BROKEN
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.BERNIE_INACTIVE.BROKEN"
msgid "This can't be the end. We'll fix this!"
msgstr "Não pode terminar assim. Vamos dar um jeito nisto!"

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.BERNIE_INACTIVE.GENERIC
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.BERNIE_INACTIVE.GENERIC"
msgid "It looks well-loved."
msgstr "Parece muito amado."

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.BERRIES
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.BERRIES"
msgid "These will keep me going a while longer."
msgstr "Elas vão me sustentar por mais um tempo."

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.BERRIES_COOKED
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.BERRIES_COOKED"
msgid "Well, now they're kind of a hot mush..."
msgstr "Bom, agora que elas viraram uma papa quente..."

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.BERRIES_JUICY
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.BERRIES_JUICY"
msgid "Their time is fleeting, and they taste all the sweeter for it."
msgstr "Sua efemeridade as deixa ainda mais doces."

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.BERRIES_JUICY_COOKED
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.BERRIES_JUICY_COOKED"
msgid "That turned out better than I expected."
msgstr "Ficou melhor do que eu esperava."

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.BERRYBUSH.BARREN
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.BERRYBUSH.BARREN"
msgid "It needs something to get it growing again."
msgstr "Precisa de algo pra fazê-la crescer de novo."

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.BERRYBUSH.BURNING
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.BERRYBUSH.BURNING"
msgid "That's not good."
msgstr "Isso não é bom."

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.BERRYBUSH.DISEASED
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.BERRYBUSH.DISEASED"
msgid "It looks pretty sick."
msgstr "Parece bem doente."

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.BERRYBUSH.DISEASING
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.BERRYBUSH.DISEASING"
msgid "Err, something's not right."
msgstr "Ahm, algo errado não está certo."

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.BERRYBUSH.GENERIC
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.BERRYBUSH.GENERIC"
msgid "Aha! A ready supply of food!"
msgstr "Ah-rá! Um suprimento de comida pronto!"

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.BERRYBUSH.PICKED
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.BERRYBUSH.PICKED"
msgid "Why do berries take so long to grow back?"
msgstr "Por que as bagas demoram tanto pra crescer de novo?"

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.BERRYBUSH.WITHERED
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.BERRYBUSH.WITHERED"
msgid "Everything is withering away in this heat."
msgstr "Neste calor, tudo definha."

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.BERRYBUSH_JUICY.BARREN
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.BERRYBUSH_JUICY.BARREN"
msgid "What do berry bushes need to grow again?"
msgstr "Do que as moitas de bagas precisam pra crescer de novo?"

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.BERRYBUSH_JUICY.BURNING
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.BERRYBUSH_JUICY.BURNING"
msgid "That's not good."
msgstr "Isso não é bom."

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.BERRYBUSH_JUICY.DISEASED
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.BERRYBUSH_JUICY.DISEASED"
msgid "It looks pretty sick."
msgstr "Parece bem doente."

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.BERRYBUSH_JUICY.DISEASING
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.BERRYBUSH_JUICY.DISEASING"
msgid "Err, something's not right."
msgstr "Ahm, algo errado não está certo."

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.BERRYBUSH_JUICY.GENERIC
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.BERRYBUSH_JUICY.GENERIC"
msgid "I can hear my stomach growling, and those berries look so tasty..."
msgstr "Meu estômago está roncando, e essas bagas parecem tão apetitosas..."

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.BERRYBUSH_JUICY.PICKED
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.BERRYBUSH_JUICY.PICKED"
msgid "Berries grow so frustratingly slow!"
msgstr "É frustrante a lentidão com que as bagas crescem!"

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.BERRYBUSH_JUICY.WITHERED
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.BERRYBUSH_JUICY.WITHERED"
msgid "Oh, it's so sad!"
msgstr "Ah, que triste!"

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.BERRYSAUCE
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.BERRYSAUCE"
msgid "Why bother putting it on something when you can just eat it by itself?"
msgstr "Por que se dar o trabalho de colocá-lo em algo quando se pode comer assim mesmo?"

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.BIBINGKA
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.BIBINGKA"
msgid "Bready and delicious."
msgstr "Pãozudo e delicioso."

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.BIGFOOT
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.BIGFOOT"
msgid "That is one biiig foot."
msgstr "Esse pé é beem grande."

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.BIRCHNUTDRAKE
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.BIRCHNUTDRAKE"
msgid "I'll stomp you back into the ground, you overgrown seedling!"
msgstr "Vou te pisotear até voltar pra baixo da terra, sua mudinha superdesenvolvida!"

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.BIRDCAGE.DEAD
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.BIRDCAGE.DEAD"
msgid "It was... probably just his time."
msgstr "Acho que... chegou a hora dele."

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.BIRDCAGE.GENERIC
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.BIRDCAGE.GENERIC"
msgid "All it needs now is a little cuckoo bird."
msgstr "Só está faltando um cuco."

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.BIRDCAGE.HUNGRY
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.BIRDCAGE.HUNGRY"
msgid "Is it feeding time?"
msgstr "É a hora da comida?"

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.BIRDCAGE.OCCUPIED
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.BIRDCAGE.OCCUPIED"
msgid "Not a cuckoo, but close enough."
msgstr "Não é um cuco, mas serve."

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.BIRDCAGE.SKELETON
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.BIRDCAGE.SKELETON"
msgid "Oh botheration, I forgot all about him!"
msgstr "Ai, que amolação. Eu me esqueci completamente dele!"

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.BIRDCAGE.SLEEPING
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.BIRDCAGE.SLEEPING"
msgid "You could be spending this time laying eggs!"
msgstr "Você podia estar botando ovos em vez de dormir!"

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.BIRDCAGE.STARVING
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.BIRDCAGE.STARVING"
msgid "Oh botheration, I forgot to feed you again, didn't I?"
msgstr "Ai, que amolação. Eu me esqueci de te dar comida de novo, né?"

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.BIRDCORPSE.BURNING
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.BIRDCORPSE.BURNING"
msgid "This should put an end to it."
msgstr "Isso deve acabar com ele."

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.BIRDCORPSE.GENERIC
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.BIRDCORPSE.GENERIC"
msgid "I know what comes next."
msgstr "Eu já sei o que vai acontecer."

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.BIRDCORPSE.REVIVING
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.BIRDCORPSE.REVIVING"
msgid "I hate this part."
msgstr "Odeio essa parte."

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.BIRDTRAP
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.BIRDTRAP"
msgid "Thankfully, birds are stupid."
msgstr "Ainda bem que os pássaros são idiotas."

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.BIRD_EGG
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.BIRD_EGG"
msgid "What, you egg?"
msgstr "Que foi, ovinho?"

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.BIRD_EGG_COOKED
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.BIRD_EGG_COOKED"
msgid "Whenever I make eggs they end up either undercooked or burnt."
msgstr "Nunca acerto o ponto dos ovos. Ou ficam mal cozidos, ou acabam queimando."

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.BIRD_MUTANT
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.BIRD_MUTANT"
msgid "What an awful sight!"
msgstr "Que visão horrorosa!"

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.BIRD_MUTANT_SPITTER
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.BIRD_MUTANT_SPITTER"
msgid "Why don't you run along and spit somewhere else?"
msgstr "Por que você não vai cuspir em outro lugar?"

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.BISHOP
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.BISHOP"
msgid "What an irresponsible use of clockwork!"
msgstr "Quem fez esse mecanismo foi muito irresponsável!"

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.BISHOP_CHARGE_HIT
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.BISHOP_CHARGE_HIT"
msgid "Ack!!"
msgstr "Ugh!"

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.BISHOP_NIGHTMARE
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.BISHOP_NIGHTMARE"
msgid "It's been completely taken over..."
msgstr "Foi completamente dominado..."

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.BLACKFLAG
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.BLACKFLAG"
msgid "Such an ominous color..."
msgstr "Que cor sinistra..."

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.BLOWDART_FIRE
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.BLOWDART_FIRE"
msgid "This is playing with fire..."
msgstr "Isto é brincar com fogo..."

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.BLOWDART_LAVA
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.BLOWDART_LAVA"
msgid "That's a weapon I could use from range."
msgstr "Essa é uma arma que eu poderia usar de longe."

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.BLOWDART_LAVA2
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.BLOWDART_LAVA2"
msgid "It uses a strong blast of air to propel a projectile."
msgstr "Ela usa uma explosão forte de ar para propulsionar um projétil."

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.BLOWDART_PIPE
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.BLOWDART_PIPE"
msgid "I like a weapon you can shoot from far away. Preferably while running."
msgstr "Gosto de uma arma que pode ser disparada de longe. De preferência correndo."

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.BLOWDART_SLEEP
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.BLOWDART_SLEEP"
msgid "This should help me avoid some conflict."
msgstr "Isso deve me ajudar a evitar um conflito."

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.BLOWDART_YELLOW
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.BLOWDART_YELLOW"
msgid "That'll give them a shock!"
msgstr "Isso vai dar um choque neles!"

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.BLUEAMULET
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.BLUEAMULET"
msgid "Just looking at it chills me to the bone."
msgstr "Me dá calafrios só de olhar!"

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.BLUEGEM
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.BLUEGEM"
msgid "Why do people say things are as blue as the sea? The sea isn't very blue at all!"
msgstr "Por que as pessoas dizem que as coisas são azuis como o mar? O mar não é tão azul assim!"

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.BLUEMOONEYE
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.BLUEMOONEYE"
msgid "I might tinker with it a bit more when I have the time."
msgstr "Talvez eu mexa um pouco mais nela quando tiver tempo."

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.BLUEPRINT.COMMON
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.BLUEPRINT.COMMON"
msgid "This looks interesting."
msgstr "Isso parece interessante."

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.BLUEPRINT.RARE
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.BLUEPRINT.RARE"
msgid "Oooh, this looks very interesting!"
msgstr "Aaah, parece muito interessante!"

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.BLUE_CAP
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.BLUE_CAP"
msgid "It's... probably edible. If I'm desperate."
msgstr "É provável... que seja comestível. Se eu estiver desesperada."

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.BLUE_CAP_COOKED
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.BLUE_CAP_COOKED"
msgid "I think I made it worse."
msgstr "Acho que só piorei."

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.BLUE_MUSHROOM.GENERIC
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.BLUE_MUSHROOM.GENERIC"
msgid "A blue mushroom. Moving on."
msgstr "Um cogumelo azul. Continuando."

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.BLUE_MUSHROOM.INGROUND
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.BLUE_MUSHROOM.INGROUND"
msgid "Something or other tucked in the ground."
msgstr "Tem uma coisa enfiada no chão."

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.BLUE_MUSHROOM.PICKED
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.BLUE_MUSHROOM.PICKED"
msgid "No sense waiting around for it to grow back."
msgstr "Não vale a pena esperar que cresça de novo."

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.BOARDS
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.BOARDS"
msgid "I'm already bored of looking at them."
msgstr "Já estou entediada de olhar pra eles."

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.BOARON
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.BOARON"
msgid "I can take him!"
msgstr "Posso enfrentar ele!"

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.BOARRIOR
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.BOARRIOR"
msgid "You sure are big!"
msgstr "Você é mesmo grande!"

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.BOATFRAGMENT03
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.BOATFRAGMENT03"
msgid "Brrr... so many terrible things can happen out at sea."
msgstr "Brrr... tantas coisas terríveis podem acontecer no mar."

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.BOATFRAGMENT04
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.BOATFRAGMENT04"
msgid "Brrr... so many terrible things can happen out at sea."
msgstr "Brrr... tantas coisas terríveis podem acontecer no mar."

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.BOATFRAGMENT05
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.BOATFRAGMENT05"
msgid "Someone's boat met an untimely end."
msgstr "O barco de alguém teve um fim prematuro."

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.BOATPATCH
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.BOATPATCH"
msgid "I hope I won't need them..."
msgstr "Tomara que eu não precise disso..."

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.BOATPATCH_KELP
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.BOATPATCH_KELP"
msgid "That won't hold forever..."
msgstr "Não vai aguentar pra sempre..."

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.BOATRACE_CHECKPOINT
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.BOATRACE_CHECKPOINT"
msgid "A progress marker."
msgstr "Um marcador de progresso."

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.BOATRACE_CHECKPOINT_THROWABLE_DEPLOYKIT
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.BOATRACE_CHECKPOINT_THROWABLE_DEPLOYKIT"
msgid "Must find the most logical spot for this."
msgstr "Preciso ver o local mais lógico para usar isso."

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.BOATRACE_PRIMEMATE
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.BOATRACE_PRIMEMATE"
msgid "Looks like it won't just be a race against time."
msgstr "Pelo visto, não será apenas uma corrida contra o tempo."

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.BOATRACE_SEASTACK
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.BOATRACE_SEASTACK"
msgid "Botheration, these buoys are slowing me down!"
msgstr "Ai, que amolação, essas boias estão me desacelerando!"

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.BOATRACE_SEASTACK_MONKEY
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.BOATRACE_SEASTACK_MONKEY"
msgid "Botheration, these buoys are slowing me down!"
msgstr "Ai, que amolação, essas boias estão me desacelerando!"

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.BOATRACE_SEASTACK_MONKEY_THROWABLE_DEPLOYKIT
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.BOATRACE_SEASTACK_MONKEY_THROWABLE_DEPLOYKIT"
msgid "This could be troublesome, if deployed at exactly the right moment..."
msgstr "Seria um problema, se acionasse bem na hora certa..."

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.BOATRACE_SEASTACK_THROWABLE_DEPLOYKIT
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.BOATRACE_SEASTACK_THROWABLE_DEPLOYKIT"
msgid "This could be troublesome, if deployed at exactly the right moment..."
msgstr "Seria um problema, se acionasse bem na hora certa..."

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.BOATRACE_SPECTATOR_DRAGONLING
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.BOATRACE_SPECTATOR_DRAGONLING"
msgid "You could always stop staring and help me paddle."
msgstr "Você podia muito bem deixar de assistir e me ajudar a remar."

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.BOATRACE_START
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.BOATRACE_START"
msgid "We should start this race on time."
msgstr "Devemos começar essa corrida a tempo."

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.BOATRACE_START_THROWABLE_DEPLOYKIT
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.BOATRACE_START_THROWABLE_DEPLOYKIT"
msgid "Where to begin?"
msgstr "Por onde começar?"

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.BOAT_ANCIENT_CONTAINER
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.BOAT_ANCIENT_CONTAINER"
msgid "It's probably a good idea not to leave all my valuables out on the deck."
msgstr "Acho que é uma boa ideia não deixar todos os meus objetos de valor no convés."

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.BOAT_ANCIENT_ITEM
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.BOAT_ANCIENT_ITEM"
msgid "This old thing better be seaworthy..."
msgstr "Tomara que esta velharia sirva pra navegar..."

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.BOAT_BUMPER_CRABKING
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.BOAT_BUMPER_CRABKING"
msgid "It looks like it will outlive the boat."
msgstr "Parece que vai durar mais que o barco."

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.BOAT_BUMPER_CRABKING_KIT
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.BOAT_BUMPER_CRABKING_KIT"
msgid "It'll make me feel slightly safer at sea. Slightly."
msgstr "Vou me sentir um pouco mais segura no mar. Um pouco."

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.BOAT_BUMPER_KELP
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.BOAT_BUMPER_KELP"
msgid "Anything to prolong the life of my boat."
msgstr "Qualquer coisa pra prolongar a vida do meu barco."

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.BOAT_BUMPER_KELP_KIT
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.BOAT_BUMPER_KELP_KIT"
msgid "It'll make me feel slightly safer at sea. Slightly."
msgstr "Vou me sentir um pouco mais segura no mar. Um pouco."

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.BOAT_BUMPER_SHELL
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.BOAT_BUMPER_SHELL"
msgid "Anything to prolong the life of my boat."
msgstr "Qualquer coisa pra prolongar a vida do meu barco."

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.BOAT_BUMPER_SHELL_KIT
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.BOAT_BUMPER_SHELL_KIT"
msgid "It'll make me feel slightly safer at sea. Slightly."
msgstr "Vou me sentir um pouco mais segura no mar. Um pouco."

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.BOAT_BUMPER_YOTD
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.BOAT_BUMPER_YOTD"
msgid "I wouldn't like to be the one bumping into those horns."
msgstr "Eu não queria ser a pessoa a se esbarrar nesses chifres."

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.BOAT_BUMPER_YOTD_KIT
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.BOAT_BUMPER_YOTD_KIT"
msgid "It'll make me feel slightly safer at sea. Slightly."
msgstr "Vou me sentir um pouco mais segura no mar. Um pouco."

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.BOAT_CANNON.AMMOLOADED
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.BOAT_CANNON.AMMOLOADED"
msgid "It never hurts to take precautions."
msgstr "Nunca dói se precaver."

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.BOAT_CANNON.GENERIC
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.BOAT_CANNON.GENERIC"
msgid "I could have sworn I loaded that cannon... maybe it hasn't happened yet."
msgstr "Poderia jurar que eu carreguei o canhão... talvez não tenha acontecido ainda."

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.BOAT_CANNON.NOAMMO
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.BOAT_CANNON.NOAMMO"
msgid "Next time I'll remember to bring cannonballs."
msgstr "Da próxima vez vou lembrar de trazer as bolas de canhão."

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.BOAT_CANNON_KIT
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.BOAT_CANNON_KIT"
msgid "I'd better get that on my boat sooner rather than later."
msgstr "É melhor botar isso no barco o quanto antes."

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.BOAT_GRASS_ITEM
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.BOAT_GRASS_ITEM"
msgid "That certainly won't stand the test of time."
msgstr "Isso certamente não vai aguentar ao longo do tempo."

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.BOAT_ITEM
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.BOAT_ITEM"
msgid "Ohhh I hate the ocean, the time stream gets so wobbly around it."
msgstr "Ahhh, detesto o oceano, o fluxo do tempo fica muito instável perto dele."

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.BOAT_LEAK
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.BOAT_LEAK"
msgid "I need to stop that leak, quickly!"
msgstr "Preciso parar o vazamento, e rápido!"

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.BOAT_MAGNET.ACTIVATED
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.BOAT_MAGNET.ACTIVATED"
msgid "Well, I'm pleasantly surprised to see it works!"
msgstr "Bem, estou positivamente surpresa de ver isso funcionando!"

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.BOAT_MAGNET.GENERIC
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.BOAT_MAGNET.GENERIC"
msgid "This seems rather excessive."
msgstr "Isso parece um tanto excessivo."

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.BOAT_MAGNET_BEACON.ACTIVATED
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.BOAT_MAGNET_BEACON.ACTIVATED"
msgid "I suppose that means it's working."
msgstr "Suponho que isso signifique que está funcionando."

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.BOAT_MAGNET_BEACON.GENERIC
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.BOAT_MAGNET_BEACON.GENERIC"
msgid "I'm much more comfortable working with clockwork than... whatever this is."
msgstr "Sinto muito mais conforto trabalhando com relógios do que com... que quer que isso seja."

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.BOAT_MAGNET_KIT
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.BOAT_MAGNET_KIT"
msgid "That young man certainly has some odd ideas."
msgstr "Aquele jovenzinho certamente tem ideias estranhas."

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.BOAT_ROTATOR
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.BOAT_ROTATOR"
msgid "Clockwise or counter-clockwise?"
msgstr "Sentido horário ou anti-horário?"

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.BOAT_ROTATOR_KIT
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.BOAT_ROTATOR_KIT"
msgid "I can't believe I didn't think of it sooner."
msgstr "Não acredito que não pensei nisso antes."

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.BODYPILLOW_BEEFALOWOOL
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.BODYPILLOW_BEEFALOWOOL"
msgid "It looks quite comfortable."
msgstr "Parece bem confortável."

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.BODYPILLOW_KELP
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.BODYPILLOW_KELP"
msgid "Who thought this was a good idea?"
msgstr "Quem achou que essa era uma boa ideia?"

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.BODYPILLOW_PETALS
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.BODYPILLOW_PETALS"
msgid "What a lovely fragrance!"
msgstr "Que fragrância adorável!"

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.BODYPILLOW_STEELWOOL
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.BODYPILLOW_STEELWOOL"
msgid "It's horribly scratchy."
msgstr "É terrivelmente áspero."

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.BOMB_LUNARPLANT
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.BOMB_LUNARPLANT"
msgid "This should end a fight quickly."
msgstr "Isso deve acabar com uma luta bem rápido."

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.BOMB_LUNARPLANT_WORMWOOD
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.BOMB_LUNARPLANT_WORMWOOD"
msgid "Wait a tick... did they always look like that?"
msgstr "Espere um pouco... Elas sempre tiveram essa aparência?"

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.BONESHARD
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.BONESHARD"
msgid "Whatever these bones belonged to is lost to time."
msgstr "Seja quem for, o dono destes ossos se perdeu no tempo."

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.BONESOUP
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.BONESOUP"
msgid "Was leaving a chunk of bone in it really necessary?"
msgstr "Precisava mesmo deixar um naco de osso dentro dela?"

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.BONESTEW
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.BONESTEW"
msgid "Was leaving the bone in really necessary?"
msgstr "Precisava mesmo deixar o osso dentro?"

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.BOOKSTATION.BURNT
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.BOOKSTATION.BURNT"
msgid "Oh botheration, now that it's gone I actually want to read something."
msgstr "Ai, que amolação, agora que se foi eu estou com vontade de ler alguma coisa."

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.BOOKSTATION.GENERIC
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.BOOKSTATION.GENERIC"
msgid "As if I have time to sit and read!"
msgstr "Como se eu tivesse tempo pra sentar e ler!"

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.BOOK_BEES
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.BOOK_BEES"
msgid "I don't care for bees and I don't care to read about them."
msgstr "Não ligo pra abelhas e muito menos quero ler sobre elas."

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.BOOK_BIRDS
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.BOOK_BIRDS"
msgid "Time and birds sure do fly."
msgstr "O tempo e os pássaros voam."

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.BOOK_BRIMSTONE
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.BOOK_BRIMSTONE"
msgid "Hmph. Not if I can help it."
msgstr "Hunf. Não se eu puder evitar."

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.BOOK_ELEMENTAL
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.BOOK_ELEMENTAL"
msgid "I can't make out the text."
msgstr "Não consigo ler isso."

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.BOOK_FIRE
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.BOOK_FIRE"
msgid "No time to read, we're burning daylight!"
msgstr "Não dá tempo de ler, o dia está acabando!"

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.BOOK_FISH
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.BOOK_FISH"
msgid "Fishing is already time-consuming enough, I'm not reading a book too!"
msgstr "A pesca já gasta tempo o bastante, não vou ler um livro também!"

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.BOOK_FOSSIL
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.BOOK_FOSSIL"
msgid "This'll keep those monsters held for a little while."
msgstr "Vai prender esses monstros por um tempo."

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.BOOK_GARDENING
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.BOOK_GARDENING"
msgid "Do I even want to know how long the unabridged version was?"
msgstr "Será que quero mesmo saber o tamanho da versão integral?"

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.BOOK_HORTICULTURE
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.BOOK_HORTICULTURE"
msgid "Say Wickerbottom, do you dabble in temporal magic as well?"
msgstr "Me diga, Wickerbottom, você também se interessa por magia temporal?"

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.BOOK_HORTICULTURE_UPGRADED
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.BOOK_HORTICULTURE_UPGRADED"
msgid "Goodness, it's even thicker than the last one."
msgstr "Céus, é ainda mais grosso que o último."

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.BOOK_LIGHT
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.BOOK_LIGHT"
msgid "You know, this one might actually be worthwhile."
msgstr "Sabe, esse aqui pode acabar valendo a pena."

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.BOOK_LIGHT_UPGRADED
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.BOOK_LIGHT_UPGRADED"
msgid "Let's keep this one close at hand, shall we?"
msgstr "Vamos guardar esse aqui ao meu alcance, sim?"

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.BOOK_MOON
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.BOOK_MOON"
msgid "Do we really want to tamper with the moon? Oh, who am I to talk?"
msgstr "Queremos mesmo mexer com a lua? Ah, quem sou eu pra falar?"

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.BOOK_RAIN
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.BOOK_RAIN"
msgid "Rituals, hm? The old girl's got some tricks up her sleeve."
msgstr "Rituais, é? A velha garota tem uns truques na manga."

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.BOOK_RESEARCH_STATION
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.BOOK_RESEARCH_STATION"
msgid "I'll admit it's quite efficient to have everything in one book."
msgstr "Admito que é muito eficiente ter tudo em um só livro."

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.BOOK_SILVICULTURE
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.BOOK_SILVICULTURE"
msgid "Say Wickerbottom, do you dabble in temporal magic as well?"
msgstr "Me diga, Wickerbottom, você também se interessa por magia temporal?"

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.BOOK_SLEEP
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.BOOK_SLEEP"
msgid "Not to critique the writing, but that nearly put me to sleep."
msgstr "Não quero criticar a escrita, mas esse aí quase me pôs pra dormir."

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.BOOK_TEMPERATURE
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.BOOK_TEMPERATURE"
msgid "I won't spend my time and energy reading all that."
msgstr "Não vou gastar meu tempo e energia lendo tudo isso."

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.BOOK_TENTACLES
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.BOOK_TENTACLES"
msgid "It's enough having to deal with them in person, why read about them too?"
msgstr "Pra que ler sobre tentáculos? Já basta ter que lidar com eles pessoalmente."

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.BOOK_WEB
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.BOOK_WEB"
msgid "Ha! Was this written by a spider? I won't let my guard down that easily."
msgstr "Ha! Isso foi escrito por uma aranha? Não vou deixar minha guarda baixa assim fácil."

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.BOOMERANG
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.BOOMERANG"
msgid "I think I remember how to use this... yes, it's coming back to me!"
msgstr "Acho que lembro como usar isto... sim, estou me recordando!"

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.BOOTLEG
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.BOOTLEG"
msgid "Hmph. That's no proper spacial displacement device, just a cheap knockoff!"
msgstr "Hunf. Isso não é um dispositivo de deslocamento espacial adequado, é só uma imitação barata!"

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.BROKEN_FORGEDITEM
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.BROKEN_FORGEDITEM"
msgid "It looks well past its prime."
msgstr "Parece que já passou há muito do seu auge."

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.BROKEN_FUMAROLETOOLITEM
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.BROKEN_FUMAROLETOOLITEM"
msgid "With a little heat, I'll have it fixed up in no time at all."
msgstr "Com um pouquinho de calor, dá pra consertar isso rapidinho."

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.BRUSH
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.BRUSH"
msgid "Caring for animals is so time consuming!"
msgstr "Cuidar de animais ocupa muito tempo!"

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.BUGNET
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.BUGNET"
msgid "It'll be faster than trying to catch them with my hands."
msgstr "Vai ser mais rápido do que tentar pegá-los com as mãos."

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.BULLKELP_PLANT.GENERIC
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.BULLKELP_PLANT.GENERIC"
msgid "Kelp is only slightly more interesting than grass."
msgstr "Algas são só um pouco mais interessantes do que grama."

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.BULLKELP_PLANT.PICKED
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.BULLKELP_PLANT.PICKED"
msgid "It'll grow back eventually."
msgstr "Vai crescer de novo."

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.BULLKELP_ROOT
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.BULLKELP_ROOT"
msgid "I could plant this somewhere more convenient."
msgstr "Eu poderia plantar isto num lugar mais conveniente."

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.BUNDLE
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.BUNDLE"
msgid "Bundled up for quick and efficient carrying."
msgstr "Um pacote para transportar de forma rápida e eficiente."

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.BUNDLEWRAP
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.BUNDLEWRAP"
msgid "It'll keep my things safe from the ravages of time."
msgstr "Vou manter minhas coisas a salvo da devastação do tempo."

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.BUNNYMAN
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.BUNNYMAN"
msgid "I don't trust those things."
msgstr "Não confio nessas coisas."

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.BUNNYSTEW
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.BUNNYSTEW"
msgid "This rabbit was too late."
msgstr "Esse coelho demorou demais."

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.BURNT_MARSH_BUSH
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.BURNT_MARSH_BUSH"
msgid "Erased from the timeline."
msgstr "Apagada da linha do tempo."

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.BUSHHAT
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.BUSHHAT"
msgid "Hiding is always preferable to fighting."
msgstr "É sempre melhor se esconder do que lutar."

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.BUTTER
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.BUTTER"
msgid "If only I had some tea and toast."
msgstr "Bem que eu queria um chá com torradas agora."

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.BUTTERFLY.GENERIC
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.BUTTERFLY.GENERIC"
msgid "Don't go causing any tornadoes!"
msgstr "Não vá causar nenhum tornado!"

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.BUTTERFLY.HELD
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.BUTTERFLY.HELD"
msgid "Crisis averted."
msgstr "Crise evitada."

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.BUTTERFLYMUFFIN
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.BUTTERFLYMUFFIN"
msgid "It has a subtle taste, light and fleeting."
msgstr "Tem um gosto sutil, leve e fugaz."

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.BUTTERFLYWINGS
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.BUTTERFLYWINGS"
msgid "Careful with those!"
msgstr "Cuidado aí!"

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.BUZZARD
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.BUZZARD"
msgid "You're wasting your time following me, buzzard."
msgstr "Está perdendo seu tempo me seguindo, abutre."

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.BUZZARDCORPSE.BURNING
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.BUZZARDCORPSE.BURNING"
msgid "This should put an end to it."
msgstr "Isso deve acabar com ele."

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.BUZZARDCORPSE.GENERIC
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.BUZZARDCORPSE.GENERIC"
msgid "I know what comes next."
msgstr "Eu já sei o que vai acontecer."

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.BUZZARDCORPSE.REVIVING
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.BUZZARDCORPSE.REVIVING"
msgid "I hate this part."
msgstr "Odeio essa parte."

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.CABBAGEROLLS
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.CABBAGEROLLS"
msgid "Meat rolled in cabbage, simple as that."
msgstr "Carne enrolada no repolho. Simples assim."

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.CACTUS.GENERIC
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.CACTUS.GENERIC"
msgid "I wonder if it's really worth the bother."
msgstr "Me pergunto se vale o incômodo."

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.CACTUS.PICKED
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.CACTUS.PICKED"
msgid "Now to pick out all the spines. What a tedious vegetable."
msgstr "Hora de tirar todos os espinhos. Que vegetal entediante."

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.CACTUS_FLOWER
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.CACTUS_FLOWER"
msgid "I'm not stopping to smell it."
msgstr "Não vou parar para cheirá-la."

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.CACTUS_MEAT
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.CACTUS_MEAT"
msgid "Now to pick out all the spines. What a tedious vegetable."
msgstr "Hora de tirar todos os espinhos. Que vegetal entediante."

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.CACTUS_MEAT_COOKED
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.CACTUS_MEAT_COOKED"
msgid "Finally, I can eat it!"
msgstr "Finalmente, eu posso comê-lo!"

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.CALIFORNIAROLL
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.CALIFORNIAROLL"
msgid "Would this be the official dish of California, then?"
msgstr "Então este é o prato oficial da Califórnia?"

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.CAMPFIRE.EMBERS
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.CAMPFIRE.EMBERS"
msgid "I need to give it something to burn, quickly!"
msgstr "Preciso colocar algo pra queimar. E rápido!"

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.CAMPFIRE.GENERIC
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.CAMPFIRE.GENERIC"
msgid "It keeps the shadows at bay."
msgstr "Mantém a escuridão distante."

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.CAMPFIRE.HIGH
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.CAMPFIRE.HIGH"
msgid "Oh botheration, I got carried away with the kindling!"
msgstr "Ai, que amolação! Acabei me empolgando com o material inflamável!"

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.CAMPFIRE.LOW
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.CAMPFIRE.LOW"
msgid "It needs more to burn if I want it to last."
msgstr "Pra que o fogo dure, preciso pôr mais coisas pra queimar."

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.CAMPFIRE.NORMAL
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.CAMPFIRE.NORMAL"
msgid "That feels better."
msgstr "Assim está melhor."

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.CAMPFIRE.OUT
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.CAMPFIRE.OUT"
msgid "That was nice while it lasted."
msgstr "Foi bom enquanto durou."

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.CANARY.GENERIC
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.CANARY.GENERIC"
msgid "Some kind of yellow bird."
msgstr "Uma espécie de pássaro amarelo."

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.CANARY.HELD
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.CANARY.HELD"
msgid "Alright, I'm holding a bird... carefully holding a bird..."
msgstr "Certo, estou segurando um pássaro... com muito cuidado..."

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.CANARY_POISONED
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.CANARY_POISONED"
msgid "I think I should take that as a sign to leave."
msgstr "Acho que devo interpretar isso como um sinal pra dar o fora."

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.CANDYBAG
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.CANDYBAG"
msgid "It holds more than I expected, as if it's bigger on the inside..."
msgstr "Comporta mais do que eu esperava, como se fosse maior por dentro..."

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.CANE
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.CANE"
msgid "I don't need a cane yet! I feel fit as a fiddle!"
msgstr "Ainda não preciso de uma bengala! Estou em plena forma!"

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.CANNONBALL_ROCK_ITEM
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.CANNONBALL_ROCK_ITEM"
msgid "Pretty self-explanitory, really."
msgstr "Bem autoexplicativo, de verdade."

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.CARNIVALCANNON.COOLDOWN
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.CARNIVALCANNON.COOLDOWN"
msgid "Oooh what fun!"
msgstr "Aaah, que divertido!"

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.CARNIVALCANNON.GENERIC
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.CARNIVALCANNON.GENERIC"
msgid "I have so much to do, but... it's just such a delightful distraction!"
msgstr "Tenho muita coisa pra fazer, mas... é uma distração tão prazerosa!"

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.CARNIVALCANNON_KIT
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.CARNIVALCANNON_KIT"
msgid "I... guess I could spare a moment or two to set it up."
msgstr "Eu... acho que tenho um tempinho sobrando pra montá-lo."

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.CARNIVALDECOR_BANNER
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.CARNIVALDECOR_BANNER"
msgid "It's quite mesmerizing to watch."
msgstr "É bem fascinante de ver."

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.CARNIVALDECOR_BANNER_KIT
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.CARNIVALDECOR_BANNER_KIT"
msgid "Oh, I suppose I have a moment or two to spare."
msgstr "Ah, suponho que eu tenho um segundo ou dois pra gastar."

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.CARNIVALDECOR_EGGRIDE
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.CARNIVALDECOR_EGGRIDE"
msgid "What a delightful little mechanism!"
msgstr "Que mecanismozinho mais adorável!"

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.CARNIVALDECOR_EGGRIDE_KIT
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.CARNIVALDECOR_EGGRIDE_KIT"
msgid "I can't resist a chance to tinker with tiny mechanisms."
msgstr "Não resisto à chance de mexer em mecanismos minúsculos."

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.CARNIVALDECOR_FIGURE.GENERIC
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.CARNIVALDECOR_FIGURE.GENERIC"
msgid "I feel as though I've seen it a few times before."
msgstr "Tenho a sensação de que já vi isto várias vezes."

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.CARNIVALDECOR_FIGURE.RARE
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.CARNIVALDECOR_FIGURE.RARE"
msgid "I should really find a nice cabinet to display it in."
msgstr "É melhor eu encontrar um bom armário para exibi-la."

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.CARNIVALDECOR_FIGURE.UNCOMMON
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.CARNIVALDECOR_FIGURE.UNCOMMON"
msgid "It would look lovely over a fireplace, perhaps next to a fine mantel clock."
msgstr "Ficaria ótima em cima de uma lareira, talvez ao lado de um belo relógio antigo."

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.CARNIVALDECOR_FIGURE_KIT
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.CARNIVALDECOR_FIGURE_KIT"
msgid "I couldn't help it, I looked ahead and took a peek..."
msgstr "Não pude evitar, eu tive que dar uma espiada..."

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.CARNIVALDECOR_FIGURE_KIT_SEASON2
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.CARNIVALDECOR_FIGURE_KIT_SEASON2"
msgid "I couldn't help it, I looked ahead and took a peek..."
msgstr "Não pude evitar, eu tive que dar uma espiada..."

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.CARNIVALDECOR_LAMP
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.CARNIVALDECOR_LAMP"
msgid "Ah... I feel a bit better already."
msgstr "Ah... já me sinto um pouco melhor."

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.CARNIVALDECOR_LAMP_KIT
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.CARNIVALDECOR_LAMP_KIT"
msgid "You can never have too many nightlights."
msgstr "Abajures nunca são demais!"

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.CARNIVALDECOR_PLANT
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.CARNIVALDECOR_PLANT"
msgid "I guess some trees can be interesting to look at after all."
msgstr "No fim, acho que algumas árvores são interessantes de observar."

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.CARNIVALDECOR_PLANT_KIT
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.CARNIVALDECOR_PLANT_KIT"
msgid "A pocket-sized tree? I'm intrigued."
msgstr "Uma árvore minúscula? Fiquei intrigada."

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.CARNIVALFOOD_CORNTEA
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.CARNIVALFOOD_CORNTEA"
msgid "The taste is alright, but the texture..."
msgstr "O sabor é razoável, mas a textura..."

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.CARNIVALGAME_FEEDCHICKS_FOOD
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.CARNIVALGAME_FEEDCHICKS_FOOD"
msgid "A handful of colored paper? Oh! To represent worms, how clever!"
msgstr "Um punhado de papel colorido? Ah! Pra representar minhocas, que inteligente!"

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.CARNIVALGAME_FEEDCHICKS_KIT
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.CARNIVALGAME_FEEDCHICKS_KIT"
msgid "At least they're quick to assemble."
msgstr "Pelo menos são rápidos de montar."

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.CARNIVALGAME_FEEDCHICKS_NEST
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.CARNIVALGAME_FEEDCHICKS_NEST"
msgid "It leads down into the game's inner workings."
msgstr "Leva aos mecanismos internos do jogo."

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.CARNIVALGAME_FEEDCHICKS_STATION.GENERIC
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.CARNIVALGAME_FEEDCHICKS_STATION.GENERIC"
msgid "The mechanism won't work without a token."
msgstr "O mecanismo não vai funcionar sem uma ficha."

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.CARNIVALGAME_FEEDCHICKS_STATION.PLAYING
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.CARNIVALGAME_FEEDCHICKS_STATION.PLAYING"
msgid "Well... I guess I've got enough time for some nanty narking!"
msgstr "Bom... acho que tenho um tempinho para me regozijar!"

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.CARNIVALGAME_HERDING_CHICK
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.CARNIVALGAME_HERDING_CHICK"
msgid "Just you wait, I'm more spry than I look!"
msgstr "Espere só, sou mais ágil do que pareço!"

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.CARNIVALGAME_HERDING_KIT
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.CARNIVALGAME_HERDING_KIT"
msgid "At least they're quick to assemble."
msgstr "Pelo menos são rápidos de montar."

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.CARNIVALGAME_HERDING_STATION.GENERIC
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.CARNIVALGAME_HERDING_STATION.GENERIC"
msgid "The mechanism won't work without a token."
msgstr "O mecanismo não vai funcionar sem uma ficha."

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.CARNIVALGAME_HERDING_STATION.PLAYING
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.CARNIVALGAME_HERDING_STATION.PLAYING"
msgid "Oooh, that does look like fun..."
msgstr "Aaah, parece bem divertido..."

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.CARNIVALGAME_MEMORY_CARD.GENERIC
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.CARNIVALGAME_MEMORY_CARD.GENERIC"
msgid "It leads down into the game's inner workings."
msgstr "Leva aos mecanismos internos do jogo."

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.CARNIVALGAME_MEMORY_CARD.PLAYING
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.CARNIVALGAME_MEMORY_CARD.PLAYING"
msgid "Oh botheration, was it this one...?"
msgstr "Ai, que amolação! Era este daqui...?"

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.CARNIVALGAME_MEMORY_KIT
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.CARNIVALGAME_MEMORY_KIT"
msgid "At least they're quick to assemble."
msgstr "Pelo menos são rápidos de montar."

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.CARNIVALGAME_MEMORY_STATION.GENERIC
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.CARNIVALGAME_MEMORY_STATION.GENERIC"
msgid "The mechanism won't work without a token."
msgstr "O mecanismo não vai funcionar sem uma ficha."

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.CARNIVALGAME_MEMORY_STATION.PLAYING
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.CARNIVALGAME_MEMORY_STATION.PLAYING"
msgid "This might be a tricky one."
msgstr "Talvez este seja complicado."

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.CARNIVALGAME_PUCKDROP_KIT
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.CARNIVALGAME_PUCKDROP_KIT"
msgid "At least they're quick to assemble."
msgstr "Pelo menos são rápidos de montar."

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.CARNIVALGAME_PUCKDROP_STATION.GENERIC
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.CARNIVALGAME_PUCKDROP_STATION.GENERIC"
msgid "The mechanism won't work without a token."
msgstr "O mecanismo não vai funcionar sem uma ficha."

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.CARNIVALGAME_PUCKDROP_STATION.PLAYING
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.CARNIVALGAME_PUCKDROP_STATION.PLAYING"
msgid "I'm not sure that there's any actual skill involved here."
msgstr "Não tenho certeza se isso realmente depende de habilidade."

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.CARNIVALGAME_SHOOTING_BUTTON.GENERIC
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.CARNIVALGAME_SHOOTING_BUTTON.GENERIC"
msgid "The mechanism won't work without a token."
msgstr "O mecanismo não vai funcionar sem uma ficha."

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.CARNIVALGAME_SHOOTING_BUTTON.PLAYING
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.CARNIVALGAME_SHOOTING_BUTTON.PLAYING"
msgid "Buttons are so much more efficient than levers."
msgstr "Os botões são muito mais eficientes do que as alavancas."

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.CARNIVALGAME_SHOOTING_KIT
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.CARNIVALGAME_SHOOTING_KIT"
msgid "At least they're quick to assemble."
msgstr "Pelo menos são rápidos de montar."

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.CARNIVALGAME_SHOOTING_STATION.GENERIC
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.CARNIVALGAME_SHOOTING_STATION.GENERIC"
msgid "The mechanism won't work without a token."
msgstr "O mecanismo não vai funcionar sem uma ficha."

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.CARNIVALGAME_SHOOTING_STATION.PLAYING
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.CARNIVALGAME_SHOOTING_STATION.PLAYING"
msgid "My timing is impeccable, it's my aim that could use some work..."
msgstr "Minha cronometragem é impecável, mas minha mira precisa de ajustes..."

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.CARNIVALGAME_SHOOTING_TARGET.GENERIC
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.CARNIVALGAME_SHOOTING_TARGET.GENERIC"
msgid "It leads down into the game's inner workings."
msgstr "Leva aos mecanismos internos do jogo."

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.CARNIVALGAME_SHOOTING_TARGET.PLAYING
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.CARNIVALGAME_SHOOTING_TARGET.PLAYING"
msgid "Could they not be a bit bigger?"
msgstr "Eles não podiam ser um pouco maiores?"

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.CARNIVALGAME_WHEELSPIN_KIT
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.CARNIVALGAME_WHEELSPIN_KIT"
msgid "At least they're quick to assemble."
msgstr "Pelo menos são rápidos de montar."

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.CARNIVALGAME_WHEELSPIN_STATION.GENERIC
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.CARNIVALGAME_WHEELSPIN_STATION.GENERIC"
msgid "The mechanism won't work without a token."
msgstr "O mecanismo não vai funcionar sem uma ficha."

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.CARNIVALGAME_WHEELSPIN_STATION.PLAYING
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.CARNIVALGAME_WHEELSPIN_STATION.PLAYING"
msgid "It's so wonderfully efficient!"
msgstr "É tão maravilhosamente eficiente!"

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.CARNIVAL_BALL
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.CARNIVAL_BALL"
msgid "A colorful child's toy."
msgstr "Um brinquedo de criança colorido."

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.CARNIVAL_CROWKID
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.CARNIVAL_CROWKID"
msgid "Look at them, so full of youthful vitality!"
msgstr "Olhe só pra eles, repletos de vitalidade juvenil!"

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.CARNIVAL_GAMETOKEN
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.CARNIVAL_GAMETOKEN"
msgid "It's been meticulously polished."
msgstr "Foi polida com esmero."

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.CARNIVAL_HOST
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.CARNIVAL_HOST"
msgid "Hello there, Goodfeather. How long has it been?"
msgstr "Olá, Goodfeather. Há quanto tempo?"

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.CARNIVAL_PLAZA.GENERIC
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.CARNIVAL_PLAZA.GENERIC"
msgid "It could use a little something or other."
msgstr "Acho que precisa de alguma coisa ou outra."

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.CARNIVAL_PLAZA.LEVEL_2
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.CARNIVAL_PLAZA.LEVEL_2"
msgid "Putting a few more trinkets around wouldn't hurt."
msgstr "Não faria mal colocar mais algumas engenhocas em volta."

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.CARNIVAL_PLAZA.LEVEL_3
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.CARNIVAL_PLAZA.LEVEL_3"
msgid "An impressive sight, if I do say so myself!"
msgstr "Uma visão impressionante, se me atrevo a dizer."

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.CARNIVAL_PLAZA_KIT
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.CARNIVAL_PLAZA_KIT"
msgid "I hope it doesn't take too long to grow."
msgstr "Tomara que não demore demais pra crescer."

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.CARNIVAL_PRIZEBOOTH.GENERIC
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.CARNIVAL_PRIZEBOOTH.GENERIC"
msgid "Oooooh, what a delightful assortment of knickknacks!"
msgstr "Aaaaah, que variedade fantástica de quinquilharias!"

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.CARNIVAL_PRIZEBOOTH_KIT
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.CARNIVAL_PRIZEBOOTH_KIT"
msgid "At least they're quick to assemble."
msgstr "Pelo menos são rápidos de montar."

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.CARNIVAL_PRIZETICKET.GENERIC
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.CARNIVAL_PRIZETICKET.GENERIC"
msgid "Only one ticket?"
msgstr "Só um tíquete?"

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.CARNIVAL_PRIZETICKET.GENERIC_LARGESTACK
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.CARNIVAL_PRIZETICKET.GENERIC_LARGESTACK"
msgid "A respectable pile of tickets."
msgstr "Uma pilha respeitável de tíquetes."

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.CARNIVAL_PRIZETICKET.GENERIC_SMALLSTACK
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.CARNIVAL_PRIZETICKET.GENERIC_SMALLSTACK"
msgid "A small pile of tickets."
msgstr "Uma pequena pilha de tíquetes."

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.CARNIVAL_SEEDPACKET
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.CARNIVAL_SEEDPACKET"
msgid "A little snack to keep in my pocket."
msgstr "Um lanchinho pra guardar no bolso."

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.CARNIVAL_VEST_A
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.CARNIVAL_VEST_A"
msgid "Wearing a scarf to fend off the heat? How delightfully paradoxical!"
msgstr "Usar um cachecol pra me proteger do calor? Que paradoxo fabuloso!"

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.CARNIVAL_VEST_B
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.CARNIVAL_VEST_B"
msgid "How odd! A cloak to keep cool!"
msgstr "Que estranho! Um manto para refrescar!"

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.CARNIVAL_VEST_C
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.CARNIVAL_VEST_C"
msgid "Quite the afternoonified capelet!"
msgstr "Que capeleta elegante!"

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.CARPENTRY_BLADE_MOONGLASS
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.CARPENTRY_BLADE_MOONGLASS"
msgid "Well, does it saw faster?"
msgstr "Bom, ela serra mais rápido?"

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.CARPENTRY_STATION.BURNT
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.CARPENTRY_STATION.BURNT"
msgid "Well, that's decidedly unfunctional."
msgstr "Sem dúvida, isso não é funcional."

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.CARPENTRY_STATION.GENERIC
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.CARPENTRY_STATION.GENERIC"
msgid "I like my furniture simple and functional."
msgstr "Gosto que meus móveis sejam simples e funcionais."

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.CARRAT.DEAD
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.CARRAT.DEAD"
msgid "I think it's gone off."
msgstr "Acho que já era."

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.CARRAT.GENERIC
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.CARRAT.GENERIC"
msgid "That's the liveliest carrot I've ever seen."
msgstr "É a cenoura mais animada que eu já vi."

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.CARRAT.HELD
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.CARRAT.HELD"
msgid "Stop wriggling!"
msgstr "Pare de se contorcer!"

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.CARRAT.SLEEPING
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.CARRAT.SLEEPING"
msgid "It's taking a quick little nap."
msgstr "Está tirando um cochilo rápido."

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.CARRAT_GHOSTRACER
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.CARRAT_GHOSTRACER"
msgid "Nice try, but you won't fool me."
msgstr "Bela tentativa, mas você não vai me enganar."

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.CARROT
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.CARROT"
msgid "From the ground, straight to my mouth."
msgstr "Do chão, diretamente pra minha boca."

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.CARROT_COOKED
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.CARROT_COOKED"
msgid "I didn't bother seasoning it."
msgstr "Nem me dei ao trabalho de temperá-la."

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.CARROT_OVERSIZED
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.CARROT_OVERSIZED"
msgid "I wonder if eating all those carrots would improve my eyesight."
msgstr "Será que, se eu comer todas essas cenouras a minha visão melhora?"

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.CARROT_PLANTED
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.CARROT_PLANTED"
msgid "I can take it now or come back for it later."
msgstr "Posso pegá-la agora ou voltar mais tarde."

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.CARROT_SEEDS
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.CARROT_SEEDS"
msgid "Why waste time growing them when I can just eat them now?"
msgstr "Pra que perder tempo plantando estas sementes se posso comê-las agora?"

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.CARTOGRAPHYDESK.BURNING
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.CARTOGRAPHYDESK.BURNING"
msgid "That's not good."
msgstr "Isso não é bom."

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.CARTOGRAPHYDESK.BURNT
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.CARTOGRAPHYDESK.BURNT"
msgid "All that's left are the memories. And some soot."
msgstr "Só sobraram as memórias. E um pouco de fuligem."

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.CARTOGRAPHYDESK.GENERIC
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.CARTOGRAPHYDESK.GENERIC"
msgid "We'll be able to explore a lot faster if we map out where we've already been."
msgstr "Vamos conseguir explorar muito mais rápido se mapearmos os locais por onde já passamos."

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.CATCOON
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.CATCOON"
msgid "I don't have time to play with you."
msgstr "Não tenho tempo pra brincar com você."

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.CATCOONDEN.EMPTY
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.CATCOONDEN.EMPTY"
msgid "It's deserted."
msgstr "Está vazio."

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.CATCOONDEN.GENERIC
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.CATCOONDEN.GENERIC"
msgid "It looks like something's been living in there for a while."
msgstr "Parece que algo está vivendo aí dentro faz algum tempo."

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.CATCOONHAT
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.CATCOONHAT"
msgid "Their sacrifice will keep me warm and alive."
msgstr "O sacrifício deles me manterá quente e viva."

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.CATTOY_MOUSE
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.CATTOY_MOUSE"
msgid "What a clever little clockwork contraption!"
msgstr "Que bugiganga espertinha!"

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.CAVEIN_BOULDER.GENERIC
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.CAVEIN_BOULDER.GENERIC"
msgid "I bet I could lift it. It... might take a while though."
msgstr "Aposto que posso erguer essa pedra. Mas... talvez leve algum tempo."

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.CAVEIN_BOULDER.RAISED
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.CAVEIN_BOULDER.RAISED"
msgid "I can't quite reach it."
msgstr "Não consigo alcançar direito."

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.CAVE_BANANA
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.CAVE_BANANA"
msgid "I like a quick snack with no fuss."
msgstr "Gosto de um lanche rápido sem confusão."

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.CAVE_BANANA_BURNT
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.CAVE_BANANA_BURNT"
msgid "It's fine! Just scrape off the burnt edges!"
msgstr "Está ótima! É só raspar as bordas queimadas!"

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.CAVE_BANANA_COOKED
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.CAVE_BANANA_COOKED"
msgid "Why did I spend time cooking it?"
msgstr "Por que gastei tempo cozinhando-a?"

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.CAVE_BANANA_TREE
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.CAVE_BANANA_TREE"
msgid "You can barely call it a tree."
msgstr "Mal dá pra chamar isso de árvore."

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.CAVE_ENTRANCE
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.CAVE_ENTRANCE"
msgid "I never was good at leaving well enough alone."
msgstr "Eu nunca fui boa em deixar as coisas como estão."

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.CAVE_ENTRANCE_OPEN.FULL
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.CAVE_ENTRANCE_OPEN.FULL"
msgid "Finish up in there, I don't have all day to wait!"
msgstr "Termine logo aí dentro. Não posso esperar o dia todo!"

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.CAVE_ENTRANCE_OPEN.GENERIC
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.CAVE_ENTRANCE_OPEN.GENERIC"
msgid "Well, this isn't working."
msgstr "Bom, não está funcionando."

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.CAVE_ENTRANCE_OPEN.OPEN
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.CAVE_ENTRANCE_OPEN.OPEN"
msgid "Nothing ventured, nothing gained. Famous last words..."
msgstr "Quem não arrisca, não petisca. Famosas últimas palavras..."

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.CAVE_ENTRANCE_RUINS
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.CAVE_ENTRANCE_RUINS"
msgid "Someone probably plugged it for a reason. I wonder what it was?"
msgstr "Alguém deve tê-la fechado por um motivo. E qual seria ele?"

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.CAVE_EXIT.FULL
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.CAVE_EXIT.FULL"
msgid "Would someone please move? You're blocking the exit!"
msgstr "Alguém aí na frente pode se mexer? Você está bloqueando a saída!"

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.CAVE_EXIT.GENERIC
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.CAVE_EXIT.GENERIC"
msgid "Looks like I'm stuck down here for the time being."
msgstr "Parece que estou presa aqui embaixo por enquanto."

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.CAVE_EXIT.OPEN
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.CAVE_EXIT.OPEN"
msgid "That's enough of this place!"
msgstr "Já chega deste lugar!"

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.CAVE_FERN
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.CAVE_FERN"
msgid "How very interesting. Anyway..."
msgstr "Que interessante. Enfim..."

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.CAVE_FERN_WITHERED
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.CAVE_FERN_WITHERED"
msgid "Not interesting at all."
msgstr "Nada de interessante."

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.CAVE_VENT_MITE.DEAD
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.CAVE_VENT_MITE.DEAD"
msgid "That's the end of that."
msgstr "Foi o fim dele."

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.CAVE_VENT_MITE.GENERIC
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.CAVE_VENT_MITE.GENERIC"
msgid "I was hoping not to see or smell you again."
msgstr "Eu esperava não te ver ou te cheirar de novo."

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.CAVE_VENT_MITE.SLEEPING
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.CAVE_VENT_MITE.SLEEPING"
msgid "That's one way to pass the time."
msgstr "Esse é um jeito de passar o tempo."

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.CAVE_VENT_MITE.VENTING
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.CAVE_VENT_MITE.VENTING"
msgid "Disgusting."
msgstr "Nojento."

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.CAVE_VENT_ROCK.GAS
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.CAVE_VENT_ROCK.GAS"
msgid "Oh that dreadful, noxious odor."
msgstr "Ah, que odor horrível e nocivo."

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.CAVE_VENT_ROCK.GENERIC
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.CAVE_VENT_ROCK.GENERIC"
msgid "Let's go around those, shall we?"
msgstr "Vamos dar uma voltinha, sim?"

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.CAVE_VENT_ROCK.HOT
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.CAVE_VENT_ROCK.HOT"
msgid "I feel sluggish in this heat."
msgstr "Esse calor me dá uma bobeira."

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.CAVE_VENT_ROCK.MIASMA
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.CAVE_VENT_ROCK.MIASMA"
msgid "Oh botheration, I've no desire to wade through that vile substance."
msgstr "Ai, que amolação. Não tenho a menor vontade de me aprofundar nessa substância vil."

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.CEILING_ROPE
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.CEILING_ROPE"
msgid "Always prudent to have a way back."
msgstr "É sempre prudente ter um plano B."

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.CEVICHE
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.CEVICHE"
msgid "Oddly refreshing!"
msgstr "Estranhamente refrescante."

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.CHARCOAL
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.CHARCOAL"
msgid "It burned once and it can burn again."
msgstr "Já queimou uma vez e pode queimar de novo."

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.CHARLIERESIDUE
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.CHARLIERESIDUE"
msgid "only_used_by_winona"
msgstr "only_used_by_winona"

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.CHARLIEROSE
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.CHARLIEROSE"
msgid "only_used_by_winona"
msgstr "only_used_by_winona"

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.CHARLIE_HAND
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.CHARLIE_HAND"
msgid "Me? Help YOU?!"
msgstr "Eu? Ajudar VOCÊ?!"

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.CHARLIE_HECKLER
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.CHARLIE_HECKLER"
msgid "I don't remember asking for their opinion."
msgstr "Eu não lembro de ter pedido opiniões."

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.CHARLIE_LECTURN
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.CHARLIE_LECTURN"
msgid "My daily life is quite dramatic enough."
msgstr "Minha vida diária já é dramática o bastante."

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.CHARLIE_NPC
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.CHARLIE_NPC"
msgid "She looks happy... that doesn't bode well."
msgstr "Ela parece feliz... isso não parece bom."

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.CHARLIE_STAGE_POST
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.CHARLIE_STAGE_POST"
msgid "Honestly, who has time for these theatrics?"
msgstr "Honestamente, quem tem tempo para esse teatro?"

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.CHESSJUNK1
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.CHESSJUNK1"
msgid "I don't see much in the way of proper clockwork in there."
msgstr "Não vejo nada aí que pareça um mecanismo decente."

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.CHESSJUNK2
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.CHESSJUNK2"
msgid "I have a suspicion these were held together with more magic than craftsmanship."
msgstr "Suspeito que tenham sido montados com mais magia do que perícia técnica."

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.CHESSJUNK3
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.CHESSJUNK3"
msgid "Not so much as a pinion or pendulum in sight. Disgraceful!"
msgstr "Nem sequer uma engrenagem ou um pêndulo à vista. Que desgraça!"

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.CHESSPIECE_ANCHOR
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.CHESSPIECE_ANCHOR"
msgid "It's not going anywhere. I can look at it later."
msgstr "Não vai a lugar algum. Posso dar uma olhada nela mais tarde."

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.CHESSPIECE_ANTLION
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.CHESSPIECE_ANTLION"
msgid "Right. That time I was almost impaled by spikes."
msgstr "É verdade. Naquela vez, eu quase fui empalada por espetos."

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.CHESSPIECE_BEARGER
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.CHESSPIECE_BEARGER"
msgid "Not one of my fondest memories."
msgstr "Não é uma das minhas melhores lembranças."

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.CHESSPIECE_BEARGER_MUTATED
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.CHESSPIECE_BEARGER_MUTATED"
msgid "Oh, wonderful. It's even worse than I remembered."
msgstr "Ah, maravilhoso. É ainda pior do que me lembrava."

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.CHESSPIECE_BEEFALO
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.CHESSPIECE_BEEFALO"
msgid "A real one would be marginally more interesting to look at."
msgstr "Um bífalo de verdade seria ligeiramente mais interessante de observar."

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.CHESSPIECE_BEEQUEEN
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.CHESSPIECE_BEEQUEEN"
msgid "This will remind me not to go poking around beehives."
msgstr "Esta aqui vai me lembrar de não cutucar colmeias."

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.CHESSPIECE_BISHOP.GENERIC
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.CHESSPIECE_BISHOP.GENERIC"
msgid "I'm guessing there's a big chessboard somewhere nearby."
msgstr "Estou achando que tem um grande tabuleiro de xadrez em algum lugar por aqui."

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.CHESSPIECE_BISHOP.STRUGGLE
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.CHESSPIECE_BISHOP.STRUGGLE"
msgid "What's happening? It can't be!"
msgstr "O que está acontecendo? Não pode ser!"

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.CHESSPIECE_BUTTERFLY
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.CHESSPIECE_BUTTERFLY"
msgid "Its beauty is captured forever."
msgstr "Sua beleza foi capturada para sempre."

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.CHESSPIECE_CARRAT
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.CHESSPIECE_CARRAT"
msgid "I don't think this really warranted a statue."
msgstr "Não acho que merecia uma estátua."

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.CHESSPIECE_CATCOON
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.CHESSPIECE_CATCOON"
msgid "I guess I did have time to play with you after all."
msgstr "Acho que afinal eu tinha mesmo tempo para brincar com vocês."

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.CHESSPIECE_CLAYHOUND
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.CHESSPIECE_CLAYHOUND"
msgid "Well, it hasn't sprung to life yet. So far so good."
msgstr "Bom, ele ainda não ganhou vida. Até aqui, tudo bem."

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.CHESSPIECE_CLAYWARG
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.CHESSPIECE_CLAYWARG"
msgid "I hope this doesn't come back to bite me."
msgstr "Tomara que não volte pra me morder."

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.CHESSPIECE_CRABKING
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.CHESSPIECE_CRABKING"
msgid "Oh yes, I remember. I was nearly drowned."
msgstr "Ah, sim. Eu lembro. Quase me afoguei."

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.CHESSPIECE_DAYWALKER
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.CHESSPIECE_DAYWALKER"
msgid "Ah yes, how could I forget that time I was nearly smashed to bits?"
msgstr "Ah, sim, como poderia me esquecer da vez em que quase fui despedaçada?"

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.CHESSPIECE_DAYWALKER2
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.CHESSPIECE_DAYWALKER2"
msgid "A familiar face I couldn't forget soon enough."
msgstr "Um rosto conhecido que eu não conseguiria esquecer tão cedo."

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.CHESSPIECE_DEERCLOPS
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.CHESSPIECE_DEERCLOPS"
msgid "I'd be happy if I never have to see it again."
msgstr "Ficaria feliz se nunca mais o visse de novo."

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.CHESSPIECE_DEERCLOPS_MUTATED
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.CHESSPIECE_DEERCLOPS_MUTATED"
msgid "What an unpleasant subject for a statue."
msgstr "Que tema desagradável para uma estátua."

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.CHESSPIECE_DEPTHWORM
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.CHESSPIECE_DEPTHWORM"
msgid "And I just managed to forget you."
msgstr "E eu tinha acabado de me esquecer de você."

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.CHESSPIECE_DRAGONFLY
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.CHESSPIECE_DRAGONFLY"
msgid "A monument to a very trying day."
msgstr "Um monumento dedicado a um dia muito difícil."

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.CHESSPIECE_EYEOFTERROR
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.CHESSPIECE_EYEOFTERROR"
msgid "Certainly an eye to behold."
msgstr "Certamente, um olho a se contemplar."

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.CHESSPIECE_FORMAL
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.CHESSPIECE_FORMAL"
msgid "Looks like he lost his head too."
msgstr "Parece que ele também perdeu a cabeça."

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.CHESSPIECE_GUARDIANPHASE3
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.CHESSPIECE_GUARDIANPHASE3"
msgid "I hope I won't have to do that again."
msgstr "Tomara que eu nunca mais tenha que fazer isso."

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.CHESSPIECE_HORNUCOPIA
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.CHESSPIECE_HORNUCOPIA"
msgid "I feel like we're being mocked."
msgstr "Sinto como se estivessem nos ridicularizando."

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.CHESSPIECE_KITCOON
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.CHESSPIECE_KITCOON"
msgid "Oh, a precariously tall statue, what could go wrong?"
msgstr "Ah, uma estátua precariamente alta. O que poderia dar errado?"

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.CHESSPIECE_KLAUS
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.CHESSPIECE_KLAUS"
msgid "Why would I want to remember him?"
msgstr "Por que eu iria querer me lembrar dele?"

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.CHESSPIECE_KNIGHT.GENERIC
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.CHESSPIECE_KNIGHT.GENERIC"
msgid "It looks like an oversized chess piece."
msgstr "Parece uma peça de xadrez exageradamente grande."

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.CHESSPIECE_KNIGHT.STRUGGLE
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.CHESSPIECE_KNIGHT.STRUGGLE"
msgid "What's happening? It can't be!"
msgstr "O que está acontecendo? Não pode ser!"

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.CHESSPIECE_MALBATROSS
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.CHESSPIECE_MALBATROSS"
msgid "Why are there so many unpleasant statues?"
msgstr "Por que há tantas estátuas desagradáveis?"

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.CHESSPIECE_MANRABBIT
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.CHESSPIECE_MANRABBIT"
msgid "I suppose it wasn't the most unpleasant diversion."
msgstr "Acho que não foi uma distração das mais desagradáveis."

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.CHESSPIECE_MINOTAUR
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.CHESSPIECE_MINOTAUR"
msgid "This will help remind me not to venture too far in the caves..."
msgstr "Isso vai me lembrar de não ir muito longe ao explorar as cavernas..."

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.CHESSPIECE_MOON
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.CHESSPIECE_MOON"
msgid "Just look up if you want to see the moon. Actually, better not."
msgstr "Só olhe para cima se quiser ver a lua. Na verdade, é melhor não fazer isso."

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.CHESSPIECE_MOOSEGOOSE.1
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.CHESSPIECE_MOOSEGOOSE.1"
msgid "Oh good, a reminder of another unpleasant encounter."
msgstr "Que maravilha, uma lembrança de outro encontro detestável."

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.CHESSPIECE_MUSE
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.CHESSPIECE_MUSE"
msgid "She went and lost her head."
msgstr "Ela foi e perdeu a cabeça."

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.CHESSPIECE_PAWN
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.CHESSPIECE_PAWN"
msgid "Even a common pawn can become powerful if it's clever enough."
msgstr "Até um peão comum pode se tornar poderoso se for esperto o bastante."

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.CHESSPIECE_PIPE
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.CHESSPIECE_PIPE"
msgid "A still life. How riveting."
msgstr "Uma natureza morta. Que instigante."

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.CHESSPIECE_ROOK.GENERIC
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.CHESSPIECE_ROOK.GENERIC"
msgid "Who sculpted these?"
msgstr "Quem foi que esculpiu isto?"

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.CHESSPIECE_ROOK.STRUGGLE
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.CHESSPIECE_ROOK.STRUGGLE"
msgid "What's happening? It can't be!"
msgstr "O que está acontecendo? Não pode ser!"

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.CHESSPIECE_SHARKBOI
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.CHESSPIECE_SHARKBOI"
msgid "How could I forget this ruffian?"
msgstr "Como pude me esquecer desse rufião?"

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.CHESSPIECE_STALKER
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.CHESSPIECE_STALKER"
msgid "Still unsettling."
msgstr "Ainda assim é perturbador."

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.CHESSPIECE_TOADSTOOL
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.CHESSPIECE_TOADSTOOL"
msgid "Such fun memories of almost being killed by a giant toad."
msgstr "Lembranças muito divertidas de quando quase fui morta por um sapo gigante."

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.CHESSPIECE_TWINSOFTERROR
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.CHESSPIECE_TWINSOFTERROR"
msgid "I'd be quite happy to never lay eyes on them again."
msgstr "Eu ficaria muito feliz de nunca olhar para eles novamente."

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.CHESSPIECE_VAULT_PILLAR_GUARD
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.CHESSPIECE_VAULT_PILLAR_GUARD"
msgid "I'll not soon forget this brute."
msgstr "Não vou me esquecer desse brutamontes tão cedo."

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.CHESSPIECE_WAGBOSS_LUNAR
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.CHESSPIECE_WAGBOSS_LUNAR"
msgid "Can't we just leave this monstrosity in the past?"
msgstr "Não podemos deixar essa monstruosidade no passado?"

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.CHESSPIECE_WAGBOSS_ROBOT
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.CHESSPIECE_WAGBOSS_ROBOT"
msgid "Do we really need a reminder of this?"
msgstr "Precisamos mesmo de um lembrete disso?"

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.CHESSPIECE_WARG_MUTATED
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.CHESSPIECE_WARG_MUTATED"
msgid "That's one memory I'd be happy not to revisit."
msgstr "Essa é uma memória que eu prefiro não revisitar."

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.CHESSPIECE_WORMBOSS
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.CHESSPIECE_WORMBOSS"
msgid "Rather not relive this one."
msgstr "Prefiro não me recordar desse aí."

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.CHESSPIECE_YOTD
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.CHESSPIECE_YOTD"
msgid "Back where it all began... the boat race, anyway."
msgstr "De volta a todo o princípio... da corrida de barcos, enfim."

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.CHESSPIECE_YOTH
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.CHESSPIECE_YOTH"
msgid "I have mixed emotions about this one."
msgstr "Tenho sentimentos contraditórios em relação a isso."

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.CHESSPIECE_YOTS
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.CHESSPIECE_YOTS"
msgid "And I just managed to forget you."
msgstr "E eu tinha acabado de me esquecer de você."

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.CHESTER
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.CHESTER"
msgid "Yes, yes, you're very cute. Just be careful with my things please."
msgstr "Sim, sim, você é uma fofura. Só tome cuidado com as minhas coisas."

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.CHESTER_EYEBONE.GENERIC
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.CHESTER_EYEBONE.GENERIC"
msgid "Do you ever blink?"
msgstr "Você nunca pisca?"

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.CHESTER_EYEBONE.WAITING
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.CHESTER_EYEBONE.WAITING"
msgid "Did it fall asleep?"
msgstr "Ele adormeceu?"

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.CHESTUPGRADE_STACKSIZE
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.CHESTUPGRADE_STACKSIZE"
msgid "More space is always welcome, but more time would be preferred."
msgstr "Mais espaço é sempre bem-vindo, porém bom mesmo seria ter mais tempo."

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.CHEST_MIMIC_REVEALED
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.CHEST_MIMIC_REVEALED"
msgid "Totally not worth the peek!"
msgstr "Não valeu a espiada!"

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.CHUM
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.CHUM"
msgid "It's only fair to feed the fish before they feed me."
msgstr "É justo alimentar os peixes antes de eles me alimentarem."

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.CLAYHOUND.GENERIC
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.CLAYHOUND.GENERIC"
msgid "I really hoped it would be a bit more breakable!"
msgstr "Eu esperava que eles fossem um pouco mais frágeis!"

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.CLAYHOUND.STATUE
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.CLAYHOUND.STATUE"
msgid "Was that a temporal blip, or did that statue just move?"
msgstr "Foi um perturbação temporal, ou aquela estátua se mexeu?"

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.CLAYWARG.GENERIC
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.CLAYWARG.GENERIC"
msgid "Not a statue!!"
msgstr "Não é uma estátua!"

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.CLAYWARG.STATUE
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.CLAYWARG.STATUE"
msgid "Thankfully, it's just a statue."
msgstr "Ainda bem, é só uma estátua."

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.COLDFIRE.EMBERS
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.COLDFIRE.EMBERS"
msgid "I need to give it something to burn, quickly!"
msgstr "Preciso colocar algo pra queimar. E rápido!"

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.COLDFIRE.GENERIC
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.COLDFIRE.GENERIC"
msgid "It keeps the shadows at bay."
msgstr "Mantém a escuridão distante."

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.COLDFIRE.HIGH
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.COLDFIRE.HIGH"
msgid "Oh botheration, I got carried away with the kindling!"
msgstr "Ai, que amolação! Acabei me empolgando com o material inflamável!"

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.COLDFIRE.LOW
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.COLDFIRE.LOW"
msgid "It needs more to burn if I want it to last."
msgstr "Pra que o fogo dure, preciso pôr mais coisas pra queimar."

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.COLDFIRE.NORMAL
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.COLDFIRE.NORMAL"
msgid "That feels better."
msgstr "Assim está melhor."

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.COLDFIRE.OUT
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.COLDFIRE.OUT"
msgid "That was nice while it lasted."
msgstr "Foi bom enquanto durou."

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.COLDFIREPIT.EMBERS
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.COLDFIREPIT.EMBERS"
msgid "I need to give it something to burn, quickly!"
msgstr "Preciso colocar algo pra queimar. E rápido!"

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.COLDFIREPIT.GENERIC
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.COLDFIREPIT.GENERIC"
msgid "It keeps the shadows at bay."
msgstr "Mantém a escuridão distante."

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.COLDFIREPIT.HIGH
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.COLDFIREPIT.HIGH"
msgid "Oh botheration, I got carried away with the kindling!"
msgstr "Ai, que amolação! Acabei me empolgando com o material inflamável!"

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.COLDFIREPIT.LOW
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.COLDFIREPIT.LOW"
msgid "It needs more to burn if I want it to last."
msgstr "Pra que o fogo dure, preciso pôr mais coisas pra queimar."

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.COLDFIREPIT.NORMAL
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.COLDFIREPIT.NORMAL"
msgid "That feels better."
msgstr "Assim está melhor."

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.COLDFIREPIT.OUT
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.COLDFIREPIT.OUT"
msgid "I could get it going again in no time at all."
msgstr "Posso acendê-la de novo num piscar de olhos."

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.COLLAPSEDCHEST
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.COLLAPSEDCHEST"
msgid "It's a waste of time to repair if someone's just going to destroy it again."
msgstr "Não tem por que perder tempo consertando se alguém vai destruí-lo de novo."

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.COMPASS.E
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.COMPASS.E"
msgid "East. It's definitely East!"
msgstr "Leste. Sem dúvida, é leste!"

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.COMPASS.GENERIC
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.COMPASS.GENERIC"
msgid "If only it could tell me which way is past and which way is future."
msgstr "Se ao menos ela pudesse me dizer pra que lado fica o passado e pra que lado fica o futuro."

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.COMPASS.N
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.COMPASS.N"
msgid "North. That's \"up\" on the map, right?"
msgstr "Norte. Fica \"no alto\" do mapa, certo?"

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.COMPASS.NE
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.COMPASS.NE"
msgid "Northeast. I think."
msgstr "Nordeste. Eu acho."

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.COMPASS.NW
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.COMPASS.NW"
msgid "Northwest. Maybe?"
msgstr "Noroeste. Talvez?"

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.COMPASS.S
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.COMPASS.S"
msgid "South. That's \"down\" on the map, right?"
msgstr "Sul. Fica \"na parte de baixo\" do mapa, certo?"

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.COMPASS.SE
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.COMPASS.SE"
msgid "Southeast. Probably."
msgstr "Sudeste. Provavelmente."

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.COMPASS.SW
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.COMPASS.SW"
msgid "Southwest. Or not, who really knows?"
msgstr "Sudoeste. Ou não, quem é que sabe?"

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.COMPASS.W
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.COMPASS.W"
msgid "West. That'd be left, right?"
msgstr "Oeste. Fica pra esquerda, certo?"

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.COMPOST
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.COMPOST"
msgid "At least I won't have to touch it."
msgstr "Pelo menos não vou ter que tocar nele."

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.COMPOSTINGBIN.BALANCED
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.COMPOSTINGBIN.BALANCED"
msgid "Perfect! I hope I can remember how I did it..."
msgstr "Perfeito! Tomara que eu possa me lembrar de como fiz..."

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.COMPOSTINGBIN.BURNT
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.COMPOSTINGBIN.BURNT"
msgid "A fine mess this is..."
msgstr "Que bela confusão..."

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.COMPOSTINGBIN.DRY
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.COMPOSTINGBIN.DRY"
msgid "Oh. It's much dryer than I expected."
msgstr "Ah. Está muito mais seco do que eu esperava."

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.COMPOSTINGBIN.GENERIC
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.COMPOSTINGBIN.GENERIC"
msgid "Just how long is this going to take?"
msgstr "Quanto tempo isso vai levar?"

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.COMPOSTINGBIN.WET
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.COMPOSTINGBIN.WET"
msgid "Oh botheration, it's turned into a wet muck!"
msgstr "Ai, que amolação! Virou um lamaçal!"

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.COMPOSTWRAP
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.COMPOSTWRAP"
msgid "To each their own."
msgstr "Cada um na sua."

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.CONSTRUCTION_PLANS
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.CONSTRUCTION_PLANS"
msgid "What's a little more tampering going to hurt?"
msgstr "Que mal pode fazer um pouquinho mais de manipulação?"

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.COOKBOOK
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.COOKBOOK"
msgid "Cooking is so time consuming, look at all these ingredients and methods!"
msgstr "Cozinhar é tão demorado. Olhe só todos estes ingredientes e métodos."

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.COOKEDMANDRAKE
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.COOKEDMANDRAKE"
msgid "It was a matter of survival."
msgstr "Era questão de sobrevivência."

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.COOKEDMEAT
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.COOKEDMEAT"
msgid "Alright, I guess it was worth taking the time to cook it."
msgstr "Está bem, acho que valeu a pena dedicar um tempo para cozinhá-la."

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.COOKEDMONSTERMEAT
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.COOKEDMONSTERMEAT"
msgid "Somehow cooking it didn't make it much better."
msgstr "Não sei por quê, mas cozinhá-la não a deixou muito melhor."

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.COOKEDSMALLMEAT
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.COOKEDSMALLMEAT"
msgid "It's at least enough to hold me over for the time being."
msgstr "Pelo menos é suficiente pra me manter por enquanto."

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.COOKIECUTTER
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.COOKIECUTTER"
msgid "Oooh those things give me the shivers."
msgstr "Aaah, essas coisas me dão arrepios."

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.COOKIECUTTERHAT
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.COOKIECUTTERHAT"
msgid "If you step back a good ways and squint, it almost looks fashionable."
msgstr "Se você se afastar bastante e apertar os olhos, ele fica quase bonito."

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.COOKIECUTTERSHELL
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.COOKIECUTTERSHELL"
msgid "Mind the spines."
msgstr "Cuidado com os espinhos."

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.COOKINGRECIPECARD.GENERIC
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.COOKINGRECIPECARD.GENERIC"
msgid "Whatever was written here has been lost to time."
msgstr "Seja lá o que estava escrito aqui se perdeu no tempo."

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.COOKPOT.BURNT
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.COOKPOT.BURNT"
msgid "Well that's a setback."
msgstr "Bom, sofri um revés."

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.COOKPOT.COOKING_LONG
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.COOKPOT.COOKING_LONG"
msgid "This is why I hate cooking. Cooking takes forever!"
msgstr "É por isso que odeio cozinhar. É demorado demais!"

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.COOKPOT.COOKING_SHORT
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.COOKPOT.COOKING_SHORT"
msgid "It has to be almost done by now, right?"
msgstr "Já deve estar quase pronto, né?"

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.COOKPOT.DONE
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.COOKPOT.DONE"
msgid "At long last, food!"
msgstr "Até que enfim, comida!"

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.COOKPOT.EMPTY
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.COOKPOT.EMPTY"
msgid "I guess I'll just... find some seeds to eat or something."
msgstr "Acho que vou... encontrar umas sementes pra comer ou algo do tipo."

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.COOLANT
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.COOLANT"
msgid "I know that bubbling gunk has a use."
msgstr "Eu sei que essa gosma borbulhante tem utilidade."

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.COONTAIL
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.COONTAIL"
msgid "I did what I had to do."
msgstr "Eu fiz o que tinha que fazer."

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.CORN
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.CORN"
msgid "The nice thing about corn is you don't have to fuss with cooking it."
msgstr "O bom do milho que é a gente não precisa perder tempo cozinhando."

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.CORN_COOKED
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.CORN_COOKED"
msgid "It could really use some butter."
msgstr "Uma manteiga cairia muito bem."

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.CORN_OVERSIZED
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.CORN_OVERSIZED"
msgid "I never thought corn could be so colorful."
msgstr "Nunca pensei que milho pudesse ser tão colorido."

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.CORN_SEEDS
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.CORN_SEEDS"
msgid "Why waste time growing them when I can just eat them now?"
msgstr "Pra que perder tempo plantando estas sementes se posso comê-las agora?"

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.COSTUME_BLACKSMITH_BODY
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.COSTUME_BLACKSMITH_BODY"
msgid "It looks like it could belong to a blacksmith."
msgstr "Parece que poderia pertencer a uma ferreira."

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.COSTUME_DOLL_BODY
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.COSTUME_DOLL_BODY"
msgid "What's this? An oversized doll's dress?"
msgstr "O que é isso? Um vestido de boneca superdimensionado?"

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.COSTUME_FOOL_BODY
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.COSTUME_FOOL_BODY"
msgid "It looks like it could belong to a fool."
msgstr "Parece que poderia pertencer a um bobo da corte."

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.COSTUME_KING_BODY
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.COSTUME_KING_BODY"
msgid "It looks like it could belong to a King."
msgstr "Parece que poderia pertencer a um Rei."

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.COSTUME_MIRROR_BODY
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.COSTUME_MIRROR_BODY"
msgid "Something about that costume doesn't sit right with me."
msgstr "Tem algo nessa fantasia que não bate bem comigo."

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.COSTUME_PRINCESS_BODY
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.COSTUME_PRINCESS_BODY"
msgid "A rather fancy outfit for a horse."
msgstr "É um traje bastante chique pra uma égua."

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.COSTUME_QUEEN_BODY
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.COSTUME_QUEEN_BODY"
msgid "It looks like it could belong to a Queen."
msgstr "Parece que poderia pertencer a uma Rainha."

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.COSTUME_TREE_BODY
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.COSTUME_TREE_BODY"
msgid "It looks like a... tree costume?"
msgstr "Parece uma... fantasia de árvore?"

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.COTL_TABERNACLE_LEVEL1.GENERIC
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.COTL_TABERNACLE_LEVEL1.GENERIC"
msgid "That seems a bit out of place, doesn't it?"
msgstr "Parece um pouco fora de lugar, não é mesmo?"

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.COTL_TABERNACLE_LEVEL1.LIT
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.COTL_TABERNACLE_LEVEL1.LIT"
msgid "It does make a nice little fire, I suppose."
msgstr "Pode virar uma bela fogueirinha, eu acho."

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.COTL_TABERNACLE_LEVEL2.GENERIC
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.COTL_TABERNACLE_LEVEL2.GENERIC"
msgid "That seems a bit out of place, doesn't it?"
msgstr "Parece um pouco fora de lugar, não é mesmo?"

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.COTL_TABERNACLE_LEVEL2.LIT
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.COTL_TABERNACLE_LEVEL2.LIT"
msgid "It really is a lovely little statue."
msgstr "É mesmo uma estatueta adorável."

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.COTL_TABERNACLE_LEVEL3.GENERIC
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.COTL_TABERNACLE_LEVEL3.GENERIC"
msgid "That seems a bit out of place, doesn't it?"
msgstr "Parece um pouco fora de lugar, não é mesmo?"

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.COTL_TABERNACLE_LEVEL3.LIT
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.COTL_TABERNACLE_LEVEL3.LIT"
msgid "I suppose I can stay and watch it, just for a minute or two."
msgstr "Acho que posso ficar um pouco para admirá-lo, só por uns minutinhos."

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.COTL_TRINKET
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.COTL_TRINKET"
msgid "A little lost, are you?"
msgstr "Está meio perdido, não é?"

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.COZY_BUNNYMAN
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.COZY_BUNNYMAN"
msgid "Don't you have anything more important to do than lay about?"
msgstr "Você não tem nada de mais importante para fazer do que ficar jogado?"

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.CRABKING.GENERIC
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.CRABKING.GENERIC"
msgid "Ah! There you are, you old codger!"
msgstr "Ah! Aí está você, seu velho esquisitão!"

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.CRABKING.INERT
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.CRABKING.INERT"
msgid "Hmm, aren't there supposed to be gems on it? Or does that come later..."
msgstr "Hmm, não deveria ter pedras preciosas nele? Ou será que elas aparecem depois..."

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.CRABKING_CANNONTOWER
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.CRABKING_CANNONTOWER"
msgid "All this fuss!"
msgstr "Quanto estardalhaço!"

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.CRABKING_CLAW
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.CRABKING_CLAW"
msgid "You keep those big old snippers away from me!"
msgstr "Mantenha esses alicates enormes longe de mim."

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.CRABKING_ICEWALL
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.CRABKING_ICEWALL"
msgid "I won't let it slow me down."
msgstr "Não vou deixar que isso me atrase."

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.CRABKING_MOB
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.CRABKING_MOB"
msgid "Quit wasting my time, crab!"
msgstr "Pare de desperdiçar meu tempo, caranguejo!"

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.CRABKING_MOB_KNIGHT
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.CRABKING_MOB_KNIGHT"
msgid "Remember me?"
msgstr "Se lembra de mim?"

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.CRITTERLAB
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.CRITTERLAB"
msgid "Shadow creatures! No, wait a tick, it's something else..."
msgstr "Criaturas das sombras! Não, espere um pouco, é outra coisa..."

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.CRITTER_BULBIN
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.CRITTER_BULBIN"
msgid "Aren't you a little far from home?"
msgstr "Você não tá meio longe de casa?"

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.CRITTER_DRAGONLING
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.CRITTER_DRAGONLING"
msgid "I'm not really a pet person... but I'll make an exception for you."
msgstr "Não sou chegada em animais de estimação... mas vou abrir uma exceção pra você."

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.CRITTER_EETS
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.CRITTER_EETS"
msgid "This timeline is starting to get ridiculous."
msgstr "Essa linha do tempo tá começando a ficar ridícula."

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.CRITTER_EYEOFTERROR
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.CRITTER_EYEOFTERROR"
msgid "An all seeing eye will be quite a useful companion."
msgstr "Um olho que tudo vê seria um ótimo ajudante."

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.CRITTER_GLOMLING
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.CRITTER_GLOMLING"
msgid "Okay, okay. You're very cute."
msgstr "Ok, ok. Você é muito fofo."

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.CRITTER_KITTEN
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.CRITTER_KITTEN"
msgid "Curious little thing, aren't you?"
msgstr "Você é uma coisinha curiosa, né?"

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.CRITTER_LAMB
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.CRITTER_LAMB"
msgid "Ohhhh look at that wrinkly little face!"
msgstr "Ahhh, olha só pra essa carinha enrugada!"

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.CRITTER_LUNARMOTHLING
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.CRITTER_LUNARMOTHLING"
msgid "Time flies, and so do you!"
msgstr "O tempo voa, assim como você!"

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.CRITTER_PERDLING
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.CRITTER_PERDLING"
msgid "I'm teaching her to chirp the hour."
msgstr "Estou ensinando o Gluglu a piar a cada nova hora."

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.CRITTER_PUPPY
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.CRITTER_PUPPY"
msgid "I think he wants belly rubs."
msgstr "Acho que ele quer que eu esfregue sua barriga."

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.CROW.GENERIC
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.CROW.GENERIC"
msgid "As long as you don't come with any bad omens, we'll get along fine."
msgstr "Contanto que você não traga mau agouro, a gente vai se dar bem."

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.CROW.HELD
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.CROW.HELD"
msgid "Don't you dare peck at my pocket watches while you're in there!"
msgstr "Não se atreva a bicar meus relógios de bolso enquanto estiver aí dentro!"

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.CRUMBS
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.CRUMBS"
msgid "Poor thing, it's leading us right to its home."
msgstr "Coitado, está nos levando direto pra casa dele."

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.CURSED_MONKEY_TOKEN
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.CURSED_MONKEY_TOKEN"
msgid "That is one trinket I'd rather not have cluttering my pockets."
msgstr "Essa é uma bugiganga que eu prefiro não ter ocupando espaço no meu bolso."

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.CUTGRASS
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.CUTGRASS"
msgid "It's about as interesting as you'd imagine cut grass to be."
msgstr "É tão interessante quanto grama cortada possa parecer."

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.CUTLESS
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.CUTLESS"
msgid "I suppose getting hit with a block of wood will still hurt."
msgstr "Suponho que ser atingido por um bloco de madeira ainda dói."

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.CUTLICHEN
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.CUTLICHEN"
msgid "Its time is running out quickly."
msgstr "O tempo dele está se esgotando rápido."

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.CUTREEDS
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.CUTREEDS"
msgid "I'll put it in my pocket and use it for something later."
msgstr "Vou colocar no meu bolso pra usar mais tarde."

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.CUTSTONE
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.CUTSTONE"
msgid "Humans have been building with stone blocks for centuries."
msgstr "Os humanos usam blocos de pedra em construções há séculos."

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.DAYWALKER.GENERIC
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.DAYWALKER.GENERIC"
msgid "I knew I shouldn't have involved myself!"
msgstr "Eu sabia que não deveria ter me envolvido!"

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.DAYWALKER.IMPRISONED
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.DAYWALKER.IMPRISONED"
msgid "I shouldn't involve myself in these things."
msgstr "Eu não deveria me envolver nesse tipo de coisa."

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.DAYWALKER2.BURIED
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.DAYWALKER2.BURIED"
msgid "This is all too familiar."
msgstr "Tudo isso me parece muito familiar."

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.DAYWALKER2.GENERIC
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.DAYWALKER2.GENERIC"
msgid "Well this is new."
msgstr "Bem, isso é novo."

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.DAYWALKER2.HOSTILE
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.DAYWALKER2.HOSTILE"
msgid "I guess we don't learn from the past."
msgstr "Acho que não aprendemos com o passado."

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.DAYWALKER_PILLAR.EXPOSED
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.DAYWALKER_PILLAR.EXPOSED"
msgid "Oh botheration. I think I just remembered something..."
msgstr "Ai, que amolação. Acho que acabo de lembrar de algo..."

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.DAYWALKER_PILLAR.GENERIC
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.DAYWALKER_PILLAR.GENERIC"
msgid "They seem breakable... but I don't think that'd be wise."
msgstr "Parece quebrável... mas não sei se fazer isso seria sábio."

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.DEADLYFEAST
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.DEADLYFEAST"
msgid "A most potent dish."
msgstr "Um prato deveras potente."

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.DEAD_SEA_BONES
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.DEAD_SEA_BONES"
msgid "Not what I was hoping to see on my stroll down the beach."
msgstr "Não era o que eu esperava ver na minha caminhada até a praia."

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.DECIDUOUSTREE.BURNING
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.DECIDUOUSTREE.BURNING"
msgid "Maybe that was supposed to happen."
msgstr "Talvez isso tivesse que acontecer."

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.DECIDUOUSTREE.BURNT
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.DECIDUOUSTREE.BURNT"
msgid "Well, what's done is done. For now anyway."
msgstr "Bom, o que está feito, está feito. Por enquanto."

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.DECIDUOUSTREE.CHOPPED
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.DECIDUOUSTREE.CHOPPED"
msgid "Its time in this world was cut short."
msgstr "O tempo dele neste mundo foi... cortado."

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.DECIDUOUSTREE.GENERIC
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.DECIDUOUSTREE.GENERIC"
msgid "It's certainly a tree."
msgstr "É uma árvore, sem dúvida."

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.DECIDUOUSTREE.POISON
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.DECIDUOUSTREE.POISON"
msgid "Mind your own business, you pesky tree!"
msgstr "Cuide da sua vida, sua árvore irritante!"

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.DECK_OF_CARDS
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.DECK_OF_CARDS"
msgid "Certainly a way to kill time."
msgstr "Certamente é um jeito de matar tempo."

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.DECOR_CENTERPIECE
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.DECOR_CENTERPIECE"
msgid "I'm sure somebody likes it."
msgstr "Tenho certeza que alguém gosta disso."

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.DECOR_FLOWERVASE.EMPTY
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.DECOR_FLOWERVASE.EMPTY"
msgid "I thought I just replaced these. Or was that later?"
msgstr "Achei que tivesse acabado de substituí-las. Ou será que foi depois?"

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.DECOR_FLOWERVASE.FRESHLIGHT
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.DECOR_FLOWERVASE.FRESHLIGHT"
msgid "Good as new."
msgstr "Como novo."

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.DECOR_FLOWERVASE.GENERIC
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.DECOR_FLOWERVASE.GENERIC"
msgid "Beautiful."
msgstr "Bonito."

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.DECOR_FLOWERVASE.OLDLIGHT
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.DECOR_FLOWERVASE.OLDLIGHT"
msgid "I swear I just replaced this."
msgstr "Eu juro que acabei trocar."

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.DECOR_FLOWERVASE.WILTED
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.DECOR_FLOWERVASE.WILTED"
msgid "Fleeting."
msgstr "Efêmera."

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.DECOR_LAMP
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.DECOR_LAMP"
msgid "How fast does light travel in this place?"
msgstr "Qual é a velocidade da luz neste lugar?"

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.DECOR_PICTUREFRAME.GENERIC
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.DECOR_PICTUREFRAME.GENERIC"
msgid "Looks like it was done in no time at all."
msgstr "Parece que foi feita num piscar de olhos!"

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.DECOR_PICTUREFRAME.UNDRAWN
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.DECOR_PICTUREFRAME.UNDRAWN"
msgid "A blank canvas, containing infinite possibilities."
msgstr "Uma tela em branco, contendo infinitas possibilidades."

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.DECOR_PORTRAITFRAME
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.DECOR_PORTRAITFRAME"
msgid "A moment captured in time."
msgstr "Um instante capturado no tempo."

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.DEER.ANTLER
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.DEER.ANTLER"
msgid "Just keep your antler to yourself!"
msgstr "Mantenha sua galhada longe de mim!"

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.DEER.GENERIC
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.DEER.GENERIC"
msgid "It could use a haircut, though I'm not one to talk..."
msgstr "Um corte de cabelo lhe cairia bem, embora eu não seja ninguém pra falar..."

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.DEERCLOPS
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.DEERCLOPS"
msgid "Do we really have to do this again?"
msgstr "A gente precisa mesmo fazer isso de novo?"

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.DEERCLOPSCORPSE.BURNING
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.DEERCLOPSCORPSE.BURNING"
msgid "It doesn't hurt to take precautions."
msgstr "Não custa nada tomar precauções."

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.DEERCLOPSCORPSE.GENERIC
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.DEERCLOPSCORPSE.GENERIC"
msgid "And stay down!"
msgstr "E fique no chão!"

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.DEERCLOPSCORPSE.REVIVING
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.DEERCLOPSCORPSE.REVIVING"
msgid "Don't you dare!"
msgstr "Não se atreva!"

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.DEERCLOPSEYEBALL_SENTRYWARD.GENERIC
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.DEERCLOPSEYEBALL_SENTRYWARD.GENERIC"
msgid "Feels like we're back in the ice age."
msgstr "Parece que voltamos à era do gelo."

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.DEERCLOPSEYEBALL_SENTRYWARD.NOEYEBALL
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.DEERCLOPSEYEBALL_SENTRYWARD.NOEYEBALL"
msgid "The part that makes it work is missing. Typical."
msgstr "Está faltando a peça que o faz funcionar. Típico."

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.DEERCLOPSEYEBALL_SENTRYWARD_KIT
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.DEERCLOPSEYEBALL_SENTRYWARD_KIT"
msgid "I think I already built this later."
msgstr "Acho que já construí isto mais tarde."

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.DEERCLOPS_EYEBALL
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.DEERCLOPS_EYEBALL"
msgid "I'll bet that creature didn't foresee its day ending like this."
msgstr "Aposto que essa criatura não previa que seu dia acabaria assim."

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.DEER_ANTLER
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.DEER_ANTLER"
msgid "This looks like a key piece to a puzzle..."
msgstr "Parece uma peça importante de um quebra-cabeça..."

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.DEER_GEMMED
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.DEER_GEMMED"
msgid "It's being controlled by that beast!"
msgstr "Está sendo controlado pela fera!"

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.DEPLETED_GRASS.GENERIC
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.DEPLETED_GRASS.GENERIC"
msgid "It hasn't had enough time to grow back yet."
msgstr "Ainda não teve tempo suficiente de crescer de novo."

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.DESERTHAT
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.DESERTHAT"
msgid "It's no good against the sands of time, unfortunately."
msgstr "Não adianta em nada contra as areias do tempo, infelizmente."

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.DESICCANT
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.DESICCANT"
msgid "It should keep me from getting too waterlogged."
msgstr "Deve impedir que eu fique muito encharcada."

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.DESICCANTBOOSTED
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.DESICCANTBOOSTED"
msgid "I won't have to worry about getting soggy!"
msgstr "Não vou precisar me preocupar em ficar ensopada!"

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.DIRTPILE
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.DIRTPILE"
msgid "There's something just irresistibly suspicious about it..."
msgstr "Tem algo de irresistivelmente suspeito nela..."

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.DIVININGROD.COLD
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.DIVININGROD.COLD"
msgid "The signal is very faint."
msgstr "O sinal está bem fraco."

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.DIVININGROD.GENERIC
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.DIVININGROD.GENERIC"
msgid "It's some kind of homing device."
msgstr "É algum tipo de dispositivo de rastreamento."

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.DIVININGROD.HOT
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.DIVININGROD.HOT"
msgid "This thing's going crazy!"
msgstr "Isso está ficando fora de controle!"

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.DIVININGROD.WARM
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.DIVININGROD.WARM"
msgid "I'm headed in the right direction."
msgstr "Estou indo naquela direção."

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.DIVININGROD.WARMER
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.DIVININGROD.WARMER"
msgid "Must be getting pretty close."
msgstr "Devo estar me aproximando."

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.DIVININGRODBASE.GENERIC
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.DIVININGRODBASE.GENERIC"
msgid "I wonder what it does."
msgstr "O que será que faz?"

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.DIVININGRODBASE.READY
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.DIVININGRODBASE.READY"
msgid "It looks like it needs a large key."
msgstr "Parece que precisa de uma chave grande."

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.DIVININGRODBASE.UNLOCKED
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.DIVININGRODBASE.UNLOCKED"
msgid "Now the machine can work!"
msgstr "Agora a máquina pode funcionar!"

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.DIVININGRODSTART
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.DIVININGRODSTART"
msgid "That rod looks useful!"
msgstr "Essa vara parece útil!"

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.DOCK_KIT
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.DOCK_KIT"
msgid "Can't someone with more time on their hands set it up?"
msgstr "Não tem alguém com mais tempo pra montar isso?"

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.DOCK_WOODPOSTS_ITEM
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.DOCK_WOODPOSTS_ITEM"
msgid "Are you supposed to place the support posts before or after? Oh well."
msgstr "É pra pôr os pinos de suporte antes ou depois? Ah, tanto faz."

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.DOLL_BLUEPRINT
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.DOLL_BLUEPRINT"
msgid "I don't remember the dolls from my childhood being quite so big and hairy."
msgstr "Não me lembro de as bonecas da minha infância serem tão grandes e cabeludas."

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.DRAGONBOAT_KIT
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.DRAGONBOAT_KIT"
msgid "Time is wasting. We'd better get to it."
msgstr "O tempo está passando. Mãos à obra."

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.DRAGONBOAT_PACK
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.DRAGONBOAT_PACK"
msgid "An instant boat. You've got to admire the efficiency of it."
msgstr "Um barco instantâneo. A eficiência disso é admirável."

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.DRAGONBODYHAT
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.DRAGONBODYHAT"
msgid "I don't like the thought of being inside a dragon's stomach..."
msgstr "Não gosto da ideia de estar dentro do estômago de um dragão."

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.DRAGONCHILISALAD
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.DRAGONCHILISALAD"
msgid "Warly always finds such unique combinations."
msgstr "O Warly sempre encontra combinações extraordinárias."

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.DRAGONFLY
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.DRAGONFLY"
msgid "Ohhhh I was really hoping to avoid dodging fiery bug monsters today."
msgstr "Ahhhh, eu esperava mesmo não ter que me esquivar de monstros incendiários hoje."

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.DRAGONFLYCHEST.GENERIC
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.DRAGONFLYCHEST.GENERIC"
msgid "Now that I'm not worried about my things burning up, I can worry about everything else."
msgstr "Agora que não preciso mais me preocupar com as minhas coisas pegando fogo, posso me preocupar com o resto."

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.DRAGONFLYCHEST.UPGRADED_STACKSIZE
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.DRAGONFLYCHEST.UPGRADED_STACKSIZE"
msgid "Big enough to keep all my trinkets safely stashed away."
msgstr "Grande o bastante para guardar bem minhas bugigangas."

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.DRAGONFLYFURNACE.GENERIC
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.DRAGONFLYFURNACE.GENERIC"
msgid "Maybe I'll just take a moment to warm up these old bones of mine."
msgstr "Talvez eu pare um instante pra esquentar meus velhos ossos."

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.DRAGONFLYFURNACE.HAMMERED
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.DRAGONFLYFURNACE.HAMMERED"
msgid "If only I could go back in time and undo that decision. If only."
msgstr "Quem dera eu pudesse voltar no tempo pra reverter essa decisão. Quem dera."

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.DRAGONFLYFURNACE.HIGH
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.DRAGONFLYFURNACE.HIGH"
msgid "Maybe I'll just take a moment to warm up these old bones of mine."
msgstr "Talvez eu pare um instante pra esquentar meus velhos ossos."

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.DRAGONFLYFURNACE.NORMAL
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.DRAGONFLYFURNACE.NORMAL"
msgid "Maybe I'll just take a moment to warm up these old bones of mine."
msgstr "Talvez eu pare um instante pra esquentar meus velhos ossos."

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.DRAGONFRUIT
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.DRAGONFRUIT"
msgid "Not even close to the weirdest thing I've eaten around here."
msgstr "Não é nem de perto a coisa mais esquisita que já comi por aqui."

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.DRAGONFRUIT_COOKED
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.DRAGONFRUIT_COOKED"
msgid "I always forget it looks like that on the inside."
msgstr "Sempre me esqueço de que ela é assim por dentro."

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.DRAGONFRUIT_OVERSIZED
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.DRAGONFRUIT_OVERSIZED"
msgid "I'll admit, it's an impressive sight."
msgstr "Tenho que admitir, é uma visão impressionante."

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.DRAGONFRUIT_SEEDS
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.DRAGONFRUIT_SEEDS"
msgid "Why waste time growing them when I can just eat them now?"
msgstr "Pra que perder tempo plantando estas sementes se posso comê-las agora?"

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.DRAGONHEADHAT
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.DRAGONHEADHAT"
msgid "What's that old saying? Two heads are better than one?"
msgstr "Como era aquele ditado? Duas cabeças pensam melhor do que uma?"

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.DRAGONPIE
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.DRAGONPIE"
msgid "When in doubt, bake it into a pie."
msgstr "Em caso de dúvida, faça uma torta."

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.DRAGONTAILHAT
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.DRAGONTAILHAT"
msgid "Hmph, who wants to be last?"
msgstr "Hunf, quem quer ser o último?"

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.DRAGON_SCALES
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.DRAGON_SCALES"
msgid "Fireproof material has served me well in the past. And future, come to think of it."
msgstr "Os materiais à prova de fogo me foram úteis no passado. E pensando bem, no futuro também."

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.DREADSTONE
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.DREADSTONE"
msgid "As off-putting as it is, it could be useful."
msgstr "Por mais que seja desconcertante, pode ser útil."

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.DREADSTONEHAT
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.DREADSTONEHAT"
msgid "That stone turned out to be rather useful."
msgstr "Aquela pedra acabou sendo bem útil."

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.DREADSTONE_STACK
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.DREADSTONE_STACK"
msgid "It's coming from deep below the surface."
msgstr "Está vindo das profundezas da superfície."

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.DRIFTWOOD_LOG
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.DRIFTWOOD_LOG"
msgid "Who knows how long it's been floating out in the ocean?"
msgstr "Quem sabe quanto tempo faz que está flutuando no oceano?"

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.DRIFTWOOD_TREE.BURNING
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.DRIFTWOOD_TREE.BURNING"
msgid "That's an unfortunate turn of events."
msgstr "Que reviravolta infeliz."

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.DRIFTWOOD_TREE.BURNT
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.DRIFTWOOD_TREE.BURNT"
msgid "It won't do me much good now."
msgstr "Não vai me servir de muita coisa agora."

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.DRIFTWOOD_TREE.CHOPPED
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.DRIFTWOOD_TREE.CHOPPED"
msgid "I should check for roots while I'm here."
msgstr "É melhor eu procurar raízes enquanto estou aqui."

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.DRIFTWOOD_TREE.GENERIC
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.DRIFTWOOD_TREE.GENERIC"
msgid "That tree is long dead."
msgstr "Faz tempo que essa árvore morreu."

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.DRUMSTICK
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.DRUMSTICK"
msgid "I'm in a hurry, it's fine enough as it is."
msgstr "Estou com pressa. Pra mim, já está boa o suficiente."

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.DRUMSTICK_COOKED
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.DRUMSTICK_COOKED"
msgid "Why do I always forget how much better cooked meat tastes..."
msgstr "Por que sempre me esqueço de como a carne fica muito melhor assada..."

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.DUG_BANANABUSH
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.DUG_BANANABUSH"
msgid "They're much easier to pick this way."
msgstr "Elas ficam muito mais fáceis de colher assim."

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.DUG_BERRYBUSH
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.DUG_BERRYBUSH"
msgid "No time for picking, I'll just take it all with me!"
msgstr "Não tenho tempo pra ficar escolhendo, vou levar todas comigo!"

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.DUG_BERRYBUSH_JUICY
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.DUG_BERRYBUSH_JUICY"
msgid "It'll save me precious time if I bring this closer to camp."
msgstr "Vou poupar tempo se eu trouxer isto pra perto do acampamento."

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.DUG_GRASS
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.DUG_GRASS"
msgid "I can think of a better place for it."
msgstr "Sei de um lugar melhor pra ele."

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.DUG_MARSH_BUSH
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.DUG_MARSH_BUSH"
msgid "I can put it somewhere later. Or maybe even earlier."
msgstr "Posso botar isto em algum lugar mais tarde. Ou talvez até mais cedo."

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.DUG_MONKEYTAIL
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.DUG_MONKEYTAIL"
msgid "There had better not be any monkeys hiding in there."
msgstr "É melhor não ter nenhum macaco escondido aí."

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.DUG_SAPLING
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.DUG_SAPLING"
msgid "I can put it somewhere later. Or maybe even earlier."
msgstr "Posso botar isto em algum lugar mais tarde. Ou talvez até mais cedo."

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.DUG_TRAP_STARFISH
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.DUG_TRAP_STARFISH"
msgid "It's what it deserves."
msgstr "É o que ela merece."

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.DUMBBELL
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.DUMBBELL"
msgid "What a dreadfully repetitive way to spend one's time."
msgstr "Que maneira terrivelmente repetitiva de gastar tempo."

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.DUMBBELL_BLUEGEM
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.DUMBBELL_BLUEGEM"
msgid "Not the most conventional weapon, but to each their own."
msgstr "Não é a mais convencional das armas, mas cada um, cada um."

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.DUMBBELL_GEM
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.DUMBBELL_GEM"
msgid "What a dreadfully repetitive way to spend one's time."
msgstr "Que maneira terrivelmente repetitiva de gastar tempo."

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.DUMBBELL_GOLDEN
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.DUMBBELL_GOLDEN"
msgid "What a dreadfully repetitive way to spend one's time."
msgstr "Que maneira terrivelmente repetitiva de gastar tempo."

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.DUMBBELL_HEAT
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.DUMBBELL_HEAT"
msgid "Well, at least it's efficient."
msgstr "Bem, pelo menos é eficiente."

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.DUMBBELL_MARBLE
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.DUMBBELL_MARBLE"
msgid "What a dreadfully repetitive way to spend one's time."
msgstr "Que maneira terrivelmente repetitiva de gastar tempo."

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.DUMBBELL_REDGEM
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.DUMBBELL_REDGEM"
msgid "Not the most conventional weapon, but to each their own."
msgstr "Não é a mais convencional das armas, mas cada um, cada um."

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.DURIAN
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.DURIAN"
msgid "I could never forget a smell like that."
msgstr "Jamais me esqueceria de um cheiro assim."

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.DURIAN_COOKED
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.DURIAN_COOKED"
msgid "It tastes better than it smells, but that's not saying much."
msgstr "O gosto é melhor do que o cheiro, mas isso não quer dizer grande coisa."

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.DURIAN_OVERSIZED
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.DURIAN_OVERSIZED"
msgid "Out of all the things I planted, this is the one that decides to grow well."
msgstr "De todas as coisas que plantei, esta é a que decidiu se desenvolver bem."

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.DURIAN_SEEDS
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.DURIAN_SEEDS"
msgid "Why waste time growing them when I can just eat them now?"
msgstr "Pra que perder tempo plantando estas sementes se posso comê-las agora?"

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.DUSTMERINGUE
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.DUSTMERINGUE"
msgid "Alright, dust was a poor ingredient choice. This is why I don't cook!"
msgstr "Está bem, não devia ter usado poeira como ingrediente. É por isso que eu não cozinho!"

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.DUSTMOTH
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.DUSTMOTH"
msgid "I could have used one of you in my workshop back home."
msgstr "Eu podia ter usado uma de vocês na minha oficina."

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.DUSTMOTHDEN
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.DUSTMOTHDEN"
msgid "A cozy little dust bin."
msgstr "Um cestinho de lixo aconchegante."

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.EARMUFFSHAT
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.EARMUFFSHAT"
msgid "If the rest of me freezes, at least my ears will be cozy."
msgstr "Se o resto do meu corpo congelar, pelo menos minhas orelhas ficarão quentinhas."

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.EEL
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.EEL"
msgid "I think I just saw it wriggle..."
msgstr "Acho que acabei de vê-la se mexendo..."

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.EEL_COOKED
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.EEL_COOKED"
msgid "Oh good. My favorite."
msgstr "Fantástico. Meu favorito."

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.EGGPLANT
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.EGGPLANT"
msgid "It kind of looks like a giant jellybean if you squint."
msgstr "Meio que parece uma jujuba gigante se você apertar os olhos."

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.EGGPLANT_COOKED
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.EGGPLANT_COOKED"
msgid "Well, the illusion is ruined."
msgstr "Bom, a ilusão foi destruída."

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.EGGPLANT_OVERSIZED
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.EGGPLANT_OVERSIZED"
msgid "I'll be eating eggplant leftovers for weeks."
msgstr "Vou comer sobras de berinjela durante semanas."

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.EGGPLANT_SEEDS
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.EGGPLANT_SEEDS"
msgid "Why waste time growing them when I can just eat them now?"
msgstr "Pra que perder tempo plantando estas sementes se posso comê-las agora?"

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.ELIXIR_CONTAINER
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.ELIXIR_CONTAINER"
msgid "Pretty, practical."
msgstr "Bonita e prática."

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.EMBERLIGHT
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.EMBERLIGHT"
msgid "Saves me the trouble of finding firewood."
msgstr "Me salva o esforço de encontrar lenha."

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.ENDTABLE.BURNT
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.ENDTABLE.BURNT"
msgid "That could have gone better."
msgstr "Poderia ter sido melhor."

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.ENDTABLE.EMPTY
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.ENDTABLE.EMPTY"
msgid "Someone forgot to put flowers in the vase. Maybe it was me..."
msgstr "Alguém se esqueceu de pôr flores na mesa. Talvez tenha sido eu..."

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.ENDTABLE.FRESHLIGHT
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.ENDTABLE.FRESHLIGHT"
msgid "As good as new."
msgstr "Como nova."

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.ENDTABLE.GENERIC
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.ENDTABLE.GENERIC"
msgid "I make it a rule not to trust fancy tables I find in the wilderness."
msgstr "Tenho como regra não confiar em mesas chiques que encontro na natureza."

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.ENDTABLE.OLDLIGHT
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.ENDTABLE.OLDLIGHT"
msgid "Oh no, did I forget to replace the bulb again?"
msgstr "Ah, não! Me esqueci de trocar o bulbo de novo?"

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.ENDTABLE.WILTED
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.ENDTABLE.WILTED"
msgid "Its age is starting to show."
msgstr "Ela está começando a aparentar a idade."

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.EVERGREEN.BURNING
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.EVERGREEN.BURNING"
msgid "Maybe that was supposed to happen."
msgstr "Talvez isso tivesse que acontecer."

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.EVERGREEN.BURNT
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.EVERGREEN.BURNT"
msgid "Well, what's done is done. For now anyway."
msgstr "Bom, o que está feito, está feito. Por enquanto."

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.EVERGREEN.CHOPPED
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.EVERGREEN.CHOPPED"
msgid "Its time in this world was cut short."
msgstr "O tempo dele neste mundo foi... cortado."

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.EVERGREEN.GENERIC
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.EVERGREEN.GENERIC"
msgid "Just another tree."
msgstr "Só mais uma árvore."

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.EVERGREEN_SPARSE.BURNING
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.EVERGREEN_SPARSE.BURNING"
msgid "Maybe that was supposed to happen."
msgstr "Talvez isso tivesse que acontecer."

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.EVERGREEN_SPARSE.BURNT
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.EVERGREEN_SPARSE.BURNT"
msgid "Well, what's done is done. For now anyway."
msgstr "Bom, o que está feito, está feito. Por enquanto."

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.EVERGREEN_SPARSE.CHOPPED
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.EVERGREEN_SPARSE.CHOPPED"
msgid "Its time in this world was cut short."
msgstr "O tempo dele neste mundo foi... cortado."

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.EVERGREEN_SPARSE.GENERIC
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.EVERGREEN_SPARSE.GENERIC"
msgid "It looks sickly."
msgstr "Parece doente."

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.EYEBRELLAHAT
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.EYEBRELLAHAT"
msgid "I don't like having eyes on me..."
msgstr "Detesto que fiquem de olho em mim..."

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.EYEMASKHAT
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.EYEMASKHAT"
msgid "How bizarre... I simply must try it on!"
msgstr "Que bizarro... Eu preciso experimentar!"

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.EYEOFTERROR
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.EYEOFTERROR"
msgid "I don't think that's supposed to be here..."
msgstr "Não acho que isso deveria estar aqui..."

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.EYEOFTERROR_MINI
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.EYEOFTERROR_MINI"
msgid "My eyes aren't the best, but I'm not looking for replacements anytime soon!"
msgstr "Meus olhos não estão tão bons mais, mas não vou procurar por peças de reposição tão cedo!"

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.EYEOFTERROR_MINI_GROUNDED
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.EYEOFTERROR_MINI_GROUNDED"
msgid "It's trying to hatch! I should keep my eye on it."
msgstr "Está tentando nascer! É melhor eu ficar de olho nele."

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.EYEPLANT
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.EYEPLANT"
msgid "Oh stop staring! Mind your own business!"
msgstr "Ah, para de me encarar! Vai cuidar da sua vida!"

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.EYETURRET
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.EYETURRET"
msgid "Ooooh, I LIKE this thing!"
msgstr "Aaaah, GOSTEI dessa coisa!"

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.EYETURRET_ITEM
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.EYETURRET_ITEM"
msgid "Where to put it, where to put it..."
msgstr "Onde vou pôr isto, onde vou pôr isto..."

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.FARMPLOT.BURNT
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.FARMPLOT.BURNT"
msgid "All that time, wasted!"
msgstr "Que desperdício de tempo!"

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.FARMPLOT.GENERIC
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.FARMPLOT.GENERIC"
msgid "Gardening is so time consuming."
msgstr "Jardinagem ocupa muito tempo."

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.FARMPLOT.GROWING
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.FARMPLOT.GROWING"
msgid "Why can't you just grow faster?"
msgstr "Por que você não cresce mais rápido?"

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.FARMPLOT.NEEDSFERTILIZER
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.FARMPLOT.NEEDSFERTILIZER"
msgid "A bit of fertilizer should speed things up."
msgstr "Um pouco de fertilizante deve acelerar as coisas."

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.FARM_HOE
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.FARM_HOE"
msgid "Tilling is so tedious."
msgstr "Arar a terra é muito chato."

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.FARM_PLANT.BURNING
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.FARM_PLANT.BURNING"
msgid "All that time and energy... wasted..."
msgstr "Tanto tempo e energia... jogados fora..."

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.FARM_PLANT.FULL
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.FARM_PLANT.FULL"
msgid "Finally!!"
msgstr "Finalmente!"

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.FARM_PLANT.FULL_OVERSIZED
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.FARM_PLANT.FULL_OVERSIZED"
msgid "I guess patience does pay off sometimes."
msgstr "Acho que às vezes compensa ter paciência."

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.FARM_PLANT.FULL_WEED
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.FARM_PLANT.FULL_WEED"
msgid "Wait a tick, I don't think I meant to plant that!"
msgstr "Espere um pouco, acho que eu não pretendia plantar isso!"

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.FARM_PLANT.GENERIC
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.FARM_PLANT.GENERIC"
msgid "A plant."
msgstr "Uma planta."

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.FARM_PLANT.GROWING
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.FARM_PLANT.GROWING"
msgid "Please hurry up!"
msgstr "Depressa, por favor!"

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.FARM_PLANT.ROTTEN
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.FARM_PLANT.ROTTEN"
msgid "Ack! I misjudged its position on the timeline!"
msgstr "Ugh! Calculei mal sua posição na linha do tempo!"

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.FARM_PLANT.ROTTEN_OVERSIZED
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.FARM_PLANT.ROTTEN_OVERSIZED"
msgid "Botheration! Time has gotten its claws into it!"
msgstr "Que amolação! O tempo cravou as garras nesta planta!"

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.FARM_PLANT.SEED
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.FARM_PLANT.SEED"
msgid "I hope it grows quickly."
msgstr "Tomara que cresça rápido."

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.FARM_PLOW
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.FARM_PLOW"
msgid "It's so much faster than digging everything up by hand!"
msgstr "É muito mais rápido do que cavar tudo com as mãos!"

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.FARM_PLOW_ITEM
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.FARM_PLOW_ITEM"
msgid "Might as well get this started."
msgstr "É melhor eu começar já."

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.FARM_SOIL_DEBRIS
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.FARM_SOIL_DEBRIS"
msgid "Didn't I pluck that out already?"
msgstr "Eu já não arranquei isso?"

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.FEATHERFAN
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.FEATHERFAN"
msgid "I've never seen a feather so big! Or have I..."
msgstr "Nunca tinha visto uma pena tão grande! Ou será que já vi..."

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.FEATHERHAT
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.FEATHERHAT"
msgid "Oooh, how eclectic!"
msgstr "Aaah, que eclético!"

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.FEATHERPENCIL
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.FEATHERPENCIL"
msgid "Good for jotting down notes in a hurry."
msgstr "Ótimo pra fazer anotações rápidas."

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.FEATHER_CANARY
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.FEATHER_CANARY"
msgid "A yellow feather."
msgstr "Uma pena amarela."

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.FEATHER_CROW
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.FEATHER_CROW"
msgid "A black feather."
msgstr "Uma pena preta."

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.FEATHER_ROBIN
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.FEATHER_ROBIN"
msgid "A red feather."
msgstr "Uma pena vermelha."

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.FEATHER_ROBIN_WINTER
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.FEATHER_ROBIN_WINTER"
msgid "A white-ish feather."
msgstr "Uma pena esbranquiçada."

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.FEM_PUPPET
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.FEM_PUPPET"
msgid "She's trapped!"
msgstr "Ela está presa!"

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.FENCE
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.FENCE"
msgid "An incredibly ordinary wooden fence."
msgstr "Uma cerca de madeira incrivelmente comum."

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.FENCE_ELECTRIC.GENERIC
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.FENCE_ELECTRIC.GENERIC"
msgid "Did I forget to connect this one?"
msgstr "Eu me esqueci de conectar isso?"

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.FENCE_ELECTRIC.LINKED
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.FENCE_ELECTRIC.LINKED"
msgid "Delivers an unforgettable shock."
msgstr "Dá um choque inesquecível."

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.FENCE_ELECTRIC_ITEM
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.FENCE_ELECTRIC_ITEM"
msgid "Must remember to plant this."
msgstr "Preciso me lembrar de plantar isso."

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.FENCE_GATE
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.FENCE_GATE"
msgid "An incredibly ordinary wooden gate."
msgstr "Um portão de madeira incrivelmente comum."

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.FENCE_GATE_ITEM
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.FENCE_GATE_ITEM"
msgid "If I don't build it now I'll just have to do it later."
msgstr "Se eu não construir agora, vou ter que construir mais tarde."

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.FENCE_ITEM
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.FENCE_ITEM"
msgid "Didn't I build that already?"
msgstr "Eu já não construí isso?"

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.FENCE_JUNK
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.FENCE_JUNK"
msgid "As long as it keeps things out, I don't care how it looks."
msgstr "Contanto que me isole das coisas de fora, a aparência não interessa."

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.FENCE_ROTATOR
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.FENCE_ROTATOR"
msgid "I appreciate specialized tools. Especially when I can still hit things with them."
msgstr "Eu aprecio ferramentas especializadas. Especialmente quando eu ainda consigo bater em coisas com elas."

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.FERTILIZER
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.FERTILIZER"
msgid "Manure, conveniently stored in a bucket."
msgstr "Estrume, convenientemente guardado num balde."

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.FESTIVEFISH
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.FESTIVEFISH"
msgid "I didn't think nutmeg and cinnamon would go so well with fish!"
msgstr "Não acho que noz moscada e canela combinem com peixe!"

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.FESTIVE_BLUEPRINT
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.FESTIVE_BLUEPRINT"
msgid "This outfit's louder than a chiming grandfather clock."
msgstr "Este traje é mais chamativo que um velho relógio de pêndulo."

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.FIG
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.FIG"
msgid "A plump, sweet fig."
msgstr "Um figo doce e polpudo."

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.FIGATONI
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.FIGATONI"
msgid "Who knew pasta could be sweet?"
msgstr "Macarrão doce? Quem poderia imaginar?"

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.FIGKABAB
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.FIGKABAB"
msgid "No plates, no cutlery, no fuss!"
msgstr "Sem pratos, sem talheres, sem complicações!"

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.FIG_COOKED
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.FIG_COOKED"
msgid "I'll admit, cooking it did help bring the sweetness out."
msgstr "Tenho que admitir, cozinhá-lo ajudou a trazer a doçura à tona."

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.FIREBALLSTAFF
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.FIREBALLSTAFF"
msgid "It calls a meteor from above."
msgstr "Chama um meteoro dos céus."

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.FIRECRACKERS
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.FIRECRACKERS"
msgid "Just in case things around here weren't already exciting enough."
msgstr "Como se as coisas por aqui já não fossem emocionantes o suficiente."

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.FIREFLIES.GENERIC
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.FIREFLIES.GENERIC"
msgid "I'll take some light wherever I can get it."
msgstr "Pego qualquer fonte de luz sempre que posso."

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.FIREFLIES.HELD
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.FIREFLIES.HELD"
msgid "It never hurts to carry a little emergency light."
msgstr "Luzes de emergência nunca são demais."

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.FIREHOUND
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.FIREHOUND"
msgid "I won't meet a fiery end from the likes of you!"
msgstr "Não vou deixar que vocês me levem a um fim ardente!"

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.FIRENETTLES
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.FIRENETTLES"
msgid "I have a feeling I shouldn't touch that."
msgstr "Tenho a impressão de que não devo tocar nisso."

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.FIRENETTLES_DRIED
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.FIRENETTLES_DRIED"
msgid "Smells lovely."
msgstr "Um aroma encantador."

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.FIREPEN
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.FIREPEN"
msgid "She should really warn people about borrowing her pens."
msgstr "Ela deveria avisar as pessoas pra não pegarem a caneta dela emprestada."

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.FIREPIT.EMBERS
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.FIREPIT.EMBERS"
msgid "I need to give it something to burn, quickly!"
msgstr "Preciso colocar algo pra queimar. E rápido!"

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.FIREPIT.GENERIC
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.FIREPIT.GENERIC"
msgid "It keeps the shadows at bay."
msgstr "Mantém a escuridão distante."

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.FIREPIT.HIGH
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.FIREPIT.HIGH"
msgid "Oh botheration, I got carried away with the kindling!"
msgstr "Ai, que amolação! Acabei me empolgando com o material inflamável!"

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.FIREPIT.LOW
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.FIREPIT.LOW"
msgid "It needs more to burn if I want it to last."
msgstr "Pra que o fogo dure, preciso pôr mais coisas pra queimar."

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.FIREPIT.NORMAL
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.FIREPIT.NORMAL"
msgid "That feels better."
msgstr "Assim está melhor."

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.FIREPIT.OUT
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.FIREPIT.OUT"
msgid "I could get it going again in no time at all."
msgstr "Posso acendê-la de novo num piscar de olhos."

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.FIRESTAFF
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.FIRESTAFF"
msgid "Better be careful with that, we don't want a repeat of last time."
msgstr "Melhor tomar cuidado com isso, não queremos repetir a última vez."

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.FIRESUPPRESSOR.LOWFUEL
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.FIRESUPPRESSOR.LOWFUEL"
msgid "It's starting to wind down."
msgstr "Está começando a apagar."

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.FIRESUPPRESSOR.OFF
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.FIRESUPPRESSOR.OFF"
msgid "Ready to fling at a moment's notice."
msgstr "Pronto pra funcionar assim que eu precisar."

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.FIRESUPPRESSOR.ON
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.FIRESUPPRESSOR.ON"
msgid "It's a good thing we prepared for just such an eventuality."
msgstr "Que bom que estamos preparados pra esse tipo de eventualidade."

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.FISH
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.FISH"
msgid "That's a fish alright."
msgstr "É um peixe, sim."

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.FISHINGNET
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.FISHINGNET"
msgid "Nothing but net."
msgstr "Nada além de rede."

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.FISHINGROD
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.FISHINGROD"
msgid "I don't know if I'm patient enough to be a fisherwoman..."
msgstr "Não sei se tenho paciência suficiente pra ser pescadora..."

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.FISHMEAT
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.FISHMEAT"
msgid "Once a fish, now food."
msgstr "Já foi peixe, agora é comida."

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.FISHMEAT_COOKED
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.FISHMEAT_COOKED"
msgid "It's been thoroughly cooked."
msgstr "Está completamente cozido."

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.FISHMEAT_DRIED
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.FISHMEAT_DRIED"
msgid "A dry, tough piece of fish meat."
msgstr "Um pedaço seco e duro de carne de peixe."

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.FISHMEAT_SMALL
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.FISHMEAT_SMALL"
msgid "Not much more than a quick fishy snack."
msgstr "Não é muito mais do que um lanchinho de peixe."

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.FISHMEAT_SMALL_COOKED
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.FISHMEAT_SMALL_COOKED"
msgid "I don't know why I took the time to cook something so small."
msgstr "Não sei por que gastei tempo cozinhando algo tão pequeno."

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.FISHMEAT_SMALL_DRIED
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.FISHMEAT_SMALL_DRIED"
msgid "A dry, tough piece of fish meat."
msgstr "Um pedaço seco e duro de carne de peixe."

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.FISHSTICKS
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.FISHSTICKS"
msgid "If only I had something to dip them in."
msgstr "Quem dera eu tivesse um molhinho pra mergulhá-los."

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.FISHTACOS
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.FISHTACOS"
msgid "I'll get a taco to go!"
msgstr "Vou pegar um taco pra viagem!"

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.FISH_BOX
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.FISH_BOX"
msgid "I suppose the best way to keep fish fresh is to keep them alive."
msgstr "Acho que a melhor maneira de manter os peixes frescos é mantê-los vivos."

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.FISH_COOKED
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.FISH_COOKED"
msgid "If only I had a bit of vinegar to go with it."
msgstr "Quem me dera ter um pouco de vinagre pra passar nele."

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.FLINT
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.FLINT"
msgid "Aha, I've found some flint!"
msgstr "Ah-rá, encontrei pederneira!"

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.FLOATINGLANTERN.DEFLATED
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.FLOATINGLANTERN.DEFLATED"
msgid "It's time ran out."
msgstr "O tempo dele se esgotou."

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.FLOATINGLANTERN.GENERIC
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.FLOATINGLANTERN.GENERIC"
msgid "There's something calming about it."
msgstr "Há algo de tranquilizante nele."

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.FLOATINGLANTERN.HELD
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.FLOATINGLANTERN.HELD"
msgid "I should use it at nightfall."
msgstr "É melhor usar ele ao anoitecer."

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.FLOTATIONCUSHION
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.FLOTATIONCUSHION"
msgid "How convenient!"
msgstr "Que conveniente!"

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.FLOWER.GENERIC
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.FLOWER.GENERIC"
msgid "I have far more pressing things to do than pick flowers."
msgstr "Tenho coisas bem mais urgentes pra fazer do que colher flores."

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.FLOWER.ROSE
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.FLOWER.ROSE"
msgid "I don't have time to stop and smell the roses."
msgstr "Não tenho tempo pra parar, a vida não é um mar de rosas."

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.FLOWERHAT
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.FLOWERHAT"
msgid "Oooh, how whimsical!"
msgstr "Aaah, que exótica!"

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.FLOWERSALAD
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.FLOWERSALAD"
msgid "What a lovely bowl of yard clippings."
msgstr "Que linda tigela de flores do jardim."

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.FLOWER_CAVE
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.FLOWER_CAVE"
msgid "I don't have time to stop and smell the flowers."
msgstr "Não tenho tempo pra parar, nem tudo na vida são flores."

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.FLOWER_CAVE_WITHERED
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.FLOWER_CAVE_WITHERED"
msgid "This flower's time is running out."
msgstr "O tempo desta flor está se esgotando."

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.FLOWER_EVIL
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.FLOWER_EVIL"
msgid "I don't have time to stop and smell the-- hold on, what's wrong with that one?"
msgstr "Não tenho tempo pra parar, nem tudo... espera, o que tem de errado com aquela ali?"

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.FLOWER_WITHERED
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.FLOWER_WITHERED"
msgid "Time has claimed it."
msgstr "O tempo a levou embora."

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.FOLIAGE
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.FOLIAGE"
msgid "Am I going to stop and examine every bit of greenery I find?"
msgstr "Será que vou parar pra examinar cada folhagem que eu encontrar?"

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.FOLIAGE_DRIED
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.FOLIAGE_DRIED"
msgid "Smells lovely."
msgstr "Um aroma encantador."

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.FOOTBALLHAT
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.FOOTBALLHAT"
msgid "I don't want my brain scrambled, I'm forgetful enough as it is."
msgstr "Não quero machucar meu cérebro. Eu já sou bem esquecida das coisas."

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.FORGETMELOTS
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.FORGETMELOTS"
msgid "Have I seen those before?"
msgstr "Eu já vi isso antes?"

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.FORGETMELOTS_DRIED
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.FORGETMELOTS_DRIED"
msgid "Smells lovely."
msgstr "Um aroma encantador."

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.FORMAL_BLUEPRINT
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.FORMAL_BLUEPRINT"
msgid "My beefalo will look like the perfect gentleman."
msgstr "Meu bífalo vai ficar com a aparência de um perfeito cavalheiro."

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.FOSSIL_PIECE
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.FOSSIL_PIECE"
msgid "These bones are too old for my magic to work. However..."
msgstr "Estes ossos são velhos demais pra minha magia funcionar. Contudo..."

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.FOSSIL_STALKER.COMPLETE
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.FOSSIL_STALKER.COMPLETE"
msgid "I did it! Why did I do that again?"
msgstr "Consegui! Aliás, por que foi que eu fiz isso?"

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.FOSSIL_STALKER.FUNNY
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.FOSSIL_STALKER.FUNNY"
msgid "Oh botheration, that doesn't look right at all."
msgstr "Ai, que amolação! Isso não parece nem um pouco certo."

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.FOSSIL_STALKER.GENERIC
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.FOSSIL_STALKER.GENERIC"
msgid "It's missing something."
msgstr "Está faltando alguma coisa."

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.FRESHFRUITCREPES
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.FRESHFRUITCREPES"
msgid "Kids these days, with their fancy syrup-less pancakes..."
msgstr "A juventude de hoje em dia, com suas panquecas chiques e sem xarope..."

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.FRIENDLYFRUITFLY
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.FRIENDLYFRUITFLY"
msgid "Thank goodness, I don't have to entertain the garden anymore."
msgstr "Ainda bem, eu não preciso mais cuidar do jardim."

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.FROG.DEAD
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.FROG.DEAD"
msgid "He's leapt his last."
msgstr "Ele deu o último salto."

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.FROG.GENERIC
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.FROG.GENERIC"
msgid "Don't even try it frogs, I'm one step ahead of you."
msgstr "Nem tentem, sapos. Estou um passo à frente de vocês."

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.FROG.SLEEPING
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.FROG.SLEEPING"
msgid "Look at him sleeping away."
msgstr "Olhe só pra ele, está dormindo."

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.FROGFISHBOWL
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.FROGFISHBOWL"
msgid "It tastes better than it looks."
msgstr "O gosto é melhor do que a aparência."

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.FROGGLEBUNWICH
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.FROGGLEBUNWICH"
msgid "I've been told it's a local delicacy."
msgstr "Me disseram que é uma iguaria local."

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.FROGLEGS
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.FROGLEGS"
msgid "The frog isn't kicking anymore."
msgstr "O sapo não vai chutar mais."

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.FROGLEGS_COOKED
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.FROGLEGS_COOKED"
msgid "At least they stopped twitching."
msgstr "Pelo menos pararam de se contorcer."

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.FROGNEWTON
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.FROGNEWTON"
msgid "It's very flavorful."
msgstr "É muito saboroso."

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.FROZENBANANADAIQUIRI
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.FROZENBANANADAIQUIRI"
msgid "I'll be done with it in no time."
msgstr "Vou acabar com isso num piscar de olhos."

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.FRUITDRAGON.GENERIC
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.FRUITDRAGON.GENERIC"
msgid "What a funny little creature."
msgstr "Que criaturinha divertida."

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.FRUITDRAGON.RIPE
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.FRUITDRAGON.RIPE"
msgid "It's a shame they're so delicious."
msgstr "É uma pena elas serem tão deliciosas."

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.FRUITDRAGON.SLEEPING
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.FRUITDRAGON.SLEEPING"
msgid "I guess it doesn't have anything better to do."
msgstr "Acho que ela não tem nada melhor pra fazer."

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.FRUITFLY
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.FRUITFLY"
msgid "Oh, shoo!"
msgstr "Ah, xô!"

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.FRUITFLYFRUIT
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.FRUITFLYFRUIT"
msgid "I'd rather not start attracting flies, but it could be useful."
msgstr "Prefiro não começar a atrair moscas, mas ela pode ser útil."

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.FRUITMEDLEY
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.FRUITMEDLEY"
msgid "Refreshing."
msgstr "Refrescante."

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.FUMAROLEAXE.GENERIC
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.FUMAROLEAXE.GENERIC"
msgid "Its time is nearly up."
msgstr "O tempo dele já quase acabou."

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.FUMAROLEAXE.HOT
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.FUMAROLEAXE.HOT"
msgid "Incredibly hot, but wonderfully efficient!"
msgstr "Incrivelmente quente, mas maravilhosamente eficiente!"

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.FUMAROLEAXE.LUKEWARM
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.FUMAROLEAXE.LUKEWARM"
msgid "It's barely warm."
msgstr "Está mal e mal quentinho."

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.FUMAROLEAXE.WARM
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.FUMAROLEAXE.WARM"
msgid "It makes the work nice and cozy."
msgstr "Torna o trabalho agradável e aconchegante."

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.FUMAROLEHAMMER.GENERIC
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.FUMAROLEHAMMER.GENERIC"
