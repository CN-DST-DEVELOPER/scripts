msgstr "É mesmo um ardil astucioso."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.OCEANFISHINGLURE_SPOON_BLUE
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.OCEANFISHINGLURE_SPOON_BLUE"
msgid "This should attract their attention!"
msgstr "Isso deve chamar a atenção deles!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.OCEANFISHINGLURE_SPOON_GREEN
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.OCEANFISHINGLURE_SPOON_GREEN"
msgid "This should attract their attention!"
msgstr "Isso deve chamar a atenção deles!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.OCEANFISHINGLURE_SPOON_RED
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.OCEANFISHINGLURE_SPOON_RED"
msgid "This should attract their attention!"
msgstr "Isso deve chamar a atenção deles!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.OCEANFISHINGROD
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.OCEANFISHINGROD"
msgid "Tremble before me, creatures of the deep!"
msgstr "Tremam perante mim, criaturas das profundezas!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.OCEANFISH_MEDIUM_1
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.OCEANFISH_MEDIUM_1"
msgid "Meat is meat."
msgstr "Carne é carne."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.OCEANFISH_MEDIUM_2
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.OCEANFISH_MEDIUM_2"
msgid "You will make a fine meal!"
msgstr "Você vai virar uma bela refeição!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.OCEANFISH_MEDIUM_3
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.OCEANFISH_MEDIUM_3"
msgid "The beastie put up an admirable fight."
msgstr "A fera lutou com bravura."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.OCEANFISH_MEDIUM_4
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.OCEANFISH_MEDIUM_4"
