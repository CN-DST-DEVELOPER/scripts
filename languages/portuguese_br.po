msgstr "Isso não parece tão difícil!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.OCEANFISHINGBOBBER_ROBIN
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.OCEANFISHINGBOBBER_ROBIN"
