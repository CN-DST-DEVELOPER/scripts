msgstr "Nossa, qual é a dele?"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.SNOWBALL_ITEM
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.SNOWBALL_ITEM"
msgid "Who needs a snowball to the face?"
msgstr "Quem precisa de uma bola de neve na cara?"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.SNOWMAN.GENERIC
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.SNOWMAN.GENERIC"
msgid "Whatever."
msgstr "Que seja."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.SNOWMAN.SNOWBALL
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.SNOWMAN.SNOWBALL"
msgid "Great. Now what?"
msgstr "Ótimo. E agora?"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.SNURTLE
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.SNURTLE"
msgid "Kaboom!"
msgstr "Cabum!"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.SOIL_AMENDER.GENERIC
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.SOIL_AMENDER.GENERIC"
msgid "Gross."
msgstr "Nojento."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.SOIL_AMENDER.SPOILED
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.SOIL_AMENDER.SPOILED"
