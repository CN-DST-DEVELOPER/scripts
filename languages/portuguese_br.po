#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.SMALLBIRD.HUNGRY
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.SMALLBIRD.HUNGRY"
msgid "Are you hungry?"
msgstr "Com fome?"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.SMALLBIRD.SLEEPING
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.SMALLBIRD.SLEEPING"
msgid "It's asleep for now."
msgstr "Está dormindo, por enquanto."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.SMALLBIRD.STARVING
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.SMALLBIRD.STARVING"
msgid "Okay, okay! I get it, you're hungry."
msgstr "OK, ok! Entendi, você está com fome."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.SMALLGHOST
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.SMALLGHOST"
msgid "What are you looking at, pipsqueak?"
msgstr "O que você está encarando, pivete?"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.SMALLMEAT
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.SMALLMEAT"
msgid "This could be made better with FIRE!"
msgstr "Isso poderia melhorar com FOGO!"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.SMALLMEAT_DRIED
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.SMALLMEAT_DRIED"
msgid "Chewy, but satisfying."
msgstr "Meio borrachudo, mas satisfaz."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.SNAPPER
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.SNAPPER"
