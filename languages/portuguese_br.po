msgstr "Isso me dá um mau pressentimento."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.SISTURN.SOME_FLOWERS
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.SISTURN.SOME_FLOWERS"
