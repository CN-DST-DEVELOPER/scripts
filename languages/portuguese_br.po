msgstr "É desmedidamente grande."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.PERDSHRINE.BURNT
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.PERDSHRINE.BURNT"
msgid "That won't do at all."
msgstr "Isso não vai servir pra nada."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.PERDSHRINE.EMPTY
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.PERDSHRINE.EMPTY"
msgid "I've got to plant something there."
msgstr "Preciso plantar alguma coisa aí."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.PERDSHRINE.GENERIC
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.PERDSHRINE.GENERIC"
