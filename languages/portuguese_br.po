#. STRINGS.UI.PLANTREGISTRY.DESCRIPTIONS.ASPARAGUS
msgctxt "STRINGS.UI.PLANTREGISTRY.DESCRIPTIONS.ASPARAGUS"
msgid "Green spears of vegetabley goodness. -W"
msgstr "Lanças verdes de delícia vegetal. -W"

#. STRINGS.UI.PLANTREGISTRY.DESCRIPTIONS.CARROT
msgctxt "STRINGS.UI.PLANTREGISTRY.DESCRIPTIONS.CARROT"
msgid "The perennial favorite of Bunnymen. -W"
msgstr "O eterno favorito dos Coelhosomens. -W"

#. STRINGS.UI.PLANTREGISTRY.DESCRIPTIONS.CORN
msgctxt "STRINGS.UI.PLANTREGISTRY.DESCRIPTIONS.CORN"
msgid "An a-maize-ingly versatile crop. -W"
msgstr "Cultura versátil e fubá-losa. -W"

#. STRINGS.UI.PLANTREGISTRY.DESCRIPTIONS.DRAGONFRUIT
msgctxt "STRINGS.UI.PLANTREGISTRY.DESCRIPTIONS.DRAGONFRUIT"
msgid "Produces a delectable fruit with a striking appearance. -W"
msgstr "Produz uma fruta deliciosa com uma aparência marcante. -W"

#. STRINGS.UI.PLANTREGISTRY.DESCRIPTIONS.DURIAN
msgctxt "STRINGS.UI.PLANTREGISTRY.DESCRIPTIONS.DURIAN"
msgid "A foul smelling fruit, favored by a certain green swamp dweller. -W"
msgstr "Fruta com cheiro desagradável, tem a preferência de uma certa habitante verde do pântano. -W"

#. STRINGS.UI.PLANTREGISTRY.DESCRIPTIONS.EGGPLANT
msgctxt "STRINGS.UI.PLANTREGISTRY.DESCRIPTIONS.EGGPLANT"
msgid "Zero percent egg, ninety-nine percent plant. Science has yet to explain the rest. -W"
msgstr "Roxa e reluzente: como alguém pode ter certeza de que não é venenosa? -W"

#. STRINGS.UI.PLANTREGISTRY.DESCRIPTIONS.GARLIC
msgctxt "STRINGS.UI.PLANTREGISTRY.DESCRIPTIONS.GARLIC"
msgid "Cloves of garlic pair well with a nice stake. -W"
msgstr "Dentes de alho vão bem com um belo filé. -W"

#. STRINGS.UI.PLANTREGISTRY.DESCRIPTIONS.MISSING
msgctxt "STRINGS.UI.PLANTREGISTRY.DESCRIPTIONS.MISSING"
msgid "Unknown"
msgstr "Desconhecido"

#. STRINGS.UI.PLANTREGISTRY.DESCRIPTIONS.ONION
msgctxt "STRINGS.UI.PLANTREGISTRY.DESCRIPTIONS.ONION"
msgid "A ripe onion plant is enough to bring tears of delight to any gardener. -W"
msgstr "Um pé de cebola maduro é o suficiente para fazer qualquer jardineiro chorar de alegria. -W"

#. STRINGS.UI.PLANTREGISTRY.DESCRIPTIONS.PEPPER
msgctxt "STRINGS.UI.PLANTREGISTRY.DESCRIPTIONS.PEPPER"
msgid "A hot pepper plant is the perfect thing to spice up your garden. -W"
msgstr "Um pé de pimenta é ideal para dar uma boa temperada no seu jardim. -W"

#. STRINGS.UI.PLANTREGISTRY.DESCRIPTIONS.POMEGRANATE
msgctxt "STRINGS.UI.PLANTREGISTRY.DESCRIPTIONS.POMEGRANATE"
msgid "Never take the juicy sweetness of a pom for granate. -W"
msgstr "Quem tem boca vai a Roma... e come romãs. -W"

#. STRINGS.UI.PLANTREGISTRY.DESCRIPTIONS.POTATO
msgctxt "STRINGS.UI.PLANTREGISTRY.DESCRIPTIONS.POTATO"
msgid "Sturdy, dependable, and loved by moustachioed strongmen. -W"
msgstr "Resistente, confiável e adorada por fortões bigodudos. -W"

#. STRINGS.UI.PLANTREGISTRY.DESCRIPTIONS.PUMPKIN
msgctxt "STRINGS.UI.PLANTREGISTRY.DESCRIPTIONS.PUMPKIN"
msgid "Compared to other gourds, the pumpkin plant squashes the competition. -W"
msgstr "Eu quero é um grande pé de abóbora. E não me venha com abobrinhas! -W"

#. STRINGS.UI.PLANTREGISTRY.DESCRIPTIONS.TOMATO
msgctxt "STRINGS.UI.PLANTREGISTRY.DESCRIPTIONS.TOMATO"
msgid "Tomatoes are an excellent source of vitamins, and make for a convenient projectile. -W"
msgstr "Tomates são uma excelente fonte de vitaminas, além de servirem muito bem como projéteis. -W"

#. STRINGS.UI.PLANTREGISTRY.DESCRIPTIONS.WATERMELON
msgctxt "STRINGS.UI.PLANTREGISTRY.DESCRIPTIONS.WATERMELON"
msgid "Fifty percent water, fifty percent melon. -W"
msgstr "É praticamente um cantil em forma de fruta. -W"

#. STRINGS.UI.PLANTREGISTRY.EFFECTS.NONE
msgctxt "STRINGS.UI.PLANTREGISTRY.EFFECTS.NONE"
msgid "None"
msgstr "Nenhum"

#. STRINGS.UI.PLANTREGISTRY.EFFECTS.WEED_FIRENETTLE
msgctxt "STRINGS.UI.PLANTREGISTRY.EFFECTS.WEED_FIRENETTLE"
msgid "These nettles can cause quite the burning sensation."
msgstr "Estas urtigas causam uma queimação e tanto."

#. STRINGS.UI.PLANTREGISTRY.EFFECTS.WEED_FORGETMELOTS
msgctxt "STRINGS.UI.PLANTREGISTRY.EFFECTS.WEED_FORGETMELOTS"
msgid "Has a tendency to come back when dug up."
msgstr "Tendem a voltar quando arrancadas."

#. STRINGS.UI.PLANTREGISTRY.EFFECTS.WEED_IVY
msgctxt "STRINGS.UI.PLANTREGISTRY.EFFECTS.WEED_IVY"
msgid "Attacks survivors when they disturb a nearby plant"
