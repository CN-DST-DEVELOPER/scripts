msgstr "A gente pegou!"

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_RABBITKING_PASSIVE
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_RABBITKING_PASSIVE"
msgid "Something's burrowing around us!"
msgstr "Tem algo cavando em volta da gente!"

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_REPELLED
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_REPELLED"
