#. STRINGS.SKIN_DESCRIPTIONS.wood_chair_cawnival
msgctxt "STRINGS.SKIN_DESCRIPTIONS.wood_chair_cawnival"
msgid "Winning is hard work. You deserve a rest."
msgstr "Vencer dá muito trabalho. Você merece um descanso."

#. STRINGS.SKIN_DESCRIPTIONS.wood_chair_fantasy
msgctxt "STRINGS.SKIN_DESCRIPTIONS.wood_chair_fantasy"
msgid "Plant your lucky rear right here."
msgstr "Plante seu bumbum sortudo bem aqui."

#. STRINGS.SKIN_DESCRIPTIONS.wood_chair_hallowed
msgctxt "STRINGS.SKIN_DESCRIPTIONS.wood_chair_hallowed"
msgid "This chair's constant squeaks and creaks will drive you batty."
msgstr "Os rangidos e guinchados constantes dessa cadeira vão te deixar biruta."

#. STRINGS.SKIN_DESCRIPTIONS.wood_chair_handmade
msgctxt "STRINGS.SKIN_DESCRIPTIONS.wood_chair_handmade"
msgid "This very chair was handcrafted for your derrière."
msgstr "Essa cadeira em particular foi criada à mão para o seu popozão."

#. STRINGS.SKIN_DESCRIPTIONS.wood_chair_rose
msgctxt "STRINGS.SKIN_DESCRIPTIONS.wood_chair_rose"
