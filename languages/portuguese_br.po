msgstr "Cuidado com os pássaros!"

#. STRINGS.CHARACTERS.WEBBER.BATTLECRY.DEER
msgctxt "STRINGS.CHARACTERS.WEBBER.BATTLECRY.DEER"
msgid "Hopefully we're venomous!"
msgstr "Espero que a gente seja venenoso!"

#. STRINGS.CHARACTERS.WEBBER.BATTLECRY.GENERIC
msgctxt "STRINGS.CHARACTERS.WEBBER.BATTLECRY.GENERIC"
