msgstr "Tem um cheiro estranho."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.MALBATROSS_FEATHER
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.MALBATROSS_FEATHER"
