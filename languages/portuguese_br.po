msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.SLINGSHOTAMMO_THULECITE"
msgid "Someone could trip and break their neck. Maybe it will be me."
msgstr "Alguém poderia tropeçar e quebrar o pescoço. Talvez seja eu."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.SLINGSHOTMODKIT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.SLINGSHOTMODKIT"
msgid "Walter is getting serious with his slingshotting."
msgstr "O Walter está levando o estilingue muito a sério."

