msgstr "Uau, as abelhas dela são tão amigáveis quanto ela."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.BEEBOX_HERMIT.NOHONEY
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.BEEBOX_HERMIT.NOHONEY"
msgid "Nothing to see here."
msgstr "Não há nada pra ver aqui."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.BEEBOX_HERMIT.READY
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.BEEBOX_HERMIT.READY"
msgid "She won't be mad if I steal a liiiittle honey, right?"
msgstr "Ela não vai ficar brava se eu roubar um pouquiiiinho de mel, certo?"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.BEEBOX_HERMIT.SOMEHONEY
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.BEEBOX_HERMIT.SOMEHONEY"
msgid "Patience."
msgstr "Paciência."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.BEEFALO.DEAD
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.BEEFALO.DEAD"
