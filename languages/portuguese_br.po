msgstr "Parece crocante."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.ONION_COOKED
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.ONION_COOKED"
msgid "A successful chemical reaction."
msgstr "Uma reação química bem-sucedida."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.ONION_OVERSIZED
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.ONION_OVERSIZED"
