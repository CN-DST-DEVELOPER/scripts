msgstr "Ah, que bonito."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.FLOATINGLANTERN.HELD
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.FLOATINGLANTERN.HELD"
