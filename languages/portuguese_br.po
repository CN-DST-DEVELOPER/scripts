msgstr "Foi um bom treinamento para o meu bolo de aniversário!"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.BLOWDART_SLEEP
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.BLOWDART_SLEEP"
msgid "Just don't breathe in."
msgstr "Tente não inspirar."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.BLOWDART_YELLOW
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.BLOWDART_YELLOW"
msgid "It has shocking accuracy."
msgstr "Tem uma precisão impressionante."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.BLUEAMULET
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.BLUEAMULET"
msgid "Cool as ice!"
msgstr "Bacanudo!"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.BLUEGEM
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.BLUEGEM"
msgid "It sparkles with cold energy."
msgstr "Brilha com energia fria."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.BLUEMOONEYE
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.BLUEMOONEYE"
msgid "It's always smart to keep an eye out."
msgstr "É sempre bom ficar de olho."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.BLUEPRINT.COMMON
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.BLUEPRINT.COMMON"
msgid "It's scientific!"
msgstr "É científico!"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.BLUEPRINT.RARE
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.BLUEPRINT.RARE"
msgid "It's REALLY scientific!"
msgstr "É científico MESMO!"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.BLUE_CAP
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.BLUE_CAP"
msgid "It's weird and gooey."
msgstr "É estranho e melequento!"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.BLUE_CAP_COOKED
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.BLUE_CAP_COOKED"
msgid "It's different now..."
msgstr "Agora está diferente..."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.BLUE_MUSHROOM.GENERIC
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.BLUE_MUSHROOM.GENERIC"
msgid "It's a mushroom."
msgstr "É um cogumelo."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.BLUE_MUSHROOM.INGROUND
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.BLUE_MUSHROOM.INGROUND"
msgid "It's sleeping."
msgstr "Está dormindo."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.BLUE_MUSHROOM.PICKED
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.BLUE_MUSHROOM.PICKED"
msgid "I wonder if it will come back?"
msgstr "Será que vai voltar?"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.BOARDS
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.BOARDS"
msgid "Boards."
msgstr "Tábuas."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.BOARON
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.BOARON"
msgid "I can take him!"
msgstr "Posso enfrentar ele!"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.BOARRIOR
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.BOARRIOR"
msgid "You sure are big!"
msgstr "Você é mesmo grande!"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.BOATFRAGMENT03
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.BOATFRAGMENT03"
msgid "Not much left of it."
msgstr "Não sobrou muita coisa."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.BOATFRAGMENT04
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.BOATFRAGMENT04"
msgid "Not much left of it."
msgstr "Não sobrou muita coisa."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.BOATFRAGMENT05
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.BOATFRAGMENT05"
msgid "Not much left of it."
msgstr "Não sobrou muita coisa."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.BOATPATCH
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.BOATPATCH"
msgid "Just in case of disaster."
msgstr "Em caso de desastre."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.BOATPATCH_KELP
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.BOATPATCH_KELP"
msgid "It'll have to do for now."
msgstr "Vai ter que servir por enquanto."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.BOATRACE_CHECKPOINT
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.BOATRACE_CHECKPOINT"
msgid "There's the checkpoint!"
msgstr "Aí está o ponto de marco!"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.BOATRACE_CHECKPOINT_THROWABLE_DEPLOYKIT
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.BOATRACE_CHECKPOINT_THROWABLE_DEPLOYKIT"
