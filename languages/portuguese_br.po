msgstr "Uma carta rebelde."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.POCKETWATCH_DISMANTLER
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.POCKETWATCH_DISMANTLER"
