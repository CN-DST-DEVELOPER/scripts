msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.CARNIVALGAME_MEMORY_STATION.GENERIC"
msgid "It'll let us play if we give it something shiny."
msgstr "Ele vai deixar a gente brincar se a gente der algo brilhante."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.CARNIVALGAME_MEMORY_STATION.PLAYING
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.CARNIVALGAME_MEMORY_STATION.PLAYING"
msgid "It's that one over there! Or... was it the other one..."
msgstr "É aquele ali adiante! Ou... era aquele outro..."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.CARNIVALGAME_PUCKDROP_KIT
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.CARNIVALGAME_PUCKDROP_KIT"
msgid "We can help the birds set up."
msgstr "A gente pode ajudar os pássaros na montagem."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.CARNIVALGAME_PUCKDROP_STATION.GENERIC
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.CARNIVALGAME_PUCKDROP_STATION.GENERIC"
