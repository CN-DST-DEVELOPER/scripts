msgstr "Eu poderia enfrentá-la."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.SPIDERCORPSE.BURNING
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.SPIDERCORPSE.BURNING"
