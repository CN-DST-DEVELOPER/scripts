msgstr "Ela guarda segredos profundos."

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.PURPLEMOONEYE
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.PURPLEMOONEYE"
