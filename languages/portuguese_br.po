msgstr "A linha precisa de algo para boiar."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.OCEANFISHINGBOBBER_OVAL
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.OCEANFISHINGBOBBER_OVAL"
msgid "My keen hunter's eyes can detect the smallest nibble!"
msgstr "Meu olhar afiado de caçadora pode detectar as menores presas!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.OCEANFISHINGBOBBER_ROBIN
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.OCEANFISHINGBOBBER_ROBIN"
msgid "Fly straight and true!"
msgstr "Voe com firmeza e determinação!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.OCEANFISHINGBOBBER_ROBIN_WINTER
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.OCEANFISHINGBOBBER_ROBIN_WINTER"
msgid "Fly straight and true!"
msgstr "Voe com firmeza e determinação!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.OCEANFISHINGLURE_HERMIT_DROWSY
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.OCEANFISHINGLURE_HERMIT_DROWSY"
