msgstr "Até mais!"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.SPIDERCORPSE.GENERIC
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.SPIDERCORPSE.GENERIC"
