msgstr "Allons-y, monsieur! Estarei logo atrás."

#. STRINGS.CHARACTERS.WARLY.ANNOUNCE_TICOON_WAITING_FOR_LEADER
msgctxt "STRINGS.CHARACTERS.WARLY.ANNOUNCE_TICOON_WAITING_FOR_LEADER"
