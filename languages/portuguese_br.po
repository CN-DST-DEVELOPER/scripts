msgstr "Já não posso dizer que ninguém me dá bola! Huehue!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.OCEANFISHINGBOBBER_CANARY
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.OCEANFISHINGBOBBER_CANARY"
