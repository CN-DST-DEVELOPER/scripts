msgstr "Wurde von kleinen Bestien verunreinigt!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_SUGARWOODTREE.TAPPED_EMPTY
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_SUGARWOODTREE.TAPPED_EMPTY"
msgid "I've no patience for thee, sap!"
msgstr "Ich habe keine Geduld für dich, Keimling!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_SUGARWOODTREE.TAPPED_READY
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_SUGARWOODTREE.TAPPED_READY"
msgid "I have acquired the nectar!"
msgstr "Ich habe den Nektar erworben!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_SUGARWOODTREE.WOUNDED
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_SUGARWOODTREE.WOUNDED"
msgid "It hath been wounded!"
msgstr "Hat Verwundungen erlitten!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_SWAMPIG
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_SWAMPIG"
msgid "You would make a most honorable warrior."
msgstr "Du wärst ein sehr ehrenwerter Krieger."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_SWAMPIGELDER.GENERIC
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_SWAMPIGELDER.GENERIC"
msgid "Your liege."
msgstr "Euer Vasall."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_SWAMPIGELDER.SLEEPING
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_SWAMPIGELDER.SLEEPING"
msgid "It slumbers soundly."
msgstr "Schlummert selig."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_SWAMPIG_HOUSE
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_SWAMPIG_HOUSE"
msgid "Lodgings of mine enemy."
msgstr "Unterkünfte meines Feindes."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_SWAMPIG_HOUSE_RUBBLE
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_SWAMPIG_HOUSE_RUBBLE"
msgid "Laid to ruin."
msgstr "In den Ruin getrieben."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_SYRUP
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_SYRUP"
msgid "Nectar of the gods, for the gods."
msgstr "Nektar der Götter, für die Götter."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_TOMATO
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_TOMATO"
msgid "Will this not anger the gods?"
msgstr "Wird das nicht die Götter verärgern?"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_TOMATO_COOKED
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_TOMATO_COOKED"
msgid "It boasts reddest guts, yet 'tis not meat!"
msgstr "Es hat die rötesten Eingeweide, aber es ist kein Fleisch!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_TOMATO_SEEDS
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_TOMATO_SEEDS"
msgid "'Tis a handful of seeds, for not-meat."
msgstr "Eine Handvoll Samen, für Nicht-Fleisch."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_TRADER_MERM
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_TRADER_MERM"
msgid "Prepare to barter!"
msgstr "Bereitet euch auf den Tausch vor!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_TRADER_MERM2
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_TRADER_MERM2"
msgid "'Tis a jaunty-hatted beast."
msgstr "Ein flottes Ding mit Hut."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_TURNIP
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_TURNIP"
msgid "The gods have strange tastes."
msgstr "Die Götter haben einen seltsamen Geschmack."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_TURNIP_COOKED
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_TURNIP_COOKED"
msgid "Ach! I shall not eat thee!"
msgstr "Ach! Ich werde dich nicht essen!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_TURNIP_SEEDS
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_TURNIP_SEEDS"
msgid "'Tis a handful of seeds, for not-meat."
msgstr "Eine Handvoll Samen, für Nicht-Fleisch."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_WHEAT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_WHEAT"
msgid "O, glorious wheat!"
msgstr "Oh, herrlicher Weizen!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_WHEAT_SEEDS
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_WHEAT_SEEDS"
msgid "'Tis a handful of seeds, for not-meat."
msgstr "Eine Handvoll Samen, für Nicht-Fleisch."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.RABBIT.GENERIC
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.RABBIT.GENERIC"
msgid "Jump into my mouth!"
msgstr "Spring in meinen Mund!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.RABBIT.HELD
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.RABBIT.HELD"
msgid "There is no escape!"
msgstr "Es gibt keinen Ausweg!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.RABBITHAT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.RABBITHAT"
msgid "Ridiculous."
msgstr "Lächerlich."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.RABBITHOLE.GENERIC
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.RABBITHOLE.GENERIC"
msgid "Showtime, rabbits!"
msgstr "Showtime, Karnickel!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.RABBITHOLE.SPRING
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.RABBITHOLE.SPRING"
msgid "It must be intermission for the rabbits."
msgstr "Die Kaninchen scheinen einen Pause zu machen."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.RABBITHOUSE.BURNT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.RABBITHOUSE.BURNT"
msgid "Good riddance, giant carrot."
msgstr "Auf Nimmerwiedersehen, Riesenkarotte."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.RABBITHOUSE.GENERIC
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.RABBITHOUSE.GENERIC"
msgid "What's to be done with a carrot that big?"
msgstr "Was macht man mit einer solch großen Karotte?"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.RABBITKINGHORN
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.RABBITKINGHORN"
msgid "The rabbit had best heed my call."
msgstr "Das Kaninchen hätte besser auf meinen Ruf hören sollen."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.RABBITKINGHORN_CHEST
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.RABBITKINGHORN_CHEST"
msgid "The rabbits pledge to safeguard my loot within their lair."
msgstr "Die Kaninchen versprechen, meine Beute in ihrem Bau zu schützen."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.RABBITKINGMINION_BUNNYMAN
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.RABBITKINGMINION_BUNNYMAN"
msgid "I shall send you to the endless carrot patch."
msgstr "Du wirst schon bald die Karotten von unten sehen."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.RABBITKINGSPEAR
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.RABBITKINGSPEAR"
msgid "It shall be a delightful insult to mine enemies to perish by rabbit antler."
msgstr "Es wäre eine schöne Beleidigung für meine Feinde, durch ein Kaninchengeweih zu sterben."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.RABBITKING_AGGRESSIVE
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.RABBITKING_AGGRESSIVE"
msgid "How adorable!"
msgstr "Wie süß!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.RABBITKING_LUCKY
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.RABBITKING_LUCKY"
msgid "I must capture it alive!"
msgstr "Ich muss ihn lebendig gefangen nehmen!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.RABBITKING_PASSIVE
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.RABBITKING_PASSIVE"
msgid "The diminutive lord seeks commerce!"
msgstr "Der winzige Herr trachtet nach Handel!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.RAINCOAT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.RAINCOAT"
msgid "Armor for rain."
msgstr "VERBESSERTE RÜSTUNG"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.RAINHAT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.RAINHAT"
msgid "We will fight in the rain."
msgstr "Wir kämpfen im Regen."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.RAINOMETER.BURNT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.RAINOMETER.BURNT"
msgid "Its prophecy days are done."
msgstr "Die Tage seiner Prophezeiungen sind vorbei."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.RAINOMETER.GENERIC
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.RAINOMETER.GENERIC"
msgid "It foretells the coming of rains."
msgstr "Sagt zukünftigen Regen vorher."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.RATATOUILLE
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.RATATOUILLE"
msgid "A pile of vegetables. No thanks."
msgstr "Ein Haufen Gemüse. Nein, danke."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.RAZOR
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.RAZOR"
msgid "A small blade, but a blade nonetheless."
msgstr "Zwar eine kleine Klinge, aber trotzdem eine Klinge."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.RECORD
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.RECORD"
msgid "T'would be a kindness to keep it from reaching the ears of my ally."
msgstr "Es wäre große Freundlichkeit, dies von den Ohren meiner Verbündeten fernzuhalten."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.RECORD_BALATRO
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.RECORD_BALATRO"
msgid "'Tis a ballad of good hap!"
msgstr "Ist eine Ballade des guten Zufalls!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.RECORD_CREEPYFOREST
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.RECORD_CREEPYFOREST"
msgid "Music is nourishment for thy soul!"
msgstr "Musik ist Nahrung für die Seele!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.RECORD_DANGER
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.RECORD_DANGER"
msgid "Let us play a rousing war song!"
msgstr "Lass uns einen mitreißenden Kriegsgesang anstimmen!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.RECORD_DAWN
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.RECORD_DAWN"
msgid "Thy melody is most soothing."
msgstr "Diese Melodie ist hochgradig wohltuend."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.RECORD_DRSTYLE
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.RECORD_DRSTYLE"
msgid "The musicians play with such passion!"
msgstr "Die Musiker spielen mit solcher Leidenschaft!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.RECORD_DUSK
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.RECORD_DUSK"
msgid "Thy melody is most soothing."
msgstr "Diese Melodie ist hochgradig wohltuend."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.RECORD_EFS
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.RECORD_EFS"
msgid "Doth the tempo not make one's heart race with excitement?"
msgstr "Lässt das Tempo irgendjemandes Herz nicht vor Ereiferung hüpfen?"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.RECORD_END
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.RECORD_END"
msgid "The showstopper!"
msgstr "Das sorgt für Furore!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.RECORD_HALLOWEDNIGHTS
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.RECORD_HALLOWEDNIGHTS"
msgid "A serenade for the ghosts and ghouls."
msgstr "Eine Serenade für Geister und Ghule."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.RECORD_MAIN
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.RECORD_MAIN"
msgid "Music is nourishment for thy soul!"
msgstr "Musik ist Nahrung für die Seele!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.RECORD_WORKTOBEDONE
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.RECORD_WORKTOBEDONE"
msgid "Music is nourishment for thy soul!"
msgstr "Musik ist Nahrung für die Seele!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.REDGEM
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.REDGEM"
msgid "It is hot to the touch."
msgstr "Er ist zu heiß, um ihn anzufassen."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.REDLANTERN
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.REDLANTERN"
msgid "A lucky ward to guard against the night."
msgstr "Ein Schutz gegen die Nacht."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.REDMOONEYE
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.REDMOONEYE"
msgid "Odin's eye, grant us wisdom!"
msgstr "Odins Auge, gewähre uns Weisheit!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.REDPOUCH
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.REDPOUCH"
msgid "A blessing of good fortune!"
msgstr "Ein Segen des Glücks!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.RED_CAP
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.RED_CAP"
msgid "Umami or not, I don't want it."
msgstr "Umami oder nicht, ich will es nicht."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.RED_CAP_COOKED
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.RED_CAP_COOKED"
msgid "I don't want it, but I'm glad it survived trial by fire."
msgstr "Ich will sie nicht, aber ich bin froh, dass sie die Feuerprobe überlebt hat."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.RED_MUSHROOM.GENERIC
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.RED_MUSHROOM.GENERIC"
msgid "At least it's got a nice color."
msgstr "Wenigstens hat er eine schöne Farbe."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.RED_MUSHROOM.INGROUND
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.RED_MUSHROOM.INGROUND"
msgid "And stay down there!"
msgstr "Und bleib dort unten!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.RED_MUSHROOM.PICKED
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.RED_MUSHROOM.PICKED"
msgid "Good riddance."
msgstr "Auf Nimmerwiedersehen!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.REEDS.BURNING
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.REEDS.BURNING"
msgid "See you in Asgard, reeds!"
msgstr "Wir sehen uns in Asgard!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.REEDS.GENERIC
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.REEDS.GENERIC"
msgid "Those are some hardy reeds."
msgstr "Das ist widerstandsfähiges Schilf."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.REEDS.PICKED
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.REEDS.PICKED"
msgid "Cut down in their prime."
msgstr "Beschnitten auf das Wesentliche."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.REFINED_DUST
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.REFINED_DUST"
msgid "The dust hath been forged into a solid block."
msgstr "Der Staub ist zu einem festen Block geformt worden."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.REFLECTIVEVEST
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.REFLECTIVEVEST"
msgid "Ha! The sun is no warrior if it cannot penetrate this."
msgstr "Ha! Die Sonne ist kein Krieger, wenn sie nicht in der Lage ist, dort einzudringen."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.RELIC
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.RELIC"
msgid "Fit for Asgard."
msgstr "Für Asgard geeignet."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.RESEARCHLAB.BURNT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.RESEARCHLAB.BURNT"
msgid "Ashes to ashes."
msgstr "Asche zu Asche."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.RESEARCHLAB.GENERIC
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.RESEARCHLAB.GENERIC"
msgid "I prefer battle to science."
msgstr "Für mich ist der Kampf wichtiger als die Wissenschaft."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.RESEARCHLAB2.BURNT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.RESEARCHLAB2.BURNT"
msgid "Dust to dust."
msgstr "Staub zu Staub."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.RESEARCHLAB2.GENERIC
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.RESEARCHLAB2.GENERIC"
msgid "Perhaps science can enhance my combat skills."
msgstr "Vielleicht kann die Wissenschaft meine Kampffertigkeiten verbessern."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.RESEARCHLAB3.BURNT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.RESEARCHLAB3.BURNT"
msgid "Its strange power did not protect it from fire."
msgstr "Seine seltsame Macht konnte es nicht vor dem Feuer bewahren."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.RESEARCHLAB3.GENERIC
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.RESEARCHLAB3.GENERIC"
msgid "A mystical thing."
msgstr "Ein mystisches Ding."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.RESEARCHLAB4.BURNT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.RESEARCHLAB4.BURNT"
msgid "No more meat will come from here!"
msgstr "Von hier wird kein weiteres Fleisch mehr kommen."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.RESEARCHLAB4.GENERIC
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.RESEARCHLAB4.GENERIC"
msgid "It is an absurd machine that makes meat."
msgstr "Das ist eine absurde Maschine, die Fleisch macht."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.RESKIN_TOOL
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.RESKIN_TOOL"
msgid "In the blink of an eye, what once was is no more!"
msgstr "Im Handumdrehen ist nicht mehr, was einst war!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.RESURRECTIONSTATUE.BURNT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.RESURRECTIONSTATUE.BURNT"
msgid "Valhalla, we come!"
msgstr "Walhalla, wir kommen."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.RESURRECTIONSTATUE.GENERIC
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.RESURRECTIONSTATUE.GENERIC"
msgid "Might the gods witness this visage and offer protection."
msgstr "Mögen die Götter dieses Gesicht sehen und Schutz bieten."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.RESURRECTIONSTONE
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.RESURRECTIONSTONE"
msgid "It holds me back from Valhalla."
msgstr "Der holt mich von Walhalla zurück."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.REVIVER
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.REVIVER"
msgid "Feel the passion inside!"
msgstr "Fühle die Leidenschaft!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.RHINODRILL
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.RHINODRILL"
msgid "Thy machismo frighten me not!"
msgstr "Dein Getue macht mir keine Angst!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.ROASTTURKEY
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.ROASTTURKEY"
msgid "A glorious feast indeed!"
msgstr "Ein wunderbares Fest fürwahr!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.ROBIN.GENERIC
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.ROBIN.GENERIC"
msgid "Red like blood."
msgstr "Rot wie Blut."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.ROBIN.HELD
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.ROBIN.HELD"
msgid "I prefer your black brethren."
msgstr "Ich bevorzuge seine schwarzen Brüder."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.ROBIN_WINTER.GENERIC
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.ROBIN_WINTER.GENERIC"
msgid "This bird knows about the cold."
msgstr "Dieser Vogel kennt sich mit der Kälte aus."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.ROBIN_WINTER.HELD
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.ROBIN_WINTER.HELD"
msgid "Such fluffy feathers."
msgstr "Solch weiche Federn."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.ROBOT_BLUEPRINT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.ROBOT_BLUEPRINT"
msgid "Armor of iron for my steed!"
msgstr "Eine Rüstung von Eisen für mein Reittier!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.ROBOT_PUPPET
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.ROBOT_PUPPET"
msgid "A prisoner!"
msgstr "Ein Gefangener!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.ROCK
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.ROCK"
msgid "Smash!"
msgstr "Zerschmettern!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.ROCKS
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.ROCKS"
msgid "Some pretty normal rocks."
msgstr "Einige ziemlich normale Steine."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.ROCKY
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.ROCKY"
msgid "He may be a worthy combat comrade."
msgstr "Er könnte ein würdiger Kampfgefährte sein."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.ROCK_AVOCADO_BUSH.BARREN
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.ROCK_AVOCADO_BUSH.BARREN"
msgid "Tis barren as the rainless desert."
msgstr "Ausgedörrt wie die regenlose Wüste."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.ROCK_AVOCADO_BUSH.BURNING
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.ROCK_AVOCADO_BUSH.BURNING"
msgid "Tis consumed by flame!"
msgstr "'s ist von Flammen verzehrt!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.ROCK_AVOCADO_BUSH.DISEASED
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.ROCK_AVOCADO_BUSH.DISEASED"
msgid "The plague hath overwhelmed it completely!"
msgstr "Von Krankheit hingestreckt!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.ROCK_AVOCADO_BUSH.DISEASING
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.ROCK_AVOCADO_BUSH.DISEASING"
msgid "A plague festers within it!"
msgstr "Eine Krankheit nistet in ihm!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.ROCK_AVOCADO_BUSH.GENERIC
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.ROCK_AVOCADO_BUSH.GENERIC"
msgid "Hark, be wary! Tis fruit I see."
msgstr "Halt, Obacht! Es ist eine Frucht, die ich sehe."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.ROCK_AVOCADO_BUSH.PICKED
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.ROCK_AVOCADO_BUSH.PICKED"
msgid "It hath been stripped of its bounty."
msgstr "Er wurde um seine Beute gebracht."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.ROCK_AVOCADO_BUSH.WITHERED
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.ROCK_AVOCADO_BUSH.WITHERED"
msgid "It had not the strength to withstand this heat."
msgstr "Er hatte nicht die Stärke, dieser Hitze zu trotzen."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.ROCK_AVOCADO_FRUIT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.ROCK_AVOCADO_FRUIT"
msgid "Tis either a rock or vegetable. Neither are food."
msgstr "Entweder ein Stein oder Gemüse. Jedenfalls keine Nahrung."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.ROCK_AVOCADO_FRUIT_RIPE
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.ROCK_AVOCADO_FRUIT_RIPE"
msgid "Yuck."
msgstr "Pfui."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.ROCK_AVOCADO_FRUIT_RIPE_COOKED
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.ROCK_AVOCADO_FRUIT_RIPE_COOKED"
msgid "I shall not eat that."
msgstr "Das esse ich nicht."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.ROCK_AVOCADO_FRUIT_SPROUT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.ROCK_AVOCADO_FRUIT_SPROUT"
msgid "The rock veggie is sprouting."
msgstr "Das Steingemüse keimt."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.ROCK_ICE.GENERIC
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.ROCK_ICE.GENERIC"
msgid "A miniature frozen mountain."
msgstr "Eine Miniatur eines gefrorenen Berges."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.ROCK_ICE.MELTED
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.ROCK_ICE.MELTED"
msgid "Poor glacier!"
msgstr "Armer Gletscher!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.ROCK_ICE_MELTED
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.ROCK_ICE_MELTED"
msgid "Poor glacier!"
msgstr "Armer Gletscher!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.ROCK_LIGHT.GENERIC
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.ROCK_LIGHT.GENERIC"
msgid "The lava crust is firm."
msgstr "Die Lavakruste ist fest."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.ROCK_LIGHT.LOW
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.ROCK_LIGHT.LOW"
msgid "The lava crust is reforming."
msgstr "Die Lavakruste reformiert sich."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.ROCK_LIGHT.NORMAL
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.ROCK_LIGHT.NORMAL"
msgid "Beautiful light!"
msgstr "Wunderschönes Licht!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.ROCK_LIGHT.OUT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.ROCK_LIGHT.OUT"
msgid "Looks delicate."
msgstr "Sieht köstlich aus."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.ROCK_MOON
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.ROCK_MOON"
msgid "A gift from Mani."
msgstr "Ein Geschenk von Mani."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.ROCK_PETRIFIED_TREE
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.ROCK_PETRIFIED_TREE"
msgid "My mere presence struck terror into their tree-hearts!"
msgstr "Meine bloße Anwesenheit schlug Schrecken in ihre Baumherzen!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.ROCK_PETRIFIED_TREE_OLD
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.ROCK_PETRIFIED_TREE_OLD"
msgid "My mere presence struck terror into their tree-hearts!"
msgstr "Meine bloße Anwesenheit schlug Schrecken in ihre Baumherzen!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.ROOK
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.ROOK"
msgid "Chaaaarge!"
msgstr "Attacke!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.ROOK_NIGHTMARE
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.ROOK_NIGHTMARE"
msgid "You don't frighten me!"
msgstr "Du machst mir keine Angst!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.ROPE
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.ROPE"
msgid "Strong enough to bind the sails of my longship."
msgstr "Stark genug, um die Segel meines Schiffs zu halten."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.ROPE_BRIDGE_KIT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.ROPE_BRIDGE_KIT"
msgid "'Tis no Bifrost, but 'twill do."
msgstr "Sie ist keine Bifröst, aber sie wird schon reichen."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.ROSEGLASSESHAT.GENERIC
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.ROSEGLASSESHAT.GENERIC"
msgid "They reveal visions to my ally. I just hope she remains wary."
msgstr "Sie offenbaren meinen Verbündeten Visionen. Ich hoffe nur, sie bleibt umsichtig."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.ROSEGLASSESHAT.MISSINGSKILL
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.ROSEGLASSESHAT.MISSINGSKILL"
msgid "only_used_by_winona"
msgstr "only_used_by_winona"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.ROTTENEGG.GENERIC
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.ROTTENEGG.GENERIC"
msgid "Ruined for eating, but primed for battle."
msgstr "Zu verdorben, um es zu essen. Aber erstklassig für den Kampf."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.ROYAL_JELLY
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.ROYAL_JELLY"
msgid "To absorb the felled queen's power!"
msgstr "Nimmt die Macht der gefällten Königin auf!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.RUBBLE
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.RUBBLE"
msgid "A pile of ancient rocks."
msgstr "Ein Stapel von uralter Steine."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.RUINSHAT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.RUINSHAT"
msgid "A crown... that fights!"
msgstr "Eine Krähe, die kämpft!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.RUINS_BAT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.RUINS_BAT"
msgid "A warrior's wand!"
msgstr "Der Stab eines Kriegers!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.RUINS_RUBBLE
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.RUINS_RUBBLE"
msgid "Its days are not done."
msgstr "Seine Tage sind gezählt."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SACRED_CHEST.GENERIC
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SACRED_CHEST.GENERIC"
msgid "What foul manner of chest is this?"
msgstr "Was für eine verdorbene Truhe ist das?"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SACRED_CHEST.LOCKED
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SACRED_CHEST.LOCKED"
msgid "I shall submit to the gods' judgment."
msgstr "Ich werde mich dem Urteil der Götter ergeben."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SADDLEHORN
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SADDLEHORN"
msgid "Mighty steeds can be unsaddled with this."
msgstr "Mächtige Rösser lassen sich damit absatteln."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SADDLE_BASIC
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SADDLE_BASIC"
msgid "Now to find a faithful steed."
msgstr "Jetzt noch ein treues Ross finden."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SADDLE_RACE
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SADDLE_RACE"
msgid "Oh to fly on the wings of Valkyrie!"
msgstr "Herrlich! Fliegen auf den Flügeln der Walküre!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SADDLE_SHADOW
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SADDLE_SHADOW"
msgid "A fine saddle for slaying."
msgstr "Ein guter Sattel zum Töten."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SADDLE_WAR
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SADDLE_WAR"
msgid "I ride to victory or death!"
msgstr "Ich reite in den Sieg oder den Tod!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SADDLE_WATHGRITHR
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SADDLE_WATHGRITHR"
msgid "We ride to victory!"
msgstr "Wir reiten zum Sieg!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SALSA
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SALSA"
msgid "A disappointing mush."
msgstr "Ein enttäuschender Brei."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SALTBOX
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SALTBOX"
msgid "A fine place to store meats!"
msgstr "Ein guter Platz, um Fleisch zu lagern!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SALTLICK
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SALTLICK"
msgid "Minerals, not meat."
msgstr "Mineralien statt Fleisch."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SALTLICK_IMPROVED
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SALTLICK_IMPROVED"
msgid "So the meat can season itself."
msgstr "Damit das Fleisch sich selbst würzen kann."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SALTROCK
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SALTROCK"
msgid "It hath a strange shape to it."
msgstr "Er hat eine merkwürdige Form."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SALTSTACK.GENERIC
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SALTSTACK.GENERIC"
msgid "Tis the form of a sea nymph!"
msgstr "Die Form einer Meeresnymphe!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SALTSTACK.GROWING
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SALTSTACK.GROWING"
msgid "Formed as if by Odin's hand!"
msgstr "Wie von Odins Hand geformt!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SALTSTACK.MINED_OUT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SALTSTACK.MINED_OUT"
msgid "Naught but a stump!"
msgstr "Nur noch ein Stumpf!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SALTY_DOG
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SALTY_DOG"
msgid "To me, my briny ally!"
msgstr "Zu mir, mein salziger Mitstreiter!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SALTY_DOGHAT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SALTY_DOGHAT"
msgid "The helm of one who holds command over the seas."
msgstr "Der Helm desjenigen, der über die See gebietet."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SANDBLOCK
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SANDBLOCK"
msgid "Tis a castle of sand!"
msgstr "Eine Burg aus Sand!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SANDSPIKE
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SANDSPIKE"
msgid "The earth itself dares to fight me!"
msgstr "Die Erde selbst will mit mir kämpfen!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SANITYROCK.ACTIVE
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SANITYROCK.ACTIVE"
msgid "I do not think I can best this rock in combat."
msgstr "Ich glaube nicht, dass ich diesen Stein in Kampf übertreffen kann."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SANITYROCK.INACTIVE
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SANITYROCK.INACTIVE"
msgid "Clever rock, you cannot surprise a warrior!"
msgstr "Geschickter Stein. Du kannst einen Krieger nicht überraschen."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SAPLING.BURNING
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SAPLING.BURNING"
msgid "Nooo! My spears!"
msgstr "Nein! Meine Speere!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SAPLING.DISEASED
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SAPLING.DISEASED"
msgid "Disease festers within its soul."
msgstr "Seine Seele ist ganz krank."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SAPLING.DISEASING
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SAPLING.DISEASING"
msgid "It is weakening before mine eyes!"
msgstr "Wird vor meinen Augen schwächer!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SAPLING.GENERIC
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SAPLING.GENERIC"
msgid "It longs to be a spear."
msgstr "Er will ein Speer werden."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SAPLING.PICKED
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SAPLING.PICKED"
msgid "The small tree has been slain!"
msgstr "Der kleine Baum wurde erschlagen!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SAPLING.WITHERED
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SAPLING.WITHERED"
msgid "It has been shriveled by the heat."
msgstr "Die Hitze hat ihn schrumpelig gemacht."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SCANDATA
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SCANDATA"
msgid "The metal scout's report!"
msgstr "Der Bericht des Metallspähers!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SCARECROW.BURNING
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SCARECROW.BURNING"
msgid "The scarecrow burns."
msgstr "Die Vogelscheuche brennt."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SCARECROW.BURNT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SCARECROW.BURNT"
msgid "The scarecrow dost yearn for nothing, now."
msgstr "Die Vogelscheuche will jetzt nichts mehr."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SCARECROW.GENERIC
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SCARECROW.GENERIC"
msgid "Dost thou yearn for a brain?"
msgstr "Hättest du nicht gerne ein Hirn?"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SCORCHED_SKELETON
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SCORCHED_SKELETON"
msgid "Rest easy, spirit. Your fight is over."
msgstr "Ruhe in Frieden, Geist. Dein Kampf ist vorbei."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SCRAPBOOK_PAGE
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SCRAPBOOK_PAGE"
msgid "From whence hath you come, mysterious page?"
msgstr "Von welch fernem Ort stammst du, geheimnisvolle Seite?"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SCRAPHAT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SCRAPHAT"
msgid "'Twas won in an invigorating battle!"
msgstr "Sie wurde in einer erquickenden Schlacht ergattert!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SCRAP_MONOCLEHAT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SCRAP_MONOCLEHAT"
msgid "An enchanted eye, to view the whole battlefield at once."
msgstr "Ein verzaubertes Auge, mit man das ganze Schlachtfeld auf einmal erblickt."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SCULPTINGTABLE.BLOCK
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SCULPTINGTABLE.BLOCK"
msgid "May the muses guide our hands!"
msgstr "Mögen die Musen unsere Hände leiten!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SCULPTINGTABLE.BURNT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SCULPTINGTABLE.BURNT"
msgid "Lain to waste."
msgstr "Zerstört."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SCULPTINGTABLE.EMPTY
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SCULPTINGTABLE.EMPTY"
msgid "A transformative altar for the stone gods."
msgstr "Ein transformativer Altar für die steinernen Götter."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SCULPTINGTABLE.SCULPTURE
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SCULPTINGTABLE.SCULPTURE"
msgid "The muses have been kind this day."
msgstr "Die Musen sind heute gut gewesen."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SCULPTURE_BISHOPBODY.COVERED
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SCULPTURE_BISHOPBODY.COVERED"
msgid "More apt for the halls of Valhalla."
msgstr "Passender für die Hallen von Walhalla."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SCULPTURE_BISHOPBODY.FINISHED
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SCULPTURE_BISHOPBODY.FINISHED"
msgid "Will this please the gods? Or anger them?"
msgstr "Wird dies den Göttern gefallen? Oder wird es sie ärgern?"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SCULPTURE_BISHOPBODY.READY
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SCULPTURE_BISHOPBODY.READY"
msgid "The beast has been roused beneath!"
msgstr "Das Tier darunter wurde geweckt!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SCULPTURE_BISHOPBODY.UNCOVERED
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SCULPTURE_BISHOPBODY.UNCOVERED"
msgid "We've freed the figure slumbering in the stone."
msgstr "Wir haben die im Stein schlummernde Figur befreit."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SCULPTURE_BISHOPHEAD
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SCULPTURE_BISHOPHEAD"
msgid "A follower of Mimir, mayhaps?"
msgstr "Ein Anhänger von Mimir vielleicht?"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SCULPTURE_KNIGHTBODY.COVERED
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SCULPTURE_KNIGHTBODY.COVERED"
msgid "An abandoned monument to the gods?"
msgstr "Eine verlassenes Denkmal für die Götter?"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SCULPTURE_KNIGHTBODY.FINISHED
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SCULPTURE_KNIGHTBODY.FINISHED"
msgid "Might we come to regret this action?"
msgstr "Ob wir das wohl noch bereuen werden?"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SCULPTURE_KNIGHTBODY.READY
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SCULPTURE_KNIGHTBODY.READY"
msgid "The beast has been roused beneath!"
msgstr "Das Tier darunter wurde geweckt!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SCULPTURE_KNIGHTBODY.UNCOVERED
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SCULPTURE_KNIGHTBODY.UNCOVERED"
msgid "An icon of evil, surely!"
msgstr "Ein Symbol des Bösen, sicherlich!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SCULPTURE_KNIGHTHEAD
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SCULPTURE_KNIGHTHEAD"
msgid "Dost thou yearn for a body?"
msgstr "Sehnst du dich nach einem Körper?"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SCULPTURE_ROOKBODY.COVERED
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SCULPTURE_ROOKBODY.COVERED"
msgid "Warriors are not concerned with decorative sculptures."
msgstr "Krieger brauchen keine dekorativen Skulpturen."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SCULPTURE_ROOKBODY.FINISHED
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SCULPTURE_ROOKBODY.FINISHED"
msgid "Gods help us on Mani's night."
msgstr "Götter helfen uns in Manis Nacht."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SCULPTURE_ROOKBODY.READY
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SCULPTURE_ROOKBODY.READY"
msgid "The beast has been roused beneath!"
msgstr "Das Tier darunter wurde geweckt!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SCULPTURE_ROOKBODY.UNCOVERED
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SCULPTURE_ROOKBODY.UNCOVERED"
msgid "I fear we've unleashed a great evil."
msgstr "Ich fürchte, wir haben ein großes Übel entfesselt."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SCULPTURE_ROOKNOSE
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SCULPTURE_ROOKNOSE"
msgid "It has strayed from the warrior's path."
msgstr "Ist vom Weg des Kriegers abgekommen."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SEAFARING_PROTOTYPER.BURNT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SEAFARING_PROTOTYPER.BURNT"
msgid "Tis no more."
msgstr "Er ist nicht mehr."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SEAFARING_PROTOTYPER.GENERIC
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SEAFARING_PROTOTYPER.GENERIC"
msgid "A seafaring Viking is keen of mind and sharp of wit."
msgstr "Seefahrende Wikinger sind von scharfem Verstande."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SEAFOODGUMBO
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SEAFOODGUMBO"
msgid "A meal fit for a Viking queen."
msgstr "Ein Mahl, das einer Wikingerkönigin würdig ist."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SEASTACK
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SEASTACK"
msgid "I shall not dash mine ship upon thee!"
msgstr "Auf dich setze ich mein Schiff nicht!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SECURITY_PULSE_CAGE
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SECURITY_PULSE_CAGE"
msgid "'Tis a trap!"
msgstr "Das ist eine Falle!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SECURITY_PULSE_CAGE_FULL
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SECURITY_PULSE_CAGE_FULL"
msgid "It burns bright like the sword of Surtr."
msgstr "Sie brennt lichterloh wie das Schwert von Surtr."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SEEDPOUCH
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SEEDPOUCH"
msgid "For carrying worthless seeds."
msgstr "Darin verwahrt man wertloses Saatgut."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SEEDS
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SEEDS"
msgid "Tiny nature bits."
msgstr "Winzige Stückchen Natur."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SEEDS_COOKED
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SEEDS_COOKED"
msgid "Tiny nature bits, cooked to death."
msgstr "Winzige Stückchen Natur, zu Tode gekocht."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SENTRYWARD
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SENTRYWARD"
msgid "May the secrets of this land be divulged by the gods."
msgstr "Mögen die Geheimnisse dieses Landes von den Göttern bewahrt werden."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SEWING_KIT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SEWING_KIT"
msgid "I am no seamstress, but repairs are sometimes necessary."
msgstr "Ich bin zwar keine Näherin, aber Reparaturen sind manchmal notwendig."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SEWING_MANNEQUIN.BURNT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SEWING_MANNEQUIN.BURNT"
msgid "The stuffed man hath met a fiery end."
msgstr "Der ausgestopfte Mann fand ein feuriges Ende."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SEWING_MANNEQUIN.GENERIC
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SEWING_MANNEQUIN.GENERIC"
msgid "It shall make for some fine target practice."
msgstr "Taugt wunderbar als Zielscheibe."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SEWING_TAPE
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SEWING_TAPE"
msgid "Luckily I need be no seamstress with this!"
msgstr "Zum Glück muss ich dafür keine Schneiderin sein!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SHADOWDANCER
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SHADOWDANCER"
msgid "This serf is not being treated with dignity."
msgstr "Dieser Leibeigene wird nicht würdevoll behandelt."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SHADOWDIGGER
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SHADOWDIGGER"
msgid "I hope this serf is being treated with dignity."
msgstr "Ich hoffe, diese Getreue wird mit Würde behandelt."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SHADOWHEART
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SHADOWHEART"
msgid "Blackest hearts. Darkest omens."
msgstr "Schwärzeste Herzen. Dunkelste Omen."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SHADOWRIFT_PORTAL
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SHADOWRIFT_PORTAL"
msgid "A chasm to Hel itself."
msgstr "Ein Abgrund für Hel höchstpersönlich."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SHADOWTHRALL_CENTIPEDE.BODY
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SHADOWTHRALL_CENTIPEDE.BODY"
msgid "The beast be clad in formidable armor."
msgstr "Das Tier ist mit einer beeindruckenden Rüstung bekleidet."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SHADOWTHRALL_CENTIPEDE.FLIPPED
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SHADOWTHRALL_CENTIPEDE.FLIPPED"
msgid "Overthrown, yet the beast's fury remaineth!"
msgstr "Gestürzt, doch die Wut der Bestie bleibt bestehen!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SHADOWTHRALL_CENTIPEDE.HEAD
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SHADOWTHRALL_CENTIPEDE.HEAD"
msgid "A twain-headed beast!"
msgstr "Ein zweiköpfiges Ungeheuer!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SHADOWTHRALL_HANDS
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SHADOWTHRALL_HANDS"
msgid "To arms, fiend!"
msgstr "Zu den Waffen, Unhold!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SHADOWTHRALL_HORNS
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SHADOWTHRALL_HORNS"
msgid "All thou shall taste is the bite of my spear!"
msgstr "Alleinig den Biss meines Speeres werdet Ihr schmecken!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SHADOWTHRALL_MOUTH
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SHADOWTHRALL_MOUTH"
msgid "I shall wipe that grin off thine face."
msgstr "Ich werde dir das Grinsen aus dem Gesicht wischen."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SHADOWTHRALL_PARASITE
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SHADOWTHRALL_PARASITE"
msgid "Keep away thy cursed embrace."
msgstr "Bewahre mich vor deiner verfluchten Berührung."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SHADOWTHRALL_WINGS
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SHADOWTHRALL_WINGS"
msgid "Thou art swift, but not swift enough!"
msgstr "Ihr seid flink, jedoch nicht flink genug!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SHADOW_BATTLEAXE
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SHADOW_BATTLEAXE"
msgid "I shall bring down many a beast with that cursed axe."
msgstr "Mit dieser verfluchten Axt werde ich so manches Biest erlegen."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SHADOW_BEEF_BELL
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SHADOW_BEEF_BELL"
msgid "We shall ride again!"
msgstr "Wir werden wieder reiten!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SHADOW_FORGE
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SHADOW_FORGE"
msgid "It doth conjure powerful, accursed things..."
msgstr "Sie beschwört mächtige, verfluchte Dinge …"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SHADOW_FORGE_KIT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SHADOW_FORGE_KIT"
msgid "Dare I toy with such a thing?"
msgstr "Wage ich mich, damit zu arbeiten?"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SHADOW_HEART_VEIN
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SHADOW_HEART_VEIN"
msgid "Such gifts bear ill fortune."
msgstr "Derlei Geschenke bringen Missgeschick hervor."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SHALLOW_GRAVE
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SHALLOW_GRAVE"
msgid "They deserved better."
msgstr "Die Person hat Besseres verdient."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SHARK
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SHARK"
msgid "Do you come to challenge me, sea beast?"
msgstr "Du willst mich herausfordern, Seeungeheuer?"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SHARKBOI
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SHARKBOI"
msgid "Whether land or sea, a shallow grave waits for thee."
msgstr "Ob Land oder Meer, dich erwartet ein untiefes Grab."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SHELLWEAVER
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SHELLWEAVER"
msgid "The sea witch hath shared her ways with us. A high honor, indeed."
msgstr "Die Meerhexe hat uns ihre Wege gelehrt. Eine wahrlich hohe Ehre."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SHELL_CLUSTER
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SHELL_CLUSTER"
msgid "Tis naught but a clump of shells."
msgstr "Es ist nur ein Muschelklumpen."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SHIELDOFTERROR
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SHIELDOFTERROR"
msgid "Why cower behind a shield when you can strike with it!"
msgstr "Warum sich hinter einem Schild verstecken, wenn du damit zuschlagen kannst!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SHOVEL
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SHOVEL"
msgid "I'd prefer a ship burial, though this might have its uses."
msgstr "Ich will zwar ein Seebegräbnis, aber das könnte trotzdem nützlich sein."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SHOVEL_LUNARPLANT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SHOVEL_LUNARPLANT"
msgid "The ground stands no chance against me."
msgstr "Der Boden selbst kann mir nicht im Wege stehen."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SHROOMBAIT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SHROOMBAIT"
msgid "What coward wouldst sedate a beast?"
msgstr "Welch Feigling würde eine Bestie sedieren?"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SHROOMCAKE
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SHROOMCAKE"
msgid "A Viking would never stoop to eat such an unworthy thing."
msgstr "Ein Wikinger würde sich niemals dazu herablassen, so etwas Unwürdiges zu essen."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SHROOM_SKIN
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SHROOM_SKIN"
msgid "A trophy of our battles!"
msgstr "Eine Trophäe unsere Schlachten!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SIESTAHUT.BURNT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SIESTAHUT.BURNT"
msgid "It has been razed."
msgstr "Wurde zerstört."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SIESTAHUT.GENERIC
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SIESTAHUT.GENERIC"
msgid "A place to rest one's battle-weary head."
msgstr "Ein Ort, um den kampfesmüden Kopf auszuruhen."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SILK
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SILK"
msgid "Useful for binding, and for remembering victories past."
msgstr "Nützlich um Stoffe herzustellen und sich an vergangene Siegen zu erinnern."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SINGINGSHELL_OCTAVE3.GENERIC
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SINGINGSHELL_OCTAVE3.GENERIC"
msgid "{note}? I expected it to sound more like a war bugle."
msgstr "{note}? Ich hätte gedacht, es klingt wie ein Kriegshorn."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SINGINGSHELL_OCTAVE4.GENERIC
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SINGINGSHELL_OCTAVE4.GENERIC"
msgid "It sings a siren's song. In {note}."
msgstr "Singt ein Sirenenlied. In {note}."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SINGINGSHELL_OCTAVE5.GENERIC
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SINGINGSHELL_OCTAVE5.GENERIC"
msgid "{note}... an impressively high register for a wee sea beast."
msgstr "{note} ... Beeindruckend hohes Register für ein kleines Meerestierchen."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SISTURN.GENERIC
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SISTURN.GENERIC"
msgid "A small langhús for the ghostly warrior to regain her strength."
msgstr "Ein kleines Langhús für die Geisterkriegerin, damit sie ihre Kräfte sammle."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SISTURN.LOTS_OF_FLOWERS
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SISTURN.LOTS_OF_FLOWERS"
msgid "'Tis a fine monument indeed."
msgstr "Ein sehr schönes Denkmal."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SISTURN.LOTS_OF_FLOWERS_BLOSSOM
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SISTURN.LOTS_OF_FLOWERS_BLOSSOM"
msgid "Call'th to memory the lays of the Havfrue."
msgstr "Erinnert an die Lieder der Havfrue."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SISTURN.LOTS_OF_FLOWERS_EVIL
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SISTURN.LOTS_OF_FLOWERS_EVIL"
msgid "'Tis marring mine musings."
msgstr "Das stört mich bei meinen Überlegungen."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SISTURN.SOME_FLOWERS
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SISTURN.SOME_FLOWERS"
msgid "Flowers doth please this spirit."
msgstr "Dieser Geist mag Blumen."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SKELETON
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SKELETON"
msgid "Rest easy in Valhalla."
msgstr "Ruhe sanft in Walhalla."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SKELETONHAT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SKELETONHAT"
msgid "Immortal's sight was not meant for thee."
msgstr "Die Unsterblichen sollten das eigentlich nicht sehen."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SKELETON_NOTPLAYER
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SKELETON_NOTPLAYER"
msgid "Didst thou fall in battle, beast?"
msgstr "Fielst du im Kampf, Bestie?"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SKELETON_PLAYER.DEFAULT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SKELETON_PLAYER.DEFAULT"
msgid "%s was felled by %s. Live on in Valhalla."
msgstr "%s wurde von %s gefällt. Leb weiter in der Walhalla."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SKELETON_PLAYER.FEMALE
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SKELETON_PLAYER.FEMALE"
msgid "%s was felled by %s. She will live on in Valhalla."
msgstr "%s wurde von %s gefällt. Sie wird in der Walhalla weiterleben."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SKELETON_PLAYER.MALE
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SKELETON_PLAYER.MALE"
msgid "%s was felled by %s. He will live on in Valhalla."
msgstr "%s wurde von %s gefällt. Er wird in der Walhalla weiterleben."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SKELETON_PLAYER.ROBOT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SKELETON_PLAYER.ROBOT"
msgid "%s was felled by %s. They will live on in Valhalla."
msgstr "%s wurde von %s gefällt. Sie werden in der Walhalla weiterleben."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SKETCH
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SKETCH"
msgid "The muses' knowledge, inscribed upon an ancient scroll!"
msgstr "Das Wissen der Musen auf einer alte Schriftrolle festgehalten!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SKULLCHEST
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SKULLCHEST"
msgid "Ah, that was a good battle."
msgstr "Ach, das war ein guter Kampf."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SLEEPBOMB
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SLEEPBOMB"
msgid "Those who enter thy circle shalt know rest."
msgstr "Wer deinen Kreis betritt, soll ruhen können."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SLINGSHOT.GENERIC
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SLINGSHOT.GENERIC"
msgid "I prefer weapons at close range."
msgstr "Ich ziehe Nahkampfwaffen vor."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SLINGSHOTAMMO_CONTAINER
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SLINGSHOTAMMO_CONTAINER"
msgid "Though I prefer a blade, the lad slings with honor."
msgstr "Obwohl ich eine Klinge bevorzuge, schleudert der Junge ehrenvoll."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SLINGSHOTAMMO_DREADSTONE
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SLINGSHOTAMMO_DREADSTONE"
msgid "What fun is a battle without hand to hand combat?"
msgstr "Schlachten ohne Nahkampf, wo bleibt da der Spaß?"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SLINGSHOTAMMO_FREEZE
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SLINGSHOTAMMO_FREEZE"
msgid "What fun is a battle without hand to hand combat?"
msgstr "Schlachten ohne Nahkampf, wo bleibt da der Spaß?"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SLINGSHOTAMMO_GELBLOB
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SLINGSHOTAMMO_GELBLOB"
msgid "What fun is a battle without hand to hand combat?"
msgstr "Schlachten ohne Nahkampf, wo bleibt da der Spaß?"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SLINGSHOTAMMO_GOLD
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SLINGSHOTAMMO_GOLD"
msgid "What fun is a battle without hand to hand combat?"
msgstr "Schlachten ohne Nahkampf, wo bleibt da der Spaß?"

