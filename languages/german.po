msgstr "Lilly"

#. STRINGS.KITCOON_NAMING.NAMES.30
msgctxt "STRINGS.KITCOON_NAMING.NAMES.30"
msgid "Giles"
msgstr "Giles"

#. STRINGS.KITCOON_NAMING.NAMES.31
msgctxt "STRINGS.KITCOON_NAMING.NAMES.31"
msgid "Brisa"
msgstr "Brisa"

#. STRINGS.KITCOON_NAMING.NAMES.32
