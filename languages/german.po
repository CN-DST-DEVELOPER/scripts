msgstr "Zutaten der Zukunft, die nur darauf warten, angebaut zu werden!"

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.COSTUME_BLACKSMITH_BODY
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.COSTUME_BLACKSMITH_BODY"
msgid "It seems to be a costume for a blacksmith."
msgstr "Scheint ein Kostüm für einen Schmied zu sein."

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.COSTUME_DOLL_BODY
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.COSTUME_DOLL_BODY"
