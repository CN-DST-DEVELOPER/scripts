msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.MEATRACK.DONE_NOTMEAT"
msgid "In laboratory terms, we would call that \"dry\"."
msgstr "In Laborsprache würden wir von \"getrocknet\" reden."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.MEATRACK.DRYING
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.MEATRACK.DRYING"
