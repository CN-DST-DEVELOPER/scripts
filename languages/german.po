msgstr "Alles ist gut, was gut brennt."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.YOTC_CARRAT_GYM_SPEED.GENERIC
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.YOTC_CARRAT_GYM_SPEED.GENERIC"
msgid "What if I just set it on fire a little bit? For motivation!"
msgstr "Und wenn ich es ein bisschen in Brand setze? Zur Motivation!"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.YOTC_CARRAT_GYM_SPEED.RAT
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.YOTC_CARRAT_GYM_SPEED.RAT"
