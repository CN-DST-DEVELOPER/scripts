msgstr "Ich scheine ein oder zwei Dinge zu übersehen."

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_CANNOT_BUILD.NO_STATION
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_CANNOT_BUILD.NO_STATION"
msgid "No, no, this just won't do."
msgstr "Nein, nein, so geht das einfach nicht."

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_CANNOT_BUILD.NO_TECH
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_CANNOT_BUILD.NO_TECH"
msgid "Its making is a mystery to me."
msgstr "Seine Machart ist für mich ein Rätsel."

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_CANTBUILDHERE_YOTB_POST
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_CANTBUILDHERE_YOTB_POST"
msgid "Alas, I fear I can't build that here."
msgstr "Leider fürchte ich, dass ich das hier nicht bauen kann."

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_CANT_ESCAPE_CURSE
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_CANT_ESCAPE_CURSE"
msgid "Oh dear, I really should have known better."
msgstr "Oh weh, ich hätte es besser wissen sollen."

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_CARRAT_ERROR_FELL_ASLEEP
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_CARRAT_ERROR_FELL_ASLEEP"
msgid "Oh pardon me, does this race bore you?"
msgstr "Oh Verzeihung, langweilt dich das Rennen etwa?"

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_CARRAT_ERROR_STUNNED
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_CARRAT_ERROR_STUNNED"
msgid "Gotten cold feet? And have they frozen to the ground?"
msgstr "Kalte Füße gekriegt? Am Boden festgefroren?"

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_CARRAT_ERROR_WALKING
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_CARRAT_ERROR_WALKING"
msgid "If you don't quicken your pace, we'll lose this race!"
msgstr "Wenn du nicht hinnemachst, verlieren wir das Rennen!"

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_CARRAT_ERROR_WRONG_WAY.1
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_CARRAT_ERROR_WRONG_WAY.1"
msgid "Your route seems rather roundabout."
msgstr "Deine Route kommt mir ziemlich zufällig vor."

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_CARRAT_ERROR_WRONG_WAY.2
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_CARRAT_ERROR_WRONG_WAY.2"
msgid "The path to victory is the other way, my friend!"
msgstr "Zum Sieg geht es da lang, mein Freund!"

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_CARRAT_START_RACE
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_CARRAT_START_RACE"
msgid "Let the race begin, I'm sure to win!"
msgstr "Möge das Rennen beginnen! Ich gewinne bestimmt!"

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_CAVEIN
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_CAVEIN"
msgid "I'd best hop on out of here!"
msgstr "Ich springe am besten hier raus!"

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_CHAIR_ON_FIRE
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_CHAIR_ON_FIRE"
msgid "This is fine."
msgstr "Das ist in Ordnung."

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_CHARLIE
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_CHARLIE"
msgid "What manner of imp was that??"
msgstr "Was für ein Kobold war das??"

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_CHARLIESAVE.1
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_CHARLIESAVE.1"
msgid "only_used_by_winona"
msgstr "only_used_by_winona"

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_CHARLIE_ATTACK
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_CHARLIE_ATTACK"
msgid "OWIE-HEE-HEE!"
msgstr "OHOOHOOHOO!"

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_COACH.1
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_COACH.1"
msgid "only_used_by_wolfgang"
msgstr "only_used_by_wolfgang"

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_COACH.2
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_COACH.2"
msgid "only_used_by_wolfgang"
msgstr "only_used_by_wolfgang"

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_COACH.3
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_COACH.3"
msgid "only_used_by_wolfgang"
msgstr "only_used_by_wolfgang"

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_COACH.4
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_COACH.4"
msgid "only_used_by_wolfgang"
msgstr "only_used_by_wolfgang"

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_COACH.5
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_COACH.5"
msgid "only_used_by_wolfgang"
msgstr "only_used_by_wolfgang"

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_COACH.6
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_COACH.6"
msgid "only_used_by_wolfgang"
msgstr "only_used_by_wolfgang"

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_COACH.7
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_COACH.7"
msgid "only_used_by_wolfgang"
msgstr "only_used_by_wolfgang"

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_COACH.8
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_COACH.8"
msgid "only_used_by_wolfgang"
msgstr "only_used_by_wolfgang"

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_COACH.9
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_COACH.9"
msgid "only_used_by_wolfgang"
msgstr "only_used_by_wolfgang"

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_COLD
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_COLD"
msgid "It's finally frozen over!"
msgstr "Endlich zugefroren!"

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_COMPASS_OUT
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_COMPASS_OUT"
msgid "My compass has pass-ed out!"
msgstr "Mein Kompass ist ausgefallen!"

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_COZY_SLEEP
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_COZY_SLEEP"
msgid "This imp feels best after a cozy rest."
msgstr "Was dieser Kobold alles macht für eine geruhsame Nacht."

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_CRAFTING_FAIL
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_CRAFTING_FAIL"
msgid "My hands are truly cursed."
msgstr "Meine Hände sind wirklich verflucht."

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_DAMP
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_DAMP"
msgid "The world is giving me a shower!"
msgstr "Die Welt will mich duschen!"

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_DEERCLOPS
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_DEERCLOPS"
msgid "A massive brute is en route!"
msgstr "Da ist ein gigantischer Schläger unterwegs!"

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_DESPAWN
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_DESPAWN"
msgid "Hyuyu, fare thee well!"
msgstr "Hui, auf Wiedersehen!"

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_DETACH_BUFF_ATTACK
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_DETACH_BUFF_ATTACK"
msgid "It was all just a prank!"
msgstr "Es war alles nur ein Scherz!"

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_DETACH_BUFF_ELECTRICATTACK
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_DETACH_BUFF_ELECTRICATTACK"
msgid "I think I gave them quite a shock! Hyuyu!"
msgstr "Ich glaube, ich bin schockierend! Hui!"

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_DETACH_BUFF_MOISTUREIMMUNITY
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_DETACH_BUFF_MOISTUREIMMUNITY"
msgid "Alas and alack, the dampness is back."
msgstr "Ach, da ist die Feuchtigkeit wieder."

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_DETACH_BUFF_PLAYERABSORPTION
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_DETACH_BUFF_PLAYERABSORPTION"
msgid "That was fun, let's do it again!"
msgstr "Das war lustig, noch mal!"

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_DETACH_BUFF_SLEEPRESISTANCE
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_DETACH_BUFF_SLEEPRESISTANCE"
msgid "Maybe I could do with a wink or two..."
msgstr "Ein Blinzler oder zwei wären nicht schlecht ..."

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_DETACH_BUFF_WORKEFFECTIVENESS
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_DETACH_BUFF_WORKEFFECTIVENESS"
msgid "All work and no play doesn't suit an imp. Hyuyu!"
msgstr "Nur arbeiten und nie spielen, das ist nichts für einen Kobold. Hui!"

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_DIG_DISEASE_WARNING
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_DIG_DISEASE_WARNING"
msgid "I've helped it!"
msgstr "Ich habe geholfen!"

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_DUSK
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_DUSK"
msgid "The night soon approaches. Hyuyu!"
msgstr "Die Nacht naht bald. O jemine!"

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_EAT.GENERIC
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_EAT.GENERIC"
msgid "Mmm! Soul free!"
msgstr "Mmm! Seelenfrei!"

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_EAT.INVALID
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_EAT.INVALID"
msgid "Not even I could eat that."
msgstr "Nicht einmal ich könnte das essen."

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_EAT.PAINFUL
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_EAT.PAINFUL"
msgid "Ouch! Hyuyu!"
msgstr "Autsch! O jemine!"

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_EAT.SPOILED
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_EAT.SPOILED"
msgid "Blech! At least souls never spoil."
msgstr "Igitt! Seelen verderben wenigstens nicht."

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_EAT.STALE
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_EAT.STALE"
msgid "How unpleasant!"
msgstr "Wie unangenehm!"

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_EAT.YUCKY
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_EAT.YUCKY"
msgid "I'd rather eat my own tail!"
msgstr "Da ess ich lieber meinen eigenen Schwanz!"

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_EATING_NOT_FEASTING
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_EATING_NOT_FEASTING"
msgid "I'm not going to eat it, might as well give it to the mortals."
msgstr "Ich esse das nicht. Sollen sich die Sterblichen dazuhalten."

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_ELIXIR_BOOSTED
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_ELIXIR_BOOSTED"
msgid "I feel like a new imp!"
msgstr "Ich fühle mich wie ein neuer Kobold!"

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_ELIXIR_GHOSTVISION
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_ELIXIR_GHOSTVISION"
msgid "See like the dead, they said."
msgstr "Sehen wie die Toten, hat man mir angeboten."

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_ELIXIR_PLAYER_SPEED
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_ELIXIR_PLAYER_SPEED"
msgid "I have the strength of ten imps!"
msgstr "Ich habe die Stärke von zehn Kobolden!"

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_ELIXIR_TOO_SUPER
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_ELIXIR_TOO_SUPER"
msgid "Don't think I can take that drink!"
msgstr "Denke nicht, darauf bin ich nicht erpicht."

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_ENCUMBERED.1
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_ENCUMBERED.1"
msgid "Huff... puff..."
msgstr "Pfff ... uff ..."

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_ENCUMBERED.2
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_ENCUMBERED.2"
msgid "Hoof..."
msgstr "Ufff ..."

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_ENCUMBERED.3
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_ENCUMBERED.3"
msgid "What... a terrible burden..."
msgstr "Was für ... eine Last ..."

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_ENCUMBERED.4
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_ENCUMBERED.4"
msgid "Hyu... yu... yu...."
msgstr "Hui ... ui ... ui ..."

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_ENCUMBERED.5
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_ENCUMBERED.5"
msgid "Hff!"
msgstr "Pfff!"

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_ENCUMBERED.6
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_ENCUMBERED.6"
msgid "Imps were not... made for this!"
msgstr "Kobolde wurden nicht für ... sow as geschaffen!"

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_ENCUMBERED.7
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_ENCUMBERED.7"
msgid "Puff... huff..."
msgstr "Pfff ... uff ..."

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_ENCUMBERED.8
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_ENCUMBERED.8"
msgid "I cannot... go on!"
msgstr "Ich ... kann nicht mehr!"

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_ENCUMBERED.9
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_ENCUMBERED.9"
msgid "What... a weight... to bear!"
msgstr "Was für ... eine Last!"

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_ENGINEERING_CAN_DOWNGRADE
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_ENGINEERING_CAN_DOWNGRADE"
msgid "only_used_by_winona"
msgstr "only_used_by_winona"

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_ENGINEERING_CAN_SIDEGRADE
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_ENGINEERING_CAN_SIDEGRADE"
msgid "only_used_by_winona"
msgstr "only_used_by_winona"

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_ENGINEERING_CAN_UPGRADE
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_ENGINEERING_CAN_UPGRADE"
msgid "only_used_by_winona"
msgstr "only_used_by_winona"

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_ENTER_DARK
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_ENTER_DARK"
msgid "I've been banished to the darkness plane!"
msgstr "Ich wurde auf die dunkle Ebene verbannt!"

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_ENTER_LIGHT
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_ENTER_LIGHT"
msgid "I return to this plane of existence!"
msgstr "Ich kehre in diese Ebene der Existenz zurück!"

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_EXIT_GELBLOB
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_EXIT_GELBLOB"
msgid "I could've died inside!"
msgstr "Ich hätte innerlich sterben können!"

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_EYEOFTERROR_ARRIVE
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_EYEOFTERROR_ARRIVE"
msgid "I don't suppose this is a friendly visit? Hyuyu..."
msgstr "Ich nehme nicht an, dass dies ein Freundschaftsbesuch ist? Hyuyu ..."

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_EYEOFTERROR_FLYAWAY
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_EYEOFTERROR_FLYAWAY"
msgid "The light of day keeps the eye at bay!"
msgstr "Das Licht des Tages hält das Auge in Schach!"

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_EYEOFTERROR_FLYBACK
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_EYEOFTERROR_FLYBACK"
msgid "Hyuyu, back for more fun?"
msgstr "Hyuyu, zurück für mehr Spaß?"

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_FAN_OUT
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_FAN_OUT"
msgid "I've lost a fan!"
msgstr "Ein Ventilator ist weg!"

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_FERTILIZER_RESEARCHED
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_FERTILIZER_RESEARCHED"
msgid "I'm getting the scoop on this gardening goop."
msgstr "Ich erfahre gerade, was es mit dem Gartenmatsch auf sich hat."

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_FIRENETTLE_TOXIN.1
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_FIRENETTLE_TOXIN.1"
msgid "Such nasty nettles!"
msgstr "Was für fiese Nesseln!"

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_FIRENETTLE_TOXIN.2
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_FIRENETTLE_TOXIN.2"
msgid "Ouch! There wasn't any silver in those nettles, was there?"
msgstr "Autsch! Da war doch kein Silber in den Nesseln, oder?"

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_FIRENETTLE_TOXIN_DONE
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_FIRENETTLE_TOXIN_DONE"
msgid "It seems I've beat the heat!"
msgstr "Es scheint, dass ich die Hitze besiegt habe!"

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_FLARE_SEEN
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_FLARE_SEEN"
msgid "One of my friends is inviting me to play!"
msgstr "Ein Freund lädt mich zum Spielen ein!"

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_FLOATER_HELD
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_FLOATER_HELD"
msgid "Wet fur? What for?"
msgstr "Auf dem Trockenen bleiben und nasses Fell vermeiden."

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_FLOATER_LETGO
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_FLOATER_LETGO"
msgid "No time to rhy-"
msgstr "Wie gemein, keine Zeit für einen Re-"

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_FLOAT_SWIM_TIRED
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_FLOAT_SWIM_TIRED"
msgid "I need a while after swimming a mile!"
msgstr "Mit dem Schwimmen kann ich mich gut trimmen."

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_FOODMEMORY
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_FOODMEMORY"
msgid "only_used_by_warly"
msgstr "only_used_by_warly"

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_FREEDOM
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_FREEDOM"
msgid "I am unbound!"
msgstr "Ich bin ungebunden!"

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_GATHER_MERM
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_GATHER_MERM"
msgid "only_used_by_wurt"
msgstr "only_used_by_wurt"

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_GHOSTDRAIN
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_GHOSTDRAIN"
msgid "Ghosts play... strange games..."
msgstr "Geister spielen ... seltsame Spiele ..."

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_GHOST_QUEST
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_GHOST_QUEST"
msgid "only_used_by_wendy"
msgstr "only_used_by_wendy"

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_GOT_DECON_MISTED
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_GOT_DECON_MISTED"
msgid "Refreshing!"
msgstr "Erfrischend!"

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_HEALINGSALVE_ACIDBUFF_DONE
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_HEALINGSALVE_ACIDBUFF_DONE"
msgid "Oh what a pain, I'm not safe from acid rain!"
msgstr "Oh, welch Schmerzen, der Säureregen versucht, mich auszumerzen!"

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_HEALINGSALVE_FUMAROLEBUFF_DONE
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_HEALINGSALVE_FUMAROLEBUFF_DONE"
msgid "My resistance to fire has just expired."
msgstr "Das ganze Feuer ist mir nun nicht mehr so geheuer."

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_HERMITCRAB_SHELL_ARRIVE
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_HERMITCRAB_SHELL_ARRIVE"
msgid "No big deal, for real."
msgstr "Keine große Sache, wirklich."

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_HERMITCRAB_SHELL_BADTELEPORTPOINT
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_HERMITCRAB_SHELL_BADTELEPORTPOINT"
msgid "Still here, I fear!"
msgstr "Das geht nicht klar, ich bin immer noch da!"

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_HIGHRESEARCH
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_HIGHRESEARCH"
msgid "My brain's grown three sizes this day!"
msgstr "Mein Gehirn ist heute drei Mal größer geworden!"

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_HOT
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_HOT"
msgid "Hot, hot, hot!"
msgstr "Heiß, heiß, heiß!"

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_HOUNDS
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_HOUNDS"
msgid "The beasts are baying!"
msgstr "Die Bestien bellen!"

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_HUNGRY
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_HUNGRY"
msgid "Oh no, I'm hungry again."
msgstr "Oh nein, ich bin schon wieder hungrig."

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_HUNT_AVOID_FORK
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_HUNT_AVOID_FORK"
msgid "A trail for the tenderfooted."
msgstr "Ein Pfad für die Leichtfüßigen."

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_HUNT_BEAST_NEARBY
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_HUNT_BEAST_NEARBY"
msgid "I love a game of hide and seek!"
msgstr "Ich spiele gerne Verstecken!"

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_HUNT_LOST_TRAIL
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_HUNT_LOST_TRAIL"
msgid "You win this round!"
msgstr "Du hast diese Runde gewonnen!"

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_HUNT_LOST_TRAIL_SPRING
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_HUNT_LOST_TRAIL_SPRING"
msgid "Sabotaged by this realm's mushiness."
msgstr "Sabotiert von der Weichlichkeit dieses Reiches."

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_HUNT_START_FORK
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_HUNT_START_FORK"
msgid "The game is afoot! Or rather, a claw! Hyuyu!"
msgstr "Das Spiel folgt auf dem Fuße! Oder eher auf der Kralle! Hui!"

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_HUNT_SUCCESSFUL_FORK
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_HUNT_SUCCESSFUL_FORK"
msgid "Aha! Advantage goes to the imp."
msgstr "Aha! Der Vorteil ist beim Kobold."

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_HUNT_WRONG_FORK
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_HUNT_WRONG_FORK"
msgid "My impish senses are tingling - something watches!"
msgstr "Mein Koboldsinn kribbelt - etwas beobachtet mich!"

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_INSUFFICIENTFERTILIZER
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_INSUFFICIENTFERTILIZER"
msgid "It needs some plant food."
msgstr "Braucht etwas Dünger."

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_INV_FULL
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_INV_FULL"
msgid "I only have two paws."
msgstr "Ich habe nur zwei Pfoten."

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_IS_FEASTING
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_IS_FEASTING"
msgid "A fancy feast... or a fancied feast? Hyuyu!"
msgstr "Ein schickes Fest ... und so beliebt! Hui!"

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_KITCOON_FOUND_IN_THE_WILD
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_KITCOON_FOUND_IN_THE_WILD"
msgid "And what are you doing over here?"
msgstr "Und was machst du hier?"

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_KITCOON_HIDANDSEEK_FOUND.1
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_KITCOON_HIDANDSEEK_FOUND.1"
msgid "I found a cat, but no fiddle, hyuyu!"
msgstr "Ich habe eine Katze gefunden, aber keine Fiedel, hyuyu!"

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_KITCOON_HIDANDSEEK_FOUND.2
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_KITCOON_HIDANDSEEK_FOUND.2"
msgid "The cat's out of the bag, hyuyu!"
msgstr "Die Katze ist aus dem Sack, hyuyu!"

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_KITCOON_HIDANDSEEK_FOUND.3
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_KITCOON_HIDANDSEEK_FOUND.3"
msgid "Your tail's a tattletale!"
msgstr "Dein Schwanz ist eine Petze!"

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_KITCOON_HIDANDSEEK_FOUND.4
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_KITCOON_HIDANDSEEK_FOUND.4"
msgid "Always at the last place I would look!"
msgstr "Immer dort, wo ich am wenigsten suchen würde!"

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_KITCOON_HIDANDSEEK_FOUND_LAST_ONE
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_KITCOON_HIDANDSEEK_FOUND_LAST_ONE"
msgid "Smile from ear to ear, the cats are all here!"
msgstr "Lächle breit von Ohr zu Ohr, die Katzen sind alle an einem Ort!"

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_KITCOON_HIDANDSEEK_FOUND_LAST_ONE_TEAM
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_KITCOON_HIDANDSEEK_FOUND_LAST_ONE_TEAM"
msgid "I found, we found, the cats all around!"
msgstr "Ich finde, wir finden, Katzen vorn und hinten!"

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_KITCOON_HIDANDSEEK_FOUND_ONE_MORE
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_KITCOON_HIDANDSEEK_FOUND_ONE_MORE"
msgid "The last one better hide with all their might, hyuyu!"
msgstr "Die letzten verstecken ... sich in Winkeln und in Ecken, hyuyu!"

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_KITCOON_HIDANDSEEK_LOSEGAME
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_KITCOON_HIDANDSEEK_LOSEGAME"
msgid "I'll have to note down those hiding spots, hyuyu."
msgstr "Ich muss mir diese Verstecke notieren, hyuyu."

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_KITCOON_HIDANDSEEK_TIME_ALMOST_UP
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_KITCOON_HIDANDSEEK_TIME_ALMOST_UP"
msgid "I'm late! I'm late! I'll lose at this rate."
msgstr "Ich bin spät dran! Ich bin spät dran! Ich verliere, ich halt mich besser ran!"

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_KITCOON_HIDANDSEEK_TOOFAR
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_KITCOON_HIDANDSEEK_TOOFAR"
msgid "No furry mortal would hide far far away!"
msgstr "Kein pelziger Sterblicher würde sich weit weg verstecken!"

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_KITCOON_HIDANDSEEK_TOOFAR_RETURN
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_KITCOON_HIDANDSEEK_TOOFAR_RETURN"
msgid "Back to the guessing game, hyuyu."
msgstr "Zurück zum Ratespiel, hyuyu."

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_KITCOON_HIDEANDSEEK_JOIN
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_KITCOON_HIDEANDSEEK_JOIN"
msgid "Oh, what fun, I'll help find one!"
msgstr "Oh, was für ein Spaß, ich werde helfen, wir finden das!"

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_KITCOON_HIDEANDSEEK_START
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_KITCOON_HIDEANDSEEK_START"
msgid "The cats have run, the game's begun!"
msgstr "Die Katzen sind geflohen, das Spiel hat begonnen!"

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_KLAUS_CALLFORHELP
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_KLAUS_CALLFORHELP"
msgid "Well that's no fun, friend!"
msgstr "Also das ist kein Spaß, Freund!"

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_KLAUS_ENRAGE
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_KLAUS_ENRAGE"
msgid "Time to hop out of here!"
msgstr "Zeit, hier rauszuhüpfen!"

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_KLAUS_UNCHAINED
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_KLAUS_UNCHAINED"
msgid "Shall we dance?"
msgstr "Sollen wir tanzen?"

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_KNOCKEDOUT
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_KNOCKEDOUT"
msgid "Oh, good morning!"
msgstr "Oh, guten Morgen!"

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_LIGHTNING_DAMAGE_AVOIDED
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_LIGHTNING_DAMAGE_AVOIDED"
msgid "Hyuyu! Can't catch me!"
msgstr "Hui! Kriegst mich nicht!"

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_LIGHTSOUT_SHADOWHAND
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_LIGHTSOUT_SHADOWHAND"
msgid "And a hand came to snuff the flame!"
msgstr "Kam die Hand behände, machte der Fackel ein Ende."

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_LOWRESEARCH
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_LOWRESEARCH"
msgid "That wasn't very enlightening."
msgstr "Das war nicht sehr aufschlussreich."

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_LUNARGUARDIAN_INCOMING
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_LUNARGUARDIAN_INCOMING"
msgid "Ack! It's back!"
msgstr "Argh! Es ist zurück!"

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_LUNARHAIL_BIRD_CORPSES
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_LUNARHAIL_BIRD_CORPSES"
msgid "The weather was unkind to those of the feather."
msgstr "War das Wetter weder gut zu mir noch zur Feder."

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_LUNARHAIL_BIRD_SOUNDS
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_LUNARHAIL_BIRD_SOUNDS"
msgid "If you're flying, you're dying! Hyuyu!"
msgstr "Willst du fliegen, werden sie obsiegen! Hui!"

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_LUNAR_RIFT_MAX
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_LUNAR_RIFT_MAX"
msgid "That odd moonlight has caught my sight."
msgstr "Das seltsame Mondlicht strahlt mir ins Gesicht."

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_MAX_CLOCKWORKS
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_MAX_CLOCKWORKS"
msgid "Are you not allowed to join my crowd?"
msgstr "Hab ich schon zu viel für dieses Spiel?"

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_MEGA_FLARE_SEEN
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_MEGA_FLARE_SEEN"
msgid "An open invitation! Who knows what might drop by?"
msgstr "Eine offene Einladung! Wer weiß, wer vorbeikommt?"

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_MITEGLAND_DEBUFF.1
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_MITEGLAND_DEBUFF.1"
msgid "That glandular snack has me under attack!"
msgstr "Diese Drüse macht mir ganz schön zu schaffen!"

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_MITEGLAND_DEBUFF.2
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_MITEGLAND_DEBUFF.2"
msgid "My stomach feels full of fire and brimstone!"
msgstr "Mein Magen fühlt sich an, als wäre er voller Feuer und Schwefel!"

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_MITEGLAND_DEBUFF_DONE
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_MITEGLAND_DEBUFF_DONE"
msgid "The burning pain has left this plane."
msgstr "Der brennende Schmerz war kein Scherz."

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_MONKEY_CURSE_1
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_MONKEY_CURSE_1"
msgid "As curses go, it could be worse."
msgstr "In Sachen Flüche könnte es auch schlimmer sein."

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_MONKEY_CURSE_CHANGE
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_MONKEY_CURSE_CHANGE"
msgid "Hyuyu you've made a monkey out of me!"
msgstr "Hui, du hast einen Affen aus mir gemacht!"

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_MONKEY_CURSE_CHANGEBACK
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_MONKEY_CURSE_CHANGEBACK"
msgid "All's well that ends spells."
msgstr "Zauber weg, alles gut."

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_MOONALTAR_MINE.GLASS_LOW
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_MOONALTAR_MINE.GLASS_LOW"
msgid "Yoo-hyuyu!"
msgstr "Joo-hui!"

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_MOONALTAR_MINE.GLASS_MED
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_MOONALTAR_MINE.GLASS_MED"
msgid "Time to come out and play, okay?"
msgstr "Zeit zum Spielen, was?"

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_MOONALTAR_MINE.GLASS_REVEAL
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_MOONALTAR_MINE.GLASS_REVEAL"
msgid "Hello there!"
msgstr "Hallöchen!"

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_MOONALTAR_MINE.IDOL_LOW
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_MOONALTAR_MINE.IDOL_LOW"
msgid "Yoo-hyuyu!"
msgstr "Joo-hui!"

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_MOONALTAR_MINE.IDOL_MED
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_MOONALTAR_MINE.IDOL_MED"
msgid "Time to come out and play, okay?"
msgstr "Zeit zum Spielen, was?"

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_MOONALTAR_MINE.IDOL_REVEAL
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_MOONALTAR_MINE.IDOL_REVEAL"
msgid "Hello there!"
msgstr "Hallöchen!"

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_MOONALTAR_MINE.SEED_LOW
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_MOONALTAR_MINE.SEED_LOW"
msgid "Yoo-hyuyu!"
msgstr "Joo-hui!"

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_MOONALTAR_MINE.SEED_MED
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_MOONALTAR_MINE.SEED_MED"
msgid "Time to come out and play, okay?"
msgstr "Zeit zum Spielen, was?"

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_MOONALTAR_MINE.SEED_REVEAL
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_MOONALTAR_MINE.SEED_REVEAL"
msgid "Hello there!"
msgstr "Hallöchen!"

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_MOONPOTION_FAILED
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_MOONPOTION_FAILED"
msgid "Oh, you're no fun at all."
msgstr "Oh, das finde ich gar nicht lustig."

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_MOSQUITOS
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_MOSQUITOS"
msgid "Mosquitos! Do I even have blood??"
msgstr "Moskitos! Habe ich überhaupt Blut???"

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_MOUNT_LOWHEALTH
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_MOUNT_LOWHEALTH"
msgid "Its soul hangs by a thread."
msgstr "Seine Seele hängt an einem Faden."

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_MUTATED_BUZZARD_ARRIVAL
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_MUTATED_BUZZARD_ARRIVAL"
msgid "Mutant munchers of murdered meat!"
msgstr "Veränderte Fresser verfaulten Fleisches!"

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_NODANGERGIFT
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_NODANGERGIFT"
msgid "Presents later, playtime now!"
msgstr "Geschenke später, erst wird gespielt!"

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_NODANGERSIESTA
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_NODANGERSIESTA"
msgid "Why sleep when there's fun afoot?"
msgstr "Warum schlafen, wenn es gleich Spaß gibt?"

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_NODANGERSLEEP
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_NODANGERSLEEP"
msgid "Who could sleep when there's fun to be had?"
msgstr "Wer könnte schlafen, wenn man auch Spaß haben könnte?"

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_NODAYSLEEP
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_NODAYSLEEP"
msgid "I wouldn't want to mess up my sleep schedule."
msgstr "Ich will meinen Schlafplan nicht durcheinanderbringen."

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_NODAYSLEEP_CAVE
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_NODAYSLEEP_CAVE"
msgid "An imp must stay on guard when underground."
msgstr "Ein Kobold muss im Untergrund auf der Hut bleiben."

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_NOHUNGERSIESTA
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_NOHUNGERSIESTA"
msgid "I'm too soul-famished to siesta."
msgstr "Ich bin zu seelenhungrig für eine Siesta."

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_NOHUNGERSLEEP
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_NOHUNGERSLEEP"
msgid "I'm too soul-famished to sleep."
msgstr "Ich bin zu seelenhungrig zum Schlafen."

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_NOMOUNTEDGIFT
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_NOMOUNTEDGIFT"
msgid "I must depart this sweet beast first."
msgstr "Zuerst muss ich dieses süße Tier verlassen."

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_NONIGHTSIESTA
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_NONIGHTSIESTA"
msgid "No honorable imp would siesta at night."
msgstr "Kein ehrenwerter Kobold würde nachts Siesta machen."

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_NONIGHTSIESTA_CAVE
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_NONIGHTSIESTA_CAVE"
msgid "An imp must stay on guard when underground."
msgstr "Ein Kobold muss im Untergrund auf der Hut bleiben."

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_NOPUMPKINCARVINGONFIRE
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_NOPUMPKINCARVINGONFIRE"
msgid "I weren't done, this burnt one!"
msgstr "Ich nicht fertig, dieser verbrannt!"

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_NOSLEEPHASPERMANENTLIGHT
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_NOSLEEPHASPERMANENTLIGHT"
msgid "It's far too bright to sleep tonight."
msgstr "Es ist zu hell, um zu schlafen."

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_NOSLEEPONFIRE
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_NOSLEEPONFIRE"
msgid "I'd prefer not to singe my fur."
msgstr "Ich möchte mein Fell lieber nicht versengen."

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_NOWARDROBEONFIRE
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_NOWARDROBEONFIRE"
msgid "I'd prefer not to singe my fur."
msgstr "Ich möchte mein Fell lieber nicht versengen."

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_NO_ABIGAIL_FLOWER
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_NO_ABIGAIL_FLOWER"
msgid "only_used_by_wendy"
msgstr "only_used_by_wendy"

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_NO_TRAP
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_NO_TRAP"
msgid "Can't catch me!"
msgstr "Mich kriegt keiner!"

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_OCEANFISHING_BADCAST
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_OCEANFISHING_BADCAST"
msgid "Try and try again!"
msgstr "Immer wieder versuchen!"

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_OCEANFISHING_GOTAWAY
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_OCEANFISHING_GOTAWAY"
msgid "Hyuyu, what a slippery little fellow!"
msgstr "Hui, was für ein glitschiges Kerlchen!"

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_OCEANFISHING_IDLE_QUOTE.1
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_OCEANFISHING_IDLE_QUOTE.1"
msgid "Surely there's more fun ways to catch a fish."
msgstr "Es muss doch noch lustigere Methoden geben, Fische zu fangen."

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_OCEANFISHING_IDLE_QUOTE.2
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_OCEANFISHING_IDLE_QUOTE.2"
msgid "I'm really only interested in catching soles."
msgstr "Ich bin wirklich nur an alten Schuhen interessiert."

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_OCEANFISHING_IDLE_QUOTE.3
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_OCEANFISHING_IDLE_QUOTE.3"
msgid "I do hope a fish will fall for my prank."
msgstr "Hoffentlich fällt ein Fisch auf meine List rein."

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_OCEANFISHING_IDLE_QUOTE.4
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_OCEANFISHING_IDLE_QUOTE.4"
msgid "Perhaps they're still spawning."
msgstr "Vielleicht schlüpfen sie gerade erst."

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_OCEANFISHING_LINESNAP
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_OCEANFISHING_LINESNAP"
msgid "Well drat, I guess that's that."
msgstr "Ach Mist, das war's dann wohl."

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_OCEANFISHING_LINETOOLOOSE
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_OCEANFISHING_LINETOOLOOSE"
msgid "The line's gone slack, best reel it back!"
msgstr "Die Schnur hängt durch, ich ziehe sie besser straff!"

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_OCEAN_SILHOUETTE_INCOMING
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_OCEAN_SILHOUETTE_INCOMING"
msgid "Hyuyu, something's come to play!"
msgstr "Hui, da kommt jemand zum Spielen!"

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_OFF_SCRIPT
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_OFF_SCRIPT"
msgid "You slipped, that's not in the script! Hyuyuyu!"
msgstr "Du hast es vermasselt, das steht nicht im Drehbuch! Hyuyuyu!"

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_OTTERBOAT_DENBROKEN
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_OTTERBOAT_DENBROKEN"
msgid "I shouldn't have shattered the den, then?"
msgstr "Ich hätte wohl nicht die Höhle vernichten sollen?"

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_OTTERBOAT_OUTOFSHALLOWS
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_OTTERBOAT_OUTOFSHALLOWS"
msgid "I knew I otter keep to the shallows, hyuyu!"
msgstr "Ich wusste, dass das Boot seine Marotten hat, hui!"

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_PANFLUTE_BUFF_ACTIVE.1
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_PANFLUTE_BUFF_ACTIVE.1"
msgid "I feel the call to toot my flute! Hyuyu!"
msgstr "Ich spüre den Ruf, auf meiner Flöte zu tröten! Hui!"

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_PANFLUTE_BUFF_ACTIVE.2
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_PANFLUTE_BUFF_ACTIVE.2"
msgid "My flute's my muse, I can't refuse!"
msgstr "Die Flöte ist mein Glück, ohne sie würde ich verrückt!"

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_PANFLUTE_BUFF_USED.1
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_PANFLUTE_BUFF_USED.1"
msgid "What a hoot, to play my flute!"
msgstr "Voll Genuss spiele ich auf der Flöte ohne Verdruss!"

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_PANFLUTE_BUFF_USED.2
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_PANFLUTE_BUFF_USED.2"
msgid "A treat that feeds the soul! Hyuyu!"
msgstr "Ein Balsam für die Seele! Hui!"

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_PECKED
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_PECKED"
msgid "But why!"
msgstr "Aber warum!"

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_PETRIFED_TREES
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_PETRIFED_TREES"
msgid "The trees are playing a funny prank!"
msgstr "Die Bäume spielen einen lustigen Streich!"

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_PICK_DISEASE_WARNING
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_PICK_DISEASE_WARNING"
msgid "Its soul has not left its body, yet still it stinks."
msgstr "Die Seele hat den Körper nicht verlassen, aber er stinkt trotzdem."

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_PIRATES_ARRIVE
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_PIRATES_ARRIVE"
msgid "Something scurvy this way comes."
msgstr "Etwas Boshaftes nähert sich."

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_PLANT_RANDOMSEED
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_PLANT_RANDOMSEED"
msgid "What will grow from this seed is a mystery, indeed!"
msgstr "Was aus diesem Samen wachsen wird, ist in der Tat ein Geheimnis!"

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_PLANT_RESEARCHED.1
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_PLANT_RESEARCHED.1"
msgid "I'm learning a lot about this plant I've got!"
msgstr "Ich lerne eine Menge über diese Pflanze, die ich habe!"

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_POCKETWATCH_PORTAL
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_POCKETWATCH_PORTAL"
msgid "It's not nearly as comfortable as my kind's way of traveling..."
msgstr "Es ist nicht annähernd so bequem wie die Art, wie meine Art zu reisen ..."

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_PREFALLINVOID
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_PREFALLINVOID"
msgid "No time to rhyme, lest we hear death's chime!"
msgstr "Keine Zeit rumzuhocken, sonst ertönen des Todes Glocken."

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_QUAKE
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_QUAKE"
msgid "Shiver and shake, that's a quake!"
msgstr "Zittern und Schütteln. Das ist ein Erdbeben!"

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_RABBITKINGHORN_BADSPAWNPOINT
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_RABBITKINGHORN_BADSPAWNPOINT"
msgid "Not quite the site."
msgstr "Gar nicht mal so hübsch."

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_RABBITKING_AGGRESSIVE
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_RABBITKING_AGGRESSIVE"
msgid "I'm serious, what approaches sounds furious!"
msgstr "Das ist keine Lüge, was da kommt ist wütend und das zur Genüge."

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_RABBITKING_LUCKY
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_RABBITKING_LUCKY"
msgid "A special rabbit! Please don't stab it!"
msgstr "Ein glücklicher Hase! Nicht nur dessen Pfote!"

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_RABBITKING_LUCKYCAUGHT
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_RABBITKING_LUCKYCAUGHT"
msgid "Got it!"
msgstr "Hab's!"

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_RABBITKING_PASSIVE
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_RABBITKING_PASSIVE"
msgid "What's that sound from underground?"
msgstr "Was ertönt da aus dem Untergrund zu dieser Stund?"

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_REPELLED
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_REPELLED"
msgid "What trickery is this!"
msgstr "Was für eine List ist das?"

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_RESEARCH
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_RESEARCH"
msgid "My mind has expanded!"
msgstr "Mein Verstand hat sich erweitert!"

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_REVIVED_FROM_CORPSE
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_REVIVED_FROM_CORPSE"
msgid "The imp returns!"
msgstr "Der Kobold kehrt zurück!"

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_REVIVED_OTHER_CORPSE
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_REVIVED_OTHER_CORPSE"
msgid "Up and at'em!"
msgstr "Auf sie mit Geschrei!"

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_REVIVING_CORPSE
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_REVIVING_CORPSE"
msgid "C'mon back, silly goose."
msgstr "Komm zurück, du alberne Gans."

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_ROYALTY.1
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_ROYALTY.1"
msgid "You humble me, royal bumble bee!"
msgstr "Ich werde nicht schummeln, königliche Hummel!"

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_ROYALTY.2
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_ROYALTY.2"
msgid "Pardon my shyness, your Highness!"
msgstr "Verzeiht meine Schüchternheit, eure Hoheit!"

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_ROYALTY.3
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_ROYALTY.3"
msgid "A crown of great renown!"
msgstr "Eine Krone so hehr, gereicht zu großer Ehr!"

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_ROYALTY_JOKER.1
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_ROYALTY_JOKER.1"
msgid "A hat for a prat! Hyuyu!"
msgstr "Wenn die Mütze dem Narren doch etwas nütze! Hui!"

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_ROYALTY_JOKER.2
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_ROYALTY_JOKER.2"
msgid "The joke's on you! Hyuyu!"
msgstr "Der Witz geht auf deine Kosten! Hui!"

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_ROYALTY_JOKER.3
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_ROYALTY_JOKER.3"
msgid "A clown of great renown!"
msgstr "Ein Clown so hehr, dem sei große Ehr!"

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_RUINS_RESET
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_RUINS_RESET"
msgid "Oh good. The monsters have returned."
msgstr "Oh, gut. Die Monster sind zurück."

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_SACREDCHEST_NO
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_SACREDCHEST_NO"
msgid "It seems my soul is too tarnished."
msgstr "Meine Seele ist wohl zu befleckt."

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_SACREDCHEST_YES
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_SACREDCHEST_YES"
msgid "I'm... worthy?"
msgstr "Ich bin ... würdig?"

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_SCRAPBOOK_FULL
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_SCRAPBOOK_FULL"
msgid "I already know everything there is to know, hyuyu!"
msgstr "Ich weiß schon alles, was es zu wissen gibt, hyuyu!"

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_SECURITY_PULSE_FOLLOWING
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_SECURITY_PULSE_FOLLOWING"
msgid "Hello, fellow who glows and follows!"
msgstr "Hallo, bist du mein glühender Verfolger?"

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_SHADOWTHRALL_STEALTH
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_SHADOWTHRALL_STEALTH"
msgid "I felt a keen blow, from an unseen foe!"
msgstr "Es traf mich jemand aus dem Schatten und ich kann nichts dagegen machen!"

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_SHADOW_RIFT_MAX
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_SHADOW_RIFT_MAX"
msgid "Calling that \"light\" wouldn't be quite right."
msgstr "Nannte man das Licht, träfe es das nicht."

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_SHELTER
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_SHELTER"
msgid "Ah, much better!"
msgstr "Ah, viel besser!"

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_SISTURN_FULL_BLOSSOM
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_SISTURN_FULL_BLOSSOM"
msgid "only_used_by_wendy"
msgstr "only_used_by_wendy"

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_SISTURN_FULL_EVIL
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_SISTURN_FULL_EVIL"
msgid "only_used_by_wendy"
msgstr "only_used_by_wendy"

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_SNARED
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_SNARED"
msgid "I've been bound!"
msgstr "Ich wurde gefesselt!"

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_SNARED_IVY
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_SNARED_IVY"
msgid "Oh ho! You think you can contain me?"
msgstr "Oh-ho! Denkst du, du kannst mich aufhalten?"

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_SNOWBALL_NO_SNOW
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_SNOWBALL_NO_SNOW"
msgid "It won't grow without more snow."
msgstr "Es muss Schnee her, dann wird er größer."

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_SNOWBALL_TOO_BIG
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_SNOWBALL_TOO_BIG"
msgid "I tell no lies! It's at full size!"
msgstr "Es ist wahr, er wird nicht größer!"

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_SOAKED
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_SOAKED"
msgid "I AM DRENCHED!"
msgstr "ICH BIN TOTAL NASS!"

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_SOUL_EMPTY.1
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_SOUL_EMPTY.1"
msgid "Woe be to a soul-starved imp!"
msgstr "Wehe, du bist ein seelenverhungerter Kobold!"

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_SOUL_EMPTY.2
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_SOUL_EMPTY.2"
msgid "I don't want to suck anymore souls!"
msgstr "Ich will keine Seelen mehr aussaugen!"

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_SOUL_EMPTY.3
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_SOUL_EMPTY.3"
msgid "What gruesome things I must do to live!"
msgstr "Was für grausame Dinge ich dich tun muss, um zu leben!"

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_SOUL_EMPTY_NAUGHTY.1
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_SOUL_EMPTY_NAUGHTY.1"
msgid "I am absolutely famished!"
msgstr "Ich bin am Verhungern!"

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_SOUL_EMPTY_NAUGHTY.2
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_SOUL_EMPTY_NAUGHTY.2"
msgid "I'm starved for some delicious souls!"
msgstr "Mich dürstet es nach ein paar köstlichen Seelen!"

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_SOUL_EMPTY_NAUGHTY.3
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_SOUL_EMPTY_NAUGHTY.3"
msgid "I yearn for those tasty treats!"
msgstr "Ich sehne mich nach diesen leckeren Leckereien!"

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_SOUL_EMPTY_NICE.1
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_SOUL_EMPTY_NICE.1"
msgid "I'm afraid I must feed soon."
msgstr "Ich befürchte, ich muss mich bald nähren."

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_SOUL_EMPTY_NICE.2
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_SOUL_EMPTY_NICE.2"
msgid "Curse my need to feed!"
msgstr "Verdammt sei mein Verlangen, mich stets zu laben!"

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_SOUL_EMPTY_NICE.3
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_SOUL_EMPTY_NICE.3"
msgid "It is tragic that they must die so that I may have life."
msgstr "Es ist eine Tragödie, dass sie für mein Leben sterben müssen."

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_SOUL_FEW.1
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_SOUL_FEW.1"
msgid "I'll need more souls soon."
msgstr "Ich werde bald mehr Seelen brauchen."

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_SOUL_FEW.2
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_SOUL_FEW.2"
msgid "I feel the soul hunger stirring."
msgstr "Ich spüre, wie der Seelenhunger kommt."

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_SOUL_FEW_NAUGHTY.1
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_SOUL_FEW_NAUGHTY.1"
msgid "My collection is running low."
msgstr "Meine Sammlung geht zur Neige."

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_SOUL_FEW_NAUGHTY.2
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_SOUL_FEW_NAUGHTY.2"
msgid "I'll need a soul snack soon."
msgstr "Ich brauche schon bald einen Seelensnack."

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_SOUL_FEW_NICE.1
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_SOUL_FEW_NICE.1"
msgid "Oh dear. Running low on souls, I fear."
msgstr "Au weh. Die Seelen gehen zur Neige, fürchte ich."

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_SOUL_FEW_NICE.2
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_SOUL_FEW_NICE.2"
msgid "I have precious few souls left."
msgstr "Ich habe nur wenige Seelen übrig."

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_SOUL_MANY.1
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_SOUL_MANY.1"
msgid "I've enough souls to sustain me."
msgstr "Ich habe genug Seelen, um eine Weile satt zu bleiben."

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_SOUL_MANY.2
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_SOUL_MANY.2"
msgid "I hope I was not too greedy."
msgstr "Ich hoffe, ich war nicht zu gierig."

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_SOUL_MANY_NAUGHTY.1
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_SOUL_MANY_NAUGHTY.1"
msgid "When is enough enough? Never! Hyuyu!"
msgstr "Was ist genug genug? Niemals! Hui!"

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_SOUL_MANY_NAUGHTY.2
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_SOUL_MANY_NAUGHTY.2"
msgid "I love a feast of souls."
msgstr "Ich liebe ein Seelenfestmahl."

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_SOUL_MANY_NICE.1
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_SOUL_MANY_NICE.1"
msgid "Oh my, I've taken so many!"
msgstr "Meine Güte, ich habe so viele genommen!"

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_SOUL_MANY_NICE.2
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_SOUL_MANY_NICE.2"
msgid "Such abundance. Many thanks!"
msgstr "Welch Überfluss. Vielen Dank!"

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_SOUL_OVERLOAD.1
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_SOUL_OVERLOAD.1"
msgid "I can't handle that much soul power!"
msgstr "Ich kann nicht mit so viel Seelenstärke umgehen!"

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_SOUL_OVERLOAD.2
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_SOUL_OVERLOAD.2"
msgid "That was one soul too many!"
msgstr "Das war eine Seele zu viel!"

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_SOUL_OVERLOAD_AVOIDED.1
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_SOUL_OVERLOAD_AVOIDED.1"
msgid "My brim is back from making a crack."
msgstr "Das war knapp eben, umsonst wären gewesen diese Leben."

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_SOUL_OVERLOAD_AVOIDED.2
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_SOUL_OVERLOAD_AVOIDED.2"
msgid "I had to stop before I popped."
msgstr "Ich musste die Expansion vor meiner Explosion stoppen."

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_SOUL_OVERLOAD_NAUGHTY.1
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_SOUL_OVERLOAD_NAUGHTY.1"
msgid "My precious souls!"
msgstr "Meine kostbaren Seelen!"

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_SOUL_OVERLOAD_NAUGHTY.2
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_SOUL_OVERLOAD_NAUGHTY.2"
msgid "Those were mine! All mine!"
msgstr "Die waren mein! Alle mein!"

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_SOUL_OVERLOAD_NICE.1
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_SOUL_OVERLOAD_NICE.1"
msgid "I was too greedy!"
msgstr "Ich war zu gierig!"

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_SOUL_OVERLOAD_NICE.2
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_SOUL_OVERLOAD_NICE.2"
msgid "Those poor souls have gone to waste!"
msgstr "Diese armen Seelen wurden verschwendet!"

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_SOUL_OVERLOAD_WARNING.1
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_SOUL_OVERLOAD_WARNING.1"
msgid "The souls are going to burst my brim!"
msgstr "Diese Seelen bringen mein Gefäß zum Überlaufen!"

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_SOUL_OVERLOAD_WARNING.2
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_SOUL_OVERLOAD_WARNING.2"
msgid "The burden of souls is certain to pop!"
msgstr "Die Last der Seelen wiegt zu schwer!"

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_SPOOKED
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_SPOOKED"
msgid "What a s-silly prank!"
msgstr "Was für ein alberner Streich!"

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_TALK_TO_PLANTS.1
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_TALK_TO_PLANTS.1"
msgid "A pleasant day to you, my good greenery!"
msgstr "Einen schönen Tag wünsche ich dir, gutes Grünzeug!"

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_TALK_TO_PLANTS.2
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_TALK_TO_PLANTS.2"
msgid "I'm so sorry, I'm afraid I'm not quite fluent in plant."
msgstr "Es tut mir so leid, ich fürchte, ich spreche die Pflanzensprache nicht fließend."

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_TALK_TO_PLANTS.3
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_TALK_TO_PLANTS.3"
msgid "How dull to spend your life stuck in the ground! Luckily I'm here to make it more exciting!"
msgstr "Wie langweilig, wenn man sein Leben unter der Erde verbringt! Zum Glück bin ich hier, um es aufregender zu gestalten!"

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_TALK_TO_PLANTS.4
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_TALK_TO_PLANTS.4"
msgid "You like hearing the sound of my voice almost as much as I do, hyuyu!"
msgstr "Du magst den Klang meiner Stimme fast so sehr wie ich, hyuyu!"

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_TALK_TO_PLANTS.5
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_TALK_TO_PLANTS.5"
msgid "Let's pull a prank! What do you think the mortals would do if you sprouted into a sheep?"
msgstr "Lass uns einen Streich spielen! Was denkst du, was die Sterblichen tun würden, wenn du dich in ein Schaf verwandelst?"

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_THORNS
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_THORNS"
msgid "It pricked me!"
msgstr "Hat mich gestochen!"

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_THURIBLE_OUT
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_THURIBLE_OUT"
msgid "Oh dear, I think our truce just expired."
msgstr "Meine Güte, ich glaube, unser Waffenstillstand ist abgelaufen."

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_TICOON_ABANDONED
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_TICOON_ABANDONED"
msgid "I did my best, now I'll rest."
msgstr "Mein bestes habe ich getan, jetz ist mal eine Pause dran."

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_TICOON_DEAD
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_TICOON_DEAD"
msgid "My guide is gone, do I carry on?"
msgstr "Mein Führer ist weg, hat Wietermachen einen Zweck?"

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_TICOON_GET_LEADER_ATTENTION
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_TICOON_GET_LEADER_ATTENTION"
msgid "Oh, is it me you're looking for?"
msgstr "Oh, suchst du etwa nach mir?"

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_TICOON_LOST_KITCOON
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_TICOON_LOST_KITCOON"
msgid "Oh me, oh my, they passed me by!"
msgstr "Oh ich, oh ich, sie sind an mir vorbeigegangen!"

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_TICOON_NEAR_KITCOON
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_TICOON_NEAR_KITCOON"
msgid "We're close, closer, yet closer!"
msgstr "Wir sind nah dran, näher, noch näher!"

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_TICOON_NOTHING_TO_TRACK
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_TICOON_NOTHING_TO_TRACK"
msgid "No tracks, no clue, I say we're through."
msgstr "Keine Spuren, keine Spur, ich sage, wir sind durch, da bin ich stur."

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_TICOON_START_TRACKING
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_TICOON_START_TRACKING"
msgid "He'll get us nowhere fast, hyuyu!"
msgstr "Er wird uns nicht weiterbringen, hyuyu!"

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_TICOON_WAITING_FOR_LEADER
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_TICOON_WAITING_FOR_LEADER"
msgid "He won't go ahead unless I keep my step, hyuyu!"
msgstr "Er bleibt stehen, wenn ich nicht mitgehe, hyuyu!"

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_TOADESCAPED
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_TOADESCAPED"
msgid "It's gone home."
msgstr "Nach Hause gegangen."

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_TOADESCAPING
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_TOADESCAPING"
msgid "Don't flee! Play with me!"
msgstr "Fliehe nicht! Spiel mit mir!"

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_TOOL_SLIP
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_TOOL_SLIP"
msgid "Whoops-a-doodle, hyuyu!"
msgstr "Aber hoppla! Huiii!"

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_TOOL_TOOWEAK
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_TOOL_TOOWEAK"
msgid "This tool is too weak for what I seek."
msgstr "Dieses Werkzeug ist zu schwach für diese Sach'."

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_TORCH_OUT
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_TORCH_OUT"
msgid "Farewell, sweet flame!"
msgstr "Lebe wohl, süße Flamme!"

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_TOWNPORTALTELEPORT
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_TOWNPORTALTELEPORT"
msgid "Never fear, the imp is here!"
msgstr "Keine Sorge, der Kobold ist da!"

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_TRAP_WENT_OFF
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_TRAP_WENT_OFF"
msgid "Oh dear, oh dear."
msgstr "Oh je, oh je."

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_UNIMPLEMENTED
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_UNIMPLEMENTED"
msgid "What on earth could it be!"
msgstr "Was um alles in der Welt könnte es sein!"

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_VAULT_SHADOW_ASSIST
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_VAULT_SHADOW_ASSIST"
msgid "Is this a dream, or a nightmare?"
msgstr "Ist das ein Traum oder ein Albtraum?"

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_VAULT_TELEPORTER_DOES_NOTHING
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_VAULT_TELEPORTER_DOES_NOTHING"
msgid "Ahem! What's the problem!"
msgstr "Ähem. Wo ist das Problem?"

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_WASHED_ASHORE
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_WASHED_ASHORE"
msgid "I escaped the threat, but now I'm wet!"
msgstr "Ich bin der Gefahr entkommen, aber jetzt bin ich nass!"

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_WEAK_RAT
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_WEAK_RAT"
msgid "Time has nearly run out for this would-be racer."
msgstr "Die Zeit ist bald um für diesen Möchtegern-Wettläufer."

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_WEAPON_TOOWEAK
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_WEAPON_TOOWEAK"
msgid "I need stronger arms to do any harms!"
msgstr "Nur ein starker Arm verursacht hier Harm."

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_WEIGHT
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_WEIGHT"
msgid "Weight: {weight}"
msgstr "Gewicht: {weight}."

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_WEIGHT_HEAVY
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_WEIGHT_HEAVY"
msgid "Weight: {weight}\nI got my wish, a hefty fish!"
msgstr "Gewicht: {weight}\nMein Wunsch wird wahr – welch' Exemplar!"

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_WENDY_BABYSITTER_SET
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_WENDY_BABYSITTER_SET"
msgid "only_used_by_wendy"
msgstr "only_used_by_wendy"

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_WENDY_BABYSITTER_STOP
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_WENDY_BABYSITTER_STOP"
msgid "only_used_by_wendy"
msgstr "only_used_by_wendy"

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_WET
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_WET"
msgid "There is wet imp smell in my future."
msgstr "In meiner Zukunft riecht es nach nassem Kobold."

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_WETTER
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_WETTER"
msgid "I am the soggiest imp!"
msgstr "Ich bin ein durchnässter Kobold!"

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_WINCH_CLAW_MISS
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_WINCH_CLAW_MISS"
msgid "I thought I'd be better at this game."
msgstr "Ich dachte, ich wäre besser bei diesem Spiel."

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_WINCH_CLAW_NO_ITEM
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_WINCH_CLAW_NO_ITEM"
msgid "It's come up with nothing."
msgstr "Es hat nichts gebracht."

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_WINTERS_FEAST_BUFF
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_WINTERS_FEAST_BUFF"
msgid "Hyuyu, how splendid!"
msgstr "Hui, wie herrlich!"

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_WINTERS_FEAST_BUFF_OVER
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_WINTERS_FEAST_BUFF_OVER"
msgid "I'll never lose the impish sparkle in my eye."
msgstr "Mein Koboldgeist lässt sich nicht unterkriegen."

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_WOLFGANG_BEGIN_COACHING
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_WOLFGANG_BEGIN_COACHING"
msgid "only_used_by_wolfang"
msgstr "only_used_by_wolfang"

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_WOLFGANG_END_COACHING
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_WOLFGANG_END_COACHING"
msgid "only_used_by_wolfang"
msgstr "only_used_by_wolfang"

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_WOLFGANG_MIGHTY_COACHING
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_WOLFGANG_MIGHTY_COACHING"
msgid "only_used_by_wolfang"
msgstr "only_used_by_wolfang"

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_WOLFGANG_NOTEAM.1
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_WOLFGANG_NOTEAM.1"
msgid "only_used_by_wolfang"
msgstr "only_used_by_wolfang"

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_WOLFGANG_NOTEAM.2
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_WOLFGANG_NOTEAM.2"
msgid "only_used_by_wolfang"
msgstr "only_used_by_wolfang"

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_WOLFGANG_NOTEAM.3
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_WOLFGANG_NOTEAM.3"
msgid "only_used_by_wolfang"
msgstr "only_used_by_wolfang"

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_WOLFGANG_WIMPY_COACHING
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_WOLFGANG_WIMPY_COACHING"
msgid "only_used_by_wolfgang"
msgstr "only_used_by_wolfgang"

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_WORMHOLE
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_WORMHOLE"
msgid "Hyuyu, how grotesque that was!"
msgstr "O jemine! Wie grotesk das war!"

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_WORMS
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_WORMS"
msgid "Something approaches from beneath!"
msgstr "Etwas nähert sich von unten!"

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_WORMS_BOSS
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_WORMS_BOSS"
msgid "Don't bumble about, upon that rumble, no doubt!"
msgstr "Ich spürte einen Stich von einem Feind ganz hinterhältig!"

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_WORTOX_REVIVER_FAILTELEPORT
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_WORTOX_REVIVER_FAILTELEPORT"
msgid "Oh dear, still here!"
msgstr "Au weh, doch keine Heilung für mein Fernweh."

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_WX_SCANNER_NEW_FOUND
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_WX_SCANNER_NEW_FOUND"
msgid "only_used_by_wx78"
msgstr "only_used_by_wx78"

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_YOTB_LEARN_NEW_PATTERN
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_YOTB_LEARN_NEW_PATTERN"
msgid "Hyuyu! A new plan has taken shape!"
msgstr "Hyuyu! Ein neuer Plan ist herangereift!"

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_YOTD_NOBOATS
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_YOTD_NOBOATS"
msgid "Me and the start are too far apart."
msgstr "Ich sollte mich an näher an die Startlinie trauen, denn uns trennt zu großer Raum."

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_YOTD_NOCHECKPOINTS
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_YOTD_NOCHECKPOINTS"
msgid "Whoopsie! I'll make a point to check first."
msgstr "Upsi! Ich muss erst einen Punkt zur Kontrolle aufstellen."

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_YOTD_NOTENOUGHBOATS
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_YOTD_NOTENOUGHBOATS"
msgid "I should make space, so someone can join the race."
msgstr "Ich sollte Platz machen, sonst passen nicht der anderen Teilnehmer Sachen."

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_YOTH_ONCOOLDOWN
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_YOTH_ONCOOLDOWN"
msgid "The knights must be busy, leaving us in a tizzy! Hyuyu!"
msgstr "Die Ritter haben zu tun. Oder wollen sie nur ruhen? Hui!"

#. STRINGS.CHARACTERS.WORTOX.ANOUNCE_MUTATED_BIRD_ATTACK
msgctxt "STRINGS.CHARACTERS.WORTOX.ANOUNCE_MUTATED_BIRD_ATTACK"
msgid "They're back, and on the attack!"
msgstr "Sie sind zurück und greifen an!"

#. STRINGS.CHARACTERS.WORTOX.BATTLECRY.DEER
msgctxt "STRINGS.CHARACTERS.WORTOX.BATTLECRY.DEER"
msgid "You look like fun, dear."
msgstr "Du siehst nach Spaß aus, Liebes."

#. STRINGS.CHARACTERS.WORTOX.BATTLECRY.GENERIC
msgctxt "STRINGS.CHARACTERS.WORTOX.BATTLECRY.GENERIC"
msgid "Let's have some fun."
msgstr "Lass uns etwas Spaß haben."

#. STRINGS.CHARACTERS.WORTOX.BATTLECRY.PIG
msgctxt "STRINGS.CHARACTERS.WORTOX.BATTLECRY.PIG"
msgid "Dance with me, piggy pig!"
msgstr "Tanz mit mir, Schweinchen!"

#. STRINGS.CHARACTERS.WORTOX.BATTLECRY.PREY
msgctxt "STRINGS.CHARACTERS.WORTOX.BATTLECRY.PREY"
msgid "I want to play!"
msgstr "Ich will spielen!"

#. STRINGS.CHARACTERS.WORTOX.BATTLECRY.SPIDER
msgctxt "STRINGS.CHARACTERS.WORTOX.BATTLECRY.SPIDER"
msgid "Let's play, let's play!"
msgstr "Lass uns spielen, lass uns spielen!"

#. STRINGS.CHARACTERS.WORTOX.BATTLECRY.SPIDER_WARRIOR
msgctxt "STRINGS.CHARACTERS.WORTOX.BATTLECRY.SPIDER_WARRIOR"
msgid "Do you dance?"
msgstr "Tanzt du?"

#. STRINGS.CHARACTERS.WORTOX.COMBAT_QUIT.GENERIC
msgctxt "STRINGS.CHARACTERS.WORTOX.COMBAT_QUIT.GENERIC"
msgid "I am the wimp imp!"
msgstr "Ich bin der schwache Kobold!"

#. STRINGS.CHARACTERS.WORTOX.COMBAT_QUIT.PIG
msgctxt "STRINGS.CHARACTERS.WORTOX.COMBAT_QUIT.PIG"
msgid "Never mind, I've forgotten my dancing shoes."
msgstr "Vergiss es, ich habe meine Tanzschuhe vergessen."

#. STRINGS.CHARACTERS.WORTOX.COMBAT_QUIT.PREY
msgctxt "STRINGS.CHARACTERS.WORTOX.COMBAT_QUIT.PREY"
msgid "You no longer entertain me."
msgstr "Du machst mir keinen Spaß mehr."

#. STRINGS.CHARACTERS.WORTOX.COMBAT_QUIT.SPIDER
msgctxt "STRINGS.CHARACTERS.WORTOX.COMBAT_QUIT.SPIDER"
msgid "I am the wimp imp!"
msgstr "Ich bin der schwache Kobold!"

#. STRINGS.CHARACTERS.WORTOX.COMBAT_QUIT.SPIDER_WARRIOR
msgctxt "STRINGS.CHARACTERS.WORTOX.COMBAT_QUIT.SPIDER_WARRIOR"
msgid "I'll take my leave. Hyuyu!"
msgstr "Ich gehe jetzt. Hui!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.ABIGAIL.LEVEL1.1
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.ABIGAIL.LEVEL1.1"
msgid "Poor soul."
msgstr "Arme Seele."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.ABIGAIL.LEVEL1.2
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.ABIGAIL.LEVEL1.2"
msgid "Poor soul."
msgstr "Arme Seele."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.ABIGAIL.LEVEL2.1
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.ABIGAIL.LEVEL2.1"
msgid "Poor soul."
msgstr "Arme Seele."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.ABIGAIL.LEVEL2.2
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.ABIGAIL.LEVEL2.2"
msgid "Poor soul."
msgstr "Arme Seele."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.ABIGAIL.LEVEL3.1
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.ABIGAIL.LEVEL3.1"
msgid "Poor soul."
msgstr "Arme Seele."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.ABIGAIL.LEVEL3.2
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.ABIGAIL.LEVEL3.2"
msgid "Poor soul."
msgstr "Arme Seele."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.ABIGAIL_FLOWER.GENERIC
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.ABIGAIL_FLOWER.GENERIC"
msgid "I think it eats souls, too."
msgstr "Ich glaube, es frisst auch Seelen."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.ABIGAIL_FLOWER.HAUNTED_GROUND
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.ABIGAIL_FLOWER.HAUNTED_GROUND"
msgid "Ohh, you're hungry too."
msgstr "Ohh, du hast auch Hunger."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.ABIGAIL_FLOWER.HAUNTED_POCKET
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.ABIGAIL_FLOWER.HAUNTED_POCKET"
msgid "Sadly, it is not mine to keep."
msgstr "Leider darf ich das nicht behalten."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.ABIGAIL_FLOWER.LEVEL1
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.ABIGAIL_FLOWER.LEVEL1"
msgid "No need to hide from me... tasty as you might be."
msgstr "Du brauchst dich nicht vor mir zu verstecken ... lecker oder nicht."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.ABIGAIL_FLOWER.LEVEL2
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.ABIGAIL_FLOWER.LEVEL2"
msgid "How are you doing in there?"
msgstr "Wie geht es dir da drinnen?"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.ABIGAIL_FLOWER.LEVEL3
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.ABIGAIL_FLOWER.LEVEL3"
msgid "My, you're looking spirited! Hyuyu!"
msgstr "Meine Güte, du siehst aber begeistert aus! Hui!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.ABIGAIL_FLOWER.LONG
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.ABIGAIL_FLOWER.LONG"
msgid "It's very sad. Full of regrets."
msgstr "Sehr traurig. Voller Reue."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.ABIGAIL_FLOWER.MEDIUM
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.ABIGAIL_FLOWER.MEDIUM"
msgid "Waking up, are we?"
msgstr "Wir wachen auf, oder?"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.ABIGAIL_FLOWER.SOON
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.ABIGAIL_FLOWER.SOON"
msgid "It seems the fun will soon begin."
msgstr "Es scheint, dass der Spaß bald beginnen wird."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.ABYSSPILLAR_MINION.ACTIVATED
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.ABYSSPILLAR_MINION.ACTIVATED"
msgid "At least it waits its turn, but what's the pattern to discern?"
msgstr "Wenigstens wird sie warten, das spielt mir in die Karten."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.ABYSSPILLAR_MINION.GENERIC
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.ABYSSPILLAR_MINION.GENERIC"
msgid "How do you do, statue?"
msgstr "Und was machst du? Statue?"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.ABYSSPILLAR_TRIAL
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.ABYSSPILLAR_TRIAL"
msgid "A clever little lever!"
msgstr "Was kann ich damit aushebeln?"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.ACCOMPLISHMENT_SHRINE
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.ACCOMPLISHMENT_SHRINE"
msgid "I did indeed do that!"
msgstr "Das habe ich in der Tat getan!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.ACORN
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.ACORN"
msgid "It's nutty, like me!"
msgstr "Verrückt, wie ich!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.ACORN_COOKED
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.ACORN_COOKED"
msgid "I'll only eat it if I have to."
msgstr "Ich werde es nur essen, wenn es sein muss."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.ACORN_SAPLING
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.ACORN_SAPLING"
msgid "You know how to grow!"
msgstr "Du weißt, wie man wächst!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.ADVENTURE_PORTAL
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.ADVENTURE_PORTAL"
msgid "I want to play a game with you!"
msgstr "Ich möchte ein Spiel mit dir spielen!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.ALTERGUARDIANHAT
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.ALTERGUARDIANHAT"
msgid "It tells me the most delicious secrets, hyuyu!"
msgstr "Sie verrät mir die köstlichsten Geheimnisse, hyuyu!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.ALTERGUARDIANHATSHARD
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.ALTERGUARDIANHATSHARD"
msgid "It won't be too hard to find a use for this shard."
msgstr "Es wird nicht allzu schwer sein, eine Verwendung für diesen Splitter zu finden."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.ALTERGUARDIAN_CONTAINED
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.ALTERGUARDIAN_CONTAINED"
msgid "Oh ho! It seems he has some tricks up his sleeve."
msgstr "Oh ho! Es scheint, als hätte er ein paar Tricks im Ärmel."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.ALTERGUARDIAN_PHASE1.DEAD
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.ALTERGUARDIAN_PHASE1.DEAD"
msgid "Send my regards to your master!"
msgstr "Meine Empfehlung an deinen Meister!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.ALTERGUARDIAN_PHASE1.GENERIC
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.ALTERGUARDIAN_PHASE1.GENERIC"
msgid "We got off to a rocky start, didn't we? Hyuyu!"
msgstr "Wir hatten einen holprigen Start, nicht wahr? Hyuyu!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.ALTERGUARDIAN_PHASE1_LUNARRIFT
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.ALTERGUARDIAN_PHASE1_LUNARRIFT"
msgid "What's it growing? Why's it glowing?"
msgstr "Wächst es heran? Warum ist die Leuchte an?"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.ALTERGUARDIAN_PHASE1_LUNARRIFT_GESTALT
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.ALTERGUARDIAN_PHASE1_LUNARRIFT_GESTALT"
msgid "We fought it, and we got it!"
msgstr "Wir haben gesiegt und das Ding erlegt!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.ALTERGUARDIAN_PHASE2.DEAD
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.ALTERGUARDIAN_PHASE2.DEAD"
msgid "Now with any luck it kicked the bucket."
msgstr "Mit etwas Glück hat das Ding jetzt den Geist aufgegeben."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.ALTERGUARDIAN_PHASE2.GENERIC
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.ALTERGUARDIAN_PHASE2.GENERIC"
msgid "Hoohoo! It seems there's more in store!"
msgstr "Huhu! Es scheint, als ob wir noch mehr auf Lager haben!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.ALTERGUARDIAN_PHASE2SPIKE
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.ALTERGUARDIAN_PHASE2SPIKE"
msgid "This imp will not be contained so easily."
msgstr "So leicht lässt sich dieser Kobold nicht fangen."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.ALTERGUARDIAN_PHASE3
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.ALTERGUARDIAN_PHASE3"
msgid "The time is right to end this fight!"
msgstr "Die Zeit ist reif, den Kampf zu beenden!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.ALTERGUARDIAN_PHASE3DEAD
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.ALTERGUARDIAN_PHASE3DEAD"
msgid "Shall we see what's left behind?"
msgstr "Sollen wir nachsehen, was übrig geblieben ist?"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.ALTERGUARDIAN_PHASE3DEADORB
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.ALTERGUARDIAN_PHASE3DEADORB"
msgid "Energy, but no soul to snack on. A pity."
msgstr "Energie, aber keine Seele zum Naschen. Schade."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.ALTERGUARDIAN_PHASE3TRAP
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.ALTERGUARDIAN_PHASE3TRAP"
msgid "Hoohoo, this imp knows a trick when he sees one."
msgstr "Huhu, dieser Kobold erkennt einen Trick, wenn er einen sieht."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.ALTERGUARDIAN_PHASE4_LUNARRIFT
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.ALTERGUARDIAN_PHASE4_LUNARRIFT"
msgid "You atrocity of a monstrosity!"
msgstr "Das ist mal ein monströses Scheusal!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.AMULET
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.AMULET"
msgid "A glimmering jewel that's rife with life."
msgstr "Ein schimmerndes Juwel, das vom Leben erfüllt ist."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.ANCHOR
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.ANCHOR"
msgid "Drop it to stop it."
msgstr "Einfach fallenlassen."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.ANCHOR_ITEM
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.ANCHOR_ITEM"
msgid "Such funny ship things I could build."
msgstr "Lustige Schiffsdinge, die ich bauen könnte."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.ANCIENTFRUIT_GEM
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.ANCIENTFRUIT_GEM"
msgid "Don't try to eat it, better to heat it!"
msgstr "Versuch's nicht so zu essen, sonst kannst du deine Zähne vergessen!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.ANCIENTFRUIT_NIGHTVISION
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.ANCIENTFRUIT_NIGHTVISION"
msgid "Just one bite to help my sight at night."
msgstr "Wenn ich nur einmal dran Nag' wird direkt die Nacht zum Tag."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.ANCIENTFRUIT_NIGHTVISION_COOKED
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.ANCIENTFRUIT_NIGHTVISION_COOKED"
msgid "I miss the wriggle, it made me giggle."
msgstr "Ich vermisse das Schlängeln, es war zum Kringeln."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.ANCIENTTREE_GEM.GENERIC
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.ANCIENTTREE_GEM.GENERIC"
msgid "The tree furnace burns in earnest."
msgstr "Der Baumofen brennt ja im Ernst."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.ANCIENTTREE_GEM.STUMP
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.ANCIENTTREE_GEM.STUMP"
msgid "Once a tree, now debris."
msgstr "Einst ein Baum, nun vergangener Traum."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.ANCIENTTREE_NIGHTVISION.GENERIC
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.ANCIENTTREE_NIGHTVISION.GENERIC"
msgid "Is it so scary for a tree to be hairy?"
msgstr "Ist es so gruselig, wenn der Baum ist haarig?"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.ANCIENTTREE_NIGHTVISION.STUMP
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.ANCIENTTREE_NIGHTVISION.STUMP"
msgid "It's leafy life was cut short."
msgstr "Sein blättriges Leben schnitt nicht so gut ab."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.ANCIENTTREE_SAPLING.GENERIC
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.ANCIENTTREE_SAPLING.GENERIC"
msgid "Not to get sappy, I'm glad it's happy."
msgstr "Mit viel Harz und vor allem Herz."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.ANCIENTTREE_SAPLING.WRONG_SEASON
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.ANCIENTTREE_SAPLING.WRONG_SEASON"
msgid "What now? Oh, not now."
msgstr "Was jetzt? Oh, nicht jetzt."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.ANCIENTTREE_SAPLING.WRONG_TILE
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.ANCIENTTREE_SAPLING.WRONG_TILE"
msgid "Not the picky plant's preferred placement?"
msgstr "Gefällt unserem wählerischen Pflänzchen wohl nicht?"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.ANCIENTTREE_SAPLING_ITEM
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.ANCIENTTREE_SAPLING_ITEM"
msgid "It's tricky with a tree so picky."
msgstr "Es ist kompliziert, ist der Baum so borniert."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.ANCIENTTREE_SEED
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.ANCIENTTREE_SEED"
msgid "I see a seed to sow, hyuyu!"
msgstr "Ich sehe einen Samen zum Säen, hui!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.ANCIENT_ALTAR
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.ANCIENT_ALTAR"
msgid "A fun place to do some naughty magic."
msgstr "Ein guter Ort für etwas unanständige Magie."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.ANCIENT_ALTAR_BROKEN
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.ANCIENT_ALTAR_BROKEN"
msgid "Oh dear oh dear, that will not do."
msgstr "O jemine! So geht das nicht."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.ANCIENT_HUSK
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.ANCIENT_HUSK"
msgid "Oh my, how they died!"
msgstr "Oh mein Gott, sie sind alle tot!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.ANCIENT_STATUE
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.ANCIENT_STATUE"
msgid "Hyuyu, how spooky!"
msgstr "Hui, wie gruselig!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.ANIMAL_TRACK
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.ANIMAL_TRACK"
msgid "Those aren't my hoofprints!"
msgstr "Das sind nicht meine Hufabdrücke!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.ANTCHOVIES
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.ANTCHOVIES"
msgid "Squirmy, wormy, fishy food."
msgstr "Wimmeliges wurmiges fischiges Futter."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.ANTLION.GENERIC
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.ANTLION.GENERIC"
msgid "You need only tell me what you desire."
msgstr "Du brauchst mir nur zu sagen, was du dir wünschst."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.ANTLION.UNHAPPY
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.ANTLION.UNHAPPY"
msgid "Apologies, dear beast! I am but a worm!"
msgstr "Entschuldigung, liebes Tier! Ich bin nur ein Wurm!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.ANTLION.VERYHAPPY
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.ANTLION.VERYHAPPY"
msgid "Are you not pleased, my friend?"
msgstr "Freust du dich nicht, mein Freund?"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.ANTLIONHAT
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.ANTLIONHAT"
msgid "I'd be lion if I said I wasn't antsy to try it, hyuyu!"
msgstr "Ich hätt’ a’ Meise würde ich nicht zum Löwen werden, hyuyuyu!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.ANTLIONTRINKET
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.ANTLIONTRINKET"
msgid "Better get a bucket!"
msgstr "Ich hole besser einen Eimer!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.ARCHIVE_CENTIPEDE
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.ARCHIVE_CENTIPEDE"
msgid "The message is clear, it does not want me here."
msgstr "Die Botschaft ist klar, ich bin hier nicht erwünscht."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.ARCHIVE_CENTIPEDE_HUSK
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.ARCHIVE_CENTIPEDE_HUSK"
msgid "An empty, soulless shell."
msgstr "Eine leere, seelenlose Hülle."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.ARCHIVE_COOKPOT.BURNT
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.ARCHIVE_COOKPOT.BURNT"
msgid "I don't understand how to make mortal food."
msgstr "Ich verstehe nicht, wie man Nahrung für Sterbliche herstellt."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.ARCHIVE_COOKPOT.COOKING_LONG
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.ARCHIVE_COOKPOT.COOKING_LONG"
msgid "It will take quite some time."
msgstr "Es wird einige Zeit dauern."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.ARCHIVE_COOKPOT.COOKING_SHORT
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.ARCHIVE_COOKPOT.COOKING_SHORT"
msgid "I'm shivering with anticipation!"
msgstr "Ich zittere vor Erwartung!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.ARCHIVE_COOKPOT.DONE
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.ARCHIVE_COOKPOT.DONE"
msgid "Looks like my treat is ready to eat!"
msgstr "Sieht so aus, als wäre mein Essen fertig!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.ARCHIVE_COOKPOT.EMPTY
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.ARCHIVE_COOKPOT.EMPTY"
msgid "I think whatever was cooking has gone cold."
msgstr "Ich glaube, was auch immer gekocht wurde, ist kalt geworden."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.ARCHIVE_LOCKBOX
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.ARCHIVE_LOCKBOX"
msgid "Oh ho! A puzzling piece indeed!"
msgstr "Oh ho! Ein wirklich rätselhaftes Stück!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.ARCHIVE_LOCKBOX_DISPENCER.GENERIC
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.ARCHIVE_LOCKBOX_DISPENCER.GENERIC"
msgid "Do you have any secrets for me?"
msgstr "Hast du irgendwelche Geheimnisse für mich?"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.ARCHIVE_LOCKBOX_DISPENCER.POWEROFF
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.ARCHIVE_LOCKBOX_DISPENCER.POWEROFF"
msgid "What a shame, these machines have no souls to claim."
msgstr "Wie schade, dass diese Maschinen keine Seelen haben, die ich holen kann."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.ARCHIVE_MOON_STATUE
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.ARCHIVE_MOON_STATUE"
msgid "My, that looks heavy."
msgstr "Mann, sieht das schwer aus."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.ARCHIVE_ORCHESTRINA_MAIN
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.ARCHIVE_ORCHESTRINA_MAIN"
msgid "This floor is soundly built, hyuyu!"
msgstr "Der Boden wurde mit großem Tamtam gebaut, hui!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.ARCHIVE_PORTAL.GENERIC
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.ARCHIVE_PORTAL.GENERIC"
msgid "My my, someone didn't want this door opened."
msgstr "Meine Güte, jemand wollte nicht, dass diese Tür geöffnet wird."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.ARCHIVE_PORTAL.POWEROFF
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.ARCHIVE_PORTAL.POWEROFF"
msgid "I won't tell the mortals it's here, it'll just get their poor hopes up."
msgstr "Ich werde den Sterblichen nicht sagen, dass es hier ist, sonst machen sie sich nur zu wenig Hoffnung."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.ARCHIVE_RESONATOR.GENERIC
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.ARCHIVE_RESONATOR.GENERIC"
msgid "There's something hidden that it seeks."
msgstr "Es gibt etwas Verborgenes, nach dem es sucht."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.ARCHIVE_RESONATOR.IDLE
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.ARCHIVE_RESONATOR.IDLE"
msgid "We've finished the deed, nowhere left to lead."
msgstr "Wir haben die Tat vollbracht, keine Wege mehr, Obacht!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.ARCHIVE_RESONATOR_ITEM
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.ARCHIVE_RESONATOR_ITEM"
msgid "What a curious contraption!"
msgstr "Was für ein merkwürdiger Apparat!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.ARCHIVE_RUNE_STATUE.LINE_1
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.ARCHIVE_RUNE_STATUE.LINE_1"
msgid "Oh, what's this? A bit of light reading?"
msgstr "Oh, was ist das? Etwas leichte Lektüre?"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.ARCHIVE_RUNE_STATUE.LINE_2
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.ARCHIVE_RUNE_STATUE.LINE_2"
msgid "It seems they were quite enamoured with our fickle moon once."
msgstr "Es scheint, als wären sie einst ganz vernarrt in unseren unbeständigen Mond gewesen."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.ARCHIVE_RUNE_STATUE.LINE_3
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.ARCHIVE_RUNE_STATUE.LINE_3"
msgid "Now this one doesn't make much sense at all. Unless..."
msgstr "Das hier ergibt überhaupt keinen Sinn. Es sei denn ..."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.ARCHIVE_RUNE_STATUE.LINE_4
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.ARCHIVE_RUNE_STATUE.LINE_4"
msgid "Oh my! My, my my!"
msgstr "Meine Güte ... Oje-oje-oje!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.ARCHIVE_RUNE_STATUE.LINE_5
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.ARCHIVE_RUNE_STATUE.LINE_5"
msgid "Hyuyu, I shouldn't spoil the surprise!"
msgstr "Hiuiui, ich sollte die Überraschung nicht verderben!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.ARCHIVE_SECURITY_DESK.GENERIC
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.ARCHIVE_SECURITY_DESK.GENERIC"
msgid "Oooh how fun! A trap!"
msgstr "Oooh, wie lustig! Eine Falle!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.ARCHIVE_SECURITY_DESK.POWEROFF
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.ARCHIVE_SECURITY_DESK.POWEROFF"
msgid "Now what are you, and what did you do?"
msgstr "Was bist du und was hast du getan?"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.ARCHIVE_SECURITY_PULSE
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.ARCHIVE_SECURITY_PULSE"
msgid "A fellow fae come to show me the way? I think not, hyuyu!"
msgstr "Eine anderes Feen-Ding, das mich auf den Weg bringt? Ich glaube nicht, hyuyu!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.ARCHIVE_SWITCH.GEMS
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.ARCHIVE_SWITCH.GEMS"
msgid "It craves something glittery."
msgstr "Es sehnt sich nach etwas Glitzerndem."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.ARCHIVE_SWITCH.VALID
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.ARCHIVE_SWITCH.VALID"
msgid "It's clutching tightly to that treasure."
msgstr "Es klammert sich fest an diesen Schatz."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.ARMORDRAGONFLY
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.ARMORDRAGONFLY"
msgid "Ooo, I've always wanted to be scaly."
msgstr "Ooo, ich wollte schon immer schuppig sein."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.ARMORDREADSTONE
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.ARMORDREADSTONE"
msgid "All blows will be blocked by this armor of rock."
msgstr "Alle Schläge werden umsonst sein gegen diese Rüstung aus Stein."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.ARMORGRASS
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.ARMORGRASS"
msgid "Protect oneself with a swish and a wish!"
msgstr "Schützt einen mit einem Wisch!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.ARMORMARBLE
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.ARMORMARBLE"
msgid "Stone cold!"
msgstr "Steinkalt!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.ARMORRUINS
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.ARMORRUINS"
msgid "This thulecite sure is a delight!"
msgstr "Dieses Thulecite ist wirklich ein Genuss!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.ARMORSKELETON
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.ARMORSKELETON"
msgid "This fashion's all the rage... it's an external rib cage!"
msgstr "Diese Mode ist der Hit ... das ist ein externer Brustkorb!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.ARMORSLURPER
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.ARMORSLURPER"
msgid "If it means I eat less often, count me in!"
msgstr "Wenn das bedeutet, dass ich weniger oft esse, dann bin ich dabei!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.ARMORSNURTLESHELL
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.ARMORSNURTLESHELL"
msgid "Little bits of snurtle, yes."
msgstr "Kleine Schniefstückchen, ja."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.ARMORWAGPUNK
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.ARMORWAGPUNK"
msgid "Don't leer at my gear."
msgstr "Stets mit Zahnrad und Tat an meiner Seite."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.ARMORWOOD
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.ARMORWOOD"
msgid "Knock on wood, they say, they say!"
msgstr "Klopf auf Holz, sagen sie, sagen sie!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.ARMOR_BRAMBLE
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.ARMOR_BRAMBLE"
msgid "Who'd like to give an imp a hug? Hyuyu!"
msgstr "Wer will einen Kobold umarmen? Hui!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.ARMOR_CARROTLURE
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.ARMOR_CARROTLURE"
msgid "Carrot? Wear it!"
msgstr "Karotte? Trag sie!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.ARMOR_LUNARPLANT
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.ARMOR_LUNARPLANT"
msgid "Strong and light, quite good in a fight."
msgstr "Stark und leicht, sodass sie für den Kampf gereicht."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.ARMOR_LUNARPLANT_HUSK
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.ARMOR_LUNARPLANT_HUSK"
msgid "Prickly plant protection, perfection!"
msgstr "Protektion vor stacheliger Pflanze. Perfektion!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.ARMOR_SANITY
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.ARMOR_SANITY"
msgid "Keeps the flesh body safe! The mind's another story."
msgstr "Schützt den Fleischkörper! Den Verstand nicht unbedingt."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.ARMOR_VOIDCLOTH
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.ARMOR_VOIDCLOTH"
msgid "It broke the chains of its previous plane."
msgstr "Hat die Ketten ihrer vorigen Existenzebene gesprengt."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.ARMOR_YOTH_KNIGHT
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.ARMOR_YOTH_KNIGHT"
msgid "Foresee harm? More horsey armor!"
msgstr "Gegen Gefahr hilft eine Rüstung mit Pferdehaar!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.ARROWSIGN_PANEL.BURNT
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.ARROWSIGN_PANEL.BURNT"
msgid "A silly prank to be sure."
msgstr "Wirklich ein alberner Streich."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.ARROWSIGN_PANEL.GENERIC
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.ARROWSIGN_PANEL.GENERIC"
msgid "It really doesn't matter which way I go!"
msgstr "Es spielt wirklich keine Rolle, in welche Richtung ich gehe!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.ARROWSIGN_PANEL.UNWRITTEN
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.ARROWSIGN_PANEL.UNWRITTEN"
msgid "Nothing to be seen here, I fear."
msgstr "Hier ist nichts zu sehen, fürchte ich."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.ARROWSIGN_POST.BURNT
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.ARROWSIGN_POST.BURNT"
msgid "A silly prank to be sure."
msgstr "Wirklich ein alberner Streich."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.ARROWSIGN_POST.GENERIC
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.ARROWSIGN_POST.GENERIC"
msgid "It really doesn't matter which way I go!"
msgstr "Es spielt wirklich keine Rolle, in welche Richtung ich gehe!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.ARROWSIGN_POST.UNWRITTEN
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.ARROWSIGN_POST.UNWRITTEN"
msgid "Nothing to be seen here, I fear."
msgstr "Hier ist nichts zu sehen, fürchte ich."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.ASH.GENERIC
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.ASH.GENERIC"
msgid "Cinders, cinders, cinders."
msgstr "Asche, Asche, Asche."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.ASH.REMAINS_EYE_BONE
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.ASH.REMAINS_EYE_BONE"
msgid "The planar hop has destroyed this bone!"
msgstr "Das Hüpfen von Ebene zu Ebene hat diesen Knochen zerstört!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.ASH.REMAINS_GLOMMERFLOWER
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.ASH.REMAINS_GLOMMERFLOWER"
msgid "The planar hop has destroyed this flower!"
msgstr "Das Hüpfen von Ebene zu Ebene hat diese Blume zerstört!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.ASH.REMAINS_THINGIE
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.ASH.REMAINS_THINGIE"
msgid "It could not exist on this plane."
msgstr "Es konnte auf dieser Ebene nicht existieren."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.ASPARAGUS
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.ASPARAGUS"
msgid "A spear I guess. Hyuyu!"
msgstr "Ein Speer, schätze ich. Hui!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.ASPARAGUSSOUP
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.ASPARAGUSSOUP"
msgid "Even for human food, this is odd."
msgstr "Sogar für menschliche Verhältnisse merkwürdig."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.ASPARAGUS_COOKED
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.ASPARAGUS_COOKED"
msgid "I'd rather not."
msgstr "Lieber nicht."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.ASPARAGUS_OVERSIZED
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.ASPARAGUS_OVERSIZED"
msgid "None for me, thank you."
msgstr "Für mich nicht, danke."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.ASPARAGUS_SEEDS
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.ASPARAGUS_SEEDS"
msgid "Strange little seeds, indeed, indeed."
msgstr "Seltsame kleine Samen, in der Tat, in der Tat."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.ATRIUM_GATE.CHARGING
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.ATRIUM_GATE.CHARGING"
msgid "Oh, we're going to have some fun!"
msgstr "Oh, wir werden etwas Spaß haben!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.ATRIUM_GATE.COOLDOWN
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.ATRIUM_GATE.COOLDOWN"
msgid "Playtime's over."
msgstr "Die Spielzeit ist vorbei."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.ATRIUM_GATE.DESTABILIZING
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.ATRIUM_GATE.DESTABILIZING"
msgid "Hyuyu, it's getting weird!"
msgstr "Huiii, jetzt wird es sonderbar!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.ATRIUM_GATE.OFF
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.ATRIUM_GATE.OFF"
msgid "The thing I hopped through!"
msgstr "Das Ding, durch das ich gehüpft bin!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.ATRIUM_GATE.ON
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.ATRIUM_GATE.ON"
msgid "That's how you get imps. Hyuyu!"
msgstr "So bekommt man Kobolde. Huii!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.ATRIUM_KEY
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.ATRIUM_KEY"
msgid "An imp could do mischievous things with this."
msgstr "Ein Kobold könnte damit schelmische Dinge anstellen."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.ATRIUM_LIGHT.OFF
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.ATRIUM_LIGHT.OFF"
msgid "I'm not sure how to play with this."
msgstr "Ich bin mir nicht sicher, wie ich damit umgehen soll."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.ATRIUM_LIGHT.ON
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.ATRIUM_LIGHT.ON"
msgid "Ooo, it turned on!"
msgstr "Oho, es ist eingeschaltet!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.ATRIUM_OVERGROWTH
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.ATRIUM_OVERGROWTH"
msgid "Ooo, there's some naughty magic at play here!"
msgstr "Oho, hier ist ein bisschen fauler Zauber im Spiel!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.ATRIUM_RUBBLE.LINE_1
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.ATRIUM_RUBBLE.LINE_1"
msgid "A bunch of mortals. They look very bored."
msgstr "Ein Haufen Sterbliche. Sie sehen sehr gelangweilt aus."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.ATRIUM_RUBBLE.LINE_2
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.ATRIUM_RUBBLE.LINE_2"
msgid "There's some magic residue on the stone. Not much else."
msgstr "Da sind magische Rückstände auf dem Stein. Sonst eigentlich nichts."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.ATRIUM_RUBBLE.LINE_3
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.ATRIUM_RUBBLE.LINE_3"
msgid "Ooo, it's about to get good!"
msgstr "Oho, das wird gut!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.ATRIUM_RUBBLE.LINE_4
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.ATRIUM_RUBBLE.LINE_4"
msgid "What a hoot! The mortals are slithering out their skins!"
msgstr "Was für ein Spaß! Die Sterblichen schleifen sich aus ihren Häuten!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.ATRIUM_RUBBLE.LINE_5
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.ATRIUM_RUBBLE.LINE_5"
msgid "They probably shouldn't have used that much magic."
msgstr "Sie hätten wahrscheinlich nicht so viel Magie benutzen sollen."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.ATRIUM_STATUE
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.ATRIUM_STATUE"
msgid "Hyuyu, did you lose a game?"
msgstr "Huiii, hast du ein Spiel verloren?"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.AXE
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.AXE"
msgid "To whack and to chop."
msgstr "Zum Schlagen und Hacken."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.BABYBEEFALO.GENERIC
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.BABYBEEFALO.GENERIC"
msgid "It belongs with its momma."
msgstr "Gehört zu seiner Mama."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.BABYBEEFALO.SLEEPING
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.BABYBEEFALO.SLEEPING"
msgid "Sleep softly sweet soul."
msgstr "Schlafe sanft, süße Seele."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.BACKPACK
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.BACKPACK"
msgid "Behold this burden on my back!"
msgstr "Seht diese Last auf meinem Rücken!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.BACONEGGS
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.BACONEGGS"
msgid "A mortal favorite."
msgstr "Die Sterblichen sind ganz wild darauf."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.BALATRO_MACHINE
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.BALATRO_MACHINE"
msgid "Hey joker, let's play some poker!"
msgstr "Hey, Joker, spielen wir ein wenig Poker!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.BALLOON
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.BALLOON"
msgid "I often feel like I might float away. Hyuyu!"
msgstr "Ich habe oft das Gefühl, dass ich wegfliegen könnte. Huiii!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.BALLOONHAT
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.BALLOONHAT"
msgid "I'm likely to get lightheaded from wearing it, hyuyuyu!"
msgstr "Mir wird wahrscheinlich schwindelig, wenn ich das trage, hyuyuyu!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.BALLOONPARTY
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.BALLOONPARTY"
msgid "A party! Am I invited?"
msgstr "Eine Party! Bin ich eingeladen?"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.BALLOONSPEED.DEFLATED
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.BALLOONSPEED.DEFLATED"
msgid "Its magic is spent."
msgstr "Die Magie ist verbraucht."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.BALLOONSPEED.GENERIC
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.BALLOONSPEED.GENERIC"
msgid "With this gift, I'll be more swift!"
msgstr "Mit diesem Geschenk bin ich geschwind wie der Wind!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.BALLOONS_EMPTY
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.BALLOONS_EMPTY"
msgid "Stores one's breath for later spells."
msgstr "Speichert den Atem für spätere Zauber."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.BALLOONVEST
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.BALLOONVEST"
msgid "A bright balloon vest to wear across my chest."
msgstr "Eine leuchtendes Ballon-Jackett, für meine Brust, das ist adrett."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.BANANABUSH
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.BANANABUSH"
msgid "Hyuyu, little shrub, are you waving at me?"
msgstr "Hui, kleiner Busch, winkst du mir zu?"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.BANANAJUICE
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.BANANAJUICE"
msgid "Mortals will eat bananas in just about any form."
msgstr "Sterbliche essen Bananen in jeglicher Form."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.BANANAPOP
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.BANANAPOP"
msgid "Hyuyu, what will the mortals think of next?"
msgstr "Hui, was lassen die Sterblichen sich als Nächstes einfallen?"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.BANDAGE
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.BANDAGE"
msgid "A wrap for wounds."
msgstr "Zum Einwickeln von Wunden."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.BANDAGE_BUTTERFLYWINGS
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.BANDAGE_BUTTERFLYWINGS"
msgid "Who? Who has a boo-boo?"
msgstr "Wer? Wer hat ein Wehwehchen?"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.BARNACLE
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.BARNACLE"
msgid "A briny bunch of barnacles."
msgstr "Ein meersalziger Muschelhaufen."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.BARNACLEPITA
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.BARNACLEPITA"
msgid "Unless this pocket is filled with souls, I'll pass."
msgstr "Wenn die Tasche nicht mit Seelen gefüllt ist, verzichte ich."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.BARNACLESTUFFEDFISHHEAD
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.BARNACLESTUFFEDFISHHEAD"
msgid "Hyuyu, no talking with your mouth full!"
msgstr "Hui, nicht mit vollem Mund reden!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.BARNACLESUSHI
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.BARNACLESUSHI"
msgid "Perhaps one of the mortals will enjoy it."
msgstr "Vielleicht mag das einer der Sterblichen."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.BARNACLE_COOKED
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.BARNACLE_COOKED"
msgid "I'd rather not."
msgstr "Lieber nicht."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.BARNACLINGUINE
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.BARNACLINGUINE"
msgid "Oodles of fishy noodles."
msgstr "Jede Menge Fischnudeln."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.BASALT
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.BASALT"
msgid "Big, big rock, for sure, for sure."
msgstr "Großer, großer Stein. Sicher, sicher."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.BAT
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.BAT"
msgid "I'm quite batty myself! Hyuyu!"
msgstr "Ich kann auch ganz gut zuschlagen! Huiii!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.BATBAT
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.BATBAT"
msgid "Extra batty!"
msgstr "Extra-Schlag!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.BATCAVE
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.BATCAVE"
msgid "Where the bats lie in wait."
msgstr "Da liegen die Fledermäuse auf der Lauer."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.BATHBOMB
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.BATHBOMB"
msgid "Sweetly stinking, bombs for bathing."
msgstr "Süße Stinkbomben zum Baden."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.BATNOSE
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.BATNOSE"
msgid "Oh my, looks like somebody blew it."
msgstr "Oh je, sieht aus, als hätte sie jemand geputzt."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.BATNOSEHAT
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.BATNOSEHAT"
msgid "What will the mortals cook up next."
msgstr "Was werden die Sterblichen als Nächstes aushecken?"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.BATNOSE_COOKED
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.BATNOSE_COOKED"
msgid "This smells! I think it's gone off!"
msgstr "Das riecht! Ich glaube, sie ist angebrannt!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.BATTLESONG_CONTAINER
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.BATTLESONG_CONTAINER"
msgid "I've been told I can carry a tune."
msgstr "Man sagt mir, ich könnte Töne gut halten."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.BATTLESONG_DURABILITY
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.BATTLESONG_DURABILITY"
msgid "Singing is good for the soul."
msgstr "Singen ist gut für die Seele."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.BATTLESONG_FIRERESISTANCE
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.BATTLESONG_FIRERESISTANCE"
msgid "Singing is good for the soul."
msgstr "Singen ist gut für die Seele."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.BATTLESONG_HEALTHGAIN
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.BATTLESONG_HEALTHGAIN"
msgid "Singing is good for the soul."
msgstr "Singen ist gut für die Seele."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.BATTLESONG_INSTANT_PANIC
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.BATTLESONG_INSTANT_PANIC"
msgid "Oooh, yay! Are we putting on a play?"
msgstr "Oooh, juhu! Führen wir ein Stück auf?"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.BATTLESONG_INSTANT_REVIVE
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.BATTLESONG_INSTANT_REVIVE"
msgid "Singing is good for the soul."
msgstr "Singen ist gut für die Seele."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.BATTLESONG_INSTANT_TAUNT
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.BATTLESONG_INSTANT_TAUNT"
msgid "Oooh, yay! Are we putting on a play?"
msgstr "Oooh, juhu! Führen wir ein Stück auf?"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.BATTLESONG_LUNARALIGNED
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.BATTLESONG_LUNARALIGNED"
msgid "Singing is good for the soul."
msgstr "Singen ist gut für die Seele."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.BATTLESONG_SANITYAURA
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.BATTLESONG_SANITYAURA"
msgid "Singing is good for the soul."
msgstr "Singen ist gut für die Seele."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.BATTLESONG_SANITYGAIN
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.BATTLESONG_SANITYGAIN"
msgid "Singing is good for the soul."
msgstr "Singen ist gut für die Seele."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.BATTLESONG_SHADOWALIGNED
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.BATTLESONG_SHADOWALIGNED"
msgid "Singing is good for the soul."
msgstr "Singen ist gut für die Seele."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.BATWING
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.BATWING"
msgid "Look at that! The wing of a bat."
msgstr "Schau nur, der Flügel einer Fledermaus."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.BATWING_COOKED
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.BATWING_COOKED"
msgid "Perhaps I'll find a hungry mortal to give it to."
msgstr "Vielleicht finde ich einen hungrigen Sterblichen, dem ich es geben kann."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.BEARDHAIR
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.BEARDHAIR"
msgid "Mortal fur."
msgstr "Sterbliches Fell."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.BEARGER
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.BEARGER"
msgid "Do not eat me, oh please, oh please!"
msgstr "Iss mich nicht, oh bitte, oh bitte!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.BEARGERCORPSE.BURNING
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.BEARGERCORPSE.BURNING"
msgid "I'd love some toast to go with this roast!"
msgstr "Ich traue diesem Braten nicht so recht, hui!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.BEARGERCORPSE.GENERIC
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.BEARGERCORPSE.GENERIC"
msgid "Hibernation? More like termination! Hyuyu!"
msgstr "Winterschlaf? Wohl eher Für-Immer-Schlaf! Hui!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.BEARGERCORPSE.REVIVING
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.BEARGERCORPSE.REVIVING"
msgid "The brute is reviving. Who did the unaliving?"
msgstr "Der Grobian reanimiert sich. Wer ist für die Reanimierung verantwortlich?"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.BEARGERFUR_SACK
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.BEARGERFUR_SACK"
msgid "Is that where the mortals pack food away for the winter?"
msgstr "Legen die Sterblichen da etwa ihre Nahrung für den Winter rein?"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.BEARGERVEST
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.BEARGERVEST"
msgid "Sometimes you want to wear someone else's fur."
msgstr "Manchmal möchte man das Fell eines anderen tragen."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.BEARGER_FUR
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.BEARGER_FUR"
msgid "You won't be eating me today!"
msgstr "Du wirst mich heute nicht essen!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.BEAST_BLUEPRINT
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.BEAST_BLUEPRINT"
msgid "Lucky, hm? Perhaps it's made with fairy gold."
msgstr "Glück, hm? Vielleicht ist es aus Elfengold gemacht."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.BEDROLL_FURRY
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.BEDROLL_FURRY"
msgid "Fur upon fur!"
msgstr "Fell auf Fell!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.BEDROLL_STRAW
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.BEDROLL_STRAW"
msgid "To lay my sweet little head down."
msgstr "Um meinen süßen kleinen Kopf hinzulegen."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.BEE.GENERIC
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.BEE.GENERIC"
msgid "Buzz buzz buzz, tiny bee!"
msgstr "Summ, summ, summ, kleine Biene!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.BEE.HELD
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.BEE.HELD"
msgid "Careful now, little mortal."
msgstr "Jetzt aber vorsichtig, kleiner Sterblicher."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.BEEBOX.BURNT
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.BEEBOX.BURNT"
msgid "Mayhaps it's caramelized within!"
msgstr "Vielleicht ist das Innere karamelisiert!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.BEEBOX.FULLHONEY
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.BEEBOX.FULLHONEY"
msgid "So much honey! The mortals will be overjoyed!"
msgstr "So viel Honig! Die Sterblichen werden überglücklich sein!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.BEEBOX.GENERIC
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.BEEBOX.GENERIC"
msgid "A box full of bees would make a great prank."
msgstr "Mit einer Kiste voller Bienen könnte man einen tollen Streich spielen."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.BEEBOX.NOHONEY
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.BEEBOX.NOHONEY"
msgid "Nothing inside but bees, oh yes!"
msgstr "Außer Bienen ist da nichts drin, oh ja!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.BEEBOX.READY
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.BEEBOX.READY"
msgid "So much honey! The mortals will be overjoyed!"
msgstr "So viel Honig! Die Sterblichen werden überglücklich sein!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.BEEBOX.SOMEHONEY
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.BEEBOX.SOMEHONEY"
msgid "We could scrape a bit of honey out."
msgstr "Wir könnte ein bisschen Honig rauskratzen."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.BEEBOX_HERMIT.BURNT
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.BEEBOX_HERMIT.BURNT"
msgid "Mayhaps it's caramelized within!"
msgstr "Vielleicht ist das Innere karamelisiert!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.BEEBOX_HERMIT.FULLHONEY
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.BEEBOX_HERMIT.FULLHONEY"
msgid "So much honey! That crabby mortal might crack a smile!"
msgstr "So viel Honig! Diese Krabbe könnte sich auch mal freuen!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.BEEBOX_HERMIT.GENERIC
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.BEEBOX_HERMIT.GENERIC"
msgid "The whole hive is abuzz!"
msgstr "Was für ein Summen bei den Bienen!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.BEEBOX_HERMIT.NOHONEY
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.BEEBOX_HERMIT.NOHONEY"
msgid "Nothing inside but bees, oh yes!"
msgstr "Außer Bienen ist da nichts drin, oh ja!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.BEEBOX_HERMIT.READY
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.BEEBOX_HERMIT.READY"
msgid "So much honey! That crabby mortal might crack a smile!"
msgstr "So viel Honig! Diese Krabbe könnte sich auch mal freuen!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.BEEBOX_HERMIT.SOMEHONEY
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.BEEBOX_HERMIT.SOMEHONEY"
msgid "We could scrape a bit of honey out."
msgstr "Wir könnte ein bisschen Honig rauskratzen."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.BEEFALO.DEAD
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.BEEFALO.DEAD"
msgid "Someone's ride has died."
msgstr "Jemandes Gefährt hat sich wohl nicht bewährt."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.BEEFALO.DEAD_MYPARTNER
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.BEEFALO.DEAD_MYPARTNER"
msgid "Say it ain't so, m'fellow beefalo!"
msgstr "Sag mir, das ist Teil der Show, mein getreues Beefalo!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.BEEFALO.DOMESTICATED
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.BEEFALO.DOMESTICATED"
msgid "I believe we've made a friend!"
msgstr "Ich glaube, wir haben einen neuen Freund!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.BEEFALO.FOLLOWER
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.BEEFALO.FOLLOWER"
msgid "Hyuyu! Are we playing follow the leader?"
msgstr "Huiii! Spielen wir jetzt Fangen?"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.BEEFALO.GENERIC
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.BEEFALO.GENERIC"
msgid "Hello, hello, dear beefalo!"
msgstr "Hallo, hallo, lieber Beefalo!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.BEEFALO.MYPARTNER
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.BEEFALO.MYPARTNER"
msgid "We're kindred souls, wouldn't you say?"
msgstr "Wir sind verwandte Seelen, findest du nicht auch?"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.BEEFALO.NAKED
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.BEEFALO.NAKED"
msgid "Hyuyuyu! That's too good!"
msgstr "Huiii! Das ist zu gut!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.BEEFALO.ORNERY
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.BEEFALO.ORNERY"
msgid "Don't you feel just hopping mad?"
msgstr "Wird dir dabei nicht schlecht?"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.BEEFALO.PUDGY
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.BEEFALO.PUDGY"
msgid "Its soul is chubby too, hyuyu!"
msgstr "Seine Seele ist auch gut beieinander, huiii!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.BEEFALO.RIDER
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.BEEFALO.RIDER"
msgid "Don't you want to carry me?"
msgstr "Willst du mich nicht tragen?"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.BEEFALO.SLEEPING
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.BEEFALO.SLEEPING"
msgid "Shhh."
msgstr "Schhh."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.BEEFALOFEED
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.BEEFALOFEED"
msgid "It really sticks to the ribs, hyuyu!"
msgstr "Hängt ganz schön an seinen Stöcken, hyuyu!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.BEEFALOHAT
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.BEEFALOHAT"
msgid "Horn replacements."
msgstr "Ersatzhörner."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.BEEFALOTREAT
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.BEEFALOTREAT"
msgid "A beef so sweet deserves a treat."
msgstr "Ein Beefalo so süß, verdient etwas Gemüs’."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.BEEFALOWOOL
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.BEEFALOWOOL"
msgid "Ex-beefalo."
msgstr "Ex-Beefalo."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.BEEFALO_GROOMER.BURNT
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.BEEFALO_GROOMER.BURNT"
msgid "Hyuyuyu how silly!"
msgstr "Hyuyuyu, wie albern!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.BEEFALO_GROOMER.GENERIC
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.BEEFALO_GROOMER.GENERIC"
msgid "I'll groom beefalo hair with my signature flair."
msgstr "Ich striegle das Beefalo-Haar mit meinem typischen Flair."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.BEEFALO_GROOMER.OCCUPIED
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.BEEFALO_GROOMER.OCCUPIED"
msgid "Fancy some fancying up? Hyuyu!"
msgstr "Lust auf ein bisschen Pepp? Hyuyu!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.BEEFALO_GROOMER_ITEM
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.BEEFALO_GROOMER_ITEM"
msgid "Let's prepare to style beefalo hair!"
msgstr "Wir sind bereit, zu Stylen das Beefalo-Haar gescheit!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.BEEF_BELL
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.BEEF_BELL"
msgid "What a strange enchantment!"
msgstr "Was für ein seltsamer Zauber!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.BEEGUARD
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.BEEGUARD"
msgid "Beeee gentle with me!"
msgstr "Bitte stech mich nicht!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.BEEHAT
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.BEEHAT"
msgid "What if my horns get stung?"
msgstr "Was, wenn ich in die Hörner gestochen werde?"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.BEEHIVE
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.BEEHIVE"
msgid "One swift kick and it becomes a great prank."
msgstr "Ein schneller Tritt und es wird ein großer Streich."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.BEEMINE
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.BEEMINE"
msgid "This will be a funny prank."
msgstr "Das wird ein lustiger Streich sein."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.BEEMINE_MAXWELL
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.BEEMINE_MAXWELL"
msgid "That's not a funny prank at all!"
msgstr "Das ist überhaupt kein lustiger Streich!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.BEEQUEEN
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.BEEQUEEN"
msgid "Tweeheehe! You're a big bee!"
msgstr "Huiuiui! Du bist aber eine große Biene!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.BEEQUEENHIVE.GENERIC
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.BEEQUEENHIVE.GENERIC"
msgid "My hooves would get stuck in it."
msgstr "Meine Hufe würden darin stecken bleiben."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.BEEQUEENHIVE.GROWING
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.BEEQUEENHIVE.GROWING"
msgid "Ooo, a new mystery!"
msgstr "Oh, ein neues Geheimnis!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.BEEQUEENHIVEGROWN
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.BEEQUEENHIVEGROWN"
msgid "The mystery grows!"
msgstr "Das Geheimnis wächst!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.BEESWAX
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.BEESWAX"
msgid "None of mine!"
msgstr "Nicht meins!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.BEESWAX_SPRAY
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.BEESWAX_SPRAY"
msgid "A frightful fragrance for freezing flora!"
msgstr "Ein gemeiner Geruch für gefrorene Gewächse!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.BEETLETAUR
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.BEETLETAUR"
msgid "My oh my, you're a big guy!"
msgstr "Sowas, wie groß du bist!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.BELL
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.BELL"
msgid "I believe it might bring forth delight."
msgstr "Ich glaube, das könnte Freude bringen."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.BERNIE_ACTIVE
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.BERNIE_ACTIVE"
msgid "Good sir, are you aware you've no soul?"
msgstr "Mein Herr, wisst ihr denn, dass ihr keine Seele habt?"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.BERNIE_BIG
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.BERNIE_BIG"
msgid "It's grown to new heights to win all our fights!"
msgstr "Zu neuen Höhen gewachsen, um alle unsere Kämpfe zu gewinnen!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.BERNIE_INACTIVE.BROKEN
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.BERNIE_INACTIVE.BROKEN"
msgid "He seemed a fine chap."
msgstr "Der schien doch ganz nett."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.BERNIE_INACTIVE.GENERIC
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.BERNIE_INACTIVE.GENERIC"
msgid "What a pity."
msgstr "Wie schade."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.BERRIES
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.BERRIES"
msgid "A handful of mortal treats."
msgstr "Eine Handvoll Leckereien für die Sterblichen."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.BERRIES_COOKED
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.BERRIES_COOKED"
msgid "I hear they last longer this way."
msgstr "Ich habe gehört, dass sie so länger halten."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.BERRIES_JUICY
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.BERRIES_JUICY"
msgid "Mortals eat them as a snack."
msgstr "Sterbliche essen sie zwischendurch."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.BERRIES_JUICY_COOKED
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.BERRIES_JUICY_COOKED"
msgid "I hear they last longer this way."
msgstr "Ich habe gehört, dass sie so länger halten."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.BERRYBUSH.BARREN
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.BERRYBUSH.BARREN"
msgid "It won't be returning to this plane."
msgstr "Ich werde nicht zu dieser Ebene zurückkehren."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.BERRYBUSH.BURNING
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.BERRYBUSH.BURNING"
msgid "Whoops-a-doodle."
msgstr "Hoppla."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.BERRYBUSH.DISEASED
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.BERRYBUSH.DISEASED"
msgid "Now it stinks really good!"
msgstr "Jetzt stinkt es wirklich gut!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.BERRYBUSH.DISEASING
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.BERRYBUSH.DISEASING"
msgid "It's started to stink."
msgstr "Hat angefangen zu stinken."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.BERRYBUSH.GENERIC
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.BERRYBUSH.GENERIC"
msgid "Mortals say they're sweet to eat."
msgstr "Die Sterblichen sagen, dass sie süß schmecken."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.BERRYBUSH.PICKED
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.BERRYBUSH.PICKED"
msgid "Gone, all gone."
msgstr "Weg, alles weg."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.BERRYBUSH.WITHERED
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.BERRYBUSH.WITHERED"
msgid "Feeling down, are you?"
msgstr "Du fühlst dich niedergeschlagen, oder?"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.BERRYBUSH_JUICY.BARREN
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.BERRYBUSH_JUICY.BARREN"
msgid "Salted earth, none will return."
msgstr "Salzige Erde. Hier wächst nichts mehr."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.BERRYBUSH_JUICY.BURNING
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.BERRYBUSH_JUICY.BURNING"
msgid "Whoops-a-doodle."
msgstr "Hoppla."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.BERRYBUSH_JUICY.DISEASED
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.BERRYBUSH_JUICY.DISEASED"
msgid "Now it stinks really good!"
msgstr "Jetzt stinkt es wirklich gut!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.BERRYBUSH_JUICY.DISEASING
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.BERRYBUSH_JUICY.DISEASING"
msgid "It's started to stink."
msgstr "Hat angefangen zu stinken."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.BERRYBUSH_JUICY.GENERIC
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.BERRYBUSH_JUICY.GENERIC"
msgid "The humans like them, yes indeed."
msgstr "Die Menschen mögen sie. Ja, wirklich."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.BERRYBUSH_JUICY.PICKED
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.BERRYBUSH_JUICY.PICKED"
msgid "Gone, all gone."
msgstr "Weg, alles weg."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.BERRYBUSH_JUICY.WITHERED
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.BERRYBUSH_JUICY.WITHERED"
msgid "Feeling down, are you?"
msgstr "Du fühlst dich niedergeschlagen, oder?"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.BERRYSAUCE
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.BERRYSAUCE"
msgid "Hyuyuyu, what a fun trick!"
msgstr "Hui, ein lustiges Kunststück!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.BIBINGKA
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.BIBINGKA"
msgid "I would've made a great Ani-ani."
msgstr "Ich hätte ein großes Ani-ani gemacht."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.BIGFOOT
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.BIGFOOT"
msgid "Do not step on little old me!"
msgstr "Tritt nicht auf mich kleines Alterchen!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.BIRCHNUTDRAKE
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.BIRCHNUTDRAKE"
msgid "Tiny forest children of hate!"
msgstr "Kleine Waldkinder voller Hass!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.BIRDCAGE.DEAD
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.BIRDCAGE.DEAD"
msgid "It seems you went and met your end."
msgstr "Sieht so aus, als hättest du dein Ende gefunden."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.BIRDCAGE.GENERIC
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.BIRDCAGE.GENERIC"
msgid "A place where little birds are penned."
msgstr "Ein Ort, an dem kleine Vögel eingesperrt werden."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.BIRDCAGE.HUNGRY
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.BIRDCAGE.HUNGRY"
msgid "No worries, lunch is right around the bend."
msgstr "Keine Sorge, das Mittagessen ist gleich um die Ecke."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.BIRDCAGE.OCCUPIED
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.BIRDCAGE.OCCUPIED"
msgid "Hello my singing, feathered friend."
msgstr "Hallo, mein singender, gefiederter Freund."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.BIRDCAGE.SKELETON
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.BIRDCAGE.SKELETON"
msgid "I don't think she's exactly on the mend."
msgstr "Ich glaube nicht, dass sie auf dem Weg der Besserung ist."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.BIRDCAGE.SLEEPING
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.BIRDCAGE.SLEEPING"
msgid "No more sleepless nights you'll spend."
msgstr "Keine schlaflosen Nächte mehr für dich."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.BIRDCAGE.STARVING
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.BIRDCAGE.STARVING"
msgid "Does no one have some seeds to lend?"
msgstr "Kann denn niemand etwas Samen borgen?"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.BIRDCORPSE.BURNING
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.BIRDCORPSE.BURNING"
msgid "Cremation to curb mutation!"
msgstr "Kremation zur Verhinderung der Mutation."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.BIRDCORPSE.GENERIC
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.BIRDCORPSE.GENERIC"
msgid "It's dead but not done."
msgstr "Ist tot aber nicht am Ende."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.BIRDCORPSE.REVIVING
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.BIRDCORPSE.REVIVING"
msgid "It's changing and deranging."
msgstr "Er verwandelt sich, um zu wandeln."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.BIRDTRAP
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.BIRDTRAP"
msgid "The birds will find this so funny!"
msgstr "Die Vögel werden das so lustig finden!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.BIRD_EGG
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.BIRD_EGG"
msgid "An egg from a bird, or so I've heard."
msgstr "Ein Ei von einem Vogel, wie ich gehört habe."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.BIRD_EGG_COOKED
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.BIRD_EGG_COOKED"
msgid "Probably a mortal thing."
msgstr "Vermutlich etwas, was die Sterblichen mögen."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.BIRD_MUTANT
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.BIRD_MUTANT"
msgid "My my, you're looking rather pale!"
msgstr "Meine Güte, du siehst ja ganz schön blass aus!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.BIRD_MUTANT_SPITTER
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.BIRD_MUTANT_SPITTER"
msgid "Its new form is far from norm."
msgstr "Seine neue Form geht gegen die Norm."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.BISHOP
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.BISHOP"
msgid "You sure look mean, you nasty fiend!"
msgstr "Du siehst wirklich gemein aus, du böser Unhold!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.BISHOP_CHARGE_HIT
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.BISHOP_CHARGE_HIT"
msgid "Hyuyu! Owie!"
msgstr "Huiii! Uiii!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.BISHOP_NIGHTMARE
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.BISHOP_NIGHTMARE"
msgid "Eep! Play nice with the imp!"
msgstr "Uff! Sei nett zum Kobold!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.BLACKFLAG
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.BLACKFLAG"
msgid "It's inspiring me to make a little mischief of my own."
msgstr "Es ist inspirierend, selbst etwas Unheil anzurichten."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.BLOWDART_FIRE
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.BLOWDART_FIRE"
msgid "Ptt!"
msgstr "Pft!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.BLOWDART_LAVA
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.BLOWDART_LAVA"
msgid "A gust of breath means flaming death!"
msgstr "Ein Atemstoß bringt den Tod in den Flammen!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.BLOWDART_LAVA2
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.BLOWDART_LAVA2"
msgid "A gust of breath means flaming death!"
msgstr "Ein Atemstoß bringt den Tod in den Flammen!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.BLOWDART_PIPE
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.BLOWDART_PIPE"
msgid "Ptoo!"
msgstr "Pfft!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.BLOWDART_SLEEP
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.BLOWDART_SLEEP"
msgid "Pph!"
msgstr "Pft!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.BLOWDART_YELLOW
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.BLOWDART_YELLOW"
msgid "Prrp!"
msgstr "Prrp!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.BLUEAMULET
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.BLUEAMULET"
msgid "The cold won't get through my chest tuft, hyuyu."
msgstr "Die Kälte wird nicht durch meinen Brustbüschel dringen, Huii."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.BLUEGEM
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.BLUEGEM"
msgid "Somber blue from seabeds grew."
msgstr "Ein schönes Blau vom Meeresboden."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.BLUEMOONEYE
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.BLUEMOONEYE"
msgid "It's visible from any nook or crook."
msgstr "Ist von überall sichtbar."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.BLUEPRINT.COMMON
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.BLUEPRINT.COMMON"
msgid "What knowledge will I find within?"
msgstr "Welches Wissen werde ich darin finden?"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.BLUEPRINT.RARE
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.BLUEPRINT.RARE"
msgid "Ooo, secret knowledge, what fun, what power!"
msgstr "Oooh, Geheimwissen, was für ein Spaß, was für eine Macht!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.BLUE_CAP
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.BLUE_CAP"
msgid "Funny tricks it tries to play."
msgstr "Das hat manche Trickserei drauf."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.BLUE_CAP_COOKED
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.BLUE_CAP_COOKED"
msgid "That changed it somehow."
msgstr "Das hat es irgendwie verändert."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.BLUE_MUSHROOM.GENERIC
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.BLUE_MUSHROOM.GENERIC"
msgid "Found you!"
msgstr "Gefunden!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.BLUE_MUSHROOM.INGROUND
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.BLUE_MUSHROOM.INGROUND"
msgid "It's playing hide and seek!"
msgstr "Spielt Verstecken!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.BLUE_MUSHROOM.PICKED
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.BLUE_MUSHROOM.PICKED"
msgid "Gone, all gone."
msgstr "Weg, alles weg."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.BOARDS
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.BOARDS"
msgid "It's a board. How untoward!"
msgstr "Ein Brett. Wie komisch!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.BOARON
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.BOARON"
msgid "Who invited a pig to this shindig?"
msgstr "Wer hat denn ein Schwein eingeladen?"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.BOARRIOR
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.BOARRIOR"
msgid "Catch me if you can!"
msgstr "Du kriegst mich nicht!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.BOATFRAGMENT03
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.BOATFRAGMENT03"
msgid "Flotsam and jetsam, bits and bobs."
msgstr "Treibgut und Strandgut, Brocken und Fetzen."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.BOATFRAGMENT04
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.BOATFRAGMENT04"
msgid "Flotsam and jetsam, bits and bobs."
msgstr "Treibgut und Strandgut, Brocken und Fetzen."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.BOATFRAGMENT05
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.BOATFRAGMENT05"
msgid "Flotsam and jetsam, bits and bobs."
msgstr "Treibgut und Strandgut, Brocken und Fetzen."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.BOATPATCH
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.BOATPATCH"
msgid "Plugging a hole sounds quite droll."
msgstr "Loch stopfen? Klingt lustig."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.BOATPATCH_KELP
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.BOATPATCH_KELP"
msgid "This kelp should help!"
msgstr "Der Tang hilft in jedem Belang'."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.BOATRACE_CHECKPOINT
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.BOATRACE_CHECKPOINT"
msgid "There's a point in need of checking!"
msgstr "Dort ist ein Punkt, der kontrolliert werden muss!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.BOATRACE_CHECKPOINT_THROWABLE_DEPLOYKIT
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.BOATRACE_CHECKPOINT_THROWABLE_DEPLOYKIT"
msgid "Where should I place the next stop for the race?"
msgstr "Wo soll ich das platzieren, um einen Punkt fürs Rennen zu markieren?"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.BOATRACE_PRIMEMATE
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.BOATRACE_PRIMEMATE"
msgid "A challenger, I see. You won't catch me!"
msgstr "Ein Herausforderer kam zum Rennen herein. Du holst mich nicht ein!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.BOATRACE_SEASTACK
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.BOATRACE_SEASTACK"
msgid "Buoy ahoy!"
msgstr "Boje, ahoi!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.BOATRACE_SEASTACK_MONKEY
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.BOATRACE_SEASTACK_MONKEY"
msgid "Buoy ahoy!"
msgstr "Boje, ahoi!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.BOATRACE_SEASTACK_MONKEY_THROWABLE_DEPLOYKIT
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.BOATRACE_SEASTACK_MONKEY_THROWABLE_DEPLOYKIT"
msgid "Hyuyu, a bouncing baby buoy!"
msgstr "Hui, ein springende Babyboje!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.BOATRACE_SEASTACK_THROWABLE_DEPLOYKIT
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.BOATRACE_SEASTACK_THROWABLE_DEPLOYKIT"
msgid "Hyuyu, a bouncing baby buoy!"
msgstr "Hui, ein springende Babyboje!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.BOATRACE_SPECTATOR_DRAGONLING
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.BOATRACE_SPECTATOR_DRAGONLING"
msgid "Clap! Clap if you believe in me!"
msgstr "Klatsche! Klatsche, wenn du an mich glaubst!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.BOATRACE_START
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.BOATRACE_START"
msgid "The fun has just begun!"
msgstr "Lasset den Spaß beginnen!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.BOATRACE_START_THROWABLE_DEPLOYKIT
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.BOATRACE_START_THROWABLE_DEPLOYKIT"
msgid "Shall I get started?"
msgstr "Soll ich beginnen?"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.BOAT_ANCIENT_CONTAINER
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.BOAT_ANCIENT_CONTAINER"
msgid "To hide my prize from prying primate eyes."
msgstr "Ein prima Versteck vor Primaten."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.BOAT_ANCIENT_ITEM
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.BOAT_ANCIENT_ITEM"
msgid "This old boat will surely float!"
msgstr "Das alte Boot hat bestimmt ein Fahrverbot!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.BOAT_BUMPER_CRABKING
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.BOAT_BUMPER_CRABKING"
