#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.PIGELITEFIGHTER1
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.PIGELITEFIGHTER1"
msgid "Cool tattoos!"
msgstr "Coole Tätowierungen!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.PIGELITEFIGHTER2
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.PIGELITEFIGHTER2"
msgid "Yikes! He's angry."
msgstr "Mannomann! Der ist wütend."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.PIGELITEFIGHTER3
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.PIGELITEFIGHTER3"
msgid "Leave us alone!"
msgstr "Lass uns in Ruhe!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.PIGELITEFIGHTER4
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.PIGELITEFIGHTER4"
