msgid "Water-Logged"
msgstr "Durchnässte/r/s"

#. STRINGS.WET_PREFIX.GENERIC
msgctxt "STRINGS.WET_PREFIX.GENERIC"
msgid "Wet"
msgstr "Nasse/r/s"

#. STRINGS.WET_PREFIX.NONE
msgctxt "STRINGS.WET_PREFIX.NONE"
msgid ""
msgstr ""

#. STRINGS.WET_PREFIX.POUCH
msgctxt "STRINGS.WET_PREFIX.POUCH"
msgid "Soggy"
msgstr "Durchnässt"

#. STRINGS.WET_PREFIX.RABBITHOLE
msgctxt "STRINGS.WET_PREFIX.RABBITHOLE"
msgid "Collapsed"
msgstr "Zerstörtes"

#. STRINGS.WET_PREFIX.TOOL
msgctxt "STRINGS.WET_PREFIX.TOOL"
msgid "Slippery"
msgstr "Rutschige/r/s"

#. STRINGS.WET_PREFIX.WETGOOP
msgctxt "STRINGS.WET_PREFIX.WETGOOP"
msgid "Very"
msgstr "Sehr"

#. STRINGS.WET_PREFIX.WX78_FOODBRICK
msgctxt "STRINGS.WET_PREFIX.WX78_FOODBRICK"
msgid "Moistened"
msgstr "Befeuchtet"

#. STRINGS.WITHEREDITEM
msgctxt "STRINGS.WITHEREDITEM"
msgid "Withered"
msgstr "Welke/r/s"

#. STRINGS.WOBY_COMMANDS.COURIER
msgctxt "STRINGS.WOBY_COMMANDS.COURIER"
msgid "Deliver"
msgstr "Liefern"

#. STRINGS.WOBY_COMMANDS.FORAGING
msgctxt "STRINGS.WOBY_COMMANDS.FORAGING"
msgid "Foraging (on/off)"
