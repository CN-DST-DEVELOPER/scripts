msgstr "Anständige Süßigkeiten müssen an den Zähnen kleben."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.TALLBIRD
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.TALLBIRD"
msgid "Look at the legs on that one!"
msgstr "Schau dir die Beine an!"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.TALLBIRDEGG
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.TALLBIRDEGG"
msgid "You wanna be an omelet, don'tcha?"
msgstr "Du willst ein Omelett sein, stimmt's?"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.TALLBIRDEGG_COOKED
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.TALLBIRDEGG_COOKED"
msgid "Dinner!"
msgstr "Abendessen!"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.TALLBIRDEGG_CRACKED.COLD
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.TALLBIRDEGG_CRACKED.COLD"
msgid "This egg's gonna freeze over."
msgstr "Das Ei wird gefrieren."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.TALLBIRDEGG_CRACKED.GENERIC
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.TALLBIRDEGG_CRACKED.GENERIC"
msgid "This one just might hatch."
msgstr "Das da könnte schlüpfen."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.TALLBIRDEGG_CRACKED.HOT
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.TALLBIRDEGG_CRACKED.HOT"
msgid "It's sweating buckets."
msgstr "Schwitzt stark."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.TALLBIRDEGG_CRACKED.LONG
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.TALLBIRDEGG_CRACKED.LONG"
msgid "You've got your work cut out for ya, lil guy."
msgstr "Du hast ganz schön was zu tun, kleiner Freund."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.TALLBIRDEGG_CRACKED.SHORT
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.TALLBIRDEGG_CRACKED.SHORT"
msgid "I can see the beak!"
msgstr "Ich kann den Schnabel sehen!"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.TALLBIRDNEST.GENERIC
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.TALLBIRDNEST.GENERIC"
msgid "That looks mighty tasty."
msgstr "Das sieht lecker aus."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.TALLBIRDNEST.PICKED
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.TALLBIRDNEST.PICKED"
msgid "Someone's an empty nester."
msgstr "Das Nest ist leer."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.TALLEGGS
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.TALLEGGS"
