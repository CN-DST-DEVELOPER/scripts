msgstr "Auch mit diesen fischbraunen Latschen sollte man aufpassen, wohin man latscht."

#. STRINGS.SKIN_DESCRIPTIONS.feet_maryjanes_white_pure
msgctxt "STRINGS.SKIN_DESCRIPTIONS.feet_maryjanes_white_pure"
msgid "Hit the jackpot with these classic 'pure white' colored Mary Janes."
msgstr "Diese weißen Mary Janes sind klassisch und schmeicheln jedem Damenfuß."

#. STRINGS.SKIN_DESCRIPTIONS.feet_maryjanesp_white_pure
msgctxt "STRINGS.SKIN_DESCRIPTIONS.feet_maryjanesp_white_pure"
