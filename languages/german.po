msgstr "Pah! Warum ist die so kalt?"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.DUMBBELL_GEM
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.DUMBBELL_GEM"
msgid "Did he really need to make it so fancy?"
msgstr "Musste er das wirklich so ausgefallen gestalten?"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.DUMBBELL_GOLDEN
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.DUMBBELL_GOLDEN"
msgid "Did he really need to make it so fancy?"
msgstr "Musste er das wirklich so ausgefallen gestalten?"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.DUMBBELL_HEAT
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.DUMBBELL_HEAT"
