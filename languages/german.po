msgstr "Zäh."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FROGNEWTON
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FROGNEWTON"
msgid "This recipe has legs."
msgstr "Das Rezept hat Beine."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FROZENBANANADAIQUIRI
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FROZENBANANADAIQUIRI"
msgid "There are better beverages to make."
msgstr "Es gibt bessere Getränke, die man zubereiten könnte."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FRUITDRAGON.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FRUITDRAGON.GENERIC"
msgid "They aren't very sociable."
msgstr "Nicht gerade umgänglich."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FRUITDRAGON.RIPE
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FRUITDRAGON.RIPE"
msgid "I bet it's delicious."
msgstr "Bestimmt köstlich."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FRUITDRAGON.SLEEPING
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FRUITDRAGON.SLEEPING"
msgid "Sleep is only a temporary escape."
msgstr "Schlaf ist nur eine kurze Flucht."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FRUITFLY
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FRUITFLY"
msgid "Begone, pest!"
msgstr "Verschwinde, Ungeziefer!"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FRUITFLYFRUIT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FRUITFLYFRUIT"
msgid "So this is all it takes to lead."
msgstr "Das ist also alles, was man braucht, um zu führen."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FRUITMEDLEY
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FRUITMEDLEY"
