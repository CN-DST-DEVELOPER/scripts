msgid "Crash report failed to send"
msgstr "Crash-Report konnte nicht versendet werden"

#. STRINGS.EXTERNAL.CRASHREPORTER.IDS_SEND
msgctxt "STRINGS.EXTERNAL.CRASHREPORTER.IDS_SEND"
msgid "Send"
msgstr "Senden"

#. STRINGS.EXTERNAL.CRASHREPORTER.IDS_ERROR
msgctxt "STRINGS.EXTERNAL.CRASHREPORTER.IDS_ERROR"
msgid "Error"
msgstr "Fehler"

#. STRINGS.EXTERNAL.CRASHREPORTER.IDS_CANCEL
msgctxt "STRINGS.EXTERNAL.CRASHREPORTER.IDS_CANCEL"
msgid "Cancel"
msgstr "Abbrechen"

#. STRINGS.EXTERNAL.CRASHREPORTER.IDS_SUCCESS
msgctxt "STRINGS.EXTERNAL.CRASHREPORTER.IDS_SUCCESS"
msgid "Success"
msgstr "Erfolg"

#. STRINGS.EXTERNAL.CRASHREPORTER.IDS_SEND_SUCCESS
msgctxt "STRINGS.EXTERNAL.CRASHREPORTER.IDS_SEND_SUCCESS"
msgid "Crash report sent. Thank you!"
msgstr "Crash Report versendet. Vielen Dank!"

#. STRINGS.EXTERNAL.CRASHREPORTER.IDS_PRIVACY_DISCLAIMER
