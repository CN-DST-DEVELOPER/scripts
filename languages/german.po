msgstr "Er stinkt schon."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.ROCK_AVOCADO_BUSH.GENERIC
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.ROCK_AVOCADO_BUSH.GENERIC"
