msgstr "%s scheint heute reizbarer als sonst zu sein."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.WORMWOOD.FIRESTARTER
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.WORMWOOD.FIRESTARTER"
msgid "I thought you hated fire, %s."
msgstr "Ich dachte, du hasst Feuer, %s?"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.WORMWOOD.GENERIC
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.WORMWOOD.GENERIC"
msgid "Greetings, %s!"
msgstr "Sei gegrüßt, %s!"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.WORMWOOD.GHOST
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.WORMWOOD.GHOST"
msgid "You need some help, lil guy?"
msgstr "Brauchst du Hilfe, Kerlchen?"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.WORMWOOD.MURDERER
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.WORMWOOD.MURDERER"
msgid "Prepare to get weed whacked, %s!"
msgstr "Pass auf, dass du nichts abkriegst, %s!"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.WORMWOOD.REVIVER
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.WORMWOOD.REVIVER"
msgid "%s never gives up on his friends."
msgstr "%s würde niemals Freunde im Stich lassen."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.WORMWOOD_MUTANTPROXY_CARRAT.DEAD
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.WORMWOOD_MUTANTPROXY_CARRAT.DEAD"
