msgctxt "STRINGS.EXTERNAL.CRASHREPORTER.IDS_DLG_TITLE"
msgid "It appears Don't Starve Together has crashed.\nPlease visit our support page for fixes to common problems: <a>https://support.klei.com</a>"
msgstr "Anscheinend ist Don't Starve Together abgestürzt.\nAuf unserer Supportseite findest du Tipps zu den häufigsten Problemen: <a>https://support.klei.com</a>"

