msgstr "Hoffentlich ist sie mir gewogen."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.YOTC_CARRAT_SCALE_ITEM
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.YOTC_CARRAT_SCALE_ITEM"
