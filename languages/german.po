msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_SPOOKED"
msgid "Hey, that's not nice!"
msgstr "Hey, das ist nicht nett!"

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_TALK_TO_PLANTS.1
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_TALK_TO_PLANTS.1"
msgid "Hi plants! How do you do today?"
msgstr "Hey ihr Pflanzen! Wie geht's euch heute?"

