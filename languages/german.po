msgstr "Der Erdboden. Man steht darauf."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.TURF_VENT
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.TURF_VENT"
