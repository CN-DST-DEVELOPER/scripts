msgstr "Nicht gerade viel dran."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.OCEANFISH_SMALL_3
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.OCEANFISH_SMALL_3"
