msgstr "Sieht mir absolut brennbar aus."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.YOTC_CARRAT_RACE_CHECKPOINT_ITEM
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.YOTC_CARRAT_RACE_CHECKPOINT_ITEM"
