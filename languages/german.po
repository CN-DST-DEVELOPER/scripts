msgctxt "STRINGS.CHARACTERS.WENDY.ANNOUNCE_COACH.6"
msgid "only_used_by_wolfgang"
msgstr "only_used_by_wolfgang"

#. STRINGS.CHARACTERS.WENDY.ANNOUNCE_COACH.7
msgctxt "STRINGS.CHARACTERS.WENDY.ANNOUNCE_COACH.7"
msgid "only_used_by_wolfgang"
msgstr "only_used_by_wolfgang"

#. STRINGS.CHARACTERS.WENDY.ANNOUNCE_COACH.8
msgctxt "STRINGS.CHARACTERS.WENDY.ANNOUNCE_COACH.8"
msgid "only_used_by_wolfgang"
msgstr "only_used_by_wolfgang"

#. STRINGS.CHARACTERS.WENDY.ANNOUNCE_COACH.9
msgctxt "STRINGS.CHARACTERS.WENDY.ANNOUNCE_COACH.9"
msgid "only_used_by_wolfgang"
msgstr "only_used_by_wolfgang"

#. STRINGS.CHARACTERS.WENDY.ANNOUNCE_COLD
msgctxt "STRINGS.CHARACTERS.WENDY.ANNOUNCE_COLD"
msgid "I am chilled to the bone."
msgstr "Ich bin bis auf die Knochen ausgekühlt."

#. STRINGS.CHARACTERS.WENDY.ANNOUNCE_COMPASS_OUT
msgctxt "STRINGS.CHARACTERS.WENDY.ANNOUNCE_COMPASS_OUT"
msgid "It feels the force of the earth no more."
msgstr "Fühlt sich an, als hätten wir mehr Haare."

#. STRINGS.CHARACTERS.WENDY.ANNOUNCE_COZY_SLEEP
msgctxt "STRINGS.CHARACTERS.WENDY.ANNOUNCE_COZY_SLEEP"
msgid "Such a peaceful slumber... but now I must wake."
msgstr "Welch friedlicher Schlummer ... aber nun muss ich aufstehen."

#. STRINGS.CHARACTERS.WENDY.ANNOUNCE_CRAFTING_FAIL
msgctxt "STRINGS.CHARACTERS.WENDY.ANNOUNCE_CRAFTING_FAIL"
msgid "I lack the necessary materials."
msgstr "Mir fehlen die notwendigen Materialien."

#. STRINGS.CHARACTERS.WENDY.ANNOUNCE_DAMP
msgctxt "STRINGS.CHARACTERS.WENDY.ANNOUNCE_DAMP"
msgid "Soggy and sad."
msgstr "Durchnässt und traurig."

#. STRINGS.CHARACTERS.WENDY.ANNOUNCE_DEERCLOPS
msgctxt "STRINGS.CHARACTERS.WENDY.ANNOUNCE_DEERCLOPS"
msgid "That could be bad."
msgstr "Das konnte unangenehm werden."

#. STRINGS.CHARACTERS.WENDY.ANNOUNCE_DESPAWN
msgctxt "STRINGS.CHARACTERS.WENDY.ANNOUNCE_DESPAWN"
msgid "Abigail?"
msgstr "Abigail?"

#. STRINGS.CHARACTERS.WENDY.ANNOUNCE_DETACH_BUFF_ATTACK
msgctxt "STRINGS.CHARACTERS.WENDY.ANNOUNCE_DETACH_BUFF_ATTACK"
msgid "My strength is fading."
msgstr "Meine Stärke schwindet."

#. STRINGS.CHARACTERS.WENDY.ANNOUNCE_DETACH_BUFF_ELECTRICATTACK
msgctxt "STRINGS.CHARACTERS.WENDY.ANNOUNCE_DETACH_BUFF_ELECTRICATTACK"
msgid "The storm has passed."
msgstr "Der Sturm ist vorüber."

#. STRINGS.CHARACTERS.WENDY.ANNOUNCE_DETACH_BUFF_MOISTUREIMMUNITY
msgctxt "STRINGS.CHARACTERS.WENDY.ANNOUNCE_DETACH_BUFF_MOISTUREIMMUNITY"
msgid "Once more I'm left defenseless against the elements."
msgstr "Ich bin den Elementen wieder schutzlos preisgegeben."

#. STRINGS.CHARACTERS.WENDY.ANNOUNCE_DETACH_BUFF_PLAYERABSORPTION
msgctxt "STRINGS.CHARACTERS.WENDY.ANNOUNCE_DETACH_BUFF_PLAYERABSORPTION"
msgid "Ah. It couldn't last."
msgstr "Ah. Es konnte nicht von Dauer sein."

#. STRINGS.CHARACTERS.WENDY.ANNOUNCE_DETACH_BUFF_SLEEPRESISTANCE
msgctxt "STRINGS.CHARACTERS.WENDY.ANNOUNCE_DETACH_BUFF_SLEEPRESISTANCE"
msgid "I'm sorry... I'm getting so tired..."
msgstr "Es tut mir leid ... Ich werde so müde ..."

#. STRINGS.CHARACTERS.WENDY.ANNOUNCE_DETACH_BUFF_WORKEFFECTIVENESS
msgctxt "STRINGS.CHARACTERS.WENDY.ANNOUNCE_DETACH_BUFF_WORKEFFECTIVENESS"
msgid "It seems my zeal was short-lived."
msgstr "Mein Eifer war kurzlebig, wie es aussieht."

#. STRINGS.CHARACTERS.WENDY.ANNOUNCE_DIG_DISEASE_WARNING
msgctxt "STRINGS.CHARACTERS.WENDY.ANNOUNCE_DIG_DISEASE_WARNING"
msgid "Your death has been delayed another day."
msgstr "Dein Tod wurde um einen weiteren Tag verschoben."

#. STRINGS.CHARACTERS.WENDY.ANNOUNCE_DUSK
msgctxt "STRINGS.CHARACTERS.WENDY.ANNOUNCE_DUSK"
msgid "The sickly sweet scent of roses fills the air..."
msgstr "Der süßliche Duft von Rosen füllt die Luft ..."

#. STRINGS.CHARACTERS.WENDY.ANNOUNCE_EAT.GENERIC
msgctxt "STRINGS.CHARACTERS.WENDY.ANNOUNCE_EAT.GENERIC"
msgid "Yum!"
msgstr "MJAM!"

#. STRINGS.CHARACTERS.WENDY.ANNOUNCE_EAT.INVALID
msgctxt "STRINGS.CHARACTERS.WENDY.ANNOUNCE_EAT.INVALID"
msgid "I would never."
msgstr "Ich dachte, ich würde dich nie wieder sehen, alter Freund!"

#. STRINGS.CHARACTERS.WENDY.ANNOUNCE_EAT.PAINFUL
msgctxt "STRINGS.CHARACTERS.WENDY.ANNOUNCE_EAT.PAINFUL"
msgid "That was not edible."
msgstr "Das war nicht mehr essbar."

#. STRINGS.CHARACTERS.WENDY.ANNOUNCE_EAT.SPOILED
msgctxt "STRINGS.CHARACTERS.WENDY.ANNOUNCE_EAT.SPOILED"
msgid "That food was nearing the end of its lifetime."
msgstr "Diese Nahrung näherte sich dem Ende ihrer Lebensdauer."

#. STRINGS.CHARACTERS.WENDY.ANNOUNCE_EAT.STALE
msgctxt "STRINGS.CHARACTERS.WENDY.ANNOUNCE_EAT.STALE"
msgid "Was that stale?"
msgstr "War das verdorben?"

#. STRINGS.CHARACTERS.WENDY.ANNOUNCE_EAT.YUCKY
msgctxt "STRINGS.CHARACTERS.WENDY.ANNOUNCE_EAT.YUCKY"
msgid "I fear consuming that."
msgstr "Ich glaube, das kocht sich gleich selbst."

#. STRINGS.CHARACTERS.WENDY.ANNOUNCE_EATING_NOT_FEASTING
msgctxt "STRINGS.CHARACTERS.WENDY.ANNOUNCE_EATING_NOT_FEASTING"
msgid "Maybe I could... join in the feast..."
msgstr "Vielleicht könnte ich ... am Fest teilnehmen ..."

#. STRINGS.CHARACTERS.WENDY.ANNOUNCE_ELIXIR_BOOSTED
msgctxt "STRINGS.CHARACTERS.WENDY.ANNOUNCE_ELIXIR_BOOSTED"
msgid "All comfort is fleeting."
msgstr "Jeglicher Komfort ist flüchtig."

#. STRINGS.CHARACTERS.WENDY.ANNOUNCE_ELIXIR_GHOSTVISION
msgctxt "STRINGS.CHARACTERS.WENDY.ANNOUNCE_ELIXIR_GHOSTVISION"
msgid "My world is just as cold and dark without you, Abby."
msgstr "Meine Welt ist genauso kalt und dunkel ohne dich, Abby."

#. STRINGS.CHARACTERS.WENDY.ANNOUNCE_ELIXIR_PLAYER_SPEED
msgctxt "STRINGS.CHARACTERS.WENDY.ANNOUNCE_ELIXIR_PLAYER_SPEED"
msgid "My heart is still heavy."
msgstr "Mein Herzt hängt noch immer schwer."

#. STRINGS.CHARACTERS.WENDY.ANNOUNCE_ELIXIR_TOO_SUPER
msgctxt "STRINGS.CHARACTERS.WENDY.ANNOUNCE_ELIXIR_TOO_SUPER"
msgid "It's too much."
msgstr "Das ist zu heftig."

#. STRINGS.CHARACTERS.WENDY.ANNOUNCE_ENCUMBERED.1
msgctxt "STRINGS.CHARACTERS.WENDY.ANNOUNCE_ENCUMBERED.1"
msgid "I must carry... my own burden..."
msgstr "Ich muss ... meine eigene Last tragen ..."

#. STRINGS.CHARACTERS.WENDY.ANNOUNCE_ENCUMBERED.2
msgctxt "STRINGS.CHARACTERS.WENDY.ANNOUNCE_ENCUMBERED.2"
msgid "I don't... need help..."
msgstr "Ich brauche ... keine Hilfe ..."

#. STRINGS.CHARACTERS.WENDY.ANNOUNCE_ENCUMBERED.3
msgctxt "STRINGS.CHARACTERS.WENDY.ANNOUNCE_ENCUMBERED.3"
msgid "Life... is a trial..."
msgstr "Das Leben ... ist eine Prüfung ..."

#. STRINGS.CHARACTERS.WENDY.ANNOUNCE_ENCUMBERED.4
msgctxt "STRINGS.CHARACTERS.WENDY.ANNOUNCE_ENCUMBERED.4"
msgid "...huff..."
msgstr "... Uff ..."

#. STRINGS.CHARACTERS.WENDY.ANNOUNCE_ENCUMBERED.5
msgctxt "STRINGS.CHARACTERS.WENDY.ANNOUNCE_ENCUMBERED.5"
msgid "Hhnnfg..."
msgstr "Hhnnfg ..."

#. STRINGS.CHARACTERS.WENDY.ANNOUNCE_ENCUMBERED.6
msgctxt "STRINGS.CHARACTERS.WENDY.ANNOUNCE_ENCUMBERED.6"
msgid "...Suffering..."
msgstr "... Leidend ..."

#. STRINGS.CHARACTERS.WENDY.ANNOUNCE_ENCUMBERED.7
msgctxt "STRINGS.CHARACTERS.WENDY.ANNOUNCE_ENCUMBERED.7"
msgid "I'm... okay..."
msgstr "Mir geht's gut ..."

#. STRINGS.CHARACTERS.WENDY.ANNOUNCE_ENCUMBERED.8
msgctxt "STRINGS.CHARACTERS.WENDY.ANNOUNCE_ENCUMBERED.8"
msgid "Don't worry... Abby... I got it..."
msgstr "Macht nichts ... Abby ... Ich schaff es ..."

#. STRINGS.CHARACTERS.WENDY.ANNOUNCE_ENCUMBERED.9
msgctxt "STRINGS.CHARACTERS.WENDY.ANNOUNCE_ENCUMBERED.9"
msgid "My heart is heavy enough... without this..."
msgstr "Mein Herz ist schon schwer genug ... ohne dies ..."

#. STRINGS.CHARACTERS.WENDY.ANNOUNCE_ENGINEERING_CAN_DOWNGRADE
msgctxt "STRINGS.CHARACTERS.WENDY.ANNOUNCE_ENGINEERING_CAN_DOWNGRADE"
msgid "only_used_by_winona"
msgstr "only_used_by_winona"

#. STRINGS.CHARACTERS.WENDY.ANNOUNCE_ENGINEERING_CAN_SIDEGRADE
msgctxt "STRINGS.CHARACTERS.WENDY.ANNOUNCE_ENGINEERING_CAN_SIDEGRADE"
msgid "only_used_by_winona"
msgstr "only_used_by_winona"

#. STRINGS.CHARACTERS.WENDY.ANNOUNCE_ENGINEERING_CAN_UPGRADE
msgctxt "STRINGS.CHARACTERS.WENDY.ANNOUNCE_ENGINEERING_CAN_UPGRADE"
msgid "only_used_by_winona"
msgstr "only_used_by_winona"

#. STRINGS.CHARACTERS.WENDY.ANNOUNCE_ENTER_DARK
msgctxt "STRINGS.CHARACTERS.WENDY.ANNOUNCE_ENTER_DARK"
msgid "The darkness has swallowed me."
msgstr "Die Dunkelheit hat mich verschluckt."

#. STRINGS.CHARACTERS.WENDY.ANNOUNCE_ENTER_LIGHT
msgctxt "STRINGS.CHARACTERS.WENDY.ANNOUNCE_ENTER_LIGHT"
msgid "And there was light!"
msgstr "Und es ward Licht!"

#. STRINGS.CHARACTERS.WENDY.ANNOUNCE_EXIT_GELBLOB
msgctxt "STRINGS.CHARACTERS.WENDY.ANNOUNCE_EXIT_GELBLOB"
msgid "I don't prefer a slow death."
msgstr "Ich ziehe einen langsamen Tod nicht vor."

#. STRINGS.CHARACTERS.WENDY.ANNOUNCE_EYEOFTERROR_ARRIVE
msgctxt "STRINGS.CHARACTERS.WENDY.ANNOUNCE_EYEOFTERROR_ARRIVE"
msgid "The abyss gazes into me!"
msgstr "Der Abgrund starrt mich an!"

#. STRINGS.CHARACTERS.WENDY.ANNOUNCE_EYEOFTERROR_FLYAWAY
msgctxt "STRINGS.CHARACTERS.WENDY.ANNOUNCE_EYEOFTERROR_FLYAWAY"
msgid "It's gone. And alas, I'm still here."
msgstr "Weg. Und leider bin ich immer noch hier."

#. STRINGS.CHARACTERS.WENDY.ANNOUNCE_EYEOFTERROR_FLYBACK
msgctxt "STRINGS.CHARACTERS.WENDY.ANNOUNCE_EYEOFTERROR_FLYBACK"
msgid "There is never an end to the madness."
msgstr "Der Wahnsinn nimmt kein Ende."

#. STRINGS.CHARACTERS.WENDY.ANNOUNCE_FAN_OUT
msgctxt "STRINGS.CHARACTERS.WENDY.ANNOUNCE_FAN_OUT"
msgid "The fan has breathed its last."
msgstr "Der Ventilator geht nicht mehr."

#. STRINGS.CHARACTERS.WENDY.ANNOUNCE_FERTILIZER_RESEARCHED
msgctxt "STRINGS.CHARACTERS.WENDY.ANNOUNCE_FERTILIZER_RESEARCHED"
msgid "I suppose we will all be nourishment for plants one day."
msgstr "Ich nehme an, dass wir alle eines Tages Nahrung für Pflanzen sein werden."

#. STRINGS.CHARACTERS.WENDY.ANNOUNCE_FIRENETTLE_TOXIN.1
msgctxt "STRINGS.CHARACTERS.WENDY.ANNOUNCE_FIRENETTLE_TOXIN.1"
msgid "Why should my life be anything other than pain..."
msgstr "Warum sollte mein Leben etwas anderes sein als Schmerz ..."

#. STRINGS.CHARACTERS.WENDY.ANNOUNCE_FIRENETTLE_TOXIN.2
msgctxt "STRINGS.CHARACTERS.WENDY.ANNOUNCE_FIRENETTLE_TOXIN.2"
msgid "What a terrible poison... I feel as though I might burn up."
msgstr "Was für ein schreckliches Gift ... Ich habe das Gefühl, ich verbrenne."

#. STRINGS.CHARACTERS.WENDY.ANNOUNCE_FIRENETTLE_TOXIN_DONE
msgctxt "STRINGS.CHARACTERS.WENDY.ANNOUNCE_FIRENETTLE_TOXIN_DONE"
msgid "Alas, I still live."
msgstr "Weh mir! Ich lebe noch immer."

#. STRINGS.CHARACTERS.WENDY.ANNOUNCE_FLARE_SEEN
msgctxt "STRINGS.CHARACTERS.WENDY.ANNOUNCE_FLARE_SEEN"
msgid "Someone just shot a flare..."
msgstr "Jemand hat eine Signalrakete abgeschossen ..."

#. STRINGS.CHARACTERS.WENDY.ANNOUNCE_FLOATER_HELD
msgctxt "STRINGS.CHARACTERS.WENDY.ANNOUNCE_FLOATER_HELD"
msgid "What now?"
msgstr "Was nun?"

#. STRINGS.CHARACTERS.WENDY.ANNOUNCE_FLOATER_LETGO
msgctxt "STRINGS.CHARACTERS.WENDY.ANNOUNCE_FLOATER_LETGO"
msgid "It's time."
msgstr "Die Zeit ist gekommen."

#. STRINGS.CHARACTERS.WENDY.ANNOUNCE_FLOAT_SWIM_TIRED
msgctxt "STRINGS.CHARACTERS.WENDY.ANNOUNCE_FLOAT_SWIM_TIRED"
msgid "Just need a rest."
msgstr "Ich brauche nur eine Pause."

#. STRINGS.CHARACTERS.WENDY.ANNOUNCE_FOODMEMORY
msgctxt "STRINGS.CHARACTERS.WENDY.ANNOUNCE_FOODMEMORY"
msgid "only_used_by_warly"
msgstr "only_used_by_warly"

#. STRINGS.CHARACTERS.WENDY.ANNOUNCE_FREEDOM
msgctxt "STRINGS.CHARACTERS.WENDY.ANNOUNCE_FREEDOM"
msgid "Freedom. Great."
msgstr "Freiheit. Toll."

#. STRINGS.CHARACTERS.WENDY.ANNOUNCE_GATHER_MERM
msgctxt "STRINGS.CHARACTERS.WENDY.ANNOUNCE_GATHER_MERM"
msgid "only_used_by_wurt"
msgstr "only_used_by_wurt"

#. STRINGS.CHARACTERS.WENDY.ANNOUNCE_GHOSTDRAIN
msgctxt "STRINGS.CHARACTERS.WENDY.ANNOUNCE_GHOSTDRAIN"
msgid "The ghosts... Want to play..."
msgstr "Die Geister ... wollen spielen ..."

#. STRINGS.CHARACTERS.WENDY.ANNOUNCE_GHOSTLYBOND_LEVELUP.LEVEL2
msgctxt "STRINGS.CHARACTERS.WENDY.ANNOUNCE_GHOSTLYBOND_LEVELUP.LEVEL2"
msgid "You seem to have brightened up a bit, Abigail."
msgstr "Dir scheint es besser zu gehen, Abigail."

#. STRINGS.CHARACTERS.WENDY.ANNOUNCE_GHOSTLYBOND_LEVELUP.LEVEL3
msgctxt "STRINGS.CHARACTERS.WENDY.ANNOUNCE_GHOSTLYBOND_LEVELUP.LEVEL3"
msgid "Abigail has always been my guiding light in the darkness..."
msgstr "Abigail war immer mein Licht, das mich in der Dunkelheit führt ..."

#. STRINGS.CHARACTERS.WENDY.ANNOUNCE_GHOST_HINT
msgctxt "STRINGS.CHARACTERS.WENDY.ANNOUNCE_GHOST_HINT"
msgid "Are you showing me the way?"
msgstr "Zeigst du mir den Weg?"

#. STRINGS.CHARACTERS.WENDY.ANNOUNCE_GHOST_QUEST
msgctxt "STRINGS.CHARACTERS.WENDY.ANNOUNCE_GHOST_QUEST"
msgid "You need me to... find something you've lost?"
msgstr "Ich soll ... etwas finden, was du verloren hast?"

#. STRINGS.CHARACTERS.WENDY.ANNOUNCE_GHOST_TOY_NEAR.1
msgctxt "STRINGS.CHARACTERS.WENDY.ANNOUNCE_GHOST_TOY_NEAR.1"
msgid "It's close... I can feel it..."
msgstr "Es ist nahe ... Ich spüre es ..."

#. STRINGS.CHARACTERS.WENDY.ANNOUNCE_GHOST_TOY_NEAR.2
msgctxt "STRINGS.CHARACTERS.WENDY.ANNOUNCE_GHOST_TOY_NEAR.2"
msgid "It's calling to me... it's nearby..."
msgstr "Es ruft mich ... Es ist in der Nähe ..."

#. STRINGS.CHARACTERS.WENDY.ANNOUNCE_GHOST_TOY_NEAR.3
msgctxt "STRINGS.CHARACTERS.WENDY.ANNOUNCE_GHOST_TOY_NEAR.3"
msgid "We're almost there..."
msgstr "Wir haben es fast geschafft ..."

#. STRINGS.CHARACTERS.WENDY.ANNOUNCE_GHOST_TOY_NEAR.4
msgctxt "STRINGS.CHARACTERS.WENDY.ANNOUNCE_GHOST_TOY_NEAR.4"
msgid "Your journey is almost over."
msgstr "Deine Reise ist fast vorbei."

#. STRINGS.CHARACTERS.WENDY.ANNOUNCE_GHOST_TOY_NEAR.5
msgctxt "STRINGS.CHARACTERS.WENDY.ANNOUNCE_GHOST_TOY_NEAR.5"
msgid "Am I getting warmer?"
msgstr "Wird es hier wärmer?"

#. STRINGS.CHARACTERS.WENDY.ANNOUNCE_GOT_DECON_MISTED
msgctxt "STRINGS.CHARACTERS.WENDY.ANNOUNCE_GOT_DECON_MISTED"
msgid "Can it truly purge all the darkness from my heart?"
msgstr "Kann es wirklich all die Dunkelheit aus meinem Herzen vertreiben?"

#. STRINGS.CHARACTERS.WENDY.ANNOUNCE_HEALINGSALVE_ACIDBUFF_DONE
msgctxt "STRINGS.CHARACTERS.WENDY.ANNOUNCE_HEALINGSALVE_ACIDBUFF_DONE"
msgid "The acid rain may burn my flesh once more."
msgstr "Der Säureregen kann mein Fleisch abermals verbrennen."

#. STRINGS.CHARACTERS.WENDY.ANNOUNCE_HEALINGSALVE_FUMAROLEBUFF_DONE
msgctxt "STRINGS.CHARACTERS.WENDY.ANNOUNCE_HEALINGSALVE_FUMAROLEBUFF_DONE"
msgid "The flames may consume me once again."
msgstr "Die Flammen können mich nun wieder verschlingen."

#. STRINGS.CHARACTERS.WENDY.ANNOUNCE_HERMITCRAB_SHELL_ARRIVE
msgctxt "STRINGS.CHARACTERS.WENDY.ANNOUNCE_HERMITCRAB_SHELL_ARRIVE"
msgid "Here we are."
msgstr "Da sind wir."

#. STRINGS.CHARACTERS.WENDY.ANNOUNCE_HERMITCRAB_SHELL_BADTELEPORTPOINT
msgctxt "STRINGS.CHARACTERS.WENDY.ANNOUNCE_HERMITCRAB_SHELL_BADTELEPORTPOINT"
msgid "I'm still here..."
msgstr "Ich bin noch hier ..."

#. STRINGS.CHARACTERS.WENDY.ANNOUNCE_HIGHRESEARCH
msgctxt "STRINGS.CHARACTERS.WENDY.ANNOUNCE_HIGHRESEARCH"
msgid "I have seen the void and it is deep and dark."
msgstr "Ich habe die Leere gesehen und sie ist tief und dunkel."

#. STRINGS.CHARACTERS.WENDY.ANNOUNCE_HOT
msgctxt "STRINGS.CHARACTERS.WENDY.ANNOUNCE_HOT"
msgid "I am miserably hot."
msgstr "Mir ist elendig heiß."

#. STRINGS.CHARACTERS.WENDY.ANNOUNCE_HOUNDS
msgctxt "STRINGS.CHARACTERS.WENDY.ANNOUNCE_HOUNDS"
msgid "The hounds are baying."
msgstr "Die Hunde bellen."

#. STRINGS.CHARACTERS.WENDY.ANNOUNCE_HUNGRY
msgctxt "STRINGS.CHARACTERS.WENDY.ANNOUNCE_HUNGRY"
msgid "I am full of emptiness."
msgstr "Ich bin voller Leere."

#. STRINGS.CHARACTERS.WENDY.ANNOUNCE_HUNT_AVOID_FORK
msgctxt "STRINGS.CHARACTERS.WENDY.ANNOUNCE_HUNT_AVOID_FORK"
msgid "I suppose this trail would be safer. Sigh."
msgstr "Ich nehme an, dieser Pfad wäre sicherer. *Seufz*."

#. STRINGS.CHARACTERS.WENDY.ANNOUNCE_HUNT_BEAST_NEARBY
msgctxt "STRINGS.CHARACTERS.WENDY.ANNOUNCE_HUNT_BEAST_NEARBY"
msgid "I sense the beast's presence nearby."
msgstr "Ich spüre die Gegenwart der Bestie in der Nähe."

#. STRINGS.CHARACTERS.WENDY.ANNOUNCE_HUNT_LOST_TRAIL
msgctxt "STRINGS.CHARACTERS.WENDY.ANNOUNCE_HUNT_LOST_TRAIL"
msgid "This trail leads nowhere."
msgstr "Die Spur führt ins Nirgendwo."

#. STRINGS.CHARACTERS.WENDY.ANNOUNCE_HUNT_LOST_TRAIL_SPRING
msgctxt "STRINGS.CHARACTERS.WENDY.ANNOUNCE_HUNT_LOST_TRAIL_SPRING"
msgid "No trail, just a bunch of muck."
msgstr "Keine Spur, nur ein Haufen Dreck."

#. STRINGS.CHARACTERS.WENDY.ANNOUNCE_HUNT_START_FORK
msgctxt "STRINGS.CHARACTERS.WENDY.ANNOUNCE_HUNT_START_FORK"
msgid "This path reeks of danger and death. Shall we?"
msgstr "Dieser Pfad stinkt nach Gefahr. Wollen wir?"

#. STRINGS.CHARACTERS.WENDY.ANNOUNCE_HUNT_SUCCESSFUL_FORK
msgctxt "STRINGS.CHARACTERS.WENDY.ANNOUNCE_HUNT_SUCCESSFUL_FORK"
msgid "The creature hasn't seen me yet..."
msgstr "Die Kreatur hat mich noch nicht gesehen ..."

#. STRINGS.CHARACTERS.WENDY.ANNOUNCE_HUNT_WRONG_FORK
msgctxt "STRINGS.CHARACTERS.WENDY.ANNOUNCE_HUNT_WRONG_FORK"
msgid "Abigail? Was that you...?"
msgstr "Abigail? Warst du das ...?"

#. STRINGS.CHARACTERS.WENDY.ANNOUNCE_INSUFFICIENTFERTILIZER
msgctxt "STRINGS.CHARACTERS.WENDY.ANNOUNCE_INSUFFICIENTFERTILIZER"
msgid "It could use a bit more."
msgstr "Könnte ein bisschen mehr vertragen."

#. STRINGS.CHARACTERS.WENDY.ANNOUNCE_INV_FULL
msgctxt "STRINGS.CHARACTERS.WENDY.ANNOUNCE_INV_FULL"
msgid "I can carry no more."
msgstr "Ich kann nicht mehr tragen."

#. STRINGS.CHARACTERS.WENDY.ANNOUNCE_IS_FEASTING
msgctxt "STRINGS.CHARACTERS.WENDY.ANNOUNCE_IS_FEASTING"
msgid "This is... nice."
msgstr "Das ist ... nett."

#. STRINGS.CHARACTERS.WENDY.ANNOUNCE_KITCOON_FOUND_IN_THE_WILD
msgctxt "STRINGS.CHARACTERS.WENDY.ANNOUNCE_KITCOON_FOUND_IN_THE_WILD"
msgid "They've lost their way. Poor thing."
msgstr "Verirrt. Armes Ding."

#. STRINGS.CHARACTERS.WENDY.ANNOUNCE_KITCOON_HIDANDSEEK_FOUND.1
msgctxt "STRINGS.CHARACTERS.WENDY.ANNOUNCE_KITCOON_HIDANDSEEK_FOUND.1"
msgid "A lost soul, now found."
msgstr "Eine verlorene Seele, jetzt wurde sie wiedergefunden."

#. STRINGS.CHARACTERS.WENDY.ANNOUNCE_KITCOON_HIDANDSEEK_FOUND.2
msgctxt "STRINGS.CHARACTERS.WENDY.ANNOUNCE_KITCOON_HIDANDSEEK_FOUND.2"
msgid "We found them, Abigail!"
msgstr "Wir haben sie gefunden, Abigail!"

#. STRINGS.CHARACTERS.WENDY.ANNOUNCE_KITCOON_HIDANDSEEK_FOUND.3
msgctxt "STRINGS.CHARACTERS.WENDY.ANNOUNCE_KITCOON_HIDANDSEEK_FOUND.3"
msgid "Much like death, I'll always find you."
msgstr "So wie der Tod, werde ich dich immer finden."

#. STRINGS.CHARACTERS.WENDY.ANNOUNCE_KITCOON_HIDANDSEEK_FOUND.4
msgctxt "STRINGS.CHARACTERS.WENDY.ANNOUNCE_KITCOON_HIDANDSEEK_FOUND.4"
msgid "You only have yourself to blame. And your tail."
msgstr "Das hast du nur dir selbst zuzuschreiben. Und deinem Schwanz."

#. STRINGS.CHARACTERS.WENDY.ANNOUNCE_KITCOON_HIDANDSEEK_FOUND_LAST_ONE
msgctxt "STRINGS.CHARACTERS.WENDY.ANNOUNCE_KITCOON_HIDANDSEEK_FOUND_LAST_ONE"
msgid "We found them all, heeheehee!"
msgstr "Wir haben sie alle gefunden, heeheehee!"

#. STRINGS.CHARACTERS.WENDY.ANNOUNCE_KITCOON_HIDANDSEEK_FOUND_LAST_ONE_TEAM
msgctxt "STRINGS.CHARACTERS.WENDY.ANNOUNCE_KITCOON_HIDANDSEEK_FOUND_LAST_ONE_TEAM"
msgid "And just like that, the game is over."
msgstr "Und schon ist das Spiel vorbei."

#. STRINGS.CHARACTERS.WENDY.ANNOUNCE_KITCOON_HIDANDSEEK_FOUND_ONE_MORE
msgctxt "STRINGS.CHARACTERS.WENDY.ANNOUNCE_KITCOON_HIDANDSEEK_FOUND_ONE_MORE"
msgid "Do you think we'll win this, Abigail?"
msgstr "Glaubst du, dass wir das gewinnen werden, Abigail?"

#. STRINGS.CHARACTERS.WENDY.ANNOUNCE_KITCOON_HIDANDSEEK_LOSEGAME
msgctxt "STRINGS.CHARACTERS.WENDY.ANNOUNCE_KITCOON_HIDANDSEEK_LOSEGAME"
msgid "I wasted time, and now doth time waste me"
msgstr "Ich habe Zeit vertan, und jetzt werde ich von der Zeit vertan."

#. STRINGS.CHARACTERS.WENDY.ANNOUNCE_KITCOON_HIDANDSEEK_TIME_ALMOST_UP
msgctxt "STRINGS.CHARACTERS.WENDY.ANNOUNCE_KITCOON_HIDANDSEEK_TIME_ALMOST_UP"
msgid "Tick tock, goes the clock."
msgstr "Ticktack macht die Uhr."

#. STRINGS.CHARACTERS.WENDY.ANNOUNCE_KITCOON_HIDANDSEEK_TOOFAR
msgctxt "STRINGS.CHARACTERS.WENDY.ANNOUNCE_KITCOON_HIDANDSEEK_TOOFAR"
msgid "No, they wouldn't have come this far..."
msgstr "Nein, so weit können sie nicht gekommen sein ..."

#. STRINGS.CHARACTERS.WENDY.ANNOUNCE_KITCOON_HIDANDSEEK_TOOFAR_RETURN
msgctxt "STRINGS.CHARACTERS.WENDY.ANNOUNCE_KITCOON_HIDANDSEEK_TOOFAR_RETURN"
msgid "I return from life's edge."
msgstr "Ich kehre vom Abgrund des Lebens zurück."

#. STRINGS.CHARACTERS.WENDY.ANNOUNCE_KITCOON_HIDEANDSEEK_JOIN
msgctxt "STRINGS.CHARACTERS.WENDY.ANNOUNCE_KITCOON_HIDEANDSEEK_JOIN"
msgid "Abigail, they're playing hide and seek. Let's go!"
msgstr "Abigail, sie spielen Verstecken. Los geht's!"

#. STRINGS.CHARACTERS.WENDY.ANNOUNCE_KITCOON_HIDEANDSEEK_START
msgctxt "STRINGS.CHARACTERS.WENDY.ANNOUNCE_KITCOON_HIDEANDSEEK_START"
msgid "Let the games begin."
msgstr "Mögen die Spiele beginnen!"

#. STRINGS.CHARACTERS.WENDY.ANNOUNCE_KLAUS_CALLFORHELP
msgctxt "STRINGS.CHARACTERS.WENDY.ANNOUNCE_KLAUS_CALLFORHELP"
msgid "Your pleas will fall on deaf ears."
msgstr "Dein Flehen wird auf taube Ohren stoßen."

#. STRINGS.CHARACTERS.WENDY.ANNOUNCE_KLAUS_ENRAGE
msgctxt "STRINGS.CHARACTERS.WENDY.ANNOUNCE_KLAUS_ENRAGE"
msgid "Death walks among us."
msgstr "Der Tod geht unter uns."

#. STRINGS.CHARACTERS.WENDY.ANNOUNCE_KLAUS_UNCHAINED
msgctxt "STRINGS.CHARACTERS.WENDY.ANNOUNCE_KLAUS_UNCHAINED"
msgid "The beast returns unchained."
msgstr "Das Biest kehrt entfesselt zurück."

#. STRINGS.CHARACTERS.WENDY.ANNOUNCE_KNOCKEDOUT
msgctxt "STRINGS.CHARACTERS.WENDY.ANNOUNCE_KNOCKEDOUT"
msgid "Yet, again I wake to life. Sigh."
msgstr "Meine Güte, das tut weh!"

#. STRINGS.CHARACTERS.WENDY.ANNOUNCE_LIGHTNING_DAMAGE_AVOIDED
msgctxt "STRINGS.CHARACTERS.WENDY.ANNOUNCE_LIGHTNING_DAMAGE_AVOIDED"
msgid "So close to death, yet so far."
msgstr "So nah am Tod und doch so weit entfernt."

#. STRINGS.CHARACTERS.WENDY.ANNOUNCE_LIGHTSOUT_SHADOWHAND
msgctxt "STRINGS.CHARACTERS.WENDY.ANNOUNCE_LIGHTSOUT_SHADOWHAND"
msgid "Like the death's own hand, come to snuff our fragile flame."
msgstr "Wie die Hand des Todes selbst, die kommt, um unsere zerbrechliche Flamme zu löschen."

#. STRINGS.CHARACTERS.WENDY.ANNOUNCE_LOWRESEARCH
msgctxt "STRINGS.CHARACTERS.WENDY.ANNOUNCE_LOWRESEARCH"
msgid "Pithy knowledge..."
msgstr "Wissen ist Macht!"

#. STRINGS.CHARACTERS.WENDY.ANNOUNCE_LUNARGUARDIAN_INCOMING
msgctxt "STRINGS.CHARACTERS.WENDY.ANNOUNCE_LUNARGUARDIAN_INCOMING"
msgid "It remembers."
msgstr "Es erinnert sich!"

#. STRINGS.CHARACTERS.WENDY.ANNOUNCE_LUNARHAIL_BIRD_CORPSES
msgctxt "STRINGS.CHARACTERS.WENDY.ANNOUNCE_LUNARHAIL_BIRD_CORPSES"
msgid "Birds of a feather fall together."
msgstr "Feder zu Feder, Staub zu Staub."

#. STRINGS.CHARACTERS.WENDY.ANNOUNCE_LUNARHAIL_BIRD_SOUNDS
msgctxt "STRINGS.CHARACTERS.WENDY.ANNOUNCE_LUNARHAIL_BIRD_SOUNDS"
msgid "Those birds are singing their last."
msgstr "Diese Vögel singen ihr letztes Lied."

#. STRINGS.CHARACTERS.WENDY.ANNOUNCE_LUNAR_RIFT_MAX
msgctxt "STRINGS.CHARACTERS.WENDY.ANNOUNCE_LUNAR_RIFT_MAX"
msgid "I can see a light..."
msgstr "Ich kann ein Licht sehen …"

#. STRINGS.CHARACTERS.WENDY.ANNOUNCE_MAX_CLOCKWORKS
msgctxt "STRINGS.CHARACTERS.WENDY.ANNOUNCE_MAX_CLOCKWORKS"
msgid "This one will be left behind."
msgstr "Das hier wird zurückgelassen."

#. STRINGS.CHARACTERS.WENDY.ANNOUNCE_MEGA_FLARE_SEEN
msgctxt "STRINGS.CHARACTERS.WENDY.ANNOUNCE_MEGA_FLARE_SEEN"
msgid "The poor soul who shot that flare... they've sealed their own fate."
msgstr "Die arme Seele, die diese Signalrakete abgefeuert hat … Sie hat ihr Schicksal besiegelt."

#. STRINGS.CHARACTERS.WENDY.ANNOUNCE_MITEGLAND_DEBUFF.1
msgctxt "STRINGS.CHARACTERS.WENDY.ANNOUNCE_MITEGLAND_DEBUFF.1"
msgid "I'm burning with fever..."
msgstr "Ich brenne vor Fieber ..."

#. STRINGS.CHARACTERS.WENDY.ANNOUNCE_MITEGLAND_DEBUFF.2
msgctxt "STRINGS.CHARACTERS.WENDY.ANNOUNCE_MITEGLAND_DEBUFF.2"
msgid "It's burning in my stomach..."
msgstr "Es brennt in meinem Magen ..."

#. STRINGS.CHARACTERS.WENDY.ANNOUNCE_MITEGLAND_DEBUFF_DONE
msgctxt "STRINGS.CHARACTERS.WENDY.ANNOUNCE_MITEGLAND_DEBUFF_DONE"
msgid "I survived. Oh well, there's always next time."
msgstr "Ich habe überlebt. Na ja, es gibt ja immer ein nächstes Mal."

#. STRINGS.CHARACTERS.WENDY.ANNOUNCE_MONKEY_CURSE_1
msgctxt "STRINGS.CHARACTERS.WENDY.ANNOUNCE_MONKEY_CURSE_1"
msgid "I feel... strange..."
msgstr "Ich fühle mich ... seltsam ..."

#. STRINGS.CHARACTERS.WENDY.ANNOUNCE_MONKEY_CURSE_CHANGE
msgctxt "STRINGS.CHARACTERS.WENDY.ANNOUNCE_MONKEY_CURSE_CHANGE"
msgid "Don't laugh at me Abigail! It's not funny!"
msgstr "Lach mich nicht aus, Abigail! Das ist nicht witzig!"

#. STRINGS.CHARACTERS.WENDY.ANNOUNCE_MONKEY_CURSE_CHANGEBACK
msgctxt "STRINGS.CHARACTERS.WENDY.ANNOUNCE_MONKEY_CURSE_CHANGEBACK"
msgid "I never imagined being glad to be myself..."
msgstr "Ich hätte nie gedacht, dass ich mal froh bin, ich selbst zu sein ..."

#. STRINGS.CHARACTERS.WENDY.ANNOUNCE_MOONALTAR_MINE.GLASS_LOW
msgctxt "STRINGS.CHARACTERS.WENDY.ANNOUNCE_MOONALTAR_MINE.GLASS_LOW"
msgid "Almost."
msgstr "Fast."

#. STRINGS.CHARACTERS.WENDY.ANNOUNCE_MOONALTAR_MINE.GLASS_MED
msgctxt "STRINGS.CHARACTERS.WENDY.ANNOUNCE_MOONALTAR_MINE.GLASS_MED"
msgid "I'll get you out..."
msgstr "Ich hole dich da raus ..."

#. STRINGS.CHARACTERS.WENDY.ANNOUNCE_MOONALTAR_MINE.GLASS_REVEAL
msgctxt "STRINGS.CHARACTERS.WENDY.ANNOUNCE_MOONALTAR_MINE.GLASS_REVEAL"
msgid "There."
msgstr "Na also."

#. STRINGS.CHARACTERS.WENDY.ANNOUNCE_MOONALTAR_MINE.IDOL_LOW
msgctxt "STRINGS.CHARACTERS.WENDY.ANNOUNCE_MOONALTAR_MINE.IDOL_LOW"
msgid "Almost."
msgstr "Fast."

#. STRINGS.CHARACTERS.WENDY.ANNOUNCE_MOONALTAR_MINE.IDOL_MED
msgctxt "STRINGS.CHARACTERS.WENDY.ANNOUNCE_MOONALTAR_MINE.IDOL_MED"
msgid "I'll get you out..."
msgstr "Ich hole dich da raus ..."

#. STRINGS.CHARACTERS.WENDY.ANNOUNCE_MOONALTAR_MINE.IDOL_REVEAL
msgctxt "STRINGS.CHARACTERS.WENDY.ANNOUNCE_MOONALTAR_MINE.IDOL_REVEAL"
msgid "There."
msgstr "Na also."

#. STRINGS.CHARACTERS.WENDY.ANNOUNCE_MOONALTAR_MINE.SEED_LOW
msgctxt "STRINGS.CHARACTERS.WENDY.ANNOUNCE_MOONALTAR_MINE.SEED_LOW"
msgid "Almost."
msgstr "Fast."

#. STRINGS.CHARACTERS.WENDY.ANNOUNCE_MOONALTAR_MINE.SEED_MED
msgctxt "STRINGS.CHARACTERS.WENDY.ANNOUNCE_MOONALTAR_MINE.SEED_MED"
msgid "I'll get you out..."
msgstr "Ich hole dich da raus ..."

#. STRINGS.CHARACTERS.WENDY.ANNOUNCE_MOONALTAR_MINE.SEED_REVEAL
msgctxt "STRINGS.CHARACTERS.WENDY.ANNOUNCE_MOONALTAR_MINE.SEED_REVEAL"
msgid "There."
msgstr "Na also."

#. STRINGS.CHARACTERS.WENDY.ANNOUNCE_MOONPOTION_FAILED
msgctxt "STRINGS.CHARACTERS.WENDY.ANNOUNCE_MOONPOTION_FAILED"
msgid "Sigh... I didn't really expect that to work."
msgstr "Seufz ... Ich habe ja wohl nicht im Ernst erwartet, dass das klappt."

#. STRINGS.CHARACTERS.WENDY.ANNOUNCE_MOSQUITOS
msgctxt "STRINGS.CHARACTERS.WENDY.ANNOUNCE_MOSQUITOS"
msgid "Mosquitoes! Let my veins be a feast!"
msgstr "Stechmücken! Labt euch an meinen Adern!"

#. STRINGS.CHARACTERS.WENDY.ANNOUNCE_MOUNT_LOWHEALTH
msgctxt "STRINGS.CHARACTERS.WENDY.ANNOUNCE_MOUNT_LOWHEALTH"
msgid "This beast... is not long for this world."
msgstr "Dieses Tier ... wird nicht mehr lange auf dieser Welt sein."

#. STRINGS.CHARACTERS.WENDY.ANNOUNCE_MUTATED_BUZZARD_ARRIVAL
msgctxt "STRINGS.CHARACTERS.WENDY.ANNOUNCE_MUTATED_BUZZARD_ARRIVAL"
msgid "Buzzards. Something off about them."
msgstr "Bussarde. Etwas stimmt mit ihnen nicht."

#. STRINGS.CHARACTERS.WENDY.ANNOUNCE_NODANGERGIFT
msgctxt "STRINGS.CHARACTERS.WENDY.ANNOUNCE_NODANGERGIFT"
msgid "There's no time for presents, death has finally come for me!"
msgstr "Es bleibt keine Zeit für Geschenke. Der Tod hat mich nun endlich eingeholt!"

#. STRINGS.CHARACTERS.WENDY.ANNOUNCE_NODANGERSIESTA
msgctxt "STRINGS.CHARACTERS.WENDY.ANNOUNCE_NODANGERSIESTA"
msgid "I couldn't possibly nap. Death is nigh."
msgstr "Ich könnte unmöglich schlafen. Der Tod ist nah."

#. STRINGS.CHARACTERS.WENDY.ANNOUNCE_NODANGERSLEEP
msgctxt "STRINGS.CHARACTERS.WENDY.ANNOUNCE_NODANGERSLEEP"
msgid "I can't sleep, there's death to be had."
msgstr "Ich kann nicht schlafen. Der Tod muss überlistet werden."

#. STRINGS.CHARACTERS.WENDY.ANNOUNCE_NODAYSLEEP
msgctxt "STRINGS.CHARACTERS.WENDY.ANNOUNCE_NODAYSLEEP"
msgid "The sun upsets me. I couldn't possibly sleep."
msgstr "Die Sonne nervt mich. Ich kann nicht schlafen."

#. STRINGS.CHARACTERS.WENDY.ANNOUNCE_NODAYSLEEP_CAVE
msgctxt "STRINGS.CHARACTERS.WENDY.ANNOUNCE_NODAYSLEEP_CAVE"
msgid "I'm not tired yet."
msgstr "Ich bin noch nicht müde."

#. STRINGS.CHARACTERS.WENDY.ANNOUNCE_NOHUNGERSIESTA
msgctxt "STRINGS.CHARACTERS.WENDY.ANNOUNCE_NOHUNGERSIESTA"
msgid "My stomach is as empty as my heart. I can't nap now."
msgstr "Mein Magen ist so leer wie mein Herz. Ich kann so kein Nickerchen machen."

#. STRINGS.CHARACTERS.WENDY.ANNOUNCE_NOHUNGERSLEEP
msgctxt "STRINGS.CHARACTERS.WENDY.ANNOUNCE_NOHUNGERSLEEP"
msgid "My stomach is as empty as my heart. I can't sleep now."
msgstr "Mein Magen ist so leer wie mein Herz. Ich kann jetzt nicht schlafen."

#. STRINGS.CHARACTERS.WENDY.ANNOUNCE_NOMOUNTEDGIFT
msgctxt "STRINGS.CHARACTERS.WENDY.ANNOUNCE_NOMOUNTEDGIFT"
msgid "Can someone help me down... I have a present to open."
msgstr "Kann mir jemand runter helfen ... Ich muss ein Geschenk öffnen."

#. STRINGS.CHARACTERS.WENDY.ANNOUNCE_NONIGHTSIESTA
msgctxt "STRINGS.CHARACTERS.WENDY.ANNOUNCE_NONIGHTSIESTA"
msgid "I'd really rather be in a tent."
msgstr "Ich wäre wirklich lieber in einem Zelt."

#. STRINGS.CHARACTERS.WENDY.ANNOUNCE_NONIGHTSIESTA_CAVE
msgctxt "STRINGS.CHARACTERS.WENDY.ANNOUNCE_NONIGHTSIESTA_CAVE"
msgid "I'd really rather be in a tent."
msgstr "Ich wäre wirklich lieber in einem Zelt."

#. STRINGS.CHARACTERS.WENDY.ANNOUNCE_NOPUMPKINCARVINGONFIRE
msgctxt "STRINGS.CHARACTERS.WENDY.ANNOUNCE_NOPUMPKINCARVINGONFIRE"
msgid "Oh well."
msgstr "Na ja."

#. STRINGS.CHARACTERS.WENDY.ANNOUNCE_NOSLEEPHASPERMANENTLIGHT
msgctxt "STRINGS.CHARACTERS.WENDY.ANNOUNCE_NOSLEEPHASPERMANENTLIGHT"
msgid "I can't sleep if I'm not surrounded by darkness."
msgstr "Ich kann nicht schlafen, wenn ich nicht von Dunkelheit umgeben bin."

#. STRINGS.CHARACTERS.WENDY.ANNOUNCE_NOSLEEPONFIRE
msgctxt "STRINGS.CHARACTERS.WENDY.ANNOUNCE_NOSLEEPONFIRE"
msgid "That'd be quite the way to go out."
msgstr "Das wäre durchaus ein Weg aus dem Leben zu treten."

#. STRINGS.CHARACTERS.WENDY.ANNOUNCE_NOWARDROBEONFIRE
msgctxt "STRINGS.CHARACTERS.WENDY.ANNOUNCE_NOWARDROBEONFIRE"
msgid "Sadly, it is ablaze."
msgstr "Leider ist es in Flammen."

#. STRINGS.CHARACTERS.WENDY.ANNOUNCE_NO_ABIGAIL_FLOWER
msgctxt "STRINGS.CHARACTERS.WENDY.ANNOUNCE_NO_ABIGAIL_FLOWER"
msgid "I need Abby's flower to pour it on."
msgstr "Ich brauch Abbys Blume, um es draufzuschütten."

#. STRINGS.CHARACTERS.WENDY.ANNOUNCE_NO_TRAP
msgctxt "STRINGS.CHARACTERS.WENDY.ANNOUNCE_NO_TRAP"
msgid "I was expecting great difficulty."
msgstr "Das habe große Probleme erwartet."

#. STRINGS.CHARACTERS.WENDY.ANNOUNCE_OCEANFISHING_BADCAST
msgctxt "STRINGS.CHARACTERS.WENDY.ANNOUNCE_OCEANFISHING_BADCAST"
msgid "Sigh. Of course."
msgstr "Seufz. Natürlich."

#. STRINGS.CHARACTERS.WENDY.ANNOUNCE_OCEANFISHING_GOTAWAY
msgctxt "STRINGS.CHARACTERS.WENDY.ANNOUNCE_OCEANFISHING_GOTAWAY"
msgid "It can't evade death forever."
msgstr "Er wird dem Tod nicht ewig entgehen."

#. STRINGS.CHARACTERS.WENDY.ANNOUNCE_OCEANFISHING_IDLE_QUOTE.1
msgctxt "STRINGS.CHARACTERS.WENDY.ANNOUNCE_OCEANFISHING_IDLE_QUOTE.1"
msgid "It's not like I have anything better to do."
msgstr "Ist ja nicht, als hätte ich was Besseres zu tun."

#. STRINGS.CHARACTERS.WENDY.ANNOUNCE_OCEANFISHING_IDLE_QUOTE.2
msgctxt "STRINGS.CHARACTERS.WENDY.ANNOUNCE_OCEANFISHING_IDLE_QUOTE.2"
msgid "I suppose I'll just starve."
msgstr "Vermutlich werde ich einfach verhungern."

#. STRINGS.CHARACTERS.WENDY.ANNOUNCE_OCEANFISHING_IDLE_QUOTE.3
msgctxt "STRINGS.CHARACTERS.WENDY.ANNOUNCE_OCEANFISHING_IDLE_QUOTE.3"
msgid "Perhaps I will be standing here forever."
msgstr "Vielleicht stehe ich nun für immer hier."

#. STRINGS.CHARACTERS.WENDY.ANNOUNCE_OCEANFISHING_IDLE_QUOTE.4
msgctxt "STRINGS.CHARACTERS.WENDY.ANNOUNCE_OCEANFISHING_IDLE_QUOTE.4"
msgid "Fishing is rather dull, I don't know why people enjoy it."
msgstr "Angeln ist ganz schön langweilig. Keine Ahnung, was die Leute daran finden."

#. STRINGS.CHARACTERS.WENDY.ANNOUNCE_OCEANFISHING_LINESNAP
msgctxt "STRINGS.CHARACTERS.WENDY.ANNOUNCE_OCEANFISHING_LINESNAP"
msgid "Ah. Predictable."
msgstr "Ah. Vorhersehbar."

#. STRINGS.CHARACTERS.WENDY.ANNOUNCE_OCEANFISHING_LINETOOLOOSE
msgctxt "STRINGS.CHARACTERS.WENDY.ANNOUNCE_OCEANFISHING_LINETOOLOOSE"
msgid "My line is too loose."
msgstr "Meine Schnur hängt zu sehr durch."

#. STRINGS.CHARACTERS.WENDY.ANNOUNCE_OCEAN_SILHOUETTE_INCOMING
msgctxt "STRINGS.CHARACTERS.WENDY.ANNOUNCE_OCEAN_SILHOUETTE_INCOMING"
msgid "Death casts its black shadow upon us."
msgstr "Der Tod wirft seinen schwarzen Schatten auf uns."

#. STRINGS.CHARACTERS.WENDY.ANNOUNCE_OFF_SCRIPT
msgctxt "STRINGS.CHARACTERS.WENDY.ANNOUNCE_OFF_SCRIPT"
msgid "Just one little mistake..."
msgstr "Nur ein kleiner Fehler …"

#. STRINGS.CHARACTERS.WENDY.ANNOUNCE_OTTERBOAT_DENBROKEN
msgctxt "STRINGS.CHARACTERS.WENDY.ANNOUNCE_OTTERBOAT_DENBROKEN"
msgid "Everything is falling apart. Like usual."
msgstr "Alles zerfällt. Wie üblich."

#. STRINGS.CHARACTERS.WENDY.ANNOUNCE_OTTERBOAT_OUTOFSHALLOWS
msgctxt "STRINGS.CHARACTERS.WENDY.ANNOUNCE_OTTERBOAT_OUTOFSHALLOWS"
msgid "It won't survive these rough waters... perhaps I won't either."
msgstr "Er wird diese rauen Gewässer nicht überleben ... ich vielleicht auch nicht."

#. STRINGS.CHARACTERS.WENDY.ANNOUNCE_PECKED
msgctxt "STRINGS.CHARACTERS.WENDY.ANNOUNCE_PECKED"
msgid "You try my patience."
msgstr "Du strapazierst meine Geduld."

#. STRINGS.CHARACTERS.WENDY.ANNOUNCE_PETRIFED_TREES
msgctxt "STRINGS.CHARACTERS.WENDY.ANNOUNCE_PETRIFED_TREES"
msgid "A wave of sadness just washed over me...?"
msgstr "Eine Welle der Traurigkeit überkam mich ..."

#. STRINGS.CHARACTERS.WENDY.ANNOUNCE_PICK_DISEASE_WARNING
msgctxt "STRINGS.CHARACTERS.WENDY.ANNOUNCE_PICK_DISEASE_WARNING"
msgid "Smells like death."
msgstr "Riecht nach Tod."

#. STRINGS.CHARACTERS.WENDY.ANNOUNCE_PIRATES_ARRIVE
msgctxt "STRINGS.CHARACTERS.WENDY.ANNOUNCE_PIRATES_ARRIVE"
msgid "Nowhere to run... they're here."
msgstr "Kein Entrinnen ... sie sind da."

#. STRINGS.CHARACTERS.WENDY.ANNOUNCE_PLANT_RANDOMSEED
msgctxt "STRINGS.CHARACTERS.WENDY.ANNOUNCE_PLANT_RANDOMSEED"
msgid "It is buried. I wonder what will grow."
msgstr "Die Saat ist bestattet. Was daraus wohl wächst?"

#. STRINGS.CHARACTERS.WENDY.ANNOUNCE_PLANT_RESEARCHED.1
msgctxt "STRINGS.CHARACTERS.WENDY.ANNOUNCE_PLANT_RESEARCHED.1"
msgid "Well, I've learned a little more. Even if it won't do me any good."
msgstr "Nun, ich habe ein bisschen mehr gelernt. Auch wenn es mir nichts nützen wird."

#. STRINGS.CHARACTERS.WENDY.ANNOUNCE_POCKETWATCH_PORTAL
msgctxt "STRINGS.CHARACTERS.WENDY.ANNOUNCE_POCKETWATCH_PORTAL"
msgid "It looks like I survived the journey. Oh well, there's always next time."
msgstr "Sieht aus, als hätte ich die Reise überlebt. Na ja, es gibt immer ein nächstes Mal."

#. STRINGS.CHARACTERS.WENDY.ANNOUNCE_PREFALLINVOID
msgctxt "STRINGS.CHARACTERS.WENDY.ANNOUNCE_PREFALLINVOID"
msgid "It's fine..."
msgstr "Das ist in Ordnung ..."

#. STRINGS.CHARACTERS.WENDY.ANNOUNCE_QUAKE
msgctxt "STRINGS.CHARACTERS.WENDY.ANNOUNCE_QUAKE"
msgid "The ground shakes. Will it swallow me whole?"
msgstr "Der Boden bebt. Wird er mich verschlucken?"

#. STRINGS.CHARACTERS.WENDY.ANNOUNCE_RABBITKINGHORN_BADSPAWNPOINT
msgctxt "STRINGS.CHARACTERS.WENDY.ANNOUNCE_RABBITKINGHORN_BADSPAWNPOINT"
msgid "Not here."
msgstr "Hier nicht."

#. STRINGS.CHARACTERS.WENDY.ANNOUNCE_RABBITKING_AGGRESSIVE
msgctxt "STRINGS.CHARACTERS.WENDY.ANNOUNCE_RABBITKING_AGGRESSIVE"
msgid "Something clawing it's way back from the grave?"
msgstr "Etwas, das sich seinen Weg aus dem Grab zurückkämpft?"

#. STRINGS.CHARACTERS.WENDY.ANNOUNCE_RABBITKING_LUCKY
msgctxt "STRINGS.CHARACTERS.WENDY.ANNOUNCE_RABBITKING_LUCKY"
msgid "That's an unusual rabbit."
msgstr "Das ist ein ungewöhnliches Kaninchen."

#. STRINGS.CHARACTERS.WENDY.ANNOUNCE_RABBITKING_LUCKYCAUGHT
msgctxt "STRINGS.CHARACTERS.WENDY.ANNOUNCE_RABBITKING_LUCKYCAUGHT"
msgid "Got it!"
msgstr "Hab's!"

#. STRINGS.CHARACTERS.WENDY.ANNOUNCE_RABBITKING_PASSIVE
msgctxt "STRINGS.CHARACTERS.WENDY.ANNOUNCE_RABBITKING_PASSIVE"
msgid "A gentle creature approaches."
msgstr "Eine sanfte Kreatur nähert sich."

#. STRINGS.CHARACTERS.WENDY.ANNOUNCE_REPELLED
msgctxt "STRINGS.CHARACTERS.WENDY.ANNOUNCE_REPELLED"
msgid "It has spirits to protect it..."
msgstr "Hat Geister, die es schützen ..."

#. STRINGS.CHARACTERS.WENDY.ANNOUNCE_RESEARCH
msgctxt "STRINGS.CHARACTERS.WENDY.ANNOUNCE_RESEARCH"
msgid "I now possess greater knowledge of this terrible world."
msgstr "Jetzt weiß ich mehr über diese schreckliche Welt."

#. STRINGS.CHARACTERS.WENDY.ANNOUNCE_REVIVED_FROM_CORPSE
msgctxt "STRINGS.CHARACTERS.WENDY.ANNOUNCE_REVIVED_FROM_CORPSE"
msgid "Thank-you..."
msgstr "Danke ..."

#. STRINGS.CHARACTERS.WENDY.ANNOUNCE_REVIVED_OTHER_CORPSE
msgctxt "STRINGS.CHARACTERS.WENDY.ANNOUNCE_REVIVED_OTHER_CORPSE"
msgid "All done."
msgstr "Alles erledigt."

#. STRINGS.CHARACTERS.WENDY.ANNOUNCE_REVIVING_CORPSE
msgctxt "STRINGS.CHARACTERS.WENDY.ANNOUNCE_REVIVING_CORPSE"
msgid "You'll not glimpse death today..."
msgstr "Heute wirst den Tod nicht zu sehen bekommen ..."

#. STRINGS.CHARACTERS.WENDY.ANNOUNCE_ROYALTY.1
msgctxt "STRINGS.CHARACTERS.WENDY.ANNOUNCE_ROYALTY.1"
msgid "Your Majesty."
msgstr "Eure Majestät."

#. STRINGS.CHARACTERS.WENDY.ANNOUNCE_ROYALTY.2
msgctxt "STRINGS.CHARACTERS.WENDY.ANNOUNCE_ROYALTY.2"
msgid "Your Highness."
msgstr "Eure Hoheit."

#. STRINGS.CHARACTERS.WENDY.ANNOUNCE_ROYALTY.3
msgctxt "STRINGS.CHARACTERS.WENDY.ANNOUNCE_ROYALTY.3"
msgid "My kingdom for another day with her."
msgstr "Mein Königreich für einen Tag mit ihr."

#. STRINGS.CHARACTERS.WENDY.ANNOUNCE_ROYALTY_JOKER.1
msgctxt "STRINGS.CHARACTERS.WENDY.ANNOUNCE_ROYALTY_JOKER.1"
msgid "I'm not in the mood for jokes."
msgstr "Ich bin nicht in Stimmung für Witze."

#. STRINGS.CHARACTERS.WENDY.ANNOUNCE_ROYALTY_JOKER.2
msgctxt "STRINGS.CHARACTERS.WENDY.ANNOUNCE_ROYALTY_JOKER.2"
msgid "Thanks for trying."
msgstr "Danke für den Versuch."

#. STRINGS.CHARACTERS.WENDY.ANNOUNCE_ROYALTY_JOKER.3
msgctxt "STRINGS.CHARACTERS.WENDY.ANNOUNCE_ROYALTY_JOKER.3"
msgid "I only laugh to be polite."
msgstr "Ich lache nur, um höflich zu sein."

#. STRINGS.CHARACTERS.WENDY.ANNOUNCE_RUINS_RESET
msgctxt "STRINGS.CHARACTERS.WENDY.ANNOUNCE_RUINS_RESET"
msgid "The dead are risen."
msgstr "Die Toten sind auferstanden."

#. STRINGS.CHARACTERS.WENDY.ANNOUNCE_SACREDCHEST_NO
msgctxt "STRINGS.CHARACTERS.WENDY.ANNOUNCE_SACREDCHEST_NO"
msgid "We failed... again..."
msgstr "Wieder einmal ... versagt ..."

#. STRINGS.CHARACTERS.WENDY.ANNOUNCE_SACREDCHEST_YES
msgctxt "STRINGS.CHARACTERS.WENDY.ANNOUNCE_SACREDCHEST_YES"
msgid "It accepted our items."
msgstr "Hat unsere Dinge angenommen."

#. STRINGS.CHARACTERS.WENDY.ANNOUNCE_SCRAPBOOK_FULL
msgctxt "STRINGS.CHARACTERS.WENDY.ANNOUNCE_SCRAPBOOK_FULL"
msgid "Nothing more will fit in my scrapbook."
msgstr "In mein Sammelalbum passt nichts mehr rein."

#. STRINGS.CHARACTERS.WENDY.ANNOUNCE_SECURITY_PULSE_FOLLOWING
msgctxt "STRINGS.CHARACTERS.WENDY.ANNOUNCE_SECURITY_PULSE_FOLLOWING"
msgid "Seems we have a new friend, Abigail."
msgstr "Es sieht so aus, als hätten wir eine neue Freundin, Abigail."

#. STRINGS.CHARACTERS.WENDY.ANNOUNCE_SHADOWTHRALL_STEALTH
msgctxt "STRINGS.CHARACTERS.WENDY.ANNOUNCE_SHADOWTHRALL_STEALTH"
msgid "Show yourself. I've seen worse."
msgstr "Zeig dich mir. Ich habe schon Schlimmeres gesehen."

#. STRINGS.CHARACTERS.WENDY.ANNOUNCE_SHADOW_RIFT_MAX
msgctxt "STRINGS.CHARACTERS.WENDY.ANNOUNCE_SHADOW_RIFT_MAX"
msgid "That glow... does it lead to my doom?"
msgstr "Dieses Leuchten … führt es mich in meinen Tod?"

#. STRINGS.CHARACTERS.WENDY.ANNOUNCE_SHELTER
msgctxt "STRINGS.CHARACTERS.WENDY.ANNOUNCE_SHELTER"
msgid "Nature is good for something after all."
msgstr "Die Natur ist schließlich doch für etwas gut."

#. STRINGS.CHARACTERS.WENDY.ANNOUNCE_SISTURN_FULL
msgctxt "STRINGS.CHARACTERS.WENDY.ANNOUNCE_SISTURN_FULL"
msgid "Now Abigail can find her way back to me faster."
msgstr "Jetzt findet Abigail schneller zurück zu mir."

#. STRINGS.CHARACTERS.WENDY.ANNOUNCE_SISTURN_FULL_BLOSSOM
msgctxt "STRINGS.CHARACTERS.WENDY.ANNOUNCE_SISTURN_FULL_BLOSSOM"
msgid "This might be as close as we've ever come, Abigail."
msgstr "Möglicherweise werde ich Abigail niemals näher kommen als hiermit."

#. STRINGS.CHARACTERS.WENDY.ANNOUNCE_SISTURN_FULL_EVIL
msgctxt "STRINGS.CHARACTERS.WENDY.ANNOUNCE_SISTURN_FULL_EVIL"
msgid "This gives me goosebumps. I hope it was worth it."
msgstr "Davon bekomme ich Gänsehaut. Ich hoffe, das war es wert."

#. STRINGS.CHARACTERS.WENDY.ANNOUNCE_SNARED
msgctxt "STRINGS.CHARACTERS.WENDY.ANNOUNCE_SNARED"
msgid "I am caged!"
msgstr "Ich bin eingesperrt!"

#. STRINGS.CHARACTERS.WENDY.ANNOUNCE_SNARED_IVY
msgctxt "STRINGS.CHARACTERS.WENDY.ANNOUNCE_SNARED_IVY"
msgid "I suppose this is how it ends..."
msgstr "So geht es also dann zu Ende ..."

#. STRINGS.CHARACTERS.WENDY.ANNOUNCE_SNOWBALL_NO_SNOW
msgctxt "STRINGS.CHARACTERS.WENDY.ANNOUNCE_SNOWBALL_NO_SNOW"
msgid "The ground lies barren, stripped of its winter coat."
msgstr "Der Erdboden ist karg und seiner Winterdecke beraubt."

#. STRINGS.CHARACTERS.WENDY.ANNOUNCE_SNOWBALL_TOO_BIG
msgctxt "STRINGS.CHARACTERS.WENDY.ANNOUNCE_SNOWBALL_TOO_BIG"
msgid "There's no use rolling it more."
msgstr "Es ist zwecklos, ihn weiterzurollen."

#. STRINGS.CHARACTERS.WENDY.ANNOUNCE_SOAKED
msgctxt "STRINGS.CHARACTERS.WENDY.ANNOUNCE_SOAKED"
msgid "A veritable apocalypse of water."
msgstr "Eine Apokalypse des Wassers."

#. STRINGS.CHARACTERS.WENDY.ANNOUNCE_SPOOKED
msgctxt "STRINGS.CHARACTERS.WENDY.ANNOUNCE_SPOOKED"
msgid "Yuck!"
msgstr "Igitt!"

#. STRINGS.CHARACTERS.WENDY.ANNOUNCE_TALK_TO_PLANTS.1
msgctxt "STRINGS.CHARACTERS.WENDY.ANNOUNCE_TALK_TO_PLANTS.1"
msgid "Abigail was the one who loved the garden. She would have been better at this than me."
msgstr "Abigail war diejenige, die den Garten geliebt hat. Sie hätte das besser gekonnt als ich."

#. STRINGS.CHARACTERS.WENDY.ANNOUNCE_TALK_TO_PLANTS.2
msgctxt "STRINGS.CHARACTERS.WENDY.ANNOUNCE_TALK_TO_PLANTS.2"
msgid "Go on then, grow if you must."
msgstr "Na schön, dann wachse eben, wenn es sein muss."

#. STRINGS.CHARACTERS.WENDY.ANNOUNCE_TALK_TO_PLANTS.3
msgctxt "STRINGS.CHARACTERS.WENDY.ANNOUNCE_TALK_TO_PLANTS.3"
msgid "I'll try to make your fleeting time in this world as comfortable as I can."
msgstr "Ich werde versuchen, deine kurze Zeit in dieser Welt so angenehm wie möglich zu machen."

#. STRINGS.CHARACTERS.WENDY.ANNOUNCE_TALK_TO_PLANTS.4
msgctxt "STRINGS.CHARACTERS.WENDY.ANNOUNCE_TALK_TO_PLANTS.4"
msgid "It must be so lonely, being stuck in the ground..."
msgstr "Es muss so einsam sein, unter der Erde festzusitzen ..."

#. STRINGS.CHARACTERS.WENDY.ANNOUNCE_TALK_TO_PLANTS.5
msgctxt "STRINGS.CHARACTERS.WENDY.ANNOUNCE_TALK_TO_PLANTS.5"
msgid "Shall I stay and talk with you for a while?"
msgstr "Soll ich noch eine Weile bleiben und mit dir reden?"

#. STRINGS.CHARACTERS.WENDY.ANNOUNCE_THORNS
msgctxt "STRINGS.CHARACTERS.WENDY.ANNOUNCE_THORNS"
msgid "Ow! Prickly, like me."
msgstr "Au! Stachelig wie ich."

#. STRINGS.CHARACTERS.WENDY.ANNOUNCE_THURIBLE_OUT
msgctxt "STRINGS.CHARACTERS.WENDY.ANNOUNCE_THURIBLE_OUT"
msgid "A blessing in disguise."
msgstr "Vielleicht gar nicht so schlecht."

#. STRINGS.CHARACTERS.WENDY.ANNOUNCE_TICOON_ABANDONED
msgctxt "STRINGS.CHARACTERS.WENDY.ANNOUNCE_TICOON_ABANDONED"
msgid "This must be where we part ways. Goodbye."
msgstr "Hier trennen sich wohl unsere Wege. Auf Wiedersehen."

#. STRINGS.CHARACTERS.WENDY.ANNOUNCE_TICOON_DEAD
msgctxt "STRINGS.CHARACTERS.WENDY.ANNOUNCE_TICOON_DEAD"
msgid "No, don't leave me...!"
msgstr "Nein ... verlass mich nicht!"

#. STRINGS.CHARACTERS.WENDY.ANNOUNCE_TICOON_GET_LEADER_ATTENTION
msgctxt "STRINGS.CHARACTERS.WENDY.ANNOUNCE_TICOON_GET_LEADER_ATTENTION"
msgid "He would like me to follow, so I shall."
msgstr "Er möchte, dass ich ihm folge, also werde ich es tun."

#. STRINGS.CHARACTERS.WENDY.ANNOUNCE_TICOON_LOST_KITCOON
msgctxt "STRINGS.CHARACTERS.WENDY.ANNOUNCE_TICOON_LOST_KITCOON"
msgid "I've arrived a moment too late. Sigh..."
msgstr "Ich bin einen Moment zu spät gekommen. Seufz ..."

#. STRINGS.CHARACTERS.WENDY.ANNOUNCE_TICOON_NEAR_KITCOON
msgctxt "STRINGS.CHARACTERS.WENDY.ANNOUNCE_TICOON_NEAR_KITCOON"
msgid "I don't think we're alone here."
msgstr "Ich glaube nicht, dass wir hier allein sind."

#. STRINGS.CHARACTERS.WENDY.ANNOUNCE_TICOON_NOTHING_TO_TRACK
msgctxt "STRINGS.CHARACTERS.WENDY.ANNOUNCE_TICOON_NOTHING_TO_TRACK"
msgid "Their scent lingers here no longer."
msgstr "Ihr Geruch verweilt hier nicht länger."

#. STRINGS.CHARACTERS.WENDY.ANNOUNCE_TICOON_START_TRACKING
msgctxt "STRINGS.CHARACTERS.WENDY.ANNOUNCE_TICOON_START_TRACKING"
msgid "He knows where they are, we should follow."
msgstr "Er weiß, wo sie sind, wir sollten ihm folgen."

#. STRINGS.CHARACTERS.WENDY.ANNOUNCE_TICOON_WAITING_FOR_LEADER
msgctxt "STRINGS.CHARACTERS.WENDY.ANNOUNCE_TICOON_WAITING_FOR_LEADER"
msgid "He waits in gloom for me, I should return."
msgstr "Er wartet in Finsternis auf mich, ich sollte zurückkehren."

#. STRINGS.CHARACTERS.WENDY.ANNOUNCE_TOADESCAPED
msgctxt "STRINGS.CHARACTERS.WENDY.ANNOUNCE_TOADESCAPED"
msgid "It's gone. The earth swallowed it whole..."
msgstr "Weg. Komplett verschluckt von der Erde ..."

#. STRINGS.CHARACTERS.WENDY.ANNOUNCE_TOADESCAPING
msgctxt "STRINGS.CHARACTERS.WENDY.ANNOUNCE_TOADESCAPING"
msgid "I hope it doesn't try to escape..."
msgstr "Versucht hoffentlich nicht zu entkommen ..."

#. STRINGS.CHARACTERS.WENDY.ANNOUNCE_TOOL_SLIP
msgctxt "STRINGS.CHARACTERS.WENDY.ANNOUNCE_TOOL_SLIP"
msgid "Oh well, I didn't need it anyways."
msgstr "Okay, ich brauchte das eh nicht mehr."

#. STRINGS.CHARACTERS.WENDY.ANNOUNCE_TOOL_TOOWEAK
msgctxt "STRINGS.CHARACTERS.WENDY.ANNOUNCE_TOOL_TOOWEAK"
msgid "It's not strong enough... like me..."
msgstr "Es ist nicht stark genug ... Genau wie ich ..."

#. STRINGS.CHARACTERS.WENDY.ANNOUNCE_TORCH_OUT
msgctxt "STRINGS.CHARACTERS.WENDY.ANNOUNCE_TORCH_OUT"
msgid "Darkness has returned!"
msgstr "Die Dunkelheit ist zurückgekehrt!"

#. STRINGS.CHARACTERS.WENDY.ANNOUNCE_TOWNPORTALTELEPORT
msgctxt "STRINGS.CHARACTERS.WENDY.ANNOUNCE_TOWNPORTALTELEPORT"
msgid "Did I die?"
msgstr "Bin ich gestorben?"

#. STRINGS.CHARACTERS.WENDY.ANNOUNCE_TRAP_WENT_OFF
msgctxt "STRINGS.CHARACTERS.WENDY.ANNOUNCE_TRAP_WENT_OFF"
msgid "Oh, goodness."
msgstr "Ach, du meine Güte!"

#. STRINGS.CHARACTERS.WENDY.ANNOUNCE_UNIMPLEMENTED
msgctxt "STRINGS.CHARACTERS.WENDY.ANNOUNCE_UNIMPLEMENTED"
msgid "Ouch. That was unnecessary."
msgstr "Autsch! Der ist nicht nötig."

#. STRINGS.CHARACTERS.WENDY.ANNOUNCE_VAULT_SHADOW_ASSIST
msgctxt "STRINGS.CHARACTERS.WENDY.ANNOUNCE_VAULT_SHADOW_ASSIST"
msgid "Strange... I wonder what price we shall pay for this assistance."
msgstr "Seltsam ... Ich frage mich, welchen Preis wir für diese Hilfe zahlen müssen."

#. STRINGS.CHARACTERS.WENDY.ANNOUNCE_VAULT_TELEPORTER_DOES_NOTHING
msgctxt "STRINGS.CHARACTERS.WENDY.ANNOUNCE_VAULT_TELEPORTER_DOES_NOTHING"
msgid "What now?"
msgstr "Was jetzt?"

#. STRINGS.CHARACTERS.WENDY.ANNOUNCE_WASHED_ASHORE
msgctxt "STRINGS.CHARACTERS.WENDY.ANNOUNCE_WASHED_ASHORE"
msgid "Oh good... I lived."
msgstr "Großartig ... ich habe überlebt."

#. STRINGS.CHARACTERS.WENDY.ANNOUNCE_WEAK_RAT
msgctxt "STRINGS.CHARACTERS.WENDY.ANNOUNCE_WEAK_RAT"
msgid "The poor creature is too far gone."
msgstr "Die arme Kreatur ist schon zu schwach."

#. STRINGS.CHARACTERS.WENDY.ANNOUNCE_WEAPON_TOOWEAK
msgctxt "STRINGS.CHARACTERS.WENDY.ANNOUNCE_WEAPON_TOOWEAK"
msgid "This is futile. I need something stronger."
msgstr "Das ist sinnlos. Ich brauche etwas Stärkeres."

#. STRINGS.CHARACTERS.WENDY.ANNOUNCE_WEIGHT
msgctxt "STRINGS.CHARACTERS.WENDY.ANNOUNCE_WEIGHT"
msgid "Weight: {weight}"
msgstr "Gewicht: {weight}."

#. STRINGS.CHARACTERS.WENDY.ANNOUNCE_WEIGHT_HEAVY
msgctxt "STRINGS.CHARACTERS.WENDY.ANNOUNCE_WEIGHT_HEAVY"
msgid "Weight: {weight}\nBurdened with yet another terrible weight..."
msgstr "Gewicht: {weight}\nUnd noch ein schreckliches Gewicht ..."

#. STRINGS.CHARACTERS.WENDY.ANNOUNCE_WENDY_BABYSITTER_SET
msgctxt "STRINGS.CHARACTERS.WENDY.ANNOUNCE_WENDY_BABYSITTER_SET"
msgid "I'll come back for you, Abby."
msgstr "Ich werde für dich zurückkommen, Abby."

#. STRINGS.CHARACTERS.WENDY.ANNOUNCE_WENDY_BABYSITTER_STOP
msgctxt "STRINGS.CHARACTERS.WENDY.ANNOUNCE_WENDY_BABYSITTER_STOP"
msgid "Abby, let's go!"
msgstr "Abby, los geht's!"

#. STRINGS.CHARACTERS.WENDY.ANNOUNCE_WET
msgctxt "STRINGS.CHARACTERS.WENDY.ANNOUNCE_WET"
msgid "Even wetter than when I cry myself to sleep."
msgstr "Mehr Wasser als ich jemals geheult habe."

#. STRINGS.CHARACTERS.WENDY.ANNOUNCE_WETTER
msgctxt "STRINGS.CHARACTERS.WENDY.ANNOUNCE_WETTER"
msgid "An eternity of moisture and sorrow."
msgstr "Eine Ewigkeit von Feuchtigkeit und Leid."

#. STRINGS.CHARACTERS.WENDY.ANNOUNCE_WINCH_CLAW_MISS
msgctxt "STRINGS.CHARACTERS.WENDY.ANNOUNCE_WINCH_CLAW_MISS"
msgid "Everything always seems just out of my grasp..."
msgstr "Immer muss alles außer Reichweite sein ..."

#. STRINGS.CHARACTERS.WENDY.ANNOUNCE_WINCH_CLAW_NO_ITEM
msgctxt "STRINGS.CHARACTERS.WENDY.ANNOUNCE_WINCH_CLAW_NO_ITEM"
msgid "Just emptiness."
msgstr "Nur Leere."

#. STRINGS.CHARACTERS.WENDY.ANNOUNCE_WINTERS_FEAST_BUFF
msgctxt "STRINGS.CHARACTERS.WENDY.ANNOUNCE_WINTERS_FEAST_BUFF"
msgid "I feel... warm..."
msgstr "Mir ist ... warm ..."

#. STRINGS.CHARACTERS.WENDY.ANNOUNCE_WINTERS_FEAST_BUFF_OVER
msgctxt "STRINGS.CHARACTERS.WENDY.ANNOUNCE_WINTERS_FEAST_BUFF_OVER"
msgid "Everything fades."
msgstr "Alles verblasst."

#. STRINGS.CHARACTERS.WENDY.ANNOUNCE_WOLFGANG_BEGIN_COACHING
msgctxt "STRINGS.CHARACTERS.WENDY.ANNOUNCE_WOLFGANG_BEGIN_COACHING"
msgid "only_used_by_wolfgang"
msgstr "only_used_by_wolfgang"

#. STRINGS.CHARACTERS.WENDY.ANNOUNCE_WOLFGANG_END_COACHING
msgctxt "STRINGS.CHARACTERS.WENDY.ANNOUNCE_WOLFGANG_END_COACHING"
msgid "only_used_by_wolfgang"
msgstr "only_used_by_wolfgang"

#. STRINGS.CHARACTERS.WENDY.ANNOUNCE_WOLFGANG_MIGHTY_COACHING
msgctxt "STRINGS.CHARACTERS.WENDY.ANNOUNCE_WOLFGANG_MIGHTY_COACHING"
msgid "only_used_by_wolfgang"
msgstr "only_used_by_wolfgang"

#. STRINGS.CHARACTERS.WENDY.ANNOUNCE_WOLFGANG_NOTEAM.1
msgctxt "STRINGS.CHARACTERS.WENDY.ANNOUNCE_WOLFGANG_NOTEAM.1"
msgid "only_used_by_wolfgang"
msgstr "only_used_by_wolfgang"

#. STRINGS.CHARACTERS.WENDY.ANNOUNCE_WOLFGANG_NOTEAM.2
msgctxt "STRINGS.CHARACTERS.WENDY.ANNOUNCE_WOLFGANG_NOTEAM.2"
msgid "only_used_by_wolfgang"
msgstr "only_used_by_wolfgang"

#. STRINGS.CHARACTERS.WENDY.ANNOUNCE_WOLFGANG_NOTEAM.3
msgctxt "STRINGS.CHARACTERS.WENDY.ANNOUNCE_WOLFGANG_NOTEAM.3"
msgid "only_used_by_wolfgang"
msgstr "only_used_by_wolfgang"

#. STRINGS.CHARACTERS.WENDY.ANNOUNCE_WOLFGANG_WIMPY_COACHING
msgctxt "STRINGS.CHARACTERS.WENDY.ANNOUNCE_WOLFGANG_WIMPY_COACHING"
msgid "only_used_by_wolfgang"
msgstr "only_used_by_wolfgang"

#. STRINGS.CHARACTERS.WENDY.ANNOUNCE_WORMHOLE
msgctxt "STRINGS.CHARACTERS.WENDY.ANNOUNCE_WORMHOLE"
msgid "I emerge into this world once more."
msgstr "Und wieder tauche ich auf dieser Welt auf."

#. STRINGS.CHARACTERS.WENDY.ANNOUNCE_WORMS
msgctxt "STRINGS.CHARACTERS.WENDY.ANNOUNCE_WORMS"
msgid "Uh-oh. I think we should leave."
msgstr "Auweh. Ich glaube, wir sollten gehen."

#. STRINGS.CHARACTERS.WENDY.ANNOUNCE_WORMS_BOSS
msgctxt "STRINGS.CHARACTERS.WENDY.ANNOUNCE_WORMS_BOSS"
msgid "We need to go. Now."
msgstr "Wir müssen gehen. Jetzt."

#. STRINGS.CHARACTERS.WENDY.ANNOUNCE_WORTOX_REVIVER_FAILTELEPORT
msgctxt "STRINGS.CHARACTERS.WENDY.ANNOUNCE_WORTOX_REVIVER_FAILTELEPORT"
msgid "That got us nowhere."
msgstr "Das hat uns nirgendwo hingebracht."

#. STRINGS.CHARACTERS.WENDY.ANNOUNCE_WX_SCANNER_NEW_FOUND
msgctxt "STRINGS.CHARACTERS.WENDY.ANNOUNCE_WX_SCANNER_NEW_FOUND"
msgid "only_used_by_wx78"
msgstr "only_used_by_wx78"

#. STRINGS.CHARACTERS.WENDY.ANNOUNCE_YOTB_LEARN_NEW_PATTERN
msgctxt "STRINGS.CHARACTERS.WENDY.ANNOUNCE_YOTB_LEARN_NEW_PATTERN"
msgid "Oh. Maybe I could try making this new costume..."
msgstr "Oh ... Vielleicht könnte ich versuchen, dieses neue Kostüm zu machen ..."

#. STRINGS.CHARACTERS.WENDY.ANNOUNCE_YOTD_NOBOATS
msgctxt "STRINGS.CHARACTERS.WENDY.ANNOUNCE_YOTD_NOBOATS"
msgid "The starting point is too far away..."
msgstr "Der Startpunkt ist zu weit weg ..."

#. STRINGS.CHARACTERS.WENDY.ANNOUNCE_YOTD_NOCHECKPOINTS
msgctxt "STRINGS.CHARACTERS.WENDY.ANNOUNCE_YOTD_NOCHECKPOINTS"
msgid "No checkpoints... I suppose I can't do anything right."
msgstr "Keine Kontrollpunkte ... Ich kann wohl gar nichts richtig machen."

#. STRINGS.CHARACTERS.WENDY.ANNOUNCE_YOTD_NOTENOUGHBOATS
msgctxt "STRINGS.CHARACTERS.WENDY.ANNOUNCE_YOTD_NOTENOUGHBOATS"
msgid "This place is too cluttered... there's hardly room to breathe..."
msgstr "Dieser Ort ist so unordentlich ... hier gibt es kaum Platz zum Atmen ..."

#. STRINGS.CHARACTERS.WENDY.ANNOUNCE_YOTH_ONCOOLDOWN
msgctxt "STRINGS.CHARACTERS.WENDY.ANNOUNCE_YOTH_ONCOOLDOWN"
msgid "The knights must not be ready to return yet."
msgstr "Die Ritter sind wohl noch nicht bereit, zurückzukehren."

#. STRINGS.CHARACTERS.WENDY.ANOUNCE_MUTATED_BIRD_ATTACK
msgctxt "STRINGS.CHARACTERS.WENDY.ANOUNCE_MUTATED_BIRD_ATTACK"
msgid "Let them come."
msgstr "Lass sie kommen."

#. STRINGS.CHARACTERS.WENDY.BATTLECRY.DEER
msgctxt "STRINGS.CHARACTERS.WENDY.BATTLECRY.DEER"
msgid "Your life is mine!"
msgstr "Dein Leben gehört mir!"

#. STRINGS.CHARACTERS.WENDY.BATTLECRY.GENERIC
msgctxt "STRINGS.CHARACTERS.WENDY.BATTLECRY.GENERIC"
msgid "Death will find you!"
msgstr "Der Tod wird dich finden."

#. STRINGS.CHARACTERS.WENDY.BATTLECRY.PIG
msgctxt "STRINGS.CHARACTERS.WENDY.BATTLECRY.PIG"
msgid "Let death embrace you!"
msgstr "Lass dich vom Tod umarmen!"

#. STRINGS.CHARACTERS.WENDY.BATTLECRY.PREY
msgctxt "STRINGS.CHARACTERS.WENDY.BATTLECRY.PREY"
msgid "Suffer, worm!"
msgstr "Leide, Wurm!"

#. STRINGS.CHARACTERS.WENDY.BATTLECRY.SPIDER
msgctxt "STRINGS.CHARACTERS.WENDY.BATTLECRY.SPIDER"
msgid "I shall send you to the other side!"
msgstr "Ich sollte dich auf die andere Seite schicken!"

#. STRINGS.CHARACTERS.WENDY.BATTLECRY.SPIDER_WARRIOR
msgctxt "STRINGS.CHARACTERS.WENDY.BATTLECRY.SPIDER_WARRIOR"
msgid "I will be your end!"
msgstr "Ich werde dein Ende sein!"

#. STRINGS.CHARACTERS.WENDY.COMBAT_QUIT.GENERIC
msgctxt "STRINGS.CHARACTERS.WENDY.COMBAT_QUIT.GENERIC"
msgid "You shall live. For now."
msgstr "Du sollst leben. Vorerst."

#. STRINGS.CHARACTERS.WENDY.COMBAT_QUIT.PIG
msgctxt "STRINGS.CHARACTERS.WENDY.COMBAT_QUIT.PIG"
msgid "You've eluded death today, beast."
msgstr "Heute bist du dem Tod noch einmal entkommen!"

#. STRINGS.CHARACTERS.WENDY.COMBAT_QUIT.PREY
msgctxt "STRINGS.CHARACTERS.WENDY.COMBAT_QUIT.PREY"
msgid "You'll appreciate the gift of life better now."
msgstr "Jetzt wirst du besser verstehen, dass das Leben ein Geschenk ist."

#. STRINGS.CHARACTERS.WENDY.COMBAT_QUIT.SPIDER
msgctxt "STRINGS.CHARACTERS.WENDY.COMBAT_QUIT.SPIDER"
msgid "You should be thankful I'm sparing you."
msgstr "Sei dankbar, dass ich dich verschone."

#. STRINGS.CHARACTERS.WENDY.COMBAT_QUIT.SPIDER_WARRIOR
msgctxt "STRINGS.CHARACTERS.WENDY.COMBAT_QUIT.SPIDER_WARRIOR"
msgid "I won't forget this."
msgstr "Schade. Badehose vergessen."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.ABIGAIL.LEVEL1.1
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.ABIGAIL.LEVEL1.1"
msgid "It was so lonely without you here."
msgstr "Es war so einsam ohne dich hier."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.ABIGAIL.LEVEL1.2
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.ABIGAIL.LEVEL1.2"
msgid "That's my twin sister, Abigail."
msgstr "Das ist meine Zwillingsschwester, Abigail."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.ABIGAIL.LEVEL2.1
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.ABIGAIL.LEVEL2.1"
msgid "We'll never be apart again."
msgstr "Wir werden uns nie wieder trennen."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.ABIGAIL.LEVEL2.2
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.ABIGAIL.LEVEL2.2"
msgid "That's my twin sister, Abigail."
msgstr "Das ist meine Zwillingsschwester, Abigail."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.ABIGAIL.LEVEL3.1
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.ABIGAIL.LEVEL3.1"
msgid "Let's play, Abigail!"
msgstr "Spielen wir, Abigail!"

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.ABIGAIL.LEVEL3.2
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.ABIGAIL.LEVEL3.2"
msgid "That's my twin sister, Abigail."
msgstr "Das ist meine Zwillingsschwester, Abigail."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.ABIGAIL_FLOWER.GENERIC
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.ABIGAIL_FLOWER.GENERIC"
msgid "It's still so pretty."
msgstr "Immer noch so hübsch."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.ABIGAIL_FLOWER.HAUNTED_GROUND
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.ABIGAIL_FLOWER.HAUNTED_GROUND"
msgid "I need to show Abigail how to play."
msgstr "Ich muss Abigail zeigen, wie man es spielt."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.ABIGAIL_FLOWER.HAUNTED_POCKET
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.ABIGAIL_FLOWER.HAUNTED_POCKET"
msgid "Abigail is ready to play, but she needs some space."
msgstr "Abigail ist bereit zum spielen, aber sie braucht ein wenig Platz."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.ABIGAIL_FLOWER.LEVEL1
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.ABIGAIL_FLOWER.LEVEL1"
msgid "It was my sister's flower. She's gone far away."
msgstr "Das war die Blume meiner Schwester. Sie ist weit weg gegangen."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.ABIGAIL_FLOWER.LEVEL2
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.ABIGAIL_FLOWER.LEVEL2"
msgid "I can sense Abigail's spirit growing stronger."
msgstr "Ich kann spüren, wie Abigails Geist stärker wird."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.ABIGAIL_FLOWER.LEVEL3
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.ABIGAIL_FLOWER.LEVEL3"
msgid "Abigail! Are you ready to play?"
msgstr "Abigail! Startklar zum Spielen?"

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.ABIGAIL_FLOWER.LONG
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.ABIGAIL_FLOWER.LONG"
msgid ""
msgstr ""

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.ABIGAIL_FLOWER.MEDIUM
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.ABIGAIL_FLOWER.MEDIUM"
msgid "I can sense Abigail's presence growing stronger."
msgstr "Ich kann spüren, wie Abigails Gegenwart stärker wird."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.ABIGAIL_FLOWER.SOON
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.ABIGAIL_FLOWER.SOON"
msgid "Abigail is almost here!"
msgstr "Abigail ist fast hier!"

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.ABYSSPILLAR_MINION.ACTIVATED
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.ABYSSPILLAR_MINION.ACTIVATED"
msgid "It follows."
msgstr "Sie folgt."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.ABYSSPILLAR_MINION.GENERIC
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.ABYSSPILLAR_MINION.GENERIC"
msgid "A lifeless statue."
msgstr "Eine leblose Statue."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.ABYSSPILLAR_TRIAL
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.ABYSSPILLAR_TRIAL"
msgid "Shall we?"
msgstr "Sollen wir?"

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.ACCOMPLISHMENT_SHRINE
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.ACCOMPLISHMENT_SHRINE"
msgid "I've never much cared for metaphor."
msgstr "Ich habe mich nie viel für Metaphern interessiert."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.ACORN
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.ACORN"
msgid "A tiny life, ensconced in brittle death."
msgstr "Ein winziges Leben, versteckt in einem zerbrechlichen Tod."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.ACORN_COOKED
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.ACORN_COOKED"
msgid "Roasted dead."
msgstr "Zu Tode geröstet."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.ACORN_SAPLING
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.ACORN_SAPLING"
msgid "A tree will grow soon."
msgstr "Bald wird ein Baum wachsen."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.ADVENTURE_PORTAL
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.ADVENTURE_PORTAL"
msgid "What technological terror is this?"
msgstr "Was ist das für ein technologischer Terror?"

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.ALTERGUARDIANHAT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.ALTERGUARDIANHAT"
msgid "When I wear it, i-it's harder to see Abigail..."
msgstr "Wenn ich sie trage, ist es schwieriger, Abigail zu sehen ..."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.ALTERGUARDIANHATSHARD
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.ALTERGUARDIANHATSHARD"
msgid "It broke apart."
msgstr "Sie ist auseinandergefallen."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.ALTERGUARDIAN_CONTAINED
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.ALTERGUARDIAN_CONTAINED"
msgid "It's draining the life from that creature..."
msgstr "Er saugt das Leben aus dieser Kreatur ..."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.ALTERGUARDIAN_PHASE1.DEAD
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.ALTERGUARDIAN_PHASE1.DEAD"
msgid "Even the mighty must fall."
msgstr "Selbst die Mächtigen müssen fallen."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.ALTERGUARDIAN_PHASE1.GENERIC
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.ALTERGUARDIAN_PHASE1.GENERIC"
msgid "We've brought on our own demise."
msgstr "Wir haben unseren eigenen Untergang heraufbeschworen."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.ALTERGUARDIAN_PHASE1_LUNARRIFT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.ALTERGUARDIAN_PHASE1_LUNARRIFT"
msgid "The ball of death burns brighter than ever."
msgstr "Der Ball des Todes leuchtet heller als je zuvor."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.ALTERGUARDIAN_PHASE1_LUNARRIFT_GESTALT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.ALTERGUARDIAN_PHASE1_LUNARRIFT_GESTALT"
msgid "It was so beautiful at its core."
msgstr "Im Kern war er so schön."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.ALTERGUARDIAN_PHASE2.DEAD
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.ALTERGUARDIAN_PHASE2.DEAD"
msgid "Will it rise again, I wonder?"
msgstr "Ob er wohl aufersteht?"

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.ALTERGUARDIAN_PHASE2.GENERIC
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.ALTERGUARDIAN_PHASE2.GENERIC"
msgid "It is not through yet."
msgstr "Es ist noch nicht vorbei."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.ALTERGUARDIAN_PHASE2SPIKE
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.ALTERGUARDIAN_PHASE2SPIKE"
msgid "Oh... it missed."
msgstr "Oh. Daneben."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.ALTERGUARDIAN_PHASE3
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.ALTERGUARDIAN_PHASE3"
msgid "It's beautiful..."
msgstr "Wunderschön ..."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.ALTERGUARDIAN_PHASE3DEAD
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.ALTERGUARDIAN_PHASE3DEAD"
msgid "Nothing can escape death for long."
msgstr "Nichts kann dem Tod für lange Zeit entkommen."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.ALTERGUARDIAN_PHASE3DEADORB
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.ALTERGUARDIAN_PHASE3DEADORB"
msgid "Perhaps now death has finally claimed it."
msgstr "Vielleicht hat der Tod ihn nun endgültig eingeholt."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.ALTERGUARDIAN_PHASE3TRAP
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.ALTERGUARDIAN_PHASE3TRAP"
msgid "It beckons me with the promise of endless slumber..."
msgstr "Sie lockt mich mit dem Versprechen eines Schlummers, der nie endet ..."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.ALTERGUARDIAN_PHASE4_LUNARRIFT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.ALTERGUARDIAN_PHASE4_LUNARRIFT"
msgid "So much pain."
msgstr "So viele Schmerzen."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.AMULET
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.AMULET"
msgid "I wonder who used to own this."
msgstr "Ich frage mich, wem das mal gehört hat."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.ANCHOR
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.ANCHOR"
msgid "For when I feel I can go no further."
msgstr "Wenn ich nicht mehr kann."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.ANCHOR_ITEM
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.ANCHOR_ITEM"
msgid "It's for a burdensome boat anchor."
msgstr "Das wird ein schrecklich schwerer Bootsanker."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.ANCIENTFRUIT_GEM
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.ANCIENTFRUIT_GEM"
msgid "A fruit that offers no sweetness."
msgstr "Ein Frucht ohne jegliche Süße."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.ANCIENTFRUIT_NIGHTVISION
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.ANCIENTFRUIT_NIGHTVISION"
msgid "It's still beating..."
msgstr "Es schlägt noch ..."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.ANCIENTFRUIT_NIGHTVISION_COOKED
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.ANCIENTFRUIT_NIGHTVISION_COOKED"
msgid "It beats no more."
msgstr "Sie lebt nicht mehr."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.ANCIENTTREE_GEM.GENERIC
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.ANCIENTTREE_GEM.GENERIC"
msgid "Burning from the inside... it must be agony."
msgstr "Brennt von innen heraus ... das muss eine Qual sein."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.ANCIENTTREE_GEM.STUMP
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.ANCIENTTREE_GEM.STUMP"
msgid "It's been put out of its misery."
msgstr "Sie wurde von ihren Qualen erlöst."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.ANCIENTTREE_NIGHTVISION.GENERIC
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.ANCIENTTREE_NIGHTVISION.GENERIC"
msgid "It is touched by darkness."
msgstr "Er wurde von der Dunkelheit berührt."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.ANCIENTTREE_NIGHTVISION.STUMP
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.ANCIENTTREE_NIGHTVISION.STUMP"
msgid "This tree was put to rest."
msgstr "Dieser Baum wurde seiner letzten Ruhe zugeführt."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.ANCIENTTREE_SAPLING.GENERIC
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.ANCIENTTREE_SAPLING.GENERIC"
msgid "Maybe if you're lucky, you'll get the chance to grow up."
msgstr "Wenn du Glück hast, wirst du vielleicht die Chance bekommen, heranzuwachsen."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.ANCIENTTREE_SAPLING.WRONG_SEASON
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.ANCIENTTREE_SAPLING.WRONG_SEASON"
msgid "Perhaps it will grow next season. I can wait."
msgstr "Vielleicht wird er in der nächsten Jahreszeit wachsen. Ich kann warten."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.ANCIENTTREE_SAPLING.WRONG_TILE
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.ANCIENTTREE_SAPLING.WRONG_TILE"
msgid "This doesn't feel like its final resting place."
msgstr "Das fühlt sich nicht wie eine letzte Ruhestätte an."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.ANCIENTTREE_SAPLING_ITEM
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.ANCIENTTREE_SAPLING_ITEM"
msgid "Don't worry. I'll bury you."
msgstr "Keine Sorge. Ich begrabe dich."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.ANCIENTTREE_SEED
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.ANCIENTTREE_SEED"
msgid "Its future is unknown. Much like the rest of us."
msgstr "Dessen Zukunft ist unbekannt. Genau wie für den Rest von uns."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.ANCIENT_ALTAR
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.ANCIENT_ALTAR"
msgid "It is full of the echoes of the dead."
msgstr "Voll von den Echos der Toten."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.ANCIENT_ALTAR_BROKEN
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.ANCIENT_ALTAR_BROKEN"
msgid "I hear the painful echoes of the dead."
msgstr "Ich höre die schmerzhaften Echos der Toten."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.ANCIENT_HUSK
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.ANCIENT_HUSK"
msgid "That's dark even for me."
msgstr "Das ist selbst für mich zu düster."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.ANCIENT_STATUE
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.ANCIENT_STATUE"
msgid "Not very attractive."
msgstr "Nicht sehr attraktiv."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.ANIMAL_TRACK
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.ANIMAL_TRACK"
msgid "Signs of the beast."
msgstr "Spuren einer Bestie."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.ANTCHOVIES
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.ANTCHOVIES"
msgid "Death would be a kindness."
msgstr "Der Tod wäre ein Segen."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.ANTLION.GENERIC
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.ANTLION.GENERIC"
msgid "Do you know any riddles?"
msgstr "Kennst du irgendwelche Rätsel?"

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.ANTLION.UNHAPPY
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.ANTLION.UNHAPPY"
msgid "A deep rage brews within..."
msgstr "Darin tobt ein unbändiger Zorn ..."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.ANTLION.VERYHAPPY
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.ANTLION.VERYHAPPY"
msgid "The gifts made it happier..."
msgstr "Die Geschenke haben es zufriedengestellt ..."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.ANTLIONHAT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.ANTLIONHAT"
msgid "A crown fit for a queen of dirt."
msgstr "Eine Krone, die einer Königin des Erdbodens würdig ist."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.ANTLIONTRINKET
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.ANTLIONTRINKET"
msgid "If only I could kick it."
msgstr "Wenn ich es doch nur treten könnte."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.ARCHIVE_CENTIPEDE
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.ARCHIVE_CENTIPEDE"
msgid "I suppose I'm to be crushed by a bug... an ironic end."
msgstr "Ich schätze, ich werde von einem Käfer zerquetscht ... Ein ironisches Ende."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.ARCHIVE_CENTIPEDE_HUSK
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.ARCHIVE_CENTIPEDE_HUSK"
msgid "It's dead."
msgstr "Sie ist tot."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.ARCHIVE_COOKPOT.BURNT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.ARCHIVE_COOKPOT.BURNT"
msgid "Burnt to a crisp."
msgstr "Zu einem Klumpen verbrannt."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.ARCHIVE_COOKPOT.COOKING_LONG
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.ARCHIVE_COOKPOT.COOKING_LONG"
msgid "Whatever's in there isn't dead yet."
msgstr "Was auch immer dort drin ist, ist noch nicht tot."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.ARCHIVE_COOKPOT.COOKING_SHORT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.ARCHIVE_COOKPOT.COOKING_SHORT"
msgid "It needs to boil."
msgstr "Es muss kochen."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.ARCHIVE_COOKPOT.DONE
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.ARCHIVE_COOKPOT.DONE"
msgid "Finally, food."
msgstr "Endlich, Essen."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.ARCHIVE_COOKPOT.EMPTY
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.ARCHIVE_COOKPOT.EMPTY"
msgid "It's covered in dust."
msgstr "Von Staub bedeckt."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.ARCHIVE_LOCKBOX
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.ARCHIVE_LOCKBOX"
msgid "How am I to get it open? Perhaps the key is nearby."
msgstr "Wie soll ich es öffnen? Vielleicht ist der Schlüssel in der Nähe."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.ARCHIVE_LOCKBOX_DISPENCER.GENERIC
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.ARCHIVE_LOCKBOX_DISPENCER.GENERIC"
msgid "All the knowledge in the world won't bring Abigail back."
msgstr "Kein Wissen der Welt wird Abigail zurückbringen."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.ARCHIVE_LOCKBOX_DISPENCER.POWEROFF
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.ARCHIVE_LOCKBOX_DISPENCER.POWEROFF"
msgid "Devoid of life. Like everything in this place."
msgstr "Bar allen Lebens. Wie alles an diesem Ort."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.ARCHIVE_MOON_STATUE
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.ARCHIVE_MOON_STATUE"
msgid "This place feels rather like a tomb."
msgstr "Dieser Ort fühlt sich eher wie ein Grab an."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.ARCHIVE_ORCHESTRINA_MAIN
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.ARCHIVE_ORCHESTRINA_MAIN"
msgid "Abigail was better at these things."
msgstr "Abigail war besser in diesen Dingen."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.ARCHIVE_PORTAL.GENERIC
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.ARCHIVE_PORTAL.GENERIC"
msgid "Not everything can come back so easily."
msgstr "Nicht alles kann so einfach zurückkommen."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.ARCHIVE_PORTAL.POWEROFF
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.ARCHIVE_PORTAL.POWEROFF"
msgid "It's long dead."
msgstr "Schon lange tot."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.ARCHIVE_RESONATOR.GENERIC
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.ARCHIVE_RESONATOR.GENERIC"
msgid "All paths lead to suffering."
msgstr "Alle Wege führen zum Leid."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.ARCHIVE_RESONATOR.IDLE
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.ARCHIVE_RESONATOR.IDLE"
msgid "There's nothing left to look for."
msgstr "Es gibt nichts mehr, wonach man suchen könnte."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.ARCHIVE_RESONATOR_ITEM
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.ARCHIVE_RESONATOR_ITEM"
msgid "The ones who designed it are long dead."
msgstr "Jene, die das entworfen haben, sind schon lange tot."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.ARCHIVE_RUNE_STATUE.LINE_1
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.ARCHIVE_RUNE_STATUE.LINE_1"
msgid "Words of a dead language."
msgstr "Worte einer toten Sprache."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.ARCHIVE_RUNE_STATUE.LINE_2
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.ARCHIVE_RUNE_STATUE.LINE_2"
msgid "It was important enough to carve into stone, but we'll never know the meaning."
msgstr "Es war wichtig genug, um es in Stein zu meißeln, aber wir werden die Bedeutung nie erfahren."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.ARCHIVE_RUNE_STATUE.LINE_3
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.ARCHIVE_RUNE_STATUE.LINE_3"
msgid "What a pity."
msgstr "Wie schade."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.ARCHIVE_RUNE_STATUE.LINE_4
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.ARCHIVE_RUNE_STATUE.LINE_4"
msgid "It was important enough to carve into stone, but we'll never know the meaning."
msgstr "Es war wichtig genug, um es in Stein zu meißeln, aber wir werden die Bedeutung nie erfahren."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.ARCHIVE_RUNE_STATUE.LINE_5
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.ARCHIVE_RUNE_STATUE.LINE_5"
msgid "What a pity."
msgstr "Wie schade."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.ARCHIVE_SECURITY_DESK.GENERIC
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.ARCHIVE_SECURITY_DESK.GENERIC"
msgid "How sad... there's nobody left to guard."
msgstr "Wie traurig ... Es gibt niemanden mehr zum Bewachen."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.ARCHIVE_SECURITY_DESK.POWEROFF
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.ARCHIVE_SECURITY_DESK.POWEROFF"
msgid "There's no life in it."
msgstr "Komplett leblos."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.ARCHIVE_SECURITY_PULSE
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.ARCHIVE_SECURITY_PULSE"
msgid "Where are you going?"
msgstr "Wo fährst du hin?"

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.ARCHIVE_SWITCH.GEMS
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.ARCHIVE_SWITCH.GEMS"
msgid "It's not yet whole."
msgstr "Noch nicht ganz fertig."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.ARCHIVE_SWITCH.VALID
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.ARCHIVE_SWITCH.VALID"
msgid "It already has its treasure."
msgstr "Es hat seinen Schatz bekommen."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.ARMORDRAGONFLY
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.ARMORDRAGONFLY"
msgid "I'd wear it inside-out."
msgstr "Ich würde sie linksherum tragen."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.ARMORDREADSTONE
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.ARMORDREADSTONE"
msgid "Let the darkness surround me."
msgstr "Die Dunkelheit soll mich umhüllen."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.ARMORGRASS
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.ARMORGRASS"
msgid "To prolong the inevitable."
msgstr "Um das Unvermeidlichen hinauszuzögern."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.ARMORMARBLE
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.ARMORMARBLE"
msgid "Could stop the daggers that stab at mine heart."
msgstr "Stoppt die Dolche, die auf mein Herz einstechen."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.ARMORRUINS
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.ARMORRUINS"
msgid "A reprieve from death."
msgstr "Ein Begnadigung vom Tod."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.ARMORSKELETON
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.ARMORSKELETON"
msgid "I shall wrap myself in death's sweet embrace."
msgstr "Ich werde mich in des Todes süße Umarmung hingeben."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.ARMORSLURPER
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.ARMORSLURPER"
msgid "A clinging, dreary, living suit."
msgstr "Ein anschmiegsamer, trostloser und lebender Anzug."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.ARMORSNURTLESHELL
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.ARMORSNURTLESHELL"
msgid "A suit to hide from one's problems."
msgstr "Ein Anzug, um sich vor seinen Problemen zu verstecken."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.ARMORWAGPUNK
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.ARMORWAGPUNK"
msgid "Even the thickest metal couldn't protect my heart."
msgstr "Selbst das dickste Metall kann mein Herz nicht schützen."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.ARMORWOOD
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.ARMORWOOD"
msgid "To hold off the inevitable a bit longer."
msgstr "Um das Unvermeidliche ein bisschen länger hinauszuzögern."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.ARMOR_BRAMBLE
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.ARMOR_BRAMBLE"
msgid "So my outside matches my inside."
msgstr "Damit mein Äußeres zu meinem Inneren passt."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.ARMOR_CARROTLURE
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.ARMOR_CARROTLURE"
msgid "I assume it only comes in orange."
msgstr "Ich nehme an, das gibt es nur in Orange."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.ARMOR_LUNARPLANT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.ARMOR_LUNARPLANT"
msgid "Shining armor, but no knight to save us."
msgstr "Glänzende Rüstung, aber nirgends ein Ritter der uns rettet."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.ARMOR_LUNARPLANT_HUSK
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.ARMOR_LUNARPLANT_HUSK"
msgid "I'd find it useful if I feared death."
msgstr "Das fände ich nützlich, sofern ich denn den Tod fürchten würde."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.ARMOR_SANITY
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.ARMOR_SANITY"
msgid "A perfectly safe way to go insane."
msgstr "Eine absolut sichere Art, um wahnsinnig zu werden."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.ARMOR_VOIDCLOTH
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.ARMOR_VOIDCLOTH"
msgid "This ragged cloak will either protect me, or be my shroud."
msgstr "Dieser zerlumpte Umhang wird mich entweder schützen oder mein Leichentuch sein."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.ARMOR_YOTH_KNIGHT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.ARMOR_YOTH_KNIGHT"
msgid "It's beautiful armor."
msgstr "Eine wunderschöne Rüstung."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.ARROWSIGN_PANEL.BURNT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.ARROWSIGN_PANEL.BURNT"
msgid "Transient, indeed."
msgstr "Vorübergehend, tatsächlich."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.ARROWSIGN_PANEL.GENERIC
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.ARROWSIGN_PANEL.GENERIC"
msgid "A mark is made, however transient."
msgstr "Ein Zeichen wurde gesetzt. Jedoch nur vorübergehend."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.ARROWSIGN_PANEL.UNWRITTEN
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.ARROWSIGN_PANEL.UNWRITTEN"
msgid "Its blank face shall soon offer a secret."
msgstr "Sein leeres Gesicht soll bald ein Geheimnis preisgeben."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.ARROWSIGN_POST.BURNT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.ARROWSIGN_POST.BURNT"
msgid "Transient, indeed."
msgstr "Vorübergehend, tatsächlich."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.ARROWSIGN_POST.GENERIC
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.ARROWSIGN_POST.GENERIC"
msgid "A mark is made, however transient."
msgstr "Ein Zeichen wurde gesetzt. Jedoch nur vorübergehend."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.ARROWSIGN_POST.UNWRITTEN
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.ARROWSIGN_POST.UNWRITTEN"
msgid "Its blank face shall soon offer a secret."
msgstr "Sein leeres Gesicht soll bald ein Geheimnis preisgeben."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.ASH.GENERIC
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.ASH.GENERIC"
msgid "All that's left after another beautiful fire."
msgstr "Alles, was nach einem schönen Feuer übrig geblieben ist."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.ASH.REMAINS_EYE_BONE
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.ASH.REMAINS_EYE_BONE"
msgid "The eyebone was incinerated in the teleportation!"
msgstr "Der Augenknochen wurde beim Teleportieren verbrannt."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.ASH.REMAINS_GLOMMERFLOWER
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.ASH.REMAINS_GLOMMERFLOWER"
msgid "The flower was incinerated in the teleportation!"
msgstr "Die Blume wurde beim Teleportieren verbrannt."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.ASH.REMAINS_THINGIE
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.ASH.REMAINS_THINGIE"
msgid "This was once some thing before it got burned..."
msgstr "Bevor es verbrannt ist, war das mal irgendetwas."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.ASPARAGUS
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.ASPARAGUS"
msgid "Vegetables are good for you, but what do I care?"
msgstr "Gemüse ist gesund, aber was schert mich das?"

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.ASPARAGUSSOUP
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.ASPARAGUSSOUP"
msgid "Soup."
msgstr "Suppe."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.ASPARAGUS_COOKED
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.ASPARAGUS_COOKED"
msgid "If I ever feel like eating anything, I'll eat it."
msgstr "Wenn mir je nach Essen zumute ist, esse ich ihn."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.ASPARAGUS_OVERSIZED
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.ASPARAGUS_OVERSIZED"
msgid "Sigh. I suppose all these vegetables will keep my strength up..."
msgstr "Seufz. Ich nehme an, das ganze Gemüse wird mich bei Kräften halten ..."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.ASPARAGUS_SEEDS
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.ASPARAGUS_SEEDS"
msgid "Will I live to see this grow?"
msgstr "Werde ich die noch wachsen sehen?"

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.ATRIUM_GATE.CHARGING
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.ATRIUM_GATE.CHARGING"
msgid "Take us far from here."
msgstr "Bring uns weit weg von hier."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.ATRIUM_GATE.COOLDOWN
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.ATRIUM_GATE.COOLDOWN"
msgid "We can't do that again for awhile."
msgstr "Das können wir jetzt eine Weile nicht mehr tun."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.ATRIUM_GATE.DESTABILIZING
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.ATRIUM_GATE.DESTABILIZING"
msgid "Oh well. I hope it's a quick death."
msgstr "Na ja. Hoffentlich ist es ein schneller Tod."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.ATRIUM_GATE.OFF
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.ATRIUM_GATE.OFF"
msgid "A beacon of hope left unlit... How fitting."
msgstr "Ein bisschen Hoffnung ... Wie passend."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.ATRIUM_GATE.ON
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.ATRIUM_GATE.ON"
msgid "Hope springs infernal."
msgstr "Die Hoffnung stirbt zuletzt."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.ATRIUM_KEY
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.ATRIUM_KEY"
msgid "I think I know where it goes..."
msgstr "Ich glaub, ich weiß, wohin es da geht ..."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.ATRIUM_LIGHT.OFF
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.ATRIUM_LIGHT.OFF"
msgid "There is no light to be found."
msgstr "Kein Licht zu finden."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.ATRIUM_LIGHT.ON
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.ATRIUM_LIGHT.ON"
msgid "A deathly light dances across the room."
msgstr "Ein tödliches Licht tanzt durch den Raum."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.ATRIUM_OVERGROWTH
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.ATRIUM_OVERGROWTH"
msgid "Scrawlings of a tongue lost to time."
msgstr "Gekritzel einer in der Zeit verlorenen Zunge."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.ATRIUM_RUBBLE.LINE_1
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.ATRIUM_RUBBLE.LINE_1"
msgid "A people struck by famine and sorrow."
msgstr "Ein Volk, dass von Hunger und Not getroffen wurde."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.ATRIUM_RUBBLE.LINE_2
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.ATRIUM_RUBBLE.LINE_2"
msgid "A piece of their story, lost to time."
msgstr "Ein Teil ihrer Geschichte. An die Zeit verloren."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.ATRIUM_RUBBLE.LINE_3
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.ATRIUM_RUBBLE.LINE_3"
msgid "They are consumed by darkness."
msgstr "Verzehrt von Dunkelheit."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.ATRIUM_RUBBLE.LINE_4
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.ATRIUM_RUBBLE.LINE_4"
msgid "Then, rebirth."
msgstr "Dann Auferstehung."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.ATRIUM_RUBBLE.LINE_5
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.ATRIUM_RUBBLE.LINE_5"
msgid "Finally, a city, full of life."
msgstr "Endlich, eine Stadt voller Leben."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.ATRIUM_STATUE
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.ATRIUM_STATUE"
msgid "A tortured soul."
msgstr "Eine gequälte Seele."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.AXE
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.AXE"
msgid "An instrument for industry and murder."
msgstr "Ein Instrument für Industrie und Mord."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.BABYBEEFALO.GENERIC
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.BABYBEEFALO.GENERIC"
msgid "Enjoy your youth. Soon you will learn the terrors of the real world."
msgstr "Genieße deine Jugend. Bald wirst du die Schrecken der realen Welt kennenlernen."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.BABYBEEFALO.SLEEPING
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.BABYBEEFALO.SLEEPING"
msgid "Don't wake up."
msgstr "Nicht aufwachen."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.BACKPACK
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.BACKPACK"
msgid "A spacious sack to increase one's burden."
msgstr "Ein großer Sack, um noch mehr tragen zu können."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.BACONEGGS
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.BACONEGGS"
msgid "A balanced breakfast to start another miserable day."
msgstr "Ein ausgewogenes Frühstück zum Start in einen elenden Tag."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.BALATRO_MACHINE
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.BALATRO_MACHINE"
msgid "What more can I lose?"
msgstr "Was könnte ich weiter verlieren?"

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.BALLOON
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.BALLOON"
msgid "A colorful reminder that my childhood is no more."
msgstr "Eine bunte Erinnerung daran, dass meine Kindheit vorbei ist."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.BALLOONHAT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.BALLOONHAT"
msgid "Can he make one for Abigail?"
msgstr "Kann er einen für Abigail machen?"

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.BALLOONPARTY
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.BALLOONPARTY"
msgid "What is the point of celebrating in a place such as this?"
msgstr "Warum sollte man an einem Ort wie diesem feiern?"

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.BALLOONSPEED.DEFLATED
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.BALLOONSPEED.DEFLATED"
msgid "Sail far away from here, little balloon."
msgstr "Schwebe ganz weit weg von hier, kleiner Ballon."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.BALLOONSPEED.GENERIC
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.BALLOONSPEED.GENERIC"
msgid "Will it make me swift enough to outrun my problems?"
msgstr "Werde ich dadurch schnell genug sein, um vor meinen Problemen davonzurennen?"

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.BALLOONS_EMPTY
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.BALLOONS_EMPTY"
msgid "These look as deflated as I feel..."
msgstr "Die sehen so schlapp aus, wie ich mich fühle ..."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.BALLOONVEST
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.BALLOONVEST"
msgid "Why try to prolong the inevitable?"
msgstr "Warum das Unvermeidliche hinauszögern?"

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.BANANABUSH
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.BANANABUSH"
msgid "Bananas that grow in the sun... how unnatural."
msgstr "Im Sonnenlicht wachsende Bananen ... wie unnatürlich."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.BANANAJUICE
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.BANANAJUICE"
msgid "I... like it."
msgstr "Ich ... mag es!"

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.BANANAPOP
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.BANANAPOP"
msgid "I used to eat these with Abigail..."
msgstr "Die habe ich immer mit Abigail gegessen."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.BANDAGE
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.BANDAGE"
msgid "There's no salve for the pain of existence."
msgstr "Heilsalbe"

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.BANDAGE_BUTTERFLYWINGS
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.BANDAGE_BUTTERFLYWINGS"
msgid "An ephemeral remedy woven from vanitas itself."
msgstr "Ein flüchtiges Heilmittel, das aus der Vanitas selbst gewoben wurde."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.BARNACLE
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.BARNACLE"
msgid "We pried it from its home."
msgstr "Wir haben sie ihrer Heimat entrissen."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.BARNACLEPITA
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.BARNACLEPITA"
msgid "My pita is filled with disappointment."
msgstr "Meine Pita ist mit Enttäuschung gefüllt."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.BARNACLESTUFFEDFISHHEAD
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.BARNACLESTUFFEDFISHHEAD"
msgid "They make starving seem almost appealing..."
msgstr "Da wird Verhungern fast attraktiv ..."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.BARNACLESUSHI
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.BARNACLESUSHI"
msgid "It's cold..."
msgstr "Es ist kalt ..."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.BARNACLE_COOKED
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.BARNACLE_COOKED"
msgid "It's... chewy."
msgstr "Sie ist ... bissfest."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.BARNACLINGUINE
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.BARNACLINGUINE"
msgid "I like my noodles plain, with butter."
msgstr "Ich mag meine Nudeln einfach mit Butter."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.BASALT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.BASALT"
msgid "Trying to break it would be pointless."
msgstr "Es wäre sinnlos, zu versuchen, es zu zerbrechen."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.BAT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.BAT"
msgid "A creature of the night."
msgstr "Eine Kreatur der Nacht!"

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.BATBAT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.BATBAT"
msgid "An enchanted weapon. How exciting!"
msgstr "Eine verzauberte Waffe. Wie aufregend!"

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.BATCAVE
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.BATCAVE"
msgid "They're just lurking in there..."
msgstr "Die lauern einfach nur da drin ..."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.BATHBOMB
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.BATHBOMB"
msgid "To mask the smell of sorrow and death."
msgstr "Um den Gestank nach Leid und Tod zu überdecken."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.BATNOSE
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.BATNOSE"
msgid "It won't be bothering us anymore."
msgstr "Er wird uns nicht mehr belästigen."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.BATNOSEHAT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.BATNOSEHAT"
msgid "This feels silly."
msgstr "Das fühlt sich albern an."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.BATNOSE_COOKED
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.BATNOSE_COOKED"
msgid "It doesn't look more appetizing now."
msgstr "Jetzt sieht es auch nicht appetitlicher aus."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.BATTLESONG_CONTAINER
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.BATTLESONG_CONTAINER"
msgid "A hollow container."
msgstr "Ein hohler Behälter."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.BATTLESONG_DURABILITY
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.BATTLESONG_DURABILITY"
msgid "My heart has no desire to sing."
msgstr "Mein Herz verlangt es nicht nach Gesang."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.BATTLESONG_FIRERESISTANCE
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.BATTLESONG_FIRERESISTANCE"
msgid "My heart has no desire to sing."
msgstr "Mein Herz verlangt es nicht nach Gesang."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.BATTLESONG_HEALTHGAIN
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.BATTLESONG_HEALTHGAIN"
msgid "My heart has no desire to sing."
msgstr "Mein Herz verlangt es nicht nach Gesang."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.BATTLESONG_INSTANT_PANIC
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.BATTLESONG_INSTANT_PANIC"
msgid "I only like tragedies."
msgstr "Ich mag nur Tragödien."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.BATTLESONG_INSTANT_REVIVE
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.BATTLESONG_INSTANT_REVIVE"
msgid "My heart has no desire to sing."
msgstr "Mein Herz verlangt es nicht nach Gesang."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.BATTLESONG_INSTANT_TAUNT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.BATTLESONG_INSTANT_TAUNT"
msgid "I only like tragedies."
msgstr "Ich mag nur Tragödien."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.BATTLESONG_LUNARALIGNED
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.BATTLESONG_LUNARALIGNED"
msgid "My heart has no desire to sing."
msgstr "Mein Herz verlangt es nicht nach Gesang."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.BATTLESONG_SANITYAURA
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.BATTLESONG_SANITYAURA"
msgid "My heart has no desire to sing."
msgstr "Mein Herz verlangt es nicht nach Gesang."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.BATTLESONG_SANITYGAIN
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.BATTLESONG_SANITYGAIN"
msgid "My heart has no desire to sing."
msgstr "Mein Herz verlangt es nicht nach Gesang."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.BATTLESONG_SHADOWALIGNED
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.BATTLESONG_SHADOWALIGNED"
msgid "My heart has no desire to sing."
msgstr "Mein Herz verlangt es nicht nach Gesang."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.BATWING
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.BATWING"
msgid "If only I could fly away."
msgstr "Wenn ich doch nur wegfliegen könnte."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.BATWING_COOKED
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.BATWING_COOKED"
msgid "They once held such great potential."
msgstr "Sie hatten einst so ein großes Potential."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.BEARDHAIR
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.BEARDHAIR"
msgid "That's just nasty."
msgstr "Das ist einfach nur widerlich."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.BEARGER
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.BEARGER"
msgid "It could crush me in one blow. I wish it would."
msgstr "Könnte mich mit einem Schlag vernichten. Schön wär's."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.BEARGERCORPSE.BURNING
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.BEARGERCORPSE.BURNING"
msgid "Reduced to ashes, scattered on the wind."
msgstr "Zu Asche geworden und in alle Winde zerstreut."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.BEARGERCORPSE.GENERIC
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.BEARGERCORPSE.GENERIC"
msgid "Laid to rest."
msgstr "Zur Ruhe gebettet."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.BEARGERCORPSE.REVIVING
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.BEARGERCORPSE.REVIVING"
msgid "Is this what you really want?"
msgstr "Ist es das, was du wirklich willst?"

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.BEARGERFUR_SACK
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.BEARGERFUR_SACK"
msgid "I already carry the coldness within."
msgstr "Ich trage die Kälte bereits im Inneren."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.BEARGERVEST
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.BEARGERVEST"
msgid "Death surrounds us. Well, our torsos anyhow."
msgstr "Der Tod umgibt uns. Na ja, zumindest unsere Körper."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.BEARGER_FUR
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.BEARGER_FUR"
msgid "It smells like death."
msgstr "Er riecht nach Tod."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.BEAST_BLUEPRINT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.BEAST_BLUEPRINT"
msgid "May it give my beefalo more luck than I've had."
msgstr "Möge es meinem Beefalo mehr Glück bringen, als ich es hatte."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.BEDROLL_FURRY
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.BEDROLL_FURRY"
msgid "For veiling oneself in the fuzzy skins of the fallen."
msgstr "Damit kuschelt man sich in das flauschige Fell einst mächtiger Tiere."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.BEDROLL_STRAW
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.BEDROLL_STRAW"
msgid "Sleep is but a temporary death."
msgstr "Schlaf ist der vorübergehende Tod."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.BEE.GENERIC
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.BEE.GENERIC"
msgid "I'd steer clear of that stinger."
msgstr "Ich würde den Stachel meiden."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.BEE.HELD
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.BEE.HELD"
msgid "Be still, little one."
msgstr "Halt still, Kleine."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.BEEBOX.BURNT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.BEEBOX.BURNT"
msgid "Burnt honey."
msgstr "Verbrannter Honig."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.BEEBOX.FULLHONEY
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.BEEBOX.FULLHONEY"
msgid "Their toils have been fruitful!"
msgstr "Ihre Mühen haben Früchte getragen."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.BEEBOX.GENERIC
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.BEEBOX.GENERIC"
msgid "Their stolen labor tastes so sweet."
msgstr "Ihre gestohlene Arbeit schmeckt so süß."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.BEEBOX.NOHONEY
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.BEEBOX.NOHONEY"
msgid "Work, bees!"
msgstr "Arbeitet, Bienen!"

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.BEEBOX.READY
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.BEEBOX.READY"
msgid "Their toils have been fruitful!"
msgstr "Ihre Mühen haben Früchte getragen."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.BEEBOX.SOMEHONEY
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.BEEBOX.SOMEHONEY"
msgid "Toil on."
msgstr "Strengt euch an."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.BEEBOX_HERMIT.BURNT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.BEEBOX_HERMIT.BURNT"
msgid "Burnt honey."
msgstr "Verbrannter Honig."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.BEEBOX_HERMIT.FULLHONEY
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.BEEBOX_HERMIT.FULLHONEY"
msgid "Their toils have been fruitful!"
msgstr "Ihre Mühen haben Früchte getragen."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.BEEBOX_HERMIT.GENERIC
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.BEEBOX_HERMIT.GENERIC"
msgid "There are only memories of sweetness here."
msgstr "Hier sind nur Erinnerungen an Süße."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.BEEBOX_HERMIT.NOHONEY
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.BEEBOX_HERMIT.NOHONEY"
msgid "Work, bees!"
msgstr "Arbeitet, Bienen!"

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.BEEBOX_HERMIT.READY
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.BEEBOX_HERMIT.READY"
msgid "Their toils have been fruitful!"
msgstr "Ihre Mühen haben Früchte getragen."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.BEEBOX_HERMIT.SOMEHONEY
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.BEEBOX_HERMIT.SOMEHONEY"
msgid "Toil on."
msgstr "Strengt euch an."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.BEEFALO.DEAD
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.BEEFALO.DEAD"
msgid "Dead, but perhaps not departed."
msgstr "Tot, aber vielleicht nicht von uns gegangen."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.BEEFALO.DEAD_MYPARTNER
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.BEEFALO.DEAD_MYPARTNER"
msgid "Not you too..."
msgstr "Nicht du auch noch ..."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.BEEFALO.DOMESTICATED
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.BEEFALO.DOMESTICATED"
msgid "I wonder if it misses its old family?"
msgstr "Ich frage mich, ob es seine alte Familie vermisst?"

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.BEEFALO.FOLLOWER
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.BEEFALO.FOLLOWER"
msgid "He follows me unto his doom."
msgstr "Er folgt mir in sein Verderben."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.BEEFALO.GENERIC
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.BEEFALO.GENERIC"
msgid "What demented thoughts must lie behind those eyes."
msgstr "Welche verrückten Gedanken liegen wohl hinter diesen Augen?"

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.BEEFALO.MYPARTNER
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.BEEFALO.MYPARTNER"
msgid "At least we have each other for company."
msgstr "Wenigstens haben wir uns gegenseitig Gesellschaft geleistet."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.BEEFALO.NAKED
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.BEEFALO.NAKED"
msgid "His nakedness is now on display."
msgstr "Seine Nacktheit wird zur Schau gestellt."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.BEEFALO.ORNERY
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.BEEFALO.ORNERY"
msgid "The world has wronged you."
msgstr "Die Welt hat dir Unrecht getan."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.BEEFALO.PUDGY
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.BEEFALO.PUDGY"
msgid "More of the world is within the beast than without."
msgstr "In diesem Tier steckt mehr von der Welt als man vermutet."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.BEEFALO.RIDER
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.BEEFALO.RIDER"
msgid "Together we can venture far."
msgstr "0Gemeinsam können wir viel wagen."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.BEEFALO.SLEEPING
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.BEEFALO.SLEEPING"
msgid "To sleep, perchance to dream."
msgstr "Schön schlafen und träumen!"

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.BEEFALOFEED
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.BEEFALOFEED"
msgid "I wouldn't want my beefalo to starve."
msgstr "Nicht, dass mein Beefalo verhungert."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.BEEFALOHAT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.BEEFALOHAT"
msgid "To cover one's head."
msgstr "Um den Kopf zu bedecken."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.BEEFALOTREAT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.BEEFALOTREAT"
msgid "Oh to be able to find joy in such a simple thing..."
msgstr "Oh, die Möglichkeit sich an solch simplen Dingen zu erfreuen …"

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.BEEFALOWOOL
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.BEEFALOWOOL"
msgid "Somewhere, a beefalo is naked and cold."
msgstr "Irgendwo friert jetzt ein nackter Beefalo."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.BEEFALO_GROOMER.BURNT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.BEEFALO_GROOMER.BURNT"
msgid "Burned to ashes."
msgstr "Zu Asche verbrannt."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.BEEFALO_GROOMER.GENERIC
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.BEEFALO_GROOMER.GENERIC"
msgid "Beauty, like all things, will fade and be forgotten."
msgstr "Schönheit wird, wie alle Dinge, verblassen und in Vergessenheit geraten."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.BEEFALO_GROOMER.OCCUPIED
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.BEEFALO_GROOMER.OCCUPIED"
msgid "I can change its appearance, but it will always just be a beefalo."
msgstr "Ich kann sein Aussehen verändern, aber es wird immer nur ein Beefalo sein."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.BEEFALO_GROOMER_ITEM
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.BEEFALO_GROOMER_ITEM"
msgid "Sigh. Endless toil."
msgstr "Seufz. Endlose Mühsal."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.BEEF_BELL
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.BEEF_BELL"
msgid "Alas, not a death knell."
msgstr "Oh weh! Das ist leider keine Totenglocke."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.BEEGUARD
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.BEEGUARD"
msgid "Their devotion knows no bounds."
msgstr "Ihre Hingabe kennt keine Grenzen."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.BEEHAT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.BEEHAT"
msgid "This will protect me from those happy buzzing sounds. Oh, and stings."
msgstr "Der schützt mich vor den glücklich summenden Geräuschen. Oh, und vor den Stacheln."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.BEEHIVE
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.BEEHIVE"
msgid "A wretched hive of scum and pollen."
msgstr "Ein erbärmlicher Bienenstock voller Abschaum und Pollen."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.BEEMINE
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.BEEMINE"
msgid "They're still alive in there. Poor things."
msgstr "Sie sind immer noch lebendig. Arme Dinger."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.BEEMINE_MAXWELL
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.BEEMINE_MAXWELL"
msgid "The furious creatures appreciate their freedom in retrospect."
msgstr "Die wütenden Kreaturen erinnern sich gern zurück an ihre Freiheit."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.BEEQUEEN
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.BEEQUEEN"
msgid "As regal as she is ruthless..."
msgstr "So königlich wie rücksichtslos ..."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.BEEQUEENHIVE.GENERIC
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.BEEQUEENHIVE.GENERIC"
msgid "The bees left their sweet mark upon the earth."
msgstr "Die Bienen haben ihre süßen Spuren auf der Erde hinterlassen."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.BEEQUEENHIVE.GROWING
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.BEEQUEENHIVE.GROWING"
msgid "It is not a danger... yet..."
msgstr "Es besteht keine Gefahr ... noch nicht ..."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.BEEQUEENHIVEGROWN
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.BEEQUEENHIVEGROWN"
msgid "Dripping with enmity. And honey."
msgstr "Triefend vor Feindschaft. Und Honig."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.BEESWAX
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.BEESWAX"
msgid "It's useless on its own, just like me."
msgstr "Allein ist es nutzlos. Genau wie ich."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.BEESWAX_SPRAY
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.BEESWAX_SPRAY"
msgid "The bottled scent of fear."
msgstr "Der Geruch von Angst in einer Flasche."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.BEETLETAUR
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.BEETLETAUR"
msgid "You are a prisoner of your own doomed destiny."
msgstr "Du bist ein Gefangener deines eigenen verdammten Schicksals."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.BELL
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.BELL"
msgid "Ring in the dead."
msgstr "Läute den Tod ein."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.BERNIE_ACTIVE
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.BERNIE_ACTIVE"
msgid "It dances to forget the pain."
msgstr "Er tanzt, um den Schmerz zu vergessen."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.BERNIE_BIG
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.BERNIE_BIG"
msgid "Wow... What a big stuffy."
msgstr "Wow ... Was für ein großer Teddy."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.BERNIE_INACTIVE.BROKEN
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.BERNIE_INACTIVE.BROKEN"
msgid "It has passed."
msgstr "Er ist über den Jordan."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.BERNIE_INACTIVE.GENERIC
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.BERNIE_INACTIVE.GENERIC"
msgid "It's had a rough life."
msgstr "Er hatte ein hartes Leben."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.BERRIES
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.BERRIES"
msgid "These berries are tart."
msgstr "Diese Beeren sind sauer."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.BERRIES_COOKED
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.BERRIES_COOKED"
msgid "More balanced flavor, but they won't last long."
msgstr "Ausgewogener Geschmack, allerdings werden sie nicht lange halten."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.BERRIES_JUICY
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.BERRIES_JUICY"
msgid "I'd better consume these before death does."
msgstr "Das sollte ich besser essen, bevor es der Tod tut."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.BERRIES_JUICY_COOKED
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.BERRIES_JUICY_COOKED"
msgid "This hasn't halted the decay, merely stalled it."
msgstr "Das hat den Verfall nicht aufgehalten, sondern nur sie ins Stocken gebracht."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.BERRYBUSH.BARREN
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.BERRYBUSH.BARREN"
msgid "It is barren."
msgstr "Er ist karg."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.BERRYBUSH.BURNING
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.BERRYBUSH.BURNING"
msgid "Its suffering will end soon."
msgstr "Sein Leiden wird bald zu Ende sein."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.BERRYBUSH.DISEASED
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.BERRYBUSH.DISEASED"
msgid "It's not long for this world..."
msgstr "Das wird nicht mehr lange auf dieser Welt sein."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.BERRYBUSH.DISEASING
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.BERRYBUSH.DISEASING"
msgid "It is on the precipice..."
msgstr "Steht am Abgrund ..."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.BERRYBUSH.GENERIC
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.BERRYBUSH.GENERIC"
msgid "A snack, perchance?"
msgstr "Zufällig etwas zu essen?"

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.BERRYBUSH.PICKED
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.BERRYBUSH.PICKED"
msgid "The wait begins."
msgstr "Das Warten beginnt."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.BERRYBUSH.WITHERED
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.BERRYBUSH.WITHERED"
msgid "It succumbed to the heat."
msgstr "Er erlag der Hitze."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.BERRYBUSH_JUICY.BARREN
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.BERRYBUSH_JUICY.BARREN"
msgid "There's no life to be had here..."
msgstr "Hier lebt nichts mehr ..."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.BERRYBUSH_JUICY.BURNING
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.BERRYBUSH_JUICY.BURNING"
msgid "Its suffering will end soon."
msgstr "Sein Leiden wird bald zu Ende sein."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.BERRYBUSH_JUICY.DISEASED
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.BERRYBUSH_JUICY.DISEASED"
msgid "It's not long for this world..."
msgstr "Das wird nicht mehr lange auf dieser Welt sein."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.BERRYBUSH_JUICY.DISEASING
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.BERRYBUSH_JUICY.DISEASING"
msgid "It is on the precipice..."
msgstr "Steht am Abgrund ..."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.BERRYBUSH_JUICY.GENERIC
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.BERRYBUSH_JUICY.GENERIC"
msgid "I could strip it clean, if I so chose..."
msgstr "Könnte ich abernten, wenn ich wollte ..."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.BERRYBUSH_JUICY.PICKED
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.BERRYBUSH_JUICY.PICKED"
msgid "It's given all it had to give."
msgstr "Hat wirklich alles gegeben."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.BERRYBUSH_JUICY.WITHERED
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.BERRYBUSH_JUICY.WITHERED"
msgid "It has crumpled under the heat."
msgstr "Die Hitze hat diese Pflanze zerstört."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.BERRYSAUCE
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.BERRYSAUCE"
msgid "Abigail would love this..."
msgstr "Abigail fände sie köstlich ..."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.BIBINGKA
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.BIBINGKA"
msgid "This bread has a most curious texture."
msgstr "Dieses Brot hat eine höchst seltsame Textur."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.BIGFOOT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.BIGFOOT"
msgid "Harbinger of doom."
msgstr "Vorbote des Untergangs."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.BIRCHNUTDRAKE
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.BIRCHNUTDRAKE"
msgid "Balls of battle!"
msgstr "Kugeln des Kampfes!"

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.BIRDCAGE.DEAD
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.BIRDCAGE.DEAD"
msgid "Bereft of life, he rests in pieces."
msgstr "Des Lebens beraubt, ruht er in Friedhelm."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.BIRDCAGE.GENERIC
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.BIRDCAGE.GENERIC"
msgid "Few of us can see our cages."
msgstr "Einige von uns können unsere Käfige sehen."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.BIRDCAGE.HUNGRY
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.BIRDCAGE.HUNGRY"
msgid "Must be hungry."
msgstr "Hungrig"

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.BIRDCAGE.OCCUPIED
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.BIRDCAGE.OCCUPIED"
msgid "He is happier now."
msgstr "Jetzt ist er glücklicher."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.BIRDCAGE.SKELETON
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.BIRDCAGE.SKELETON"
msgid "That... is an ex-bird."
msgstr "Das ... war mal ein Vogel."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.BIRDCAGE.SLEEPING
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.BIRDCAGE.SLEEPING"
msgid "Dead? No. Just sleeping."
msgstr "Ist er tot? Nein. Schläft nur."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.BIRDCAGE.STARVING
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.BIRDCAGE.STARVING"
msgid "The emptiness is eating him from the inside out."
msgstr "Die Leere frisst ihn von innen nach außen."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.BIRDCORPSE.BURNING
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.BIRDCORPSE.BURNING"
msgid "Now it is truly free."
msgstr "Jetzt ist er wirklich frei."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.BIRDCORPSE.GENERIC
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.BIRDCORPSE.GENERIC"
msgid "Poor bird."
msgstr "Armer Vogel."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.BIRDCORPSE.REVIVING
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.BIRDCORPSE.REVIVING"
msgid "There can be a fate worse than death."
msgstr "Es kann ein Schicksal geben, das schlimmer ist als der Tod."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.BIRDTRAP
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.BIRDTRAP"
msgid "Sticks and silk turned lethal."
msgstr "Stöcke und Seide wurden tödlich."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.BIRD_EGG
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.BIRD_EGG"
msgid "So much hope, dashed."
msgstr "So viel Hoffnung. Alles zunicht gemacht."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.BIRD_EGG_COOKED
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.BIRD_EGG_COOKED"
msgid "No bird will ever come of it."
msgstr "Da wird niemals ein Vogel rauskommen."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.BIRD_MUTANT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.BIRD_MUTANT"
msgid "Mr. Crow, you don't look well."
msgstr "Herr Krähe, Sie sehen nicht gut aus."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.BIRD_MUTANT_SPITTER
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.BIRD_MUTANT_SPITTER"
msgid "Something is terribly wrong with that bird."
msgstr "Irgendetwas stimmt mit diesem Vogel ganz und gar nicht."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.BISHOP
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.BISHOP"
msgid "What does he pray for?"
msgstr "Wofür betet er?"

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.BISHOP_CHARGE_HIT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.BISHOP_CHARGE_HIT"
msgid "Ouch..."
msgstr "Autsch ..."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.BISHOP_NIGHTMARE
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.BISHOP_NIGHTMARE"
msgid "Time wins all battles."
msgstr "Die Zeit verurteilt alles."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.BLACKFLAG
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.BLACKFLAG"
msgid "Black, like a mourning shroud."
msgstr "Schwarz wie ein Leichentuch."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.BLOWDART_FIRE
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.BLOWDART_FIRE"
msgid "Shall we set the world on fire?"
msgstr "Sollen wir die Welt in Flammen setzen?"

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.BLOWDART_LAVA
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.BLOWDART_LAVA"
msgid "To pierce the hearts of my foes..."
msgstr "Um die Herzen meiner Feinde zu durchbohren ..."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.BLOWDART_LAVA2
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.BLOWDART_LAVA2"
msgid "To burn and pierce!"
msgstr "Zum Brennen und Durchbohren!"

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.BLOWDART_PIPE
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.BLOWDART_PIPE"
msgid "Blow in one end, pain comes out the other."
msgstr "Ich blase in das eine Ende rein und auf der anderen Seite kommen Schmerzen raus."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.BLOWDART_SLEEP
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.BLOWDART_SLEEP"
msgid "Not the big sleep, just a temporary one."
msgstr "Nicht mal ein endgültige Schlaf, sondern nur ein temporärer."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.BLOWDART_YELLOW
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.BLOWDART_YELLOW"
msgid "Airborne lightning and death."
msgstr "Blitz und Tod in der Luft."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.BLUEAMULET
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.BLUEAMULET"
msgid "A familiar, chilling embrace."
msgstr "Eine vertraut frostige Umarmung."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.BLUEGEM
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.BLUEGEM"
msgid "Blue like... er... a sad bird?"
msgstr "Blau wie ... ähm ... eine Meise?"

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.BLUEMOONEYE
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.BLUEMOONEYE"
msgid "Such an icy gaze..."
msgstr "Solch ein eisiger Blick ..."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.BLUEPRINT.COMMON
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.BLUEPRINT.COMMON"
msgid "Whoever drew this is probably dead."
msgstr "Wer auch immer das gezeichnet hat, ist wahrscheinlich tot."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.BLUEPRINT.RARE
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.BLUEPRINT.RARE"
msgid "I'm surprised we didn't die trying to get this."
msgstr "Ich bin überrascht, dass wir den Versuch, das zu bekommen, überlebt haben."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.BLUE_CAP
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.BLUE_CAP"
msgid "A fungus to preserve the monotony."
msgstr "Ein Pilz, um die Eintönigkeit zu bewahren."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.BLUE_CAP_COOKED
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.BLUE_CAP_COOKED"
msgid "All is malleable."
msgstr "Vollkommen weich."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.BLUE_MUSHROOM.GENERIC
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.BLUE_MUSHROOM.GENERIC"
msgid "Musty."
msgstr "Muffig."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.BLUE_MUSHROOM.INGROUND
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.BLUE_MUSHROOM.INGROUND"
msgid "I would hide too, if I could."
msgstr "Wenn ich könnte, würd ich mich auch verstecken."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.BLUE_MUSHROOM.PICKED
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.BLUE_MUSHROOM.PICKED"
msgid "Harvested."
msgstr "Geerntet."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.BOARDS
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.BOARDS"
msgid "Even scarier for the trees."
msgstr "Für Bäume noch erschreckender."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.BOARON
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.BOARON"
msgid "A shame you have to perish."
msgstr "Schade, dass du sterben musst."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.BOARRIOR
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.BOARRIOR"
msgid "Your death will be swift."
msgstr "Dein Tod wird schnell sein."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.BOATFRAGMENT03
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.BOATFRAGMENT03"
msgid "Wreckage is all that remains."
msgstr "Trümmer sind alles, was bleibt."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.BOATFRAGMENT04
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.BOATFRAGMENT04"
msgid "Wreckage is all that remains."
msgstr "Trümmer sind alles, was bleibt."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.BOATFRAGMENT05
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.BOATFRAGMENT05"
msgid "Wreckage is all that remains."
msgstr "Trümmer sind alles, was bleibt."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.BOATPATCH
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.BOATPATCH"
msgid "To mend what the cruel seas have crushed."
msgstr "Zum Flicken, was die See grausam zerstört."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.BOATPATCH_KELP
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.BOATPATCH_KELP"
msgid "It will probably fall apart before I can reach shore. If I'm lucky."
msgstr "Es wird wahrscheinlich auseinanderfallen, bevor ich den Strand erreiche. Wenn ich Glück habe."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.BOATRACE_CHECKPOINT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.BOATRACE_CHECKPOINT"
msgid "Where do we go from here?"
msgstr "Und wohin müssen wir nun?"

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.BOATRACE_CHECKPOINT_THROWABLE_DEPLOYKIT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.BOATRACE_CHECKPOINT_THROWABLE_DEPLOYKIT"
msgid "I should throw this in the water."
msgstr "Das sollte ich ins Wasser werfen."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.BOATRACE_PRIMEMATE
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.BOATRACE_PRIMEMATE"
msgid "We are all just racing to the end."
msgstr "Wir beeilen uns alle einfach nur, ans Ende zu kommen."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.BOATRACE_SEASTACK
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.BOATRACE_SEASTACK"
msgid "Why try to avoid the inevitable?"
msgstr "Warum versuchen, dem Unvermeidlichen zu entrinnen?"

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.BOATRACE_SEASTACK_MONKEY
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.BOATRACE_SEASTACK_MONKEY"
msgid "Why try to avoid the inevitable?"
msgstr "Warum versuchen, dem Unvermeidlichen zu entrinnen?"

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.BOATRACE_SEASTACK_MONKEY_THROWABLE_DEPLOYKIT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.BOATRACE_SEASTACK_MONKEY_THROWABLE_DEPLOYKIT"
msgid "A useful guide, or a marker for a watery grave..."
msgstr "Eine nützliche Anleitung oder Markierung für ein nasses Grab ..."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.BOATRACE_SEASTACK_THROWABLE_DEPLOYKIT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.BOATRACE_SEASTACK_THROWABLE_DEPLOYKIT"
msgid "A useful guide, or a marker for a watery grave..."
msgstr "Eine nützliche Anleitung oder Markierung für ein nasses Grab ..."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.BOATRACE_SPECTATOR_DRAGONLING
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.BOATRACE_SPECTATOR_DRAGONLING"
msgid "Will you silently bear witness to what befalls us?"
msgstr "Wirst du stiller Zeuge dessen sein, was uns befällt?"

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.BOATRACE_START
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.BOATRACE_START"
msgid "Is this the start or the end? Or the start of the end?"
msgstr "Ist dies der Anfang oder das Ende? Oder der Anfang vom Ende?"

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.BOATRACE_START_THROWABLE_DEPLOYKIT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.BOATRACE_START_THROWABLE_DEPLOYKIT"
msgid "Does it matter where? It's all a game isn't it?"
msgstr "Ist es von Bedeutung, wo man das aufstellt? Letzten Endes ist alles nur ein Spiel, nicht wahr?"

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.BOAT_ANCIENT_CONTAINER
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.BOAT_ANCIENT_CONTAINER"
msgid "I could put things in there. I guess."
msgstr "Ich könnte Dinge da hineinlegen. Nehme ich mal an."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.BOAT_ANCIENT_ITEM
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.BOAT_ANCIENT_ITEM"
msgid "It looks like it will be quite sturdy. Oh well."
msgstr "Es sieht aus, als wäre es ziemlich robust. Ach na ja."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.BOAT_BUMPER_CRABKING
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.BOAT_BUMPER_CRABKING"
msgid "Looks strong. Are we afraid to die?"
msgstr "Sieht stark aus. Haben wir Angst zu sterben?"

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.BOAT_BUMPER_CRABKING_KIT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.BOAT_BUMPER_CRABKING_KIT"
msgid "I suppose I should make myself useful."
msgstr "Ich schätze, ich sollte mich nützlich machen."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.BOAT_BUMPER_KELP
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.BOAT_BUMPER_KELP"
msgid "It will only prolong the inevitable."
msgstr "Das wird das Unvermeidliche nur hinauszögern."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.BOAT_BUMPER_KELP_KIT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.BOAT_BUMPER_KELP_KIT"
msgid "I suppose I should make myself useful."
msgstr "Ich schätze, ich sollte mich nützlich machen."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.BOAT_BUMPER_SHELL
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.BOAT_BUMPER_SHELL"
msgid "It will only prolong the inevitable."
msgstr "Das wird das Unvermeidliche nur hinauszögern."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.BOAT_BUMPER_SHELL_KIT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.BOAT_BUMPER_SHELL_KIT"
msgid "I suppose I should make myself useful."
msgstr "Ich schätze, ich sollte mich nützlich machen."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.BOAT_BUMPER_YOTD
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.BOAT_BUMPER_YOTD"
msgid "My boat is baring its teeth."
msgstr "Mein Boot zeigt Zähne."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.BOAT_BUMPER_YOTD_KIT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.BOAT_BUMPER_YOTD_KIT"
msgid "I suppose I should make myself useful."
msgstr "Ich schätze, ich sollte mich nützlich machen."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.BOAT_CANNON.AMMOLOADED
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.BOAT_CANNON.AMMOLOADED"
msgid "What irreparable damage will it cause?"
msgstr "Welch irreparablen Schaden wird das verursachen?"

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.BOAT_CANNON.GENERIC
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.BOAT_CANNON.GENERIC"
msgid "It's empty inside..."
msgstr "Drinnen ist leer ..."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.BOAT_CANNON.NOAMMO
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.BOAT_CANNON.NOAMMO"
msgid "I have nothing that can fill the void... of this empty cannon."
msgstr "Ich habe nichts, das das Loch füllen könnte ... unter dem diese Kanone leidet."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.BOAT_CANNON_KIT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.BOAT_CANNON_KIT"
msgid "A creation of destruction."
msgstr "Eine Schöpfung zur Zerstörung."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.BOAT_GRASS_ITEM
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.BOAT_GRASS_ITEM"
msgid "It will make a rather flimsy boat. I'll likely drown."
msgstr "Das gibt ein ziemlich schwaches Boot ab. Wahrscheinlich werde ich ertrinken."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.BOAT_ITEM
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.BOAT_ITEM"
msgid "It's for making a boat."
msgstr "Das ist für ein Boot."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.BOAT_LEAK
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.BOAT_LEAK"
msgid "I always knew the ocean floor would be my final resting place."
msgstr "Ich wusste schon immer, dass ich die letzte Ruhe auf dem Meeresboden finde."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.BOAT_MAGNET.ACTIVATED
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.BOAT_MAGNET.ACTIVATED"
msgid "Will it draw me toward safety or destruction?"
msgstr "Wird er die Sicherheit oder das Verderben anziehen?"

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.BOAT_MAGNET.GENERIC
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.BOAT_MAGNET.GENERIC"
msgid "It looks so... silly."
msgstr "Sieht so ... albern aus."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.BOAT_MAGNET_BEACON.ACTIVATED
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.BOAT_MAGNET_BEACON.ACTIVATED"
msgid "Oh. I suppose it's working."
msgstr "Oh. Ich schätze, das funktioniert."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.BOAT_MAGNET_BEACON.GENERIC
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.BOAT_MAGNET_BEACON.GENERIC"
msgid "It will draw others near."
msgstr "Es wird andere anlocken."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.BOAT_MAGNET_KIT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.BOAT_MAGNET_KIT"
msgid "I'm left to pick up the pieces..."
msgstr "Und ich muss mich wieder um alles kümmern ..."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.BOAT_ROTATOR
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.BOAT_ROTATOR"
msgid "If only I could turn everything around so easily."
msgstr "Wenn ich doch nur genauso einfach umdrehen könnte."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.BOAT_ROTATOR_KIT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.BOAT_ROTATOR_KIT"
msgid "I could build a rudder, I suppose..."
msgstr "Ich könnte ein Ruder bauen, nehme ich an ..."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.BODYPILLOW_BEEFALOWOOL
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.BODYPILLOW_BEEFALOWOOL"
msgid "This one is just right. Except for the smell."
msgstr "Das Ding ist einfach genau richtig. Außer dessen Geruch."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.BODYPILLOW_KELP
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.BODYPILLOW_KELP"
msgid "This one is too... kelpy."
msgstr "Das Ding ist zu ... seetangig."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.BODYPILLOW_PETALS
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.BODYPILLOW_PETALS"
msgid "This one is too soft."
msgstr "Das Ding ist zu ... weich."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.BODYPILLOW_STEELWOOL
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.BODYPILLOW_STEELWOOL"
msgid "This one is too hard."
msgstr "Das Ding ist zu ... hart."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.BOMB_LUNARPLANT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.BOMB_LUNARPLANT"
msgid "An instrument of destruction."
msgstr "Ein Instrument der Zerstörung."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.BOMB_LUNARPLANT_WORMWOOD
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.BOMB_LUNARPLANT_WORMWOOD"
msgid "It's far deadlier than before."
msgstr "Sie ist noch viel tödlicher als zuvor."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.BONESHARD
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.BONESHARD"
msgid "Choking hazard."
msgstr "Erstickungsgefahr."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.BONESOUP
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.BONESOUP"
msgid "Supper looks good."
msgstr "Das Essen sieht gut aus."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.BONESTEW
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.BONESTEW"
msgid "You'd be surprised how much life can be gleaned from death and bones."
msgstr "Es wird dich überraschen, wie viel Leben aus Tod und Knochen entsteht."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.BOOKSTATION.BURNT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.BOOKSTATION.BURNT"
msgid "It's all burned away."
msgstr "Es ist alles verbrannt."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.BOOKSTATION.GENERIC
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.BOOKSTATION.GENERIC"
msgid "How I miss my poetry books."
msgstr "Ich vermisse meine Poesiebücher so sehr."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.BOOK_BEES
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.BOOK_BEES"
msgid "Bees live such short, unremarkable lives."
msgstr "Bienen leben ein solch kurzes und nicht weiter bemerkenswertes Leben."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.BOOK_BIRDS
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.BOOK_BIRDS"
msgid "Will it teach me to fly away from here?"
msgstr "Wird es mir beibringen, von hier wegzufliegen?"

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.BOOK_BRIMSTONE
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.BOOK_BRIMSTONE"
msgid "The tome to end it all..."
msgstr "Das Buch aller Bücher ..."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.BOOK_ELEMENTAL
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.BOOK_ELEMENTAL"
msgid "I would not want such power."
msgstr "Ich würde eine solche Macht nicht wollen."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.BOOK_FIRE
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.BOOK_FIRE"
msgid "What if we let this world fall to ash?"
msgstr "Was, wenn wir die Welt zu Asche werden lassen?"

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.BOOK_FISH
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.BOOK_FISH"
msgid "Poor fish, so easily murdered."
msgstr "Armer Fisch. So einfach umzubringen."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.BOOK_FOSSIL
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.BOOK_FOSSIL"
msgid "There is power in words."
msgstr "In Worten liegt Macht."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.BOOK_GARDENING
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.BOOK_GARDENING"
msgid "Imagine, a rolling field of red flowers..."
msgstr "Man stelle sich ein Feld voll roter Blumen vor ..."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.BOOK_HORTICULTURE
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.BOOK_HORTICULTURE"
msgid "I'm not very good at keeping things alive."
msgstr "Ich bin nicht sehr gut darin, Dinge am Leben zu erhalten."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.BOOK_HORTICULTURE_UPGRADED
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.BOOK_HORTICULTURE_UPGRADED"
msgid "We help the plants grow, only to cull them in their prime."
msgstr "Wir helfen den Pflanzen zu wachsen, nur um sie in ihrer Blüte auszumerzen."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.BOOK_LIGHT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.BOOK_LIGHT"
msgid "It won't save us from the darkness forever."
msgstr "Es wird uns nicht ewig vor der Dunkelheit bewahren."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.BOOK_LIGHT_UPGRADED
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.BOOK_LIGHT_UPGRADED"
msgid "The brighter the light, the deeper the shadows..."
msgstr "Je heller das Licht, desto tiefer die Schatten ..."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.BOOK_MOON
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.BOOK_MOON"
msgid "Let the moon turn its cold gaze on us once again."
msgstr "Lass den Mond abermals seinen kalten Blick auf uns werfen."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.BOOK_RAIN
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.BOOK_RAIN"
msgid "Oh... I suppose I was hoping it might involve more candles and chanting."
msgstr "Oh ... ich hatte gehofft, dass es mehr Kerzen und Sprechchöre benötigt."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.BOOK_RESEARCH_STATION
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.BOOK_RESEARCH_STATION"
msgid "It looks so... boring..."
msgstr "Sieht so ... langweilig aus."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.BOOK_SILVICULTURE
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.BOOK_SILVICULTURE"
msgid "What secrets lie deep in the forest?"
msgstr "Welche Geheimnisse schlummern tief im Wald?"

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.BOOK_SLEEP
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.BOOK_SLEEP"
msgid "Does it impart an eternal slumber?"
msgstr "Gibt es einen ewigen Schlaf?"

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.BOOK_TEMPERATURE
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.BOOK_TEMPERATURE"
msgid "What does it matter? I'll always feel cold inside."
msgstr "Und wenn schon? Draußen wird mir immer kalt sein."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.BOOK_TENTACLES
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.BOOK_TENTACLES"
msgid "Does this world need more beasts?"
msgstr "Braucht diese Welt mehr Bestien?"

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.BOOK_WEB
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.BOOK_WEB"
msgid "I'm not afraid of spiders."
msgstr "Ich habe keine Angst vor Spinnen."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.BOOMERANG
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.BOOMERANG"
msgid "Death returns to the sender."
msgstr "Der Tod kehrt zurück zum Absender."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.BOOTLEG
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.BOOTLEG"
msgid "It will just take me from one unpleasant place to another."
msgstr "Es wird mich von einem unangenehmen Ort zum nächsten bringen."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.BROKEN_FORGEDITEM
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.BROKEN_FORGEDITEM"
msgid "A broken mockery of what it once was."
msgstr "Ein defekter Hohn dessen, was es mal war."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.BROKEN_FUMAROLETOOLITEM
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.BROKEN_FUMAROLETOOLITEM"
msgid "It needs someplace warm to become whole again."
msgstr "Es braucht einen warmen Ort, um wieder ganz zu werden."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.BRUSH
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.BRUSH"
msgid "Oh, to rid the world of fluff."
msgstr "Wie schön wäre eine Welt ohne Fussel."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.BUGNET
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.BUGNET"
msgid "A prison for tiny insects."
msgstr "Ein Gefängnis für winzige Insekten."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.BULLKELP_PLANT.GENERIC
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.BULLKELP_PLANT.GENERIC"
msgid "It's just seaweed."
msgstr "Es ist nur Seetang."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.BULLKELP_PLANT.PICKED
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.BULLKELP_PLANT.PICKED"
msgid "There's no more seaweed here."
msgstr "Kein Seetang mehr da."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.BULLKELP_ROOT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.BULLKELP_ROOT"
msgid "It's like a very slimy whip."
msgstr "Wie eine schleimige Peitsche."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.BUNDLE
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.BUNDLE"
msgid "I don't even remember what's within anymore..."
msgstr "Ich weiß nicht einmal mehr, was da drin ist ..."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.BUNDLEWRAP
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.BUNDLEWRAP"
msgid "Abigail always helped me tie the bow."
msgstr "Abigail hat mir immer geholfen, die Fliege zu binden."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.BUNNYMAN
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.BUNNYMAN"
msgid "What tormented inner lives they must have."
msgstr "Was für eine gequälte Seele die haben müssen."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.BUNNYSTEW
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.BUNNYSTEW"
msgid "You were fast, little rabbit, but death is faster."
msgstr "Du warst schnell, kleiner Hase, aber der Tod ist schneller."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.BURNT_MARSH_BUSH
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.BURNT_MARSH_BUSH"
msgid "It's unspeakably burnt."
msgstr "Unbeschreiblich verbrannt."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.BUSHHAT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.BUSHHAT"
msgid "I'm already practically invisible..."
msgstr "Ich bin schon fast unsichtbar..."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.BUTTER
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.BUTTER"
msgid "I wasn't expecting that."
msgstr "Das hab ich nicht erwartet."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.BUTTERFLY.GENERIC
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.BUTTERFLY.GENERIC"
msgid "Pretty, but short-lived."
msgstr "Hübsch, aber kurzlebig."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.BUTTERFLY.HELD
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.BUTTERFLY.HELD"
msgid "I hold its life in my hands."
msgstr "Ich halte sein Leben in meinen Händen."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.BUTTERFLYMUFFIN
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.BUTTERFLYMUFFIN"
msgid "Let's see you get out of this sugary trap!"
msgstr "Ich bin gespannt, wie du aus dieser Zuckerfalle rauskommen willst."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.BUTTERFLYWINGS
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.BUTTERFLYWINGS"
msgid "No more can the butterfly soar."
msgstr "Der Schmetterling kann nicht mehr aufsteigen."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.BUZZARD
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.BUZZARD"
msgid "I hear they feed on the dead."
msgstr "Ich hörte, dass sie sich von den Toten ernähren."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.BUZZARDCORPSE.BURNING
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.BUZZARDCORPSE.BURNING"
msgid "Now it is truly free."
msgstr "Jetzt ist er wirklich frei."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.BUZZARDCORPSE.GENERIC
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.BUZZARDCORPSE.GENERIC"
msgid "Poor bird."
msgstr "Armer Vogel."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.BUZZARDCORPSE.REVIVING
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.BUZZARDCORPSE.REVIVING"
msgid "There can be a fate worse than death."
msgstr "Es kann ein Schicksal geben, das schlimmer ist als der Tod."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.CABBAGEROLLS
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.CABBAGEROLLS"
msgid "I wouldn't mind rolling up in a blanket and forgetting my troubles..."
msgstr "Wäre schön, sich in eine Decke zu wickeln und die Sorgen zu vergessen ..."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.CACTUS.GENERIC
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.CACTUS.GENERIC"
msgid "Knives out."
msgstr "Die Messer sind gewetzt."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.CACTUS.PICKED
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.CACTUS.PICKED"
msgid "Flattened."
msgstr "Abgeflacht."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.CACTUS_FLOWER
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.CACTUS_FLOWER"
msgid "Even the knife-plant has a flower. Ugh."
msgstr "Selbst die Messerpflanze hat eine Blüte. Igitt."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.CACTUS_MEAT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.CACTUS_MEAT"
msgid "It's still dangerous."
msgstr "Immer noch gefährlich."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.CACTUS_MEAT_COOKED
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.CACTUS_MEAT_COOKED"
msgid "Its defenses have been stripped away."
msgstr "Hat keinerlei Verteidigung mehr."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.CALIFORNIAROLL
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.CALIFORNIAROLL"
msgid "A cold fish, dressed up in a seaweed jacket."
msgstr "Kalter Fisch in einem Jäckchen aus Seetang."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.CAMPFIRE.EMBERS
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.CAMPFIRE.EMBERS"
msgid "Darkness is looming."
msgstr "Es wird gleich dunkel."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.CAMPFIRE.GENERIC
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.CAMPFIRE.GENERIC"
msgid "I might survive this night!"
msgstr "Ich könnte diese Nacht überleben!"

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.CAMPFIRE.HIGH
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.CAMPFIRE.HIGH"
msgid "A vision of Hell!"
msgstr "Eine Vision der Hölle!"

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.CAMPFIRE.LOW
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.CAMPFIRE.LOW"
msgid "The gloom encroaches."
msgstr "Die Dunkelheit kommt."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.CAMPFIRE.NORMAL
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.CAMPFIRE.NORMAL"
msgid "It's a fire."
msgstr "Ein Feuer."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.CAMPFIRE.OUT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.CAMPFIRE.OUT"
msgid "That is not a good sign."
msgstr "Das ist kein gutes Zeichen."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.CANARY.GENERIC
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.CANARY.GENERIC"
msgid "Such a cheery yellow... I can't stand it."
msgstr "So ein fröhliches Gelb ... Ich kann es nicht ausstehen."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.CANARY.HELD
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.CANARY.HELD"
msgid "You're at my mercy, bird."
msgstr "Du bist mir ausgeliefert, Vogel."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.CANARY_POISONED
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.CANARY_POISONED"
msgid "Pestilence and death will soon claim you."
msgstr "Pest und Tod werden dich bald holen."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.CANDYBAG
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.CANDYBAG"
msgid "It's for putting nice things in..."
msgstr "Darin kann man schöne Dinge aufbewahren ..."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.CANE
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.CANE"
msgid "To explore to the ends of this wretched world."
msgstr "Um bis ans Ende dieser elenden Welt blicken zu können."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.CANNONBALL_ROCK_ITEM
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.CANNONBALL_ROCK_ITEM"
msgid "I must carry this weight... to the cannon, at least."
msgstr "Ich muss dieses Gewicht ... zur Kanone tragen ... mindestens."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.CARNIVALCANNON.COOLDOWN
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.CARNIVALCANNON.COOLDOWN"
msgid "Heehee...!"
msgstr "Heehee ...!"

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.CARNIVALCANNON.GENERIC
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.CARNIVALCANNON.GENERIC"
msgid "Oh. That might be... f-fun..."
msgstr "Oh. Das könnte ... l-lustig sein ..."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.CARNIVALCANNON_KIT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.CARNIVALCANNON_KIT"
msgid "I suppose I should try to be useful..."
msgstr "Ich sollte wohl versuchen, mich nützlich zu machen ..."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.CARNIVALDECOR_BANNER
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.CARNIVALDECOR_BANNER"
msgid "Such a simple thing, but somehow watching it makes my heart lighter."
msgstr "Solch eine simple Sache, aber irgendwie lässt der Anblick mein Herz aufatmen."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.CARNIVALDECOR_BANNER_KIT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.CARNIVALDECOR_BANNER_KIT"
msgid "I suppose I should try to be useful..."
msgstr "Ich sollte wohl versuchen, mich nützlich zu machen ..."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.CARNIVALDECOR_EGGRIDE
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.CARNIVALDECOR_EGGRIDE"
msgid "I doubt those eggs will ever hatch."
msgstr "Ich glaube nicht, dass diese Eier je schlüpfen werden."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.CARNIVALDECOR_EGGRIDE_KIT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.CARNIVALDECOR_EGGRIDE_KIT"
msgid "I suppose I should try to be useful..."
msgstr "Ich sollte wohl versuchen, mich nützlich zu machen ..."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.CARNIVALDECOR_FIGURE.GENERIC
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.CARNIVALDECOR_FIGURE.GENERIC"
msgid "Oh. It's a little wooden statue."
msgstr "Oh. Das ist eine kleine Holzstatue."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.CARNIVALDECOR_FIGURE.RARE
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.CARNIVALDECOR_FIGURE.RARE"
msgid "Here it shall rest, forever."
msgstr "Hier soll sie auf ewig ruhen."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.CARNIVALDECOR_FIGURE.UNCOMMON
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.CARNIVALDECOR_FIGURE.UNCOMMON"
msgid "The colors are so cheery, yet I don't despise it. How odd."
msgstr "Die Farben sind so fröhlich, und trotzdem verabscheue ich sie nicht. Wie seltsam."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.CARNIVALDECOR_FIGURE_KIT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.CARNIVALDECOR_FIGURE_KIT"
msgid "What secrets does it hide?"
msgstr "Welche Geheimnisse verbergen sich darin?"

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.CARNIVALDECOR_FIGURE_KIT_SEASON2
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.CARNIVALDECOR_FIGURE_KIT_SEASON2"
msgid "What secrets does it hide?"
msgstr "Welche Geheimnisse verbergen sich darin?"

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.CARNIVALDECOR_LAMP
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.CARNIVALDECOR_LAMP"
msgid "It can't hold back the darkness forever."
msgstr "Sie kann die Dunkelheit nicht ewig in Schach halten."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.CARNIVALDECOR_LAMP_KIT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.CARNIVALDECOR_LAMP_KIT"
msgid "I suppose I should try to be useful..."
msgstr "Ich sollte wohl versuchen, mich nützlich zu machen ..."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.CARNIVALDECOR_PLANT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.CARNIVALDECOR_PLANT"
msgid "A small reminder of... a nice day."
msgstr "Eine kleine Erinnerung an ... einen schönen Tag."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.CARNIVALDECOR_PLANT_KIT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.CARNIVALDECOR_PLANT_KIT"
msgid "I suppose I should try to be useful..."
msgstr "Ich sollte wohl versuchen, mich nützlich zu machen ..."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.CARNIVALFOOD_CORNTEA
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.CARNIVALFOOD_CORNTEA"
msgid "Oh. There really is corn in it..."
msgstr "Oh. Enthält ja wirklich Mais ..."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.CARNIVALGAME_FEEDCHICKS_FOOD
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.CARNIVALGAME_FEEDCHICKS_FOOD"
msgid "At least they're not real worms."
msgstr "Wenigstens sind es keine echten Würmer."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.CARNIVALGAME_FEEDCHICKS_KIT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.CARNIVALGAME_FEEDCHICKS_KIT"
msgid "Can I... help set up the carnival?"
msgstr "Kann ich ... dabei helfen, den Karneval aufzubauen?"

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.CARNIVALGAME_FEEDCHICKS_NEST
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.CARNIVALGAME_FEEDCHICKS_NEST"
msgid "It's a little door."
msgstr "Das ist eine kleine Tür."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.CARNIVALGAME_FEEDCHICKS_STATION.GENERIC
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.CARNIVALGAME_FEEDCHICKS_STATION.GENERIC"
msgid "It wants something first... something shiny."
msgstr "Es will erst etwas haben ... Etwas Glänzendes."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.CARNIVALGAME_FEEDCHICKS_STATION.PLAYING
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.CARNIVALGAME_FEEDCHICKS_STATION.PLAYING"
msgid "What a funny game."
msgstr "Was für ein lustiges Spiel!"

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.CARNIVALGAME_HERDING_CHICK
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.CARNIVALGAME_HERDING_CHICK"
msgid "You can't outrun the inevitable."
msgstr "Man kann dem Unvermeidlichen nicht entkommen."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.CARNIVALGAME_HERDING_KIT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.CARNIVALGAME_HERDING_KIT"
msgid "Can I... help set up the carnival?"
msgstr "Kann ich ... dabei helfen, den Karneval aufzubauen?"

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.CARNIVALGAME_HERDING_STATION.GENERIC
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.CARNIVALGAME_HERDING_STATION.GENERIC"
msgid "It wants something first... something shiny."
msgstr "Es will erst etwas haben ... Etwas Glänzendes."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.CARNIVALGAME_HERDING_STATION.PLAYING
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.CARNIVALGAME_HERDING_STATION.PLAYING"
msgid "They look so silly running about."
msgstr "Sie sehen so albern aus, wenn sie herumrennen."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.CARNIVALGAME_MEMORY_CARD.GENERIC
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.CARNIVALGAME_MEMORY_CARD.GENERIC"
msgid "It's a little door."
msgstr "Das ist eine kleine Tür."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.CARNIVALGAME_MEMORY_CARD.PLAYING
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.CARNIVALGAME_MEMORY_CARD.PLAYING"
msgid "Abigail, do you remember which one it was?"
msgstr "Abigail, weißt du noch, welche es war?"

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.CARNIVALGAME_MEMORY_KIT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.CARNIVALGAME_MEMORY_KIT"
msgid "Can I... help set up the carnival?"
msgstr "Kann ich ... dabei helfen, den Karneval aufzubauen?"

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.CARNIVALGAME_MEMORY_STATION.GENERIC
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.CARNIVALGAME_MEMORY_STATION.GENERIC"
msgid "It wants something first... something shiny."
msgstr "Es will erst etwas haben ... Etwas Glänzendes."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.CARNIVALGAME_MEMORY_STATION.PLAYING
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.CARNIVALGAME_MEMORY_STATION.PLAYING"
msgid "I'm very good at remembering... aren't I, Abigail?"
msgstr "Ich bin sehr gut darin, mich an Dinge zu erinnern ... Nicht wahr, Abigail?"

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.CARNIVALGAME_PUCKDROP_KIT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.CARNIVALGAME_PUCKDROP_KIT"
msgid "Can I... help set up the carnival?"
msgstr "Kann ich ... dabei helfen, den Karneval aufzubauen?"

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.CARNIVALGAME_PUCKDROP_STATION.GENERIC
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.CARNIVALGAME_PUCKDROP_STATION.GENERIC"
msgid "It wants something first... something shiny."
msgstr "Es will erst etwas haben ... Etwas Glänzendes."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.CARNIVALGAME_PUCKDROP_STATION.PLAYING
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.CARNIVALGAME_PUCKDROP_STATION.PLAYING"
msgid "The outcome is as unpredictable as life itself."
msgstr "Das Resultat ist genauso unvorhersehbar wie das Leben selbst."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.CARNIVALGAME_SHOOTING_BUTTON.GENERIC
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.CARNIVALGAME_SHOOTING_BUTTON.GENERIC"
msgid "It wants something first... something shiny."
msgstr "Es will erst etwas haben ... Etwas Glänzendes."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.CARNIVALGAME_SHOOTING_BUTTON.PLAYING
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.CARNIVALGAME_SHOOTING_BUTTON.PLAYING"
msgid "What a pretty button."
msgstr "Solch ein hübscher Knopf."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.CARNIVALGAME_SHOOTING_KIT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.CARNIVALGAME_SHOOTING_KIT"
msgid "Can I... help set up the carnival?"
msgstr "Kann ich ... dabei helfen, den Karneval aufzubauen?"

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.CARNIVALGAME_SHOOTING_STATION.GENERIC
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.CARNIVALGAME_SHOOTING_STATION.GENERIC"
msgid "It wants something first... something shiny."
msgstr "Es will erst etwas haben ... Etwas Glänzendes."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.CARNIVALGAME_SHOOTING_STATION.PLAYING
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.CARNIVALGAME_SHOOTING_STATION.PLAYING"
msgid "I think... I'd like to try to play..."
msgstr "Ich denke ... Ich würde das gerne mal ausprobieren ..."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.CARNIVALGAME_SHOOTING_TARGET.GENERIC
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.CARNIVALGAME_SHOOTING_TARGET.GENERIC"
msgid "It's a little door."
msgstr "Das ist eine kleine Tür."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.CARNIVALGAME_SHOOTING_TARGET.PLAYING
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.CARNIVALGAME_SHOOTING_TARGET.PLAYING"
msgid "They were created only to suffer."
msgstr "Sie wurden nur erschaffen, um zu leiden."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.CARNIVALGAME_WHEELSPIN_KIT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.CARNIVALGAME_WHEELSPIN_KIT"
msgid "Can I... help set up the carnival?"
msgstr "Kann ich ... dabei helfen, den Karneval aufzubauen?"

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.CARNIVALGAME_WHEELSPIN_STATION.GENERIC
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.CARNIVALGAME_WHEELSPIN_STATION.GENERIC"
msgid "It wants something first... something shiny."
msgstr "Es will erst etwas haben ... Etwas Glänzendes."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.CARNIVALGAME_WHEELSPIN_STATION.PLAYING
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.CARNIVALGAME_WHEELSPIN_STATION.PLAYING"
msgid "Oh... I think I'm doing... well?"
msgstr "Oh ... Ich glaube, ich mache das ... gut?"

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.CARNIVAL_BALL
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.CARNIVAL_BALL"
msgid "Won't you play with me, Abigail?"
msgstr "Willst du nicht mit mir spielen, Abigail?"

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.CARNIVAL_CROWKID
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.CARNIVAL_CROWKID"
msgid "A murder has flown in."
msgstr "Ein Schwarm kommt angeflogen."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.CARNIVAL_GAMETOKEN
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.CARNIVAL_GAMETOKEN"
msgid "It gleams in the light."
msgstr "Strahlt im Licht."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.CARNIVAL_HOST
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.CARNIVAL_HOST"
msgid "How do you do, Mr. Raven?"
msgstr "Wie geht es Ihnen, Herr Rabe?"

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.CARNIVAL_PLAZA.GENERIC
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.CARNIVAL_PLAZA.GENERIC"
msgid "Abigail thinks it needs some decorations around it."
msgstr "Abigail meint, dass noch etwas Dekoration nötig wäre."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.CARNIVAL_PLAZA.LEVEL_2
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.CARNIVAL_PLAZA.LEVEL_2"
msgid "The ravens seem quite drawn to the decorations."
msgstr "Die Raben scheinen von der Dekoration sehr angetan zu sein."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.CARNIVAL_PLAZA.LEVEL_3
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.CARNIVAL_PLAZA.LEVEL_3"
msgid "It does look quite pretty, doesn't it?"
msgstr "Das sieht schon recht hübsch aus, nicht wahr?"

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.CARNIVAL_PLAZA_KIT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.CARNIVAL_PLAZA_KIT"
msgid "Perhaps I might enjoy its shade one day."
msgstr "Vielleicht kann ich eines Tages seinen Schatten genießen."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.CARNIVAL_PRIZEBOOTH.GENERIC
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.CARNIVAL_PRIZEBOOTH.GENERIC"
msgid "Maybe I'll just take a peek..."
msgstr "Vielleicht werfe ich einfach einen winzig kleinen Blick darauf ..."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.CARNIVAL_PRIZEBOOTH_KIT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.CARNIVAL_PRIZEBOOTH_KIT"
msgid "I wonder what kind of prizes they have..."
msgstr "Ich frage mich, was es da für Preise gibt ..."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.CARNIVAL_PRIZETICKET.GENERIC
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.CARNIVAL_PRIZETICKET.GENERIC"
msgid "I... won something?"
msgstr "Ich ... habe etwas gewonnen?"

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.CARNIVAL_PRIZETICKET.GENERIC_LARGESTACK
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.CARNIVAL_PRIZETICKET.GENERIC_LARGESTACK"
msgid "M-maybe I'll take a look at the prizes...!"
msgstr "Vielleicht schaue ich mir die Preise mal an...!"

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.CARNIVAL_PRIZETICKET.GENERIC_SMALLSTACK
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.CARNIVAL_PRIZETICKET.GENERIC_SMALLSTACK"
msgid "I've collected quite a few now."
msgstr "Ich habe schon ziemlich viele gesammelt."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.CARNIVAL_SEEDPACKET
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.CARNIVAL_SEEDPACKET"
msgid "It tastes like disappointment."
msgstr "Schmeckt nach Enttäuschung."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.CARNIVAL_VEST_A
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.CARNIVAL_VEST_A"
msgid "I wish you could try it on Abigail, I think it would suit you."
msgstr "Ich wünschte, du könntest das anprobieren, Abigail, ich glaube, er würde dir stehen."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.CARNIVAL_VEST_B
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.CARNIVAL_VEST_B"
msgid "I find a curious comfort in the sound of dead, rustling leaves."
msgstr "Ich finde den Klang von toten, raschelnden Blättern seltsam tröstlich."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.CARNIVAL_VEST_C
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.CARNIVAL_VEST_C"
msgid "Perhaps I could join the ravens and fly far, far away..."
msgstr "Vielleicht könnte ich mich den Raben anschließen und weit, weit weg fliegen ..."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.CARPENTRY_BLADE_MOONGLASS
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.CARPENTRY_BLADE_MOONGLASS"
msgid "Pretty. If it was smaller I'd wear it around my neck."
msgstr "Hübsch. Wenn es kleiner wäre, würde ich es um den Hals tragen."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.CARPENTRY_STATION.BURNT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.CARPENTRY_STATION.BURNT"
msgid "...Perhaps not."
msgstr "... Vielleicht nicht."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.CARPENTRY_STATION.GENERIC
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.CARPENTRY_STATION.GENERIC"
msgid "Perhaps I could make something nice."
msgstr "Vielleicht könnte ich etwas nettes herstellen."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.CARRAT.DEAD
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.CARRAT.DEAD"
msgid "It is no more."
msgstr "Das war einmal."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.CARRAT.GENERIC
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.CARRAT.GENERIC"
msgid "I despise how it skitters..."
msgstr "Ich hasse es, wie sie huscht ..."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.CARRAT.HELD
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.CARRAT.HELD"
msgid "Freedom is not for you."
msgstr "Freiheit ist nichts für dich."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.CARRAT.SLEEPING
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.CARRAT.SLEEPING"
msgid "It is arrested by deepest sleep."
msgstr "Gefangen in tiefstem Schlaf."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.CARRAT_GHOSTRACER
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.CARRAT_GHOSTRACER"
msgid "It's merely a shade."
msgstr "Es ist nur ein Schatten."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.CARROT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.CARROT"
msgid "It's a carrot."
msgstr "Das ist eine Karotte."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.CARROT_COOKED
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.CARROT_COOKED"
msgid "It's a carrot that's gone through a gauntlet of fire."
msgstr "Die Karotte wurden aus allen Richtungen vom Feuer angegriffen."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.CARROT_OVERSIZED
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.CARROT_OVERSIZED"
msgid "A clump of giant, gnarled roots for eating."
msgstr "Ein Büschel riesiger, knorriger Wurzeln zum Essen."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.CARROT_PLANTED
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.CARROT_PLANTED"
msgid "It's a carrot that's in the ground."
msgstr "Das ist eine Karotte im Boden."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.CARROT_SEEDS
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.CARROT_SEEDS"
msgid "It's a plant that's waiting to be."
msgstr "Es ist eine Pflanze, die nur darauf wartet, zu sein."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.CARTOGRAPHYDESK.BURNING
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.CARTOGRAPHYDESK.BURNING"
msgid "Well, old maps always do look burnt at the edges..."
msgstr "Na ja, alte Karten sehen immer verbrannt aus an den Rändern ..."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.CARTOGRAPHYDESK.BURNT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.CARTOGRAPHYDESK.BURNT"
msgid "No more mapmaking, then."
msgstr "Dann werden wohl keine Karten mehr gemacht."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.CARTOGRAPHYDESK.GENERIC
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.CARTOGRAPHYDESK.GENERIC"
msgid "Maps are best with monsters drawn on the borders."
msgstr "Karten sind am schönsten, wenn sie am Rand Monster haben."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.CATCOON
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.CATCOON"
msgid "I wonder if it had a twin, too."
msgstr "Ich frage mich, ob sie auch einen Zwilling hat wie ich."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.CATCOONDEN.EMPTY
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.CATCOONDEN.EMPTY"
msgid "All cats must die."
msgstr "Alle Katzen müssen sterben."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.CATCOONDEN.GENERIC
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.CATCOONDEN.GENERIC"
msgid "I could curl up and die in there."
msgstr "Ich könnte mich dort drin zusammenrollen und sterben."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.CATCOONHAT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.CATCOONHAT"
msgid "Nothing like the stench of death on your head."
msgstr "Oh, der Gestank des Todes auf deinem Kopf."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.CATTOY_MOUSE
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.CATTOY_MOUSE"
msgid "The wheel is come full circle."
msgstr "Das Rad hat sich vollends gedreht."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.CAVEIN_BOULDER.GENERIC
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.CAVEIN_BOULDER.GENERIC"
msgid "Call me Sisyphus."
msgstr "Nenn mich Sisyphos."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.CAVEIN_BOULDER.RAISED
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.CAVEIN_BOULDER.RAISED"
msgid "So close, yet so far away."
msgstr "So nah und doch so fern."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.CAVE_BANANA
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.CAVE_BANANA"
msgid "The peels look dangerous."
msgstr "Die Schalen sehen bedenklich aus."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.CAVE_BANANA_BURNT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.CAVE_BANANA_BURNT"
msgid "The death and suffering never ends."
msgstr "Tod und Qual enden nie."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.CAVE_BANANA_COOKED
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.CAVE_BANANA_COOKED"
msgid "Warmed banana mush is so much better."
msgstr "Aufgewärmtes Bananenmus ist wirklich viel besser."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.CAVE_BANANA_TREE
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.CAVE_BANANA_TREE"
msgid "Poor plant, locked away from the sun."
msgstr "Arme Pflanze, von der Sonne abgeschnitten."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.CAVE_ENTRANCE
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.CAVE_ENTRANCE"
msgid "Someone is trying to keep the underground at bay."
msgstr "Jemand versucht, den Untergrund in Schach zu halten."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.CAVE_ENTRANCE_OPEN.FULL
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.CAVE_ENTRANCE_OPEN.FULL"
msgid "There's no room at the cave party for me..."
msgstr "Für mich ist kein Platz bei der Höhlenparty."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.CAVE_ENTRANCE_OPEN.GENERIC
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.CAVE_ENTRANCE_OPEN.GENERIC"
msgid "I'm too busy descending into madness to descend that cave."
msgstr "Ich bin schon am Verrücktwerden und jetzt soll ich auch noch da hinunter?"

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.CAVE_ENTRANCE_OPEN.OPEN
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.CAVE_ENTRANCE_OPEN.OPEN"
msgid "A great evil lurks beneath the surface."
msgstr "Unter der Oberfläche lauert ein großes Übel."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.CAVE_ENTRANCE_RUINS
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.CAVE_ENTRANCE_RUINS"
msgid "Someone is trying to keep the underground at bay."
msgstr "Jemand versucht, den Untergrund in Schach zu halten."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.CAVE_EXIT.FULL
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.CAVE_EXIT.FULL"
msgid "Oh... I guess I'm not invited to the surface party..."
msgstr "Oh ... Ich glaube, ich bin nicht zur Party eingeladen ..."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.CAVE_EXIT.GENERIC
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.CAVE_EXIT.GENERIC"
msgid "Why leave? The light here compliments my complexion."
msgstr "Warum nicht hierbleiben? Das Licht hier passt so gut zu meinem Teint."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.CAVE_EXIT.OPEN
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.CAVE_EXIT.OPEN"
msgid "The surface beckons."
msgstr "Die Erdoberfläche winkt."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.CAVE_FERN
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.CAVE_FERN"
msgid "A touch of color in the bleakness."
msgstr "Ein Hauch von Farbe in der Trostlosigkeit."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.CAVE_FERN_WITHERED
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.CAVE_FERN_WITHERED"
msgid "It's dead."
msgstr "Ist tot."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.CAVE_VENT_MITE.DEAD
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.CAVE_VENT_MITE.DEAD"
msgid "It's dead."
msgstr "Ist tot."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.CAVE_VENT_MITE.GENERIC
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.CAVE_VENT_MITE.GENERIC"
msgid "Has it ever been above ground?"
msgstr "War sie je an der Oberfläche?"

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.CAVE_VENT_MITE.SLEEPING
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.CAVE_VENT_MITE.SLEEPING"
msgid "It's asleep."
msgstr "Sie schläft."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.CAVE_VENT_MITE.VENTING
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.CAVE_VENT_MITE.VENTING"
msgid "It smells terrible."
msgstr "Pfui, das riecht schrecklich."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.CAVE_VENT_ROCK.GAS
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.CAVE_VENT_ROCK.GAS"
msgid "That's unpleasant."
msgstr "Das ist unangenehm."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.CAVE_VENT_ROCK.GENERIC
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.CAVE_VENT_ROCK.GENERIC"
msgid "There's nothing coming out... for now."
msgstr "Da kommt nichts raus ... vorerst."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.CAVE_VENT_ROCK.HOT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.CAVE_VENT_ROCK.HOT"
msgid "I prefer the cold's quiet embrace."
msgstr "Ich bevorzuge die stille Umarmung der Kälte."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.CAVE_VENT_ROCK.MIASMA
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.CAVE_VENT_ROCK.MIASMA"
msgid "One could drown in that black fog."
msgstr "Man könnte in diesem schwarzen Nebel ertrinken."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.CEILING_ROPE
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.CEILING_ROPE"
msgid "A way out."
msgstr "Ein Weg nach draußen."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.CEVICHE
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.CEVICHE"
msgid "All I taste is my sadness..."
msgstr "Ich schmecke nur meine Trauer ..."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.CHARCOAL
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.CHARCOAL"
msgid "Cold, dead and black, just like my heart."
msgstr "Sie ist kalt und tot, wie mein Herz."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.CHARLIERESIDUE
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.CHARLIERESIDUE"
msgid "only_used_by_winona"
msgstr "only_used_by_winona"

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.CHARLIEROSE
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.CHARLIEROSE"
msgid "only_used_by_winona"
msgstr "only_used_by_winona"

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.CHARLIE_HAND
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.CHARLIE_HAND"
msgid "Do I dare approach?"
msgstr "Wage ich mich heran?"

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.CHARLIE_HECKLER
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.CHARLIE_HECKLER"
msgid "Their words can't hurt me. Well, maybe just a little..."
msgstr "Ihre Worte können mich nicht verletzen. Na ja, ein bisschen vielleicht …"

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.CHARLIE_LECTURN
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.CHARLIE_LECTURN"
msgid "Perhaps there is a small part for me to play."
msgstr "Vielleicht gibt es auch für mich eine kleine Rolle."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.CHARLIE_NPC
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.CHARLIE_NPC"
msgid "Are you the true face of the darkness?"
msgstr "Bist du etwa das wahre Gesicht der Dunkelheit?"

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.CHARLIE_STAGE_POST
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.CHARLIE_STAGE_POST"
msgid "The perfect place for a tragedy."
msgstr "Der perfekte Ort für eine Tragödie."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.CHESSJUNK1
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.CHESSJUNK1"
msgid "Cold, dead artificial life."
msgstr "Kaltes, totes, künstliches Leben."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.CHESSJUNK2
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.CHESSJUNK2"
msgid "Cold, dead artificial life."
msgstr "Kaltes, totes, künstliches Leben."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.CHESSJUNK3
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.CHESSJUNK3"
msgid "Cold, dead artificial life."
msgstr "Kaltes, totes, künstliches Leben."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.CHESSPIECE_ANCHOR
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.CHESSPIECE_ANCHOR"
msgid "Why did we sculpt an anchor."
msgstr "Warum haben wir einen Anker geformt?"

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.CHESSPIECE_ANTLION
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.CHESSPIECE_ANTLION"
msgid "Still and lifeless."
msgstr "Still und leblos."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.CHESSPIECE_BEARGER
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.CHESSPIECE_BEARGER"
msgid "Ashes to ashes, bust to bust. Oh."
msgstr "Asche zu Asche, taub zu taub. Oh."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.CHESSPIECE_BEARGER_MUTATED
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.CHESSPIECE_BEARGER_MUTATED"
msgid "Its new lease on life was, well, short-lived."
msgstr "Dessen neuer Versuch zu leben war, nun ja, kurzlebig."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.CHESSPIECE_BEEFALO
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.CHESSPIECE_BEEFALO"
msgid "Merely a cold, lifeless copy."
msgstr "Bloß eine kalte, leblose Kopie."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.CHESSPIECE_BEEQUEEN
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.CHESSPIECE_BEEQUEEN"
msgid "She once had a sweet life."
msgstr "Sie hatte mal ein süßes Leben."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.CHESSPIECE_BISHOP.GENERIC
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.CHESSPIECE_BISHOP.GENERIC"
msgid "A piece, constrained to the board."
msgstr "Eine Spielfigur, die an das Spielbrett gebunden ist."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.CHESSPIECE_BISHOP.STRUGGLE
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.CHESSPIECE_BISHOP.STRUGGLE"
msgid "They're here."
msgstr "Sie sind hier."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.CHESSPIECE_BUTTERFLY
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.CHESSPIECE_BUTTERFLY"
msgid "But a simulacrum of life. Sigh."
msgstr "Nur ein Scheinbild des Lebens. Seufz."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.CHESSPIECE_CARRAT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.CHESSPIECE_CARRAT"
msgid "If only I could feel so serene."
msgstr "Könnte ich doch nur so heiter sein."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.CHESSPIECE_CATCOON
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.CHESSPIECE_CATCOON"
msgid "A reminder of brighter days."
msgstr "Eine Erinnerung an schönere Tage."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.CHESSPIECE_CLAYHOUND
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.CHESSPIECE_CLAYHOUND"
msgid "Happiness is a warm puppy... but this one is cold."
msgstr "Glück ist ein warmer Welpe ... aber dieser ist kalt."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.CHESSPIECE_CLAYWARG
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.CHESSPIECE_CLAYWARG"
msgid "It knows only fury."
msgstr "Kennt nur Wut."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.CHESSPIECE_CRABKING
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.CHESSPIECE_CRABKING"
msgid "We put him out of his misery."
msgstr "Wir erlösen ihn von seinem Leid."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.CHESSPIECE_DAYWALKER
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.CHESSPIECE_DAYWALKER"
msgid "A reminder that kindness only leads to pain."
msgstr "Eine Erinnerung daran, dass Freundlichkeit nur zu Schmerz führt."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.CHESSPIECE_DAYWALKER2
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.CHESSPIECE_DAYWALKER2"
msgid "His pain led to anger."
msgstr "Sein Schmerz verwandelte sich in Wut."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.CHESSPIECE_DEERCLOPS
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.CHESSPIECE_DEERCLOPS"
msgid "What a terrible beast."
msgstr "Was für eine schreckliche Bestie."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.CHESSPIECE_DEERCLOPS_MUTATED
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.CHESSPIECE_DEERCLOPS_MUTATED"
msgid "The beast came back even colder than before."
msgstr "Das Biest kam sogar noch kälter zurück als zuvor."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.CHESSPIECE_DEPTHWORM
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.CHESSPIECE_DEPTHWORM"
msgid "How curious, the things we choose to commemorate."
msgstr "Merkwürdig, mit welchen Dingen wir zelebrieren."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.CHESSPIECE_DRAGONFLY
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.CHESSPIECE_DRAGONFLY"
msgid "She now lies, cold as stone."
msgstr "Nun liegt sie da. Kalt wie ein Stein."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.CHESSPIECE_EYEOFTERROR
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.CHESSPIECE_EYEOFTERROR"
msgid "Its stony gaze will glare for eternity."
msgstr "Dieser steinerne Blick wird bis in alle Ewigkeit starren."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.CHESSPIECE_FORMAL
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.CHESSPIECE_FORMAL"
msgid "Alas, the king is but a figurehead, at best."
msgstr "Leider ist der König bestenfalls nur eine Galionsfigur."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.CHESSPIECE_GUARDIANPHASE3
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.CHESSPIECE_GUARDIANPHASE3"
msgid "It won't be looking down on us anymore."
msgstr "Er wird nicht mehr auf uns herabblicken."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.CHESSPIECE_HORNUCOPIA
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.CHESSPIECE_HORNUCOPIA"
msgid "A cold mockery."
msgstr "Kalter Hohn."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.CHESSPIECE_KITCOON
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.CHESSPIECE_KITCOON"
msgid "Hubris, undoubtedly."
msgstr "Anmaßung, zweifelsohne."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.CHESSPIECE_KLAUS
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.CHESSPIECE_KLAUS"
msgid "No more life in this festive spirit."
msgstr "Kein Leben mehr in diesem festlichen Geist."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.CHESSPIECE_KNIGHT.GENERIC
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.CHESSPIECE_KNIGHT.GENERIC"
msgid "Oh, if I could ride away into the night."
msgstr "Oh, wenn ich doch einfach in die Nacht reiten könnte."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.CHESSPIECE_KNIGHT.STRUGGLE
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.CHESSPIECE_KNIGHT.STRUGGLE"
msgid "They're here."
msgstr "Sie sind hier."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.CHESSPIECE_MALBATROSS
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.CHESSPIECE_MALBATROSS"
msgid "No more will she soar over the gloomy shoals."
msgstr "Kein Kreisen über den finsteren Untiefen mehr."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.CHESSPIECE_MANRABBIT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.CHESSPIECE_MANRABBIT"
msgid "A fleeting moment of joy, captured in stone."
msgstr "Ein flüchtiger Moment der Freude in Stein verewigt."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.CHESSPIECE_MINOTAUR
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.CHESSPIECE_MINOTAUR"
msgid "A testament to a lifetime spent alone in the dark."
msgstr "Zeugnis eines Lebens alleine in der Finsternis."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.CHESSPIECE_MOON
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.CHESSPIECE_MOON"
msgid "I'd prefer to look at this over the real thing."
msgstr "Diese Version finde ich schöner als den echten."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.CHESSPIECE_MOOSEGOOSE.1
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.CHESSPIECE_MOOSEGOOSE.1"
msgid "Such expression in her eyes."
msgstr "So viel Ausdruck in ihren Augen."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.CHESSPIECE_MUSE
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.CHESSPIECE_MUSE"
msgid "She holds the true power, here."
msgstr "Hier hat sie die wahre Kraft."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.CHESSPIECE_PAWN
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.CHESSPIECE_PAWN"
msgid "We are all but pawns in this game called \"life\"."
msgstr "Wir sind alle nur Schachfiguren in diesem Spiel namens \"Leben\"."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.CHESSPIECE_PIPE
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.CHESSPIECE_PIPE"
msgid "A bubble, frozen in time, can never pop."
msgstr "Eine Blase, eingefroren in der Zeit, kann nie platzen."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.CHESSPIECE_ROOK.GENERIC
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.CHESSPIECE_ROOK.GENERIC"
msgid "A mere minion to something greater."
msgstr "Ein bloßer Gehilfe zu etwas Größerem."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.CHESSPIECE_ROOK.STRUGGLE
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.CHESSPIECE_ROOK.STRUGGLE"
msgid "They're here."
msgstr "Sie sind hier."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.CHESSPIECE_SHARKBOI
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.CHESSPIECE_SHARKBOI"
msgid "Their cold shark heart was just misunderstood."
msgstr "Sein kaltes Haiherz wurde nur missverstanden."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.CHESSPIECE_STALKER
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.CHESSPIECE_STALKER"
msgid "Dark and cold, like my soul."
msgstr "Dunkel und kalt wie meine Seele."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.CHESSPIECE_TOADSTOOL
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.CHESSPIECE_TOADSTOOL"
msgid "A monument to fungal decay."
msgstr "Ein Denkmal des pilzigen Verfalls."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.CHESSPIECE_TWINSOFTERROR
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.CHESSPIECE_TWINSOFTERROR"
msgid "I still remember watching the light leave their eyes."
msgstr "Ich erinnere mich noch daran, wie das Licht in ihren Augen erlosch."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.CHESSPIECE_VAULT_PILLAR_GUARD
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.CHESSPIECE_VAULT_PILLAR_GUARD"
msgid "There's no life in this small sentry."
msgstr "In diesem kleinen Wachposten steckt kein Leben."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.CHESSPIECE_WAGBOSS_LUNAR
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.CHESSPIECE_WAGBOSS_LUNAR"
msgid "This doesn't capture its pain."
msgstr "Das fängt den Schmerz nicht richtig ein."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.CHESSPIECE_WAGBOSS_ROBOT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.CHESSPIECE_WAGBOSS_ROBOT"
msgid "It was built to bring death."
msgstr "Es wurde gebaut, um den Tod zu bringen."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.CHESSPIECE_WARG_MUTATED
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.CHESSPIECE_WARG_MUTATED"
msgid "Why was it able to come back? It's not fair..."
msgstr "Warum konnte er zurückkehren? Das ist nicht fair ..."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.CHESSPIECE_WORMBOSS
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.CHESSPIECE_WORMBOSS"
msgid "It consumed to fill its endless void."
msgstr "Es konsumierte, um seine endlose Leere zu füllen."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.CHESSPIECE_YOTD
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.CHESSPIECE_YOTD"
msgid "If only I could have a new start."
msgstr "Wenn ich doch nur von Neuem beginnen könnte."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.CHESSPIECE_YOTH
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.CHESSPIECE_YOTH"
msgid "Not quite the fairy tale version."
msgstr "Nicht ganz wie im Märchen."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.CHESSPIECE_YOTS
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.CHESSPIECE_YOTS"
msgid "How curious, the things we choose to commemorate."
msgstr "Es ist schon seltsam, welche Dinge wir zum Gedenken auswählen."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.CHESTER
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.CHESTER"
msgid "A fuzzy ball of emptiness."
msgstr "Eine flauschige Kugel der Leere."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.CHESTER_EYEBONE.GENERIC
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.CHESTER_EYEBONE.GENERIC"
msgid "It's looking into my soul."
msgstr "Er blickt in meine Seele."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.CHESTER_EYEBONE.WAITING
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.CHESTER_EYEBONE.WAITING"
msgid "Not so much sleeping as... waiting."
msgstr "Er schläft nicht, er ... wartet."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.CHESTUPGRADE_STACKSIZE
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.CHESTUPGRADE_STACKSIZE"
msgid "It will make the emptiness in my chest grow even bigger..."
msgstr "Es wird die Leere in meiner Brust nur noch anwachsen lassen ..."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.CHEST_MIMIC_REVEALED
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.CHEST_MIMIC_REVEALED"
msgid "I did not expect that."
msgstr "Das hatte ich nicht erwartet."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.CHUM
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.CHUM"
msgid "I had a pet fish once... it didn't last very long."
msgstr "Ich hatte mal einen Fisch ... Er hat nicht sehr lange gelebt."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.CLAYHOUND.GENERIC
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.CLAYHOUND.GENERIC"
msgid "My, what big teeth you have."
msgstr "Meine Güte, was für große Zähne du hast."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.CLAYHOUND.STATUE
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.CLAYHOUND.STATUE"
msgid "Naught but a pithy imitation of life."
msgstr "Nichts als eine schwache Imitation des Lebens."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.CLAYWARG.GENERIC
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.CLAYWARG.GENERIC"
msgid "To perish now would save me much sorrow."
msgstr "Jetzt zu sterben, würde mir viel Kummer ersparen."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.CLAYWARG.STATUE
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.CLAYWARG.STATUE"
msgid "There is no life in its eyes."
msgstr "Was für leblose Augen."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.COLDFIRE.EMBERS
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.COLDFIRE.EMBERS"
msgid "Darkness is looming."
msgstr "Es wird gleich dunkel."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.COLDFIRE.GENERIC
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.COLDFIRE.GENERIC"
msgid "I might survive this night!"
msgstr "Ich könnte diese Nacht überleben!"

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.COLDFIRE.HIGH
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.COLDFIRE.HIGH"
msgid "A vision of a frozen-over Hell!"
msgstr "Eine Vision der überfrierenden Hölle!"

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.COLDFIRE.LOW
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.COLDFIRE.LOW"
msgid "The gloom encroaches."
msgstr "Die Dunkelheit kommt."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.COLDFIRE.NORMAL
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.COLDFIRE.NORMAL"
msgid "It's a weird fire."
msgstr "Das ist ein seltsames Feuer."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.COLDFIRE.OUT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.COLDFIRE.OUT"
msgid "That is not a good sign."
msgstr "Das ist kein gutes Zeichen."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.COLDFIREPIT.EMBERS
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.COLDFIREPIT.EMBERS"
msgid "Darkness is looming."
msgstr "Es wird gleich dunkel."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.COLDFIREPIT.GENERIC
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.COLDFIREPIT.GENERIC"
msgid "I might survive this night!"
msgstr "Ich könnte diese Nacht überleben!"

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.COLDFIREPIT.HIGH
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.COLDFIREPIT.HIGH"
msgid "A vision of a frozen-over Hell!"
msgstr "Eine Vision der überfrierenden Hölle!"

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.COLDFIREPIT.LOW
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.COLDFIREPIT.LOW"
msgid "The gloom encroaches."
msgstr "Die Dunkelheit kommt."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.COLDFIREPIT.NORMAL
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.COLDFIREPIT.NORMAL"
msgid "It's a weird fire."
msgstr "Das ist ein seltsames Feuer."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.COLDFIREPIT.OUT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.COLDFIREPIT.OUT"
msgid "That is not a good sign."
msgstr "Das ist kein gutes Zeichen."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.COLLAPSEDCHEST
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.COLLAPSEDCHEST"
msgid "Is the emptyness all around us now?"
msgstr "Ist diese Leere jetzt um uns herum?"

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.COMPASS.E
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.COMPASS.E"
msgid "East."
msgstr "Osten."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.COMPASS.GENERIC
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.COMPASS.GENERIC"
msgid "I am directionless."
msgstr "Ich weiß nicht wohin."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.COMPASS.N
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.COMPASS.N"
msgid "North."
msgstr "Norden."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.COMPASS.NE
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.COMPASS.NE"
msgid "Northeast."
msgstr "Nordosten."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.COMPASS.NW
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.COMPASS.NW"
msgid "Northwest."
msgstr "Nordwesten."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.COMPASS.S
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.COMPASS.S"
msgid "North. No wait, South."
msgstr "Norden."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.COMPASS.SE
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.COMPASS.SE"
msgid "Southeast."
msgstr "Südosten."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.COMPASS.SW
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.COMPASS.SW"
msgid "Southwest."
msgstr "Südwesten."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.COMPASS.W
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.COMPASS.W"
msgid "West."
msgstr "Westen."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.COMPOST
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.COMPOST"
msgid "Rot and decay."
msgstr "Verfall und Verwesung."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.COMPOSTINGBIN.BALANCED
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.COMPOSTINGBIN.BALANCED"
msgid "I suppose this will do well enough."
msgstr "Ich nehme an, dass das gut genug ist."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.COMPOSTINGBIN.BURNT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.COMPOSTINGBIN.BURNT"
msgid "Ashes to ashes."
msgstr "Asche zu Asche."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.COMPOSTINGBIN.DRY
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.COMPOSTINGBIN.DRY"
msgid "Dry and brittle."
msgstr "Trocken und marode."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.COMPOSTINGBIN.GENERIC
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.COMPOSTINGBIN.GENERIC"
msgid "Food for worms."
msgstr "Wurmfutter."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.COMPOSTINGBIN.WET
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.COMPOSTINGBIN.WET"
msgid "It's far too watery, the poor plants might drown."
msgstr "Es ist viel zu wässrig, die armen Pflanzen könnten ertrinken."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.COMPOSTWRAP
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.COMPOSTWRAP"
msgid "It's poop. Sigh."
msgstr "Es ist Kacke. Seufz."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.CONSTRUCTION_PLANS
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.CONSTRUCTION_PLANS"
msgid "Shall I even bother building this?"
msgstr "Soll ich überhaupt versuchen, das zu bauen?"

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.COOKBOOK
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.COOKBOOK"
msgid "What's the point of filling my stomach when my heart remains empty..."
msgstr "Wozu sich den Bauch füllen, wenn das Herz leer bleibt ...?"

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.COOKEDMANDRAKE
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.COOKEDMANDRAKE"
msgid "It was a good death. You will be delicious."
msgstr "Es war ein guter Tod. Du wirst köstlich sein."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.COOKEDMEAT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.COOKEDMEAT"
msgid "The remaining blood has been cooked away."
msgstr "Das Blut ist wurde weggekocht."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.COOKEDMONSTERMEAT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.COOKEDMONSTERMEAT"
msgid "Cooked evil is still evil."
msgstr "Selbst gekocht ist das Böse noch schlecht."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.COOKEDSMALLMEAT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.COOKEDSMALLMEAT"
msgid "Fire has purified it."
msgstr "Das Feuer hat es gereinigt."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.COOKIECUTTER
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.COOKIECUTTER"
msgid "Their faces are twisted with hunger."
msgstr "Sie schneiden vor Hunger Grimassen."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.COOKIECUTTERHAT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.COOKIECUTTERHAT"
msgid "I'm protected, but at what cost to my dignity."
msgstr "Ich bin geschützt, aber welchen Preis muss meine Würde zahlen?"

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.COOKIECUTTERSHELL
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.COOKIECUTTERSHELL"
msgid "All that remains of its former occupant."
msgstr "Mehr bleibt vom bisherigen Bewohner nicht."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.COOKINGRECIPECARD.GENERIC
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.COOKINGRECIPECARD.GENERIC"
msgid "The writing has been smudged away, the words forgotten."
msgstr "Die Schrift wurde gänzlich vollgekleckert und die Worte vergessen."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.COOKPOT.BURNT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.COOKPOT.BURNT"
msgid "Burnt to a crisp."
msgstr "Zu einem Klumpen verbrannt."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.COOKPOT.COOKING_LONG
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.COOKPOT.COOKING_LONG"
msgid "Whatever's in there isn't dead yet."
msgstr "Was auch immer dort drin ist, ist noch nicht tot."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.COOKPOT.COOKING_SHORT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.COOKPOT.COOKING_SHORT"
msgid "It needs to boil."
msgstr "Es muss kochen."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.COOKPOT.DONE
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.COOKPOT.DONE"
msgid "Finally, food."
msgstr "Endlich, Essen."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.COOKPOT.EMPTY
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.COOKPOT.EMPTY"
msgid "As empty as my soul."
msgstr "Leer. Wie meine Seele."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.COOLANT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.COOLANT"
msgid "It seems alive but not."
msgstr "Es scheint lebendig zu sein, ist es aber nicht."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.COONTAIL
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.COONTAIL"
msgid "It's matted, patchy and putrid."
msgstr "Er ist verfilzt, fleckig und faulig."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.CORN
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.CORN"
msgid "I could make a corny joke, but I'll refrain."
msgstr "Ich konnte einen blöden Witz machen, aber ich lasse es."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.CORN_COOKED
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.CORN_COOKED"
msgid "This corn couldn't handle the heat."
msgstr "Dieser Mais hat die Hitze nicht vertragen."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.CORN_OVERSIZED
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.CORN_OVERSIZED"
msgid "I could pop enough corn for everyone."
msgstr "Ich könnte genug Mais für alle poppen."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.CORN_SEEDS
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.CORN_SEEDS"
msgid "The seed of life, so tiny in my hand."
msgstr "Der Samen für neues Leben. In meinen Händen!"

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.COSTUME_BLACKSMITH_BODY
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.COSTUME_BLACKSMITH_BODY"
msgid "Shall we play a game of dress-up, Abigail?"
msgstr "Wollen wir Verkleiden spielen, Abigail?"

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.COSTUME_DOLL_BODY
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.COSTUME_DOLL_BODY"
msgid "Shall we play a game of dress-up, Abigail?"
msgstr "Wollen wir Verkleiden spielen, Abigail?"

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.COSTUME_FOOL_BODY
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.COSTUME_FOOL_BODY"
msgid "Shall we play a game of dress-up, Abigail?"
msgstr "Wollen wir Verkleiden spielen, Abigail?"

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.COSTUME_KING_BODY
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.COSTUME_KING_BODY"
msgid "Shall we play a game of dress-up, Abigail?"
msgstr "Wollen wir Verkleiden spielen, Abigail?"

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.COSTUME_MIRROR_BODY
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.COSTUME_MIRROR_BODY"
msgid "Shall we play a game of dress-up, Abigail?"
msgstr "Wollen wir Verkleiden spielen, Abigail?"

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.COSTUME_PRINCESS_BODY
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.COSTUME_PRINCESS_BODY"
msgid "So pretty."
msgstr "So hübsch."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.COSTUME_QUEEN_BODY
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.COSTUME_QUEEN_BODY"
msgid "Shall we play a game of dress-up, Abigail?"
msgstr "Wollen wir Verkleiden spielen, Abigail?"

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.COSTUME_TREE_BODY
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.COSTUME_TREE_BODY"
msgid "Shall we play a game of dress-up, Abigail?"
msgstr "Wollen wir Verkleiden spielen, Abigail?"

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.COTL_TABERNACLE_LEVEL1.GENERIC
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.COTL_TABERNACLE_LEVEL1.GENERIC"
msgid "The fire has grown cold."
msgstr "Das Feuer ist kalt geworden."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.COTL_TABERNACLE_LEVEL1.LIT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.COTL_TABERNACLE_LEVEL1.LIT"
msgid "A gentle glow from a gentle creature."
msgstr "Ein sanftes Leuchten einer sanften Kreatur."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.COTL_TABERNACLE_LEVEL2.GENERIC
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.COTL_TABERNACLE_LEVEL2.GENERIC"
msgid "The fire has grown cold."
msgstr "Das Feuer ist kalt geworden."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.COTL_TABERNACLE_LEVEL2.LIT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.COTL_TABERNACLE_LEVEL2.LIT"
msgid "Somehow, its presence puts my mind at ease."
msgstr "Irgendwie beruhigt dessen Präsenz meinen Geist."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.COTL_TABERNACLE_LEVEL3.GENERIC
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.COTL_TABERNACLE_LEVEL3.GENERIC"
msgid "The fire has grown cold."
msgstr "Das Feuer ist kalt geworden."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.COTL_TABERNACLE_LEVEL3.LIT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.COTL_TABERNACLE_LEVEL3.LIT"
msgid "Look how it glitters in the firelight, Abigail!"
msgstr "Schau, wie es im Schein des Feuers glänzt, Abigail!"

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.COTL_TRINKET
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.COTL_TRINKET"
msgid "I wonder whose head it toppled from."
msgstr "Ich frage mich, von wessen Kopf das herunterfiel."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.COZY_BUNNYMAN
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.COZY_BUNNYMAN"
msgid "Poor creatures, sleep is only a temporary escape."
msgstr "Arme Kreaturen. Schlaf ist nur eine kurze Flucht."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.CRABKING.GENERIC
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.CRABKING.GENERIC"
msgid "One of us will be sent to a watery grave..."
msgstr "Einer von uns fährt in sein nasses Grab ..."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.CRABKING.INERT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.CRABKING.INERT"
msgid "A crumbling edifice of sand... it's not even decorated."
msgstr "Ein bröselndes Sandgebäude ... nicht mal dekoriert."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.CRABKING_CANNONTOWER
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.CRABKING_CANNONTOWER"
msgid "Futile."
msgstr "Sinnlos."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.CRABKING_CLAW
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.CRABKING_CLAW"
msgid "It wants to drag me down to the icy depths of the sea."
msgstr "Er will mich hinabziehen in die eisigen Tiefen."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.CRABKING_ICEWALL
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.CRABKING_ICEWALL"
msgid "You can't hide forever, crab."
msgstr "Du kannst dich nicht für immer verstecken, Krabbe."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.CRABKING_MOB
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.CRABKING_MOB"
msgid "You're a pawn."
msgstr "Du bist lediglich ein Bauer."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.CRABKING_MOB_KNIGHT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.CRABKING_MOB_KNIGHT"
msgid "Is your agression an attempt to fill the void?"
msgstr "Ist deine Aggression ein Versuch, die innere Leere zu füllen?"

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.CRITTERLAB
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.CRITTERLAB"
msgid "Oh. The abyss is staring back at me..."
msgstr "Oh. Der Abgrund starrt mir entgegen ..."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.CRITTER_BULBIN
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.CRITTER_BULBIN"
msgid "Its adorable face nearly brings me to tears."
msgstr "Dieses niedliche Gesicht bringt mich fast zum Weinen."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.CRITTER_DRAGONLING
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.CRITTER_DRAGONLING"
msgid "My, what big eyes you have."
msgstr "Du meine Güte! Was für große Augen du doch hast!"

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.CRITTER_EETS
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.CRITTER_EETS"
msgid "It likes to bounce along with Abigail."
msgstr "Es hüpft gerne mit Abigail herum."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.CRITTER_EYEOFTERROR
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.CRITTER_EYEOFTERROR"
msgid "May we gaze into the abyss... together."
msgstr "Lass uns in den Abgrund blicken ... gemeinsam."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.CRITTER_GLOMLING
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.CRITTER_GLOMLING"
msgid "Its snuggles almost make me forget."
msgstr "Sein Kuscheln lässt mich fast alles vergessen."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.CRITTER_KITTEN
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.CRITTER_KITTEN"
msgid "Cursed with nine lives. Poor thing."
msgstr "Mit neun Leben verflucht. Das arme Ding."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.CRITTER_LAMB
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.CRITTER_LAMB"
msgid "The softest creature in the hardest world."
msgstr "Die weichste Kreatur in der härtesten Welt."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.CRITTER_LUNARMOTHLING
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.CRITTER_LUNARMOTHLING"
msgid "Your beauty will fade too, you know."
msgstr "Deine Schönheit ist auch vergänglich, weißt du."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.CRITTER_PERDLING
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.CRITTER_PERDLING"
msgid "It's so happy."
msgstr "So glücklich."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.CRITTER_PUPPY
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.CRITTER_PUPPY"
msgid "Blissfully unaware of mortal troubles..."
msgstr "Keine Ahnung von irdischen Sorgen ..."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.CROW.GENERIC
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.CROW.GENERIC"
msgid "Take thy beak from out my heart!"
msgstr "Nimm deinen Schnabel aus meinem Herz!"

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.CROW.HELD
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.CROW.HELD"
msgid "He is mine."
msgstr "Er gehört mir."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.CRUMBS
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.CRUMBS"
msgid "The little guy is falling apart."
msgstr "Der Kleine fällt auseinander."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.CURSED_MONKEY_TOKEN
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.CURSED_MONKEY_TOKEN"
msgid "It has an aura of malevolence... and monkeyness."
msgstr "Es verströmt eine Aura der Bösartigkeit ... und Affigkeit."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.CUTGRASS
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.CUTGRASS"
msgid "It never even knew it was alive. How fortunate."
msgstr "Es wusste nicht einmal, dass es am Leben ist. Welch ein Glück."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.CUTLESS
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.CUTLESS"
msgid "Sigh. Very well, I'll play \"pirates\"."
msgstr "*Seufz*. Also gut, ich werde \"Pirat\" spielen."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.CUTLICHEN
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.CUTLICHEN"
msgid "Fleeting, just like life."
msgstr "Vergänglich, genau wie das Leben."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.CUTREEDS
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.CUTREEDS"
msgid "The blade has sentenced you to death."
msgstr "Die Klinge hat dich zum Tode verurteilt."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.CUTSTONE
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.CUTSTONE"
msgid "The better to mark graves with."
msgstr "Die bessere Wahl, um Gräber zu markieren."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.DAYWALKER.GENERIC
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.DAYWALKER.GENERIC"
msgid "Kindness only begets more pain..."
msgstr "Nettigkeit führt nur zu noch mehr Schmerz ..."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.DAYWALKER.IMPRISONED
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.DAYWALKER.IMPRISONED"
msgid "What a pitiful creature."
msgstr "Welch bemitleidenswerte Kreatur."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.DAYWALKER2.BURIED
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.DAYWALKER2.BURIED"
msgid "A soul crushed by the weight of the inescapable past."
msgstr "Eine von der unvermeidlichen Vergangenheit gebrochenen Seele."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.DAYWALKER2.GENERIC
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.DAYWALKER2.GENERIC"
msgid "He seems hungry for power. Perhaps to fill the void within."
msgstr "Er scheint nach Macht zu dürsten. Vielleicht um die innere Leere zu füllen."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.DAYWALKER2.HOSTILE
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.DAYWALKER2.HOSTILE"
msgid "The rage is a mask to hide his pain."
msgstr "Die Wut ist eine Maske, hinter der er seinen Schmerz verbirgt."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.DAYWALKER_PILLAR.EXPOSED
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.DAYWALKER_PILLAR.EXPOSED"
msgid "It is too strong, and I am too weak."
msgstr "Ist sie zu stark, bin ich zu schwach."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.DAYWALKER_PILLAR.GENERIC
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.DAYWALKER_PILLAR.GENERIC"
msgid "We are all tethered to this place in one way or another."
msgstr "Auf die eine oder andere Art sind wir alle an diesen Ort gebunden."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.DEADLYFEAST
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.DEADLYFEAST"
msgid "This, a fitting final meal."
msgstr "Ein passendes letztes Mahl."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.DEAD_SEA_BONES
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.DEAD_SEA_BONES"
msgid "The sea rejects its dead."
msgstr "Das Meer will seine Toten nicht."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.DECIDUOUSTREE.BURNING
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.DECIDUOUSTREE.BURNING"
msgid "It's burning brightly."
msgstr "Er brennt strahlend hell."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.DECIDUOUSTREE.BURNT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.DECIDUOUSTREE.BURNT"
msgid "Used up and done for."
msgstr "Verbrannt und im Eimer."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.DECIDUOUSTREE.CHOPPED
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.DECIDUOUSTREE.CHOPPED"
msgid "Everything dies."
msgstr "Alles stirbt."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.DECIDUOUSTREE.GENERIC
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.DECIDUOUSTREE.GENERIC"
msgid "This tree is spooky. I bet it likes Halloween."
msgstr "Dieser Baum ist gruselig. Ich wette, er mag Halloween."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.DECIDUOUSTREE.POISON
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.DECIDUOUSTREE.POISON"
msgid "Extra-spooky!"
msgstr "Extra gruselig!"

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.DECK_OF_CARDS
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.DECK_OF_CARDS"
msgid "Suppose I can play Solitaire."
msgstr "Nehme an, ich kann Solitär spielen."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.DECOR_CENTERPIECE
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.DECOR_CENTERPIECE"
msgid "The mortal obsession with material things."
msgstr "Die tödliche Obsession mit materiellen Dinge."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.DECOR_FLOWERVASE.EMPTY
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.DECOR_FLOWERVASE.EMPTY"
msgid "I feel the urge to stare into it."
msgstr "Ich verspüre den Drang hinein zu starren."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.DECOR_FLOWERVASE.FRESHLIGHT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.DECOR_FLOWERVASE.FRESHLIGHT"
msgid "It's illuminating... for now."
msgstr "Erleuchtend ... für den Moment."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.DECOR_FLOWERVASE.GENERIC
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.DECOR_FLOWERVASE.GENERIC"
msgid "We pulled the flowers from their homes for our own amusement."
msgstr "Wir zogen nur zum Spaß die Blumen aus ihrem Heim."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.DECOR_FLOWERVASE.OLDLIGHT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.DECOR_FLOWERVASE.OLDLIGHT"
msgid "It, too, will die."
msgstr "Wird auch sterben."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.DECOR_FLOWERVASE.WILTED
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.DECOR_FLOWERVASE.WILTED"
msgid "I think it's lovelier this way..."
msgstr "Ich denke, so ist es schöner ..."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.DECOR_LAMP
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.DECOR_LAMP"
msgid "Great."
msgstr "Toll."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.DECOR_PICTUREFRAME.GENERIC
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.DECOR_PICTUREFRAME.GENERIC"
msgid "It will be worth more after the artist dies."
msgstr "Es wird mehr Wert sein, sobald der Künstler verstorben ist."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.DECOR_PICTUREFRAME.UNDRAWN
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.DECOR_PICTUREFRAME.UNDRAWN"
msgid "Leave it."
msgstr "Lass es hier."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.DECOR_PORTRAITFRAME
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.DECOR_PORTRAITFRAME"
msgid "In the end, all we have are pictures."
msgstr "Am Ende sind Bilder alles, was wir haben."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.DEER.ANTLER
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.DEER.ANTLER"
msgid "That horn won't protect you."
msgstr "Das Horn wird dich nicht schützen."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.DEER.GENERIC
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.DEER.GENERIC"
msgid "It lives in a constant state of fear."
msgstr "Er lebt in einem ständigen Zustand der Angst."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.DEERCLOPS
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.DEERCLOPS"
msgid "Death incarnate!"
msgstr "Der leibhaftige Tod."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.DEERCLOPSCORPSE.BURNING
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.DEERCLOPSCORPSE.BURNING"
msgid "Ashes to ashes."
msgstr "Asche zu Asche."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.DEERCLOPSCORPSE.GENERIC
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.DEERCLOPSCORPSE.GENERIC"
msgid "This body is nothing but an empty vessel."
msgstr "Dieser Körper ist nichts weiter als ein leeres Gefäß."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.DEERCLOPSCORPSE.REVIVING
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.DEERCLOPSCORPSE.REVIVING"
msgid "You should stay down."
msgstr "Du hättest am Boden bleiben sollen."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.DEERCLOPSEYEBALL_SENTRYWARD.GENERIC
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.DEERCLOPSEYEBALL_SENTRYWARD.GENERIC"
msgid "No colder than a world without Abigail."
msgstr "Auch nicht kälter als eine Welt ohne Abigail."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.DEERCLOPSEYEBALL_SENTRYWARD.NOEYEBALL
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.DEERCLOPSEYEBALL_SENTRYWARD.NOEYEBALL"
msgid "Hot. Cold. What does it matter?"
msgstr "Heiß. Kalt. Welche Bedeutung hat das schon?"

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.DEERCLOPSEYEBALL_SENTRYWARD_KIT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.DEERCLOPSEYEBALL_SENTRYWARD_KIT"
msgid "I guess I could set this up and be helpful."
msgstr "Ich denke, ich könnte das aufbauen und eine Hilfe sein."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.DEERCLOPS_EYEBALL
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.DEERCLOPS_EYEBALL"
msgid "What terrors must it see."
msgstr "Welche Schrecken er wohl sieht."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.DEER_ANTLER
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.DEER_ANTLER"
msgid "We have grabbed life by its horn... though I wish we hadn't."
msgstr "Wir haben das Leben bei den Hörnern gepackt ... auch wenn ich es schon bereue."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.DEER_GEMMED
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.DEER_GEMMED"
msgid "Some chains are physical..."
msgstr "Einige Ketten sind physisch ..."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.DEPLETED_GRASS.GENERIC
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.DEPLETED_GRASS.GENERIC"
msgid "The remains of a tuft of grass."
msgstr "Die Überreste eines Grasbüschels."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.DESERTHAT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.DESERTHAT"
msgid "Now no one can tell when I'm crying."
msgstr "Niemand merkt, wenn ich weine."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.DESICCANT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.DESICCANT"
msgid "It can't dry away all my tears."
msgstr "Ich kann nicht alle meine Tränen trocknen."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.DESICCANTBOOSTED
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.DESICCANTBOOSTED"
msgid "I can't remember the last time my eyes were dry."
msgstr "Ich weiß nicht mehr, wann meine Augen zuletzt trocken waren."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.DIRTPILE
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.DIRTPILE"
msgid "Oh look. More dirt."
msgstr "Oh, schau. Mehr Dreck."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.DIVININGROD.COLD
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.DIVININGROD.COLD"
msgid "The source is distant."
msgstr "Der Ursprung ist fern."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.DIVININGROD.GENERIC
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.DIVININGROD.GENERIC"
msgid "It is forever seeking its lost half."
msgstr "Sie wird für immer ihre verlorenen Hälfte suchen."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.DIVININGROD.HOT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.DIVININGROD.HOT"
msgid "Something wicked is here!"
msgstr "Irgendetwas böses ist hier!"

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.DIVININGROD.WARM
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.DIVININGROD.WARM"
msgid "The wickedness draws closer."
msgstr "Die Boshaftigkeit nähert sich."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.DIVININGROD.WARMER
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.DIVININGROD.WARMER"
msgid "It is very close now."
msgstr "Jetzt ist es sehr nah."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.DIVININGRODBASE.GENERIC
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.DIVININGRODBASE.GENERIC"
msgid "What does this newfangled thing do?"
msgstr "Was macht dieses neumodische Ding?"

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.DIVININGRODBASE.READY
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.DIVININGRODBASE.READY"
msgid "It still needs a large key."
msgstr "Dafür ist immer noch ein großer Schlüssel erforderlich."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.DIVININGRODBASE.UNLOCKED
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.DIVININGRODBASE.UNLOCKED"
msgid "What mysteries will be revealed!"
msgstr "Welche Rätsel wohl aufgedeckt werden?"

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.DIVININGRODSTART
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.DIVININGRODSTART"
msgid "I could use that."
msgstr "Ich könnte ein Nickerchen vertragen."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.DOCK_KIT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.DOCK_KIT"
msgid "I will build it, but no one will come."
msgstr "Ich werde es bauen, aber niemand wird kommen."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.DOCK_WOODPOSTS_ITEM
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.DOCK_WOODPOSTS_ITEM"
msgid "What would be the point?"
msgstr "Was wäre der Sinn davon?"

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.DOLL_BLUEPRINT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.DOLL_BLUEPRINT"
msgid "It's pretty."
msgstr "Hübsch."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.DRAGONBOAT_KIT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.DRAGONBOAT_KIT"
msgid "I can help set this up, I guess."
msgstr "Ich könnte helfen, das zu bauen, denke ich."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.DRAGONBOAT_PACK
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.DRAGONBOAT_PACK"
msgid "I suppose I can make myself useful in some small way and put it together."
msgstr "Ich nehme an, ich könnte mich ein wenig nützlich machen und das zusammenbauen."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.DRAGONBODYHAT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.DRAGONBODYHAT"
msgid "The belly of the beast."
msgstr "Der Bauch des Tieres."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.DRAGONCHILISALAD
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.DRAGONCHILISALAD"
msgid "I missed having someone make me dinner..."
msgstr "Ich vermisse es, dass mir jemand Abendessen macht ..."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.DRAGONFLY
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.DRAGONFLY"
msgid "It's burning on the inside."
msgstr "Brennt von innen."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.DRAGONFLYCHEST.GENERIC
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.DRAGONFLYCHEST.GENERIC"
msgid "Boom box."
msgstr "Drachenkiste."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.DRAGONFLYCHEST.UPGRADED_STACKSIZE
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.DRAGONFLYCHEST.UPGRADED_STACKSIZE"
msgid "It holds multitudes, and refuses to burn away."
msgstr "Sie fasst Unmengen und trotzt jeder Flamme."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.DRAGONFLYFURNACE.GENERIC
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.DRAGONFLYFURNACE.GENERIC"
msgid "Its teeth do not even gnash."
msgstr "Seine Zähne knirschen nicht einmal."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.DRAGONFLYFURNACE.HAMMERED
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.DRAGONFLYFURNACE.HAMMERED"
msgid "Pathetic."
msgstr "Jämmerlich."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.DRAGONFLYFURNACE.HIGH
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.DRAGONFLYFURNACE.HIGH"
msgid "No need to lean in and check if it's hot. I can feel it from here."
msgstr "Das muss man nicht anfassen, um zu sehen, ob es heiß ist. Ich spüre es von hier."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.DRAGONFLYFURNACE.NORMAL
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.DRAGONFLYFURNACE.NORMAL"
msgid "Burns hot... but not bright..."
msgstr "Brennt heiß ... aber nicht hell ..."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.DRAGONFRUIT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.DRAGONFRUIT"
msgid "This isn't shaped like a dragon at all."
msgstr "Die ist überhaupt nicht wie ein Drachen geformt."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.DRAGONFRUIT_COOKED
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.DRAGONFRUIT_COOKED"
msgid "Still not a dragon. At least it's dead."
msgstr "Immer noch kein Drache. Immerhin ist sie tot."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.DRAGONFRUIT_OVERSIZED
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.DRAGONFRUIT_OVERSIZED"
msgid "It nearly became a dragon."
msgstr "Daraus wäre fast ein Drache geworden."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.DRAGONFRUIT_SEEDS
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.DRAGONFRUIT_SEEDS"
msgid "It's a seed."
msgstr "Das ist ein Samen."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.DRAGONHEADHAT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.DRAGONHEADHAT"
msgid "What big eyes you have."
msgstr "Was für große Augen du hast."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.DRAGONPIE
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.DRAGONPIE"
msgid "Well, at least it's a pie now."
msgstr "Nun, immerhin es ist jetzt ein Kuchen."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.DRAGONTAILHAT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.DRAGONTAILHAT"
msgid "That's just a tall tail."
msgstr "Das ist nur ein hoher Schwanz."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.DRAGON_SCALES
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.DRAGON_SCALES"
msgid "Scales of pain."
msgstr "Schuppen des Schmerzes."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.DREADSTONE
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.DREADSTONE"
msgid "It is cold... and beautiful."
msgstr "Er ist kalt ... und wunderschön."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.DREADSTONEHAT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.DREADSTONEHAT"
msgid "What's the point?"
msgstr "Was soll das bringen?"

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.DREADSTONE_STACK
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.DREADSTONE_STACK"
msgid "Do I dare imagine what kind of darkness it grew from?"
msgstr "Ich mag mir kaum vorstellen, aus welcher Dunkelheit das erwachsen ist."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.DRIFTWOOD_LOG
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.DRIFTWOOD_LOG"
msgid "Bleached like bones left in the sun."
msgstr "Gebleicht wie Knochen in der Sonne."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.DRIFTWOOD_TREE.BURNING
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.DRIFTWOOD_TREE.BURNING"
msgid "Oh. It's burning."
msgstr "Oh. Er brennt."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.DRIFTWOOD_TREE.BURNT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.DRIFTWOOD_TREE.BURNT"
msgid "Your suffering is over now."
msgstr "Dein Leid ist nun vorüber."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.DRIFTWOOD_TREE.CHOPPED
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.DRIFTWOOD_TREE.CHOPPED"
msgid "It's met its end at our hands."
msgstr "Wir haben ihm den Garaus gemacht."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.DRIFTWOOD_TREE.GENERIC
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.DRIFTWOOD_TREE.GENERIC"
msgid "The bleached remains of a dead tree."
msgstr "Die gebleichten Überreste eines toten Baums."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.DRUMSTICK
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.DRUMSTICK"
msgid "Makes a good thud, and it's nutritious!"
msgstr "Macht dumpfe Geräusche und besitzt Nährstoffe!"

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.DRUMSTICK_COOKED
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.DRUMSTICK_COOKED"
msgid "Less raw, more tasty."
msgstr "Weniger roh und dadurch schmackhafter."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.DUG_BANANABUSH
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.DUG_BANANABUSH"
msgid "Bananas that grow in the sun... how unnatural."
msgstr "Im Sonnenlicht wachsende Bananen ... wie unnatürlich."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.DUG_BERRYBUSH
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.DUG_BERRYBUSH"
msgid "How sad. You've no home."
msgstr "Wie traurig. Du hast kein Zuhause."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.DUG_BERRYBUSH_JUICY
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.DUG_BERRYBUSH_JUICY"
msgid "How does it feel to be ripped from your home?"
msgstr "Wie fühlt es sich an, aus dem eigenen Zuhause gerissen zu werden?"

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.DUG_GRASS
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.DUG_GRASS"
msgid "I like it dead, but it should probably be returned to the earth."
msgstr "Ich mag es tot, aber es gehört wohl der Erde zurückgegeben."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.DUG_MARSH_BUSH
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.DUG_MARSH_BUSH"
msgid "I like it dead, but it should probably be returned to the earth."
msgstr "Ich mag es tot, aber es gehört wohl der Erde zurückgegeben."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.DUG_MONKEYTAIL
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.DUG_MONKEYTAIL"
msgid "Oh. They're so soft. And fuzzy."
msgstr "Oh. Sie sind so weich. Und flauschig."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.DUG_SAPLING
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.DUG_SAPLING"
msgid "I like it dead, but it should probably be returned to the earth."
msgstr "Ich mag es tot, aber es gehört wohl der Erde zurückgegeben."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.DUG_TRAP_STARFISH
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.DUG_TRAP_STARFISH"
msgid "A pity it didn't crunch me up when it had the chance."
msgstr "Schade, dass sie mich nicht zermalmt hat, als sie die Chance hatte."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.DUMBBELL
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.DUMBBELL"
msgid "Oh. It's very heavy."
msgstr "Oh. Das ist sehr schwer."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.DUMBBELL_BLUEGEM
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.DUMBBELL_BLUEGEM"
msgid "It chills me to my core."
msgstr "Das lässt mich zutiefst erschaudern."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.DUMBBELL_GEM
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.DUMBBELL_GEM"
msgid "Who would choose to carry such a burden..."
msgstr "Wer würde eine solche Last tragen wollen ..."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.DUMBBELL_GOLDEN
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.DUMBBELL_GOLDEN"
msgid "It's almost as heavy as my heart."
msgstr "Fast so schwer wie mein Herz."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.DUMBBELL_HEAT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.DUMBBELL_HEAT"
msgid "It may warm the body, but not the heart."
msgstr "Sie mag zwar meinen Körper wärmen, aber nicht mein Herz."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.DUMBBELL_MARBLE
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.DUMBBELL_MARBLE"
msgid "We all carry a great weight. His seems... a bit more literal, though."
msgstr "Wir alle tragen eine große Last. Seine scheint aber ... etwas buchstäblicher zu sein."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.DUMBBELL_REDGEM
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.DUMBBELL_REDGEM"
msgid "It inflicts burning pain."
msgstr "Sie verursacht brennenden Schmerz."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.DURIAN
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.DURIAN"
msgid "Spiky and smelly!"
msgstr "Stachelig und stinken!"

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.DURIAN_COOKED
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.DURIAN_COOKED"
msgid "Less spiky, but even smellier!"
msgstr "Nicht mehr so dornig, aber dafür stinkender."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.DURIAN_OVERSIZED
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.DURIAN_OVERSIZED"
msgid "Why did this one have to grow so large?"
msgstr "Warum musste sie so groß werden?"

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.DURIAN_SEEDS
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.DURIAN_SEEDS"
msgid "It's a plant that's waiting to be."
msgstr "Es ist eine Pflanze, die nur darauf wartet, zu sein."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.DUSTMERINGUE
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.DUSTMERINGUE"
msgid "A treat devoid of sweetness..."
msgstr "Eine Köstlichkeit, die nicht süß ist ..."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.DUSTMOTH
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.DUSTMOTH"
msgid "They seem to live only to clean. What a tiresome life."
msgstr "Putzen scheint ihr einziger Lebensinhalt zu sein. Was für ein mühsames Leben."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.DUSTMOTHDEN
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.DUSTMOTHDEN"
msgid "Poor things, their home is no longer safe from us."
msgstr "Die armen Dinger, ihr Zuhause ist nicht mehr sicher vor uns."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.EARMUFFSHAT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.EARMUFFSHAT"
msgid "Their bitter end offers protection from the bitter cold."
msgstr "Ihr bitteres Ende schützt mich vor der bitteren Kälte."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.EEL
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.EEL"
msgid "An eel."
msgstr "Ein Aal."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.EEL_COOKED
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.EEL_COOKED"
msgid "An eel that has been cooked."
msgstr "Ein gekochter Aal."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.EGGPLANT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.EGGPLANT"
msgid "Almost a deadly nightshade. Almost."
msgstr "Sieht fast wie eine Tollkirsche aus. Fast."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.EGGPLANT_COOKED
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.EGGPLANT_COOKED"
msgid "Cooking this nightshade made it even less deadly."
msgstr "Durch das Kochen dieses Nachtschattens, wird er sogar noch ungefährlicher."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.EGGPLANT_OVERSIZED
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.EGGPLANT_OVERSIZED"
msgid "Unfortunately it's not poisonous, despite its sickly purple shade."
msgstr "Leider ist sie nicht giftig, trotz ihrer kränklichen lila Farbe."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.EGGPLANT_SEEDS
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.EGGPLANT_SEEDS"
msgid "It's a plant that's waiting to be."
msgstr "Es ist eine Pflanze, die nur darauf wartet, zu sein."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.ELIXIR_CONTAINER
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.ELIXIR_CONTAINER"
msgid "If only I could have helped you then."
msgstr "Wenn ich dir doch nur hätte helfen können."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.EMBERLIGHT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.EMBERLIGHT"
msgid "At least it warms my hands."
msgstr "Wenigstens wärmt es meine Hände."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.ENDTABLE.BURNT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.ENDTABLE.BURNT"
msgid "Nothing lasts forever."
msgstr "Nichts hält für ewig."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.ENDTABLE.EMPTY
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.ENDTABLE.EMPTY"
msgid "The shadow equivalent of taxidermy. I like it."
msgstr "Das Schatten-Äquivalent der Tierpräparation. Mir gefällt's."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.ENDTABLE.FRESHLIGHT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.ENDTABLE.FRESHLIGHT"
msgid "It's illuminating... for now."
msgstr "Erleuchtend ... für den Moment."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.ENDTABLE.GENERIC
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.ENDTABLE.GENERIC"
msgid "We pulled the flowers from their homes for our own amusement."
msgstr "Wir zogen nur zum Spaß die Blumen aus ihrem Heim."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.ENDTABLE.OLDLIGHT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.ENDTABLE.OLDLIGHT"
msgid "It, too, will die."
msgstr "Wird auch sterben."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.ENDTABLE.WILTED
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.ENDTABLE.WILTED"
msgid "I think it's lovelier this way..."
msgstr "Ich denke, so ist es schöner ..."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.EVERGREEN.BURNING
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.EVERGREEN.BURNING"
msgid "It's burning brightly."
msgstr "Brennt strahlend hell."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.EVERGREEN.BURNT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.EVERGREEN.BURNT"
msgid "Used up and done for."
msgstr "Verbrannt und im Eimer."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.EVERGREEN.CHOPPED
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.EVERGREEN.CHOPPED"
msgid "Everything dies."
msgstr "Alles stirbt."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.EVERGREEN.GENERIC
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.EVERGREEN.GENERIC"
msgid "Nature is so boring."
msgstr "Natur ist wirklich langweilig."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.EVERGREEN_SPARSE.BURNING
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.EVERGREEN_SPARSE.BURNING"
msgid "It's burning brightly."
msgstr "Er brennt strahlend hell."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.EVERGREEN_SPARSE.BURNT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.EVERGREEN_SPARSE.BURNT"
msgid "Used up and done for."
msgstr "Verbrannt und im Eimer."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.EVERGREEN_SPARSE.CHOPPED
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.EVERGREEN_SPARSE.CHOPPED"
msgid "Everything dies."
msgstr "Alles stirbt."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.EVERGREEN_SPARSE.GENERIC
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.EVERGREEN_SPARSE.GENERIC"
msgid "Its cycle of life is ending."
msgstr "Der Zyklus seines Lebens endet."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.EYEBRELLAHAT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.EYEBRELLAHAT"
msgid "That's one stretchy eye."
msgstr "Das ist ein dehnbares Auge."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.EYEMASKHAT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.EYEMASKHAT"
msgid "I am the beholder of the eye."
msgstr "Ich bin der Betrachter des Auges."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.EYEOFTERROR
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.EYEOFTERROR"
msgid "Beware the evil eye."
msgstr "Der böse Blick des bösen Auges ..."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.EYEOFTERROR_MINI
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.EYEOFTERROR_MINI"
msgid "I can feel the sting of their sharp gaze..."
msgstr "Ich kann den Stich ihres stechenden Blicks spüren ..."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.EYEOFTERROR_MINI_GROUNDED
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.EYEOFTERROR_MINI_GROUNDED"
msgid "One more blight will be brought into this world."
msgstr "Eine weitere Plage wird auf diese Welt losgelassen."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.EYEPLANT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.EYEPLANT"
msgid "They follow their master's every wish."
msgstr "Sie erfüllen ihrem Meister jeden Wunsch."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.EYETURRET
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.EYETURRET"
msgid "I do not know why it helps me."
msgstr "Ich weiß nicht, wieso er mir hilft."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.EYETURRET_ITEM
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.EYETURRET_ITEM"
msgid "I think it needs to be placed."
msgstr "Ich glaube, das muss irgendwo platziert werden."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.FARMPLOT.BURNT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.FARMPLOT.BURNT"
msgid "This earth is burnt and dead."
msgstr "Diese Erde ist verbrannt und tot."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.FARMPLOT.GENERIC
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.FARMPLOT.GENERIC"
msgid "What seeds shall I sow?"
msgstr "Welche Samen soll ich säen?"

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.FARMPLOT.GROWING
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.FARMPLOT.GROWING"
msgid "Leafy tendrils coil out of the muck."
msgstr "Grüne Ranken winden sich aus dem Dreck."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.FARMPLOT.NEEDSFERTILIZER
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.FARMPLOT.NEEDSFERTILIZER"
msgid "This earth is cold and dead."
msgstr "Diese Erde ist kalt und tot."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.FARM_HOE
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.FARM_HOE"
msgid "I must prepare the seeds for their burial."
msgstr "Ich muss das Saatgut für seine Bestattung vorbereiten."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.FARM_PLANT.BURNING
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.FARM_PLANT.BURNING"
msgid "All that work, destroyed..."
msgstr "All die Arbeit, zerstört ..."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.FARM_PLANT.FULL
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.FARM_PLANT.FULL"
msgid "How cruel, that I must now steal the fruits of your labor."
msgstr "Wie grausam, dass ich dir jetzt die Früchte deiner Arbeit stehlen muss."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.FARM_PLANT.FULL_OVERSIZED
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.FARM_PLANT.FULL_OVERSIZED"
msgid "However did it grow so big?"
msgstr "Wie ist sie bloß so groß geworden?"

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.FARM_PLANT.FULL_WEED
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.FARM_PLANT.FULL_WEED"
msgid "It is the tragic fate of all weeds to be spurned from the garden."
msgstr "Es ist das tragische Schicksal Unkrauts, aus dem Garten verbannt zu werden."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.FARM_PLANT.GENERIC
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.FARM_PLANT.GENERIC"
msgid "A plant."
msgstr "Eine Pflanze."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.FARM_PLANT.GROWING
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.FARM_PLANT.GROWING"
msgid "Despite the horrors of the world, it seems intent on living."
msgstr "Trotz der Schrecken der Welt scheint sie leben zu wollen."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.FARM_PLANT.ROTTEN
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.FARM_PLANT.ROTTEN"
msgid "There's nothing I can do for it."
msgstr "Es gibt nichts, was ich dafür tun kann."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.FARM_PLANT.ROTTEN_OVERSIZED
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.FARM_PLANT.ROTTEN_OVERSIZED"
msgid "Dead and rotting."
msgstr "Tot und faulend."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.FARM_PLANT.SEED
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.FARM_PLANT.SEED"
msgid "Is it cold down there, alone in the ground?"
msgstr "Ist es kalt da unten, so ganz allein in der Erde?"

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.FARM_PLOW
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.FARM_PLOW"
msgid "It's fighting against the ground."
msgstr "Das kämpft gegen den Boden an."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.FARM_PLOW_ITEM
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.FARM_PLOW_ITEM"
msgid "I suppose I must find a place for the garden."
msgstr "Ich muss wohl einen Platz für den Garten finden."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.FARM_SOIL_DEBRIS
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.FARM_SOIL_DEBRIS"
msgid "You don't belong here."
msgstr "Du gehörst nicht hierher."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.FEATHERFAN
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.FEATHERFAN"
msgid "That'll make quite a draft."
msgstr "Der macht einen ziemlichen Wind."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.FEATHERHAT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.FEATHERHAT"
msgid "Ca-caw!"
msgstr "Krächz."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.FEATHERPENCIL
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.FEATHERPENCIL"
msgid "M...maybe I'll doodle something... When no one's looking."
msgstr "Vielleicht ... werde ich etwas hinkritzeln ... Wenn niemand hersieht."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.FEATHER_CANARY
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.FEATHER_CANARY"
msgid "A canary feather, golden as the gilded cage."
msgstr "Die Feder eines Kanarienvogels, so golden wie der goldene Käfig."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.FEATHER_CROW
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.FEATHER_CROW"
msgid "A soft feather, black like eternal darkness."
msgstr "Eine weiche Feder. Schwarz wie die ewige Finsternis."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.FEATHER_ROBIN
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.FEATHER_ROBIN"
msgid "A redbird feather, red like blood."
msgstr "Die Feder eines roten Vogels. Rot wie Blut."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.FEATHER_ROBIN_WINTER
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.FEATHER_ROBIN_WINTER"
msgid "A snowbird feather, white as the light at the end of the tunnel."
msgstr "Die Feder eines Schneevogels. Weißer als das Licht am Ende des Tunnels."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.FEM_PUPPET
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.FEM_PUPPET"
msgid "I wonder what she did."
msgstr "Ich frage mich, was sie getan hat."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.FENCE
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.FENCE"
msgid "Sort of like an emotional barrier. But wood."
msgstr "Ähnlich wie eine emotionale Barriere. Aber aus Holz."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.FENCE_ELECTRIC.GENERIC
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.FENCE_ELECTRIC.GENERIC"
msgid "What a lonely post."
msgstr "Was für ein einsamer Pfosten."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.FENCE_ELECTRIC.LINKED
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.FENCE_ELECTRIC.LINKED"
msgid "It fulfills its purpose in connection."
msgstr "Es erfüllt seinen Zweck in Verbindung."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.FENCE_ELECTRIC_ITEM
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.FENCE_ELECTRIC_ITEM"
msgid "It's no use to anyone like that."
msgstr "Das nützt niemandem etwas."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.FENCE_GATE
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.FENCE_GATE"
msgid "Will it keep others in, or out?"
msgstr "Soll es andere raushalten oder einsperren?"

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.FENCE_GATE_ITEM
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.FENCE_GATE_ITEM"
msgid "We could use it to build a gate."
msgstr "Wir können daraus ein Tor bauen."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.FENCE_ITEM
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.FENCE_ITEM"
msgid "We could use it to build a fence."
msgstr "Wir können daraus einen Zaun bauen."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.FENCE_JUNK
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.FENCE_JUNK"
msgid "Even these discarded pieces can manage to be useful."
msgstr "Selbst diese weggeworfenen Stücke können mal nützlich sein."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.FENCE_ROTATOR
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.FENCE_ROTATOR"
msgid "Disorderly fences need to be brought into line."
msgstr "Unordentliche Zäune müssen auf Linie gebracht werden."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.FERTILIZER
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.FERTILIZER"
msgid "A bucket of grime."
msgstr "Ein Eimer voll Dreck."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.FESTIVEFISH
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.FESTIVEFISH"
msgid "It's about as festive as I feel."
msgstr "Ungefähr so feierlich ist mir zumute."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.FESTIVE_BLUEPRINT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.FESTIVE_BLUEPRINT"
msgid "It's so colorful, it hurts my eyes."
msgstr "Das ist so bunt, dass mir die Augen wehtun."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.FIG
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.FIG"
msgid "Abigail always told me they were filled with wasps."
msgstr "Abigail hat mir immer gesagt, dass sie mit Wespen gefüllt sind."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.FIGATONI
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.FIGATONI"
msgid "The fig cowers in its pasta shell."
msgstr "Die Feige versteckt sich in ihrer Nudelschale."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.FIGKABAB
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.FIGKABAB"
msgid "The fig pieces look like little pierced hearts."
msgstr "Die Feigenstücke sehen aus wie kleine durchbohrte Herzen."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.FIG_COOKED
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.FIG_COOKED"
msgid "Any wasps it held seem to have been burned away."
msgstr "Die Wespen, die darin lebten, sind weggebrannt worden."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.FIREBALLSTAFF
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.FIREBALLSTAFF"
msgid "To call death from the skies."
msgstr "Um den Tod aus dem Himmel zu rufen."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.FIRECRACKERS
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.FIRECRACKERS"
msgid "It needs only a light."
msgstr "Braucht nur ein Licht."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.FIREFLIES.GENERIC
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.FIREFLIES.GENERIC"
msgid "A tiny brightness in the dark."
msgstr "Ein winziges Licht in der Dunkelheit."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.FIREFLIES.HELD
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.FIREFLIES.HELD"
msgid "Tiny lights, stranded from the world outside my pocket."
msgstr "Winzige Lichter, aus der Welt außerhalb meiner Tasche."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.FIREHOUND
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.FIREHOUND"
msgid "His disposition is fiery."
msgstr "Sein Gemüt ist feurig."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.FIRENETTLES
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.FIRENETTLES"
msgid "They sting terribly."
msgstr "Das brennt furchtbar."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.FIRENETTLES_DRIED
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.FIRENETTLES_DRIED"
msgid "I like how they smell."
msgstr "Mir gefällt ihr Geruch."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.FIREPEN
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.FIREPEN"
msgid "Father had one very similar. I doubt it ever started a fire, though."
msgstr "Vater mal einen Ähnlichen. Ich zweifle jedoch, dass er je ein Feuer entfacht hat."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.FIREPIT.EMBERS
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.FIREPIT.EMBERS"
msgid "Don't give up, little flame!"
msgstr "Nicht aufgeben, kleine Flamme!"

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.FIREPIT.GENERIC
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.FIREPIT.GENERIC"
msgid "A flame to keep the horrors at bay."
msgstr "Eine Flamme, um die Fieslinge fernzuhalten."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.FIREPIT.HIGH
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.FIREPIT.HIGH"
msgid "This fire burns with passion!"
msgstr "Es brennt! Doch wo ist das Feuer?"

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.FIREPIT.LOW
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.FIREPIT.LOW"
msgid "It's losing the will to go on."
msgstr "Auf die Augen zielen!"

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.FIREPIT.NORMAL
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.FIREPIT.NORMAL"
msgid "It's a comfort."
msgstr "Eine kalte Gemütlichkeit."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.FIREPIT.OUT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.FIREPIT.OUT"
msgid "This can be rekindled, unlike my heart."
msgstr "Dies kann im Gegensatz zu meinem Herzen neu entfacht werden."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.FIRESTAFF
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.FIRESTAFF"
msgid "The world will burn before this staff."
msgstr "Die Welt wird durch diesen Stab brennen."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.FIRESUPPRESSOR.LOWFUEL
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.FIRESUPPRESSOR.LOWFUEL"
msgid "It's running on fumes."
msgstr "Er läuft schon auf Reserve."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.FIRESUPPRESSOR.OFF
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.FIRESUPPRESSOR.OFF"
msgid "Quiet as a corpse."
msgstr "Still wie eine Leiche."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.FIRESUPPRESSOR.ON
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.FIRESUPPRESSOR.ON"
msgid "I don't know why you bother. We're all going to burn."
msgstr "Ich weiß nicht, wieso er sich so quält. Wir werden alle brennen."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.FISH
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.FISH"
msgid "It was flopping around desperately for life. The poor fool."
msgstr "Er zappelte verzweifelt um sein Leben. Der arme Narr."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.FISHINGNET
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.FISHINGNET"
msgid "To ensnare fish and tear them from their peaceful lives."
msgstr "Damit fesselt man Fische und reißt sie aus ihrem friedlichen Leben."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.FISHINGROD
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.FISHINGROD"
msgid "With this the fishies will be ripped from the safety of their precious pond."
msgstr "Damit werden die Fischen aus der Sicherheit ihres schönen Teichs gerissen."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.FISHMEAT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.FISHMEAT"
msgid "It's been decapitated."
msgstr "Wurde geköpft!"

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.FISHMEAT_COOKED
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.FISHMEAT_COOKED"
msgid "A proper grilling puts a stop to the flopping."
msgstr "Ein angemessenes Grillen macht dem Zappeln ein Ende."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.FISHMEAT_DRIED
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.FISHMEAT_DRIED"
msgid "The dessicated remains of a fish."
msgstr "Die ausgetrockneten Überreste eines Fischs."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.FISHMEAT_SMALL
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.FISHMEAT_SMALL"
msgid "There are other fish in the sea. Bigger ones, hopefully."
msgstr "Hoffentlich gibt es noch größere Fische im Meer."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.FISHMEAT_SMALL_COOKED
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.FISHMEAT_SMALL_COOKED"
msgid "It will... tide... me over for now."
msgstr "Das hilft mir fürs Erste."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.FISHMEAT_SMALL_DRIED
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.FISHMEAT_SMALL_DRIED"
msgid "Withered away to almost nothing."
msgstr "Beinahe komplett verwest."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.FISHSTICKS
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.FISHSTICKS"
msgid "Perfectly molded blocks of fish."
msgstr "Perfekt geformte Blöcke aus Fisch."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.FISHTACOS
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.FISHTACOS"
msgid "Hopefully no bones still linger within."
msgstr "Hoffentlich sind da keine Gräten drin."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.FISH_BOX
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.FISH_BOX"
msgid "It feels a bit cruel to trap them within sight of freedom."
msgstr "Scheint grausam, sie in Sichtweite der Freiheit zu fangen."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.FISH_COOKED
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.FISH_COOKED"
msgid "A proper grilling puts a stop to the flopping."
msgstr "Ein angemessenes Grillen macht dem Zappeln ein Ende."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.FLINT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.FLINT"
msgid "A tiny blade-like rock."
msgstr "Ein winziger klingenartiger Stein."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.FLOATINGLANTERN.DEFLATED
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.FLOATINGLANTERN.DEFLATED"
msgid "I knew it couldn't last."
msgstr "Ich wusste, dass es nicht von Dauer ist."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.FLOATINGLANTERN.GENERIC
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.FLOATINGLANTERN.GENERIC"
msgid "It does lift my spirits... a little."
msgstr "Das hebt meine Stimmung ... ein wenig."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.FLOATINGLANTERN.HELD
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.FLOATINGLANTERN.HELD"
msgid "I should save this for when it's darkest."
msgstr "Ich sollte sie für später aufheben, wenn es am dunkelsten ist."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.FLOTATIONCUSHION
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.FLOTATIONCUSHION"
msgid "One does not need water to drown."
msgstr "Man braucht kein Wasser, um zu ertrinken."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.FLOWER.GENERIC
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.FLOWER.GENERIC"
msgid "They are bright and cheery. Yuck."
msgstr "Sie sind fröhlich und munter. Igitt."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.FLOWER.ROSE
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.FLOWER.ROSE"
msgid "Prickly and blood red..."
msgstr "Dornig und blutrot ..."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.FLOWERHAT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.FLOWERHAT"
msgid "But I am in mourning..."
msgstr "Aber ich trauere doch..."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.FLOWERSALAD
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.FLOWERSALAD"
msgid "Ugh, more flowers."
msgstr "Igitt, noch mehr Blumen."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.FLOWER_CAVE
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.FLOWER_CAVE"
msgid "It looks fragile."
msgstr "Sie sieht gebrechlich aus."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.FLOWER_CAVE_WITHERED
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.FLOWER_CAVE_WITHERED"
msgid "There's a sadness about how it flickers."
msgstr "Es hat etwas Trauriges, wie es flackert."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.FLOWER_EVIL
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.FLOWER_EVIL"
msgid "At least they're better than the other flowers."
msgstr "Wenigstens sind sie besser als die anderen Blumen."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.FLOWER_WITHERED
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.FLOWER_WITHERED"
msgid "This is the fate of all things."
msgstr "Die Zeit verurteilt alles."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.FOLIAGE
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.FOLIAGE"
msgid "Lead me to the Aarnivalkea."
msgstr "Führe mich zu den Irrlichtern."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.FOLIAGE_DRIED
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.FOLIAGE_DRIED"
msgid "I like how they smell."
msgstr "Mir gefällt ihr Geruch."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.FOOTBALLHAT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.FOOTBALLHAT"
msgid "A dead thing for me to wear. Goody."
msgstr "Ein totes Ding für mich zum Anziehen. Toll."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.FORGETMELOTS
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.FORGETMELOTS"
msgid "They are rather pretty for a weed."
msgstr "Die sind aber hübsch ... für Unkraut."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.FORGETMELOTS_DRIED
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.FORGETMELOTS_DRIED"
msgid "I like how they smell."
msgstr "Mir gefällt ihr Geruch."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.FORMAL_BLUEPRINT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.FORMAL_BLUEPRINT"
msgid "It looks very dignified."
msgstr "Sieht sehr gediegen aus."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.FOSSIL_PIECE
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.FOSSIL_PIECE"
msgid "It is death, preserved."
msgstr "Tot, aber erhalten."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.FOSSIL_STALKER.COMPLETE
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.FOSSIL_STALKER.COMPLETE"
msgid "What horrors have we resurrected here today?"
msgstr "Welche Schrecken haben wir hier heute wiederbelebt?"

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.FOSSIL_STALKER.FUNNY
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.FOSSIL_STALKER.FUNNY"
msgid "Death has a sense of humor."
msgstr "Der Tod hat einen Sinn für Humor."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.FOSSIL_STALKER.GENERIC
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.FOSSIL_STALKER.GENERIC"
msgid "We must find more pieces."
msgstr "Wir müssen mehr Stücke finden."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.FRESHFRUITCREPES
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.FRESHFRUITCREPES"
msgid "Could I get this a la mode?"
msgstr "Ich bräuchte ein bisschen Dünger hier."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.FRIENDLYFRUITFLY
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.FRIENDLYFRUITFLY"
msgid "Oh. It seems to be friendly."
msgstr "Oh. Sie sieht freundlich aus."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.FROG.DEAD
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.FROG.DEAD"
msgid "Life is small and short."
msgstr "Das Leben ist unbedeutend und kurz."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.FROG.GENERIC
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.FROG.GENERIC"
msgid "He's little and warty."
msgstr "Er ist klein und warzig."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.FROG.SLEEPING
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.FROG.SLEEPING"
msgid "He's asleep."
msgstr "Er schläft."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.FROGFISHBOWL
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.FROGFISHBOWL"
msgid "It's actually... really good..."
msgstr "Das ist eigentlich ... richtig lecker ..."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.FROGGLEBUNWICH
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.FROGGLEBUNWICH"
msgid "I never thought frog's legs could look so good."
msgstr "Ich hätte nie gedacht, dass die Beine des Frosches so gut aussehen können."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.FROGLEGS
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.FROGLEGS"
msgid "Torn right from the frog."
msgstr "Direkt vom Frosch abgerissen."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.FROGLEGS_COOKED
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.FROGLEGS_COOKED"
msgid "Definitely not twitching any longer."
msgstr "Die zucken definitiv nicht mehr."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.FROGNEWTON
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.FROGNEWTON"
msgid "Sweet and only a little slimy."
msgstr "Süß und nur leicht schleimig."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.FROZENBANANADAIQUIRI
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.FROZENBANANADAIQUIRI"
msgid "This won't be of help to my cold, cold heart."
msgstr "Das wird meinem kalten, kalten Herzen nicht helfen."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.FRUITDRAGON.GENERIC
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.FRUITDRAGON.GENERIC"
msgid "It prefers to be alone."
msgstr "Er ist lieber alleine."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.FRUITDRAGON.RIPE
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.FRUITDRAGON.RIPE"
msgid "You simply look too delicious."
msgstr "Du siehst einfach zu köstlich aus."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.FRUITDRAGON.SLEEPING
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.FRUITDRAGON.SLEEPING"
msgid "It is arrested by deepest sleep."
msgstr "Gefangen in tiefstem Schlaf."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.FRUITFLY
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.FRUITFLY"
msgid "They have no respect for living things."
msgstr "Sie haben keinen Respekt vor lebenden Dingen."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.FRUITFLYFRUIT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.FRUITFLYFRUIT"
msgid "Now you may trade your lord for a queen."
msgstr "Jetzt kannst du deinen Lord gegen eine Königin eintauschen."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.FRUITMEDLEY
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.FRUITMEDLEY"
msgid "Sweet, tart and in a cup."
msgstr "Süß, sauer und in einem Becher."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.FUMAROLEAXE.GENERIC
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.FUMAROLEAXE.GENERIC"
msgid "It's not long for this world..."
msgstr "Wird nicht mehr lange auf dieser Welt sein ..."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.FUMAROLEAXE.HOT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.FUMAROLEAXE.HOT"
msgid "The hottest flames burn out the quickest..."
msgstr "Die heißesten Flammen erlöschen am schnellsten ..."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.FUMAROLEAXE.LUKEWARM
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.FUMAROLEAXE.LUKEWARM"
msgid "It has lost the warmth it once had."
msgstr "Sie hat die Wärme verloren, die sie einst hatte."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.FUMAROLEAXE.WARM
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.FUMAROLEAXE.WARM"
msgid "I can find some small comfort in its warmth."
msgstr "Ihre Wärme spendet mir ein wenig Trost."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.FUMAROLEHAMMER.GENERIC
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.FUMAROLEHAMMER.GENERIC"
msgid "It's not long for this world..."
msgstr "Wird nicht mehr lange auf dieser Welt sein."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.FUMAROLEHAMMER.HOT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.FUMAROLEHAMMER.HOT"
msgid "The hottest flames burn out the quickest..."
msgstr "Die heißesten Flammen erlöschen am schnellsten ..."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.FUMAROLEHAMMER.LUKEWARM
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.FUMAROLEHAMMER.LUKEWARM"
msgid "It has lost the warmth it once had."
msgstr "Er hat die Wärme verloren, die er einst hatte."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.FUMAROLEHAMMER.WARM
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.FUMAROLEHAMMER.WARM"
msgid "I can find some small comfort in its warmth."
msgstr "Seine Wärme spendet mir ein wenig Trost."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.FUMAROLEPICKAXE.GENERIC
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.FUMAROLEPICKAXE.GENERIC"
msgid "It's not long for this world..."
msgstr "Wird nicht mehr lange auf dieser Welt sein ..."

