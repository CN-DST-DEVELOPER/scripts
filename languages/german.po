msgstr "Ich MUSS das Ding verbrennen."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.SPIDER_MOON.SLEEPING
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.SPIDER_MOON.SLEEPING"
