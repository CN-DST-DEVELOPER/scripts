#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.SLINGSHOT.GENERIC
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.SLINGSHOT.GENERIC"
msgid "The bane of windows everywhere."
msgstr "La pesadilla de las ventanas de todo el mundo."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.SLINGSHOT.NOT_MINE
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.SLINGSHOT.NOT_MINE"
msgid "only_used_by_walter"
msgstr "only_used_by_walter"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.SLINGSHOTAMMO_CONTAINER
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.SLINGSHOTAMMO_CONTAINER"
msgid "It's full of potential... energy!"
msgstr "¡Está llena de energía... en potencia!"

