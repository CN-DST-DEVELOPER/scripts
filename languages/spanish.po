msgctxt "STRINGS.SKILLTREE.WORMWOOD.BLOOMING_SPEED1_TITLE"
msgid "Growth Spurt I"
msgstr "Crecimiento acelerado I"

#. STRINGS.SKILLTREE.WORMWOOD.BLOOMING_SPEED2_DESC
msgctxt "STRINGS.SKILLTREE.WORMWOOD.BLOOMING_SPEED2_DESC"
msgid "Reach full bloom much quicker."
msgstr "Alcanza la plena floración mucho más rápido."

#. STRINGS.SKILLTREE.WORMWOOD.BLOOMING_SPEED2_TITLE
msgctxt "STRINGS.SKILLTREE.WORMWOOD.BLOOMING_SPEED2_TITLE"
msgid "Growth Spurt II"
msgstr "Crecimiento acelerado II"

#. STRINGS.SKILLTREE.WORMWOOD.BLOOMING_TRAPBRAMBLE_DESC
msgctxt "STRINGS.SKILLTREE.WORMWOOD.BLOOMING_TRAPBRAMBLE_DESC"
