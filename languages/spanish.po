msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.KITCOON_MOON"
msgid "A clever little thing."
msgstr "¿Quién es un gapachito listo?"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.KITCOON_NAMETAG
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.KITCOON_NAMETAG"
msgid "Name tags can be pretty handy in the workplace."
msgstr "Las placas de identidad van genial en el trabajo."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.KITCOON_ROCKY
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.KITCOON_ROCKY"
msgid "A clever little thing."
msgstr "¿Quién es un gapachito listo?"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.KITCOON_SAVANNA
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.KITCOON_SAVANNA"
