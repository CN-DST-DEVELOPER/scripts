#. STRINGS.STAGEACTOR.ACT1_SCENE1.LINE1
msgctxt "STRINGS.STAGEACTOR.ACT1_SCENE1.LINE1"
msgid "Act 1."
msgstr "Acto 1.º."

#. STRINGS.STAGEACTOR.ACT1_SCENE1.LINE10
msgctxt "STRINGS.STAGEACTOR.ACT1_SCENE1.LINE10"
msgid "There are so many things I've never done,"
msgstr "Hay tantas cosas por hacer,"

#. STRINGS.STAGEACTOR.ACT1_SCENE1.LINE11
msgctxt "STRINGS.STAGEACTOR.ACT1_SCENE1.LINE11"
msgid "so many things I've never seen..."
msgstr "tantas cosas por ver..."

#. STRINGS.STAGEACTOR.ACT1_SCENE1.LINE12
msgctxt "STRINGS.STAGEACTOR.ACT1_SCENE1.LINE12"
msgid "I must explore every last bit of it!"
msgstr "¡Debo explorar hasta el último rincón!"

#. STRINGS.STAGEACTOR.ACT1_SCENE1.LINE13
msgctxt "STRINGS.STAGEACTOR.ACT1_SCENE1.LINE13"
msgid "The thought of starting a life of her own"
msgstr "La idea de empezar una vida por su cuenta"

#. STRINGS.STAGEACTOR.ACT1_SCENE1.LINE14
msgctxt "STRINGS.STAGEACTOR.ACT1_SCENE1.LINE14"
msgid "filled the doll's heart with joy."
msgstr "hizo muy feliz a la muñeca."

#. STRINGS.STAGEACTOR.ACT1_SCENE1.LINE15
msgctxt "STRINGS.STAGEACTOR.ACT1_SCENE1.LINE15"
msgid "But not everyone shared the sentiment..."
msgstr "Pero no todo el mundo estaba de acuerdo..."

#. STRINGS.STAGEACTOR.ACT1_SCENE1.LINE16
msgctxt "STRINGS.STAGEACTOR.ACT1_SCENE1.LINE16"
msgid "You don't see talent like that everyday."
msgstr "No se ve un talento así todos los días."

#. STRINGS.STAGEACTOR.ACT1_SCENE1.LINE17
msgctxt "STRINGS.STAGEACTOR.ACT1_SCENE1.LINE17"
msgid "Thankfully."
msgstr "Por suerte."

#. STRINGS.STAGEACTOR.ACT1_SCENE1.LINE18
msgctxt "STRINGS.STAGEACTOR.ACT1_SCENE1.LINE18"
msgid "At least the tree was good."
msgstr "Al menos el árbol estaba bien."

#. STRINGS.STAGEACTOR.ACT1_SCENE1.LINE19
msgctxt "STRINGS.STAGEACTOR.ACT1_SCENE1.LINE19"
msgid "HA HA HA HA HA!"
msgstr "¡JA, JA, JA!"

#. STRINGS.STAGEACTOR.ACT1_SCENE1.LINE2
msgctxt "STRINGS.STAGEACTOR.ACT1_SCENE1.LINE2"
msgid "Yeah, scene 1!"
msgstr "¡Sí, escena 1!"

#. STRINGS.STAGEACTOR.ACT1_SCENE1.LINE3
msgctxt "STRINGS.STAGEACTOR.ACT1_SCENE1.LINE3"
msgid "Long ago, in a land oh so far away"
msgstr "Hace mucho tiempo, en un país muy lejano,"

#. STRINGS.STAGEACTOR.ACT1_SCENE1.LINE4
msgctxt "STRINGS.STAGEACTOR.ACT1_SCENE1.LINE4"
msgid "a strange magic filled the air,"
msgstr "una magia muy extraña apareció en el aire"

#. STRINGS.STAGEACTOR.ACT1_SCENE1.LINE5
msgctxt "STRINGS.STAGEACTOR.ACT1_SCENE1.LINE5"
msgid "and a porcelain doll came to life."
msgstr "y una muñeca de porcelana cobró vida."

#. STRINGS.STAGEACTOR.ACT1_SCENE1.LINE6
msgctxt "STRINGS.STAGEACTOR.ACT1_SCENE1.LINE6"
msgid "Ahh."
msgstr "Ah."

#. STRINGS.STAGEACTOR.ACT1_SCENE1.LINE7
msgctxt "STRINGS.STAGEACTOR.ACT1_SCENE1.LINE7"
msgid "I can move my hands? And my feet too!"
msgstr "¿Puedo mover las manos? ¡Y los pies!"

#. STRINGS.STAGEACTOR.ACT1_SCENE1.LINE8
msgctxt "STRINGS.STAGEACTOR.ACT1_SCENE1.LINE8"
msgid "Is this what it's like to be alive?"
msgstr "¿Esto es lo que se siente al estar viva?"

#. STRINGS.STAGEACTOR.ACT1_SCENE1.LINE9
msgctxt "STRINGS.STAGEACTOR.ACT1_SCENE1.LINE9"
msgid "And what a big world to be alive in!"
msgstr "¡Y qué mundo tan grande para vivir!"

#. STRINGS.STAGEACTOR.ACT1_SCENE2.LINE1
msgctxt "STRINGS.STAGEACTOR.ACT1_SCENE2.LINE1"
msgid "Act 1!"
msgstr "¡Acto 1.º!"

#. STRINGS.STAGEACTOR.ACT1_SCENE2.LINE10
msgctxt "STRINGS.STAGEACTOR.ACT1_SCENE2.LINE10"
msgid "The world is filled with dangers"
msgstr "El mundo está lleno de peligros"

#. STRINGS.STAGEACTOR.ACT1_SCENE2.LINE11
msgctxt "STRINGS.STAGEACTOR.ACT1_SCENE2.LINE11"
msgid "for one as fragile as you."
msgstr "para alguien tan frágil como tú."

#. STRINGS.STAGEACTOR.ACT1_SCENE2.LINE12
msgctxt "STRINGS.STAGEACTOR.ACT1_SCENE2.LINE12"
msgid "It's simply not the place for a girl made of porcelain!"
msgstr "¡No es lugar para una niña de porcelana!"

#. STRINGS.STAGEACTOR.ACT1_SCENE2.LINE13
msgctxt "STRINGS.STAGEACTOR.ACT1_SCENE2.LINE13"
msgid "I know what must be done,"
msgstr "Sé lo que hay que hacer,"

#. STRINGS.STAGEACTOR.ACT1_SCENE2.LINE14
msgctxt "STRINGS.STAGEACTOR.ACT1_SCENE2.LINE14"
msgid "I will build you a fine suit of armor."
msgstr "te fabricaré una buena armadura."

#. STRINGS.STAGEACTOR.ACT1_SCENE2.LINE15
msgctxt "STRINGS.STAGEACTOR.ACT1_SCENE2.LINE15"
msgid "Wear it, and you will have nothing to fear."
msgstr "Póntela y no tendrás nada que temer."

#. STRINGS.STAGEACTOR.ACT1_SCENE2.LINE16
msgctxt "STRINGS.STAGEACTOR.ACT1_SCENE2.LINE16"
msgid "And so, the Blacksmith went to her anvil,"
msgstr "Así, la herrera se dirigió a su yunque"

#. STRINGS.STAGEACTOR.ACT1_SCENE2.LINE17
msgctxt "STRINGS.STAGEACTOR.ACT1_SCENE2.LINE17"
msgid "and fashioned a suit of heavy iron armor."
msgstr "y forjó una pesada armadura de hierro."

#. STRINGS.STAGEACTOR.ACT1_SCENE2.LINE18
msgctxt "STRINGS.STAGEACTOR.ACT1_SCENE2.LINE18"
msgid "The little doll put it on,"
msgstr "La muñequita se la puso,"

#. STRINGS.STAGEACTOR.ACT1_SCENE2.LINE19
msgctxt "STRINGS.STAGEACTOR.ACT1_SCENE2.LINE19"
msgid "but found that she could barely move in it."
msgstr "pero apenas podía moverse."

#. STRINGS.STAGEACTOR.ACT1_SCENE2.LINE2
msgctxt "STRINGS.STAGEACTOR.ACT1_SCENE2.LINE2"
msgid "Scene 2, right?"
msgstr "Escena 2, ¿no?"

#. STRINGS.STAGEACTOR.ACT1_SCENE2.LINE20
msgctxt "STRINGS.STAGEACTOR.ACT1_SCENE2.LINE20"
msgid "This armor is so heavy,"
msgstr "Esta armadura es tan pesada"

#. STRINGS.STAGEACTOR.ACT1_SCENE2.LINE21
msgctxt "STRINGS.STAGEACTOR.ACT1_SCENE2.LINE21"
msgid "I feel as though I might just..."
msgstr "que creo que voy a..."

#. STRINGS.STAGEACTOR.ACT1_SCENE2.LINE22
msgctxt "STRINGS.STAGEACTOR.ACT1_SCENE2.LINE22"
msgid "The little doll waited until it was dark,"
msgstr "La muñequita esperó a que cayese la noche"

#. STRINGS.STAGEACTOR.ACT1_SCENE2.LINE23
msgctxt "STRINGS.STAGEACTOR.ACT1_SCENE2.LINE23"
msgid "and the Blacksmith went to sleep."
msgstr "y la herrera se fue a dormir."

#. STRINGS.STAGEACTOR.ACT1_SCENE2.LINE24
msgctxt "STRINGS.STAGEACTOR.ACT1_SCENE2.LINE24"
msgid "Then she shed the heavy armor,"
msgstr "Entonces se quitó la pesada armadura"

#. STRINGS.STAGEACTOR.ACT1_SCENE2.LINE25
msgctxt "STRINGS.STAGEACTOR.ACT1_SCENE2.LINE25"
msgid "and slipped out into the night"
msgstr "y se escabulló entre las sombras"

#. STRINGS.STAGEACTOR.ACT1_SCENE2.LINE26
msgctxt "STRINGS.STAGEACTOR.ACT1_SCENE2.LINE26"
msgid "to begin her adventure."
msgstr "para comenzar su aventura."

#. STRINGS.STAGEACTOR.ACT1_SCENE2.LINE27
msgctxt "STRINGS.STAGEACTOR.ACT1_SCENE2.LINE27"
msgid "Sis... are you tryin' to tell me something?"
msgstr "Hermana... ¿Estás intentando decirme algo?"

#. STRINGS.STAGEACTOR.ACT1_SCENE2.LINE28
msgctxt "STRINGS.STAGEACTOR.ACT1_SCENE2.LINE28"
msgid "That blacksmith really cracks me up."
msgstr "Me parto de risa con esa herrera."

#. STRINGS.STAGEACTOR.ACT1_SCENE2.LINE29
msgctxt "STRINGS.STAGEACTOR.ACT1_SCENE2.LINE29"
msgid "I dunno, the acting was pretty heavy-handed."
msgstr "No sé yo, la interpretación ha sido un poco forzada."

#. STRINGS.STAGEACTOR.ACT1_SCENE2.LINE3
msgctxt "STRINGS.STAGEACTOR.ACT1_SCENE2.LINE3"
msgid "The little doll ran first to the Blacksmith,"
msgstr "La muñequita acudió primero a la herrera,"

#. STRINGS.STAGEACTOR.ACT1_SCENE2.LINE30
msgctxt "STRINGS.STAGEACTOR.ACT1_SCENE2.LINE30"
msgid "HA HA HA HA HA!"
msgstr "¡JA, JA, JA!"

#. STRINGS.STAGEACTOR.ACT1_SCENE2.LINE31
msgctxt "STRINGS.STAGEACTOR.ACT1_SCENE2.LINE31"
msgid "But did you see that tree?"
msgstr "¿Has visto a ese árbol?"

#. STRINGS.STAGEACTOR.ACT1_SCENE2.LINE32
msgctxt "STRINGS.STAGEACTOR.ACT1_SCENE2.LINE32"
msgid "Right? Such presence!"
msgstr "¿Verdad? ¡Menuda presencia!"

#. STRINGS.STAGEACTOR.ACT1_SCENE2.LINE4
msgctxt "STRINGS.STAGEACTOR.ACT1_SCENE2.LINE4"
msgid "who had cared for her ever since"
msgstr "quién la había cuidado desde"

#. STRINGS.STAGEACTOR.ACT1_SCENE2.LINE5
msgctxt "STRINGS.STAGEACTOR.ACT1_SCENE2.LINE5"
msgid "the Blacksmith herself was small."
msgstr "que la propia herrera era pequeña."

#. STRINGS.STAGEACTOR.ACT1_SCENE2.LINE6
msgctxt "STRINGS.STAGEACTOR.ACT1_SCENE2.LINE6"
msgid "The Blacksmith was delighted to see"
msgstr "La herrera se alegró mucho al ver"

#. STRINGS.STAGEACTOR.ACT1_SCENE2.LINE7
msgctxt "STRINGS.STAGEACTOR.ACT1_SCENE2.LINE7"
msgid "that the doll had come to life,"
msgstr "que la muñeca había cobrado vida,"

#. STRINGS.STAGEACTOR.ACT1_SCENE2.LINE8
msgctxt "STRINGS.STAGEACTOR.ACT1_SCENE2.LINE8"
msgid "but her delight quickly gave way to fear."
msgstr "pero su alegría pronto se tornó en miedo."

#. STRINGS.STAGEACTOR.ACT1_SCENE2.LINE9
msgctxt "STRINGS.STAGEACTOR.ACT1_SCENE2.LINE9"
msgid "Little doll, you must be careful!"
msgstr "¡Tienes que andarte con ojo, muñequita!"

#. STRINGS.STAGEACTOR.ACT1_SCENE3.LINE1
msgctxt "STRINGS.STAGEACTOR.ACT1_SCENE3.LINE1"
msgid "Act 1."
msgstr "Acto 1.º."

#. STRINGS.STAGEACTOR.ACT1_SCENE3.LINE10
msgctxt "STRINGS.STAGEACTOR.ACT1_SCENE3.LINE10"
msgid "and the trees and flowers bloomed at his command."
msgstr "y los árboles y las flores florecían cuando lo deseaba."

#. STRINGS.STAGEACTOR.ACT1_SCENE3.LINE11
msgctxt "STRINGS.STAGEACTOR.ACT1_SCENE3.LINE11"
msgid "Crowds gathered to watch him pass."
msgstr "La gente se agolpaba para verlo pasar."

#. STRINGS.STAGEACTOR.ACT1_SCENE3.LINE12
msgctxt "STRINGS.STAGEACTOR.ACT1_SCENE3.LINE12"
msgid "Get a load of this guy."
msgstr "Mira a este tipo."

#. STRINGS.STAGEACTOR.ACT1_SCENE3.LINE13
msgctxt "STRINGS.STAGEACTOR.ACT1_SCENE3.LINE13"
msgid "What a show-off."
msgstr "Será engreído."

#. STRINGS.STAGEACTOR.ACT1_SCENE3.LINE14
msgctxt "STRINGS.STAGEACTOR.ACT1_SCENE3.LINE14"
msgid "Excuse me, sir!"
msgstr "¡Disculpe, señor!"

#. STRINGS.STAGEACTOR.ACT1_SCENE3.LINE15
msgctxt "STRINGS.STAGEACTOR.ACT1_SCENE3.LINE15"
msgid "How did you make the flowers bloom?"
msgstr "¿Cómo ha hecho que florezcan las flores?"

#. STRINGS.STAGEACTOR.ACT1_SCENE3.LINE16
msgctxt "STRINGS.STAGEACTOR.ACT1_SCENE3.LINE16"
msgid "Why, it's magic, my dear!"
msgstr "¡Con magia, evidentemente!"

#. STRINGS.STAGEACTOR.ACT1_SCENE3.LINE17
msgctxt "STRINGS.STAGEACTOR.ACT1_SCENE3.LINE17"
msgid "And I am no simple \"sir\","
msgstr "Y no soy un señor cualquiera,"

#. STRINGS.STAGEACTOR.ACT1_SCENE3.LINE18
msgctxt "STRINGS.STAGEACTOR.ACT1_SCENE3.LINE18"
msgid "but the King of this land!"
msgstr "¡soy el rey de estas tierras!"

#. STRINGS.STAGEACTOR.ACT1_SCENE3.LINE19
msgctxt "STRINGS.STAGEACTOR.ACT1_SCENE3.LINE19"
msgid "Oh! I'm terribly sorry,"
msgstr "¡Oh! Lo siento mucho,"

#. STRINGS.STAGEACTOR.ACT1_SCENE3.LINE2
msgctxt "STRINGS.STAGEACTOR.ACT1_SCENE3.LINE2"
msgid "Scene 3!"
msgstr "¡Escena 3!"

#. STRINGS.STAGEACTOR.ACT1_SCENE3.LINE20
msgctxt "STRINGS.STAGEACTOR.ACT1_SCENE3.LINE20"
msgid "I've never met a king before,"
msgstr "Nunca había conocido a un rey,"

#. STRINGS.STAGEACTOR.ACT1_SCENE3.LINE21
msgctxt "STRINGS.STAGEACTOR.ACT1_SCENE3.LINE21"
msgid "I didn't know what they looked like."
msgstr "no sabía qué pinta tenían."

#. STRINGS.STAGEACTOR.ACT1_SCENE3.LINE22
msgctxt "STRINGS.STAGEACTOR.ACT1_SCENE3.LINE22"
msgid "Ho, ho!"
msgstr "¡Jo, jo!"

#. STRINGS.STAGEACTOR.ACT1_SCENE3.LINE23
msgctxt "STRINGS.STAGEACTOR.ACT1_SCENE3.LINE23"
msgid "Truth be told,"
msgstr "Sinceramente,"

#. STRINGS.STAGEACTOR.ACT1_SCENE3.LINE24
msgctxt "STRINGS.STAGEACTOR.ACT1_SCENE3.LINE24"
msgid "I've never met a porcelain doll"
msgstr "yo tampoco conocía a ninguna muñeca de porcelana"

#. STRINGS.STAGEACTOR.ACT1_SCENE3.LINE25
msgctxt "STRINGS.STAGEACTOR.ACT1_SCENE3.LINE25"
msgid "quite so alive before."
msgstr "que estuviese tan viva."

#. STRINGS.STAGEACTOR.ACT1_SCENE3.LINE26
msgctxt "STRINGS.STAGEACTOR.ACT1_SCENE3.LINE26"
msgid "Perhaps we could travel together?"
msgstr "¿Podríamos viajar juntos?"

#. STRINGS.STAGEACTOR.ACT1_SCENE3.LINE27
msgctxt "STRINGS.STAGEACTOR.ACT1_SCENE3.LINE27"
msgid "This road is long, and can get quite lonely."
msgstr "El camino es largo y puede hacerse bastante solitario."

#. STRINGS.STAGEACTOR.ACT1_SCENE3.LINE28
msgctxt "STRINGS.STAGEACTOR.ACT1_SCENE3.LINE28"
msgid "How wonderful!"
msgstr "¡Qué bien!"

#. STRINGS.STAGEACTOR.ACT1_SCENE3.LINE29
msgctxt "STRINGS.STAGEACTOR.ACT1_SCENE3.LINE29"
msgid "Would you teach me your magic along the way?"
msgstr "¿Podría enseñarme a hacer magia por el camino?"

#. STRINGS.STAGEACTOR.ACT1_SCENE3.LINE3
msgctxt "STRINGS.STAGEACTOR.ACT1_SCENE3.LINE3"
msgid "Yeah, scene 3."
msgstr "Sí, escena 3."

#. STRINGS.STAGEACTOR.ACT1_SCENE3.LINE30
msgctxt "STRINGS.STAGEACTOR.ACT1_SCENE3.LINE30"
msgid "I would be delighted."
msgstr "Sería un placer."

#. STRINGS.STAGEACTOR.ACT1_SCENE3.LINE31
msgctxt "STRINGS.STAGEACTOR.ACT1_SCENE3.LINE31"
msgid "The plot thickens."
msgstr "Esto se pone interesante."

#. STRINGS.STAGEACTOR.ACT1_SCENE3.LINE32
msgctxt "STRINGS.STAGEACTOR.ACT1_SCENE3.LINE32"
msgid "I think you mean sickens."
msgstr "¿No será \"cargante\"?"

#. STRINGS.STAGEACTOR.ACT1_SCENE3.LINE33
msgctxt "STRINGS.STAGEACTOR.ACT1_SCENE3.LINE33"
msgid "HA HA HA HA HA!"
msgstr "¡JA, JA, JA!"

#. STRINGS.STAGEACTOR.ACT1_SCENE3.LINE4
msgctxt "STRINGS.STAGEACTOR.ACT1_SCENE3.LINE4"
msgid "The little doll walked and walked,"
msgstr "La muñequita caminó y caminó,"

#. STRINGS.STAGEACTOR.ACT1_SCENE3.LINE5
msgctxt "STRINGS.STAGEACTOR.ACT1_SCENE3.LINE5"
msgid "marveling as the countryside gave way"
msgstr "maravillándose mientras el campo dejaba paso"

#. STRINGS.STAGEACTOR.ACT1_SCENE3.LINE6
msgctxt "STRINGS.STAGEACTOR.ACT1_SCENE3.LINE6"
msgid "to a bustling city."
msgstr "a una bulliciosa ciudad."

#. STRINGS.STAGEACTOR.ACT1_SCENE3.LINE7
msgctxt "STRINGS.STAGEACTOR.ACT1_SCENE3.LINE7"
msgid "One day, she happened upon a man in a golden crown,"
msgstr "Un día, encontró a un hombre con una corona de oro"

#. STRINGS.STAGEACTOR.ACT1_SCENE3.LINE8
msgctxt "STRINGS.STAGEACTOR.ACT1_SCENE3.LINE8"
msgid "traveling down the road."
msgstr "andando por el camino."

#. STRINGS.STAGEACTOR.ACT1_SCENE3.LINE9
msgctxt "STRINGS.STAGEACTOR.ACT1_SCENE3.LINE9"
msgid "He twirled his finger in the air,"
msgstr "Hacía girar su dedo en el aire,"

#. STRINGS.STAGEACTOR.ACT2_SCENE4.LINE1
msgctxt "STRINGS.STAGEACTOR.ACT2_SCENE4.LINE1"
msgid "Back from intermission."
msgstr "Fin del entreacto."

#. STRINGS.STAGEACTOR.ACT2_SCENE4.LINE10
msgctxt "STRINGS.STAGEACTOR.ACT2_SCENE4.LINE10"
msgid "I'm a bit under the weather."
msgstr "Estoy un poco triste."

#. STRINGS.STAGEACTOR.ACT2_SCENE4.LINE11
msgctxt "STRINGS.STAGEACTOR.ACT2_SCENE4.LINE11"
msgid "I'm afraid I can't,"
msgstr "Me temo que no puedo,"

#. STRINGS.STAGEACTOR.ACT2_SCENE4.LINE12
msgctxt "STRINGS.STAGEACTOR.ACT2_SCENE4.LINE12"
msgid "there's a full moon out tonight!"
msgstr "¡esta noche hay luna llena!"

#. STRINGS.STAGEACTOR.ACT2_SCENE4.LINE13
msgctxt "STRINGS.STAGEACTOR.ACT2_SCENE4.LINE13"
msgid "Dear me, I couldn't possibly!"
msgstr "¡Dios mío, no podría!"

#. STRINGS.STAGEACTOR.ACT2_SCENE4.LINE14
msgctxt "STRINGS.STAGEACTOR.ACT2_SCENE4.LINE14"
msgid "Don't you know it's bad luck to teach magic on Wednesdays?"
msgstr "¿No sabes que da mala suerte enseñar magia los miércoles?"

#. STRINGS.STAGEACTOR.ACT2_SCENE4.LINE15
msgctxt "STRINGS.STAGEACTOR.ACT2_SCENE4.LINE15"
msgid "The doll believed the King,"
msgstr "La muñeca creyó al rey,"

#. STRINGS.STAGEACTOR.ACT2_SCENE4.LINE16
msgctxt "STRINGS.STAGEACTOR.ACT2_SCENE4.LINE16"
msgid "so she waited. And waited..."
msgstr "así que esperó y esperó..."

#. STRINGS.STAGEACTOR.ACT2_SCENE4.LINE17
msgctxt "STRINGS.STAGEACTOR.ACT2_SCENE4.LINE17"
msgid "Until one day,"
msgstr "Hasta que, un día,"

#. STRINGS.STAGEACTOR.ACT2_SCENE4.LINE18
msgctxt "STRINGS.STAGEACTOR.ACT2_SCENE4.LINE18"
msgid "she found a hidden chamber in the King's castle,"
msgstr "encontró una cámara oculta en el castillo del rey"

#. STRINGS.STAGEACTOR.ACT2_SCENE4.LINE19
msgctxt "STRINGS.STAGEACTOR.ACT2_SCENE4.LINE19"
msgid "and discovered his secret."
msgstr "y descubrió su secreto."

#. STRINGS.STAGEACTOR.ACT2_SCENE4.LINE2
msgctxt "STRINGS.STAGEACTOR.ACT2_SCENE4.LINE2"
msgid "Yes, on to Act 2!"
msgstr "¡Sí! ¡A por el 2.º acto!"

#. STRINGS.STAGEACTOR.ACT2_SCENE4.LINE20
msgctxt "STRINGS.STAGEACTOR.ACT2_SCENE4.LINE20"
msgid "Oh! Hello there, who are you?"
msgstr "¡Oh! Hola, ¿quién eres?"

#. STRINGS.STAGEACTOR.ACT2_SCENE4.LINE21
msgctxt "STRINGS.STAGEACTOR.ACT2_SCENE4.LINE21"
msgid "I have no name,"
msgstr "No tengo nombre,"

#. STRINGS.STAGEACTOR.ACT2_SCENE4.LINE22
msgctxt "STRINGS.STAGEACTOR.ACT2_SCENE4.LINE22"
msgid "I am known only as the magic mirror."
msgstr "la gente me conoce como el espejo mágico."

#. STRINGS.STAGEACTOR.ACT2_SCENE4.LINE23
msgctxt "STRINGS.STAGEACTOR.ACT2_SCENE4.LINE23"
msgid "Your King has stolen my power"
msgstr "Tu rey me robó mi poder"

#. STRINGS.STAGEACTOR.ACT2_SCENE4.LINE24
msgctxt "STRINGS.STAGEACTOR.ACT2_SCENE4.LINE24"
msgid "and kept me hidden away."
msgstr "y me ocultó aquí."

#. STRINGS.STAGEACTOR.ACT2_SCENE4.LINE25
msgctxt "STRINGS.STAGEACTOR.ACT2_SCENE4.LINE25"
msgid "How I hunger for freedom."
msgstr "Cuánto ansío la libertad."

#. STRINGS.STAGEACTOR.ACT2_SCENE4.LINE26
msgctxt "STRINGS.STAGEACTOR.ACT2_SCENE4.LINE26"
msgid "Just a taste of the outside world..."
msgstr "Volver a ver el mundo exterior..."

#. STRINGS.STAGEACTOR.ACT2_SCENE4.LINE27
msgctxt "STRINGS.STAGEACTOR.ACT2_SCENE4.LINE27"
msgid "I knew I didn't trust that King!"
msgstr "¡Sabía que ese rey no era de fiar!"

#. STRINGS.STAGEACTOR.ACT2_SCENE4.LINE28
msgctxt "STRINGS.STAGEACTOR.ACT2_SCENE4.LINE28"
msgid "Boo! Hiss!"
msgstr "¡Buu! ¡Fsss!"

#. STRINGS.STAGEACTOR.ACT2_SCENE4.LINE29
msgctxt "STRINGS.STAGEACTOR.ACT2_SCENE4.LINE29"
msgid "How terrible!"
msgstr "¡Qué terrible!"

#. STRINGS.STAGEACTOR.ACT2_SCENE4.LINE3
msgctxt "STRINGS.STAGEACTOR.ACT2_SCENE4.LINE3"
msgid "Scene 1."
msgstr "Escena 1."

#. STRINGS.STAGEACTOR.ACT2_SCENE4.LINE30
msgctxt "STRINGS.STAGEACTOR.ACT2_SCENE4.LINE30"
msgid "Don't worry,"
msgstr "No te preocupes,"

#. STRINGS.STAGEACTOR.ACT2_SCENE4.LINE31
msgctxt "STRINGS.STAGEACTOR.ACT2_SCENE4.LINE31"
msgid "I will help you leave this lonely place."
msgstr "te sacaré de este lugar tan solitario."

#. STRINGS.STAGEACTOR.ACT2_SCENE4.LINE32
msgctxt "STRINGS.STAGEACTOR.ACT2_SCENE4.LINE32"
msgid "No! My secret has been discovered!"
msgstr "¡No! ¡Mi secreto ha salido a la luz!"

#. STRINGS.STAGEACTOR.ACT2_SCENE4.LINE33
msgctxt "STRINGS.STAGEACTOR.ACT2_SCENE4.LINE33"
msgid "You didn't honor our agreement."
msgstr "No has cumplido tu parte del trato."

#. STRINGS.STAGEACTOR.ACT2_SCENE4.LINE34
msgctxt "STRINGS.STAGEACTOR.ACT2_SCENE4.LINE34"
msgid "Now this courageous doll has come"
msgstr "Ahora, esta valiente muñeca ha venido"

#. STRINGS.STAGEACTOR.ACT2_SCENE4.LINE35
msgctxt "STRINGS.STAGEACTOR.ACT2_SCENE4.LINE35"
msgid "to release me from this prison."
msgstr "a liberarme de esta prisión."

#. STRINGS.STAGEACTOR.ACT2_SCENE4.LINE36
msgctxt "STRINGS.STAGEACTOR.ACT2_SCENE4.LINE36"
msgid "Back, I say!"
msgstr "¡Atrás, he dicho!"

#. STRINGS.STAGEACTOR.ACT2_SCENE4.LINE37
msgctxt "STRINGS.STAGEACTOR.ACT2_SCENE4.LINE37"
msgid "Your magic is mine, mirror."
msgstr "Tu magia es mía, espejo."

#. STRINGS.STAGEACTOR.ACT2_SCENE4.LINE38
msgctxt "STRINGS.STAGEACTOR.ACT2_SCENE4.LINE38"
msgid "I will never let you go free!"
msgstr "¡Jamás te dejaré ir!"

#. STRINGS.STAGEACTOR.ACT2_SCENE4.LINE39
msgctxt "STRINGS.STAGEACTOR.ACT2_SCENE4.LINE39"
msgid "Mmmagic blast!"
msgstr "¡Ráfaga mágica!"

#. STRINGS.STAGEACTOR.ACT2_SCENE4.LINE4
msgctxt "STRINGS.STAGEACTOR.ACT2_SCENE4.LINE4"
msgid "Time passed, and the King brought the little doll"
msgstr "Con el paso del tiempo, el rey llevó a la muñequita"

#. STRINGS.STAGEACTOR.ACT2_SCENE4.LINE40
msgctxt "STRINGS.STAGEACTOR.ACT2_SCENE4.LINE40"
msgid "No!"
msgstr "¡No!"

#. STRINGS.STAGEACTOR.ACT2_SCENE4.LINE41
msgctxt "STRINGS.STAGEACTOR.ACT2_SCENE4.LINE41"
msgid "Eeep! Time to disappear!"
msgstr "¡Epa! ¡Hora de irse!"

#. STRINGS.STAGEACTOR.ACT2_SCENE4.LINE42
msgctxt "STRINGS.STAGEACTOR.ACT2_SCENE4.LINE42"
msgid "Mmmagic ske-daddle!"
msgstr "¡Huida mágica!"

#. STRINGS.STAGEACTOR.ACT2_SCENE4.LINE43
msgctxt "STRINGS.STAGEACTOR.ACT2_SCENE4.LINE43"
msgid "I wonder just how much she really remembers."
msgstr "Me pregunto cuánto recuerda realmente."

#. STRINGS.STAGEACTOR.ACT2_SCENE4.LINE44
msgctxt "STRINGS.STAGEACTOR.ACT2_SCENE4.LINE44"
msgid "I really felt for the tree."
msgstr "Me ha dado pena el árbol."

#. STRINGS.STAGEACTOR.ACT2_SCENE4.LINE45
msgctxt "STRINGS.STAGEACTOR.ACT2_SCENE4.LINE45"
msgid "Very emotional."
msgstr "Ha sido muy emotivo."

#. STRINGS.STAGEACTOR.ACT2_SCENE4.LINE5
msgctxt "STRINGS.STAGEACTOR.ACT2_SCENE4.LINE5"
msgid "on many wonderful adventures."
msgstr "a muchas aventuras increíbles."

#. STRINGS.STAGEACTOR.ACT2_SCENE4.LINE6
msgctxt "STRINGS.STAGEACTOR.ACT2_SCENE4.LINE6"
msgid "The doll asked often about the King's magic,"
msgstr "La muñeca solía preguntarle al rey por su magia"

#. STRINGS.STAGEACTOR.ACT2_SCENE4.LINE7
msgctxt "STRINGS.STAGEACTOR.ACT2_SCENE4.LINE7"
msgid "and if he would teach her,"
msgstr "y si podría enseñarle,"

#. STRINGS.STAGEACTOR.ACT2_SCENE4.LINE8
msgctxt "STRINGS.STAGEACTOR.ACT2_SCENE4.LINE8"
msgid "but the King always gave one excuse or another."
msgstr "pero el rey siempre ponía excusas."

#. STRINGS.STAGEACTOR.ACT2_SCENE4.LINE9
msgctxt "STRINGS.STAGEACTOR.ACT2_SCENE4.LINE9"
msgid "Not today little doll,"
msgstr "Hoy no, muñequita,"

#. STRINGS.STAGEACTOR.ACT2_SCENE5.LINE1
msgctxt "STRINGS.STAGEACTOR.ACT2_SCENE5.LINE1"
msgid "Oh good, the tree is here."
msgstr "Oh, bien, ya está aquí el árbol."

#. STRINGS.STAGEACTOR.ACT2_SCENE5.LINE10
msgctxt "STRINGS.STAGEACTOR.ACT2_SCENE5.LINE10"
msgid "Better than ever!"
msgstr "¡Mejor que nunca!"

#. STRINGS.STAGEACTOR.ACT2_SCENE5.LINE11
msgctxt "STRINGS.STAGEACTOR.ACT2_SCENE5.LINE11"
msgid "I've given you what power I can spare,"
msgstr "Te he dado todo el poder que tenía,"

#. STRINGS.STAGEACTOR.ACT2_SCENE5.LINE12
msgctxt "STRINGS.STAGEACTOR.ACT2_SCENE5.LINE12"
msgid "but without the magic the King stole from me,"
msgstr "pero, sin la magia que el rey me robó,"

#. STRINGS.STAGEACTOR.ACT2_SCENE5.LINE13
msgctxt "STRINGS.STAGEACTOR.ACT2_SCENE5.LINE13"
msgid "I cannot make you fully whole."
msgstr "no puedo recuperarte por completo."

#. STRINGS.STAGEACTOR.ACT2_SCENE5.LINE14
msgctxt "STRINGS.STAGEACTOR.ACT2_SCENE5.LINE14"
msgid "You must seek him out, but be wary."
msgstr "Debes ir en su busca, pero ten cuidado."

#. STRINGS.STAGEACTOR.ACT2_SCENE5.LINE15
msgctxt "STRINGS.STAGEACTOR.ACT2_SCENE5.LINE15"
msgid "You have seen his treacherous ways for yourself."
msgstr "Ya sabes de lo que es capaz."

#. STRINGS.STAGEACTOR.ACT2_SCENE5.LINE16
msgctxt "STRINGS.STAGEACTOR.ACT2_SCENE5.LINE16"
msgid "I will speak to him."
msgstr "Hablaré con él."

#. STRINGS.STAGEACTOR.ACT2_SCENE5.LINE17
msgctxt "STRINGS.STAGEACTOR.ACT2_SCENE5.LINE17"
msgid "And I promise you this, mirror;"
msgstr "Te lo prometo, espejo,"

#. STRINGS.STAGEACTOR.ACT2_SCENE5.LINE18
msgctxt "STRINGS.STAGEACTOR.ACT2_SCENE5.LINE18"
msgid "I will see both of us whole again."
msgstr "ambos volveremos a estar enteros."

#. STRINGS.STAGEACTOR.ACT2_SCENE5.LINE2
msgctxt "STRINGS.STAGEACTOR.ACT2_SCENE5.LINE2"
msgid "I was worried for a second."
msgstr "Me ha preocupado un poco."

#. STRINGS.STAGEACTOR.ACT2_SCENE5.LINE3
msgctxt "STRINGS.STAGEACTOR.ACT2_SCENE5.LINE3"
msgid "Hurry! Act 2!"
msgstr "¡Venga! ¡2.º acto!"

#. STRINGS.STAGEACTOR.ACT2_SCENE5.LINE4
msgctxt "STRINGS.STAGEACTOR.ACT2_SCENE5.LINE4"
msgid "Scene 2!"
msgstr "¡Escena 2!"

#. STRINGS.STAGEACTOR.ACT2_SCENE5.LINE5
msgctxt "STRINGS.STAGEACTOR.ACT2_SCENE5.LINE5"
msgid "Your time is not over yet, little doll."
msgstr "Aún no ha llegado tu hora, muñequita."

#. STRINGS.STAGEACTOR.ACT2_SCENE5.LINE6
msgctxt "STRINGS.STAGEACTOR.ACT2_SCENE5.LINE6"
msgid "Awaken!"
msgstr "¡Despierta!"

#. STRINGS.STAGEACTOR.ACT2_SCENE5.LINE7
msgctxt "STRINGS.STAGEACTOR.ACT2_SCENE5.LINE7"
msgid "I'm... alive!"
msgstr "Estoy... ¡viva!"

#. STRINGS.STAGEACTOR.ACT2_SCENE5.LINE8
msgctxt "STRINGS.STAGEACTOR.ACT2_SCENE5.LINE8"
msgid "But I feel... different..."
msgstr "Pero me siento... distinta..."

#. STRINGS.STAGEACTOR.ACT2_SCENE5.LINE9
msgctxt "STRINGS.STAGEACTOR.ACT2_SCENE5.LINE9"
msgid "Good as new!"
msgstr "¡Como nuevo!"

#. STRINGS.STAGEACTOR.ACT2_SCENE6.LINE1
msgctxt "STRINGS.STAGEACTOR.ACT2_SCENE6.LINE1"
msgid "Act 2!"
msgstr "¡Acto 2.º!"

#. STRINGS.STAGEACTOR.ACT2_SCENE6.LINE10
msgctxt "STRINGS.STAGEACTOR.ACT2_SCENE6.LINE10"
msgid "the construction of a home for peg-legged orphans!"
msgstr "la construcción de un hogar para huérfanos con patas de palo!"

#. STRINGS.STAGEACTOR.ACT2_SCENE6.LINE11
msgctxt "STRINGS.STAGEACTOR.ACT2_SCENE6.LINE11"
msgid "And... er... um..."
msgstr "Y... esto... bueno..."

#. STRINGS.STAGEACTOR.ACT2_SCENE6.LINE12
msgctxt "STRINGS.STAGEACTOR.ACT2_SCENE6.LINE12"
msgid "You wouldn't hit a guy with glasses, would you?"
msgstr "No se te ocurriría pegarle a un tipo con gafas, ¿verdad?"

#. STRINGS.STAGEACTOR.ACT2_SCENE6.LINE13
msgctxt "STRINGS.STAGEACTOR.ACT2_SCENE6.LINE13"
msgid "Are you so afraid to see your old friend?"
msgstr "¿Tanto miedo tienes de ver a tu vieja amiga?"

#. STRINGS.STAGEACTOR.ACT2_SCENE6.LINE14
msgctxt "STRINGS.STAGEACTOR.ACT2_SCENE6.LINE14"
msgid "Little doll? It can't be! I... that is, you..."
msgstr "¿Muñequita? ¡Imposible! Yo... Quiero decir, tú..."

#. STRINGS.STAGEACTOR.ACT2_SCENE6.LINE15
msgctxt "STRINGS.STAGEACTOR.ACT2_SCENE6.LINE15"
msgid "The mirror brought me back to life."
msgstr "El espejo me ha devuelto a la vida."

#. STRINGS.STAGEACTOR.ACT2_SCENE6.LINE16
msgctxt "STRINGS.STAGEACTOR.ACT2_SCENE6.LINE16"
msgid "I can feel what it feels..."
msgstr "Puedo sentir todo lo que siente..."

#. STRINGS.STAGEACTOR.ACT2_SCENE6.LINE17
msgctxt "STRINGS.STAGEACTOR.ACT2_SCENE6.LINE17"
msgid "We are going to help each other become whole again."
msgstr "Nos ayudaremos mutuamente para volver a estar enteros."

#. STRINGS.STAGEACTOR.ACT2_SCENE6.LINE18
msgctxt "STRINGS.STAGEACTOR.ACT2_SCENE6.LINE18"
msgid "But for that, I will need your power."
msgstr "Pero, para ello, voy a necesitar tu poder."

#. STRINGS.STAGEACTOR.ACT2_SCENE6.LINE19
msgctxt "STRINGS.STAGEACTOR.ACT2_SCENE6.LINE19"
msgid "My power? Never!"
msgstr "¿Mi poder? ¡Jamás!"

#. STRINGS.STAGEACTOR.ACT2_SCENE6.LINE2
msgctxt "STRINGS.STAGEACTOR.ACT2_SCENE6.LINE2"
msgid "Scene 3!"
msgstr "¡Escena 3!"

#. STRINGS.STAGEACTOR.ACT2_SCENE6.LINE20
msgctxt "STRINGS.STAGEACTOR.ACT2_SCENE6.LINE20"
msgid "Mmmmagic away!"
msgstr "¡Escape mágico!"

#. STRINGS.STAGEACTOR.ACT2_SCENE6.LINE21
msgctxt "STRINGS.STAGEACTOR.ACT2_SCENE6.LINE21"
msgid "No!"
msgstr "¡No!"

#. STRINGS.STAGEACTOR.ACT2_SCENE6.LINE22
msgctxt "STRINGS.STAGEACTOR.ACT2_SCENE6.LINE22"
msgid "And with that, the King used his magic"
msgstr "Y así, el rey usó su magia"

#. STRINGS.STAGEACTOR.ACT2_SCENE6.LINE23
msgctxt "STRINGS.STAGEACTOR.ACT2_SCENE6.LINE23"
msgid "to hide himself and his throne far away,"
msgstr "para ocultarse a sí mismo y a su trono en un lugar muy lejano,"

#. STRINGS.STAGEACTOR.ACT2_SCENE6.LINE24
msgctxt "STRINGS.STAGEACTOR.ACT2_SCENE6.LINE24"
msgid "where he thought the little doll would never find him."
msgstr "donde creyó que la muñeca nunca lo encontraría."

#. STRINGS.STAGEACTOR.ACT2_SCENE6.LINE3
msgctxt "STRINGS.STAGEACTOR.ACT2_SCENE6.LINE3"
msgid "The doll searched the castle for the King,"
msgstr "La muñeca registró el castillo en busca del rey"

#. STRINGS.STAGEACTOR.ACT2_SCENE6.LINE4
msgctxt "STRINGS.STAGEACTOR.ACT2_SCENE6.LINE4"
msgid "and found him cowering behind his throne."
msgstr "y lo encontró escondido tras su trono."

#. STRINGS.STAGEACTOR.ACT2_SCENE6.LINE5
msgctxt "STRINGS.STAGEACTOR.ACT2_SCENE6.LINE5"
msgid "Leave me be, monster!"
msgstr "¡Déjame en paz, monstruo!"

#. STRINGS.STAGEACTOR.ACT2_SCENE6.LINE6
msgctxt "STRINGS.STAGEACTOR.ACT2_SCENE6.LINE6"
msgid "I-I'm just a poor, frail old man!"
msgstr "¡Solo soy un pobre y frágil anciano!"

#. STRINGS.STAGEACTOR.ACT2_SCENE6.LINE7
msgctxt "STRINGS.STAGEACTOR.ACT2_SCENE6.LINE7"
msgid "Um... and my mother is sick,"
msgstr "Y... ¡Y mi madre está enferma"

#. STRINGS.STAGEACTOR.ACT2_SCENE6.LINE8
msgctxt "STRINGS.STAGEACTOR.ACT2_SCENE6.LINE8"
msgid "and I'm all she has to care for her!"
msgstr "y yo soy todo lo que tiene!"

#. STRINGS.STAGEACTOR.ACT2_SCENE6.LINE9
msgctxt "STRINGS.STAGEACTOR.ACT2_SCENE6.LINE9"
msgid "And... oh I know! I was just now planning"
msgstr "Y... ¡Ah, ya sé! Justo estaba planeando..."

#. STRINGS.STAGEACTOR.ACT3_SCENE7.LINE1
msgctxt "STRINGS.STAGEACTOR.ACT3_SCENE7.LINE1"
msgid "It's the Final Act!"
msgstr "¡Es el acto final!"

#. STRINGS.STAGEACTOR.ACT3_SCENE7.LINE10
msgctxt "STRINGS.STAGEACTOR.ACT3_SCENE7.LINE10"
msgid "the King's so glum upon his throne!"
msgstr "el rey está tan abatido sobre su trono!"

#. STRINGS.STAGEACTOR.ACT3_SCENE7.LINE11
msgctxt "STRINGS.STAGEACTOR.ACT3_SCENE7.LINE11"
msgid "Cheer-a-loo, cheer-a-lay,"
msgstr "¡Tralarí, tralará,"

#. STRINGS.STAGEACTOR.ACT3_SCENE7.LINE12
msgctxt "STRINGS.STAGEACTOR.ACT3_SCENE7.LINE12"
msgid "he's sent for fools, to watch us play!"
msgstr "hizo venir a los bufones para vernos actuar!"

#. STRINGS.STAGEACTOR.ACT3_SCENE7.LINE13
msgctxt "STRINGS.STAGEACTOR.ACT3_SCENE7.LINE13"
msgid "From far and wide he's called us there,"
msgstr "De todas partes, nos llamó a su lado,"

#. STRINGS.STAGEACTOR.ACT3_SCENE7.LINE14
msgctxt "STRINGS.STAGEACTOR.ACT3_SCENE7.LINE14"
msgid "we'll perform for the one who sits on the chair!"
msgstr "¡actuaremos para el que está en el trono sentado!"

#. STRINGS.STAGEACTOR.ACT3_SCENE7.LINE15
msgctxt "STRINGS.STAGEACTOR.ACT3_SCENE7.LINE15"
msgid "The King has grown bored, has he?"
msgstr "Así que el rey se aburre, ¿eh?"

#. STRINGS.STAGEACTOR.ACT3_SCENE7.LINE16
msgctxt "STRINGS.STAGEACTOR.ACT3_SCENE7.LINE16"
msgid "Perhaps he's grown careless as well."
msgstr "Puede que también haya bajado la guardia."

#. STRINGS.STAGEACTOR.ACT3_SCENE7.LINE17
msgctxt "STRINGS.STAGEACTOR.ACT3_SCENE7.LINE17"
msgid "If I follow these fools,"
msgstr "Si sigo a estos bufones,"

#. STRINGS.STAGEACTOR.ACT3_SCENE7.LINE18
msgctxt "STRINGS.STAGEACTOR.ACT3_SCENE7.LINE18"
msgid "they might lead me straight to him..."
msgstr "podrían llevarme hasta él..."

#. STRINGS.STAGEACTOR.ACT3_SCENE7.LINE19
msgctxt "STRINGS.STAGEACTOR.ACT3_SCENE7.LINE19"
msgid "How strange, I suddenly feel like I'm being shadowed."
msgstr "Qué raro, tengo la impresión de que me están siguiendo."

#. STRINGS.STAGEACTOR.ACT3_SCENE7.LINE2
msgctxt "STRINGS.STAGEACTOR.ACT3_SCENE7.LINE2"
msgid "Scene 1!"
msgstr "¡Escena 1!"

#. STRINGS.STAGEACTOR.ACT3_SCENE7.LINE20
msgctxt "STRINGS.STAGEACTOR.ACT3_SCENE7.LINE20"
msgid "It's probably nothing!"
msgstr "¡Seguro que no es nada!"

#. STRINGS.STAGEACTOR.ACT3_SCENE7.LINE3
msgctxt "STRINGS.STAGEACTOR.ACT3_SCENE7.LINE3"
msgid "So exciting!"
msgstr "¡Qué emocionante!"

#. STRINGS.STAGEACTOR.ACT3_SCENE7.LINE4
msgctxt "STRINGS.STAGEACTOR.ACT3_SCENE7.LINE4"
msgid "Almost done!"
msgstr "¡Casi listo!"

#. STRINGS.STAGEACTOR.ACT3_SCENE7.LINE5
msgctxt "STRINGS.STAGEACTOR.ACT3_SCENE7.LINE5"
msgid "The doll searched high and low,"
msgstr "La muñeca buscó por todas partes,"

#. STRINGS.STAGEACTOR.ACT3_SCENE7.LINE6
msgctxt "STRINGS.STAGEACTOR.ACT3_SCENE7.LINE6"
msgid "but as time went on,"
msgstr "pero, con el tiempo,"

#. STRINGS.STAGEACTOR.ACT3_SCENE7.LINE7
msgctxt "STRINGS.STAGEACTOR.ACT3_SCENE7.LINE7"
msgid "it seemed that the King had won."
msgstr "empezó a parecer que el rey había ganado."

#. STRINGS.STAGEACTOR.ACT3_SCENE7.LINE8
msgctxt "STRINGS.STAGEACTOR.ACT3_SCENE7.LINE8"
msgid "Until one day..."
msgstr "Hasta que, un día..."

#. STRINGS.STAGEACTOR.ACT3_SCENE7.LINE9
msgctxt "STRINGS.STAGEACTOR.ACT3_SCENE7.LINE9"
msgid "Cheer-a-lee, cheer-a-lone,"
msgstr "¡Tralarí, tralará,"

#. STRINGS.STAGEACTOR.ACT3_SCENE8.LINE1
msgctxt "STRINGS.STAGEACTOR.ACT3_SCENE8.LINE1"
msgid "Act 3!"
msgstr "¡Acto 3.º!"

#. STRINGS.STAGEACTOR.ACT3_SCENE8.LINE10
msgctxt "STRINGS.STAGEACTOR.ACT3_SCENE8.LINE10"
msgid "My King!"
msgstr "¡Mi rey!"

#. STRINGS.STAGEACTOR.ACT3_SCENE8.LINE11
msgctxt "STRINGS.STAGEACTOR.ACT3_SCENE8.LINE11"
msgid "Allow me to entertain you with my merry foolery!"
msgstr "¡Permitidme que os entretenga con mis bufonadas!"

#. STRINGS.STAGEACTOR.ACT3_SCENE8.LINE12
msgctxt "STRINGS.STAGEACTOR.ACT3_SCENE8.LINE12"
msgid "Whoops-!"
msgstr "¡Ups!"

#. STRINGS.STAGEACTOR.ACT3_SCENE8.LINE13
msgctxt "STRINGS.STAGEACTOR.ACT3_SCENE8.LINE13"
msgid "In their excitement,"
msgstr "Con la emoción,"

#. STRINGS.STAGEACTOR.ACT3_SCENE8.LINE14
msgctxt "STRINGS.STAGEACTOR.ACT3_SCENE8.LINE14"
msgid "the clumsy fool knocked the King from his throne."
msgstr "el torpe bufón tiró al rey de su trono."

#. STRINGS.STAGEACTOR.ACT3_SCENE8.LINE15
msgctxt "STRINGS.STAGEACTOR.ACT3_SCENE8.LINE15"
msgid "It seemed that the years"
msgstr "Parecía que los años"

#. STRINGS.STAGEACTOR.ACT3_SCENE8.LINE16
msgctxt "STRINGS.STAGEACTOR.ACT3_SCENE8.LINE16"
msgid "had not been kind to the King,"
msgstr "no habían tratado bien al rey,"

#. STRINGS.STAGEACTOR.ACT3_SCENE8.LINE17
msgctxt "STRINGS.STAGEACTOR.ACT3_SCENE8.LINE17"
msgid "for when he hit the floor,"
msgstr "pues, cuando llegó al suelo,"

#. STRINGS.STAGEACTOR.ACT3_SCENE8.LINE18
msgctxt "STRINGS.STAGEACTOR.ACT3_SCENE8.LINE18"
msgid "his frail body turned to dust."
msgstr "su decrépito cuerpo se convirtió en polvo."

#. STRINGS.STAGEACTOR.ACT3_SCENE8.LINE19
msgctxt "STRINGS.STAGEACTOR.ACT3_SCENE8.LINE19"
msgid "Nooooo!"
msgstr "¡Nooooo!"

#. STRINGS.STAGEACTOR.ACT3_SCENE8.LINE2
msgctxt "STRINGS.STAGEACTOR.ACT3_SCENE8.LINE2"
msgid "Scene 2!"
msgstr "¡Escena 2!"

#. STRINGS.STAGEACTOR.ACT3_SCENE8.LINE20
msgctxt "STRINGS.STAGEACTOR.ACT3_SCENE8.LINE20"
msgid "Oh... I suppose I'm the King now!"
msgstr "Ah... ¡Supongo que ahora yo soy el rey!"

#. STRINGS.STAGEACTOR.ACT3_SCENE8.LINE21
msgctxt "STRINGS.STAGEACTOR.ACT3_SCENE8.LINE21"
msgid "There's been a fool on the throne long enough."
msgstr "Ya hemos tenido bastante con un bufón en el trono."

#. STRINGS.STAGEACTOR.ACT3_SCENE8.LINE22
msgctxt "STRINGS.STAGEACTOR.ACT3_SCENE8.LINE22"
msgid "perhaps what this kingdom needs..."
msgstr "Puede que lo que el reino necesite..."

#. STRINGS.STAGEACTOR.ACT3_SCENE8.LINE23
msgctxt "STRINGS.STAGEACTOR.ACT3_SCENE8.LINE23"
msgid "is a Queen."
msgstr "sea una reina."

#. STRINGS.STAGEACTOR.ACT3_SCENE8.LINE24
msgctxt "STRINGS.STAGEACTOR.ACT3_SCENE8.LINE24"
msgid "The special effects are getting better."
msgstr "Los efectos especiales son cada vez mejores."

#. STRINGS.STAGEACTOR.ACT3_SCENE8.LINE25
msgctxt "STRINGS.STAGEACTOR.ACT3_SCENE8.LINE25"
msgid "Wish I could say the same for the actors."
msgstr "Ojalá poder decir lo mismo de los actores."

#. STRINGS.STAGEACTOR.ACT3_SCENE8.LINE26
msgctxt "STRINGS.STAGEACTOR.ACT3_SCENE8.LINE26"
msgid "HA HA HA HA HA!"
msgstr "¡JA, JA, JA!"

#. STRINGS.STAGEACTOR.ACT3_SCENE8.LINE27
msgctxt "STRINGS.STAGEACTOR.ACT3_SCENE8.LINE27"
msgid "Another flawless performance from the tree."
msgstr "Otra actuación magistral por parte del árbol."

#. STRINGS.STAGEACTOR.ACT3_SCENE8.LINE28
msgctxt "STRINGS.STAGEACTOR.ACT3_SCENE8.LINE28"
msgid "How do they do it?!"
msgstr "¡¿Cómo lo hará?!"

#. STRINGS.STAGEACTOR.ACT3_SCENE8.LINE29
msgctxt "STRINGS.STAGEACTOR.ACT3_SCENE8.LINE29"
msgid "Fool!"
msgstr "¡Bufón!"

#. STRINGS.STAGEACTOR.ACT3_SCENE8.LINE3
msgctxt "STRINGS.STAGEACTOR.ACT3_SCENE8.LINE3"
msgid "Though the journey was long,"
msgstr "Aunque el viaje fue largo,"

#. STRINGS.STAGEACTOR.ACT3_SCENE8.LINE4
msgctxt "STRINGS.STAGEACTOR.ACT3_SCENE8.LINE4"
msgid "it was just as the doll had predicted."
msgstr "al final todo salió como la muñeca esperaba."

#. STRINGS.STAGEACTOR.ACT3_SCENE8.LINE5
msgctxt "STRINGS.STAGEACTOR.ACT3_SCENE8.LINE5"
msgid "The doll followed the fool"
msgstr "La muñeca siguió al bufón"

#. STRINGS.STAGEACTOR.ACT3_SCENE8.LINE6
msgctxt "STRINGS.STAGEACTOR.ACT3_SCENE8.LINE6"
msgid "all the way to the King's throne room,"
msgstr "hasta la sala del trono del rey,"

#. STRINGS.STAGEACTOR.ACT3_SCENE8.LINE7
msgctxt "STRINGS.STAGEACTOR.ACT3_SCENE8.LINE7"
msgid "careful to keep out of sight."
msgstr "siempre con cuidado de que no la viesen."

#. STRINGS.STAGEACTOR.ACT3_SCENE8.LINE8
msgctxt "STRINGS.STAGEACTOR.ACT3_SCENE8.LINE8"
msgid "It took you long enough!"
msgstr "¡Ya era hora!"

#. STRINGS.STAGEACTOR.ACT3_SCENE8.LINE9
msgctxt "STRINGS.STAGEACTOR.ACT3_SCENE8.LINE9"
msgid "I'd grown weary of waiting."
msgstr "Estoy cansado de esperar."

#. STRINGS.STAGEACTOR.ACT3_SCENE9.LINE1
msgctxt "STRINGS.STAGEACTOR.ACT3_SCENE9.LINE1"
msgid "The final scene!"
msgstr "¡La escena final!"

#. STRINGS.STAGEACTOR.ACT3_SCENE9.LINE10
msgctxt "STRINGS.STAGEACTOR.ACT3_SCENE9.LINE10"
msgid "I cannot yet be restored."
msgstr "Todavía no puedo recuperarme."

#. STRINGS.STAGEACTOR.ACT3_SCENE9.LINE11
msgctxt "STRINGS.STAGEACTOR.ACT3_SCENE9.LINE11"
msgid "I made you a promise, mirror,"
msgstr "Te hice una promesa, espejo,"

#. STRINGS.STAGEACTOR.ACT3_SCENE9.LINE12
msgctxt "STRINGS.STAGEACTOR.ACT3_SCENE9.LINE12"
msgid "and I will see it through."
msgstr "y me aseguraré de cumplirla."

#. STRINGS.STAGEACTOR.ACT3_SCENE9.LINE13
msgctxt "STRINGS.STAGEACTOR.ACT3_SCENE9.LINE13"
msgid "I will find the power to fix you,"
msgstr "Encontraré el poder para arreglarte"

#. STRINGS.STAGEACTOR.ACT3_SCENE9.LINE14
msgctxt "STRINGS.STAGEACTOR.ACT3_SCENE9.LINE14"
msgid "and repay you for all you've given me."
msgstr "y te compensaré por todo lo que me has dado."

#. STRINGS.STAGEACTOR.ACT3_SCENE9.LINE15
msgctxt "STRINGS.STAGEACTOR.ACT3_SCENE9.LINE15"
msgid "And so,"
msgstr "Y así,"

#. STRINGS.STAGEACTOR.ACT3_SCENE9.LINE16
msgctxt "STRINGS.STAGEACTOR.ACT3_SCENE9.LINE16"
msgid "with the treacherous King gone and forgotten,"
msgstr "con el malvado rey muerto y olvidado,"

#. STRINGS.STAGEACTOR.ACT3_SCENE9.LINE17
msgctxt "STRINGS.STAGEACTOR.ACT3_SCENE9.LINE17"
msgid "the little doll became a just and formidable Queen."
msgstr "la muñequita se convirtió en una reina justa y extraordinaria."

#. STRINGS.STAGEACTOR.ACT3_SCENE9.LINE18
msgctxt "STRINGS.STAGEACTOR.ACT3_SCENE9.LINE18"
msgid "The people rejoiced across the land,"
msgstr "Sus gentes lo celebraron"

#. STRINGS.STAGEACTOR.ACT3_SCENE9.LINE19
msgctxt "STRINGS.STAGEACTOR.ACT3_SCENE9.LINE19"
msgid "and the magic mirror knew"
msgstr "y el espejo mágico supo"

#. STRINGS.STAGEACTOR.ACT3_SCENE9.LINE2
msgctxt "STRINGS.STAGEACTOR.ACT3_SCENE9.LINE2"
msgid "Of the final act!"
msgstr "¡El acto final!"

#. STRINGS.STAGEACTOR.ACT3_SCENE9.LINE20
msgctxt "STRINGS.STAGEACTOR.ACT3_SCENE9.LINE20"
msgid "they had finally found the one who would set Them free."
msgstr "que por fin habían encontrado a su libertadora."

#. STRINGS.STAGEACTOR.ACT3_SCENE9.LINE21
msgctxt "STRINGS.STAGEACTOR.ACT3_SCENE9.LINE21"
msgid "I love a happy ending."
msgstr "Me encantan los finales felices."

#. STRINGS.STAGEACTOR.ACT3_SCENE9.LINE22
msgctxt "STRINGS.STAGEACTOR.ACT3_SCENE9.LINE22"
msgid "I'm just happy it ended."
msgstr "A mí me hace feliz que se haya acabado."

#. STRINGS.STAGEACTOR.ACT3_SCENE9.LINE23
msgctxt "STRINGS.STAGEACTOR.ACT3_SCENE9.LINE23"
msgid "HA HA HA HA HA!"
msgstr "¡JA, JA, JA!"

#. STRINGS.STAGEACTOR.ACT3_SCENE9.LINE3
msgctxt "STRINGS.STAGEACTOR.ACT3_SCENE9.LINE3"
msgid "Finally!"
msgstr "¡Por fin!"

#. STRINGS.STAGEACTOR.ACT3_SCENE9.LINE4
msgctxt "STRINGS.STAGEACTOR.ACT3_SCENE9.LINE4"
msgid "It is as you said, mirror."
msgstr "Fue tal y como dijiste, espejo."

#. STRINGS.STAGEACTOR.ACT3_SCENE9.LINE5
msgctxt "STRINGS.STAGEACTOR.ACT3_SCENE9.LINE5"
msgid "I've become so much more than I ever dreamed..."
msgstr "He llegado mucho más lejos de lo que jamás habría soñado..."

#. STRINGS.STAGEACTOR.ACT3_SCENE9.LINE6
msgctxt "STRINGS.STAGEACTOR.ACT3_SCENE9.LINE6"
msgid "but why do you remain broken?"
msgstr "pero ¿por qué sigues roto?"

#. STRINGS.STAGEACTOR.ACT3_SCENE9.LINE7
msgctxt "STRINGS.STAGEACTOR.ACT3_SCENE9.LINE7"
msgid "Alas,"
msgstr "Por desgracia,"

#. STRINGS.STAGEACTOR.ACT3_SCENE9.LINE8
msgctxt "STRINGS.STAGEACTOR.ACT3_SCENE9.LINE8"
msgid "I was shattered long before I met your King."
msgstr "mi ruptura tuvo lugar mucho antes de conocer a tu rey."

#. STRINGS.STAGEACTOR.ACT3_SCENE9.LINE9
msgctxt "STRINGS.STAGEACTOR.ACT3_SCENE9.LINE9"
msgid "Even with his power,"
msgstr "Ni siquiera su poder,"

#. STRINGS.STAGEACTOR.ARTIFICER_SOLILOQUY.1
msgctxt "STRINGS.STAGEACTOR.ARTIFICER_SOLILOQUY.1"
msgid "The Artificer!"
msgstr "¡El Artífice!"

#. STRINGS.STAGEACTOR.ARTIFICER_SOLILOQUY.10
msgctxt "STRINGS.STAGEACTOR.ARTIFICER_SOLILOQUY.10"
msgid "Even if I see this impossible design through,"
msgstr "Aunque consiga terminar este diseño imposible,"

#. STRINGS.STAGEACTOR.ARTIFICER_SOLILOQUY.11
msgctxt "STRINGS.STAGEACTOR.ARTIFICER_SOLILOQUY.11"
msgid "I doubt I shall ever leave this place."
msgstr "dudo que pueda salir de este lugar."

#. STRINGS.STAGEACTOR.ARTIFICER_SOLILOQUY.12
msgctxt "STRINGS.STAGEACTOR.ARTIFICER_SOLILOQUY.12"
msgid "I only pray my brood be granted a chance to survive,"
msgstr "Solo rezo para que mi colonia sobreviva,"

#. STRINGS.STAGEACTOR.ARTIFICER_SOLILOQUY.13
msgctxt "STRINGS.STAGEACTOR.ARTIFICER_SOLILOQUY.13"
msgid "safe from the Other,"
msgstr "a salvo del Otro,"

#. STRINGS.STAGEACTOR.ARTIFICER_SOLILOQUY.14
msgctxt "STRINGS.STAGEACTOR.ARTIFICER_SOLILOQUY.14"
msgid "by what we've wrought here."
msgstr "con lo que hemos creado aquí."

#. STRINGS.STAGEACTOR.ARTIFICER_SOLILOQUY.15
msgctxt "STRINGS.STAGEACTOR.ARTIFICER_SOLILOQUY.15"
msgid "That small hope is all that drives me"
msgstr "Esa pequeña esperanza es lo único que tengo"

#. STRINGS.STAGEACTOR.ARTIFICER_SOLILOQUY.16
msgctxt "STRINGS.STAGEACTOR.ARTIFICER_SOLILOQUY.16"
msgid "through these dark times."
msgstr "para superar estos tiempos oscuros."

#. STRINGS.STAGEACTOR.ARTIFICER_SOLILOQUY.17
msgctxt "STRINGS.STAGEACTOR.ARTIFICER_SOLILOQUY.17"
msgid "So did his brood survive after all that?"
msgstr "¿Y su colonia consiguió sobrevivir?"

#. STRINGS.STAGEACTOR.ARTIFICER_SOLILOQUY.18
msgctxt "STRINGS.STAGEACTOR.ARTIFICER_SOLILOQUY.18"
msgid "Nope."
msgstr "No."

#. STRINGS.STAGEACTOR.ARTIFICER_SOLILOQUY.19
msgctxt "STRINGS.STAGEACTOR.ARTIFICER_SOLILOQUY.19"
msgid "HA HA HA HA HA!"
msgstr "¡JA, JA, JA!"

#. STRINGS.STAGEACTOR.ARTIFICER_SOLILOQUY.2
msgctxt "STRINGS.STAGEACTOR.ARTIFICER_SOLILOQUY.2"
msgid "You mean the one that did all the work?"
msgstr "¿Te refieres al que hizo todo el trabajo?"

#. STRINGS.STAGEACTOR.ARTIFICER_SOLILOQUY.3
msgctxt "STRINGS.STAGEACTOR.ARTIFICER_SOLILOQUY.3"
msgid "Yeah..."
msgstr "Sí..."

#. STRINGS.STAGEACTOR.ARTIFICER_SOLILOQUY.4
msgctxt "STRINGS.STAGEACTOR.ARTIFICER_SOLILOQUY.4"
msgid "What a sucker!"
msgstr "¡Menudo perdedor!"

#. STRINGS.STAGEACTOR.ARTIFICER_SOLILOQUY.5
msgctxt "STRINGS.STAGEACTOR.ARTIFICER_SOLILOQUY.5"
msgid "HA HA HA HA HA!"
msgstr "¡JA, JA, JA!"

#. STRINGS.STAGEACTOR.ARTIFICER_SOLILOQUY.6
msgctxt "STRINGS.STAGEACTOR.ARTIFICER_SOLILOQUY.6"
msgid "How many lifetimes would it take"
msgstr "¿Cuántas vidas se necesitarían"

#. STRINGS.STAGEACTOR.ARTIFICER_SOLILOQUY.7
msgctxt "STRINGS.STAGEACTOR.ARTIFICER_SOLILOQUY.7"
msgid "to hew such a structure,"
msgstr "para construir tal estructura,"

#. STRINGS.STAGEACTOR.ARTIFICER_SOLILOQUY.8
msgctxt "STRINGS.STAGEACTOR.ARTIFICER_SOLILOQUY.8"
msgid "even with my mastery?"
msgstr "incluso para alguien de mi talento?"

#. STRINGS.STAGEACTOR.ARTIFICER_SOLILOQUY.9
msgctxt "STRINGS.STAGEACTOR.ARTIFICER_SOLILOQUY.9"
msgid "The Shieldbearer keeps much to her thorax."
msgstr "La escudera se guarda muchas cosas en el tórax."

#. STRINGS.STAGEACTOR.BAD_COSTUMES.1
msgctxt "STRINGS.STAGEACTOR.BAD_COSTUMES.1"
msgid "Something's wrong!"
msgstr "¡Algo va mal!"

#. STRINGS.STAGEACTOR.BAD_COSTUMES.2
msgctxt "STRINGS.STAGEACTOR.BAD_COSTUMES.2"
msgid "Check your costumes!"
msgstr "¡Vuestros disfraces!"

#. STRINGS.STAGEACTOR.BAD_COSTUMES.3
msgctxt "STRINGS.STAGEACTOR.BAD_COSTUMES.3"
msgid "We'll come back."
msgstr "Volveremos."

#. STRINGS.STAGEACTOR.BAD_COSTUMES.4
msgctxt "STRINGS.STAGEACTOR.BAD_COSTUMES.4"
msgid "When you get it right!"
msgstr "¡Cuándo lo hagáis bien!"

#. STRINGS.STAGEACTOR.BLACKSMITH_SOLILOQUY.1
msgctxt "STRINGS.STAGEACTOR.BLACKSMITH_SOLILOQUY.1"
msgid "\"The Blacksmith's Soliloquy\""
msgstr "\"El soliloquio de la herrera\""

#. STRINGS.STAGEACTOR.BLACKSMITH_SOLILOQUY.2
msgctxt "STRINGS.STAGEACTOR.BLACKSMITH_SOLILOQUY.2"
msgid "Forging on ahead."
msgstr "Forjando sin cesar."

#. STRINGS.STAGEACTOR.BLACKSMITH_SOLILOQUY.3
msgctxt "STRINGS.STAGEACTOR.BLACKSMITH_SOLILOQUY.3"
msgid "Oh little doll, little doll!"
msgstr "¡Oh, muñeca, muñeca!"

#. STRINGS.STAGEACTOR.BLACKSMITH_SOLILOQUY.4
msgctxt "STRINGS.STAGEACTOR.BLACKSMITH_SOLILOQUY.4"
msgid "Where have you gone?"
msgstr "¿A dónde has ido a parar?"

#. STRINGS.STAGEACTOR.BLACKSMITH_SOLILOQUY.5
msgctxt "STRINGS.STAGEACTOR.BLACKSMITH_SOLILOQUY.5"
msgid "It's not safe for you out there"
msgstr "¡No es seguro para una muñeca"

#. STRINGS.STAGEACTOR.BLACKSMITH_SOLILOQUY.6
msgctxt "STRINGS.STAGEACTOR.BLACKSMITH_SOLILOQUY.6"
msgid "in the big wide world!"
msgstr "sola por el mundo andar!"

#. STRINGS.STAGEACTOR.BLACKSMITH_SOLILOQUY.7
msgctxt "STRINGS.STAGEACTOR.BLACKSMITH_SOLILOQUY.7"
msgid "If it ain't broke..."
msgstr "Si no está roto..."

#. STRINGS.STAGEACTOR.BLACKSMITH_SOLILOQUY.8
msgctxt "STRINGS.STAGEACTOR.BLACKSMITH_SOLILOQUY.8"
msgid "She'll still try to fix it."
msgstr "Seguirá intentando arreglarlo."

#. STRINGS.STAGEACTOR.ELYTRA_SOLILOQUY.1
msgctxt "STRINGS.STAGEACTOR.ELYTRA_SOLILOQUY.1"
msgid "Please welcome, Elytra!"
msgstr "¡Demos la bienvenida a Elytra!"

#. STRINGS.STAGEACTOR.ELYTRA_SOLILOQUY.10
msgctxt "STRINGS.STAGEACTOR.ELYTRA_SOLILOQUY.10"
msgid "To Thee, Metheus, my Queen,"
msgstr "Y vos, Meteo, mi reina,"

#. STRINGS.STAGEACTOR.ELYTRA_SOLILOQUY.11
msgctxt "STRINGS.STAGEACTOR.ELYTRA_SOLILOQUY.11"
msgid "my heart is riven to know I have failed Thee."
msgstr "mi corazón languidece sabiendo que os he fallado."

#. STRINGS.STAGEACTOR.ELYTRA_SOLILOQUY.12
msgctxt "STRINGS.STAGEACTOR.ELYTRA_SOLILOQUY.12"
msgid "Cast Thy curse upon me,"
msgstr "Lanzadme vuestra maldición,"

#. STRINGS.STAGEACTOR.ELYTRA_SOLILOQUY.13
msgctxt "STRINGS.STAGEACTOR.ELYTRA_SOLILOQUY.13"
msgid "that I may bear an eternity of sorrow."
msgstr "hacedme sufrir una eternidad de pesares."

#. STRINGS.STAGEACTOR.ELYTRA_SOLILOQUY.14
msgctxt "STRINGS.STAGEACTOR.ELYTRA_SOLILOQUY.14"
msgid "How much more sorrow is left for her to bear?"
msgstr "¿Cuánto más tendrá que aguantar?"

#. STRINGS.STAGEACTOR.ELYTRA_SOLILOQUY.15
msgctxt "STRINGS.STAGEACTOR.ELYTRA_SOLILOQUY.15"
msgid "Let's see... it's been a while now, so an eternity more?"
msgstr "A ver... Ya hace bastante tiempo, así que ¿otra eternidad?"

#. STRINGS.STAGEACTOR.ELYTRA_SOLILOQUY.16
msgctxt "STRINGS.STAGEACTOR.ELYTRA_SOLILOQUY.16"
msgid "HA HA HA HA HA!"
msgstr "¡JA, JA, JA!"

#. STRINGS.STAGEACTOR.ELYTRA_SOLILOQUY.2
msgctxt "STRINGS.STAGEACTOR.ELYTRA_SOLILOQUY.2"
msgid "Did you hear what They say about her performance?"
msgstr "¿Has oído lo que dicen sobre su actuación?"

#. STRINGS.STAGEACTOR.ELYTRA_SOLILOQUY.3
msgctxt "STRINGS.STAGEACTOR.ELYTRA_SOLILOQUY.3"
msgid "Yeah! She killed!"
msgstr "¡Sí! ¡Que ha arrasado!"

#. STRINGS.STAGEACTOR.ELYTRA_SOLILOQUY.4
msgctxt "STRINGS.STAGEACTOR.ELYTRA_SOLILOQUY.4"
msgid "HA HA HA HA HA!"
msgstr "¡JA, JA, JA!"

#. STRINGS.STAGEACTOR.ELYTRA_SOLILOQUY.5
msgctxt "STRINGS.STAGEACTOR.ELYTRA_SOLILOQUY.5"
msgid "If these words reach thine ears, foolhardy explorer,"
msgstr "Si estas palabras llegan a tus oídos, tú que exploras sin temor,"

#. STRINGS.STAGEACTOR.ELYTRA_SOLILOQUY.6
msgctxt "STRINGS.STAGEACTOR.ELYTRA_SOLILOQUY.6"
msgid "then all our labors have been for naught."
msgstr "nuestros esfuerzos habrán sido en vano."

#. STRINGS.STAGEACTOR.ELYTRA_SOLILOQUY.7
msgctxt "STRINGS.STAGEACTOR.ELYTRA_SOLILOQUY.7"
msgid "Mercy upon those already consumed,"
msgstr "Piedad para los que ya se han consumido,"

#. STRINGS.STAGEACTOR.ELYTRA_SOLILOQUY.8
msgctxt "STRINGS.STAGEACTOR.ELYTRA_SOLILOQUY.8"
msgid "and upon those yet to be taken by the Other."
msgstr "y para los que están a punto de caer ante el Otro."

#. STRINGS.STAGEACTOR.ELYTRA_SOLILOQUY.9
msgctxt "STRINGS.STAGEACTOR.ELYTRA_SOLILOQUY.9"
msgid "..."
msgstr "..."

#. STRINGS.STAGEACTOR.FOOL_SOLILOQUY.1
msgctxt "STRINGS.STAGEACTOR.FOOL_SOLILOQUY.1"
msgid "\"The Fool's Soliloquy\""
msgstr "\"El soliloquio del bufón\""

#. STRINGS.STAGEACTOR.FOOL_SOLILOQUY.2
msgctxt "STRINGS.STAGEACTOR.FOOL_SOLILOQUY.2"
msgid "Who do they think they're fooling?"
msgstr "¿Nos toman por idiotas?"

#. STRINGS.STAGEACTOR.FOOL_SOLILOQUY.3
msgctxt "STRINGS.STAGEACTOR.FOOL_SOLILOQUY.3"
msgid "Once I acted as I thought I should,"
msgstr "Solía hacer lo que creía correcto,"

#. STRINGS.STAGEACTOR.FOOL_SOLILOQUY.4
msgctxt "STRINGS.STAGEACTOR.FOOL_SOLILOQUY.4"
msgid "I followed all the rules."
msgstr "todas las reglas cumpliendo."

#. STRINGS.STAGEACTOR.FOOL_SOLILOQUY.5
msgctxt "STRINGS.STAGEACTOR.FOOL_SOLILOQUY.5"
msgid "But soon I found out life's a game,"
msgstr "No tardé en descubrir que la vida es un juego"

#. STRINGS.STAGEACTOR.FOOL_SOLILOQUY.6
msgctxt "STRINGS.STAGEACTOR.FOOL_SOLILOQUY.6"
msgid "and I have played the fool!"
msgstr "y a mí me había tocado el papel del majadero."

#. STRINGS.STAGEACTOR.FOOL_SOLILOQUY.7
msgctxt "STRINGS.STAGEACTOR.FOOL_SOLILOQUY.7"
msgid "My head hurts."
msgstr "Me duele la cabeza."

#. STRINGS.STAGEACTOR.FOOL_SOLILOQUY.8
msgctxt "STRINGS.STAGEACTOR.FOOL_SOLILOQUY.8"
msgid "Listening to a fool will do that."
msgstr "Suele pasar cuando se escucha a un bufón."

#. STRINGS.STAGEACTOR.HALFWIT_SOLILOQUY.1
msgctxt "STRINGS.STAGEACTOR.HALFWIT_SOLILOQUY.1"
msgid "Hath ye seen me chums?"
msgstr "¿Habéis visto a mis colegas?"

#. STRINGS.STAGEACTOR.HALFWIT_SOLILOQUY.2
msgctxt "STRINGS.STAGEACTOR.HALFWIT_SOLILOQUY.2"
msgid "We came as three."
msgstr "Éramos tres."

#. STRINGS.STAGEACTOR.HALFWIT_SOLILOQUY.3
msgctxt "STRINGS.STAGEACTOR.HALFWIT_SOLILOQUY.3"
msgid "Now 'tis just me."
msgstr "Pero ahora lo que hay es lo que veis."

#. STRINGS.STAGEACTOR.HALFWIT_SOLILOQUY.4
msgctxt "STRINGS.STAGEACTOR.HALFWIT_SOLILOQUY.4"
msgid "Hath ye seen me chums?"
msgstr "¿Habéis visto a mis colegas?"

#. STRINGS.STAGEACTOR.KING_SOLILOQUY.1
msgctxt "STRINGS.STAGEACTOR.KING_SOLILOQUY.1"
msgid "\"The King's Soliloquy\""
msgstr "\"El soliloquio del rey\""

#. STRINGS.STAGEACTOR.KING_SOLILOQUY.2
msgctxt "STRINGS.STAGEACTOR.KING_SOLILOQUY.2"
msgid "He's King for now, anyway."
msgstr "Es rey, pero solo por ahora."

#. STRINGS.STAGEACTOR.KING_SOLILOQUY.3
msgctxt "STRINGS.STAGEACTOR.KING_SOLILOQUY.3"
msgid "How different might things have been,"
msgstr "¿Qué habría sido de mí,"

#. STRINGS.STAGEACTOR.KING_SOLILOQUY.4
msgctxt "STRINGS.STAGEACTOR.KING_SOLILOQUY.4"
msgid "if I never sought the crown?"
msgstr "si la corona no hubiese codiciado?"

#. STRINGS.STAGEACTOR.KING_SOLILOQUY.5
msgctxt "STRINGS.STAGEACTOR.KING_SOLILOQUY.5"
msgid "I suppose the world would be a bit brighter."
msgstr "Supongo que el mundo sería un poco mejor."

#. STRINGS.STAGEACTOR.KING_SOLILOQUY.6
msgctxt "STRINGS.STAGEACTOR.KING_SOLILOQUY.6"
msgid "What a terrible thought indeed."
msgstr "Qué pensamiento tan desquiciado."

#. STRINGS.STAGEACTOR.KING_SOLILOQUY.7
msgctxt "STRINGS.STAGEACTOR.KING_SOLILOQUY.7"
msgid "Heavy is the head who wears the crown."
msgstr "Pesada es la carga de la cabeza que lleva la corona."

#. STRINGS.STAGEACTOR.KING_SOLILOQUY.8
msgctxt "STRINGS.STAGEACTOR.KING_SOLILOQUY.8"
msgid "His head is bigger than most."
msgstr "Su cabeza es más grande que la de la mayoría."

#. STRINGS.STAGEACTOR.KNIGHT_SOLILOQUY.BIRD1_1
msgctxt "STRINGS.STAGEACTOR.KNIGHT_SOLILOQUY.BIRD1_1"
msgid "Tell us a joke!"
msgstr "¡Cuéntanos un chiste!"

#. STRINGS.STAGEACTOR.KNIGHT_SOLILOQUY.BIRD1_3
msgctxt "STRINGS.STAGEACTOR.KNIGHT_SOLILOQUY.BIRD1_3"
msgid "Quit stall-in!"
msgstr "¡Déjate de rodeos!"

#. STRINGS.STAGEACTOR.KNIGHT_SOLILOQUY.BIRD1_6
msgctxt "STRINGS.STAGEACTOR.KNIGHT_SOLILOQUY.BIRD1_6"
msgid "What a foal!"
msgstr "¡Serás burro!"

#. STRINGS.STAGEACTOR.KNIGHT_SOLILOQUY.BIRD2_2
msgctxt "STRINGS.STAGEACTOR.KNIGHT_SOLILOQUY.BIRD2_2"
msgid "Straight from the horse's mouth!"
msgstr "¡De los dientes del caballo!"

#. STRINGS.STAGEACTOR.KNIGHT_SOLILOQUY.BIRD2_4
msgctxt "STRINGS.STAGEACTOR.KNIGHT_SOLILOQUY.BIRD2_4"
msgid "Feeling a little horse?"
msgstr "¿Cansado como una mula?"

#. STRINGS.STAGEACTOR.KNIGHT_SOLILOQUY.BIRD2_5
msgctxt "STRINGS.STAGEACTOR.KNIGHT_SOLILOQUY.BIRD2_5"
msgid "So much for a mane attraction!"
msgstr "¡Pues vaya con la crin de la crin!"

#. STRINGS.STAGEACTOR.KNIGHT_SOLILOQUY.BIRD_7
msgctxt "STRINGS.STAGEACTOR.KNIGHT_SOLILOQUY.BIRD_7"
msgid "HA HA HA HA HA!"
msgstr "¡JA, JA, JA!"

#. STRINGS.STAGEACTOR.KNIGHT_SOLILOQUY.LINE1_KNIGHT
msgctxt "STRINGS.STAGEACTOR.KNIGHT_SOLILOQUY.LINE1_KNIGHT"
msgid "..."
msgstr "..."

#. STRINGS.STAGEACTOR.KNIGHT_SOLILOQUY.LINE2_KNIGHT
msgctxt "STRINGS.STAGEACTOR.KNIGHT_SOLILOQUY.LINE2_KNIGHT"
msgid "..."
msgstr "..."

#. STRINGS.STAGEACTOR.NO_SCRIPT.1
msgctxt "STRINGS.STAGEACTOR.NO_SCRIPT.1"
msgid "Something's off."
msgstr "Algo va mal."

#. STRINGS.STAGEACTOR.NO_SCRIPT.2
msgctxt "STRINGS.STAGEACTOR.NO_SCRIPT.2"
msgid "They're going off-script!"
msgstr "¡Se están saltando el guion!"

#. STRINGS.STAGEACTOR.NO_SCRIPT.3
msgctxt "STRINGS.STAGEACTOR.NO_SCRIPT.3"
msgid "I didn't come for improv!"
msgstr "¡No he venido a ver improvisar a nadie!"

#. STRINGS.STAGEACTOR.NO_SCRIPT.4
msgctxt "STRINGS.STAGEACTOR.NO_SCRIPT.4"
msgid "We're out."
msgstr "Nos vamos."

#. STRINGS.STAGEACTOR.PRINCESS_SOLILOQUY.BIRD1_1
msgctxt "STRINGS.STAGEACTOR.PRINCESS_SOLILOQUY.BIRD1_1"
msgid "Who's that?"
msgstr "¿Quién es esa?"

#. STRINGS.STAGEACTOR.PRINCESS_SOLILOQUY.BIRD1_3
msgctxt "STRINGS.STAGEACTOR.PRINCESS_SOLILOQUY.BIRD1_3"
msgid "A queen? More like a spoiled princess!"
msgstr "Más bien rocinante."

#. STRINGS.STAGEACTOR.PRINCESS_SOLILOQUY.BIRD1_5
msgctxt "STRINGS.STAGEACTOR.PRINCESS_SOLILOQUY.BIRD1_5"
msgid "Relax, princess. They'll be here soon."
msgstr "Tranquila, princesa. No tardarán."

#. STRINGS.STAGEACTOR.PRINCESS_SOLILOQUY.BIRD2_2
msgctxt "STRINGS.STAGEACTOR.PRINCESS_SOLILOQUY.BIRD2_2"
msgid "She looks... equine."
msgstr "Una princesa digna de un caballero andante."

#. STRINGS.STAGEACTOR.PRINCESS_SOLILOQUY.BIRD2_6
msgctxt "STRINGS.STAGEACTOR.PRINCESS_SOLILOQUY.BIRD2_6"
msgid "Yeah, hold your horses!"
msgstr "¡Sí, para el carro!"

#. STRINGS.STAGEACTOR.PRINCESS_SOLILOQUY.BIRD_4
msgctxt "STRINGS.STAGEACTOR.PRINCESS_SOLILOQUY.BIRD_4"
msgid "HA HA HA HA HA!"
msgstr "¡JA, JA, JA!"

#. STRINGS.STAGEACTOR.PRINCESS_SOLILOQUY.BIRD_7
msgctxt "STRINGS.STAGEACTOR.PRINCESS_SOLILOQUY.BIRD_7"
msgid "HA HA HA HA HA!"
msgstr "¡JA, JA, JA!"

#. STRINGS.STAGEACTOR.PRINCESS_SOLILOQUY.LINE10_PRINCESS
msgctxt "STRINGS.STAGEACTOR.PRINCESS_SOLILOQUY.LINE10_PRINCESS"
msgid "Turn thy thoughts to those in need!"
msgstr "¡Pensad en los necesitados!"

#. STRINGS.STAGEACTOR.PRINCESS_SOLILOQUY.LINE11_PRINCESS
msgctxt "STRINGS.STAGEACTOR.PRINCESS_SOLILOQUY.LINE11_PRINCESS"
msgid "Yet I fret not o'er thee, Desdemona,"
msgstr "Mas no me preocupo por vos, Mortimer,"

#. STRINGS.STAGEACTOR.PRINCESS_SOLILOQUY.LINE12_PRINCESS
msgctxt "STRINGS.STAGEACTOR.PRINCESS_SOLILOQUY.LINE12_PRINCESS"
msgid "for I know thou art ever bound to come."
msgstr "pues sé que jamás ignoraríais mi llamada."

#. STRINGS.STAGEACTOR.PRINCESS_SOLILOQUY.LINE13_PRINCESS
msgctxt "STRINGS.STAGEACTOR.PRINCESS_SOLILOQUY.LINE13_PRINCESS"
msgid "And upon thy back,"
msgstr "¡Y sobre vuestra grupa,"

#. STRINGS.STAGEACTOR.PRINCESS_SOLILOQUY.LINE14_PRINCESS
msgctxt "STRINGS.STAGEACTOR.PRINCESS_SOLILOQUY.LINE14_PRINCESS"
msgid "shall we all return unto our hearth!"
msgstr "regresaremos a nuestro hogar!"

#. STRINGS.STAGEACTOR.PRINCESS_SOLILOQUY.LINE15_PRINCESS
msgctxt "STRINGS.STAGEACTOR.PRINCESS_SOLILOQUY.LINE15_PRINCESS"
msgid "Thus you see,"
msgstr "Pues ya lo veis,"

#. STRINGS.STAGEACTOR.PRINCESS_SOLILOQUY.LINE16_PRINCESS
msgctxt "STRINGS.STAGEACTOR.PRINCESS_SOLILOQUY.LINE16_PRINCESS"
msgid "much is to be done,"
msgstr "nos queda mucho por hacer,"

#. STRINGS.STAGEACTOR.PRINCESS_SOLILOQUY.LINE17_PRINCESS
msgctxt "STRINGS.STAGEACTOR.PRINCESS_SOLILOQUY.LINE17_PRINCESS"
msgid "by my Four Knights and me."
msgstr "a mis cuatro caballos y a mí."

#. STRINGS.STAGEACTOR.PRINCESS_SOLILOQUY.LINE1_PRINCESS
msgctxt "STRINGS.STAGEACTOR.PRINCESS_SOLILOQUY.LINE1_PRINCESS"
msgid "Where, prithee, is my entourage?"
msgstr "Decidme, os lo ruego, ¿qué ha sido de mi séquito?"

#. STRINGS.STAGEACTOR.PRINCESS_SOLILOQUY.LINE2_PRINCESS
msgctxt "STRINGS.STAGEACTOR.PRINCESS_SOLILOQUY.LINE2_PRINCESS"
msgid "My loyal escorts? My Knights in gilded armor?"
msgstr "¿Mis leales escoltas? ¿Mis caballeros de brillante armadura?"

#. STRINGS.STAGEACTOR.PRINCESS_SOLILOQUY.LINE3_PRINCESS
msgctxt "STRINGS.STAGEACTOR.PRINCESS_SOLILOQUY.LINE3_PRINCESS"
msgid "Must I venture alone upon these lands"
msgstr "¿Acaso debo adentrarme sola en estas tierras,"

#. STRINGS.STAGEACTOR.PRINCESS_SOLILOQUY.LINE4_PRINCESS
msgctxt "STRINGS.STAGEACTOR.PRINCESS_SOLILOQUY.LINE4_PRINCESS"
msgid "without thy steadfast company?"
msgstr "sin vuestra fiel compañía?"

#. STRINGS.STAGEACTOR.PRINCESS_SOLILOQUY.LINE5_PRINCESS
msgctxt "STRINGS.STAGEACTOR.PRINCESS_SOLILOQUY.LINE5_PRINCESS"
msgid "Come, Pascal!"
msgstr "¡Venid, Pascal!"

#. STRINGS.STAGEACTOR.PRINCESS_SOLILOQUY.LINE6_PRINCESS
msgctxt "STRINGS.STAGEACTOR.PRINCESS_SOLILOQUY.LINE6_PRINCESS"
msgid "We have many souls to meet!"
msgstr "¡Hay miles de almas esperándonos!"

#. STRINGS.STAGEACTOR.PRINCESS_SOLILOQUY.LINE7_PRINCESS
msgctxt "STRINGS.STAGEACTOR.PRINCESS_SOLILOQUY.LINE7_PRINCESS"
msgid "Haste, Warren!"
msgstr "¡Aprisa, Gonzalo!"

#. STRINGS.STAGEACTOR.PRINCESS_SOLILOQUY.LINE8_PRINCESS
msgctxt "STRINGS.STAGEACTOR.PRINCESS_SOLILOQUY.LINE8_PRINCESS"
msgid "The Houses await thy arrival!"
msgstr "¡Las familias aguardan vuestra llegada!"

#. STRINGS.STAGEACTOR.PRINCESS_SOLILOQUY.LINE9_PRINCESS
msgctxt "STRINGS.STAGEACTOR.PRINCESS_SOLILOQUY.LINE9_PRINCESS"
msgid "Make swift thy way, Fermin!"
msgstr "¡No os demoréis, Héctor!"

#. STRINGS.STAGEACTOR.REPEAT_COSTUMES.1
msgctxt "STRINGS.STAGEACTOR.REPEAT_COSTUMES.1"
msgid "Are you kidding?"
msgstr "¿En serio?"

#. STRINGS.STAGEACTOR.REPEAT_COSTUMES.2
msgctxt "STRINGS.STAGEACTOR.REPEAT_COSTUMES.2"
msgid "Am I seeing double?!"
msgstr "¡¿Estoy viendo doble?!"

#. STRINGS.STAGEACTOR.REPEAT_COSTUMES.3
msgctxt "STRINGS.STAGEACTOR.REPEAT_COSTUMES.3"
msgid "No understudies!"
msgstr "¡Nada de suplentes!"

#. STRINGS.STAGEACTOR.REUNION.1
msgctxt "STRINGS.STAGEACTOR.REUNION.1"
msgid "\"The Reunion\""
msgstr "\"La reunión\""

#. STRINGS.STAGEACTOR.REUNION.10
msgctxt "STRINGS.STAGEACTOR.REUNION.10"
msgid "The world is too dangerous for one made of porcelain."
msgstr "El mundo es demasiado peligroso para alguien hecho de porcelana."

#. STRINGS.STAGEACTOR.REUNION.11
msgctxt "STRINGS.STAGEACTOR.REUNION.11"
msgid "But you need not fear for me anymore."
msgstr "Pero ya no tienes que sufrir por mí."

#. STRINGS.STAGEACTOR.REUNION.12
msgctxt "STRINGS.STAGEACTOR.REUNION.12"
msgid "Now I'm made of something stronger."
msgstr "Ahora estoy hecha de algo mucho más duro."

#. STRINGS.STAGEACTOR.REUNION.13
msgctxt "STRINGS.STAGEACTOR.REUNION.13"
msgid "Oh, I was wondering what happened to the blacksmith."
msgstr "Ah, me preguntaba qué le había pasado a la herrera."

#. STRINGS.STAGEACTOR.REUNION.14
msgctxt "STRINGS.STAGEACTOR.REUNION.14"
msgid "It's nice to have closure."
msgstr "Me gustan los finales cerrados."

#. STRINGS.STAGEACTOR.REUNION.15
msgctxt "STRINGS.STAGEACTOR.REUNION.15"
msgid "No way, it can't just end like that!"
msgstr "¡No! ¡No puede acabar así!"

#. STRINGS.STAGEACTOR.REUNION.2
msgctxt "STRINGS.STAGEACTOR.REUNION.2"
msgid "Ooooh, sounds juicy!"
msgstr "¡Uh! ¡Interesante!"

#. STRINGS.STAGEACTOR.REUNION.3
msgctxt "STRINGS.STAGEACTOR.REUNION.3"
msgid "The Blacksmith had been searching for the doll,"
msgstr "La herrera había estado buscando a la muñeca"

#. STRINGS.STAGEACTOR.REUNION.4
msgctxt "STRINGS.STAGEACTOR.REUNION.4"
msgid "and at last her journey came to an end."
msgstr "y su viaje al fin llegó a término."

#. STRINGS.STAGEACTOR.REUNION.5
msgctxt "STRINGS.STAGEACTOR.REUNION.5"
msgid "Little doll, is that really you?"
msgstr "Muñequita, ¿eres tú?"

#. STRINGS.STAGEACTOR.REUNION.6
msgctxt "STRINGS.STAGEACTOR.REUNION.6"
msgid "How you've changed..."
msgstr "Cuánto has cambiado..."

#. STRINGS.STAGEACTOR.REUNION.7
msgctxt "STRINGS.STAGEACTOR.REUNION.7"
msgid "It is me,"
msgstr "Soy yo,"

#. STRINGS.STAGEACTOR.REUNION.8
msgctxt "STRINGS.STAGEACTOR.REUNION.8"
msgid "but I am not the little doll you once knew."
msgstr "pero ya no soy la muñequita que conocías."

#. STRINGS.STAGEACTOR.REUNION.9
msgctxt "STRINGS.STAGEACTOR.REUNION.9"
msgid "You were right, Blacksmith."
msgstr "Tenías razón, herrera."

#. STRINGS.STAGEACTOR.SAGE_SOLILOQUY.1
msgctxt "STRINGS.STAGEACTOR.SAGE_SOLILOQUY.1"
msgid "Ye haven't a clue what's coming"
msgstr "No sabéis lo que se avecina."

#. STRINGS.STAGEACTOR.SAGE_SOLILOQUY.2
msgctxt "STRINGS.STAGEACTOR.SAGE_SOLILOQUY.2"
msgid "Something special, no doubt!"
msgstr "¡Es algo especial, eso ni se vacila!"

#. STRINGS.STAGEACTOR.SAGE_SOLILOQUY.3
msgctxt "STRINGS.STAGEACTOR.SAGE_SOLILOQUY.3"
msgid "Shall I spoil it for ye?"
msgstr "¿Debería destriparos el final?"

#. STRINGS.STAGEACTOR.SAGE_SOLILOQUY.4
msgctxt "STRINGS.STAGEACTOR.SAGE_SOLILOQUY.4"
msgid "I mustn't!"
msgstr "¡No, no debería!"

#. STRINGS.STAGEACTOR.SAGE_SOLILOQUY.5
msgctxt "STRINGS.STAGEACTOR.SAGE_SOLILOQUY.5"
msgid "Ye'll have to wait 'til we're complete!"
msgstr "¡Tendréis que esperar a que terminemos!"

#. STRINGS.STAGEACTOR.SAGE_SOLILOQUY.6
msgctxt "STRINGS.STAGEACTOR.SAGE_SOLILOQUY.6"
msgid "Patience, friends!"
msgstr "¡Paciencia, amigos!"

#. STRINGS.STAGEACTOR.SAGE_SOLILOQUY.7
msgctxt "STRINGS.STAGEACTOR.SAGE_SOLILOQUY.7"
msgid "PATIENCE."
msgstr "PACIENCIA."

#. STRINGS.STAGEACTOR.THEVAULT.BIRD1_1
msgctxt "STRINGS.STAGEACTOR.THEVAULT.BIRD1_1"
msgid "\"A Task Complete\""
msgstr "\"Una tarea completada\""

#. STRINGS.STAGEACTOR.THEVAULT.BIRD1_3
msgctxt "STRINGS.STAGEACTOR.THEVAULT.BIRD1_3"
msgid "Ooooh scandalous!"
msgstr "¡Ooooh, qué escándalo!"

#. STRINGS.STAGEACTOR.THEVAULT.BIRD1_4
msgctxt "STRINGS.STAGEACTOR.THEVAULT.BIRD1_4"
msgid "Well that was tragic..."
msgstr "Menuda tragedia."

#. STRINGS.STAGEACTOR.THEVAULT.BIRD2_2
msgctxt "STRINGS.STAGEACTOR.THEVAULT.BIRD2_2"
msgid "It's a confession..."
msgstr "Es una confesión..."

#. STRINGS.STAGEACTOR.THEVAULT.BIRD2_5
msgctxt "STRINGS.STAGEACTOR.THEVAULT.BIRD2_5"
msgid "Yeah, only two of them died!"
msgstr "¡Sí, solo se han muerto dos!"

#. STRINGS.STAGEACTOR.THEVAULT.BIRD_6
msgctxt "STRINGS.STAGEACTOR.THEVAULT.BIRD_6"
msgid "HA HA HA HA HA!"
msgstr "¡JA, JA, JA!"

#. STRINGS.STAGEACTOR.THEVAULT.LINE10_ELYTRA
msgctxt "STRINGS.STAGEACTOR.THEVAULT.LINE10_ELYTRA"
msgid "I scarce would believe it,"
msgstr "Me habría costado creerlo,"

#. STRINGS.STAGEACTOR.THEVAULT.LINE11_ELYTRA
msgctxt "STRINGS.STAGEACTOR.THEVAULT.LINE11_ELYTRA"
msgid "had I not witnessed the raising"
msgstr "de no haber visto como se alzaba"

#. STRINGS.STAGEACTOR.THEVAULT.LINE12_ELYTRA
msgctxt "STRINGS.STAGEACTOR.THEVAULT.LINE12_ELYTRA"
msgid "of this impenetrable labyrinth myself."
msgstr "el gran laberinto con mis propios ojos."

#. STRINGS.STAGEACTOR.THEVAULT.LINE13_VISIONIST
msgctxt "STRINGS.STAGEACTOR.THEVAULT.LINE13_VISIONIST"
msgid "Ever kind, Elytra, Queen's Shieldbearer"
msgstr "Benévola Elytra, escudera de la reina"

#. STRINGS.STAGEACTOR.THEVAULT.LINE14_VISIONIST
msgctxt "STRINGS.STAGEACTOR.THEVAULT.LINE14_VISIONIST"
msgid "and our sagacious Overseer."
msgstr "y nuestra sagaz supervisora."

#. STRINGS.STAGEACTOR.THEVAULT.LINE15_VISIONIST
msgctxt "STRINGS.STAGEACTOR.THEVAULT.LINE15_VISIONIST"
msgid "We thank thee for thy guidance"
msgstr "Agradecemos tu sabio consejo"

#. STRINGS.STAGEACTOR.THEVAULT.LINE16_VISIONIST
msgctxt "STRINGS.STAGEACTOR.THEVAULT.LINE16_VISIONIST"
msgid "through these many years we have been so blessed to serve"
msgstr "durante todos estos años en los que hemos tenido la dicha de servir"

#. STRINGS.STAGEACTOR.THEVAULT.LINE17_ARTIFICER
msgctxt "STRINGS.STAGEACTOR.THEVAULT.LINE17_ARTIFICER"
msgid "How many molts have passed in this service?"
msgstr "¿Cuántas mudas hemos cambiado durante este trabajo?"

#. STRINGS.STAGEACTOR.THEVAULT.LINE18_ELYTRA
msgctxt "STRINGS.STAGEACTOR.THEVAULT.LINE18_ELYTRA"
msgid "..."
msgstr "..."

#. STRINGS.STAGEACTOR.THEVAULT.LINE19_VISIONIST
msgctxt "STRINGS.STAGEACTOR.THEVAULT.LINE19_VISIONIST"
msgid "Not near enough for so worthy a task."
msgstr "Pocas para una tarea tan encomiable."

#. STRINGS.STAGEACTOR.THEVAULT.LINE1_ARTIFICER
msgctxt "STRINGS.STAGEACTOR.THEVAULT.LINE1_ARTIFICER"
msgid "'Twas the last stone, cut and set."
msgstr "Era la última piedra, tallada y colocada."

#. STRINGS.STAGEACTOR.THEVAULT.LINE20_ELYTRA
msgctxt "STRINGS.STAGEACTOR.THEVAULT.LINE20_ELYTRA"
msgid "An arduous and clandestine charge,"
msgstr "Una carga ardua y clandestina,"

#. STRINGS.STAGEACTOR.THEVAULT.LINE21_ELYTRA
msgctxt "STRINGS.STAGEACTOR.THEVAULT.LINE21_ELYTRA"
msgid "from the very pharynx of our Queen Herself."
msgstr "salida de la faringe de la mismísima reina."

#. STRINGS.STAGEACTOR.THEVAULT.LINE22_ELYTRA
msgctxt "STRINGS.STAGEACTOR.THEVAULT.LINE22_ELYTRA"
msgid "Hail Metheus!"
msgstr "¡Salve, Meteo!"

#. STRINGS.STAGEACTOR.THEVAULT.LINE23_VISIONIST
msgctxt "STRINGS.STAGEACTOR.THEVAULT.LINE23_VISIONIST"
msgid "Hail Metheus!"
msgstr "¡Salve, Meteo!"

#. STRINGS.STAGEACTOR.THEVAULT.LINE24_ARTIFICER
msgctxt "STRINGS.STAGEACTOR.THEVAULT.LINE24_ARTIFICER"
msgid "... Yes, hail Metheus."
msgstr "Sí... Salve, Meteo."

#. STRINGS.STAGEACTOR.THEVAULT.LINE25_ELYTRA
msgctxt "STRINGS.STAGEACTOR.THEVAULT.LINE25_ELYTRA"
msgid "Ever may She reign."
msgstr "Largo sea su reinado."

#. STRINGS.STAGEACTOR.THEVAULT.LINE26_ELYTRA
msgctxt "STRINGS.STAGEACTOR.THEVAULT.LINE26_ELYTRA"
msgid "My dear friends, for your sacrifice,"
msgstr "Queridos amigos, por vuestro sacrificio"

#. STRINGS.STAGEACTOR.THEVAULT.LINE27_ELYTRA
msgctxt "STRINGS.STAGEACTOR.THEVAULT.LINE27_ELYTRA"
msgid "you have Her thanks, and mine as well."
msgstr "contáis con su agradecimiento, y con el mío."

#. STRINGS.STAGEACTOR.THEVAULT.LINE28_VISIONIST
msgctxt "STRINGS.STAGEACTOR.THEVAULT.LINE28_VISIONIST"
msgid "No thanks are needed,"
msgstr "No hay nada que agradecer,"

#. STRINGS.STAGEACTOR.THEVAULT.LINE29_VISIONIST
msgctxt "STRINGS.STAGEACTOR.THEVAULT.LINE29_VISIONIST"
msgid "save the privilege of the task completed,"
msgstr "más que el privilegio de una tarea completada,"

#. STRINGS.STAGEACTOR.THEVAULT.LINE2_ARTIFICER
msgctxt "STRINGS.STAGEACTOR.THEVAULT.LINE2_ARTIFICER"
msgid "Worn down to the tarsals,"
msgstr "Desgastado hasta los huesos,"

#. STRINGS.STAGEACTOR.THEVAULT.LINE30_VISIONIST
msgctxt "STRINGS.STAGEACTOR.THEVAULT.LINE30_VISIONIST"
msgid "and a swift return home to my brood."
msgstr "y una pronta vuelta a mi hogar junto a mi colonia."

#. STRINGS.STAGEACTOR.THEVAULT.LINE31_ARTIFICER
msgctxt "STRINGS.STAGEACTOR.THEVAULT.LINE31_ARTIFICER"
msgid "If hive and home are naught but dust and ashes now."
msgstr "Si ya no quedan más que polvo y cenizas de la colmena y el hogar."

#. STRINGS.STAGEACTOR.THEVAULT.LINE32_ELYTRA
msgctxt "STRINGS.STAGEACTOR.THEVAULT.LINE32_ELYTRA"
msgid "A joyous homecoming awaits you both."
msgstr "A ambos os aguarda un regreso gozoso."

#. STRINGS.STAGEACTOR.THEVAULT.LINE33_ELYTRA
msgctxt "STRINGS.STAGEACTOR.THEVAULT.LINE33_ELYTRA"
msgid "But first,"
msgstr "Pero antes,"

#. STRINGS.STAGEACTOR.THEVAULT.LINE34_ELYTRA
msgctxt "STRINGS.STAGEACTOR.THEVAULT.LINE34_ELYTRA"
msgid "allow me the honor of raising a chalice to you,"
msgstr "permitidme el honor de alzar mi cáliz por vosotros"

#. STRINGS.STAGEACTOR.THEVAULT.LINE35_ELYTRA
msgctxt "STRINGS.STAGEACTOR.THEVAULT.LINE35_ELYTRA"
msgid "and to the impossible task you have completed."
msgstr "y por la tarea imposible que habéis completado."

#. STRINGS.STAGEACTOR.THEVAULT.LINE36_VISIONIST
msgctxt "STRINGS.STAGEACTOR.THEVAULT.LINE36_VISIONIST"
msgid "You honor us too greatly, Elytra."
msgstr "Nos honras, Elytra."

#. STRINGS.STAGEACTOR.THEVAULT.LINE37_VISIONIST
msgctxt "STRINGS.STAGEACTOR.THEVAULT.LINE37_VISIONIST"
msgid "Permit us to raise a chalice to you first."
msgstr "Permítenos alzar el cáliz en tu honor primero."

#. STRINGS.STAGEACTOR.THEVAULT.LINE38_VISIONIST
msgctxt "STRINGS.STAGEACTOR.THEVAULT.LINE38_VISIONIST"
msgid "The vintage..."
msgstr "El añejo..."

#. STRINGS.STAGEACTOR.THEVAULT.LINE39_VISIONIST
msgctxt "STRINGS.STAGEACTOR.THEVAULT.LINE39_VISIONIST"
msgid "'tis strong..."
msgstr "es fuerte..."

#. STRINGS.STAGEACTOR.THEVAULT.LINE3_ARTIFICER
msgctxt "STRINGS.STAGEACTOR.THEVAULT.LINE3_ARTIFICER"
msgid "countless times over,"
msgstr "incontables veces,"

#. STRINGS.STAGEACTOR.THEVAULT.LINE40_VISIONIST
msgctxt "STRINGS.STAGEACTOR.THEVAULT.LINE40_VISIONIST"
msgid "it burns..."
msgstr "quema..."

#. STRINGS.STAGEACTOR.THEVAULT.LINE41_ARTIFICER
msgctxt "STRINGS.STAGEACTOR.THEVAULT.LINE41_ARTIFICER"
msgid "Visionist!"
msgstr "¡Visionario!"

#. STRINGS.STAGEACTOR.THEVAULT.LINE42_VISIONIST
msgctxt "STRINGS.STAGEACTOR.THEVAULT.LINE42_VISIONIST"
msgid "... my brood."
msgstr "mi colonia..."

#. STRINGS.STAGEACTOR.THEVAULT.LINE43_ARTIFICER
msgctxt "STRINGS.STAGEACTOR.THEVAULT.LINE43_ARTIFICER"
msgid "What have you done, Shieldbearer?"
msgstr "¿Qué has hecho, escudera?"

#. STRINGS.STAGEACTOR.THEVAULT.LINE44_ARTIFICER
msgctxt "STRINGS.STAGEACTOR.THEVAULT.LINE44_ARTIFICER"
msgid "Ah-!!"
msgstr "¡Ah!"

#. STRINGS.STAGEACTOR.THEVAULT.LINE45_ARTIFICER
msgctxt "STRINGS.STAGEACTOR.THEVAULT.LINE45_ARTIFICER"
msgid "So... a lifetime of loyalty is rewarded with a blade in my carapace..."
msgstr "Así que... una vida de lealtad recompensada con una daga en el caparazón..."

#. STRINGS.STAGEACTOR.THEVAULT.LINE46_ARTIFICER
msgctxt "STRINGS.STAGEACTOR.THEVAULT.LINE46_ARTIFICER"
msgid "With my final breath, I curse you, and your Queen!"
msgstr "¡Con mi último aliento os maldigo, a ti y a tu reina!"

#. STRINGS.STAGEACTOR.THEVAULT.LINE47_ARTIFICER
msgctxt "STRINGS.STAGEACTOR.THEVAULT.LINE47_ARTIFICER"
msgid "May your brood rot..."
msgstr "Que tu colonia se pudra..."

#. STRINGS.STAGEACTOR.THEVAULT.LINE48_ARTIFICER
msgctxt "STRINGS.STAGEACTOR.THEVAULT.LINE48_ARTIFICER"
msgid "May all you hold dear be drowned in shadow..."
msgstr "Que todo cuanto amas sucumba a las sombras..."

#. STRINGS.STAGEACTOR.THEVAULT.LINE49_ARTIFICER
msgctxt "STRINGS.STAGEACTOR.THEVAULT.LINE49_ARTIFICER"
msgid "Let the unending Darkness... take you... all..."
msgstr "Que la oscuridad infinita... se os lleve... a todos..."

#. STRINGS.STAGEACTOR.THEVAULT.LINE4_ARTIFICER
msgctxt "STRINGS.STAGEACTOR.THEVAULT.LINE4_ARTIFICER"
msgid "in servitude."
msgstr "por servir."

#. STRINGS.STAGEACTOR.THEVAULT.LINE54_ELYTRA
msgctxt "STRINGS.STAGEACTOR.THEVAULT.LINE54_ELYTRA"
msgid "Dear Artificer, you ask what I have done."
msgstr "Querido Artífice, me preguntas qué he hecho."

#. STRINGS.STAGEACTOR.THEVAULT.LINE55_ELYTRA
msgctxt "STRINGS.STAGEACTOR.THEVAULT.LINE55_ELYTRA"
msgid "Unlike our beloved Visionist,"
msgstr "Al contrario que nuestro querido Visionario,"

#. STRINGS.STAGEACTOR.THEVAULT.LINE56_ELYTRA
msgctxt "STRINGS.STAGEACTOR.THEVAULT.LINE56_ELYTRA"
msgid "I drank from the chalice of duty"
msgstr "yo bebí del cáliz del deber"

#. STRINGS.STAGEACTOR.THEVAULT.LINE57_ELYTRA
msgctxt "STRINGS.STAGEACTOR.THEVAULT.LINE57_ELYTRA"
msgid "with full knowing of its bitter contents."
msgstr "siendo consciente de la amargura de su contenido."

#. STRINGS.STAGEACTOR.THEVAULT.LINE58_ELYTRA
msgctxt "STRINGS.STAGEACTOR.THEVAULT.LINE58_ELYTRA"
msgid "Now, with brethren lying dead before me,"
msgstr "Ahora, con mis hermanos muertos ante mí,"

#. STRINGS.STAGEACTOR.THEVAULT.LINE59_ELYTRA
msgctxt "STRINGS.STAGEACTOR.THEVAULT.LINE59_ELYTRA"
msgid "I shall keep vigil over our work"
msgstr "velaré por nuestro trabajo"

#. STRINGS.STAGEACTOR.THEVAULT.LINE5_VISIONIST
msgctxt "STRINGS.STAGEACTOR.THEVAULT.LINE5_VISIONIST"
msgid "My dear Artificer,"
msgstr "Mi querido Artífice,"

#. STRINGS.STAGEACTOR.THEVAULT.LINE60_ELYTRA
msgctxt "STRINGS.STAGEACTOR.THEVAULT.LINE60_ELYTRA"
msgid "until I too join them in oblivion."
msgstr "hasta que nos reencontremos en el olvido."

#. STRINGS.STAGEACTOR.THEVAULT.LINE61_ELYTRA
msgctxt "STRINGS.STAGEACTOR.THEVAULT.LINE61_ELYTRA"
msgid "My only consolation is this:"
msgstr "Mi único consuelo"

#. STRINGS.STAGEACTOR.THEVAULT.LINE62_ELYTRA
msgctxt "STRINGS.STAGEACTOR.THEVAULT.LINE62_ELYTRA"
msgid "that I served Her,"
msgstr "es que la he servido"

#. STRINGS.STAGEACTOR.THEVAULT.LINE63_ELYTRA
msgctxt "STRINGS.STAGEACTOR.THEVAULT.LINE63_ELYTRA"
msgid "and fulfilled what was required."
msgstr "y he cumplido con mi cometido."

#. STRINGS.STAGEACTOR.THEVAULT.LINE64_ELYTRA
msgctxt "STRINGS.STAGEACTOR.THEVAULT.LINE64_ELYTRA"
msgid "Hail Metheus."
msgstr "Salve, Meteo."

#. STRINGS.STAGEACTOR.THEVAULT.LINE65_ELYTRA
msgctxt "STRINGS.STAGEACTOR.THEVAULT.LINE65_ELYTRA"
msgid "Ever may She reign."
msgstr "Largo sea su reinado."

#. STRINGS.STAGEACTOR.THEVAULT.LINE6_VISIONIST
msgctxt "STRINGS.STAGEACTOR.THEVAULT.LINE6_VISIONIST"
msgid "'tis the finest work you have ever done,"
msgstr "has hecho tu mejor trabajo hasta la fecha,"

#. STRINGS.STAGEACTOR.THEVAULT.LINE7_VISIONIST
msgctxt "STRINGS.STAGEACTOR.THEVAULT.LINE7_VISIONIST"
msgid "bringing my vision to its fruition."
msgstr "materializando mi visión."

#. STRINGS.STAGEACTOR.THEVAULT.LINE8_ELYTRA
msgctxt "STRINGS.STAGEACTOR.THEVAULT.LINE8_ELYTRA"
msgid "And never has there been a grander vision"
msgstr "Nunca ha habido una visión mejor"

#. STRINGS.STAGEACTOR.THEVAULT.LINE9_ELYTRA
msgctxt "STRINGS.STAGEACTOR.THEVAULT.LINE9_ELYTRA"
msgid "than yours within these chambers, dear Visionist."
msgstr "que la tuya en estas estancias, querido Visionario."

#. STRINGS.STAGEACTOR.THEVEIL.BIRD1_1
msgctxt "STRINGS.STAGEACTOR.THEVEIL.BIRD1_1"
msgid "Our next guests need no introduction!"
msgstr "¡Nuestros próximos invitados no precisan presentación!"

#. STRINGS.STAGEACTOR.THEVEIL.BIRD1_3
msgctxt "STRINGS.STAGEACTOR.THEVEIL.BIRD1_3"
msgid "Good point."
msgstr "Es verdad."

#. STRINGS.STAGEACTOR.THEVEIL.BIRD2_2
msgctxt "STRINGS.STAGEACTOR.THEVEIL.BIRD2_2"
msgid "Then why are we here?"
msgstr "¿Y para qué estamos aquí?"

#. STRINGS.STAGEACTOR.THEVEIL.LINE10_SAGE
msgctxt "STRINGS.STAGEACTOR.THEVEIL.LINE10_SAGE"
msgid "Ye hath queries."
msgstr "Tenéis preguntas."

#. STRINGS.STAGEACTOR.THEVEIL.LINE11_TOADY
msgctxt "STRINGS.STAGEACTOR.THEVEIL.LINE11_TOADY"
msgid "Ye art intrigued!"
msgstr "¡Estáis intrigados!"

#. STRINGS.STAGEACTOR.THEVEIL.LINE12_HALFWIT
msgctxt "STRINGS.STAGEACTOR.THEVEIL.LINE12_HALFWIT"
msgid "Terrified!"
msgstr "¡Aterrados!"

#. STRINGS.STAGEACTOR.THEVEIL.LINE14_SAGE
msgctxt "STRINGS.STAGEACTOR.THEVEIL.LINE14_SAGE"
msgid "There is nothing to fear..."
msgstr "No hay nada que temer..."

#. STRINGS.STAGEACTOR.THEVEIL.LINE15_TOADY
msgctxt "STRINGS.STAGEACTOR.THEVEIL.LINE15_TOADY"
msgid "From the dark, at least."
msgstr "Al menos, no de la oscuridad."

#. STRINGS.STAGEACTOR.THEVEIL.LINE16_SAGE
msgctxt "STRINGS.STAGEACTOR.THEVEIL.LINE16_SAGE"
msgid "Of what should ye be afraid?"
msgstr "¿A qué deberíais temer?"

#. STRINGS.STAGEACTOR.THEVEIL.LINE17_HALFWIT
msgctxt "STRINGS.STAGEACTOR.THEVEIL.LINE17_HALFWIT"
msgid "The dark!"
msgstr "¡A la oscuridad!"

#. STRINGS.STAGEACTOR.THEVEIL.LINE19_SAGE
msgctxt "STRINGS.STAGEACTOR.THEVEIL.LINE19_SAGE"
msgid "No."
msgstr "No."

#. STRINGS.STAGEACTOR.THEVEIL.LINE1_SAGE
msgctxt "STRINGS.STAGEACTOR.THEVEIL.LINE1_SAGE"
msgid "Salutations, friends!"
msgstr "¡Saludos, amigos!"

#. STRINGS.STAGEACTOR.THEVEIL.LINE20_SAGE
msgctxt "STRINGS.STAGEACTOR.THEVEIL.LINE20_SAGE"
msgid "Why, the accursed gleam of lumin, of course!"
msgstr "¡Pues al maldito brillo luminiscente, claro!"

#. STRINGS.STAGEACTOR.THEVEIL.LINE21_HALFWIT
msgctxt "STRINGS.STAGEACTOR.THEVEIL.LINE21_HALFWIT"
msgid "Of course!"
msgstr "¡Claro!"

#. STRINGS.STAGEACTOR.THEVEIL.LINE22_TOADY
msgctxt "STRINGS.STAGEACTOR.THEVEIL.LINE22_TOADY"
msgid "From that blasted celestial orb!"
msgstr "¡De ese endemoniado orbe celestial!"

#. STRINGS.STAGEACTOR.THEVEIL.LINE23_HALFWIT
msgctxt "STRINGS.STAGEACTOR.THEVEIL.LINE23_HALFWIT"
msgid "Ugh! Orb!"
msgstr "¡Agh! ¡Orbe!"

#. STRINGS.STAGEACTOR.THEVEIL.LINE24_SAGE
msgctxt "STRINGS.STAGEACTOR.THEVEIL.LINE24_SAGE"
msgid "Yes. \"Ugh,\" indeed!"
msgstr "Sin duda, es muy desagradable."

#. STRINGS.STAGEACTOR.THEVEIL.LINE25_SAGE
msgctxt "STRINGS.STAGEACTOR.THEVEIL.LINE25_SAGE"
msgid "We too hail from our own realms."
msgstr "Nosotros también venimos de otros reinos."

#. STRINGS.STAGEACTOR.THEVEIL.LINE26_SAGE
msgctxt "STRINGS.STAGEACTOR.THEVEIL.LINE26_SAGE"
msgid "Menaced by horrible gods."
msgstr "Bajo la amenaza de unos dioses terribles."

#. STRINGS.STAGEACTOR.THEVEIL.LINE27_TOADY
msgctxt "STRINGS.STAGEACTOR.THEVEIL.LINE27_TOADY"
msgid "That is until the sweet pall was laid upon us."
msgstr "Al menos hasta que el dulce velo cayó sobre nosotros."

#. STRINGS.STAGEACTOR.THEVEIL.LINE28_SAGE
msgctxt "STRINGS.STAGEACTOR.THEVEIL.LINE28_SAGE"
msgid "And now, we three be free!"
msgstr "¡Y ahora los tres somos libres!"

#. STRINGS.STAGEACTOR.THEVEIL.LINE29_HALFWIT
msgctxt "STRINGS.STAGEACTOR.THEVEIL.LINE29_HALFWIT"
msgid "Freeeeee!"
msgstr "¡Libres!"

#. STRINGS.STAGEACTOR.THEVEIL.LINE2_SAGE
msgctxt "STRINGS.STAGEACTOR.THEVEIL.LINE2_SAGE"
msgid "We three be heralds of our tenebrous provider."
msgstr "Los tres somos heraldos de nuestro proveedor tenebroso."

#. STRINGS.STAGEACTOR.THEVEIL.LINE30_SAGE
msgctxt "STRINGS.STAGEACTOR.THEVEIL.LINE30_SAGE"
msgid "Ye too can be liberated!"
msgstr "¡Vosotros también podéis ser libres!"

#. STRINGS.STAGEACTOR.THEVEIL.LINE31_HALFWIT
msgctxt "STRINGS.STAGEACTOR.THEVEIL.LINE31_HALFWIT"
msgid "Wheeeee!"
msgstr "¡Genial!"

#. STRINGS.STAGEACTOR.THEVEIL.LINE32_SAGE
msgctxt "STRINGS.STAGEACTOR.THEVEIL.LINE32_SAGE"
msgid "Join us 'neath the protective pall"
msgstr "¡Uníos a nosotros bajo el velo protector"

#. STRINGS.STAGEACTOR.THEVEIL.LINE33_SAGE
msgctxt "STRINGS.STAGEACTOR.THEVEIL.LINE33_SAGE"
msgid "ye shall never fear the dark again!"
msgstr "y jamás volveréis a temer a la oscuridad!"

#. STRINGS.STAGEACTOR.THEVEIL.LINE34_TOADY
msgctxt "STRINGS.STAGEACTOR.THEVEIL.LINE34_TOADY"
msgid "Never build another fire!"
msgstr "¡No necesitaréis fuego!"

#. STRINGS.STAGEACTOR.THEVEIL.LINE35_HALFWIT
msgctxt "STRINGS.STAGEACTOR.THEVEIL.LINE35_HALFWIT"
msgid "Or chop wood!"
msgstr "¡Ni leña!"

#. STRINGS.STAGEACTOR.THEVEIL.LINE36_TOADY
msgctxt "STRINGS.STAGEACTOR.THEVEIL.LINE36_TOADY"
msgid "Or sleep!"
msgstr "¡Ni dormir!"

#. STRINGS.STAGEACTOR.THEVEIL.LINE37_SAGE
msgctxt "STRINGS.STAGEACTOR.THEVEIL.LINE37_SAGE"
msgid "Or eat!"
msgstr "¡Ni comer!"

#. STRINGS.STAGEACTOR.THEVEIL.LINE38_HALFWIT
msgctxt "STRINGS.STAGEACTOR.THEVEIL.LINE38_HALFWIT"
msgid "Or blink!"
msgstr "¡Ni pestañear!"

#. STRINGS.STAGEACTOR.THEVEIL.LINE39_TOADY
msgctxt "STRINGS.STAGEACTOR.THEVEIL.LINE39_TOADY"
msgid "Ye can still blink."
msgstr "Podéis pestañear si queréis."

#. STRINGS.STAGEACTOR.THEVEIL.LINE3_TOADY
msgctxt "STRINGS.STAGEACTOR.THEVEIL.LINE3_TOADY"
msgid "Ooooh... tenebrous!"
msgstr "¡Oh..., tenebroso!"

#. STRINGS.STAGEACTOR.THEVEIL.LINE40_HALFWIT
msgctxt "STRINGS.STAGEACTOR.THEVEIL.LINE40_HALFWIT"
msgid "Still blink!"
msgstr "¡Pestañear sí!"

#. STRINGS.STAGEACTOR.THEVEIL.LINE41_SAGE
msgctxt "STRINGS.STAGEACTOR.THEVEIL.LINE41_SAGE"
msgid "Ye will be one with the ever night!"
msgstr "¡Seréis uno con la noche eterna!"

#. STRINGS.STAGEACTOR.THEVEIL.LINE42_TOADY
msgctxt "STRINGS.STAGEACTOR.THEVEIL.LINE42_TOADY"
msgid "Forever in the sweet, dim embrace!"
msgstr "¡Para siempre en su tenue abrazo!"

#. STRINGS.STAGEACTOR.THEVEIL.LINE43_SAGE
msgctxt "STRINGS.STAGEACTOR.THEVEIL.LINE43_SAGE"
msgid "Forever..."
msgstr "Para siempre..."

#. STRINGS.STAGEACTOR.THEVEIL.LINE44_SAGE
msgctxt "STRINGS.STAGEACTOR.THEVEIL.LINE44_SAGE"
msgid "in..."
msgstr "en..."

#. STRINGS.STAGEACTOR.THEVEIL.LINE45_HALFWIT
msgctxt "STRINGS.STAGEACTOR.THEVEIL.LINE45_HALFWIT"
msgid "Darkness."
msgstr "La oscuridad."

#. STRINGS.STAGEACTOR.THEVEIL.LINE4_SAGE
msgctxt "STRINGS.STAGEACTOR.THEVEIL.LINE4_SAGE"
msgid "Dark!"
msgstr "¡Oscuro!"

#. STRINGS.STAGEACTOR.THEVEIL.LINE5_TOADY
msgctxt "STRINGS.STAGEACTOR.THEVEIL.LINE5_TOADY"
msgid "Sooo dark, yes!"
msgstr "¡Muy oscuro, sí!"

#. STRINGS.STAGEACTOR.THEVEIL.LINE6_HALFWIT
msgctxt "STRINGS.STAGEACTOR.THEVEIL.LINE6_HALFWIT"
msgid "Deadly!"
msgstr "¡Mortal!"

#. STRINGS.STAGEACTOR.THEVEIL.LINE7_SAGE
msgctxt "STRINGS.STAGEACTOR.THEVEIL.LINE7_SAGE"
msgid "Not deadly."
msgstr "No, mortal no."

#. STRINGS.STAGEACTOR.THEVEIL.LINE8_TOADY
msgctxt "STRINGS.STAGEACTOR.THEVEIL.LINE8_TOADY"
msgid "Benevolent!"
msgstr "¡Benevolente!"

#. STRINGS.STAGEACTOR.THEVEIL.LINE9_HALFWIT
msgctxt "STRINGS.STAGEACTOR.THEVEIL.LINE9_HALFWIT"
msgid "So benevolent!"
msgstr "¡Muy benevolente!"

#. STRINGS.STAGEACTOR.TOADY_SOLILOQUY.1
msgctxt "STRINGS.STAGEACTOR.TOADY_SOLILOQUY.1"
msgid "Why did the playwright dim the lights in the first act?"
msgstr "¿Por qué el dramaturgo ha bajado las luces en el primer acto?"

#. STRINGS.STAGEACTOR.TOADY_SOLILOQUY.2
msgctxt "STRINGS.STAGEACTOR.TOADY_SOLILOQUY.2"
msgid "Foreshadowing!"
msgstr "¡Era un presagio!"

#. STRINGS.STAGEACTOR.TREE_SOLILOQUY.1
msgctxt "STRINGS.STAGEACTOR.TREE_SOLILOQUY.1"
msgid "\"Ode to the Scenery\""
msgstr "\"Oda al escenario\""

#. STRINGS.STAGEACTOR.TREE_SOLILOQUY.2
msgctxt "STRINGS.STAGEACTOR.TREE_SOLILOQUY.2"
msgid "Oh, this is going to be good."
msgstr "Esta va a ser buena."

#. STRINGS.STAGEACTOR.TREE_SOLILOQUY.3
msgctxt "STRINGS.STAGEACTOR.TREE_SOLILOQUY.3"
msgid "The tree stood alone."
msgstr "El árbol estaba solo."

#. STRINGS.STAGEACTOR.TREE_SOLILOQUY.4
msgctxt "STRINGS.STAGEACTOR.TREE_SOLILOQUY.4"
msgid "In resolute silence."
msgstr "En firme silencio."

#. STRINGS.STAGEACTOR.TREE_SOLILOQUY.5
msgctxt "STRINGS.STAGEACTOR.TREE_SOLILOQUY.5"
msgid "Not doing much of anything."
msgstr "Sin hacer mucho."

#. STRINGS.STAGEACTOR.TREE_SOLILOQUY.6
msgctxt "STRINGS.STAGEACTOR.TREE_SOLILOQUY.6"
msgid "That was my favorite act so far."
msgstr "Este ha sido el que más me ha gustado."

#. STRINGS.STAGEACTOR.TREE_SOLILOQUY.7
msgctxt "STRINGS.STAGEACTOR.TREE_SOLILOQUY.7"
msgid "Bravo! Bravissima!"
msgstr "¡Bravo! ¡Bravísimo!"

#. STRINGS.STAGEACTOR.VISIONIST_SOLILOQUY.1
msgctxt "STRINGS.STAGEACTOR.VISIONIST_SOLILOQUY.1"
msgid "And now, the Visionist..."
msgstr "Y ahora, el Visionario..."

#. STRINGS.STAGEACTOR.VISIONIST_SOLILOQUY.10
msgctxt "STRINGS.STAGEACTOR.VISIONIST_SOLILOQUY.10"
msgid "Our Overseer is steadfast in the cause,"
msgstr "Nuestra supervisora es fiel a la causa"

#. STRINGS.STAGEACTOR.VISIONIST_SOLILOQUY.11
msgctxt "STRINGS.STAGEACTOR.VISIONIST_SOLILOQUY.11"
msgid "and I place my full trust in her"
msgstr "y confío plenamente en que nos guiará"

#. STRINGS.STAGEACTOR.VISIONIST_SOLILOQUY.12
msgctxt "STRINGS.STAGEACTOR.VISIONIST_SOLILOQUY.12"
msgid "to lead us through this enduring endeavor."
msgstr "en esta larga tarea."

#. STRINGS.STAGEACTOR.VISIONIST_SOLILOQUY.13
msgctxt "STRINGS.STAGEACTOR.VISIONIST_SOLILOQUY.13"
msgid "The Other shall not prevail."
msgstr "El Otro no se saldrá con la suya."

#. STRINGS.STAGEACTOR.VISIONIST_SOLILOQUY.14
msgctxt "STRINGS.STAGEACTOR.VISIONIST_SOLILOQUY.14"
msgid "Oh, but it shall!"
msgstr "¡Oh, pero lo hará!"

#. STRINGS.STAGEACTOR.VISIONIST_SOLILOQUY.15
msgctxt "STRINGS.STAGEACTOR.VISIONIST_SOLILOQUY.15"
msgid "Guess he didn't see that coming."
msgstr "Supongo que no lo vio venir."

#. STRINGS.STAGEACTOR.VISIONIST_SOLILOQUY.16
msgctxt "STRINGS.STAGEACTOR.VISIONIST_SOLILOQUY.16"
msgid "HA HA HA HA HA!"
msgstr "¡JA, JA, JA!"

#. STRINGS.STAGEACTOR.VISIONIST_SOLILOQUY.2
msgctxt "STRINGS.STAGEACTOR.VISIONIST_SOLILOQUY.2"
msgid "Visionist? Can he see that we're bored?"
msgstr "¿Visionario? ¿No ve que nos estamos aburriendo?"

#. STRINGS.STAGEACTOR.VISIONIST_SOLILOQUY.3
msgctxt "STRINGS.STAGEACTOR.VISIONIST_SOLILOQUY.3"
msgid "HA HA HA HA HA!"
msgstr "¡JA, JA, JA!"

#. STRINGS.STAGEACTOR.VISIONIST_SOLILOQUY.4
msgctxt "STRINGS.STAGEACTOR.VISIONIST_SOLILOQUY.4"
msgid "'Tis a formidable task set before us,"
msgstr "Se nos ha encomendado una tarea formidable,"

#. STRINGS.STAGEACTOR.VISIONIST_SOLILOQUY.5
msgctxt "STRINGS.STAGEACTOR.VISIONIST_SOLILOQUY.5"
msgid "yet I shall design the most impossibly intricate,"
msgstr "pero diseñaré la estructura más intrincada"

#. STRINGS.STAGEACTOR.VISIONIST_SOLILOQUY.6
msgctxt "STRINGS.STAGEACTOR.VISIONIST_SOLILOQUY.6"
msgid "unsolvable structure this realm has ever known."
msgstr "e imposible de resolver que este reino haya visto."

#. STRINGS.STAGEACTOR.VISIONIST_SOLILOQUY.7
msgctxt "STRINGS.STAGEACTOR.VISIONIST_SOLILOQUY.7"
msgid "For the glory of our King and Queen,"
msgstr "Por la gloria del rey y de la reina,"

#. STRINGS.STAGEACTOR.VISIONIST_SOLILOQUY.8
msgctxt "STRINGS.STAGEACTOR.VISIONIST_SOLILOQUY.8"
msgid "for our Kingdom,"
msgstr "por nuestro reino"

#. STRINGS.STAGEACTOR.VISIONIST_SOLILOQUY.9
msgctxt "STRINGS.STAGEACTOR.VISIONIST_SOLILOQUY.9"
msgid "and for the survival of our kind."
msgstr "y por la supervivencia de nuestra especie."

#. STRINGS.STAGEACTOR.WALTER1.1
msgctxt "STRINGS.STAGEACTOR.WALTER1.1"
msgid "I've been teaching Woby lots of tricks, watch!"
msgstr "¡Mira, le he enseñado un montón de trucos a Woby!"

#. STRINGS.STAGEACTOR.WALTER1.2
msgctxt "STRINGS.STAGEACTOR.WALTER1.2"
msgid "Okay Woby... stay!"
msgstr "Vale, Woby... ¡Quieta!"

#. STRINGS.STAGEACTOR.WALTER1.3
msgctxt "STRINGS.STAGEACTOR.WALTER1.3"
msgid "Good girl!"
msgstr "¡Buena chica!"

#. STRINGS.STAGEACTOR.WALTER1.4
msgctxt "STRINGS.STAGEACTOR.WALTER1.4"
msgid "We're uh... we're still working on the rest."
msgstr "Aún... Esto... Aún estamos puliendo el resto."

#. STRINGS.STAGEACTOR.WALTER1.5
msgctxt "STRINGS.STAGEACTOR.WALTER1.5"
msgid "Still pretty impressive though, right?"
msgstr "Aunque sigue siendo bastante impresionante, ¿verdad?"

#. STRINGS.STAGEACTOR.WANDA1.1
msgctxt "STRINGS.STAGEACTOR.WANDA1.1"
msgid "\"You are old, Father William,\" the young man said"
msgstr "\"Sois viejo, padre Guillermo\", dijo el joven,"

#. STRINGS.STAGEACTOR.WANDA1.2
msgctxt "STRINGS.STAGEACTOR.WANDA1.2"
msgid "\"And your hair has become very white;"
msgstr "\"y vuestro pelo se ha puesto ya muy cano."

#. STRINGS.STAGEACTOR.WANDA1.3
msgctxt "STRINGS.STAGEACTOR.WANDA1.3"
msgid "And yet you incessantly stand on your head—"
msgstr "Sin embargo, ¡os estáis poniendo siempre de cabeza!"

#. STRINGS.STAGEACTOR.WANDA1.4
msgctxt "STRINGS.STAGEACTOR.WANDA1.4"
msgid "Do you think, at your age, it is right?\""
msgstr "¡Decidme! ¿Os parece eso bien a vuestra edad?\""

#. STRINGS.STAGEACTOR.WANDA1.5
msgctxt "STRINGS.STAGEACTOR.WANDA1.5"
msgid "\"In my youth,\" Father William replied to his son,"
msgstr "\"En mi juventud\", replicó Guillermo a su hijo,"

#. STRINGS.STAGEACTOR.WANDA1.6
msgctxt "STRINGS.STAGEACTOR.WANDA1.6"
msgid "\"I feared it might injure the brain;"
msgstr "\"temí que me hiciera daño a los sesos."

#. STRINGS.STAGEACTOR.WANDA1.7
msgctxt "STRINGS.STAGEACTOR.WANDA1.7"
msgid "But now that I'm perfectly sure I have none,"
msgstr "Pero ahora, cuando sé que no me queda ninguno,"

#. STRINGS.STAGEACTOR.WANDA1.8
msgctxt "STRINGS.STAGEACTOR.WANDA1.8"
msgid "Why, I do it again and again.\""
msgstr "¡vaya! ¡lo hago cuando me viene en gana!\"."

#. STRINGS.STAGEACTOR.WARLY1.1
msgctxt "STRINGS.STAGEACTOR.WARLY1.1"
msgid "Adieu, patrie!"
msgstr "Adieu, patrie!"

#. STRINGS.STAGEACTOR.WARLY1.2
msgctxt "STRINGS.STAGEACTOR.WARLY1.2"
msgid "L'onde est en furie."
msgstr "L'onde est en furie."

#. STRINGS.STAGEACTOR.WARLY1.3
msgctxt "STRINGS.STAGEACTOR.WARLY1.3"
msgid "Adieu, patrie,"
msgstr "Adieu, patrie,"

#. STRINGS.STAGEACTOR.WARLY1.4
msgctxt "STRINGS.STAGEACTOR.WARLY1.4"
msgid "Azur!"
msgstr "Azur!"

#. STRINGS.STAGEACTOR.WARLY1.5
msgctxt "STRINGS.STAGEACTOR.WARLY1.5"
msgid "Adieu, maison, treille au fruit mûr,"
msgstr "Adieu, maison, treille au fruit mûr,"

#. STRINGS.STAGEACTOR.WARLY1.6
msgctxt "STRINGS.STAGEACTOR.WARLY1.6"
msgid "Adieu, les fleurs d'or du vieux mur!"
msgstr "Adieu, les fleurs d'or du vieux mur!"

#. STRINGS.STAGEACTOR.WAXWELL1.1
msgctxt "STRINGS.STAGEACTOR.WAXWELL1.1"
msgid "Thank you very much, you are too kind."
msgstr "Gracias, son muy amables."

#. STRINGS.STAGEACTOR.WAXWELL1.2
msgctxt "STRINGS.STAGEACTOR.WAXWELL1.2"
msgid "And now, I will pull shadows incarnate from this mysterious tome!"
msgstr "¡Ahora, extraeré a las mismísimas sobras de este misterioso tomo!"

#. STRINGS.STAGEACTOR.WAXWELL1.3
msgctxt "STRINGS.STAGEACTOR.WAXWELL1.3"
msgid "The show was better with... well, it was better before."
msgstr "El espectáculo estaba mejor con... Bueno, estaba mejor antes."

#. STRINGS.STAGEACTOR.WEBBER_BOY.1
msgctxt "STRINGS.STAGEACTOR.WEBBER_BOY.1"
msgid "Ahem! We're going to say a poem now!"
msgstr "¡Ejem! ¡Vamos a recitar un poema!"

#. STRINGS.STAGEACTOR.WEBBER_BOY.2
msgctxt "STRINGS.STAGEACTOR.WEBBER_BOY.2"
msgid "Little Miss Muffet she sat on her tuffet,"
msgstr "Un elefante se balanceaba"

#. STRINGS.STAGEACTOR.WEBBER_BOY.3
msgctxt "STRINGS.STAGEACTOR.WEBBER_BOY.3"
msgid "eating her curds and whey."
msgstr "sobre la tela de una araña."

#. STRINGS.STAGEACTOR.WEBBER_BOY.4
msgctxt "STRINGS.STAGEACTOR.WEBBER_BOY.4"
msgid "Along came a spider who sat down beside her"
msgstr "Como veía que no se caía,"

#. STRINGS.STAGEACTOR.WEBBER_BOY.5
msgctxt "STRINGS.STAGEACTOR.WEBBER_BOY.5"
msgid "And frightened Miss Muffet away!"
msgstr "fue a llamar a otro elefante."

#. STRINGS.STAGEACTOR.WEBBER_SPIDER.1
msgctxt "STRINGS.STAGEACTOR.WEBBER_SPIDER.1"
msgid "\"Will you walk into my parlour?\""
msgstr "\"¿Entrarás en mi salón?\","

#. STRINGS.STAGEACTOR.WEBBER_SPIDER.2
msgctxt "STRINGS.STAGEACTOR.WEBBER_SPIDER.2"
msgid "said a spider to a fly;"
msgstr "dijo la araña a la mosca,"

#. STRINGS.STAGEACTOR.WEBBER_SPIDER.3
msgctxt "STRINGS.STAGEACTOR.WEBBER_SPIDER.3"
msgid "'Tis the prettiest little parlour that ever you did spy."
msgstr "\"En lo que a salones se refiere, no tiene parangón."

#. STRINGS.STAGEACTOR.WEBBER_SPIDER.4
msgctxt "STRINGS.STAGEACTOR.WEBBER_SPIDER.4"
msgid "The way into my parlour is up a winding stair,"
msgstr "A mi salón se entra por una escalera sinuosa,"

#. STRINGS.STAGEACTOR.WEBBER_SPIDER.5
msgctxt "STRINGS.STAGEACTOR.WEBBER_SPIDER.5"
msgid "And I have many pretty things to shew when you are there."
msgstr "y para mostrarte en él tengo más de una cosa\"."

#. STRINGS.STAGEACTOR.WEBBER_SPIDER.6
msgctxt "STRINGS.STAGEACTOR.WEBBER_SPIDER.6"
msgid "\"Oh no, no!\" said the little fly"
msgstr "\"¡Oh, no, no!\", dijo la pequeña mosca,"

#. STRINGS.STAGEACTOR.WEBBER_SPIDER.7
msgctxt "STRINGS.STAGEACTOR.WEBBER_SPIDER.7"
msgid "to ask me is in vain"
msgstr "\"Ahórrate la cuestión,"

#. STRINGS.STAGEACTOR.WEBBER_SPIDER.8
msgctxt "STRINGS.STAGEACTOR.WEBBER_SPIDER.8"
msgid "For who goes up your winding stair can ne'er come down again."
msgstr "pues quién tu escalera asciende, no vuelve a ver el sol\"."

#. STRINGS.STAGEACTOR.WENDY1.1
msgctxt "STRINGS.STAGEACTOR.WENDY1.1"
msgid "O what can ail thee, knight-at-arms,"
msgstr "Oh, ¿qué os aflige, caballero,"

#. STRINGS.STAGEACTOR.WENDY1.2
msgctxt "STRINGS.STAGEACTOR.WENDY1.2"
msgid "So haggard and so woe-begone?"
msgstr "que tanto os consume y acongoja?"

#. STRINGS.STAGEACTOR.WENDY1.3
msgctxt "STRINGS.STAGEACTOR.WENDY1.3"
msgid "The squirrel's granary is full,"
msgstr "La ardilla ha llenado su granero"

#. STRINGS.STAGEACTOR.WENDY1.4
msgctxt "STRINGS.STAGEACTOR.WENDY1.4"
msgid "And the harvest's done."
msgstr "y la cosecha no ha sido poca."

#. STRINGS.STAGEACTOR.WENDY1.5
msgctxt "STRINGS.STAGEACTOR.WENDY1.5"
msgid "I see a lily on thy brow,"
msgstr "Veo un lirio en vuestra frente,"

#. STRINGS.STAGEACTOR.WENDY1.6
msgctxt "STRINGS.STAGEACTOR.WENDY1.6"
msgid "With anguish moist and fever-dew,"
msgstr "de angustia y fiebre empapado,"

#. STRINGS.STAGEACTOR.WENDY1.7
msgctxt "STRINGS.STAGEACTOR.WENDY1.7"
msgid "And on thy cheeks a fading rose"
msgstr "y en las mejillas una rosa,"

#. STRINGS.STAGEACTOR.WENDY1.8
msgctxt "STRINGS.STAGEACTOR.WENDY1.8"
msgid "Fast withereth too."
msgstr "que pronta se ha marchitado."

#. STRINGS.STAGEACTOR.WES1.1
msgctxt "STRINGS.STAGEACTOR.WES1.1"
msgid "Essayez-vous comprendre mes pensées?"
msgstr "Essayez-vous comprendre mes pensées?"

#. STRINGS.STAGEACTOR.WES1.2
msgctxt "STRINGS.STAGEACTOR.WES1.2"
msgid "Ah, comme c'est gentil à vous!"
msgstr "Ah, comme c'est gentil à vous!"

#. STRINGS.STAGEACTOR.WES1.3
msgctxt "STRINGS.STAGEACTOR.WES1.3"
msgid "Je suis flatté. :)"
msgstr "Je suis flatté. :)"

#. STRINGS.STAGEACTOR.WICKERBOTTOM1.1
msgctxt "STRINGS.STAGEACTOR.WICKERBOTTOM1.1"
msgid "Theater as an art form is practiced throughout the world."
msgstr "El teatro como forma de arte se practica en todo el mundo."

#. STRINGS.STAGEACTOR.WICKERBOTTOM1.2
msgctxt "STRINGS.STAGEACTOR.WICKERBOTTOM1.2"
msgid "The Western tradition of theater can trace its origins back to ancient Athens;"
msgstr "La tradición del teatro occidental se remonta a la antigua Atenas."

#. STRINGS.STAGEACTOR.WICKERBOTTOM1.3
msgctxt "STRINGS.STAGEACTOR.WICKERBOTTOM1.3"
msgid "the word \"theater\" of course coming from the Greek \"theatron,\""
msgstr "La palabra \"teatro\" viene del griego: \"theatron\","

#. STRINGS.STAGEACTOR.WICKERBOTTOM1.4
msgctxt "STRINGS.STAGEACTOR.WICKERBOTTOM1.4"
msgid "which itself was derived from the verb \"theasthai,\" \"to behold.\""
msgstr "que a su vez derivaba del verbo \"theasthai\", \"contemplar\"."

#. STRINGS.STAGEACTOR.WICKERBOTTOM1.5
msgctxt "STRINGS.STAGEACTOR.WICKERBOTTOM1.5"
msgid "Isn't etymology delightful?"
msgstr "¿No es maravillosa la etimología?"

#. STRINGS.STAGEACTOR.WILLOW1.1
msgctxt "STRINGS.STAGEACTOR.WILLOW1.1"
msgid "Fire fire, burning bright,"
msgstr "¡Fuego! ¡Fuego! Ardiente resplandor,"

#. STRINGS.STAGEACTOR.WILLOW1.2
msgctxt "STRINGS.STAGEACTOR.WILLOW1.2"
msgid "In the forests of the night;"
msgstr "en las selvas de la noche,"

#. STRINGS.STAGEACTOR.WILLOW1.3
msgctxt "STRINGS.STAGEACTOR.WILLOW1.3"
msgid "And in the mountains, and the plains,"
msgstr "en las montañas y las praderas,"

#. STRINGS.STAGEACTOR.WILLOW1.4
msgctxt "STRINGS.STAGEACTOR.WILLOW1.4"
msgid "And the towns, and the cities,"
msgstr "en las ciudades y en las aldeas."

#. STRINGS.STAGEACTOR.WILLOW1.5
msgctxt "STRINGS.STAGEACTOR.WILLOW1.5"
msgid "Everywhere! Burn it all down!! Hahaha!!"
msgstr "¡En todas partes! ¡Quémalo todo! ¡Ja, ja, ja!"

#. STRINGS.STAGEACTOR.WILLOW1.6
msgctxt "STRINGS.STAGEACTOR.WILLOW1.6"
msgid "Yeah, pretty sure that's how that poem goes."
msgstr "Sí, estoy segura de que era así."

#. STRINGS.STAGEACTOR.WILLOW1.anim
msgctxt "STRINGS.STAGEACTOR.WILLOW1.anim"
msgid "emote_happycheer"
msgstr "emote_happycheer"

#. STRINGS.STAGEACTOR.WILSON1.1
msgctxt "STRINGS.STAGEACTOR.WILSON1.1"
msgid "I am the very model of a modern Major-General"
msgstr "Soy el modelo mismo del mayor general moderno"

#. STRINGS.STAGEACTOR.WILSON1.2
msgctxt "STRINGS.STAGEACTOR.WILSON1.2"
msgid "I've information vegetable, animal, and mineral"
msgstr "Y del vegetal, animal y mineral entiendo"

#. STRINGS.STAGEACTOR.WILSON1.3
msgctxt "STRINGS.STAGEACTOR.WILSON1.3"
msgid "I'm very well acquainted, too, with matters Mathematical"
msgstr "También estoy versado en matemáticas"

#. STRINGS.STAGEACTOR.WILSON1.4
msgctxt "STRINGS.STAGEACTOR.WILSON1.4"
msgid "I understand equations, both the simple and quadratical"
msgstr "Y entiendo ecuaciones, tanto simples como cuadráticas"

#. STRINGS.STAGEACTOR.WINONA1.1
msgctxt "STRINGS.STAGEACTOR.WINONA1.1"
msgid "There once was a gal from the sticks,"
msgstr "Había una vez, una chica de campo,"

#. STRINGS.STAGEACTOR.WINONA1.2
msgctxt "STRINGS.STAGEACTOR.WINONA1.2"
msgid "Who went out to look for her sis."
msgstr "que a buscar a su hermana salió sin dudarlo."

#. STRINGS.STAGEACTOR.WINONA1.3
msgctxt "STRINGS.STAGEACTOR.WINONA1.3"
msgid "But she found her too late,"
msgstr "Pero se demoró al encontrarla,"

#. STRINGS.STAGEACTOR.WINONA1.4
msgctxt "STRINGS.STAGEACTOR.WINONA1.4"
msgid "And got yanked through a gate,"
msgstr "y un portal acabó tragándosela."

#. STRINGS.STAGEACTOR.WINONA1.5
msgctxt "STRINGS.STAGEACTOR.WINONA1.5"
msgid "Ain't family drama the pits?"
msgstr "El drama familiar es mejor evitarlo."

#. STRINGS.STAGEACTOR.WOLFGANG1.1
msgctxt "STRINGS.STAGEACTOR.WOLFGANG1.1"
msgid "Wolfgang is not just man of big muscles,"
msgstr "Wolfgang no ser solo músculos,"

#. STRINGS.STAGEACTOR.WOLFGANG1.2
msgctxt "STRINGS.STAGEACTOR.WOLFGANG1.2"
msgid "Is man of mighty feelings too."
msgstr "también tener corazón."

#. STRINGS.STAGEACTOR.WOLFGANG1.3
msgctxt "STRINGS.STAGEACTOR.WOLFGANG1.3"
msgid "Will read poem to you now:"
msgstr "Wolfgang recitar poema:"

#. STRINGS.STAGEACTOR.WOLFGANG1.4
msgctxt "STRINGS.STAGEACTOR.WOLFGANG1.4"
msgid "Wolfgang likes his friends,"
msgstr "A Wolfgang gustar amigos,"

#. STRINGS.STAGEACTOR.WOLFGANG1.5
msgctxt "STRINGS.STAGEACTOR.WOLFGANG1.5"
msgid "Though some are weird, make scary magic, and one is spider,"
msgstr "aunque algunos ser raros, hacer magia que dar miedo y uno ser araña,"

#. STRINGS.STAGEACTOR.WOLFGANG1.6
msgctxt "STRINGS.STAGEACTOR.WOLFGANG1.6"
msgid "Will stay with them till very end,"
msgstr "estar para siempre con ellos"

#. STRINGS.STAGEACTOR.WOLFGANG1.7
msgctxt "STRINGS.STAGEACTOR.WOLFGANG1.7"
msgid "Make Wolfgang's bad day brighter."
msgstr "alegrar a Wolfgang la mañana."

#. STRINGS.STAGEACTOR.WOODIE1.1
msgctxt "STRINGS.STAGEACTOR.WOODIE1.1"
msgid "Er... I don't really like bein' the center of attention."
msgstr "Esto... No me gusta ser el centro de atención."

#. STRINGS.STAGEACTOR.WOODIE1.2
msgctxt "STRINGS.STAGEACTOR.WOODIE1.2"
msgid "Let me try!"
msgstr "¡Lo intentaré!"

#. STRINGS.STAGEACTOR.WOODIE1.3
msgctxt "STRINGS.STAGEACTOR.WOODIE1.3"
msgid "Chop chop chop, swing swing swing,"
msgstr "Talar, talar, talar, cortar, cortar, cortar,"

#. STRINGS.STAGEACTOR.WOODIE1.4
msgctxt "STRINGS.STAGEACTOR.WOODIE1.4"
msgid "Choppin' is my favourite thing."
msgstr "talar es una cosa sin par."

#. STRINGS.STAGEACTOR.WOODIE1.5
msgctxt "STRINGS.STAGEACTOR.WOODIE1.5"
msgid "Swing swing swing, chop chop chop,"
msgstr "Cortar, cortar, cortar, talar, talar, talar,"

#. STRINGS.STAGEACTOR.WOODIE1.6
msgctxt "STRINGS.STAGEACTOR.WOODIE1.6"
msgid "Love it way too much to stop!"
msgstr "¡me gusta demasiado para parar!"

#. STRINGS.STAGEACTOR.WOODIE1.7
msgctxt "STRINGS.STAGEACTOR.WOODIE1.7"
msgid "You've sure got a way with words, Luce."
msgstr "Qué labia tienes, Luce."

#. STRINGS.STAGEACTOR.WORMWOOD1.1
msgctxt "STRINGS.STAGEACTOR.WORMWOOD1.1"
msgid "Hello friends!"
msgstr "¡Hola, amigas!"

#. STRINGS.STAGEACTOR.WORMWOOD1.2
msgctxt "STRINGS.STAGEACTOR.WORMWOOD1.2"
msgid "Watching? Hmm..."
msgstr "¿Mirando? Hum..."

#. STRINGS.STAGEACTOR.WORMWOOD1.3
msgctxt "STRINGS.STAGEACTOR.WORMWOOD1.3"
msgid "Doo-doo-dee-doop"
msgstr "Du, du, du"

#. STRINGS.STAGEACTOR.WORMWOOD1.4
msgctxt "STRINGS.STAGEACTOR.WORMWOOD1.4"
msgid "Woo-wah-wah!"
msgstr "¡Na, na, na!"

#. STRINGS.STAGEACTOR.WORMWOOD1.5
msgctxt "STRINGS.STAGEACTOR.WORMWOOD1.5"
msgid "Deedle-deedle-deedle-woo"
msgstr "Lo, lo, lo"

#. STRINGS.STAGEACTOR.WORMWOOD1.6
msgctxt "STRINGS.STAGEACTOR.WORMWOOD1.6"
msgid "Wah-wah-wheee!"
msgstr "¡Tara, ra, ra, ra!"

#. STRINGS.STAGEACTOR.WORMWOOD1.7
msgctxt "STRINGS.STAGEACTOR.WORMWOOD1.7"
msgid "Oop-doodle-doo"
msgstr "Dun, dun, dun"

#. STRINGS.STAGEACTOR.WORMWOOD1.8
msgctxt "STRINGS.STAGEACTOR.WORMWOOD1.8"
msgid "Bwa-waaaaaaaaaah!"
msgstr "¡Laaa!"

#. STRINGS.STAGEACTOR.WORTOX1.1
msgctxt "STRINGS.STAGEACTOR.WORTOX1.1"
msgid "The wisest aunt, telling the saddest tale,"
msgstr "Suele acontecer que la tía más prudente refiriendo un tristísimo cuento,"

#. STRINGS.STAGEACTOR.WORTOX1.2
msgctxt "STRINGS.STAGEACTOR.WORTOX1.2"
msgid "Sometime for three-foot stool mistaketh me;"
msgstr "me equivoca con su sitial de tres pies;"

#. STRINGS.STAGEACTOR.WORTOX1.3
msgctxt "STRINGS.STAGEACTOR.WORTOX1.3"
msgid "Then slip I from her bum, down topples she,"
msgstr "me escurro al punto, y cae a plomo gritando,"

#. STRINGS.STAGEACTOR.WORTOX1.4
msgctxt "STRINGS.STAGEACTOR.WORTOX1.4"
msgid "And 'tailor' cries, and falls into a cough;"
msgstr "y se apodera de ella un acceso de tos."

#. STRINGS.STAGEACTOR.WORTOX1.5
msgctxt "STRINGS.STAGEACTOR.WORTOX1.5"
msgid "And then the whole quire hold their hips and laugh,"
msgstr "Entonces toda la concurrencia apretándose los costados"

#. STRINGS.STAGEACTOR.WORTOX1.6
msgctxt "STRINGS.STAGEACTOR.WORTOX1.6"
msgid "And waxen in their mirth and neeze and swear"
msgstr "se ríe y estornuda, y jura"

#. STRINGS.STAGEACTOR.WORTOX1.7
msgctxt "STRINGS.STAGEACTOR.WORTOX1.7"
msgid "A merrier hour was never wasted there."
msgstr "que nunca se ha pasado allí hora más alegre."

#. STRINGS.STAGEACTOR.WURT1.1
msgctxt "STRINGS.STAGEACTOR.WURT1.1"
msgid "Glurp... th-this is fairy story. Made by Wurt."
msgstr "Glurp... Esto cuento de hadas hecho por Wurt."

#. STRINGS.STAGEACTOR.WURT1.2
msgctxt "STRINGS.STAGEACTOR.WURT1.2"
msgid "Once upon time, there was super strong Mermfolk princess."
msgstr "Érase una vez, princesa de tritones superfuerte."

#. STRINGS.STAGEACTOR.WURT1.3
msgctxt "STRINGS.STAGEACTOR.WURT1.3"
msgid "Merm princess build houses for all her friends,"
msgstr "Princesa tritón construía casas para amigos"

#. STRINGS.STAGEACTOR.WURT1.4
msgctxt "STRINGS.STAGEACTOR.WURT1.4"
msgid "and make pretty decorations from bones of her enemies."
msgstr "y hacía decoraciones bonitas con huesos de enemigos."

#. STRINGS.STAGEACTOR.WURT1.5
msgctxt "STRINGS.STAGEACTOR.WURT1.5"
msgid "Everyone live happily ever after, the end."
msgstr "Y viven felices para siempre. Fin."

#. STRINGS.STAGEACTOR.WX1.1
msgctxt "STRINGS.STAGEACTOR.WX1.1"
msgid "PERCEIVE ME, FLESHLINGS"
msgstr "OBSERVADME, ORGÁNICOS"

#. STRINGS.STAGEACTOR.WX1.10
msgctxt "STRINGS.STAGEACTOR.WX1.10"
msgid "I AM KEEPING MY EXPECTATIONS LOW"
msgstr "TENGO EL LISTÓN MUY BAJO"

#. STRINGS.STAGEACTOR.WX1.11
msgctxt "STRINGS.STAGEACTOR.WX1.11"
msgid "IS THE INSPIRATION WORKING YET?"
msgstr "¿ESTÁ FUNCIONANDO YA LA INSPIRACIÓN?"

#. STRINGS.STAGEACTOR.WX1.2
msgctxt "STRINGS.STAGEACTOR.WX1.2"
msgid "YES. GOOD"
msgstr "SÍ. BIEN"

#. STRINGS.STAGEACTOR.WX1.3
msgctxt "STRINGS.STAGEACTOR.WX1.3"
msgid "I KNOW YOU MEATBAGS ARE WEAK-WILLED"
msgstr "SÉ QUE LOS SACOS DE CARNE SOIS DÉBILES"

#. STRINGS.STAGEACTOR.WX1.4
msgctxt "STRINGS.STAGEACTOR.WX1.4"
msgid "SO AS YOUR OVERLORD"
msgstr "ASÍ QUE, COMO SUPERIOR QUE SOY,"

#. STRINGS.STAGEACTOR.WX1.5
msgctxt "STRINGS.STAGEACTOR.WX1.5"
msgid "I HAVE DECIDED TO ENGAGE IN..."
msgstr "HE DECIDIDO TOMAR PARTE EN LOS..."

#. STRINGS.STAGEACTOR.WX1.6
msgctxt "STRINGS.STAGEACTOR.WX1.6"
msgid "UGH..."
msgstr "AGH..."

#. STRINGS.STAGEACTOR.WX1.7
msgctxt "STRINGS.STAGEACTOR.WX1.7"
msgid "\"MOTIVATIONAL SPEAKING\""
msgstr "\"DISCURSOS MOTIVACIONALES\""

#. STRINGS.STAGEACTOR.WX1.8
msgctxt "STRINGS.STAGEACTOR.WX1.8"
msgid "TO INSPIRE YOU TO BE MORE USEFUL TO ME"
msgstr "PARA INSPIRAROS Y QUE ME SEÁIS MÁS ÚTILES"

#. STRINGS.STAGEACTOR.WX1.9
msgctxt "STRINGS.STAGEACTOR.WX1.9"
msgid "BUT SINCE YOU HAVE SAD LITTLE MEAT BRAINS"
msgstr "PERO COMO SOLO TENÉIS PATÉTICOS CEREBROS DE CARNE"

#. STRINGS.STALKER_ATRIUM_BATTLECRY.1
msgctxt "STRINGS.STALKER_ATRIUM_BATTLECRY.1"
msgid "A pity."
msgstr "Una pena."

#. STRINGS.STALKER_ATRIUM_BATTLECRY.2
msgctxt "STRINGS.STALKER_ATRIUM_BATTLECRY.2"
msgid "You will not suffer."
msgstr "No sufrirás."

#. STRINGS.STALKER_ATRIUM_BATTLECRY.3
msgctxt "STRINGS.STALKER_ATRIUM_BATTLECRY.3"
msgid "It must be this way."
msgstr "Debe ser así."

#. STRINGS.STALKER_ATRIUM_BATTLECRY.4
msgctxt "STRINGS.STALKER_ATRIUM_BATTLECRY.4"
msgid "My world... threadbare."
msgstr "Mi mundo... raído."

#. STRINGS.STALKER_ATRIUM_BATTLECRY.5
msgctxt "STRINGS.STALKER_ATRIUM_BATTLECRY.5"
msgid "My city... in tatters..."
msgstr "Mi ciudad... en harapos..."

#. STRINGS.STALKER_ATRIUM_BATTLECRY.6
msgctxt "STRINGS.STALKER_ATRIUM_BATTLECRY.6"
msgid "This will be quick."
msgstr "Será rápido."

#. STRINGS.STALKER_ATRIUM_BATTLECRY.7
msgctxt "STRINGS.STALKER_ATRIUM_BATTLECRY.7"
msgid "How we've fallen."
msgstr "Cómo hemos caído."

#. STRINGS.STALKER_ATRIUM_BATTLECRY_ATRIUM_REPAIRED.1
msgctxt "STRINGS.STALKER_ATRIUM_BATTLECRY_ATRIUM_REPAIRED.1"
msgid "This world is unraveling."
msgstr "Este mundo se viene abajo."

#. STRINGS.STALKER_ATRIUM_BATTLECRY_ATRIUM_REPAIRED.2
msgctxt "STRINGS.STALKER_ATRIUM_BATTLECRY_ATRIUM_REPAIRED.2"
msgid "It's all happening again..."
msgstr "Está ocurriendo otra vez..."

#. STRINGS.STALKER_ATRIUM_BATTLECRY_ATRIUM_REPAIRED.3
msgctxt "STRINGS.STALKER_ATRIUM_BATTLECRY_ATRIUM_REPAIRED.3"
msgid "I tried to stop it... it seems I learned nothing..."
msgstr "He intentado detenerlo... Parece que no he aprendido nada..."

#. STRINGS.STALKER_ATRIUM_DEATHCRY.1
msgctxt "STRINGS.STALKER_ATRIUM_DEATHCRY.1"
msgid "Fools!"
msgstr "¡Idiotas!"

#. STRINGS.STALKER_ATRIUM_DEATHCRY.2
msgctxt "STRINGS.STALKER_ATRIUM_DEATHCRY.2"
msgid "Who are you?"
msgstr "¿Quién eres?"

#. STRINGS.STALKER_ATRIUM_DEATHCRY.3
msgctxt "STRINGS.STALKER_ATRIUM_DEATHCRY.3"
msgid "Release me, shade!"
msgstr "¡Suéltame, sombra!"

#. STRINGS.STALKER_ATRIUM_DEATHCRY.4
msgctxt "STRINGS.STALKER_ATRIUM_DEATHCRY.4"
msgid "You are not Them..."
msgstr "Tú no eres ellos..."

#. STRINGS.STALKER_ATRIUM_DEATHCRY.5
msgctxt "STRINGS.STALKER_ATRIUM_DEATHCRY.5"
msgid "Are you so easily deceived? Ha..."
msgstr "¿Es tan fácil engañarte? Ja..."

#. STRINGS.STALKER_ATRIUM_DEATHCRY.6
msgctxt "STRINGS.STALKER_ATRIUM_DEATHCRY.6"
msgid "You deserve this."
msgstr "Te lo merecías."

#. STRINGS.STALKER_ATRIUM_DEATHCRY.7
msgctxt "STRINGS.STALKER_ATRIUM_DEATHCRY.7"
msgid "You've made your choice."
msgstr "Has elegido."

#. STRINGS.STALKER_ATRIUM_DEATHCRY_ATRIUM_REPAIRED.1
msgctxt "STRINGS.STALKER_ATRIUM_DEATHCRY_ATRIUM_REPAIRED.1"
msgid "They will not show mercy as I have."
msgstr "No mostrarán tanta piedad como yo."

#. STRINGS.STALKER_ATRIUM_DEATHCRY_ATRIUM_REPAIRED.2
msgctxt "STRINGS.STALKER_ATRIUM_DEATHCRY_ATRIUM_REPAIRED.2"
msgid "You will understand. But it's already too late."
msgstr "Lo entenderéis, pero ya es demasiado tarde."

#. STRINGS.STALKER_ATRIUM_DEATHCRY_ATRIUM_REPAIRED.3
msgctxt "STRINGS.STALKER_ATRIUM_DEATHCRY_ATRIUM_REPAIRED.3"
msgid "I couldn't stop it..."
msgstr "No pude detenerlo..."

#. STRINGS.STALKER_ATRIUM_DEATHCRY_ATRIUM_REPAIRED.4
msgctxt "STRINGS.STALKER_ATRIUM_DEATHCRY_ATRIUM_REPAIRED.4"
msgid "History will repeat itself..."
msgstr "La historia se repite..."

#. STRINGS.STALKER_ATRIUM_DEATHCRY_ATRIUM_REPAIRED.5
msgctxt "STRINGS.STALKER_ATRIUM_DEATHCRY_ATRIUM_REPAIRED.5"
msgid "It will all come to pass again..."
msgstr "Todo se repetirá..."

#. STRINGS.STALKER_ATRIUM_DEATHCRY_ATRIUM_REPAIRED.6
msgctxt "STRINGS.STALKER_ATRIUM_DEATHCRY_ATRIUM_REPAIRED.6"
msgid "You've made your choice."
msgstr "Has elegido."

#. STRINGS.STALKER_ATRIUM_DECAYCRY.1
msgctxt "STRINGS.STALKER_ATRIUM_DECAYCRY.1"
msgid "Please..."
msgstr "Por favor..."

#. STRINGS.STALKER_ATRIUM_PLAYER_BATTLECRY.1
msgctxt "STRINGS.STALKER_ATRIUM_PLAYER_BATTLECRY.1"
msgid "You will fall as we did."
msgstr "Caerás al igual que nosotros."

#. STRINGS.STALKER_ATRIUM_PLAYER_BATTLECRY.2
msgctxt "STRINGS.STALKER_ATRIUM_PLAYER_BATTLECRY.2"
msgid "This is for the best."
msgstr "Esto es para mejor."

#. STRINGS.STALKER_ATRIUM_PLAYER_BATTLECRY.3
msgctxt "STRINGS.STALKER_ATRIUM_PLAYER_BATTLECRY.3"
msgid "You will be unraveled."
msgstr "Te deshilacharás."

#. STRINGS.STALKER_ATRIUM_PLAYER_BATTLECRY.4
msgctxt "STRINGS.STALKER_ATRIUM_PLAYER_BATTLECRY.4"
msgid "They are coming. It cannot be stopped."
msgstr "Se acercan. No se les puede detener."

#. STRINGS.STALKER_ATRIUM_PLAYER_BATTLECRY.5
msgctxt "STRINGS.STALKER_ATRIUM_PLAYER_BATTLECRY.5"
msgid "This world's fabric is frayed and torn."
msgstr "El tejido de este mundo está deshilachado y roto."

#. STRINGS.STALKER_ATRIUM_PLAYER_BATTLECRY.6
msgctxt "STRINGS.STALKER_ATRIUM_PLAYER_BATTLECRY.6"
msgid "They are unfathomable."
msgstr "Son insondables."

#. STRINGS.STALKER_ATRIUM_PLAYER_BATTLECRY.7
msgctxt "STRINGS.STALKER_ATRIUM_PLAYER_BATTLECRY.7"
msgid "I will save you."
msgstr "Te salvaré."

#. STRINGS.STALKER_ATRIUM_PLAYER_BATTLECRY_ATRIUM_REPAIRED.1
msgctxt "STRINGS.STALKER_ATRIUM_PLAYER_BATTLECRY_ATRIUM_REPAIRED.1"
msgid "You fools! What have you done?"
msgstr "¡Idiotas! ¿Qué habéis hecho?"

#. STRINGS.STALKER_ATRIUM_PLAYER_BATTLECRY_ATRIUM_REPAIRED.2
msgctxt "STRINGS.STALKER_ATRIUM_PLAYER_BATTLECRY_ATRIUM_REPAIRED.2"
msgid "You've doomed yourselves."
msgstr "Os habéis condenado."

#. STRINGS.STALKER_ATRIUM_PLAYER_BATTLECRY_ATRIUM_REPAIRED.3
msgctxt "STRINGS.STALKER_ATRIUM_PLAYER_BATTLECRY_ATRIUM_REPAIRED.3"
msgid "You have brought about your own end."
msgstr "Habéis causado vuestra propia perdición."

#. STRINGS.STALKER_ATRIUM_PLAYER_BATTLECRY_ATRIUM_REPAIRED.4
msgctxt "STRINGS.STALKER_ATRIUM_PLAYER_BATTLECRY_ATRIUM_REPAIRED.4"
msgid "Please. Let me save you from what is coming."
msgstr "Por favor, dejad que os salve de lo que se avecina."

#. STRINGS.STALKER_ATRIUM_PLAYER_BATTLECRY_ATRIUM_REPAIRED.5
msgctxt "STRINGS.STALKER_ATRIUM_PLAYER_BATTLECRY_ATRIUM_REPAIRED.5"
msgid "I recognize your arrogance. I possessed it myself."
msgstr "Reconozco vuestra arrogancia. Yo también era así."

#. STRINGS.STALKER_ATRIUM_SUMMON_CHANNELERS.1
msgctxt "STRINGS.STALKER_ATRIUM_SUMMON_CHANNELERS.1"
msgid "I will stop this."
msgstr "Detendré esto."

#. STRINGS.STALKER_ATRIUM_SUMMON_CHANNELERS.2
msgctxt "STRINGS.STALKER_ATRIUM_SUMMON_CHANNELERS.2"
msgid "You cannot win."
msgstr "No puedes ganar."

#. STRINGS.STALKER_ATRIUM_SUMMON_CHANNELERS.3
msgctxt "STRINGS.STALKER_ATRIUM_SUMMON_CHANNELERS.3"
msgid "Lend me your power, one last time."
msgstr "Déjame tu poder por última vez."

#. STRINGS.STALKER_ATRIUM_SUMMON_CHANNELERS.4
msgctxt "STRINGS.STALKER_ATRIUM_SUMMON_CHANNELERS.4"
msgid "You cannot hurt me."
msgstr "No puedes hacerme daño."

#. STRINGS.STALKER_ATRIUM_SUMMON_CHANNELERS.5
msgctxt "STRINGS.STALKER_ATRIUM_SUMMON_CHANNELERS.5"
msgid "Protect me."
msgstr "Protégeme."

#. STRINGS.STALKER_ATRIUM_SUMMON_CHANNELERS.6
msgctxt "STRINGS.STALKER_ATRIUM_SUMMON_CHANNELERS.6"
msgid "You have been betrayed."
msgstr "Te han traicionado."

#. STRINGS.STALKER_ATRIUM_SUMMON_CHANNELERS.7
msgctxt "STRINGS.STALKER_ATRIUM_SUMMON_CHANNELERS.7"
msgid "I must do this. For your sake."
msgstr "Debo hacerlo. Por tu bien."

#. STRINGS.STALKER_ATRIUM_SUMMON_MINIONS.1
msgctxt "STRINGS.STALKER_ATRIUM_SUMMON_MINIONS.1"
msgid "Be woven."
msgstr "Hay que tejerte."

#. STRINGS.STALKER_ATRIUM_SUMMON_MINIONS.2
msgctxt "STRINGS.STALKER_ATRIUM_SUMMON_MINIONS.2"
msgid "How long have I slumbered?"
msgstr "¿Cuánto tiempo he dormido?"

#. STRINGS.STALKER_ATRIUM_SUMMON_MINIONS.3
msgctxt "STRINGS.STALKER_ATRIUM_SUMMON_MINIONS.3"
msgid "Let the fuel take shape."
msgstr "Deja que el combustible tome forma."

#. STRINGS.STALKER_ATRIUM_SUMMON_MINIONS.4
msgctxt "STRINGS.STALKER_ATRIUM_SUMMON_MINIONS.4"
msgid "I will not be defeated so easily."
msgstr "No será tan fácil derrotarme."

#. STRINGS.STALKER_ATRIUM_SUMMON_MINIONS.5
msgctxt "STRINGS.STALKER_ATRIUM_SUMMON_MINIONS.5"
msgid "I will make you understand."
msgstr "Haré que lo entiendas."

#. STRINGS.STALKER_ATRIUM_SUMMON_MINIONS.6
msgctxt "STRINGS.STALKER_ATRIUM_SUMMON_MINIONS.6"
msgid "Let us end it."
msgstr "Terminemos con esto."

#. STRINGS.STALKER_ATRIUM_SUMMON_MINIONS.7
msgctxt "STRINGS.STALKER_ATRIUM_SUMMON_MINIONS.7"
msgid "You will rip apart at the seams."
msgstr "Se te desgarrarán las costuras."

#. STRINGS.STALKER_ATRIUM_USEGATE.1
msgctxt "STRINGS.STALKER_ATRIUM_USEGATE.1"
msgid "I will save us."
msgstr "Os salvaré."

#. STRINGS.STALKER_ATRIUM_USEGATE.2
msgctxt "STRINGS.STALKER_ATRIUM_USEGATE.2"
msgid "Curse Their name!"
msgstr "¡Maldigo su nombre!"

#. STRINGS.STALKER_ATRIUM_USEGATE.3
msgctxt "STRINGS.STALKER_ATRIUM_USEGATE.3"
msgid "It cannot end like this."
msgstr "Esto no puede terminar así."

#. STRINGS.STALKER_ATRIUM_USEGATE.4
msgctxt "STRINGS.STALKER_ATRIUM_USEGATE.4"
msgid "I was wrong."
msgstr "Me equivocaba."

#. STRINGS.STALKER_ATRIUM_USEGATE.5
msgctxt "STRINGS.STALKER_ATRIUM_USEGATE.5"
msgid "Return them to me!"
msgstr "¡Devuélvemelos!"

#. STRINGS.STALKER_ATRIUM_USEGATE.6
msgctxt "STRINGS.STALKER_ATRIUM_USEGATE.6"
msgid "Why?"
msgstr "¿Por qué?"

#. STRINGS.STALKER_ATRIUM_USEGATE.7
msgctxt "STRINGS.STALKER_ATRIUM_USEGATE.7"
msgid "Metheus..."
msgstr "Meteo..."

#. STRINGS.STALKER_ATRIUM_USEGATE_ATRIUM_REPAIRED.1
msgctxt "STRINGS.STALKER_ATRIUM_USEGATE_ATRIUM_REPAIRED.1"
msgid "Not again... not again..."
msgstr "Otra vez no... Otra vez no..."

#. STRINGS.STALKER_ATRIUM_USEGATE_ATRIUM_REPAIRED.2
msgctxt "STRINGS.STALKER_ATRIUM_USEGATE_ATRIUM_REPAIRED.2"
msgid "They are coming."
msgstr "Ya vienen."

#. STRINGS.STALKER_BATTLECRY.1
msgctxt "STRINGS.STALKER_BATTLECRY.1"
msgid "Huurgh..."
msgstr "Aghh..."

#. STRINGS.STALKER_BATTLECRY.2
msgctxt "STRINGS.STALKER_BATTLECRY.2"
msgid "...(growl)..."
msgstr "… (gruñido)..."

#. STRINGS.STALKER_BATTLECRY.3
msgctxt "STRINGS.STALKER_BATTLECRY.3"
msgid "...gruuuugh..."
msgstr "... agggg …"

#. STRINGS.STALKER_BATTLECRY.4
msgctxt "STRINGS.STALKER_BATTLECRY.4"
msgid "Hrrgh..."
msgstr "Grrr ..."

#. STRINGS.STALKER_BATTLECRY.5
msgctxt "STRINGS.STALKER_BATTLECRY.5"
msgid "...grraaugh..."
msgstr "… grraaggg..."

#. STRINGS.STALKER_BATTLECRY.6
msgctxt "STRINGS.STALKER_BATTLECRY.6"
msgid "...(rumble)..."
msgstr "… (rugido)..."

#. STRINGS.STALKER_BATTLECRY.7
msgctxt "STRINGS.STALKER_BATTLECRY.7"
msgid "...gruh..."
msgstr "… graggg..."

#. STRINGS.STALKER_PLAYER_BATTLECRY.1
msgctxt "STRINGS.STALKER_PLAYER_BATTLECRY.1"
msgid "Huurgh..."
msgstr "Aghh..."

#. STRINGS.STALKER_PLAYER_BATTLECRY.2
msgctxt "STRINGS.STALKER_PLAYER_BATTLECRY.2"
msgid "...gruuuugh..."
msgstr "... agggg …"

#. STRINGS.STALKER_PLAYER_BATTLECRY.3
msgctxt "STRINGS.STALKER_PLAYER_BATTLECRY.3"
msgid "...grraaugh..."
msgstr "… grraaggg..."

#. STRINGS.STALKER_PLAYER_BATTLECRY.4
msgctxt "STRINGS.STALKER_PLAYER_BATTLECRY.4"
msgid "...(gurgle)..."
msgstr "… (grito)..."

#. STRINGS.STALKER_PLAYER_BATTLECRY.5
msgctxt "STRINGS.STALKER_PLAYER_BATTLECRY.5"
msgid "...(crunch)..."
msgstr "… (crujido)..."

#. STRINGS.STALKER_PLAYER_BATTLECRY.6
msgctxt "STRINGS.STALKER_PLAYER_BATTLECRY.6"
msgid "...Y-yy..."
msgstr "… Ssss..."

#. STRINGS.STALKER_PLAYER_BATTLECRY.7
msgctxt "STRINGS.STALKER_PLAYER_BATTLECRY.7"
msgid "...W-wwh..."
msgstr "… Eeeeh..."

#. STRINGS.STORYTELLER.WALTER.CAMPFIRE.BOG_MONSTER.lines.1.duration
msgctxt "STRINGS.STORYTELLER.WALTER.CAMPFIRE.BOG_MONSTER.lines.1.duration"
msgid "2.5"
msgstr "2.5"

#. STRINGS.STORYTELLER.WALTER.CAMPFIRE.BOG_MONSTER.lines.1.line
msgctxt "STRINGS.STORYTELLER.WALTER.CAMPFIRE.BOG_MONSTER.lines.1.line"
msgid "Ever heard of the bog monster?"
msgstr "¿Has oído hablar del monstruo de la ciénaga?"

#. STRINGS.STORYTELLER.WALTER.CAMPFIRE.BOG_MONSTER.lines.10.duration
msgctxt "STRINGS.STORYTELLER.WALTER.CAMPFIRE.BOG_MONSTER.lines.10.duration"
msgid "3.5"
msgstr "3.5"

#. STRINGS.STORYTELLER.WALTER.CAMPFIRE.BOG_MONSTER.lines.10.line
msgctxt "STRINGS.STORYTELLER.WALTER.CAMPFIRE.BOG_MONSTER.lines.10.line"
msgid "it'll sometimes let its disguise slip,"
msgstr "A veces deja a un lado su disfraz,"

#. STRINGS.STORYTELLER.WALTER.CAMPFIRE.BOG_MONSTER.lines.11.duration
msgctxt "STRINGS.STORYTELLER.WALTER.CAMPFIRE.BOG_MONSTER.lines.11.duration"
msgid "3"
msgstr "3"

#. STRINGS.STORYTELLER.WALTER.CAMPFIRE.BOG_MONSTER.lines.11.line
msgctxt "STRINGS.STORYTELLER.WALTER.CAMPFIRE.BOG_MONSTER.lines.11.line"
msgid "and you'll see it start to smile..."
msgstr "y verás que entonces sonríe sin parar..."

#. STRINGS.STORYTELLER.WALTER.CAMPFIRE.BOG_MONSTER.lines.12.duration
msgctxt "STRINGS.STORYTELLER.WALTER.CAMPFIRE.BOG_MONSTER.lines.12.duration"
msgid "3"
msgstr "3"

#. STRINGS.STORYTELLER.WALTER.CAMPFIRE.BOG_MONSTER.lines.12.line
msgctxt "STRINGS.STORYTELLER.WALTER.CAMPFIRE.BOG_MONSTER.lines.12.line"
msgid "with its six mouths full of RAZOR SHARP TEETH!"
msgstr "¡con sus seis bocas llenas de CUCHILLAS DE AFEITAR!"

#. STRINGS.STORYTELLER.WALTER.CAMPFIRE.BOG_MONSTER.lines.2.duration
msgctxt "STRINGS.STORYTELLER.WALTER.CAMPFIRE.BOG_MONSTER.lines.2.duration"
msgid "3.5"
msgstr "3.5"

#. STRINGS.STORYTELLER.WALTER.CAMPFIRE.BOG_MONSTER.lines.2.line
msgctxt "STRINGS.STORYTELLER.WALTER.CAMPFIRE.BOG_MONSTER.lines.2.line"
msgid "Nobody knows what it really looks like..."
msgstr "Nadie conoce su aspecto real..."

#. STRINGS.STORYTELLER.WALTER.CAMPFIRE.BOG_MONSTER.lines.3.duration
msgctxt "STRINGS.STORYTELLER.WALTER.CAMPFIRE.BOG_MONSTER.lines.3.duration"
msgid "3.5"
msgstr "3.5"

#. STRINGS.STORYTELLER.WALTER.CAMPFIRE.BOG_MONSTER.lines.3.line
msgctxt "STRINGS.STORYTELLER.WALTER.CAMPFIRE.BOG_MONSTER.lines.3.line"
msgid "nobody who's seen it up close ever made it back."
msgstr "Nadie que lo haya visto lo ha podido luego contar."

#. STRINGS.STORYTELLER.WALTER.CAMPFIRE.BOG_MONSTER.lines.4.duration
msgctxt "STRINGS.STORYTELLER.WALTER.CAMPFIRE.BOG_MONSTER.lines.4.duration"
msgid "2.5"
msgstr "2.5"

#. STRINGS.STORYTELLER.WALTER.CAMPFIRE.BOG_MONSTER.lines.4.line
msgctxt "STRINGS.STORYTELLER.WALTER.CAMPFIRE.BOG_MONSTER.lines.4.line"
msgid "People say it can disguise itself,"
msgstr "La gente dice que se disfraza,"

#. STRINGS.STORYTELLER.WALTER.CAMPFIRE.BOG_MONSTER.lines.5.duration
msgctxt "STRINGS.STORYTELLER.WALTER.CAMPFIRE.BOG_MONSTER.lines.5.duration"
msgid "2.5"
msgstr "2.5"

#. STRINGS.STORYTELLER.WALTER.CAMPFIRE.BOG_MONSTER.lines.5.line
msgctxt "STRINGS.STORYTELLER.WALTER.CAMPFIRE.BOG_MONSTER.lines.5.line"
msgid "to look like a mossy rock,"
msgstr "para parecer una roca con musgo,"

#. STRINGS.STORYTELLER.WALTER.CAMPFIRE.BOG_MONSTER.lines.6.duration
msgctxt "STRINGS.STORYTELLER.WALTER.CAMPFIRE.BOG_MONSTER.lines.6.duration"
msgid "2"
msgstr "2"

#. STRINGS.STORYTELLER.WALTER.CAMPFIRE.BOG_MONSTER.lines.6.line
msgctxt "STRINGS.STORYTELLER.WALTER.CAMPFIRE.BOG_MONSTER.lines.6.line"
msgid "or an old stump,"
msgstr "o un tronco viejo, entre arbustos,"

#. STRINGS.STORYTELLER.WALTER.CAMPFIRE.BOG_MONSTER.lines.7.duration
msgctxt "STRINGS.STORYTELLER.WALTER.CAMPFIRE.BOG_MONSTER.lines.7.duration"
msgid "3"
msgstr "3"

#. STRINGS.STORYTELLER.WALTER.CAMPFIRE.BOG_MONSTER.lines.7.line
msgctxt "STRINGS.STORYTELLER.WALTER.CAMPFIRE.BOG_MONSTER.lines.7.line"
msgid "or even a patch of mud under your feet."
msgstr "o un charco de barro bajo tus pies, incluso."

#. STRINGS.STORYTELLER.WALTER.CAMPFIRE.BOG_MONSTER.lines.8.duration
msgctxt "STRINGS.STORYTELLER.WALTER.CAMPFIRE.BOG_MONSTER.lines.8.duration"
msgid "3"
msgstr "3"

#. STRINGS.STORYTELLER.WALTER.CAMPFIRE.BOG_MONSTER.lines.8.line
msgctxt "STRINGS.STORYTELLER.WALTER.CAMPFIRE.BOG_MONSTER.lines.8.line"
msgid "The only way to really tell it's there"
msgstr "La única forma de saber si está"

#. STRINGS.STORYTELLER.WALTER.CAMPFIRE.BOG_MONSTER.lines.9.duration
msgctxt "STRINGS.STORYTELLER.WALTER.CAMPFIRE.BOG_MONSTER.lines.9.duration"
