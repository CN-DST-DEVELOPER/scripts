msgstr ""

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.KITCOONDEN_KIT
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.KITCOONDEN_KIT"
msgid "We'll make a nice home for the kitcoons."
msgstr "Les haremos una casita a los gapachitos."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.KITCOON_DECIDUOUS
