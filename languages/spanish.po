msgstr "Se habrá ido a dar una vuelta."

#. STRINGS.CHARACTERS.WOODIE.ACTIONFAIL.YOTB_STARTCONTEST.RIGHTTHERE
msgctxt "STRINGS.CHARACTERS.WOODIE.ACTIONFAIL.YOTB_STARTCONTEST.RIGHTTHERE"
msgid "Hm. Busy."
msgstr "Ah, está ocupado."

#. STRINGS.CHARACTERS.WOODIE.ACTIONFAIL.YOTB_UNLOCKSKIN.ALREADYKNOWN
msgctxt "STRINGS.CHARACTERS.WOODIE.ACTIONFAIL.YOTB_UNLOCKSKIN.ALREADYKNOWN"
msgid "Nothin' new here."
msgstr "Nada nuevo por aquí."

#. STRINGS.CHARACTERS.WOODIE.ACTIONFAIL_GENERIC
msgctxt "STRINGS.CHARACTERS.WOODIE.ACTIONFAIL_GENERIC"
msgid "Sorry, I can't do that."
msgstr "Lo siento, no puedo hacer eso."

#. STRINGS.CHARACTERS.WOODIE.ANNOUNCE_ACCOMPLISHMENT
msgctxt "STRINGS.CHARACTERS.WOODIE.ANNOUNCE_ACCOMPLISHMENT"
msgid "Lucy is going to be so proud of me!"
msgstr "¡Lucy va a estar tan orgullosa de mí!"

#. STRINGS.CHARACTERS.WOODIE.ANNOUNCE_ACCOMPLISHMENT_DONE
msgctxt "STRINGS.CHARACTERS.WOODIE.ANNOUNCE_ACCOMPLISHMENT_DONE"
msgid "That's a wrap, eh!"
msgstr "¡Qué bien terminado, eh!"

#. STRINGS.CHARACTERS.WOODIE.ANNOUNCE_ACIDBATS
msgctxt "STRINGS.CHARACTERS.WOODIE.ANNOUNCE_ACIDBATS"
msgid "You hear something, Lucy?"
msgstr "¿Has oído eso, Lucy?"

#. STRINGS.CHARACTERS.WOODIE.ANNOUNCE_ADVENTUREFAIL
msgctxt "STRINGS.CHARACTERS.WOODIE.ANNOUNCE_ADVENTUREFAIL"
msgid "Oh well. I gave it a good try."
msgstr "En fin. Lo intenté como pude."

#. STRINGS.CHARACTERS.WOODIE.ANNOUNCE_ANTLION_SINKHOLE.1
msgctxt "STRINGS.CHARACTERS.WOODIE.ANNOUNCE_ANTLION_SINKHOLE.1"
msgid "Pothole incoming."
msgstr "Pronto será una sima."

#. STRINGS.CHARACTERS.WOODIE.ANNOUNCE_ANTLION_SINKHOLE.2
msgctxt "STRINGS.CHARACTERS.WOODIE.ANNOUNCE_ANTLION_SINKHOLE.2"
msgid "Take cover!"
msgstr "¡Hay que ponerse a cubierto!"

#. STRINGS.CHARACTERS.WOODIE.ANNOUNCE_ANTLION_SINKHOLE.3
msgctxt "STRINGS.CHARACTERS.WOODIE.ANNOUNCE_ANTLION_SINKHOLE.3"
