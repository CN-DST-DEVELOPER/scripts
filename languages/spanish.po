msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.COSTUME_MIRROR_BODY"
msgid "They can't ban you from the theater if you're part of the cast!"
msgstr "¡No pueden echarte del teatro si eres parte del elenco!"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.COSTUME_PRINCESS_BODY
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.COSTUME_PRINCESS_BODY"
msgid "It definitely matches the head."
msgstr "A juego con la cabeza."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.COSTUME_QUEEN_BODY
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.COSTUME_QUEEN_BODY"
