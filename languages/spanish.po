msgstr "Proporciona protección."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.SLURTLEHOLE
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.SLURTLEHOLE"
