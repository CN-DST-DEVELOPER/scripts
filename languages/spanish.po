msgstr "Qué mala pata."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.MERMCORPSE.REVIVING
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.MERMCORPSE.REVIVING"
