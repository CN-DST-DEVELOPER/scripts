msgstr "Puf... Me estoy asando..."

#. STRINGS.CHARACTERS.WARLY.ANNOUNCE_MITEGLAND_DEBUFF.2
msgctxt "STRINGS.CHARACTERS.WARLY.ANNOUNCE_MITEGLAND_DEBUFF.2"
msgid "My stomach is burning!"
msgstr "¡Me arde el estómago!"

#. STRINGS.CHARACTERS.WARLY.ANNOUNCE_MITEGLAND_DEBUFF_DONE
msgctxt "STRINGS.CHARACTERS.WARLY.ANNOUNCE_MITEGLAND_DEBUFF_DONE"
