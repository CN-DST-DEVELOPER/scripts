msgstr "Esos ojos han visto cosas."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.MERMGUARD_SHADOW
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.MERMGUARD_SHADOW"
msgid "There's no quit in these fellas."
msgstr "Estos chicos no se rinden nunca."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.MERMHAT
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.MERMHAT"
msgid "Not sure it'll fit over my luxurious beard."
msgstr "No estoy seguro de que encaje sobre mi frondosa barba."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.MERMHEAD.BURNT
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.MERMHEAD.BURNT"
msgid "Amazingly, it smells even worse now."
msgstr "Sorprendentemente, huele aún peor ahora."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.MERMHEAD.GENERIC
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.MERMHEAD.GENERIC"
