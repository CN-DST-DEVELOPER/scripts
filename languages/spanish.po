msgstr "¡Ahí vamos!"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.YOTC_CARRAT_GYM_STAMINA_ITEM
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.YOTC_CARRAT_GYM_STAMINA_ITEM"
