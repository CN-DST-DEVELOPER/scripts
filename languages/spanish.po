msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.TROPHYSCALE_FISH.OWNER"
msgid "Weight: {weight}\nCaught by: {owner}\nI do have a bit of experience with fishing!"
msgstr "Peso: {weight}\nCapturado por: {owner}\n¡Tengo cierta experiencia pescando!"

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.TROPHYSCALE_FISH.OWNER_HEAVY
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.TROPHYSCALE_FISH.OWNER_HEAVY"
