msgstr "Ugh, ¿vas a seguirme a todas partes?"

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_SHADOWLEVEL_ITEM
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_SHADOWLEVEL_ITEM"
msgid "\nMy shadow puppets should be able to draw from its power..."
msgstr "\nMis marionetas sombrías deberían ser capaces de aprovechar su poder..."

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_SHADOWTHRALL_STEALTH
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_SHADOWTHRALL_STEALTH"
msgid "Who bit me? Show yourself, coward!"
msgstr "¿Quién me ha mordido? ¡Muéstrate, cobarde!"

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_SHADOW_RIFT_MAX
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_SHADOW_RIFT_MAX"
