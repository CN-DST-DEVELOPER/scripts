msgstr "¡Wickerbottom dice que ya no podemos ser amigos!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.WORMWOOD.REVIVER
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.WORMWOOD.REVIVER"
msgid "%s is really rooting for us!"
msgstr "¡%s apuesta por nosotros!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.WORMWOOD_MUTANTPROXY_CARRAT.DEAD
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.WORMWOOD_MUTANTPROXY_CARRAT.DEAD"
msgid "Oh no!"
msgstr "¡Oh, no!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.WORMWOOD_MUTANTPROXY_CARRAT.GENERIC
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.WORMWOOD_MUTANTPROXY_CARRAT.GENERIC"
