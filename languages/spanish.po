msgstr "n/a"

#. STRINGS.SKIN_DESCRIPTIONS.minerhat_western
msgctxt "STRINGS.SKIN_DESCRIPTIONS.minerhat_western"
msgid "There's gold in them caves!"
msgstr "¡Hay oro en las cuevas!"

#. STRINGS.SKIN_DESCRIPTIONS.minisign_fantasy
msgctxt "STRINGS.SKIN_DESCRIPTIONS.minisign_fantasy"
msgid "Display your flowery prose for all to see."
msgstr "Expón tu fina prosa para que todos puedan deleitarse con ella."

