msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.FUMAROLEHAMMER.WARM"
msgid "It's like wearin' a cozy pair of long johns while I work."
msgstr "Es como llevar un buen par de pantalones térmicos mientras trabajo."

