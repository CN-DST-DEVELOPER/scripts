msgstr "¡Oooh, qué divertido!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.SLINGSHOTAMMO_GOLD
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.SLINGSHOTAMMO_GOLD"
msgid "Oooh, how fun!"
msgstr "¡Oooh, qué divertido!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.SLINGSHOTAMMO_GUNPOWDER
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.SLINGSHOTAMMO_GUNPOWDER"
msgid "Oooh, how fun!"
msgstr "¡Oooh, qué divertido!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.SLINGSHOTAMMO_HONEY
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.SLINGSHOTAMMO_HONEY"
msgid "Oooh, how fun!"
msgstr "¡Oooh, qué divertido!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.SLINGSHOTAMMO_HORRORFUEL
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.SLINGSHOTAMMO_HORRORFUEL"
msgid "Oooh, how fun!"
msgstr "¡Oooh, qué divertido!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.SLINGSHOTAMMO_LUNARPLANTHUSK
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.SLINGSHOTAMMO_LUNARPLANTHUSK"
msgid "Oooh, how fun!"
msgstr "¡Oooh, qué divertido!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.SLINGSHOTAMMO_MARBLE
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.SLINGSHOTAMMO_MARBLE"
