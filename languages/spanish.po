msgid "Bonjour, Mademoiselle Abigail!"
msgstr "¡Bonjour, Mademoiselle Abigail!"

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.ABIGAIL.LEVEL2.1
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.ABIGAIL.LEVEL2.1"
msgid "Bonjour, Mademoiselle Abigail!"
msgstr "¡Bonjour, Mademoiselle Abigail!"

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.ABIGAIL.LEVEL2.2
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.ABIGAIL.LEVEL2.2"
