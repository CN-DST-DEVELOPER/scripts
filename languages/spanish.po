msgstr "only_used_by_willow"

#. STRINGS.CHARACTERS.WENDY.ACTIONFAIL.CASTSPELL.TERRAFORM_TOO_SOON
msgctxt "STRINGS.CHARACTERS.WENDY.ACTIONFAIL.CASTSPELL.TERRAFORM_TOO_SOON"
