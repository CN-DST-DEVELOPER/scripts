msgstr "¡Oye, no toques nuestras cosas!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.OTTERDEN.GENERIC
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.OTTERDEN.GENERIC"
msgid "We don't see anything."
msgstr "No vemos nada."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.OTTERDEN.HAS_LOOT
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.OTTERDEN.HAS_LOOT"
