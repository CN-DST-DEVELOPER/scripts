msgstr "Savia dorada y dulce."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.QUAGMIRE_SUGARWOODTREE.WOUNDED
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.QUAGMIRE_SUGARWOODTREE.WOUNDED"
msgid "It looks ill."
msgstr "Parece enfermo."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.QUAGMIRE_SWAMPIG
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.QUAGMIRE_SWAMPIG"
