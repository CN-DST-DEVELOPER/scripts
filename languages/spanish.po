msgstr "¡Es tan solo una boca!"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.SLURPERPELT
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.SLURPERPELT"
msgid "That's WAY too fuzzy."
msgstr "Es MUY peludo."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.SLURPER_PELT
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.SLURPER_PELT"
msgid "That's WAY too fuzzy."
msgstr "Es MUY peludo."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.SLURTLE
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.SLURTLE"
msgid "Just don't seem right."
msgstr "No me gusta un pelo."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.SLURTLEHAT
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.SLURTLEHAT"
msgid "Gotta protect my noggin! I keep my ideas in there."
msgstr "¡Tengo que proteger la cabeza! Ahí guardo las ideas."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.SLURTLEHOLE
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.SLURTLEHOLE"
msgid "There's something gross in there."
msgstr "Hay algo asqueroso ahí dentro."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.SLURTLESLIME
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.SLURTLESLIME"
msgid "I hock those up after a long day at the factory."
msgstr "Eso es lo que escupo después de un largo día en la fábrica."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.SLURTLE_SHELLPIECES
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.SLURTLE_SHELLPIECES"
msgid "Broke, but I might salvage something useful."
msgstr "Se ha roto, pero podría reciclarse en algo útil."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.SMALLBIRD.GENERIC
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.SMALLBIRD.GENERIC"
msgid "Ha! You're so tiny!"
msgstr "¡Ja! ¡Eres muy pequeño!"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.SMALLBIRD.HUNGRY
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.SMALLBIRD.HUNGRY"
msgid "You feelin' a bit peckish? Ha!"
msgstr "¿Tienes un poco de hambre? ¡Ja!"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.SMALLBIRD.SLEEPING
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.SMALLBIRD.SLEEPING"
msgid "Sleep well, fluffnugget."
msgstr "Que duermas bien, pajarillo."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.SMALLBIRD.STARVING
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.SMALLBIRD.STARVING"
msgid "Yeesh, you ain't lookin' so good."
msgstr "Uf, no tienes buena pinta."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.SMALLGHOST
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.SMALLGHOST"
msgid "Y'know, you're awful cute for a grim reminder of my own mortality."
msgstr "¿Sabes? Para ser un lúgubre recordatorio de mi propia mortalidad eres de lo más mono."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.SMALLMEAT
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.SMALLMEAT"
msgid "Looks like grub to me."
msgstr "A mí me parece que es comida."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.SMALLMEAT_DRIED
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.SMALLMEAT_DRIED"
msgid "Meat to go."
msgstr "Carne para llevar."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.SNAPPER
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.SNAPPER"
msgid "You keep yer spit to yourself now, buddy."
msgstr "Guárdate tu saliva para ti, amigo."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.SNOWBALL_ITEM
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.SNOWBALL_ITEM"
msgid "This could be fun."
msgstr "Esto podría ser divertido."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.SNOWMAN.GENERIC
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.SNOWMAN.GENERIC"
msgid "Not exactly a marvel of engineering."
msgstr "No es precisamente una maravilla de la ingeniería."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.SNOWMAN.SNOWBALL
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.SNOWMAN.SNOWBALL"
msgid "It's a start."
msgstr "Es un comienzo."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.SNURTLE
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.SNURTLE"
msgid "Get along, little snurtle."
msgstr "Adelante, pequeño torturol."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.SOIL_AMENDER.GENERIC
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.SOIL_AMENDER.GENERIC"
msgid "Wouldn't want to take a sip of that stuff."
msgstr "No me tomaría ni un chupito."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.SOIL_AMENDER.SPOILED
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.SOIL_AMENDER.SPOILED"
msgid "That looks like some strong stuff."
msgstr "Tiene pinta de ser bastante fuerte..."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.SOIL_AMENDER.STALE
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.SOIL_AMENDER.STALE"
msgid "This stuff sure takes a while to do its thing."
msgstr "Se toma su tiempo para hacer las cosas, ¿eh?"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.SOIL_AMENDER_FERMENTED
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.SOIL_AMENDER_FERMENTED"
msgid "I don't think it can smell any worse, must mean it's done!"
msgstr "Creo que no podría oler peor, así que fijo que ya está."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.SPAT
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.SPAT"
msgid "Looks like the old foreman. Ha!"
msgstr "Parece el viejo capataz. ¡Ja!"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.SPEAR
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.SPEAR"
msgid "So crude."
msgstr "Qué rudimentaria."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.SPEAR_GUNGNIR
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.SPEAR_GUNGNIR"
msgid "Pretty snazzy weapon there!"
msgstr "¡Qué arma tan elegante!"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.SPEAR_LANCE
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.SPEAR_LANCE"
msgid "Check out this drill bit!"
msgstr "¡Fíjate en esta broca!"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.SPEAR_WATHGRITHR
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.SPEAR_WATHGRITHR"
msgid "This would never pass inspection."
msgstr "Nunca pasaría la inspección."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.SPEAR_WATHGRITHR_LIGHTNING
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.SPEAR_WATHGRITHR_LIGHTNING"
msgid "A lightning spear? What will they think of next?"
msgstr "¿Una lanza eléctrica? ¿Qué será lo siguiente?"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.SPICEPACK
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.SPICEPACK"
msgid "Say, this is some fine bit of engineering!"
msgstr "¡Esto es un buen ejemplo de ingeniería!"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.SPICE_CHILI
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.SPICE_CHILI"
msgid "Just smelling it is making my eyes water."
msgstr "Solo al olerlo ya se me saltan las lágrimas."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.SPICE_GARLIC
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.SPICE_GARLIC"
msgid "Hooboy. That's some smelly dust."
msgstr "Guau. Este polvo sí que huele."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.SPICE_SALT
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.SPICE_SALT"
msgid "I could really go for some potato chips."
msgstr "Me apetecen mucho unas patatas fritas."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.SPICE_SUGAR
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.SPICE_SUGAR"
msgid "Now all I need is some pancakes to pour this over."
msgstr "Ahora solo necesito unas tortitas para poderles echar esto por encima."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.SPIDER.DEAD
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.SPIDER.DEAD"
msgid "No sleeping on the job!"
msgstr "¡No se puede dormir en el trabajo!"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.SPIDER.GENERIC
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.SPIDER.GENERIC"
msgid "I don't like you."
msgstr "No me gustas."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.SPIDER.SLEEPING
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.SPIDER.SLEEPING"
msgid "Get back to work!"
msgstr "¡Vuelve al trabajo!"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.SPIDERCORPSE.BURNING
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.SPIDERCORPSE.BURNING"
msgid "Just to be sure."
msgstr "Hay que asegurarse."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.SPIDERCORPSE.GENERIC
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.SPIDERCORPSE.GENERIC"
msgid "I prefer my spiders dead."
msgstr "Prefiero las arañas muertas."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.SPIDERCORPSE.REVIVING
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.SPIDERCORPSE.REVIVING"
msgid "Here we go again."
msgstr "Otra vez."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.SPIDERDEN
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.SPIDERDEN"
msgid "I'd rather not mess with that."
msgstr "Será mejor que no me meta con eso."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.SPIDERDEN_BEDAZZLER
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.SPIDERDEN_BEDAZZLER"
msgid "Doing some home improvements, kiddo?"
msgstr "¿Andas haciendo mejoras, chavalín?"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.SPIDEREGGSACK
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.SPIDEREGGSACK"
msgid "I think it'd be unwise to plant this."
msgstr "Creo que no sería prudente plantarlo."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.SPIDERGLAND
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.SPIDERGLAND"
msgid "Ha! How indecent."
msgstr "¡Ja! Qué indecente."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.SPIDERHAT
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.SPIDERHAT"
msgid "This is disgusting."
msgstr "Qué repugnante."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.SPIDERHOLE
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.SPIDERHOLE"
msgid "A rock filled with spiders. Great."
msgstr "Una roca llena de arañas. Genial."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.SPIDERHOLE_ROCK
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.SPIDERHOLE_ROCK"
msgid "A rock filled with spiders. Great."
msgstr "Una roca llena de arañas. Genial."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.SPIDERQUEEN
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.SPIDERQUEEN"
msgid "Better stay out of her way."
msgstr "Será mejor que me aleje de ella."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.SPIDERQUEENCORPSE.BURNING
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.SPIDERQUEENCORPSE.BURNING"
msgid "Nothin' comin' back from that."
msgstr "De esta no vuelve."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.SPIDERQUEENCORPSE.GENERIC
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.SPIDERQUEENCORPSE.GENERIC"
msgid "That is one big ol' dead spider."
msgstr "Es una araña muerta. Y de las gordas."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.SPIDERQUEENCORPSE.REVIVING
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.SPIDERQUEENCORPSE.REVIVING"
msgid "That is so gross!"
msgstr "¡Qué asco!"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.SPIDER_DROPPER
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.SPIDER_DROPPER"
msgid "That's a nasty looking spider!"
msgstr "¡Qué araña tan desagradable!"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.SPIDER_HEALER
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.SPIDER_HEALER"
msgid "You're a real stinker, you know that?"
msgstr "Apestas un montonazo, ¿lo sabías?"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.SPIDER_HEALER_ITEM
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.SPIDER_HEALER_ITEM"
msgid "Doesn't look like good eatin' to me."
msgstr "Tiene muy mala pinta..."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.SPIDER_HIDER
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.SPIDER_HIDER"
msgid "You know I can see you, right?"
msgstr "Sabes que puedo verte, ¿no?"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.SPIDER_MOON.DEAD
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.SPIDER_MOON.DEAD"
msgid "Don't get back up."
msgstr "Y no te levantes."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.SPIDER_MOON.GENERIC
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.SPIDER_MOON.GENERIC"
msgid "Urgh! What's wrong with it??"
msgstr "¡Puaj! ¿¿Qué le pasa??"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.SPIDER_MOON.SLEEPING
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.SPIDER_MOON.SLEEPING"
msgid "Down and out. For now."
msgstr "Está K.O. De momento."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.SPIDER_REPELLENT
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.SPIDER_REPELLENT"
msgid "Guess it can only be used by a spider specialist."
msgstr "Supongo que solo lo pueden usar los expertos en arañas."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.SPIDER_SPITTER
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.SPIDER_SPITTER"
msgid "Pfft, I can spit further than that!"
msgstr "¡Uf, yo puedo escupir más lejos!"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.SPIDER_WARRIOR.DEAD
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.SPIDER_WARRIOR.DEAD"
msgid "It's just trying to get out of work."
msgstr "Está tratando de salir de trabajar."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.SPIDER_WARRIOR.GENERIC
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.SPIDER_WARRIOR.GENERIC"
msgid "You'll look better on the underside of my workboot."
msgstr "Estás mejor en la parte inferior de mi bota de trabajo."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.SPIDER_WARRIOR.SLEEPING
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.SPIDER_WARRIOR.SLEEPING"
msgid "Lazy spider."
msgstr "Araña vaga."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.SPIDER_WATER
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.SPIDER_WATER"
msgid "You and your creepy long legs better stay far away from me!"
msgstr "¡Más os vale a ti y a tus patas gigantes y asquerosas no acercaros ni un poquito!"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.SPIDER_WHISTLE
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.SPIDER_WHISTLE"
msgid "Sure wish that kid would hang around a better crowd."
msgstr "Ojalá el crío ese se juntara con una pandilla más decente."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.SPOILED_FISH.GENERIC
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.SPOILED_FISH.GENERIC"
msgid "Such a shame to let good food go to waste."
msgstr "Es una pena malgastar la comida."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.SPOILED_FOOD.GENERIC
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.SPOILED_FOOD.GENERIC"
msgid "Wouldn't touch that with a ten foot pole."
msgstr "No tocaría eso ni con un palo."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.SPORE_MEDIUM.GENERIC
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.SPORE_MEDIUM.GENERIC"
msgid "I've breathed in worse stuff at work."
msgstr "He respirado cosas peores en el trabajo."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.SPORE_MEDIUM.HELD
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.SPORE_MEDIUM.HELD"
msgid "Never hurts to have extra light."
