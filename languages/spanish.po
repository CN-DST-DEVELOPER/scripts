#. STRINGS.CHARACTERS.WINONA.DESCRIBE.MONKEY_MEDIUMHAT
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.MONKEY_MEDIUMHAT"
msgid "Dress for the job you want."
msgstr "Viste acorde con el trabajo que quieres."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.MONKEY_SMALLHAT
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.MONKEY_SMALLHAT"
msgid "Keeps the sun off your head and the hair outta your face."
msgstr "Protege tu cabeza del sol y te sujeta el pelo."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.MONSTERLASAGNA
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.MONSTERLASAGNA"
msgid "Not sure meat's supposed to be that color."
msgstr "No creo que la carne sea de ese color."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.MONSTERMEAT
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.MONSTERMEAT"
msgid "Hooboy! Is that even meat?"
msgstr "¡Anda! ¿Es eso carne?"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.MONSTERMEAT_DRIED
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.MONSTERMEAT_DRIED"
msgid "Drying didn't help none."
msgstr "Secarla no ha servido de nada."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.MONSTERTARTARE
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.MONSTERTARTARE"
msgid "I'm all for getting my daily iron but this goes too far."
msgstr "Estoy a favor de tomar hierro, pero esto es demasiado."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.MOONBASE.BROKEN
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.MOONBASE.BROKEN"
msgid "In need of a good fixin'!"
msgstr "¡Le hace falta una buena reparación!"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.MOONBASE.GENERIC
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.MOONBASE.GENERIC"
msgid "I don't think it's done yet."
msgstr "No creo que esté terminada todavía."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.MOONBASE.MOONSTAFF
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.MOONBASE.MOONSTAFF"
msgid "Moonlight's good for the complexion, hey?"
msgstr "La luz de luna es buena para el cutis, ¿a que sí?"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.MOONBASE.STAFFED
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.MOONBASE.STAFFED"
msgid "Job well done! Now what?"
msgstr "¡Un trabajo bien hecho! ¿Y ahora qué?"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.MOONBASE.WRONGSTAFF
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.MOONBASE.WRONGSTAFF"
msgid "Hm. This wasn't assembled right."
msgstr "Mmm. No estaba bien montado."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.MOONBUTTERFLY.GENERIC
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.MOONBUTTERFLY.GENERIC"
msgid "Cute little fella, aintcha?"
msgstr "Qué criatura tan mona eres, ¿no?"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.MOONBUTTERFLY.HELD
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.MOONBUTTERFLY.HELD"
msgid "So... you like engineerin'?"
msgstr "Y... ¿te gusta la ingeniería?"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.MOONBUTTERFLYWINGS
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.MOONBUTTERFLYWINGS"
msgid "They ain't flyin' no more."
msgstr "Ya no van a volar más."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.MOONBUTTERFLY_SAPLING
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.MOONBUTTERFLY_SAPLING"
msgid "It'll be a nice tree someday."
msgstr "Algún día será un bonito árbol."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.MOONDIAL.CAVE
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.MOONDIAL.CAVE"
msgid "It was impractical to build this here."
msgstr "No fue práctico construir esto aquí."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.MOONDIAL.GENERIC
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.MOONDIAL.GENERIC"
msgid "Must be broke. I can still see the moon."
msgstr "Debe de estar roto. Todavía puedo ver la luna."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.MOONDIAL.GLASSED
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.MOONDIAL.GLASSED"
msgid "Why do I get the feeling something's watchin' me..."
msgstr "¿Por qué me da la sensación de que me están observando?"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.MOONDIAL.NIGHT_FULL
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.MOONDIAL.NIGHT_FULL"
msgid "Full as can be."
msgstr "Lo más llena posible."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.MOONDIAL.NIGHT_NEW
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.MOONDIAL.NIGHT_NEW"
msgid "Brand spanking new moon."
msgstr "Una luna nueva y reluciente."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.MOONDIAL.NIGHT_WANE
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.MOONDIAL.NIGHT_WANE"
msgid "It's waning."
msgstr "Menguante."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.MOONDIAL.NIGHT_WAX
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.MOONDIAL.NIGHT_WAX"
msgid "It's waxing."
msgstr "Creciente."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.MOONGLASS
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.MOONGLASS"
msgid "Can't wait to try this out."
msgstr "Estoy impaciente por probar esto."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.MOONGLASSAXE
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.MOONGLASSAXE"
msgid "Anything to make gettin' firewood easier."
msgstr "Me vale cualquier cosa que haga más fácil conseguir leña."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.MOONGLASS_CHARGED
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.MOONGLASS_CHARGED"
msgid "I'd better hustle, the energy's not gonna last long."
msgstr "Mejor me doy prisa, que dudo que la energía dure mucho."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.MOONGLASS_ROCK
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.MOONGLASS_ROCK"
msgid "Wonder if it's got any special properties."
msgstr "Me pregunto si tiene alguna propiedad especial."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.MOONGLASS_WOBSTER_DEN
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.MOONGLASS_WOBSTER_DEN"
msgid "Wonder what lives in there?"
msgstr "¿Qué habrá viviendo dentro?"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.MOONROCKCRATER
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.MOONROCKCRATER"
msgid "A rock with a hole in it."
msgstr "Una roca con un agujero."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.MOONROCKIDOL
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.MOONROCKIDOL"
msgid "Do I gotta offer it up to something?"
msgstr "¿Tengo que ofrecerle algo?"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.MOONROCKNUGGET
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.MOONROCKNUGGET"
msgid "Woah! What an odd texture."
msgstr "¡Vaya! Qué textura extraña."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.MOONROCKSEED
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.MOONROCKSEED"
msgid "I could learn a thing or two from this."
msgstr "Podría aprender un par de cosas de ella."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.MOONROCK_PIECES
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.MOONROCK_PIECES"
msgid "That's... strange."
msgstr "Qué... extraño."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.MOONSPIDERDEN
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.MOONSPIDERDEN"
msgid "I don't wanna see whatever's in there."
msgstr "No quiero ver lo que sea que está ahí."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.MOONSTORM_GLASS.GENERIC
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.MOONSTORM_GLASS.GENERIC"
msgid "That's some good, workable material there."
msgstr "Ese material es decente y muy práctico."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.MOONSTORM_GLASS.INFUSED
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.MOONSTORM_GLASS.INFUSED"
msgid "It's been powered up."
msgstr "Ya tiene energía."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.MOONSTORM_GOGGLESHAT
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.MOONSTORM_GOGGLESHAT"
msgid "You work with the materials you've got out here."
msgstr "Tenemos que currar con todo lo que pillamos."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.MOONSTORM_SPARK
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.MOONSTORM_SPARK"
msgid "Not quite electricity, but it could still work..."
msgstr "No es electricidad, pero servirá..."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.MOONSTORM_STATIC
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.MOONSTORM_STATIC"
msgid "Looks like an electrical fire waiting to happen."
msgstr "No me sorprendería si empezara a arder."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.MOONSTORM_STATIC_CATCHER
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.MOONSTORM_STATIC_CATCHER"
msgid "Ain't nothin' in there."
msgstr "Ahí no hay nada."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.MOONSTORM_STATIC_ITEM
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.MOONSTORM_STATIC_ITEM"
msgid "The boss really does have a gadget for everything."
msgstr "El jefe tiene cachivaches para todo, ¿eh?"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.MOONSTORM_STATIC_ROAMER
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.MOONSTORM_STATIC_ROAMER"
msgid "Hope it don't short somethin' or someone out!"
msgstr "¡Espero que no cortocircuite a nada ni a nadie!"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.MOON_ALTAR.GENERIC
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.MOON_ALTAR.GENERIC"
msgid "Inventions? What sort of inventions?"
msgstr "¿Inventos? ¿Qué tipo de inventos?"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.MOON_ALTAR.MOON_ALTAR_WIP
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.MOON_ALTAR.MOON_ALTAR_WIP"
msgid "Don't worry, we're nearly done."
msgstr "No te preocupes, casi hemos terminado."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.MOON_ALTAR_ASTRAL
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.MOON_ALTAR_ASTRAL"
msgid "All the pieces are finally in their proper place."
msgstr "Todas las piezas están en su sitio."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.MOON_ALTAR_COSMIC
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.MOON_ALTAR_COSMIC"
msgid "Can't shake the feeling that this is all building up to somethin'..."
msgstr "No puedo evitar sentir que todo esto es el preludio de algo..."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.MOON_ALTAR_CROWN
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.MOON_ALTAR_CROWN"
msgid "Don't worry, I'll get you where you need to go."
msgstr "No te preocupes, te llevaré donde necesites ir."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.MOON_ALTAR_GLASS
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.MOON_ALTAR_GLASS"
msgid "Huh? You talkin' to me?"
msgstr "¿Eh? ¿Me hablas a mí?"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.MOON_ALTAR_ICON
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.MOON_ALTAR_ICON"
msgid "Now what were you doin' hiding underground?"
msgstr "A ver, a ver... ¿Qué hacías bajo tierra?"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.MOON_ALTAR_IDOL
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.MOON_ALTAR_IDOL"
msgid "I'll fix ya up right proper!"
msgstr "¡Te arreglaré ahora mismo!"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.MOON_ALTAR_LINK
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.MOON_ALTAR_LINK"
msgid "Looks like it's still under construction."
msgstr "Todavía está a medio construir."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.MOON_ALTAR_ROCK_GLASS
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.MOON_ALTAR_ROCK_GLASS"
msgid "Somethin' inside is itching to get out."
msgstr "Hay algo dentro que quiere salir."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.MOON_ALTAR_ROCK_IDOL
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.MOON_ALTAR_ROCK_IDOL"
msgid "Somethin' inside is itching to get out."
msgstr "Hay algo dentro que quiere salir."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.MOON_ALTAR_ROCK_SEED
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.MOON_ALTAR_ROCK_SEED"
msgid "Somethin' inside is itching to get out."
msgstr "Hay algo dentro que quiere salir."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.MOON_ALTAR_SEED
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.MOON_ALTAR_SEED"
msgid "You're a pretty lil fella."
msgstr "Eres una monada de criaturita."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.MOON_ALTAR_WARD
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.MOON_ALTAR_WARD"
msgid "Let's getcha fixed up."
msgstr "Hora de arreglarte."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.MOON_CAP
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.MOON_CAP"
msgid "Anyone wanna volunteer to try it?"
msgstr "¿Alguien se presenta voluntario para darle un mordisquito?"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.MOON_CAP_COOKED
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.MOON_CAP_COOKED"
msgid "Wouldn't have minded having some of these around when I was pulling overtime."
msgstr "No me habría importado tener esto cuando tenía que hacer horas extra."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.MOON_DEVICE.CONSTRUCTION1
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.MOON_DEVICE.CONSTRUCTION1"
msgid "Feels kinda like old times back at the factory."
msgstr "Esto es como cuando estaba en la fábrica."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.MOON_DEVICE.CONSTRUCTION2
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.MOON_DEVICE.CONSTRUCTION2"
msgid "Well, it's not shaping up to be a portal. I was hopin' the boss had figured out a way back..."
msgstr "No tiene mucha pinta de portal... Tenía la esperanza de que el jefe hubiera preparado un camino de vuelta."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.MOON_DEVICE.GENERIC
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.MOON_DEVICE.GENERIC"
msgid "Wonder what the boss is gonna use all this energy for?"
msgstr "¿Qué va a hacer el jefe con toda esa energía?"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.MOON_FISSURE.GENERIC
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.MOON_FISSURE.GENERIC"
msgid "Hm, wonder if I could use this energy somehow."
msgstr "Hum, me pregunto si podría aprovechar esta energía de algún modo."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.MOON_FISSURE.NOLIGHT
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.MOON_FISSURE.NOLIGHT"
msgid "Wonder how far down it goes."
msgstr "Me pregunto cuál será su profundidad..."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.MOON_FISSURE_PLUGGED
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.MOON_FISSURE_PLUGGED"
msgid "That old lady's more resourceful than I gave her credit for."
msgstr "Esa vieja señora tiene más recursos de lo que me pensaba."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.MOON_TREE.BURNING
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.MOON_TREE.BURNING"
msgid "Yeesh, that thing's on fire!"
msgstr "Jope, ¡esta cosa está en llamas!"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.MOON_TREE.BURNT
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.MOON_TREE.BURNT"
msgid "Looks like there was an accident here."
msgstr "Parece que aquí ha habido un accidente."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.MOON_TREE.CHOPPED
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.MOON_TREE.CHOPPED"
msgid "Don't worry, we'll put it to good use."
msgstr "No hay de qué preocuparse; le daré buen uso."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.MOON_TREE.GENERIC
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.MOON_TREE.GENERIC"
msgid "Sure is pretty, ain't it?"
msgstr "Es una belleza, ¿verdad?"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.MOON_TREE_BLOSSOM
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.MOON_TREE_BLOSSOM"
msgid "The trees sure are pretty 'round here."
msgstr "Los árboles de por aquí son muy bonitos, la verdad."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.MOON_TREE_BLOSSOM_DRIED
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.MOON_TREE_BLOSSOM_DRIED"
msgid "These are nice and dry."
msgstr "Ni rastro de humedad."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.MOOSE
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.MOOSE"
msgid "Oh, mama!"
msgstr "¡Ay, mamá!"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.MOOSEEGG
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.MOOSEEGG"
msgid "Animals don't build things well."
msgstr "Los animales no construyen bien."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.MOOSE_NESTING_GROUND
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.MOOSE_NESTING_GROUND"
msgid "That's where the mom keeps her babies."
msgstr "Ahí es donde la madre guarda a sus bebés."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.MOQUECA
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.MOQUECA"
msgid "What's this fancy stuff? I like it!"
msgstr "¿Qué es esta cosa sofisticada? ¡Me gusta!"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.MOSQUITO.GENERIC
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.MOSQUITO.GENERIC"
msgid "Once you've dealt with bedbugs, mosquitoes aren't so bad."
msgstr "Una vez que has lidiado con chinches, los mosquitos no son tan malos."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.MOSQUITO.HELD
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.MOSQUITO.HELD"
msgid "Stop wriggling, it's gross."
msgstr "Deja de moverte, es asqueroso."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.MOSQUITOBOMB
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.MOSQUITOBOMB"
msgid "Talk about a buzz-kill. Ha!"
msgstr "Esto sí que es picajoso. ¡Ja!"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.MOSQUITOFERTILIZER
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.MOSQUITOFERTILIZER"
msgid "Just throw a healthy dollop on the ground."
msgstr "Solo hay que echar un buen pegote en el suelo."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.MOSQUITOMERMSALVE
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.MOSQUITOMERMSALVE"
msgid "I almost feel sorry for the bloodsucker. Almost."
msgstr "Casi me da pena el pobre chupasangre. Casi."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.MOSQUITOMUSK
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.MOSQUITOMUSK"
msgid "Somehow it's still not the creepiest doll I've seen."
msgstr "Por extraño que parezca, no es la muñeca más espeluznante que he visto."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.MOSQUITOSACK
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.MOSQUITOSACK"
msgid "Ha. That's real gross."
msgstr "Ja. Esto sí que es asqueroso."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.MOSSLING
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.MOSSLING"
msgid "Don'tcha just wanna noogie it?"
msgstr "¿A que te dan ganas de acariciarles el pelo?"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.MOUND.DUG
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.MOUND.DUG"
msgid "Just a hole now."
msgstr "Ahora es solo un agujero."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.MOUND.GENERIC
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.MOUND.GENERIC"
msgid "Anything good in there, ya think?"
msgstr "¿Crees que habrá algo bueno ahí dentro?"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.MULLEDDRINK
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.MULLEDDRINK"
msgid "I ain't one to pull my punches... but I'll mull them! Ha!"
msgstr "Nunca he sido de llevar poncho..., ¡pero sí ponche! ¡Ja!"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.MULTIPLAYER_PORTAL
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.MULTIPLAYER_PORTAL"
msgid "That was a one-way ticket."
msgstr "Fue un billete de ida."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.MULTIPLAYER_PORTAL_MOONROCK
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.MULTIPLAYER_PORTAL_MOONROCK"
msgid "Wow. Can't even see the weld joints."
msgstr "Vaya. Ni siquiera veo las juntas de soldadura."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.MULTITOOL_AXE_PICKAXE
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.MULTITOOL_AXE_PICKAXE"
msgid "That's really not my forte."
msgstr "Realmente no es mi fuerte."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.MUSHGNOME
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.MUSHGNOME"
msgid "Strange, no matter how you spin it."
msgstr "Es una cosa rarísima, la mires por donde la mires."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.MUSHROOMBOMB
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.MUSHROOMBOMB"
msgid "Fire in the hole!"
msgstr "¡Fuego en el hoyo!"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.MUSHROOMHAT
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.MUSHROOMHAT"
msgid "Really?"
msgstr "¿En serio?"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.MUSHROOMSPROUT.BURNT
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.MUSHROOMSPROUT.BURNT"
msgid "That seemed like a waste."
msgstr "Vaya desperdicio."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.MUSHROOMSPROUT.GENERIC
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.MUSHROOMSPROUT.GENERIC"
msgid "Now that's a big mushroom!"
msgstr "¡Qué hongo tan grande!"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.MUSHROOM_FARM.BURNT
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.MUSHROOM_FARM.BURNT"
msgid "All burned up."
msgstr "Se ha quemado entera."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.MUSHROOM_FARM.EMPTY
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.MUSHROOM_FARM.EMPTY"
msgid "Nothing yet."
msgstr "Aún nada."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.MUSHROOM_FARM.LOTS
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.MUSHROOM_FARM.LOTS"
msgid "Looks like a pretty good yield."
msgstr "Parece una cosecha bastante buena."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.MUSHROOM_FARM.ROTTEN
