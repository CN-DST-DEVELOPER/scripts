msgctxt "STRINGS.CHARACTERS.WARLY.ANNOUNCE_WEIGHT_HEAVY"
msgid "Weight: {weight}\nEnough fish to feed an entire crew!"
msgstr "Peso: {weight}\n¡Suficiente pescado para alimentar a todo el personal!"

