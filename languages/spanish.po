#. STRINGS.SKIN_DESCRIPTIONS.mastupgradelamp_nautical
msgctxt "STRINGS.SKIN_DESCRIPTIONS.mastupgradelamp_nautical"
msgid "The beauty of the sea will guide your way with this iridescent lamp."
msgstr "La belleza de los mares guiará tus pasos con esta lámpara iridiscente."

#. STRINGS.SKIN_DESCRIPTIONS.meatrack_ancient
msgctxt "STRINGS.SKIN_DESCRIPTIONS.meatrack_ancient"
msgid "Archaeologists speculate that the meat found on this drying rack was way past the expiration date."
msgstr "Los arqueólogos creen que la carne que se ha encontrado en este secadero estaba más que caducada."

#. STRINGS.SKIN_DESCRIPTIONS.meatrack_butcher
msgctxt "STRINGS.SKIN_DESCRIPTIONS.meatrack_butcher"
msgid "A very normal piece of food prep equipment that isn't disconcerting at all."
msgstr "Un elemento de preparación de comidas que no es nada desconcertante."

#. STRINGS.SKIN_DESCRIPTIONS.meatrack_circus
msgctxt "STRINGS.SKIN_DESCRIPTIONS.meatrack_circus"
msgid "An exercise bar is the perfect thing for toughening up your food."
msgstr "Una barra de ejercicios es perfecta para endurecer la comida."

#. STRINGS.SKIN_DESCRIPTIONS.meatrack_hermit_coral
msgctxt "STRINGS.SKIN_DESCRIPTIONS.meatrack_hermit_coral"
msgid "Add a deliciously fishy kick to your jerky!"
msgstr "¡Dale un delicioso toque marino a tu cecina!"

#. STRINGS.SKIN_DESCRIPTIONS.meatrack_hermit_multi_coral
msgctxt "STRINGS.SKIN_DESCRIPTIONS.meatrack_hermit_multi_coral"
msgid "Add a large amount of deliciously fishy kick to your jerky!"
msgstr "¡Dale un buen toque marino a tu cecina!"

#. STRINGS.SKIN_DESCRIPTIONS.meatrack_hermit_multi_yule
msgctxt "STRINGS.SKIN_DESCRIPTIONS.meatrack_hermit_multi_yule"
