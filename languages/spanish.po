msgstr "No más bayas frescas para mis postres."

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.BERRYBUSH_JUICY.BURNING
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.BERRYBUSH_JUICY.BURNING"
msgid "It's burning down!"
msgstr "¡Está ardiendo!"

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.BERRYBUSH_JUICY.DISEASED
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.BERRYBUSH_JUICY.DISEASED"
msgid "It's got food poisoning."
msgstr "Se ha intoxicado."

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.BERRYBUSH_JUICY.DISEASING
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.BERRYBUSH_JUICY.DISEASING"
msgid "I think it's coming down with a little something."
msgstr "Creo que le ha entrado un no sé qué."

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.BERRYBUSH_JUICY.GENERIC
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.BERRYBUSH_JUICY.GENERIC"
