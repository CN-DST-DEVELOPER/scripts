msgstr "Esa planta da mal rollo..."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.LUNARTHRALL_PLANT_VINE_END
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.LUNARTHRALL_PLANT_VINE_END"
