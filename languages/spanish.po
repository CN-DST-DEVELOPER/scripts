msgstr "¿Sabe como la luna?"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.HERMITCRABTEA_PETALS
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.HERMITCRABTEA_PETALS"
msgid "For when we feel a little funny."
msgstr "Para cuando nos sentimos un poco raros."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.HERMITCRABTEA_PETALS_EVIL
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.HERMITCRABTEA_PETALS_EVIL"
