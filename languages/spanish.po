msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.MEATRACK_HERMIT.DRYING_NOTMEAT"
msgid "It sways in the drying wind."
msgstr "Se balancea secándose al viento."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.MEATRACK_HERMIT.GENERIC
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.MEATRACK_HERMIT.GENERIC"
msgid "One can't survive long without food..."
msgstr "No se puede sobrevivir mucho sin comida..."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.MEATRACK_HERMIT_MULTI.ABANDONED
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.MEATRACK_HERMIT_MULTI.ABANDONED"
msgid "Broken and abandoned."
msgstr "Roto y abandonado."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.MEATRACK_HERMIT_MULTI.BURNT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.MEATRACK_HERMIT_MULTI.BURNT"
msgid "It's done drying. Forever."
msgstr "Se ha secado. Para siempre."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.MEATRACK_HERMIT_MULTI.DONE
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.MEATRACK_HERMIT_MULTI.DONE"
msgid "The drying is over."
msgstr "Ya se ha secado."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.MEATRACK_HERMIT_MULTI.DONE_NOTMEAT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.MEATRACK_HERMIT_MULTI.DONE_NOTMEAT"
msgid "The drying is over."
msgstr "Ya se ha secado."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.MEATRACK_HERMIT_MULTI.DONE_SALT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.MEATRACK_HERMIT_MULTI.DONE_SALT"
msgid "Food without salt is like life without..."
msgstr "La comida sin sal es como una vida sin..."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.MEATRACK_HERMIT_MULTI.DRYING
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.MEATRACK_HERMIT_MULTI.DRYING"
msgid "It sways in the drying wind."
msgstr "Se balancea secándose al viento."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.MEATRACK_HERMIT_MULTI.DRYINGINRAIN
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.MEATRACK_HERMIT_MULTI.DRYINGINRAIN"
msgid "The rain is keeping it from drying."
msgstr "La lluvia impide que se seque."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.MEATRACK_HERMIT_MULTI.DRYINGINRAIN_NOTMEAT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.MEATRACK_HERMIT_MULTI.DRYINGINRAIN_NOTMEAT"
