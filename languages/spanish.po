msgstr "Es lo más seguro."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.MERMCORPSE.GENERIC
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.MERMCORPSE.GENERIC"
