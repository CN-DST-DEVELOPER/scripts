msgstr "Un conservante de primera."

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.BEESWAX_SPRAY
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.BEESWAX_SPRAY"
