msgctxt "STRINGS.CHARACTERS.WORTOX.ACTIONFAIL.RUMMAGE.NOTMASTERCHEF"
msgid "Warly won't let me peek inside. He's no fun."
msgstr "Warly no me deja echar un vistazo. No es divertido."

#. STRINGS.CHARACTERS.WORTOX.ACTIONFAIL.RUMMAGE.NOTSOULJARHANDLER
msgctxt "STRINGS.CHARACTERS.WORTOX.ACTIONFAIL.RUMMAGE.NOTSOULJARHANDLER"
