#. STRINGS.SKILLTREE.WOODIE.WOODIE_HUMAN_TREEGUARD_MAX_DESC
msgctxt "STRINGS.SKILLTREE.WOODIE.WOODIE_HUMAN_TREEGUARD_MAX_DESC"
