msgstr "Cultivador lunar III"

#. STRINGS.SKILLTREE.WORMWOOD.LUREPLANTCRAFTING_DESC
msgctxt "STRINGS.SKILLTREE.WORMWOOD.LUREPLANTCRAFTING_DESC"
