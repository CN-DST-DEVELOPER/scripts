msgstr "Esto será el volante."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.YOTH_CHAIR_ROCKING_ITEM
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.YOTH_CHAIR_ROCKING_ITEM"
msgid "It's a rocky ride!"
msgstr "¡Un viaje movidito!"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.YOTH_KNIGHTHAT
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.YOTH_KNIGHTHAT"
msgid "Will I look like a foal?"
msgstr "¿No pareceré un asno?"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.YOTH_KNIGHTSHRINE.BURNT
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.YOTH_KNIGHTSHRINE.BURNT"
