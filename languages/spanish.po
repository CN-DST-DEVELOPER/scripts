msgstr "Suelo o techo, según tu perspectiva."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.TURF_UNDERROCK
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.TURF_UNDERROCK"
msgid "Floor or ceiling, depending on your perspective."
msgstr "Suelo o techo, según tu perspectiva."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.TURF_VAULT
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.TURF_VAULT"
msgid "Floor or ceiling, depending on your perspective."
msgstr "Suelo o techo, según tu perspectiva."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.TURF_VENT
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.TURF_VENT"
msgid "Floor or ceiling, depending on your perspective."
msgstr "Suelo o techo, según tu perspectiva."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.TURF_WOODFLOOR
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.TURF_WOODFLOOR"
msgid "Floor or ceiling, depending on your perspective."
msgstr "Suelo o techo, según tu perspectiva."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.TURKEYDINNER
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.TURKEYDINNER"
msgid "A very hearty mortal feast."
msgstr "Un banquete mortal muy abundante."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.TURNIP
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.TURNIP"
msgid "That's a tiny turnip."
msgstr "Qué nabo tan pequeño."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.TURNIP_COOKED
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.TURNIP_COOKED"
msgid "Cooked, but not into a dish."
msgstr "Cocinada, pero no en un plato."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.TURNIP_SEEDS
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.TURNIP_SEEDS"
msgid "Strange little seeds, indeed, indeed."
msgstr "Unas extrañas semillitas, oh, sí, oh, sí."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.TURTILLUS
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.TURTILLUS"
msgid "We can't fight well when it's in its shell."
msgstr "No podemos luchar nada cuando está encerrada."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.TWIGGYTREE.BURNING
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.TWIGGYTREE.BURNING"
msgid "Twiddle dee dee, a burning tree!"
msgstr "¡Laralalaralá, el árbol arderá!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.TWIGGYTREE.BURNT
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.TWIGGYTREE.BURNT"
msgid "Well, that was fun."
msgstr "Fue divertido."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.TWIGGYTREE.CHOPPED
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.TWIGGYTREE.CHOPPED"
msgid "A funny tree prank."
msgstr "Una broma graciosa con el árbol."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.TWIGGYTREE.DISEASED
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.TWIGGYTREE.DISEASED"
msgid "Oh jeez, oh ick, that tree looks sick!"
msgstr "¡Oh, Dios mío, ese árbol parece alicaído!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.TWIGGYTREE.GENERIC
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.TWIGGYTREE.GENERIC"
msgid "A slender tree of twigs and sticks."
msgstr "Un árbol esbelto de ramitas y palitos."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.TWIGGY_NUT
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.TWIGGY_NUT"
msgid "It wants to be a lovely tree."
msgstr "Quiere ser un árbol precioso."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.TWIGGY_NUT_SAPLING
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.TWIGGY_NUT_SAPLING"
msgid "It's just a tree baby."
msgstr "Es solo un árbol bebé."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.TWIGGY_OLD
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.TWIGGY_OLD"
msgid "This tree is long in the tooth."
msgstr "Este árbol es bastante viejo."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.TWIGS
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.TWIGS"
msgid "Little twigs that bend and snap!"
msgstr "¡Pequeñas ramitas que se doblan y rompen!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.TWINOFTERROR1
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.TWINOFTERROR1"
msgid "Double double, we're in trouble!"
msgstr "¡Son dos, son dos! Qué peligro, ¡adiós!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.TWINOFTERROR2
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.TWINOFTERROR2"
msgid "Double double, we're in trouble!"
msgstr "¡Son dos, son dos! Qué peligro, ¡adiós!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.UMBRELLA
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.UMBRELLA"
msgid "No soggy imps on this fine day!"
msgstr "¡Nada de diablillos empapados!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.UNAGI
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.UNAGI"
msgid "Yet another dish cooked up by mortals."
msgstr "Otro plato cocinado por los mortales."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.UNIMPLEMENTED
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.UNIMPLEMENTED"
msgid "What on earth is that?"
msgstr "¿Pero qué demonios es eso?"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.VAULT_CHANDELIER_BROKEN
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.VAULT_CHANDELIER_BROKEN"
msgid "Oh dear, the chandelier."
msgstr "La lámpara, qué lástima."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.VAULT_COMPASS.GENERIC
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.VAULT_COMPASS.GENERIC"
msgid "It's in the know on where to go."
msgstr "Sabe a dónde ir y me va a dirigir."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.VAULT_COMPASS.KEYROOM
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.VAULT_COMPASS.KEYROOM"
msgid "The search has ended as I intended."
msgstr "Búsqueda finalizada."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.VAULT_COMPASS.NOTVAULT
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.VAULT_COMPASS.NOTVAULT"
msgid "Alas, I fear it won't work here."
msgstr "Empiezo a sospechar que aquí no va a funcionar."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.VAULT_CRAWLER.GENERIC
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.VAULT_CRAWLER.GENERIC"
msgid "My my, you just gave me a bright idea..."
msgstr "Qué maravilla, se me ha encendido la bombilla..."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.VAULT_CRAWLER.SOCKETED
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.VAULT_CRAWLER.SOCKETED"
msgid "Got it to the spot."
msgstr "Está puesto en su puesto."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.VAULT_CRAWLER_LEVER
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.VAULT_CRAWLER_LEVER"
msgid "Pull the lever, win a prize!"
msgstr "¡Tiras de la palanca y tienes un premio!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.VAULT_DECON_DOOR
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.VAULT_DECON_DOOR"
msgid "Walls have never posed a problem for me, hyuyu!"
msgstr "¡Ningún muro puede dejarme mudo, ju, ju!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.VAULT_DECON_MISTER
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.VAULT_DECON_MISTER"
msgid "Spray your troubles away!"
msgstr "¡Pulverizas tus movidas!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.VAULT_KEY
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.VAULT_KEY"
msgid "The key to our salvation, or destruction? Hyuyuyu, I can't wait to find out!"
msgstr "¿La clave de nuestra salvación o de nuestra destrucción? Ji, ji, ji. ¡Me muero por descubrirlo!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.VAULT_KEY_ACTIVATOR
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.VAULT_KEY_ACTIVATOR"
msgid "It's missing that special spark, hyuyu!"
msgstr "¡No tiene lo que hay que tener, ji, ji!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.VAULT_KEY_EXIT
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.VAULT_KEY_EXIT"
msgid "There's no hope for a rope!"
msgstr "¡Daría el brazo por un lazo!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.VAULT_KEY_PEDESTAL.GENERIC
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.VAULT_KEY_PEDESTAL.GENERIC"
msgid "I see a key!"
msgstr "¡La llave es la clave!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.VAULT_KEY_PEDESTAL.PICKED
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.VAULT_KEY_PEDESTAL.PICKED"
msgid "It's been taken! Shall we be foresaken?"
msgstr "¡Se la han llevado! ¿Se ha acabado?"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.VAULT_LOBBY_EXIT
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.VAULT_LOBBY_EXIT"
msgid "Should I need to retreat, a rope can't be beat!"
msgstr "¡Las sogas son lo mejor para las fugas!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.VAULT_ORB
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.VAULT_ORB"
msgid "The ball took a fall!"
msgstr "¡La pelota se rebota!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.VAULT_ORB_REFINED
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.VAULT_ORB_REFINED"
msgid "For imitation of my teleportation."
msgstr "Una imitación de mi teletransportación."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.VAULT_PILLAR_GUARD
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.VAULT_PILLAR_GUARD"
msgid "Killer pillar!"
msgstr "¡Un torreón matón!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.VAULT_PILLAR_GUARD_CONSTR
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.VAULT_PILLAR_GUARD_CONSTR"
msgid "I don't mean to harp, but what's under the tarp?"
msgstr "¡No pretendo cotillear, pero necesito mirar!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.VAULT_PILLAR_GUARD_CONSTR_PLANS
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.VAULT_PILLAR_GUARD_CONSTR_PLANS"
msgid "Where to guard? It's not that hard."
msgstr "¿Vigilar? No te vas a herniar."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.VAULT_PILLAR_GUARD_CRAFTED
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.VAULT_PILLAR_GUARD_CRAFTED"
msgid "It's a tower of great power!"
msgstr "¡Es un torreón del copón!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.VAULT_PILLAR_GUARD_DORMANT
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.VAULT_PILLAR_GUARD_DORMANT"
msgid "That's what I call tall!"
msgstr "¡No hace falta que sea más alta!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.VAULT_PILLAR_GUARD_DORMANT_CRAFTED
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.VAULT_PILLAR_GUARD_DORMANT_CRAFTED"
msgid "This tower needs power!"
msgstr "¡La torre no corre!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.VAULT_PILLAR_GUARD_PIECE
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.VAULT_PILLAR_GUARD_PIECE"
msgid "It won't start until it has every part."
msgstr "Si quiero que trabaje, hay que darle montaje."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.VAULT_REFINER_PEDESTAL
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.VAULT_REFINER_PEDESTAL"
msgid "Be patient! It's ancient!"
msgstr "¡Para ser tan vieja, no tengo queja!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.VAULT_RUNE
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.VAULT_RUNE"
msgid "Makes sense."
msgstr "Tiene sentido."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.VAULT_STATUE.LORE1
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.VAULT_STATUE.LORE1"
msgid "The Monarch is lost to the Dark!"
msgstr "¡La oscuridad devora a su majestad!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.VAULT_STATUE.LORE2
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.VAULT_STATUE.LORE2"
msgid "Mass extinction makes no distinction!"
msgstr "¡La extinción no tiene excepción!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.VAULT_STATUE.LORE3
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.VAULT_STATUE.LORE3"
msgid "Oh dears. They appears to have spears, I fears!"
msgstr "¡Ya no se lanzan a lanzar las lanzas!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.VAULT_TELEPORTER.BROKEN
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.VAULT_TELEPORTER.BROKEN"
msgid "Don't despair, we can repair!"
msgstr "¡No hay que desesperar, todo se puede arreglar!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.VAULT_TELEPORTER.GENERIC
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.VAULT_TELEPORTER.GENERIC"
msgid "How lame, I do the same."
msgstr "¿Y qué? Yo también sé."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.VAULT_TELEPORTER.UNPOWERED
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.VAULT_TELEPORTER.UNPOWERED"
msgid "No power? At this hour?"
msgstr "¿Sin energía? ¿A esta hora del día?"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.VAULT_TORCH.BROKEN
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.VAULT_TORCH.BROKEN"
msgid "What a joke! The switch is broke!"
msgstr "¡Horror! ¡Adiós al interruptor!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.VAULT_TORCH.GENERIC
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.VAULT_TORCH.GENERIC"
msgid "That light's alright!"
msgstr "¡Encantado con el alumbrado!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.VEGGIEOMLET
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.VEGGIEOMLET"
msgid "A mortal dish. Or should I say, a mortal pan."
msgstr "Un plato mortal. ¿O debería decir, una sartén mortal?"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.VEGGIE_OVERSIZED_ROTTEN
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.VEGGIE_OVERSIZED_ROTTEN"
msgid "This one's spoiled rotten!"
msgstr "¡Se ha quedado podre!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.VEGSTINGER
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.VEGSTINGER"
msgid "I can't decide if it's for sipping or souping."
msgstr "No sé si es para sorber o morder."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.VICTORIAN_BLUEPRINT
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.VICTORIAN_BLUEPRINT"
msgid "Fancy, that!"
msgstr "Qué elegante."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.VOIDCLOTH
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.VOIDCLOTH"
msgid "Bits of tattered reality. And it comes in my color!"
msgstr "Jirones de realidad. ¡Y del color que mejor me queda!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.VOIDCLOTHHAT
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.VOIDCLOTHHAT"
msgid "A hood of night, that blocks out all light."
msgstr "Una capucha nocturna para bloquear la luz diurna."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.VOIDCLOTH_BOOMERANG
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.VOIDCLOTH_BOOMERANG"
msgid "Delivering death from a distance!"
msgstr "¡Llevando la muerte a una distancia prudente!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.VOIDCLOTH_KIT
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.VOIDCLOTH_KIT"
msgid "A stitch here and there for a quick repair."
msgstr "Un punto y a punto."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.VOIDCLOTH_SCYTHE
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.VOIDCLOTH_SCYTHE"
msgid "Alas, it reaps no souls, just grass."
msgstr "Por desgracia no siega almas, solo plantas."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.VOIDCLOTH_UMBRELLA
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.VOIDCLOTH_UMBRELLA"
msgid "The rain of pain falls mainly on this plane."
msgstr "La lluvia doliente cae en este plano principalmente."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.VOLTGOATJELLY
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.VOLTGOATJELLY"
msgid "Hyuyu, it looks interesting at least."
msgstr "Ju, ju, por lo menos parece interesante."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.WAFFLES
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.WAFFLES"
msgid "The mortals like these a lot."
msgstr "A los mortales les gustan mucho."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.WAGBOSS_ROBOT
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.WAGBOSS_ROBOT"
msgid "No need for alarm, it means us no harm..."
msgstr "En verdad os digo, que es inofensivo..."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.WAGBOSS_ROBOT_CONSTRUCTIONSITE
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.WAGBOSS_ROBOT_CONSTRUCTIONSITE"
msgid "The foundation of devastation, hyuyu!"
msgstr "¡La fundación de la devastación, ji, ji!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.WAGBOSS_ROBOT_CONSTRUCTIONSITE_KIT
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.WAGBOSS_ROBOT_CONSTRUCTIONSITE_KIT"
msgid "I'll feel no guilt until it's built!"
msgstr "¡No me sentiré culpable hasta que no esté operable!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.WAGBOSS_ROBOT_CREATION_PARTS
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.WAGBOSS_ROBOT_CREATION_PARTS"
msgid "Install to end us all?"
msgstr "¿Instalar para finiquitar?"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.WAGBOSS_ROBOT_LEG
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.WAGBOSS_ROBOT_LEG"
msgid "A robust robot leg!"
msgstr "¡Una robusta pata robótica!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.WAGBOSS_ROBOT_POSSESSED
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.WAGBOSS_ROBOT_POSSESSED"
msgid "It's got a few screws loose, I do deduce."
msgstr "Me da en el hociquillo que le falta un tornillo."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.WAGBOSS_ROBOT_SECRET
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.WAGBOSS_ROBOT_SECRET"
msgid "If we know history, better to leave it a mystery."
msgstr "Hemos aprendido la lección, lo mejor es la inacción."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.WAGDRONE_BEACON
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.WAGDRONE_BEACON"
msgid "I've seen it all! An invisible wall!"
msgstr "¡Increíble! ¡Un muro invisible!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.WAGDRONE_FLYING.DAMAGED
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.WAGDRONE_FLYING.DAMAGED"
msgid "It's had its day, let's salvage away!"
msgstr "¡Si no podemos salvarlo, vamos a aprovecharlo!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.WAGDRONE_FLYING.GENERIC
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.WAGDRONE_FLYING.GENERIC"
msgid "Buzzing blight from yonder height!"
msgstr "¡Una plaga irritante a una altura distante!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.WAGDRONE_FLYING.INACTIVE
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.WAGDRONE_FLYING.INACTIVE"
msgid "A mean little machine!"
msgstr "¡Un aparato la mar de ingrato!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.WAGDRONE_PARTS
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.WAGDRONE_PARTS"
msgid "Spares for repairs."
msgstr "Un artefacto para el aparato."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.WAGDRONE_ROLLING.DAMAGED
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.WAGDRONE_ROLLING.DAMAGED"
msgid "Shall I repair or take the spare... parts?"
msgstr "¿Le hago un cambio o me llevo los recambios?"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.WAGDRONE_ROLLING.FRIENDLY
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.WAGDRONE_ROLLING.FRIENDLY"
msgid "A friendly model that doesn't dawdle."
msgstr "Un modelo muy majo que no teme al trabajo."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.WAGDRONE_ROLLING.GENERIC
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.WAGDRONE_ROLLING.GENERIC"
msgid "Deranged dervish on the skirmish!"
msgstr "¡Un torbellino hostil entre las hostilidades!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.WAGDRONE_ROLLING.INACTIVE
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.WAGDRONE_ROLLING.INACTIVE"
msgid "A mean little machine!"
msgstr "¡Un aparato la mar de ingrato!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.WAGPUNKBITS_KIT
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.WAGPUNKBITS_KIT"
msgid "An automatic mechanical mechanic? Fantastic!"
msgstr "¿Un mecánico mecánico automático? ¡Fantástico!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.WAGPUNKHAT
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.WAGPUNKHAT"
msgid "This should help me blow off some steam, hyuyu!"
msgstr "¡Esto me ayudará a desahogarme, ji, ji!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.WAGPUNK_BITS
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.WAGPUNK_BITS"
msgid "I'll have to settle for these scraps of metal."
msgstr "Tendré que conformarme con el metal sobrante."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.WAGPUNK_CAGEWALL
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.WAGPUNK_CAGEWALL"
msgid "Save the sass! None shall pass! Hyuyu!"
msgstr "¡Deja de llorar! ¡No puedes pasar! ¡Ji, ji!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.WAGPUNK_FLOOR_KIT
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.WAGPUNK_FLOOR_KIT"
msgid "Score! More floor!"
msgstr "¡Pero bueno! ¡Más terreno!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.WAGPUNK_LEVER
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.WAGPUNK_LEVER"
msgid "Is it polite to pull it?"
msgstr "Un tirador muy tentador."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.WAGPUNK_WORKSTATION
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.WAGPUNK_WORKSTATION"
msgid "What have we here? His intentions are never clear!"
msgstr "¡Increíble! ¡Es impredecible!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.WAGSTAFF_ITEM_1
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.WAGSTAFF_ITEM_1"
msgid "The glove is on the physical plane? I must have truly gone insane!"
msgstr "¿El guante existe? ¡Esto es de chiste!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.WAGSTAFF_ITEM_2
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.WAGSTAFF_ITEM_2"
msgid "The clipboard is real, I said with a squeal! Hyuyu!"
msgstr "¿El sujetapapeles es real? ¡No es lo ideal! ¡Ji, ji!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.WAGSTAFF_MACHINERY
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.WAGSTAFF_MACHINERY"
msgid "This whole lot has been left to rot."
msgstr "Lo han dejado todo cogiendo polvo."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.WAGSTAFF_MUTATIONS_NOTE
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.WAGSTAFF_MUTATIONS_NOTE"
msgid "The writings of a visionary, or the ravings of a madman? Who's to say!"
msgstr "¿Los escritos de un visionario o los desvaríos de un lunático? ¡Quién sabe!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.WAGSTAFF_NPC
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.WAGSTAFF_NPC"
msgid "Hyuyuyu! He's not all there!"
msgstr "Ju, ju, ju... No está del todo aquí."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.WAGSTAFF_NPC_MUTATIONS
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.WAGSTAFF_NPC_MUTATIONS"
msgid "Shall I assist with his to-do list?"
msgstr "¿Debería hacer de asistente con sus tareas pendientes?"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.WAGSTAFF_NPC_WAGPUNK
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.WAGSTAFF_NPC_WAGPUNK"
msgid "Perhaps he's late for an important date."
msgstr "Tal vez llegue tarde a una cita importante."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.WAGSTAFF_TOOL_1
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.WAGSTAFF_TOOL_1"
msgid "Hoohoo! You're not from around this plane, are you?"
msgstr "Jo, jo, jo. Tú no eres de este plano, ¿verdad?"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.WAGSTAFF_TOOL_2
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.WAGSTAFF_TOOL_2"
msgid "You belong in the hand of that old man."
msgstr "A las manos del viejo has de regresar ¡y sin faltar!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.WAGSTAFF_TOOL_3
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.WAGSTAFF_TOOL_3"
msgid "This may be what I'm looking for, or not!"
msgstr "A lo mejor es lo que buscaba... ¿O solo me lo imaginaba?"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.WAGSTAFF_TOOL_4
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.WAGSTAFF_TOOL_4"
msgid "Oooh how fun! I can't be sure if that's the right one!"
msgstr "¡Qué diversión! Aunque si me equivoco, me llevaré una decepción..."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.WAGSTAFF_TOOL_5
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.WAGSTAFF_TOOL_5"
msgid "What a fun game, finding tools from another plane!"
msgstr "Me lo paso como un enano con esto de buscar cosas de otro plano."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.WALKINGPLANK
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.WALKINGPLANK"
msgid "It's just a last resort, worrywart!"
msgstr "¡No angustiarse, es solo el último recurso!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.WALKINGPLANK_ANCIENT
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.WALKINGPLANK_ANCIENT"
msgid "It's just a last resort, worrywart!"
msgstr "¡No angustiarse, es solo el último recurso!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.WALKINGPLANK_GRASS
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.WALKINGPLANK_GRASS"
msgid "It's just a last resort, worrywart!"
msgstr "¡No angustiarse, es solo el último recurso!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.WALKINGPLANK_YOTD
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.WALKINGPLANK_YOTD"
msgid "A last resort, dressed up for sport."
msgstr "Una última opción, vestida para la ocasión."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.WALKING_STICK
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.WALKING_STICK"
msgid "A walking stick for walking quick."
msgstr "Un garrote para andar al trote."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.WALL_DREADSTONE
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.WALL_DREADSTONE"
msgid "To keep you out, or keep me in?"
msgstr "¿Para dejarte afuera o para quedarme adentro?"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.WALL_DREADSTONE_ITEM
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.WALL_DREADSTONE_ITEM"
msgid "It's of no use there on the ground."
msgstr "No sirve de nada en el suelo."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.WALL_HAY.BURNT
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.WALL_HAY.BURNT"
msgid "A silly prank to be sure."
msgstr "Una broma tonta, está claro."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.WALL_HAY.GENERIC
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.WALL_HAY.GENERIC"
msgid "To keep you out, or keep me in?"
msgstr "¿Para dejarte afuera o para quedarme adentro?"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.WALL_HAY_ITEM
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.WALL_HAY_ITEM"
msgid "It's of no use there on the ground."
msgstr "No sirve de nada en el suelo."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.WALL_MOONROCK
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.WALL_MOONROCK"
msgid "To keep you out, or keep me in?"
msgstr "¿Para dejarte afuera o para quedarme adentro?"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.WALL_MOONROCK_ITEM
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.WALL_MOONROCK_ITEM"
msgid "It's of no use there on the ground."
msgstr "No sirve de nada en el suelo."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.WALL_RUINS
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.WALL_RUINS"
msgid "To keep you out, or keep me in?"
msgstr "¿Para dejarte afuera o para quedarme adentro?"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.WALL_RUINS_2
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.WALL_RUINS_2"
msgid "To keep you out, or keep me in?"
msgstr "¿Para dejarte afuera o para quedarme adentro?"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.WALL_RUINS_ITEM
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.WALL_RUINS_ITEM"
msgid "It's of no use there on the ground."
msgstr "No sirve de nada en el suelo."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.WALL_SCRAP
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.WALL_SCRAP"
msgid "Who would have thunk? A wall of junk."
msgstr "¿Quién lo diría? Una valla de porquería."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.WALL_SCRAP_ITEM
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.WALL_SCRAP_ITEM"
msgid "Who would have thunk? A wall of junk."
msgstr "¿Quién lo diría? Una valla de porquería."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.WALL_STONE
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.WALL_STONE"
msgid "To keep you out, or keep me in?"
msgstr "¿Para dejarte afuera o para quedarme adentro?"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.WALL_STONE_2
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.WALL_STONE_2"
msgid "To keep you out, or keep me in?"
msgstr "¿Para dejarte afuera o para quedarme adentro?"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.WALL_STONE_ITEM
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.WALL_STONE_ITEM"
msgid "It's of no use there on the ground."
msgstr "No sirve de nada en el suelo."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.WALL_WOOD.BURNT
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.WALL_WOOD.BURNT"
msgid "A silly prank to be sure."
msgstr "Una broma tonta, está claro."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.WALL_WOOD.GENERIC
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.WALL_WOOD.GENERIC"
msgid "To keep you out, or keep me in?"
msgstr "¿Para dejarte afuera o para quedarme adentro?"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.WALL_WOOD_ITEM
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.WALL_WOOD_ITEM"
msgid "It's of no use there on the ground."
msgstr "No sirve de nada en el suelo."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.WALRUS
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.WALRUS"
msgid "His horns are on the wrong way."
msgstr "Sus cuernos están al revés."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.WALRUSHAT
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.WALRUSHAT"
msgid "Do I look good in plaid?"
msgstr "¿Me quedan bien los cuadros?"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.WALRUS_CAMP.EMPTY
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.WALRUS_CAMP.EMPTY"
msgid "The walruses aren't too keen. There's none here to be seen!"
msgstr "Las morsas son bichos raros. ¡Siempre están en otro lado!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.WALRUS_CAMP.GENERIC
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.WALRUS_CAMP.GENERIC"
msgid "They would not roam, too far from home."
msgstr "No deambularían, muy lejos de casa no irían."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.WALRUS_TUSK
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.WALRUS_TUSK"
msgid "A sideways horn for a wizened face."
msgstr "Un cuerno lateral para una cara arrugada."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.WALTER.ATTACKER
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.WALTER.ATTACKER"
msgid "Making some mischief, are we %s?"
msgstr "Haciendo travesuras, ¿eh, %s?"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.WALTER.FIRESTARTER
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.WALTER.FIRESTARTER"
msgid "Rules are meant to be broken, hyuyuyu!"
msgstr "¡Las reglas son para romperlas, ju, ju!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.WALTER.GENERIC
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.WALTER.GENERIC"
msgid "Helped anyone cross the street lately, %s?"
msgstr "¿Has ayudado a alguien a cruzar la calle últimamente, %s?"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.WALTER.GHOST
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.WALTER.GHOST"
msgid "I'll just take a nibble... hyuyu I'm only joking!"
msgstr "Probaré solo un mordisquito. ¡Ju, ju, es broma!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.WALTER.MURDERER
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.WALTER.MURDERER"
msgid "Eep! I rather like this plane, I'd hate to leave it!"
msgstr "¡Ay! ¡Me gusta este plano. no me gustaría tener que irme!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.WALTER.REVIVER
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.WALTER.REVIVER"
msgid "Hyuyu! Such a helpful soul!"
msgstr "¡Ju, ju, qué alma tan colaboradora!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.WALTERHAT
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.WALTERHAT"
msgid "Imps and uniforms rarely mix."
msgstr "Los diablillos y los uniformes no hacen buenas migas."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.WANDA.ATTACKER
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.WANDA.ATTACKER"
msgid "Hyuyuyu, I don't think she liked my last prank."
msgstr "Ji, ji, ji... Creo que no le ha hecho gracia mi última broma."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.WANDA.FIRESTARTER
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.WANDA.FIRESTARTER"
msgid "Oooh, mind if I join in?"
msgstr "Ohhh... ¿Te importa si me apunto?"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.WANDA.GENERIC
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.WANDA.GENERIC"
msgid "Have you been anytime interesting lately, %s?"
msgstr "¿Has estado en algún momento interesante estos días, %s?"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.WANDA.GHOST
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.WANDA.GHOST"
msgid "You're looking much tastier than usual, %s!"
msgstr "Nunca habías tenido tan buena pinta, %s."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.WANDA.MURDERER
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.WANDA.MURDERER"
msgid "You wouldn't kill an imp in the prime of his life, would you?"
msgstr "No me matarías ahora que estoy en la flor de la vida..."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.WANDA.REVIVER
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.WANDA.REVIVER"
msgid "Hyuyu, %s doesn't seem to be wise to soul power, thankfully."
msgstr "Ju, ju... Por suerte, %s no es una experta en el poder del alma."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.WANDERINGTRADER.GENERIC
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.WANDERINGTRADER.GENERIC"
msgid "Whoa, uncanny beefalo!"
msgstr "¡Diantre, un beefalo inquietante!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.WANDERINGTRADER.REVEALED
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.WANDERINGTRADER.REVEALED"
msgid "This guy's disguise! Hyuyu!"
msgstr "¡Un rapaz con disfraz! ¡Ju, ju!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.WARDROBE.BURNING
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.WARDROBE.BURNING"
msgid "Someone's playing a funny prank."
msgstr "Alguien jugó una broma divertida."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.WARDROBE.BURNT
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.WARDROBE.BURNT"
msgid "The fashion dimension has been sealed off."
msgstr "La dimensión de la moda terminó arrasada."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.WARDROBE.GENERIC
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.WARDROBE.GENERIC"
msgid "A portal to the fashion dimension."
msgstr "Un portal a la dimensión de la moda."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.WARG
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.WARG"
msgid "I'll not be a feast for that beast!"
msgstr "¡No seré un manjar para ese animal!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.WARGCORPSE.BURNING
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.WARGCORPSE.BURNING"
msgid "This hot dog needs a bun."
msgstr "A este perrito caliente le falta el pan."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.WARGCORPSE.GENERIC
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.WARGCORPSE.GENERIC"
msgid "A mutt in a permanent rut, hyuyu!"
msgstr "¡Un perro callejero en un buen atolladero, ji, ji!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.WARGCORPSE.REVIVING
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.WARGCORPSE.REVIVING"
msgid "Death doesn't stick? Must be a new trick."
msgstr "¿Ha aprendido a volver de la tumba? ¡Ese truco no abunda!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.WARGLET
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.WARGLET"
msgid "You wouldn't want to eat me, imps give terrible indigestion!"
msgstr "No quieres comerme, lo sé. ¡Los diablillos damos indigestión!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.WARGSHRINE.BURNT
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.WARGSHRINE.BURNT"
msgid "That's that."
msgstr "Se acabó."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.WARGSHRINE.EMPTY
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.WARGSHRINE.EMPTY"
msgid "Rumble and grumble, it wants to eat meat!"
msgstr "¡Gruñe y regruñe, quiere comer carne!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.WARGSHRINE.GENERIC
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.WARGSHRINE.GENERIC"
msgid "Let us celebrate!"
msgstr "¡Vamos a celebrarlo!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.WARLY.ATTACKER
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.WARLY.ATTACKER"
msgid "I think %s's been causing some trouble. How fun!"
msgstr "Creo que %s ha estado dando problemas. ¡Qué divertido!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.WARLY.FIRESTARTER
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.WARLY.FIRESTARTER"
msgid "Oh, are we playing pranks today, %s?"
msgstr "Oh, ¿haremos algunas bromas hoy, %s?"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.WARLY.GENERIC
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.WARLY.GENERIC"
msgid "%s sure likes food. I don't get humans."
msgstr "A %s le encanta la comida. No entiendo a los humanos."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.WARLY.GHOST
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.WARLY.GHOST"
msgid "The culinarian's become the culination, hyuyu!"
msgstr "Al cocinillas lo han pasado por la sartén, ¡ju, ju!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.WARLY.MURDERER
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.WARLY.MURDERER"
msgid "Don't hurt me-hee-hee!"
msgstr "¡No me hagas daño, jo, jo!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.WARLY.REVIVER
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.WARLY.REVIVER"
msgid "I guess %s doesn't have a taste for souls."
msgstr "Supongo que %s no tiene paladar para las almas."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.WAR_BLUEPRINT
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.WAR_BLUEPRINT"
msgid "Fit for a fearsome fellow."
msgstr "Perfecto para aterrorizar."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.WASPHIVE
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.WASPHIVE"
msgid "Do I want to start some mischief?"
msgstr "¿Tengo ganas de hacer alguna travesura?"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.WATERBALLOON
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.WATERBALLOON"
msgid "You'd never see me coming!"
msgstr "¡Nunca me verías venir!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.WATERINGCAN.EMPTY
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.WATERINGCAN.EMPTY"
msgid "The water was spilled, it must be refilled!"
msgstr "La regadera debo llenar si quiero volver a regar."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.WATERINGCAN.GENERIC
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.WATERINGCAN.GENERIC"
msgid "A watering can, what an excellent plan!"
msgstr "Una regadera, pero ¡ya podía ser una bañera!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.WATERMELON
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.WATERMELON"
msgid "I do not want it."
msgstr "No la quiero."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.WATERMELONHAT
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.WATERMELONHAT"
msgid "Sticky horns await."
msgstr "Se me van a poner los cuernos pegajosos."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.WATERMELONICLE
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.WATERMELONICLE"
msgid "Looks stomachable."
msgstr "Parece digestible."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.WATERMELON_COOKED
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.WATERMELON_COOKED"
msgid "Goodness, gracious, no no no!"
msgstr "¡Oh, cielos, no, no, no!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.WATERMELON_OVERSIZED
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.WATERMELON_OVERSIZED"
msgid "If only it had a soul!"
msgstr "Ojalá tuviera alma..."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.WATERMELON_SEEDS
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.WATERMELON_SEEDS"
msgid "Grow a seed and you shall feed!"
msgstr "¡Planta una semilla y tendrás buena comida!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.WATERPLANT
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.WATERPLANT"
msgid "I feel as though I've ended up in Wonderland, hyuyu!"
msgstr "¡Es como si hubiera acabado en el País de las Maravillas, ju, ju!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.WATERPLANT_BABY
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.WATERPLANT_BABY"
msgid "I surmise it's not yet at full size."
msgstr "Supongo que aún no ha crecido todo lo posible."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.WATERPLANT_BOMB
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.WATERPLANT_BOMB"
msgid "That plant is so selfish, it won't share its shellfish!"
msgstr "Esta planta es tan acaparadora, que no comparte lo que le sobra."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.WATERPLANT_PLANTER
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.WATERPLANT_PLANTER"
msgid "A bouncing baby bulb."
msgstr "Un bulbo bebé botando."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.WATERPUMP
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.WATERPUMP"
msgid "This will put a swift end to fiery pranks..."
msgstr "Esto pondrá fin de inmediato a las bromas incendiarias."

