#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.TURNIP_COOKED
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.TURNIP_COOKED"
msgid "Smell is very good."
msgstr "Huele muy bien."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.TURNIP_SEEDS
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.TURNIP_SEEDS"
msgid "Is little tiny seeds for burying."
msgstr "Semillitas para enterrarlas."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.TURTILLUS
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.TURTILLUS"
msgid "Armor is for tiny men!"
msgstr "¡La armadura es para los hombres pequeños!"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.TWIGGYTREE.BURNING
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.TWIGGYTREE.BURNING"
msgid "Is broke."
msgstr "Está roto."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.TWIGGYTREE.BURNT
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.TWIGGYTREE.BURNT"
msgid "Is small and broken now."
msgstr "Es pequeño y está roto ahora."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.TWIGGYTREE.CHOPPED
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.TWIGGYTREE.CHOPPED"
msgid "Ha! You stood no chance!"
msgstr "¡Ja! ¡No tenías nada que hacer!"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.TWIGGYTREE.DISEASED
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.TWIGGYTREE.DISEASED"
msgid "Is weak. Sickly!"
msgstr "Está débil. ¡Enfermo!"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.TWIGGYTREE.GENERIC
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.TWIGGYTREE.GENERIC"
msgid "Wolfgang will snap like toothpick!"
msgstr "¡Wolfgang lo partirá como un palillo de dientes!"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.TWIGGY_NUT
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.TWIGGY_NUT"
msgid "Little cone make big tree!"
msgstr "¡El pequeño cono será un gran árbol!"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.TWIGGY_NUT_SAPLING
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.TWIGGY_NUT_SAPLING"
msgid "Grow, grow little tree!"
msgstr "¡Crece, crece árbol pequeño!"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.TWIGGY_OLD
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.TWIGGY_OLD"
msgid "Wolfgang wishes to put weak tree out of misery!"
msgstr "¡Wolfgang quiere acabar con la miseria del débil árbol!"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.TWIGS
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.TWIGS"
msgid "Puny twigs! I will break them!"
msgstr "¡Ramas enclenques! ¡Las romperé!"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.TWINOFTERROR1
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.TWINOFTERROR1"
msgid "Eep! Big scary metal eyes even worse!"
msgstr "¡Aaah! ¡Ojos grandes de metal ser todavía peor!"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.TWINOFTERROR2
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.TWINOFTERROR2"
msgid "Eep! Big scary metal eyes even worse!"
msgstr "¡Aaah! ¡Ojos grandes de metal ser todavía peor!"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.UMBRELLA
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.UMBRELLA"
msgid "The rain hurts my mighty skin."
msgstr "La lluvia hace daño a mi poderosa piel."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.UNAGI
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.UNAGI"
msgid "Food makes me mighty!"
msgstr "¡La comida me vuelve poderoso!"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.UNIMPLEMENTED
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.UNIMPLEMENTED"
msgid "I do not trust unfinished business."
msgstr "No me fío de los asuntos pendientes."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.VAULT_CHANDELIER_BROKEN
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.VAULT_CHANDELIER_BROKEN"
msgid "That belong on ceiling."
msgstr "Eso tendría que estar en techo."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.VAULT_COMPASS.GENERIC
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.VAULT_COMPASS.GENERIC"
msgid "Wolfgang knows the way! ...But compass helps."
msgstr "¡Wolfgang conocer el camino...! Pero brújula ayuda."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.VAULT_COMPASS.KEYROOM
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.VAULT_COMPASS.KEYROOM"
msgid "We are here! Just like Wolfgang said!"
msgstr "¡Estamos aquí! ¡Como Wolfgang decir!"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.VAULT_COMPASS.NOTVAULT
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.VAULT_COMPASS.NOTVAULT"
msgid "Is broken! How will Wolfgang know where to go?!"
msgstr "¡Se haber roto! ¡¿Cómo sabrá Wolfgang a dónde ir?!"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.VAULT_CRAWLER.GENERIC
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.VAULT_CRAWLER.GENERIC"
msgid "Rock bug needs little push!"
msgstr "¡Bicho de roca necesitar empujoncito!"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.VAULT_CRAWLER.SOCKETED
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.VAULT_CRAWLER.SOCKETED"
msgid "You stay there, rock bug!"
msgstr "¡No te muevas, bicho de roca!"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.VAULT_CRAWLER_LEVER
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.VAULT_CRAWLER_LEVER"
msgid "Stand back! Wolfgang will pull!"
msgstr "¡Atrás! ¡Wolfgang va a tirar!"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.VAULT_DECON_DOOR
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.VAULT_DECON_DOOR"
msgid "Would be hard for even mighty Wolfgang to break down."
msgstr "Hasta al poderoso Wolfgang le costaría romper."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.VAULT_DECON_MISTER
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.VAULT_DECON_MISTER"
msgid "Chases scary shadows away. Wolfgang like!"
msgstr "Espantar a las sombras aterradoras. ¡A Wolfgang gusta!"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.VAULT_KEY
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.VAULT_KEY"
msgid "Will weird rock help bring Wolfgang home?"
msgstr "¿Roca rara ayudar a Wolfgang a volver a casa?"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.VAULT_KEY_ACTIVATOR
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.VAULT_KEY_ACTIVATOR"
msgid "Has place for putting something inside."
msgstr "Tiene sitio para poner algo dentro."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.VAULT_KEY_EXIT
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.VAULT_KEY_EXIT"
msgid "Nowhere for Wolfgang to tie rope!"
msgstr "¡Wolfgang no tiene donde atar cuerda!"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.VAULT_KEY_PEDESTAL.GENERIC
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.VAULT_KEY_PEDESTAL.GENERIC"
msgid "Time for Wolfgang to claim prize!"
msgstr "¡Es hora de que Wolfgang reclamar premio!"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.VAULT_KEY_PEDESTAL.PICKED
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.VAULT_KEY_PEDESTAL.PICKED"
msgid "Nothing there for Wolfgang."
msgstr "Nada para Wolfgang."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.VAULT_LOBBY_EXIT
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.VAULT_LOBBY_EXIT"
msgid "Too dark to see bottom... maybe Wolfgang climb down with rope, just to be safe."
msgstr "Demasiado oscuro para ver fondo... Wolfgang poder bajar con cuerda, por si acaso."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.VAULT_ORB
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.VAULT_ORB"
msgid "It is not ball for fun."
msgstr "No es pelota para jugar."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.VAULT_ORB_REFINED
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.VAULT_ORB_REFINED"
msgid "So pretty and shiny."
msgstr "Tan bonito y brillante."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.VAULT_PILLAR_GUARD
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.VAULT_PILLAR_GUARD"
msgid "Wolfgang does not like ancient interior decorating."
msgstr "A Wolfgang no gusta antiguo diseño de interiores."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.VAULT_PILLAR_GUARD_CONSTR
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.VAULT_PILLAR_GUARD_CONSTR"
msgid "Wolfgang can't wait!"
msgstr "¡Wolfgang no puede esperar!"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.VAULT_PILLAR_GUARD_CONSTR_PLANS
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.VAULT_PILLAR_GUARD_CONSTR_PLANS"
msgid "Wolfgang need good spot to put."
msgstr "Wolfgang necesita buen sitio para poner."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.VAULT_PILLAR_GUARD_CRAFTED
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.VAULT_PILLAR_GUARD_CRAFTED"
msgid "But is it as mighty as Wolfgang? Of course not!"
msgstr "¿Pero ser tan poderosa como Wolfgang? ¡Claro que no!"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.VAULT_PILLAR_GUARD_DORMANT
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.VAULT_PILLAR_GUARD_DORMANT"
msgid "Ancient tower looks mighty."
msgstr "Torre ancestral parece poderosa."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.VAULT_PILLAR_GUARD_DORMANT_CRAFTED
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.VAULT_PILLAR_GUARD_DORMANT_CRAFTED"
msgid "It need power source to become mighty!"
msgstr "¡Necesita fuente de energía para ser poderosa!"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.VAULT_PILLAR_GUARD_PIECE
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.VAULT_PILLAR_GUARD_PIECE"
msgid "This must belong to big brick guy."
msgstr "Debe ser de gran tipo de ladrillo."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.VAULT_REFINER_PEDESTAL
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.VAULT_REFINER_PEDESTAL"
msgid "What will Wolfgang make here?"
msgstr "¿Qué hacer Wolfgang aquí?"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.VAULT_RUNE
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.VAULT_RUNE"
msgid "Cute scribblemarks."
msgstr "Garabatos adorables."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.VAULT_STATUE.LORE1
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.VAULT_STATUE.LORE1"
msgid "Is very tragic."
msgstr "Una tragedia."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.VAULT_STATUE.LORE2
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.VAULT_STATUE.LORE2"
msgid "Is just bugs. Why Wolfgang heart breaking?"
msgstr "Solo son bichos. ¿Por qué se rompe el corazón de Wolfgang?"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.VAULT_STATUE.LORE3
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.VAULT_STATUE.LORE3"
msgid "Lucky they are statue, or Wolfgang squish them all!"
msgstr "¡Menos mal que son estatuas o Wolfgang aplastaría a todos!"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.VAULT_TELEPORTER.BROKEN
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.VAULT_TELEPORTER.BROKEN"
msgid "Maybe we leave it like this."
msgstr "Igual deberíamos dejar así."

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.VAULT_TELEPORTER.GENERIC
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.VAULT_TELEPORTER.GENERIC"
