msgstr "Creemos que le pasa algo raro a ese pájaro..."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.BIRD_MUTANT_SPITTER
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.BIRD_MUTANT_SPITTER"
