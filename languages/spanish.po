msgctxt "STRINGS.SKILLTREE.WILSON.WILSON_ALCHEMY_2_DESC"
msgid "Transform 2 Red Gems into a Blue Gem.\nTransform 2 Blue Gems into a Red Gem.\nTransform a Blue and Red Gem into a Purple Gem."
