msgstr "¡Oh, non! ¡Vuelvo a ser inflamable!"

#. STRINGS.CHARACTERS.WARLY.ANNOUNCE_HERMITCRAB_SHELL_ARRIVE
msgctxt "STRINGS.CHARACTERS.WARLY.ANNOUNCE_HERMITCRAB_SHELL_ARRIVE"
