msgstr "Un festín para mí."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.YOTP_FOOD2
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.YOTP_FOOD2"
msgid "A meal only a beast would love."
msgstr "Una comida que solo le gustaría a una bestia."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.YOTP_FOOD3
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.YOTP_FOOD3"
msgid "Nothing fancy."
msgstr "Nada sofisticado."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.YOTR_DECOR_1.GENERAL
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.YOTR_DECOR_1.GENERAL"
