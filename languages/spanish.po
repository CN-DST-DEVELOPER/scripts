msgstr "¡Me siento genial! ¡Debe de ser algo que he comido!"

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_ATTACH_BUFF_SLEEPRESISTANCE
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_ATTACH_BUFF_SLEEPRESISTANCE"
