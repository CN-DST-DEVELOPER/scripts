msgstr "¡Así no es como se cocina en flambé!"

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.TROPHYSCALE_OVERSIZEDVEGGIES.BURNT
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.TROPHYSCALE_OVERSIZEDVEGGIES.BURNT"
