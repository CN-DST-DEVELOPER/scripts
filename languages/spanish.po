msgstr "Parecen caramelos, pero solo son rocas."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.LUNARRIFT_PORTAL
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.LUNARRIFT_PORTAL"
