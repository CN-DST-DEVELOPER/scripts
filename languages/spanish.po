msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.WONKEY.REVIVER"
msgid "Thank you for your help, mon... key."
msgstr "Gracias por tu ayuda, mon... no."

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.WOODCARVEDHAT
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.WOODCARVEDHAT"
msgid "Ah, I can see it's been carved with love and care."
msgstr "Ah, veo que lo han tallado con amor y cuidado."

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.WOODIE.ATTACKER
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.WOODIE.ATTACKER"
msgid "I don't trust him with that axe right now."
msgstr "No me fío de él con esa hacha."

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.WOODIE.BEAVER
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.WOODIE.BEAVER"
msgid "What on earth have you been eating?"
msgstr "¿Qué narices has estado comiendo?"

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.WOODIE.BEAVERGHOST
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.WOODIE.BEAVERGHOST"
msgid "My friends are very strange."
msgstr "Mis camaradas son muy raros."

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.WOODIE.FIRESTARTER
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.WOODIE.FIRESTARTER"
msgid "I thought you disliked forest fires?"
msgstr "Pensaba que te horrorizaban los incendios forestales."

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.WOODIE.GENERIC
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.WOODIE.GENERIC"
msgid "Bonjour, %s!"
msgstr "¡Bonjour, %s!"

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.WOODIE.GHOST
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.WOODIE.GHOST"
msgid "Would some comfort food help?"
msgstr "¿Un poco de comida reconfortante sería de ayuda?"

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.WOODIE.GOOSE
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.WOODIE.GOOSE"
msgid "Goodness, are you feeling alright?"
msgstr "Caramba, ¿te encuentras bien?"

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.WOODIE.GOOSEGHOST
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.WOODIE.GOOSEGHOST"
msgid "Looks like your goose is cooked, mon ami."
msgstr "Parece que tu ganso está cocinado, camarade."

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.WOODIE.MOOSE
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.WOODIE.MOOSE"
msgid "That truly is a powerful curse."
msgstr "Es una maldición muy poderosa, la verdad."

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.WOODIE.MOOSEGHOST
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.WOODIE.MOOSEGHOST"
msgid "Don't worry mon ami, I'll get you back on your feet... er, hooves?"
msgstr "No te preocupes, camarade, volverás a estar en pie... Em, ¿pezuñas?"

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.WOODIE.MURDERER
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.WOODIE.MURDERER"
msgid "%s did something unforgivable."
msgstr "%s ha hecho algo imperdonable."

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.WOODIE.REVIVER
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.WOODIE.REVIVER"
msgid "%s has a soft spot a mile wide."
msgstr "%s tiene un punto débil muy llamativo."

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.WOOD_CHAIR.BURNT
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.WOOD_CHAIR.BURNT"
msgid "Chair brûlé."
msgstr "Silla brûlée."

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.WOOD_CHAIR.GENERIC
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.WOOD_CHAIR.GENERIC"
msgid "Mon chair."
msgstr "Mon silla."

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.WOOD_CHAIR.OCCUPIED
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.WOOD_CHAIR.OCCUPIED"
msgid "Leur chair."
msgstr "Leur silla."

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.WOOD_TABLE.BURNT
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.WOOD_TABLE.BURNT"
msgid "C'est tragique."
msgstr "C'est tragique."

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.WOOD_TABLE.GENERIC
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.WOOD_TABLE.GENERIC"
msgid "All it's missing are homecooked food and good wine."
msgstr "Solo le falta una comida casera y un buen vino."

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.WOOD_TABLE.HAS_ITEM
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.WOOD_TABLE.HAS_ITEM"
msgid "All it's missing are homecooked food and good wine."
msgstr "Solo le falta una comida casera y un buen vino."

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.WORM.DIRT
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.WORM.DIRT"
msgid "Dirty."
msgstr "Tierra."

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.WORM.PLANT
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.WORM.PLANT"
msgid "I see nothing amiss here."
msgstr "No veo que falte nada."

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.WORM.WORM
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.WORM.WORM"
msgid "Worm!"
msgstr "¡Una lombriz!"

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.WORMHOLE.GENERIC
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.WORMHOLE.GENERIC"
msgid "That is no ordinary tooth-lined hole in the ground!"
msgstr "¡Eso del suelo no es ningún agujero ordinario con dientes!"

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.WORMHOLE.OPEN
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.WORMHOLE.OPEN"
msgid "Am I really doing this?"
msgstr "¿Estoy de verdad haciendo esto?"

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.WORMHOLE_LIMITED
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.WORMHOLE_LIMITED"
msgid "These things can look worse?"
msgstr "¿Estas cosas pueden ser aún más feas?"

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.WORMLIGHT
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.WORMLIGHT"
msgid "Radiates deliciousness."
msgstr "Irradia exquisitez."

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.WORMLIGHT_LESSER
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.WORMLIGHT_LESSER"
msgid "Not as fresh, but I imagine the flavor is still good."
msgstr "No está muy fresco, pero supongo que sabrá bien."

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.WORMLIGHT_PLANT
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.WORMLIGHT_PLANT"
msgid "I see nothing amiss here."
msgstr "No veo que falte nada."

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.WORMWOOD.ATTACKER
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.WORMWOOD.ATTACKER"
msgid "You won't make friends that way, %s."
msgstr "Así no vas a hacer amigos, %s."

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.WORMWOOD.FIRESTARTER
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.WORMWOOD.FIRESTARTER"
msgid "Fire isn't safe for you, %s."
msgstr "El fuego no es seguro para ti, %s."

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.WORMWOOD.GENERIC
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.WORMWOOD.GENERIC"
msgid "Bonjour, %s!"
msgstr "¡Bonjour, %s!"

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.WORMWOOD.GHOST
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.WORMWOOD.GHOST"
msgid "Hold on, mon amie, I will find a heart."
msgstr "Aguanta, camarade, encontraré un corazón."

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.WORMWOOD.MURDERER
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.WORMWOOD.MURDERER"
msgid "I could never be friends with such a creature."
msgstr "Nunca podría tratar con semejante criatura."

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.WORMWOOD.REVIVER
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.WORMWOOD.REVIVER"
msgid "%s is a kind little veg."
msgstr "%s es un vegetal muy agradable."

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.WORMWOOD_MUTANTPROXY_CARRAT.DEAD
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.WORMWOOD_MUTANTPROXY_CARRAT.DEAD"
msgid "I wonder what you'd taste like."
msgstr "Me pregunto a qué sabrás."

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.WORMWOOD_MUTANTPROXY_CARRAT.GENERIC
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.WORMWOOD_MUTANTPROXY_CARRAT.GENERIC"
msgid "I... think I had a nightmare like this once."
msgstr "Creo... que una vez tuve una pesadilla así."

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.WORMWOOD_MUTANTPROXY_CARRAT.HELD
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.WORMWOOD_MUTANTPROXY_CARRAT.HELD"
msgid "Would you be a meat or a vegetable?"
msgstr "¿Eres carne o verdura?"

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.WORMWOOD_MUTANTPROXY_CARRAT.SLEEPING
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.WORMWOOD_MUTANTPROXY_CARRAT.SLEEPING"
msgid "Bonne nuit."
msgstr "Bonne nuit."

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.WORMWOOD_MUTANTPROXY_FRUITDRAGON.GENERIC
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.WORMWOOD_MUTANTPROXY_FRUITDRAGON.GENERIC"
msgid "Our little friend is not quite ripe."
msgstr "Nuestro pequeño amigo aún no ha madurado."

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.WORMWOOD_MUTANTPROXY_FRUITDRAGON.RIPE
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.WORMWOOD_MUTANTPROXY_FRUITDRAGON.RIPE"
msgid "You'd be perfect in a meal!"
msgstr "¡Quedarías de lujo en una comida!"

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.WORMWOOD_MUTANTPROXY_FRUITDRAGON.SLEEPING
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.WORMWOOD_MUTANTPROXY_FRUITDRAGON.SLEEPING"
msgid "Sleep well, you tasty morsel."
msgstr "Que duermas bien, sabroso bocado."

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.WORMWOOD_MUTANTPROXY_LIGHTFLIER
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.WORMWOOD_MUTANTPROXY_LIGHTFLIER"
msgid "Light the way, mon ami!"
msgstr "¡Ilumina el camino, mon ami!"

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.WORM_BOSS
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.WORM_BOSS"
msgid "That worm looks hungry!"
msgstr "¡Parece que ese gusano tiene hambre!"

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.WORTOX.ATTACKER
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.WORTOX.ATTACKER"
msgid "I don't find %s's pranks very funny."
msgstr "Las bromas de %s no me hacen mucha gracia."

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.WORTOX.FIRESTARTER
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.WORTOX.FIRESTARTER"
msgid "It makes sense that he'd like fire."
msgstr "Tiene sentido que le guste el fuego."

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.WORTOX.GENERIC
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.WORTOX.GENERIC"
msgid "Salut, my fuzzy red friend!"
msgstr "¡Salut, mi peludo y rojo amiguito!"

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.WORTOX.GHOST
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.WORTOX.GHOST"
msgid "I don't think it bothers him as much as it does mortals."
msgstr "No creo que a él le importe tanto como a los mortales."

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.WORTOX.MURDERER
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.WORTOX.MURDERER"
msgid "%s did something very, very cruel."
msgstr "%s ha hecho algo muy muy cruel."

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.WORTOX.REVIVER
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.WORTOX.REVIVER"
msgid "%s is a trickster, but he helps sometimes too."
msgstr "%s te la suele jugar, pero a veces también ayuda."

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.WORTOX_NABBAG
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.WORTOX_NABBAG"
msgid "It is a naughty bag for sure!"
msgstr "¡No cabe duda de que es una bolsa muy atrevida!"

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.WORTOX_REVIVER
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.WORTOX_REVIVER"
msgid "I could not serve this. There is fur on it!"
msgstr "No podría servir esta cosa. ¡Tiene pelos!"

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.WORTOX_SOULJAR
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.WORTOX_SOULJAR"
msgid "Metaphysical snack jar."
msgstr "Un tarro de aperitivos metafísicos."

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.WURT.ATTACKER
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.WURT.ATTACKER"
msgid "That wasn't very nice, %s!"
msgstr "¡Eso no ha estado bonito, %s!"

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.WURT.FIRESTARTER
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.WURT.FIRESTARTER"
msgid "Ah-! Little ones shouldn't play with matches!"
msgstr "¡Ah! ¡Los peques no deberían jugar con cerillas!"

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.WURT.GENERIC
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.WURT.GENERIC"
