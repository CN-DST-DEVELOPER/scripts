msgstr "No parece un bollo..."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.PETALS
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.PETALS"
msgid "How colorful."
msgstr "Qué colorido."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.PETALS_DRIED
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.PETALS_DRIED"
msgid "Did we pick these?"
msgstr "¿Esto lo hemos recogido nosotros?"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.PETALS_EVIL
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.PETALS_EVIL"
msgid "They make our head hurt."
msgstr "Nos dan dolor de cabeza."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.PETALS_EVIL_DRIED
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.PETALS_EVIL_DRIED"
msgid "Did we pick these?"
msgstr "¿Esto lo hemos recogido nosotros?"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.PETRIFIED_TREE
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.PETRIFIED_TREE"
msgid "It's all stone and no bark."
msgstr "Es todo piedra y no tiene corteza."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.PHLEGM
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.PHLEGM"
msgid "It's a boogie!"
msgstr "¡Es un moco!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.PHONOGRAPH
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.PHONOGRAPH"
msgid "We could listen to that forever."
msgstr "Podríamos quedarnos escuchándolo todo el día."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.PICKAXE
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.PICKAXE"
msgid "Rocks will be ours!"
msgstr "¡Las rocas serán nuestras!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.PICKAXE_LUNARPLANT
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.PICKAXE_LUNARPLANT"
