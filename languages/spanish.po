msgstr "Un ramo de hojas."

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.DECIDUOUSTREE.POISON
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.DECIDUOUSTREE.POISON"
msgid "No thank you!"
msgstr "¡No, gracias!"

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.DECK_OF_CARDS
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.DECK_OF_CARDS"
