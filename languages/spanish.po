#. STRINGS.CHARACTERS.WATHGRITHR.ACTIONFAIL.APPLYMODULE.NOTENOUGHSLOTS
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.ACTIONFAIL.APPLYMODULE.NOTENOUGHSLOTS"
msgid "only_used_by_wx78"
msgstr "only_used_by_wx78"

#. STRINGS.CHARACTERS.WATHGRITHR.ACTIONFAIL.APPRAISE.NOTNOW
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.ACTIONFAIL.APPRAISE.NOTNOW"
msgid "Finish thine business with haste! I have glory to attain!"
msgstr "¡Acaba lo que tengas entre manos cuanto antes! ¡La gloria me espera!"

#. STRINGS.CHARACTERS.WATHGRITHR.ACTIONFAIL.ATTUNE.NOHEALTH
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.ACTIONFAIL.ATTUNE.NOHEALTH"
msgid "Alas, I am too stricken."
msgstr "Por desgracia, estoy demasiado débil."

#. STRINGS.CHARACTERS.WATHGRITHR.ACTIONFAIL.BATHBOMB.ALREADY_BOMBED
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.ACTIONFAIL.BATHBOMB.ALREADY_BOMBED"
msgid "Someone has enchanted it already."
msgstr "Alguien lo ha encantado ya."

#. STRINGS.CHARACTERS.WATHGRITHR.ACTIONFAIL.BATHBOMB.GLASSED
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.ACTIONFAIL.BATHBOMB.GLASSED"
msgid "'Tis shielded!"
msgstr "¡Está blindado!"

#. STRINGS.CHARACTERS.WATHGRITHR.ACTIONFAIL.BEGIN_QUEST.ONEGHOST
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.ACTIONFAIL.BEGIN_QUEST.ONEGHOST"
msgid "only_used_by_wendy"
msgstr "only_used_by_wendy"

#. STRINGS.CHARACTERS.WATHGRITHR.ACTIONFAIL.BUILD.BUSY_STATION
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.ACTIONFAIL.BUILD.BUSY_STATION"
msgid "It is not my time yet."
msgstr "Aún no me ha llegado la hora."

#. STRINGS.CHARACTERS.WATHGRITHR.ACTIONFAIL.BUILD.HASPET
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.ACTIONFAIL.BUILD.HASPET"
msgid "I can only command one beastie!"
msgstr "¡Solo puedo dirigir a una bestia!"

#. STRINGS.CHARACTERS.WATHGRITHR.ACTIONFAIL.BUILD.MOUNTED
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.ACTIONFAIL.BUILD.MOUNTED"
msgid "I must first dismount from my mighty steed."
msgstr "Debo bajarme primero de mi poderoso corcel."

#. STRINGS.CHARACTERS.WATHGRITHR.ACTIONFAIL.BUILD.TICOON
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.ACTIONFAIL.BUILD.TICOON"
msgid "I hath already found a guide."
msgstr "Ya he dado con un guía."

#. STRINGS.CHARACTERS.WATHGRITHR.ACTIONFAIL.CARNIVALGAME_FEED.TOO_LATE
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.ACTIONFAIL.CARNIVALGAME_FEED.TOO_LATE"
msgid "I must move with greater haste!"
msgstr "Tengo que darme más prisa."

#. STRINGS.CHARACTERS.WATHGRITHR.ACTIONFAIL.CARVEPUMPKIN.BURNING
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.ACTIONFAIL.CARVEPUMPKIN.BURNING"
msgid "The inferno doth singe me."
msgstr "El infierno me ha chamuscado."

#. STRINGS.CHARACTERS.WATHGRITHR.ACTIONFAIL.CARVEPUMPKIN.INUSE
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.ACTIONFAIL.CARVEPUMPKIN.INUSE"
msgid "'Tis a task for one."
msgstr "Es tarea para una persona."

#. STRINGS.CHARACTERS.WATHGRITHR.ACTIONFAIL.CASTAOE.CANT_SPELL_MOUNTED
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.ACTIONFAIL.CASTAOE.CANT_SPELL_MOUNTED"
msgid "only_used_by_willow"
msgstr "only_used_by_willow"

#. STRINGS.CHARACTERS.WATHGRITHR.ACTIONFAIL.CASTAOE.NOT_ENOUGH_EMBERS
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.ACTIONFAIL.CASTAOE.NOT_ENOUGH_EMBERS"
msgid "only_used_by_willow"
msgstr "only_used_by_willow"

#. STRINGS.CHARACTERS.WATHGRITHR.ACTIONFAIL.CASTAOE.NO_BATTERY
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.ACTIONFAIL.CASTAOE.NO_BATTERY"
msgid "only_used_by_winona"
msgstr "only_used_by_winona"

#. STRINGS.CHARACTERS.WATHGRITHR.ACTIONFAIL.CASTAOE.NO_CATAPULTS
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.ACTIONFAIL.CASTAOE.NO_CATAPULTS"
msgid "only_used_by_winona"
msgstr "only_used_by_winona"

#. STRINGS.CHARACTERS.WATHGRITHR.ACTIONFAIL.CASTAOE.NO_TARGETS
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.ACTIONFAIL.CASTAOE.NO_TARGETS"
msgid "only_used_by_willow"
msgstr "only_used_by_willow"

#. STRINGS.CHARACTERS.WATHGRITHR.ACTIONFAIL.CASTAOE.SPELL_ON_COOLDOWN
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.ACTIONFAIL.CASTAOE.SPELL_ON_COOLDOWN"
msgid "only_used_by_willow"
msgstr "only_used_by_willow"

#. STRINGS.CHARACTERS.WATHGRITHR.ACTIONFAIL.CASTSPELL.TERRAFORM_TOO_SOON
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.ACTIONFAIL.CASTSPELL.TERRAFORM_TOO_SOON"
msgid "only_used_by_wurt"
msgstr "only_used_by_wurt"

#. STRINGS.CHARACTERS.WATHGRITHR.ACTIONFAIL.CHANGEIN.BURNING
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.ACTIONFAIL.CHANGEIN.BURNING"
msgid "Gasp! My furs!"
msgstr "¡Glub! ¡Mis pieles!"

#. STRINGS.CHARACTERS.WATHGRITHR.ACTIONFAIL.CHANGEIN.GENERIC
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.ACTIONFAIL.CHANGEIN.GENERIC"
msgid "That's where I keep all my favorite furs and pelts."
msgstr "Ahí es donde guardo mis pieles favoritas."

#. STRINGS.CHARACTERS.WATHGRITHR.ACTIONFAIL.CHANGEIN.INUSE
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.ACTIONFAIL.CHANGEIN.INUSE"
msgid "I shall let them select their garments first."
msgstr "Dejaré que elijan primero sus prendas."

#. STRINGS.CHARACTERS.WATHGRITHR.ACTIONFAIL.CHANGEIN.NOOCCUPANT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.ACTIONFAIL.CHANGEIN.NOOCCUPANT"
msgid "I cannot groom without a beast."
msgstr "No puedo acicalar a nada si no tengo una bestia."

#. STRINGS.CHARACTERS.WATHGRITHR.ACTIONFAIL.CHANGEIN.NOTENOUGHHAIR
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.ACTIONFAIL.CHANGEIN.NOTENOUGHHAIR"
msgid "First the beast must grow back its mane."
msgstr "Necesito que le vuelva a crecer el pelo a la bestia."

#. STRINGS.CHARACTERS.WATHGRITHR.ACTIONFAIL.CHARGE_FROM.CHARGE_FULL
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.ACTIONFAIL.CHARGE_FROM.CHARGE_FULL"
msgid "Brimming with power like Mjolnir!"
msgstr "¡Rebosante de energía, como Mjolnir!"

#. STRINGS.CHARACTERS.WATHGRITHR.ACTIONFAIL.CHARGE_FROM.NOT_ENOUGH_CHARGE
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.ACTIONFAIL.CHARGE_FROM.NOT_ENOUGH_CHARGE"
msgid "Alas! The charge doth fail!"
msgstr "¡Maldición! ¡La carga se ha quedado corta!"

#. STRINGS.CHARACTERS.WATHGRITHR.ACTIONFAIL.COMPARE_WEIGHABLE.FISH_TOO_SMALL
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.ACTIONFAIL.COMPARE_WEIGHABLE.FISH_TOO_SMALL"
msgid "This wee beastie will not bring me glory."
msgstr "Esta minibestia no me brindará gloria."

#. STRINGS.CHARACTERS.WATHGRITHR.ACTIONFAIL.COMPARE_WEIGHABLE.OVERSIZEDVEGGIES_TOO_SMALL
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.ACTIONFAIL.COMPARE_WEIGHABLE.OVERSIZEDVEGGIES_TOO_SMALL"
msgid "This non-meat isn't even worthy of competing!"
msgstr "¡Este pedazo de alimento sin carne no sirve ni para competir!"

#. STRINGS.CHARACTERS.WATHGRITHR.ACTIONFAIL.CONSTRUCT.EMPTY
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.ACTIONFAIL.CONSTRUCT.EMPTY"
msgid "It requireth materials."
msgstr "Necesita materiales."

#. STRINGS.CHARACTERS.WATHGRITHR.ACTIONFAIL.CONSTRUCT.INUSE
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.ACTIONFAIL.CONSTRUCT.INUSE"
msgid "'Tis in use, and not by me."
msgstr "Alguien lo está usando, y yo no."

#. STRINGS.CHARACTERS.WATHGRITHR.ACTIONFAIL.CONSTRUCT.MISMATCH
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.ACTIONFAIL.CONSTRUCT.MISMATCH"
msgid "Alas! 'Tis the wrong plans."
msgstr "¡Ay! Es el plano equivocado."

#. STRINGS.CHARACTERS.WATHGRITHR.ACTIONFAIL.CONSTRUCT.NOTALLOWED
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.ACTIONFAIL.CONSTRUCT.NOTALLOWED"
msgid "Alas! It doth not go there!"
msgstr "¡Ay! ¡No va ahí!"

#. STRINGS.CHARACTERS.WATHGRITHR.ACTIONFAIL.CONSTRUCT.NOTREADY
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.ACTIONFAIL.CONSTRUCT.NOTREADY"
msgid "'Tis no time for pleasantries!"
msgstr "¡No es momento de formalidades!"

#. STRINGS.CHARACTERS.WATHGRITHR.ACTIONFAIL.COOK.GENERIC
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.ACTIONFAIL.COOK.GENERIC"
msgid "Alas! Bested by cookware!"
msgstr "¡Ay! ¡Derrotado por utensilios de cocina!"

#. STRINGS.CHARACTERS.WATHGRITHR.ACTIONFAIL.COOK.INUSE
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.ACTIONFAIL.COOK.INUSE"
msgid "I shall wait whilst my allies plan their feast."
msgstr "Esperaré mientras mis aliados preparan su festín."

#. STRINGS.CHARACTERS.WATHGRITHR.ACTIONFAIL.COOK.TOOFAR
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.ACTIONFAIL.COOK.TOOFAR"
msgid "I must close the gap between us!"
msgstr "¡Debo cerrar la brecha entre nosotros!"

#. STRINGS.CHARACTERS.WATHGRITHR.ACTIONFAIL.DECORATESNOWMAN.HASHAT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.ACTIONFAIL.DECORATESNOWMAN.HASHAT"
msgid "I will not crush that hat!"
msgstr "¡No voy a aplastar ese sombrero!"

#. STRINGS.CHARACTERS.WATHGRITHR.ACTIONFAIL.DECORATESNOWMAN.INUSE
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.ACTIONFAIL.DECORATESNOWMAN.INUSE"
msgid "It is engaged."
msgstr "Está ocupado."

#. STRINGS.CHARACTERS.WATHGRITHR.ACTIONFAIL.DECORATESNOWMAN.MELTING
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.ACTIONFAIL.DECORATESNOWMAN.MELTING"
msgid "No further. 'Tis is returning to the earth."
msgstr "Se acabó. Regresa a la tierra."

#. STRINGS.CHARACTERS.WATHGRITHR.ACTIONFAIL.DECORATESNOWMAN.STACKEDTOOHIGH
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.ACTIONFAIL.DECORATESNOWMAN.STACKEDTOOHIGH"
msgid "'Tis tall enough!'"
msgstr "¡Ya es lo bastante alto!"

#. STRINGS.CHARACTERS.WATHGRITHR.ACTIONFAIL.DEPLOY.HERMITCRAB_RELOCATE
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.ACTIONFAIL.DEPLOY.HERMITCRAB_RELOCATE"
msgid "'Tis dry. I shall see to it later."
msgstr "Está seco. Me encargaré de ello en otro momento."

#. STRINGS.CHARACTERS.WATHGRITHR.ACTIONFAIL.DISMANTLE.COOKING
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.ACTIONFAIL.DISMANTLE.COOKING"
msgid "I will let it finish its work."
msgstr "Dejaré que termine lo que está haciendo."

#. STRINGS.CHARACTERS.WATHGRITHR.ACTIONFAIL.DISMANTLE.INUSE
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.ACTIONFAIL.DISMANTLE.INUSE"
msgid "I shall valiantly wait my turn."
msgstr "Esperaré valientemente mi turno."

#. STRINGS.CHARACTERS.WATHGRITHR.ACTIONFAIL.DISMANTLE.NOTEMPTY
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.ACTIONFAIL.DISMANTLE.NOTEMPTY"
msgid "First, it must be emptied!"
msgstr "Se tiene que vaciar antes."

#. STRINGS.CHARACTERS.WATHGRITHR.ACTIONFAIL.DIVEGRAB.MISSED
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.ACTIONFAIL.DIVEGRAB.MISSED"
msgid "Curses!"
msgstr "¡Maldiciones!"

#. STRINGS.CHARACTERS.WATHGRITHR.ACTIONFAIL.DRAW.NOIMAGE
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.ACTIONFAIL.DRAW.NOIMAGE"
msgid "The muses will not visit me if I do not place an item first."
msgstr "Las musas no me visitarán si no coloco ningún objeto primero."

#. STRINGS.CHARACTERS.WATHGRITHR.ACTIONFAIL.FILL_OCEAN.UNSUITABLE_FOR_PLANTS
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.ACTIONFAIL.FILL_OCEAN.UNSUITABLE_FOR_PLANTS"
msgid "The plants will like this about as much as I like them."
msgstr "A las plantas les va a gustar tanto como ellas a mí."

#. STRINGS.CHARACTERS.WATHGRITHR.ACTIONFAIL.FISH_OCEAN.TOODEEP
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.ACTIONFAIL.FISH_OCEAN.TOODEEP"
msgid "Come closer, ye wee fishy cowards!"
msgstr "¡Acercaos, cobardicas con escamas!"

#. STRINGS.CHARACTERS.WATHGRITHR.ACTIONFAIL.GENERIC.ITEMMIMIC
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.ACTIONFAIL.GENERIC.ITEMMIMIC"
msgid "Infernal trickster."
msgstr "Embaucador infernal."

#. STRINGS.CHARACTERS.WATHGRITHR.ACTIONFAIL.GIVE.ABIGAILHEART
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.ACTIONFAIL.GIVE.ABIGAILHEART"
msgid "The girl's spirit cannot be returned."
msgstr "El espíritu de la chica no puede ser devuelto."

#. STRINGS.CHARACTERS.WATHGRITHR.ACTIONFAIL.GIVE.BUSY
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.ACTIONFAIL.GIVE.BUSY"
msgid "I'll try once more when it's done."
msgstr "Lo intentaré una vez más cuando acabe."

#. STRINGS.CHARACTERS.WATHGRITHR.ACTIONFAIL.GIVE.CANTSHADOWREVIVE
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.ACTIONFAIL.GIVE.CANTSHADOWREVIVE"
msgid "T'will not raise from death, it seems."
msgstr "Parece que no se levantará de la tumba."

#. STRINGS.CHARACTERS.WATHGRITHR.ACTIONFAIL.GIVE.CARNIVALGAME_ALREADY_PLAYING
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.ACTIONFAIL.GIVE.CARNIVALGAME_ALREADY_PLAYING"
msgid "A warrior must be patient."
msgstr "Una guerrera debe ser paciente."

#. STRINGS.CHARACTERS.WATHGRITHR.ACTIONFAIL.GIVE.CARNIVALGAME_INVALID_ITEM
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.ACTIONFAIL.GIVE.CARNIVALGAME_INVALID_ITEM"
msgid "'Tis not to its liking."
msgstr "No es de su agrado."

#. STRINGS.CHARACTERS.WATHGRITHR.ACTIONFAIL.GIVE.DEAD
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.ACTIONFAIL.GIVE.DEAD"
msgid "They'll have better things in Valhalla."
msgstr "Habrá cosas mejores en Valhalla."

#. STRINGS.CHARACTERS.WATHGRITHR.ACTIONFAIL.GIVE.DUPLICATE
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.ACTIONFAIL.GIVE.DUPLICATE"
msgid "We have already conquered this knowledge."
msgstr "Ya dominamos este conocimiento."

#. STRINGS.CHARACTERS.WATHGRITHR.ACTIONFAIL.GIVE.FOODFULL
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.ACTIONFAIL.GIVE.FOODFULL"
msgid "One sacrifice at a time!"
msgstr "¡Un sacrificio a la vez!"

#. STRINGS.CHARACTERS.WATHGRITHR.ACTIONFAIL.GIVE.GENERIC
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.ACTIONFAIL.GIVE.GENERIC"
msgid "T'will not work."
msgstr "No funcionará."

#. STRINGS.CHARACTERS.WATHGRITHR.ACTIONFAIL.GIVE.GHOSTHEART
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.ACTIONFAIL.GIVE.GHOSTHEART"
msgid "The spirit cannot be returned."
msgstr "El espíritu no puede ser devuelto."

#. STRINGS.CHARACTERS.WATHGRITHR.ACTIONFAIL.GIVE.MUSHROOMFARM_NEEDSLOG
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.ACTIONFAIL.GIVE.MUSHROOMFARM_NEEDSLOG"
msgid "The sprite home requires sprucing up. With magical spruce!"
msgstr "Hay que decorar la casa del duende. ¡Con adornos mágicos!"

#. STRINGS.CHARACTERS.WATHGRITHR.ACTIONFAIL.GIVE.MUSHROOMFARM_NEEDSSHROOM
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.ACTIONFAIL.GIVE.MUSHROOMFARM_NEEDSSHROOM"
msgid "Forest sprites have no need of that."
msgstr "A los duendes del bosque no les hace falta."

#. STRINGS.CHARACTERS.WATHGRITHR.ACTIONFAIL.GIVE.MUSHROOMFARM_NOMOONALLOWED
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.ACTIONFAIL.GIVE.MUSHROOMFARM_NOMOONALLOWED"
msgid "It longs for its homeland. It will not grow here."
msgstr "Anhela su tierra... No va a crecer aquí."

#. STRINGS.CHARACTERS.WATHGRITHR.ACTIONFAIL.GIVE.NOGENERATORSKILL
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.ACTIONFAIL.GIVE.NOGENERATORSKILL"
msgid "Nay, that would be foolhardy."
msgstr "No, sería demasiado arriesgado."

#. STRINGS.CHARACTERS.WATHGRITHR.ACTIONFAIL.GIVE.NOMOON
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.ACTIONFAIL.GIVE.NOMOON"
msgid "Needs the gaze of Mani to work."
msgstr "Necesita la mirada de Máni para que funcione."

#. STRINGS.CHARACTERS.WATHGRITHR.ACTIONFAIL.GIVE.NOTAMONKEY
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.ACTIONFAIL.GIVE.NOTAMONKEY"
msgid "Speak plainly! I understand not thine chittering."
msgstr "¡Habla claro! No comprendo tu parloteo."

#. STRINGS.CHARACTERS.WATHGRITHR.ACTIONFAIL.GIVE.NOTDISH
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.ACTIONFAIL.GIVE.NOTDISH"
msgid "That's not worthy to grace the mouth of the gods!"
msgstr "¡Eso no es digno de la boca de los dioses!"

#. STRINGS.CHARACTERS.WATHGRITHR.ACTIONFAIL.GIVE.NOTGEM
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.ACTIONFAIL.GIVE.NOTGEM"
msgid "This object is not blessed with the power of the gods."
msgstr "Este objeto no está bendecido con el poder de los dioses."

#. STRINGS.CHARACTERS.WATHGRITHR.ACTIONFAIL.GIVE.NOTSCULPTABLE
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.ACTIONFAIL.GIVE.NOTSCULPTABLE"
msgid "That material is not befitting a work of art."
msgstr "Ese material no es apropiado para una obra de arte."

#. STRINGS.CHARACTERS.WATHGRITHR.ACTIONFAIL.GIVE.NOTSTAFF
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.ACTIONFAIL.GIVE.NOTSTAFF"
msgid "The gods may frown were I to do that."
msgstr "Los dioses puede que se enfaden si hago eso."

#. STRINGS.CHARACTERS.WATHGRITHR.ACTIONFAIL.GIVE.PIGKINGGAME_DANGER
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.ACTIONFAIL.GIVE.PIGKINGGAME_DANGER"
msgid "Danger is near! 'Tis no time for games."
msgstr "¡El peligro está cerca! No hay tiempo para juegos."

#. STRINGS.CHARACTERS.WATHGRITHR.ACTIONFAIL.GIVE.PIGKINGGAME_MESSY
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.ACTIONFAIL.GIVE.PIGKINGGAME_MESSY"
msgid "I must clear the battlefield first!"
msgstr "¡Debo despejar primero el campo de batalla!"

#. STRINGS.CHARACTERS.WATHGRITHR.ACTIONFAIL.GIVE.PIGKINGGAME_TOOLATE
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.ACTIONFAIL.GIVE.PIGKINGGAME_TOOLATE"
msgid "'Tis too late for revelry!"
msgstr "¡Es demasiado tarde para jolgorios!"

#. STRINGS.CHARACTERS.WATHGRITHR.ACTIONFAIL.GIVE.QUEENBUSY
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.ACTIONFAIL.GIVE.QUEENBUSY"
msgid "Something else hath caught her attention."
msgstr "Otra cosa ha captado su atención."

#. STRINGS.CHARACTERS.WATHGRITHR.ACTIONFAIL.GIVE.SLEEPING
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.ACTIONFAIL.GIVE.SLEEPING"
msgid "Such sweet slumber... Maybe later."
msgstr "Un sueño tan dulce...Igual más tarde."

#. STRINGS.CHARACTERS.WATHGRITHR.ACTIONFAIL.GIVE.SLOTFULL
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.ACTIONFAIL.GIVE.SLOTFULL"
msgid "One material at a time!"
msgstr "¡Solo un material a la vez!"

#. STRINGS.CHARACTERS.WATHGRITHR.ACTIONFAIL.GIVE.SPIDERNOHAT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.ACTIONFAIL.GIVE.SPIDERNOHAT"
msgid "It hath no use for such things while it's in my pocket."
msgstr "No necesita nada de eso mientras esté en mi bolsillo."

#. STRINGS.CHARACTERS.WATHGRITHR.ACTIONFAIL.GIVE.TERRARIUM_COOLDOWN
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.ACTIONFAIL.GIVE.TERRARIUM_COOLDOWN"
msgid "I shall await the small tree's return before presenting it with another offering."
msgstr "Aguardaré a la vuelta del arbolito antes de entregarle otra ofrenda."

#. STRINGS.CHARACTERS.WATHGRITHR.ACTIONFAIL.GIVE.TERRARIUM_REFUSE
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.ACTIONFAIL.GIVE.TERRARIUM_REFUSE"
msgid "Perhaps it shall accept a different offering."
msgstr "Tal vez debiera aceptar otra ofrenda."

#. STRINGS.CHARACTERS.WATHGRITHR.ACTIONFAIL.GIVE.WRONGGEM
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.ACTIONFAIL.GIVE.WRONGGEM"
msgid "This gem was not chosen for this purpose."
msgstr "Esta gema no fue elegida para este fin."

#. STRINGS.CHARACTERS.WATHGRITHR.ACTIONFAIL.GIVE.WRONGSHADOWFORM
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.ACTIONFAIL.GIVE.WRONGSHADOWFORM"
msgid "We must rearrange the bones of the beast."
msgstr "Debemos reordenar los huesos de la bestia."

#. STRINGS.CHARACTERS.WATHGRITHR.ACTIONFAIL.GIVEALLTOPLAYER.BUSY
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.ACTIONFAIL.GIVEALLTOPLAYER.BUSY"
msgid "I'll try once more when they're free."
msgstr "Lo intentaré una vez más cuando haya terminado."

#. STRINGS.CHARACTERS.WATHGRITHR.ACTIONFAIL.GIVEALLTOPLAYER.DEAD
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.ACTIONFAIL.GIVEALLTOPLAYER.DEAD"
msgid "They'll have better things in Valhalla."
msgstr "Habrá cosas mejores en Valhalla."

#. STRINGS.CHARACTERS.WATHGRITHR.ACTIONFAIL.GIVEALLTOPLAYER.FULL
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.ACTIONFAIL.GIVEALLTOPLAYER.FULL"
msgid "They're not strong enough to carry more!"
msgstr "¡Ya no son lo bastante fuertes para llevar más!"

#. STRINGS.CHARACTERS.WATHGRITHR.ACTIONFAIL.GIVEALLTOPLAYER.SLEEPING
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.ACTIONFAIL.GIVEALLTOPLAYER.SLEEPING"
msgid "Such sweet slumber graces thy face... Maybe later."
msgstr "Ese dueño tan dulce te alegra el rostro... Igual más tarde."

#. STRINGS.CHARACTERS.WATHGRITHR.ACTIONFAIL.GIVETOPLAYER.BUSY
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.ACTIONFAIL.GIVETOPLAYER.BUSY"
msgid "I'll try once more when they're free."
msgstr "Lo intentaré una vez más cuando haya terminado."

#. STRINGS.CHARACTERS.WATHGRITHR.ACTIONFAIL.GIVETOPLAYER.DEAD
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.ACTIONFAIL.GIVETOPLAYER.DEAD"
msgid "They'll have better things in Valhalla."
msgstr "Habrá cosas mejores en Valhalla."

#. STRINGS.CHARACTERS.WATHGRITHR.ACTIONFAIL.GIVETOPLAYER.FULL
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.ACTIONFAIL.GIVETOPLAYER.FULL"
msgid "They're not strong enough to carry more!"
msgstr "¡Ya no son lo bastante fuertes para llevar más!"

#. STRINGS.CHARACTERS.WATHGRITHR.ACTIONFAIL.GIVETOPLAYER.SLEEPING
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.ACTIONFAIL.GIVETOPLAYER.SLEEPING"
msgid "Such sweet slumber graces thy face... Maybe later."
msgstr "Ese dueño tan dulce te alegra el rostro... Igual más tarde."

#. STRINGS.CHARACTERS.WATHGRITHR.ACTIONFAIL.GIVE_TACKLESKETCH.DUPLICATE
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.ACTIONFAIL.GIVE_TACKLESKETCH.DUPLICATE"
msgid "We have already conquered this knowledge."
msgstr "Ya dominamos este conocimiento."

#. STRINGS.CHARACTERS.WATHGRITHR.ACTIONFAIL.HARVEST.DOER_ISNT_MODULE_OWNER
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.ACTIONFAIL.HARVEST.DOER_ISNT_MODULE_OWNER"
msgid "I respect thine loyalty to our metal warrior, scout."
msgstr "Respeto tu lealtad a mi paladín de metal."

#. STRINGS.CHARACTERS.WATHGRITHR.ACTIONFAIL.HEAL.NOT_MERM
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.ACTIONFAIL.HEAL.NOT_MERM"
msgid "'Tis for the fish beasts."
msgstr "Es para las bestias marinas."

#. STRINGS.CHARACTERS.WATHGRITHR.ACTIONFAIL.HERD_FOLLOWERS.WEBBERONLY
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.ACTIONFAIL.HERD_FOLLOWERS.WEBBERONLY"
msgid "The spiderchild is the only one who can tame those little beasts!"
msgstr "¡El único que puede domar a esas bestias es el chico araña!"

#. STRINGS.CHARACTERS.WATHGRITHR.ACTIONFAIL.HITCHUP.BEEF_HITCHED
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.ACTIONFAIL.HITCHUP.BEEF_HITCHED"
msgid "The beast hath already been secured to its post."
msgstr "La bestia ya está atada en su lugar."

#. STRINGS.CHARACTERS.WATHGRITHR.ACTIONFAIL.HITCHUP.INMOOD
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.ACTIONFAIL.HITCHUP.INMOOD"
msgid "The beast is in a foul temper."
msgstr "La bestia ha entrado en cólera..."

#. STRINGS.CHARACTERS.WATHGRITHR.ACTIONFAIL.HITCHUP.NEEDBEEF
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.ACTIONFAIL.HITCHUP.NEEDBEEF"
msgid "I have a hitching post, but no beast."
msgstr "Tengo un poste para atar a la bestia, pero no tengo bestia alguna."

#. STRINGS.CHARACTERS.WATHGRITHR.ACTIONFAIL.HITCHUP.NEEDBEEF_CLOSER
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.ACTIONFAIL.HITCHUP.NEEDBEEF_CLOSER"
msgid "I shall have to coax the beast closer."
msgstr "Necesito persuadir a la bestia para que se acerque."

#. STRINGS.CHARACTERS.WATHGRITHR.ACTIONFAIL.LOWER_SAIL_FAIL.1
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.ACTIONFAIL.LOWER_SAIL_FAIL.1"
msgid "By Aegir, you will bend to my will!"
msgstr "¡Te doblegarás a mi voluntad, por Aegir!"

#. STRINGS.CHARACTERS.WATHGRITHR.ACTIONFAIL.LOWER_SAIL_FAIL.2
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.ACTIONFAIL.LOWER_SAIL_FAIL.2"
msgid "Oh-ho! Feisty, are we?"
msgstr "¡Oh-oh! Con ganas, ¿eh?"

#. STRINGS.CHARACTERS.WATHGRITHR.ACTIONFAIL.LOWER_SAIL_FAIL.3
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.ACTIONFAIL.LOWER_SAIL_FAIL.3"
msgid "I will not be defeated by my own vessel!"
msgstr "¡No me dejaré vencer por mi propio navío!"

#. STRINGS.CHARACTERS.WATHGRITHR.ACTIONFAIL.MARK.ALREADY_MARKED
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.ACTIONFAIL.MARK.ALREADY_MARKED"
msgid "I must stand by my choice, even in the heat of competition!"
msgstr "¡He de luchar por mi decisión, incluso en mitad de la competición!"

#. STRINGS.CHARACTERS.WATHGRITHR.ACTIONFAIL.MARK.NOT_PARTICIPANT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.ACTIONFAIL.MARK.NOT_PARTICIPANT"
msgid "I cannot join in the competition without a beastie of my own."
msgstr "No me puedo unir a la competición si no tengo una bestia."

#. STRINGS.CHARACTERS.WATHGRITHR.ACTIONFAIL.MOUNT.INUSE
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.ACTIONFAIL.MOUNT.INUSE"
msgid "I'll need to be faster than that in battle!"
msgstr "¡Tengo que ser más rápida en la batalla!"

#. STRINGS.CHARACTERS.WATHGRITHR.ACTIONFAIL.MOUNT.SLEEPING
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.ACTIONFAIL.MOUNT.SLEEPING"
msgid "Rise, beastie! We ride!"
msgstr "¡Arriba, bestia! ¡A cabalgar!"

#. STRINGS.CHARACTERS.WATHGRITHR.ACTIONFAIL.MOUNT.TARGETINCOMBAT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.ACTIONFAIL.MOUNT.TARGETINCOMBAT"
msgid "I'll only ride it if it's the victor."
msgstr "Solo me montaré si es el vencedor."

#. STRINGS.CHARACTERS.WATHGRITHR.ACTIONFAIL.MUTATE.CAVE
