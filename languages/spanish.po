msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.YOTB_POST"
msgid "Enjoy your time in the spotlight while you can."
msgstr "Disfruta siendo el centro de atención mientras puedas."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.YOTB_POST_ITEM
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.YOTB_POST_ITEM"
msgid "This seems like a dreadful amount of effort."
msgstr "Creo que esto requiere de demasiado esfuerzo..."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.YOTB_SEWINGMACHINE
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.YOTB_SEWINGMACHINE"
msgid "I'm more of an appreciator of fine clothes than a maker of them."
msgstr "Prefiero apreciar la ropa de calidad en lugar de confeccionarla."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.YOTB_SEWINGMACHINE_ITEM
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.YOTB_SEWINGMACHINE_ITEM"
