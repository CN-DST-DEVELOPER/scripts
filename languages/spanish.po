msgstr "¡Hay premios dentro!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.OTTERDEN_DEAD
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.OTTERDEN_DEAD"
msgid "We're in trouble."
msgstr "Tenemos problemas."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.PALMCONETREE
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.PALMCONETREE"
msgid "It looks hard to climb."
msgstr "Parece difícil de escalar."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.PALMCONE_SAPLING
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.PALMCONE_SAPLING"
