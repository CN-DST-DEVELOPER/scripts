msgstr "Es un manantial caliente y agradable."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.HERMITHOTSPRING_CONSTR
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.HERMITHOTSPRING_CONSTR"
msgid "It's takin' a while."
msgstr "Está tardando lo suyo."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.HERMITHOUSE.BUILTUP
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.HERMITHOUSE.BUILTUP"
msgid "Just needed a bit of elbow grease."
msgstr "Solo necesitaba un poco de esfuerzo."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.HERMITHOUSE.GENERIC
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.HERMITHOUSE.GENERIC"
msgid "That can't be up to code."
msgstr "Eso no puede cumplir con la normativa."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.HERMITHOUSE_LAUNDRY
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.HERMITHOUSE_LAUNDRY"
msgid "Guess it's laundry day."
msgstr "Supongo que es día de colada."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.HERMITHOUSE_ORNAMENT
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.HERMITHOUSE_ORNAMENT"
msgid "Aw, that's sweet."
msgstr "Oh, qué cucada."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.HERMIT_BUNDLE
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.HERMIT_BUNDLE"
msgid "Aw, she didn't have to give me anything..."
msgstr "Ay, no tenía por qué darme nada..."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.HERMIT_BUNDLE_SHELLS
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.HERMIT_BUNDLE_SHELLS"
msgid "Not sure what came over me to buy these knicknacks."
msgstr "No sé qué mosca me ha picado para comprarme todos estos trastos."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.HERMIT_CRACKED_PEARL
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.HERMIT_CRACKED_PEARL"
msgid "I'm so sorry, Pearl."
msgstr "Lo siento mucho, Perla."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.HERMIT_PEARL
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.HERMIT_PEARL"
msgid "I know a bit about not givin' up on someone."
msgstr "Sé algo acerca de no perder la esperanza en alguien."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.HIVEHAT
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.HIVEHAT"
msgid "Snoot city."
msgstr "Ciudad presuntuosa."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.HOME
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.HOME"
msgid "They say you can't go home again."
msgstr "Dice que no puedes volver a casa."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.HOMESIGN.BURNT
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.HOMESIGN.BURNT"
msgid "Burnt to cinders."
msgstr "Se ha quemado hasta convertirse en cenizas."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.HOMESIGN.GENERIC
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.HOMESIGN.GENERIC"
msgid "I'll take this as a sign."
msgstr "Tomaré esto como una señal."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.HOMESIGN.UNWRITTEN
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.HOMESIGN.UNWRITTEN"
