#. STRINGS.STAGEACTOR.ACT1_SCENE1.LINE1
msgctxt "STRINGS.STAGEACTOR.ACT1_SCENE1.LINE1"
msgid "Act 1."
msgstr ""

#. STRINGS.STAGEACTOR.ACT1_SCENE1.LINE10
msgctxt "STRINGS.STAGEACTOR.ACT1_SCENE1.LINE10"
msgid "There are so many things I've never done,"
msgstr ""

#. STRINGS.STAGEACTOR.ACT1_SCENE1.LINE11
msgctxt "STRINGS.STAGEACTOR.ACT1_SCENE1.LINE11"
msgid "so many things I've never seen..."
msgstr ""

#. STRINGS.STAGEACTOR.ACT1_SCENE1.LINE12
msgctxt "STRINGS.STAGEACTOR.ACT1_SCENE1.LINE12"
msgid "I must explore every last bit of it!"
msgstr ""

#. STRINGS.STAGEACTOR.ACT1_SCENE1.LINE13
msgctxt "STRINGS.STAGEACTOR.ACT1_SCENE1.LINE13"
msgid "The thought of starting a life of her own"
msgstr ""

#. STRINGS.STAGEACTOR.ACT1_SCENE1.LINE14
msgctxt "STRINGS.STAGEACTOR.ACT1_SCENE1.LINE14"
msgid "filled the doll's heart with joy."
msgstr ""

#. STRINGS.STAGEACTOR.ACT1_SCENE1.LINE15
msgctxt "STRINGS.STAGEACTOR.ACT1_SCENE1.LINE15"
msgid "But not everyone shared the sentiment..."
msgstr ""

#. STRINGS.STAGEACTOR.ACT1_SCENE1.LINE16
msgctxt "STRINGS.STAGEACTOR.ACT1_SCENE1.LINE16"
msgid "You don't see talent like that everyday."
msgstr ""

#. STRINGS.STAGEACTOR.ACT1_SCENE1.LINE17
msgctxt "STRINGS.STAGEACTOR.ACT1_SCENE1.LINE17"
msgid "Thankfully."
msgstr ""

#. STRINGS.STAGEACTOR.ACT1_SCENE1.LINE18
msgctxt "STRINGS.STAGEACTOR.ACT1_SCENE1.LINE18"
msgid "At least the tree was good."
msgstr ""

#. STRINGS.STAGEACTOR.ACT1_SCENE1.LINE19
msgctxt "STRINGS.STAGEACTOR.ACT1_SCENE1.LINE19"
msgid "HA HA HA HA HA!"
msgstr ""

#. STRINGS.STAGEACTOR.ACT1_SCENE1.LINE2
msgctxt "STRINGS.STAGEACTOR.ACT1_SCENE1.LINE2"
msgid "Yeah, scene 1!"
msgstr ""

#. STRINGS.STAGEACTOR.ACT1_SCENE1.LINE3
msgctxt "STRINGS.STAGEACTOR.ACT1_SCENE1.LINE3"
msgid "Long ago, in a land oh so far away"
msgstr ""

#. STRINGS.STAGEACTOR.ACT1_SCENE1.LINE4
msgctxt "STRINGS.STAGEACTOR.ACT1_SCENE1.LINE4"
msgid "a strange magic filled the air,"
msgstr ""

#. STRINGS.STAGEACTOR.ACT1_SCENE1.LINE5
msgctxt "STRINGS.STAGEACTOR.ACT1_SCENE1.LINE5"
msgid "and a porcelain doll came to life."
msgstr ""

#. STRINGS.STAGEACTOR.ACT1_SCENE1.LINE6
msgctxt "STRINGS.STAGEACTOR.ACT1_SCENE1.LINE6"
msgid "Ahh."
msgstr ""

#. STRINGS.STAGEACTOR.ACT1_SCENE1.LINE7
msgctxt "STRINGS.STAGEACTOR.ACT1_SCENE1.LINE7"
msgid "I can move my hands? And my feet too!"
msgstr ""

#. STRINGS.STAGEACTOR.ACT1_SCENE1.LINE8
msgctxt "STRINGS.STAGEACTOR.ACT1_SCENE1.LINE8"
msgid "Is this what it's like to be alive?"
msgstr ""

#. STRINGS.STAGEACTOR.ACT1_SCENE1.LINE9
msgctxt "STRINGS.STAGEACTOR.ACT1_SCENE1.LINE9"
msgid "And what a big world to be alive in!"
msgstr ""

#. STRINGS.STAGEACTOR.ACT1_SCENE2.LINE1
msgctxt "STRINGS.STAGEACTOR.ACT1_SCENE2.LINE1"
msgid "Act 1!"
msgstr ""

#. STRINGS.STAGEACTOR.ACT1_SCENE2.LINE10
msgctxt "STRINGS.STAGEACTOR.ACT1_SCENE2.LINE10"
msgid "The world is filled with dangers"
msgstr ""

#. STRINGS.STAGEACTOR.ACT1_SCENE2.LINE11
msgctxt "STRINGS.STAGEACTOR.ACT1_SCENE2.LINE11"
msgid "for one as fragile as you."
msgstr ""

#. STRINGS.STAGEACTOR.ACT1_SCENE2.LINE12
msgctxt "STRINGS.STAGEACTOR.ACT1_SCENE2.LINE12"
msgid "It's simply not the place for a girl made of porcelain!"
msgstr ""

#. STRINGS.STAGEACTOR.ACT1_SCENE2.LINE13
msgctxt "STRINGS.STAGEACTOR.ACT1_SCENE2.LINE13"
msgid "I know what must be done,"
msgstr ""

#. STRINGS.STAGEACTOR.ACT1_SCENE2.LINE14
msgctxt "STRINGS.STAGEACTOR.ACT1_SCENE2.LINE14"
msgid "I will build you a fine suit of armor."
msgstr ""

#. STRINGS.STAGEACTOR.ACT1_SCENE2.LINE15
msgctxt "STRINGS.STAGEACTOR.ACT1_SCENE2.LINE15"
msgid "Wear it, and you will have nothing to fear."
msgstr ""

#. STRINGS.STAGEACTOR.ACT1_SCENE2.LINE16
msgctxt "STRINGS.STAGEACTOR.ACT1_SCENE2.LINE16"
msgid "And so, the Blacksmith went to her anvil,"
msgstr ""

#. STRINGS.STAGEACTOR.ACT1_SCENE2.LINE17
msgctxt "STRINGS.STAGEACTOR.ACT1_SCENE2.LINE17"
msgid "and fashioned a suit of heavy iron armor."
msgstr ""

#. STRINGS.STAGEACTOR.ACT1_SCENE2.LINE18
msgctxt "STRINGS.STAGEACTOR.ACT1_SCENE2.LINE18"
msgid "The little doll put it on,"
msgstr ""

#. STRINGS.STAGEACTOR.ACT1_SCENE2.LINE19
msgctxt "STRINGS.STAGEACTOR.ACT1_SCENE2.LINE19"
msgid "but found that she could barely move in it."
msgstr ""

#. STRINGS.STAGEACTOR.ACT1_SCENE2.LINE2
msgctxt "STRINGS.STAGEACTOR.ACT1_SCENE2.LINE2"
msgid "Scene 2, right?"
msgstr ""

#. STRINGS.STAGEACTOR.ACT1_SCENE2.LINE20
msgctxt "STRINGS.STAGEACTOR.ACT1_SCENE2.LINE20"
msgid "This armor is so heavy,"
msgstr ""

#. STRINGS.STAGEACTOR.ACT1_SCENE2.LINE21
msgctxt "STRINGS.STAGEACTOR.ACT1_SCENE2.LINE21"
msgid "I feel as though I might just..."
msgstr ""

#. STRINGS.STAGEACTOR.ACT1_SCENE2.LINE22
msgctxt "STRINGS.STAGEACTOR.ACT1_SCENE2.LINE22"
msgid "The little doll waited until it was dark,"
msgstr ""

#. STRINGS.STAGEACTOR.ACT1_SCENE2.LINE23
msgctxt "STRINGS.STAGEACTOR.ACT1_SCENE2.LINE23"
msgid "and the Blacksmith went to sleep."
msgstr ""

#. STRINGS.STAGEACTOR.ACT1_SCENE2.LINE24
msgctxt "STRINGS.STAGEACTOR.ACT1_SCENE2.LINE24"
msgid "Then she shed the heavy armor,"
msgstr ""

#. STRINGS.STAGEACTOR.ACT1_SCENE2.LINE25
msgctxt "STRINGS.STAGEACTOR.ACT1_SCENE2.LINE25"
msgid "and slipped out into the night"
msgstr ""

#. STRINGS.STAGEACTOR.ACT1_SCENE2.LINE26
msgctxt "STRINGS.STAGEACTOR.ACT1_SCENE2.LINE26"
msgid "to begin her adventure."
msgstr ""

#. STRINGS.STAGEACTOR.ACT1_SCENE2.LINE27
msgctxt "STRINGS.STAGEACTOR.ACT1_SCENE2.LINE27"
msgid "Sis... are you tryin' to tell me something?"
msgstr ""

#. STRINGS.STAGEACTOR.ACT1_SCENE2.LINE28
msgctxt "STRINGS.STAGEACTOR.ACT1_SCENE2.LINE28"
msgid "That blacksmith really cracks me up."
msgstr ""

#. STRINGS.STAGEACTOR.ACT1_SCENE2.LINE29
msgctxt "STRINGS.STAGEACTOR.ACT1_SCENE2.LINE29"
msgid "I dunno, the acting was pretty heavy-handed."
msgstr ""

#. STRINGS.STAGEACTOR.ACT1_SCENE2.LINE3
msgctxt "STRINGS.STAGEACTOR.ACT1_SCENE2.LINE3"
msgid "The little doll ran first to the Blacksmith,"
msgstr ""

#. STRINGS.STAGEACTOR.ACT1_SCENE2.LINE30
msgctxt "STRINGS.STAGEACTOR.ACT1_SCENE2.LINE30"
msgid "HA HA HA HA HA!"
msgstr ""

#. STRINGS.STAGEACTOR.ACT1_SCENE2.LINE31
msgctxt "STRINGS.STAGEACTOR.ACT1_SCENE2.LINE31"
msgid "But did you see that tree?"
msgstr ""

#. STRINGS.STAGEACTOR.ACT1_SCENE2.LINE32
msgctxt "STRINGS.STAGEACTOR.ACT1_SCENE2.LINE32"
msgid "Right? Such presence!"
msgstr ""

#. STRINGS.STAGEACTOR.ACT1_SCENE2.LINE4
msgctxt "STRINGS.STAGEACTOR.ACT1_SCENE2.LINE4"
msgid "who had cared for her ever since"
msgstr ""

#. STRINGS.STAGEACTOR.ACT1_SCENE2.LINE5
msgctxt "STRINGS.STAGEACTOR.ACT1_SCENE2.LINE5"
msgid "the Blacksmith herself was small."
msgstr ""

#. STRINGS.STAGEACTOR.ACT1_SCENE2.LINE6
msgctxt "STRINGS.STAGEACTOR.ACT1_SCENE2.LINE6"
msgid "The Blacksmith was delighted to see"
msgstr ""

#. STRINGS.STAGEACTOR.ACT1_SCENE2.LINE7
msgctxt "STRINGS.STAGEACTOR.ACT1_SCENE2.LINE7"
msgid "that the doll had come to life,"
msgstr ""

#. STRINGS.STAGEACTOR.ACT1_SCENE2.LINE8
msgctxt "STRINGS.STAGEACTOR.ACT1_SCENE2.LINE8"
msgid "but her delight quickly gave way to fear."
msgstr ""

#. STRINGS.STAGEACTOR.ACT1_SCENE2.LINE9
msgctxt "STRINGS.STAGEACTOR.ACT1_SCENE2.LINE9"
msgid "Little doll, you must be careful!"
msgstr ""

#. STRINGS.STAGEACTOR.ACT1_SCENE3.LINE1
msgctxt "STRINGS.STAGEACTOR.ACT1_SCENE3.LINE1"
msgid "Act 1."
msgstr ""

#. STRINGS.STAGEACTOR.ACT1_SCENE3.LINE10
msgctxt "STRINGS.STAGEACTOR.ACT1_SCENE3.LINE10"
msgid "and the trees and flowers bloomed at his command."
msgstr ""

#. STRINGS.STAGEACTOR.ACT1_SCENE3.LINE11
msgctxt "STRINGS.STAGEACTOR.ACT1_SCENE3.LINE11"
msgid "Crowds gathered to watch him pass."
msgstr ""

#. STRINGS.STAGEACTOR.ACT1_SCENE3.LINE12
msgctxt "STRINGS.STAGEACTOR.ACT1_SCENE3.LINE12"
msgid "Get a load of this guy."
msgstr ""

#. STRINGS.STAGEACTOR.ACT1_SCENE3.LINE13
msgctxt "STRINGS.STAGEACTOR.ACT1_SCENE3.LINE13"
msgid "What a show-off."
msgstr ""

#. STRINGS.STAGEACTOR.ACT1_SCENE3.LINE14
msgctxt "STRINGS.STAGEACTOR.ACT1_SCENE3.LINE14"
msgid "Excuse me, sir!"
msgstr ""

#. STRINGS.STAGEACTOR.ACT1_SCENE3.LINE15
msgctxt "STRINGS.STAGEACTOR.ACT1_SCENE3.LINE15"
msgid "How did you make the flowers bloom?"
msgstr ""

#. STRINGS.STAGEACTOR.ACT1_SCENE3.LINE16
msgctxt "STRINGS.STAGEACTOR.ACT1_SCENE3.LINE16"
msgid "Why, it's magic, my dear!"
msgstr ""

#. STRINGS.STAGEACTOR.ACT1_SCENE3.LINE17
msgctxt "STRINGS.STAGEACTOR.ACT1_SCENE3.LINE17"
msgid "And I am no simple \"sir\","
msgstr ""

#. STRINGS.STAGEACTOR.ACT1_SCENE3.LINE18
msgctxt "STRINGS.STAGEACTOR.ACT1_SCENE3.LINE18"
msgid "but the King of this land!"
msgstr ""

#. STRINGS.STAGEACTOR.ACT1_SCENE3.LINE19
msgctxt "STRINGS.STAGEACTOR.ACT1_SCENE3.LINE19"
msgid "Oh! I'm terribly sorry,"
msgstr ""

#. STRINGS.STAGEACTOR.ACT1_SCENE3.LINE2
msgctxt "STRINGS.STAGEACTOR.ACT1_SCENE3.LINE2"
msgid "Scene 3!"
msgstr ""

#. STRINGS.STAGEACTOR.ACT1_SCENE3.LINE20
msgctxt "STRINGS.STAGEACTOR.ACT1_SCENE3.LINE20"
msgid "I've never met a king before,"
msgstr ""

#. STRINGS.STAGEACTOR.ACT1_SCENE3.LINE21
msgctxt "STRINGS.STAGEACTOR.ACT1_SCENE3.LINE21"
msgid "I didn't know what they looked like."
msgstr ""

#. STRINGS.STAGEACTOR.ACT1_SCENE3.LINE22
msgctxt "STRINGS.STAGEACTOR.ACT1_SCENE3.LINE22"
msgid "Ho, ho!"
msgstr ""

#. STRINGS.STAGEACTOR.ACT1_SCENE3.LINE23
msgctxt "STRINGS.STAGEACTOR.ACT1_SCENE3.LINE23"
msgid "Truth be told,"
msgstr ""

#. STRINGS.STAGEACTOR.ACT1_SCENE3.LINE24
msgctxt "STRINGS.STAGEACTOR.ACT1_SCENE3.LINE24"
msgid "I've never met a porcelain doll"
msgstr ""

#. STRINGS.STAGEACTOR.ACT1_SCENE3.LINE25
msgctxt "STRINGS.STAGEACTOR.ACT1_SCENE3.LINE25"
msgid "quite so alive before."
msgstr ""

#. STRINGS.STAGEACTOR.ACT1_SCENE3.LINE26
msgctxt "STRINGS.STAGEACTOR.ACT1_SCENE3.LINE26"
msgid "Perhaps we could travel together?"
msgstr ""

#. STRINGS.STAGEACTOR.ACT1_SCENE3.LINE27
msgctxt "STRINGS.STAGEACTOR.ACT1_SCENE3.LINE27"
msgid "This road is long, and can get quite lonely."
msgstr ""

#. STRINGS.STAGEACTOR.ACT1_SCENE3.LINE28
msgctxt "STRINGS.STAGEACTOR.ACT1_SCENE3.LINE28"
msgid "How wonderful!"
msgstr ""

#. STRINGS.STAGEACTOR.ACT1_SCENE3.LINE29
msgctxt "STRINGS.STAGEACTOR.ACT1_SCENE3.LINE29"
msgid "Would you teach me your magic along the way?"
msgstr ""

#. STRINGS.STAGEACTOR.ACT1_SCENE3.LINE3
msgctxt "STRINGS.STAGEACTOR.ACT1_SCENE3.LINE3"
msgid "Yeah, scene 3."
msgstr ""

#. STRINGS.STAGEACTOR.ACT1_SCENE3.LINE30
msgctxt "STRINGS.STAGEACTOR.ACT1_SCENE3.LINE30"
msgid "I would be delighted."
msgstr ""

#. STRINGS.STAGEACTOR.ACT1_SCENE3.LINE31
msgctxt "STRINGS.STAGEACTOR.ACT1_SCENE3.LINE31"
msgid "The plot thickens."
msgstr ""

#. STRINGS.STAGEACTOR.ACT1_SCENE3.LINE32
msgctxt "STRINGS.STAGEACTOR.ACT1_SCENE3.LINE32"
msgid "I think you mean sickens."
msgstr ""

#. STRINGS.STAGEACTOR.ACT1_SCENE3.LINE33
msgctxt "STRINGS.STAGEACTOR.ACT1_SCENE3.LINE33"
msgid "HA HA HA HA HA!"
msgstr ""

#. STRINGS.STAGEACTOR.ACT1_SCENE3.LINE4
msgctxt "STRINGS.STAGEACTOR.ACT1_SCENE3.LINE4"
msgid "The little doll walked and walked,"
msgstr ""

#. STRINGS.STAGEACTOR.ACT1_SCENE3.LINE5
msgctxt "STRINGS.STAGEACTOR.ACT1_SCENE3.LINE5"
msgid "marveling as the countryside gave way"
msgstr ""

#. STRINGS.STAGEACTOR.ACT1_SCENE3.LINE6
msgctxt "STRINGS.STAGEACTOR.ACT1_SCENE3.LINE6"
msgid "to a bustling city."
msgstr ""

#. STRINGS.STAGEACTOR.ACT1_SCENE3.LINE7
msgctxt "STRINGS.STAGEACTOR.ACT1_SCENE3.LINE7"
msgid "One day, she happened upon a man in a golden crown,"
msgstr ""

#. STRINGS.STAGEACTOR.ACT1_SCENE3.LINE8
msgctxt "STRINGS.STAGEACTOR.ACT1_SCENE3.LINE8"
msgid "traveling down the road."
msgstr ""

#. STRINGS.STAGEACTOR.ACT1_SCENE3.LINE9
msgctxt "STRINGS.STAGEACTOR.ACT1_SCENE3.LINE9"
msgid "He twirled his finger in the air,"
msgstr ""

#. STRINGS.STAGEACTOR.ACT2_SCENE4.LINE1
msgctxt "STRINGS.STAGEACTOR.ACT2_SCENE4.LINE1"
msgid "Back from intermission."
msgstr ""

#. STRINGS.STAGEACTOR.ACT2_SCENE4.LINE10
msgctxt "STRINGS.STAGEACTOR.ACT2_SCENE4.LINE10"
msgid "I'm a bit under the weather."
msgstr ""

#. STRINGS.STAGEACTOR.ACT2_SCENE4.LINE11
msgctxt "STRINGS.STAGEACTOR.ACT2_SCENE4.LINE11"
msgid "I'm afraid I can't,"
msgstr ""

#. STRINGS.STAGEACTOR.ACT2_SCENE4.LINE12
msgctxt "STRINGS.STAGEACTOR.ACT2_SCENE4.LINE12"
msgid "there's a full moon out tonight!"
msgstr ""

#. STRINGS.STAGEACTOR.ACT2_SCENE4.LINE13
msgctxt "STRINGS.STAGEACTOR.ACT2_SCENE4.LINE13"
msgid "Dear me, I couldn't possibly!"
msgstr ""

#. STRINGS.STAGEACTOR.ACT2_SCENE4.LINE14
msgctxt "STRINGS.STAGEACTOR.ACT2_SCENE4.LINE14"
msgid "Don't you know it's bad luck to teach magic on Wednesdays?"
msgstr ""

#. STRINGS.STAGEACTOR.ACT2_SCENE4.LINE15
msgctxt "STRINGS.STAGEACTOR.ACT2_SCENE4.LINE15"
msgid "The doll believed the King,"
msgstr ""

#. STRINGS.STAGEACTOR.ACT2_SCENE4.LINE16
msgctxt "STRINGS.STAGEACTOR.ACT2_SCENE4.LINE16"
msgid "so she waited. And waited..."
msgstr ""

#. STRINGS.STAGEACTOR.ACT2_SCENE4.LINE17
msgctxt "STRINGS.STAGEACTOR.ACT2_SCENE4.LINE17"
msgid "Until one day,"
msgstr ""

#. STRINGS.STAGEACTOR.ACT2_SCENE4.LINE18
msgctxt "STRINGS.STAGEACTOR.ACT2_SCENE4.LINE18"
msgid "she found a hidden chamber in the King's castle,"
msgstr ""

#. STRINGS.STAGEACTOR.ACT2_SCENE4.LINE19
msgctxt "STRINGS.STAGEACTOR.ACT2_SCENE4.LINE19"
msgid "and discovered his secret."
msgstr ""

#. STRINGS.STAGEACTOR.ACT2_SCENE4.LINE2
msgctxt "STRINGS.STAGEACTOR.ACT2_SCENE4.LINE2"
msgid "Yes, on to Act 2!"
msgstr ""

#. STRINGS.STAGEACTOR.ACT2_SCENE4.LINE20
msgctxt "STRINGS.STAGEACTOR.ACT2_SCENE4.LINE20"
msgid "Oh! Hello there, who are you?"
msgstr ""

#. STRINGS.STAGEACTOR.ACT2_SCENE4.LINE21
msgctxt "STRINGS.STAGEACTOR.ACT2_SCENE4.LINE21"
msgid "I have no name,"
msgstr ""

#. STRINGS.STAGEACTOR.ACT2_SCENE4.LINE22
msgctxt "STRINGS.STAGEACTOR.ACT2_SCENE4.LINE22"
msgid "I am known only as the magic mirror."
msgstr ""

#. STRINGS.STAGEACTOR.ACT2_SCENE4.LINE23
msgctxt "STRINGS.STAGEACTOR.ACT2_SCENE4.LINE23"
msgid "Your King has stolen my power"
msgstr ""

#. STRINGS.STAGEACTOR.ACT2_SCENE4.LINE24
msgctxt "STRINGS.STAGEACTOR.ACT2_SCENE4.LINE24"
msgid "and kept me hidden away."
msgstr ""

#. STRINGS.STAGEACTOR.ACT2_SCENE4.LINE25
msgctxt "STRINGS.STAGEACTOR.ACT2_SCENE4.LINE25"
msgid "How I hunger for freedom."
msgstr ""

#. STRINGS.STAGEACTOR.ACT2_SCENE4.LINE26
msgctxt "STRINGS.STAGEACTOR.ACT2_SCENE4.LINE26"
msgid "Just a taste of the outside world..."
msgstr ""

#. STRINGS.STAGEACTOR.ACT2_SCENE4.LINE27
msgctxt "STRINGS.STAGEACTOR.ACT2_SCENE4.LINE27"
msgid "I knew I didn't trust that King!"
msgstr ""

#. STRINGS.STAGEACTOR.ACT2_SCENE4.LINE28
msgctxt "STRINGS.STAGEACTOR.ACT2_SCENE4.LINE28"
msgid "Boo! Hiss!"
msgstr ""

#. STRINGS.STAGEACTOR.ACT2_SCENE4.LINE29
msgctxt "STRINGS.STAGEACTOR.ACT2_SCENE4.LINE29"
msgid "How terrible!"
msgstr ""

#. STRINGS.STAGEACTOR.ACT2_SCENE4.LINE3
msgctxt "STRINGS.STAGEACTOR.ACT2_SCENE4.LINE3"
msgid "Scene 1."
msgstr ""

#. STRINGS.STAGEACTOR.ACT2_SCENE4.LINE30
msgctxt "STRINGS.STAGEACTOR.ACT2_SCENE4.LINE30"
msgid "Don't worry,"
msgstr ""

#. STRINGS.STAGEACTOR.ACT2_SCENE4.LINE31
msgctxt "STRINGS.STAGEACTOR.ACT2_SCENE4.LINE31"
msgid "I will help you leave this lonely place."
msgstr ""

#. STRINGS.STAGEACTOR.ACT2_SCENE4.LINE32
msgctxt "STRINGS.STAGEACTOR.ACT2_SCENE4.LINE32"
msgid "No! My secret has been discovered!"
msgstr ""

#. STRINGS.STAGEACTOR.ACT2_SCENE4.LINE33
msgctxt "STRINGS.STAGEACTOR.ACT2_SCENE4.LINE33"
msgid "You didn't honor our agreement."
msgstr ""

#. STRINGS.STAGEACTOR.ACT2_SCENE4.LINE34
msgctxt "STRINGS.STAGEACTOR.ACT2_SCENE4.LINE34"
msgid "Now this courageous doll has come"
msgstr ""

#. STRINGS.STAGEACTOR.ACT2_SCENE4.LINE35
msgctxt "STRINGS.STAGEACTOR.ACT2_SCENE4.LINE35"
msgid "to release me from this prison."
msgstr ""

#. STRINGS.STAGEACTOR.ACT2_SCENE4.LINE36
msgctxt "STRINGS.STAGEACTOR.ACT2_SCENE4.LINE36"
msgid "Back, I say!"
msgstr ""

#. STRINGS.STAGEACTOR.ACT2_SCENE4.LINE37
msgctxt "STRINGS.STAGEACTOR.ACT2_SCENE4.LINE37"
msgid "Your magic is mine, mirror."
msgstr ""

#. STRINGS.STAGEACTOR.ACT2_SCENE4.LINE38
msgctxt "STRINGS.STAGEACTOR.ACT2_SCENE4.LINE38"
msgid "I will never let you go free!"
msgstr ""

#. STRINGS.STAGEACTOR.ACT2_SCENE4.LINE39
msgctxt "STRINGS.STAGEACTOR.ACT2_SCENE4.LINE39"
msgid "Mmmagic blast!"
msgstr ""

#. STRINGS.STAGEACTOR.ACT2_SCENE4.LINE4
msgctxt "STRINGS.STAGEACTOR.ACT2_SCENE4.LINE4"
msgid "Time passed, and the King brought the little doll"
msgstr ""

#. STRINGS.STAGEACTOR.ACT2_SCENE4.LINE40
msgctxt "STRINGS.STAGEACTOR.ACT2_SCENE4.LINE40"
msgid "No!"
msgstr ""

#. STRINGS.STAGEACTOR.ACT2_SCENE4.LINE41
msgctxt "STRINGS.STAGEACTOR.ACT2_SCENE4.LINE41"
msgid "Eeep! Time to disappear!"
msgstr ""

#. STRINGS.STAGEACTOR.ACT2_SCENE4.LINE42
msgctxt "STRINGS.STAGEACTOR.ACT2_SCENE4.LINE42"
msgid "Mmmagic ske-daddle!"
msgstr ""

#. STRINGS.STAGEACTOR.ACT2_SCENE4.LINE43
msgctxt "STRINGS.STAGEACTOR.ACT2_SCENE4.LINE43"
msgid "I wonder just how much she really remembers."
msgstr ""

#. STRINGS.STAGEACTOR.ACT2_SCENE4.LINE44
msgctxt "STRINGS.STAGEACTOR.ACT2_SCENE4.LINE44"
msgid "I really felt for the tree."
msgstr ""

#. STRINGS.STAGEACTOR.ACT2_SCENE4.LINE45
msgctxt "STRINGS.STAGEACTOR.ACT2_SCENE4.LINE45"
msgid "Very emotional."
msgstr ""

#. STRINGS.STAGEACTOR.ACT2_SCENE4.LINE5
msgctxt "STRINGS.STAGEACTOR.ACT2_SCENE4.LINE5"
msgid "on many wonderful adventures."
msgstr ""

#. STRINGS.STAGEACTOR.ACT2_SCENE4.LINE6
msgctxt "STRINGS.STAGEACTOR.ACT2_SCENE4.LINE6"
msgid "The doll asked often about the King's magic,"
msgstr ""

#. STRINGS.STAGEACTOR.ACT2_SCENE4.LINE7
msgctxt "STRINGS.STAGEACTOR.ACT2_SCENE4.LINE7"
msgid "and if he would teach her,"
msgstr ""

#. STRINGS.STAGEACTOR.ACT2_SCENE4.LINE8
msgctxt "STRINGS.STAGEACTOR.ACT2_SCENE4.LINE8"
msgid "but the King always gave one excuse or another."
msgstr ""

#. STRINGS.STAGEACTOR.ACT2_SCENE4.LINE9
msgctxt "STRINGS.STAGEACTOR.ACT2_SCENE4.LINE9"
msgid "Not today little doll,"
msgstr ""

#. STRINGS.STAGEACTOR.ACT2_SCENE5.LINE1
msgctxt "STRINGS.STAGEACTOR.ACT2_SCENE5.LINE1"
msgid "Oh good, the tree is here."
msgstr ""

#. STRINGS.STAGEACTOR.ACT2_SCENE5.LINE10
msgctxt "STRINGS.STAGEACTOR.ACT2_SCENE5.LINE10"
msgid "Better than ever!"
msgstr ""

#. STRINGS.STAGEACTOR.ACT2_SCENE5.LINE11
msgctxt "STRINGS.STAGEACTOR.ACT2_SCENE5.LINE11"
msgid "I've given you what power I can spare,"
msgstr ""

#. STRINGS.STAGEACTOR.ACT2_SCENE5.LINE12
msgctxt "STRINGS.STAGEACTOR.ACT2_SCENE5.LINE12"
msgid "but without the magic the King stole from me,"
msgstr ""

#. STRINGS.STAGEACTOR.ACT2_SCENE5.LINE13
msgctxt "STRINGS.STAGEACTOR.ACT2_SCENE5.LINE13"
msgid "I cannot make you fully whole."
msgstr ""

#. STRINGS.STAGEACTOR.ACT2_SCENE5.LINE14
msgctxt "STRINGS.STAGEACTOR.ACT2_SCENE5.LINE14"
msgid "You must seek him out, but be wary."
msgstr ""

#. STRINGS.STAGEACTOR.ACT2_SCENE5.LINE15
msgctxt "STRINGS.STAGEACTOR.ACT2_SCENE5.LINE15"
msgid "You have seen his treacherous ways for yourself."
msgstr ""

#. STRINGS.STAGEACTOR.ACT2_SCENE5.LINE16
msgctxt "STRINGS.STAGEACTOR.ACT2_SCENE5.LINE16"
msgid "I will speak to him."
msgstr ""

#. STRINGS.STAGEACTOR.ACT2_SCENE5.LINE17
msgctxt "STRINGS.STAGEACTOR.ACT2_SCENE5.LINE17"
msgid "And I promise you this, mirror;"
msgstr ""

#. STRINGS.STAGEACTOR.ACT2_SCENE5.LINE18
msgctxt "STRINGS.STAGEACTOR.ACT2_SCENE5.LINE18"
msgid "I will see both of us whole again."
msgstr ""

#. STRINGS.STAGEACTOR.ACT2_SCENE5.LINE2
msgctxt "STRINGS.STAGEACTOR.ACT2_SCENE5.LINE2"
msgid "I was worried for a second."
msgstr ""

#. STRINGS.STAGEACTOR.ACT2_SCENE5.LINE3
msgctxt "STRINGS.STAGEACTOR.ACT2_SCENE5.LINE3"
msgid "Hurry! Act 2!"
msgstr ""

#. STRINGS.STAGEACTOR.ACT2_SCENE5.LINE4
msgctxt "STRINGS.STAGEACTOR.ACT2_SCENE5.LINE4"
msgid "Scene 2!"
msgstr ""

#. STRINGS.STAGEACTOR.ACT2_SCENE5.LINE5
msgctxt "STRINGS.STAGEACTOR.ACT2_SCENE5.LINE5"
msgid "Your time is not over yet, little doll."
msgstr ""

#. STRINGS.STAGEACTOR.ACT2_SCENE5.LINE6
msgctxt "STRINGS.STAGEACTOR.ACT2_SCENE5.LINE6"
msgid "Awaken!"
msgstr ""

#. STRINGS.STAGEACTOR.ACT2_SCENE5.LINE7
msgctxt "STRINGS.STAGEACTOR.ACT2_SCENE5.LINE7"
msgid "I'm... alive!"
msgstr ""

#. STRINGS.STAGEACTOR.ACT2_SCENE5.LINE8
msgctxt "STRINGS.STAGEACTOR.ACT2_SCENE5.LINE8"
msgid "But I feel... different..."
msgstr ""

#. STRINGS.STAGEACTOR.ACT2_SCENE5.LINE9
msgctxt "STRINGS.STAGEACTOR.ACT2_SCENE5.LINE9"
msgid "Good as new!"
msgstr ""

#. STRINGS.STAGEACTOR.ACT2_SCENE6.LINE1
msgctxt "STRINGS.STAGEACTOR.ACT2_SCENE6.LINE1"
msgid "Act 2!"
msgstr ""

#. STRINGS.STAGEACTOR.ACT2_SCENE6.LINE10
msgctxt "STRINGS.STAGEACTOR.ACT2_SCENE6.LINE10"
msgid "the construction of a home for peg-legged orphans!"
msgstr ""

#. STRINGS.STAGEACTOR.ACT2_SCENE6.LINE11
msgctxt "STRINGS.STAGEACTOR.ACT2_SCENE6.LINE11"
msgid "And... er... um..."
msgstr ""

#. STRINGS.STAGEACTOR.ACT2_SCENE6.LINE12
msgctxt "STRINGS.STAGEACTOR.ACT2_SCENE6.LINE12"
msgid "You wouldn't hit a guy with glasses, would you?"
msgstr ""

#. STRINGS.STAGEACTOR.ACT2_SCENE6.LINE13
msgctxt "STRINGS.STAGEACTOR.ACT2_SCENE6.LINE13"
msgid "Are you so afraid to see your old friend?"
msgstr ""

#. STRINGS.STAGEACTOR.ACT2_SCENE6.LINE14
msgctxt "STRINGS.STAGEACTOR.ACT2_SCENE6.LINE14"
msgid "Little doll? It can't be! I... that is, you..."
msgstr ""

#. STRINGS.STAGEACTOR.ACT2_SCENE6.LINE15
msgctxt "STRINGS.STAGEACTOR.ACT2_SCENE6.LINE15"
msgid "The mirror brought me back to life."
msgstr ""

#. STRINGS.STAGEACTOR.ACT2_SCENE6.LINE16
msgctxt "STRINGS.STAGEACTOR.ACT2_SCENE6.LINE16"
msgid "I can feel what it feels..."
msgstr ""

#. STRINGS.STAGEACTOR.ACT2_SCENE6.LINE17
msgctxt "STRINGS.STAGEACTOR.ACT2_SCENE6.LINE17"
msgid "We are going to help each other become whole again."
msgstr ""

#. STRINGS.STAGEACTOR.ACT2_SCENE6.LINE18
msgctxt "STRINGS.STAGEACTOR.ACT2_SCENE6.LINE18"
msgid "But for that, I will need your power."
msgstr ""

#. STRINGS.STAGEACTOR.ACT2_SCENE6.LINE19
msgctxt "STRINGS.STAGEACTOR.ACT2_SCENE6.LINE19"
msgid "My power? Never!"
msgstr ""

#. STRINGS.STAGEACTOR.ACT2_SCENE6.LINE2
msgctxt "STRINGS.STAGEACTOR.ACT2_SCENE6.LINE2"
msgid "Scene 3!"
msgstr ""

#. STRINGS.STAGEACTOR.ACT2_SCENE6.LINE20
msgctxt "STRINGS.STAGEACTOR.ACT2_SCENE6.LINE20"
msgid "Mmmmagic away!"
msgstr ""

#. STRINGS.STAGEACTOR.ACT2_SCENE6.LINE21
msgctxt "STRINGS.STAGEACTOR.ACT2_SCENE6.LINE21"
msgid "No!"
msgstr ""

#. STRINGS.STAGEACTOR.ACT2_SCENE6.LINE22
msgctxt "STRINGS.STAGEACTOR.ACT2_SCENE6.LINE22"
msgid "And with that, the King used his magic"
msgstr ""

#. STRINGS.STAGEACTOR.ACT2_SCENE6.LINE23
msgctxt "STRINGS.STAGEACTOR.ACT2_SCENE6.LINE23"
msgid "to hide himself and his throne far away,"
msgstr ""

#. STRINGS.STAGEACTOR.ACT2_SCENE6.LINE24
msgctxt "STRINGS.STAGEACTOR.ACT2_SCENE6.LINE24"
msgid "where he thought the little doll would never find him."
msgstr ""

#. STRINGS.STAGEACTOR.ACT2_SCENE6.LINE3
msgctxt "STRINGS.STAGEACTOR.ACT2_SCENE6.LINE3"
msgid "The doll searched the castle for the King,"
msgstr ""

#. STRINGS.STAGEACTOR.ACT2_SCENE6.LINE4
msgctxt "STRINGS.STAGEACTOR.ACT2_SCENE6.LINE4"
msgid "and found him cowering behind his throne."
msgstr ""

#. STRINGS.STAGEACTOR.ACT2_SCENE6.LINE5
msgctxt "STRINGS.STAGEACTOR.ACT2_SCENE6.LINE5"
msgid "Leave me be, monster!"
msgstr ""

#. STRINGS.STAGEACTOR.ACT2_SCENE6.LINE6
msgctxt "STRINGS.STAGEACTOR.ACT2_SCENE6.LINE6"
msgid "I-I'm just a poor, frail old man!"
msgstr ""

#. STRINGS.STAGEACTOR.ACT2_SCENE6.LINE7
msgctxt "STRINGS.STAGEACTOR.ACT2_SCENE6.LINE7"
msgid "Um... and my mother is sick,"
msgstr ""

#. STRINGS.STAGEACTOR.ACT2_SCENE6.LINE8
msgctxt "STRINGS.STAGEACTOR.ACT2_SCENE6.LINE8"
msgid "and I'm all she has to care for her!"
msgstr ""

#. STRINGS.STAGEACTOR.ACT2_SCENE6.LINE9
msgctxt "STRINGS.STAGEACTOR.ACT2_SCENE6.LINE9"
msgid "And... oh I know! I was just now planning"
msgstr ""

#. STRINGS.STAGEACTOR.ACT3_SCENE7.LINE1
msgctxt "STRINGS.STAGEACTOR.ACT3_SCENE7.LINE1"
msgid "It's the Final Act!"
msgstr ""

#. STRINGS.STAGEACTOR.ACT3_SCENE7.LINE10
msgctxt "STRINGS.STAGEACTOR.ACT3_SCENE7.LINE10"
msgid "the King's so glum upon his throne!"
msgstr ""

#. STRINGS.STAGEACTOR.ACT3_SCENE7.LINE11
msgctxt "STRINGS.STAGEACTOR.ACT3_SCENE7.LINE11"
msgid "Cheer-a-loo, cheer-a-lay,"
msgstr ""

#. STRINGS.STAGEACTOR.ACT3_SCENE7.LINE12
msgctxt "STRINGS.STAGEACTOR.ACT3_SCENE7.LINE12"
msgid "he's sent for fools, to watch us play!"
msgstr ""

#. STRINGS.STAGEACTOR.ACT3_SCENE7.LINE13
msgctxt "STRINGS.STAGEACTOR.ACT3_SCENE7.LINE13"
msgid "From far and wide he's called us there,"
msgstr ""

#. STRINGS.STAGEACTOR.ACT3_SCENE7.LINE14
msgctxt "STRINGS.STAGEACTOR.ACT3_SCENE7.LINE14"
msgid "we'll perform for the one who sits on the chair!"
msgstr ""

#. STRINGS.STAGEACTOR.ACT3_SCENE7.LINE15
msgctxt "STRINGS.STAGEACTOR.ACT3_SCENE7.LINE15"
msgid "The King has grown bored, has he?"
msgstr ""

#. STRINGS.STAGEACTOR.ACT3_SCENE7.LINE16
msgctxt "STRINGS.STAGEACTOR.ACT3_SCENE7.LINE16"
msgid "Perhaps he's grown careless as well."
msgstr ""

#. STRINGS.STAGEACTOR.ACT3_SCENE7.LINE17
msgctxt "STRINGS.STAGEACTOR.ACT3_SCENE7.LINE17"
msgid "If I follow these fools,"
msgstr ""

#. STRINGS.STAGEACTOR.ACT3_SCENE7.LINE18
msgctxt "STRINGS.STAGEACTOR.ACT3_SCENE7.LINE18"
msgid "they might lead me straight to him..."
msgstr ""

#. STRINGS.STAGEACTOR.ACT3_SCENE7.LINE19
msgctxt "STRINGS.STAGEACTOR.ACT3_SCENE7.LINE19"
msgid "How strange, I suddenly feel like I'm being shadowed."
msgstr ""

#. STRINGS.STAGEACTOR.ACT3_SCENE7.LINE2
msgctxt "STRINGS.STAGEACTOR.ACT3_SCENE7.LINE2"
msgid "Scene 1!"
msgstr ""

#. STRINGS.STAGEACTOR.ACT3_SCENE7.LINE20
msgctxt "STRINGS.STAGEACTOR.ACT3_SCENE7.LINE20"
msgid "It's probably nothing!"
msgstr ""

#. STRINGS.STAGEACTOR.ACT3_SCENE7.LINE3
msgctxt "STRINGS.STAGEACTOR.ACT3_SCENE7.LINE3"
msgid "So exciting!"
msgstr ""

#. STRINGS.STAGEACTOR.ACT3_SCENE7.LINE4
msgctxt "STRINGS.STAGEACTOR.ACT3_SCENE7.LINE4"
msgid "Almost done!"
msgstr ""

#. STRINGS.STAGEACTOR.ACT3_SCENE7.LINE5
msgctxt "STRINGS.STAGEACTOR.ACT3_SCENE7.LINE5"
msgid "The doll searched high and low,"
msgstr ""

#. STRINGS.STAGEACTOR.ACT3_SCENE7.LINE6
msgctxt "STRINGS.STAGEACTOR.ACT3_SCENE7.LINE6"
msgid "but as time went on,"
msgstr ""

#. STRINGS.STAGEACTOR.ACT3_SCENE7.LINE7
msgctxt "STRINGS.STAGEACTOR.ACT3_SCENE7.LINE7"
msgid "it seemed that the King had won."
msgstr ""

#. STRINGS.STAGEACTOR.ACT3_SCENE7.LINE8
msgctxt "STRINGS.STAGEACTOR.ACT3_SCENE7.LINE8"
msgid "Until one day..."
msgstr ""

#. STRINGS.STAGEACTOR.ACT3_SCENE7.LINE9
msgctxt "STRINGS.STAGEACTOR.ACT3_SCENE7.LINE9"
msgid "Cheer-a-lee, cheer-a-lone,"
msgstr ""

#. STRINGS.STAGEACTOR.ACT3_SCENE8.LINE1
msgctxt "STRINGS.STAGEACTOR.ACT3_SCENE8.LINE1"
msgid "Act 3!"
msgstr ""

#. STRINGS.STAGEACTOR.ACT3_SCENE8.LINE10
msgctxt "STRINGS.STAGEACTOR.ACT3_SCENE8.LINE10"
msgid "My King!"
msgstr ""

#. STRINGS.STAGEACTOR.ACT3_SCENE8.LINE11
msgctxt "STRINGS.STAGEACTOR.ACT3_SCENE8.LINE11"
msgid "Allow me to entertain you with my merry foolery!"
msgstr ""

#. STRINGS.STAGEACTOR.ACT3_SCENE8.LINE12
msgctxt "STRINGS.STAGEACTOR.ACT3_SCENE8.LINE12"
msgid "Whoops-!"
msgstr ""

#. STRINGS.STAGEACTOR.ACT3_SCENE8.LINE13
msgctxt "STRINGS.STAGEACTOR.ACT3_SCENE8.LINE13"
msgid "In their excitement,"
msgstr ""

#. STRINGS.STAGEACTOR.ACT3_SCENE8.LINE14
msgctxt "STRINGS.STAGEACTOR.ACT3_SCENE8.LINE14"
msgid "the clumsy fool knocked the King from his throne."
msgstr ""

#. STRINGS.STAGEACTOR.ACT3_SCENE8.LINE15
msgctxt "STRINGS.STAGEACTOR.ACT3_SCENE8.LINE15"
msgid "It seemed that the years"
msgstr ""

#. STRINGS.STAGEACTOR.ACT3_SCENE8.LINE16
msgctxt "STRINGS.STAGEACTOR.ACT3_SCENE8.LINE16"
msgid "had not been kind to the King,"
msgstr ""

#. STRINGS.STAGEACTOR.ACT3_SCENE8.LINE17
msgctxt "STRINGS.STAGEACTOR.ACT3_SCENE8.LINE17"
msgid "for when he hit the floor,"
msgstr ""

#. STRINGS.STAGEACTOR.ACT3_SCENE8.LINE18
msgctxt "STRINGS.STAGEACTOR.ACT3_SCENE8.LINE18"
msgid "his frail body turned to dust."
msgstr ""

#. STRINGS.STAGEACTOR.ACT3_SCENE8.LINE19
msgctxt "STRINGS.STAGEACTOR.ACT3_SCENE8.LINE19"
msgid "Nooooo!"
msgstr ""

#. STRINGS.STAGEACTOR.ACT3_SCENE8.LINE2
msgctxt "STRINGS.STAGEACTOR.ACT3_SCENE8.LINE2"
msgid "Scene 2!"
msgstr ""

#. STRINGS.STAGEACTOR.ACT3_SCENE8.LINE20
msgctxt "STRINGS.STAGEACTOR.ACT3_SCENE8.LINE20"
msgid "Oh... I suppose I'm the King now!"
msgstr ""

#. STRINGS.STAGEACTOR.ACT3_SCENE8.LINE21
msgctxt "STRINGS.STAGEACTOR.ACT3_SCENE8.LINE21"
msgid "There's been a fool on the throne long enough."
msgstr ""

#. STRINGS.STAGEACTOR.ACT3_SCENE8.LINE22
msgctxt "STRINGS.STAGEACTOR.ACT3_SCENE8.LINE22"
msgid "perhaps what this kingdom needs..."
msgstr ""

#. STRINGS.STAGEACTOR.ACT3_SCENE8.LINE23
msgctxt "STRINGS.STAGEACTOR.ACT3_SCENE8.LINE23"
msgid "is a Queen."
msgstr ""

#. STRINGS.STAGEACTOR.ACT3_SCENE8.LINE24
msgctxt "STRINGS.STAGEACTOR.ACT3_SCENE8.LINE24"
msgid "The special effects are getting better."
msgstr ""

#. STRINGS.STAGEACTOR.ACT3_SCENE8.LINE25
msgctxt "STRINGS.STAGEACTOR.ACT3_SCENE8.LINE25"
msgid "Wish I could say the same for the actors."
msgstr ""

#. STRINGS.STAGEACTOR.ACT3_SCENE8.LINE26
msgctxt "STRINGS.STAGEACTOR.ACT3_SCENE8.LINE26"
msgid "HA HA HA HA HA!"
msgstr ""

#. STRINGS.STAGEACTOR.ACT3_SCENE8.LINE27
msgctxt "STRINGS.STAGEACTOR.ACT3_SCENE8.LINE27"
msgid "Another flawless performance from the tree."
msgstr ""

#. STRINGS.STAGEACTOR.ACT3_SCENE8.LINE28
msgctxt "STRINGS.STAGEACTOR.ACT3_SCENE8.LINE28"
msgid "How do they do it?!"
msgstr ""

#. STRINGS.STAGEACTOR.ACT3_SCENE8.LINE29
msgctxt "STRINGS.STAGEACTOR.ACT3_SCENE8.LINE29"
msgid "Fool!"
msgstr ""

#. STRINGS.STAGEACTOR.ACT3_SCENE8.LINE3
msgctxt "STRINGS.STAGEACTOR.ACT3_SCENE8.LINE3"
msgid "Though the journey was long,"
msgstr ""

#. STRINGS.STAGEACTOR.ACT3_SCENE8.LINE4
msgctxt "STRINGS.STAGEACTOR.ACT3_SCENE8.LINE4"
msgid "it was just as the doll had predicted."
msgstr ""

#. STRINGS.STAGEACTOR.ACT3_SCENE8.LINE5
msgctxt "STRINGS.STAGEACTOR.ACT3_SCENE8.LINE5"
msgid "The doll followed the fool"
msgstr ""

#. STRINGS.STAGEACTOR.ACT3_SCENE8.LINE6
msgctxt "STRINGS.STAGEACTOR.ACT3_SCENE8.LINE6"
msgid "all the way to the King's throne room,"
msgstr ""

#. STRINGS.STAGEACTOR.ACT3_SCENE8.LINE7
msgctxt "STRINGS.STAGEACTOR.ACT3_SCENE8.LINE7"
msgid "careful to keep out of sight."
msgstr ""

#. STRINGS.STAGEACTOR.ACT3_SCENE8.LINE8
msgctxt "STRINGS.STAGEACTOR.ACT3_SCENE8.LINE8"
msgid "It took you long enough!"
msgstr ""

#. STRINGS.STAGEACTOR.ACT3_SCENE8.LINE9
msgctxt "STRINGS.STAGEACTOR.ACT3_SCENE8.LINE9"
msgid "I'd grown weary of waiting."
msgstr ""

#. STRINGS.STAGEACTOR.ACT3_SCENE9.LINE1
msgctxt "STRINGS.STAGEACTOR.ACT3_SCENE9.LINE1"
msgid "The final scene!"
msgstr ""

#. STRINGS.STAGEACTOR.ACT3_SCENE9.LINE10
msgctxt "STRINGS.STAGEACTOR.ACT3_SCENE9.LINE10"
msgid "I cannot yet be restored."
msgstr ""

#. STRINGS.STAGEACTOR.ACT3_SCENE9.LINE11
msgctxt "STRINGS.STAGEACTOR.ACT3_SCENE9.LINE11"
msgid "I made you a promise, mirror,"
msgstr ""

#. STRINGS.STAGEACTOR.ACT3_SCENE9.LINE12
msgctxt "STRINGS.STAGEACTOR.ACT3_SCENE9.LINE12"
msgid "and I will see it through."
msgstr ""

#. STRINGS.STAGEACTOR.ACT3_SCENE9.LINE13
msgctxt "STRINGS.STAGEACTOR.ACT3_SCENE9.LINE13"
msgid "I will find the power to fix you,"
msgstr ""

#. STRINGS.STAGEACTOR.ACT3_SCENE9.LINE14
msgctxt "STRINGS.STAGEACTOR.ACT3_SCENE9.LINE14"
msgid "and repay you for all you've given me."
msgstr ""

#. STRINGS.STAGEACTOR.ACT3_SCENE9.LINE15
msgctxt "STRINGS.STAGEACTOR.ACT3_SCENE9.LINE15"
msgid "And so,"
msgstr ""

#. STRINGS.STAGEACTOR.ACT3_SCENE9.LINE16
msgctxt "STRINGS.STAGEACTOR.ACT3_SCENE9.LINE16"
msgid "with the treacherous King gone and forgotten,"
msgstr ""

#. STRINGS.STAGEACTOR.ACT3_SCENE9.LINE17
msgctxt "STRINGS.STAGEACTOR.ACT3_SCENE9.LINE17"
msgid "the little doll became a just and formidable Queen."
msgstr ""

#. STRINGS.STAGEACTOR.ACT3_SCENE9.LINE18
msgctxt "STRINGS.STAGEACTOR.ACT3_SCENE9.LINE18"
msgid "The people rejoiced across the land,"
msgstr ""

#. STRINGS.STAGEACTOR.ACT3_SCENE9.LINE19
msgctxt "STRINGS.STAGEACTOR.ACT3_SCENE9.LINE19"
msgid "and the magic mirror knew"
msgstr ""

#. STRINGS.STAGEACTOR.ACT3_SCENE9.LINE2
msgctxt "STRINGS.STAGEACTOR.ACT3_SCENE9.LINE2"
msgid "Of the final act!"
msgstr ""

#. STRINGS.STAGEACTOR.ACT3_SCENE9.LINE20
msgctxt "STRINGS.STAGEACTOR.ACT3_SCENE9.LINE20"
msgid "they had finally found the one who would set Them free."
msgstr ""

#. STRINGS.STAGEACTOR.ACT3_SCENE9.LINE21
msgctxt "STRINGS.STAGEACTOR.ACT3_SCENE9.LINE21"
msgid "I love a happy ending."
msgstr ""

#. STRINGS.STAGEACTOR.ACT3_SCENE9.LINE22
msgctxt "STRINGS.STAGEACTOR.ACT3_SCENE9.LINE22"
msgid "I'm just happy it ended."
msgstr ""

#. STRINGS.STAGEACTOR.ACT3_SCENE9.LINE23
msgctxt "STRINGS.STAGEACTOR.ACT3_SCENE9.LINE23"
msgid "HA HA HA HA HA!"
msgstr ""

#. STRINGS.STAGEACTOR.ACT3_SCENE9.LINE3
msgctxt "STRINGS.STAGEACTOR.ACT3_SCENE9.LINE3"
msgid "Finally!"
msgstr ""

#. STRINGS.STAGEACTOR.ACT3_SCENE9.LINE4
msgctxt "STRINGS.STAGEACTOR.ACT3_SCENE9.LINE4"
msgid "It is as you said, mirror."
msgstr ""

#. STRINGS.STAGEACTOR.ACT3_SCENE9.LINE5
msgctxt "STRINGS.STAGEACTOR.ACT3_SCENE9.LINE5"
msgid "I've become so much more than I ever dreamed..."
msgstr ""

#. STRINGS.STAGEACTOR.ACT3_SCENE9.LINE6
msgctxt "STRINGS.STAGEACTOR.ACT3_SCENE9.LINE6"
msgid "but why do you remain broken?"
msgstr ""

#. STRINGS.STAGEACTOR.ACT3_SCENE9.LINE7
msgctxt "STRINGS.STAGEACTOR.ACT3_SCENE9.LINE7"
msgid "Alas,"
msgstr ""

#. STRINGS.STAGEACTOR.ACT3_SCENE9.LINE8
msgctxt "STRINGS.STAGEACTOR.ACT3_SCENE9.LINE8"
msgid "I was shattered long before I met your King."
msgstr ""

#. STRINGS.STAGEACTOR.ACT3_SCENE9.LINE9
msgctxt "STRINGS.STAGEACTOR.ACT3_SCENE9.LINE9"
msgid "Even with his power,"
msgstr ""

#. STRINGS.STAGEACTOR.ARTIFICER_SOLILOQUY.1
msgctxt "STRINGS.STAGEACTOR.ARTIFICER_SOLILOQUY.1"
msgid "The Artificer!"
msgstr ""

#. STRINGS.STAGEACTOR.ARTIFICER_SOLILOQUY.10
msgctxt "STRINGS.STAGEACTOR.ARTIFICER_SOLILOQUY.10"
msgid "Even if I see this impossible design through,"
msgstr ""

#. STRINGS.STAGEACTOR.ARTIFICER_SOLILOQUY.11
msgctxt "STRINGS.STAGEACTOR.ARTIFICER_SOLILOQUY.11"
msgid "I doubt I shall ever leave this place."
msgstr ""

#. STRINGS.STAGEACTOR.ARTIFICER_SOLILOQUY.12
msgctxt "STRINGS.STAGEACTOR.ARTIFICER_SOLILOQUY.12"
msgid "I only pray my brood be granted a chance to survive,"
msgstr ""

#. STRINGS.STAGEACTOR.ARTIFICER_SOLILOQUY.13
msgctxt "STRINGS.STAGEACTOR.ARTIFICER_SOLILOQUY.13"
msgid "safe from the Other,"
msgstr ""

#. STRINGS.STAGEACTOR.ARTIFICER_SOLILOQUY.14
msgctxt "STRINGS.STAGEACTOR.ARTIFICER_SOLILOQUY.14"
msgid "by what we've wrought here."
msgstr ""

#. STRINGS.STAGEACTOR.ARTIFICER_SOLILOQUY.15
msgctxt "STRINGS.STAGEACTOR.ARTIFICER_SOLILOQUY.15"
msgid "That small hope is all that drives me"
msgstr ""

#. STRINGS.STAGEACTOR.ARTIFICER_SOLILOQUY.16
msgctxt "STRINGS.STAGEACTOR.ARTIFICER_SOLILOQUY.16"
msgid "through these dark times."
msgstr ""

#. STRINGS.STAGEACTOR.ARTIFICER_SOLILOQUY.17
msgctxt "STRINGS.STAGEACTOR.ARTIFICER_SOLILOQUY.17"
msgid "So did his brood survive after all that?"
msgstr ""

#. STRINGS.STAGEACTOR.ARTIFICER_SOLILOQUY.18
msgctxt "STRINGS.STAGEACTOR.ARTIFICER_SOLILOQUY.18"
msgid "Nope."
msgstr ""

#. STRINGS.STAGEACTOR.ARTIFICER_SOLILOQUY.19
msgctxt "STRINGS.STAGEACTOR.ARTIFICER_SOLILOQUY.19"
msgid "HA HA HA HA HA!"
msgstr ""

#. STRINGS.STAGEACTOR.ARTIFICER_SOLILOQUY.2
msgctxt "STRINGS.STAGEACTOR.ARTIFICER_SOLILOQUY.2"
msgid "You mean the one that did all the work?"
msgstr ""

#. STRINGS.STAGEACTOR.ARTIFICER_SOLILOQUY.3
msgctxt "STRINGS.STAGEACTOR.ARTIFICER_SOLILOQUY.3"
msgid "Yeah..."
msgstr ""

#. STRINGS.STAGEACTOR.ARTIFICER_SOLILOQUY.4
msgctxt "STRINGS.STAGEACTOR.ARTIFICER_SOLILOQUY.4"
msgid "What a sucker!"
msgstr ""

#. STRINGS.STAGEACTOR.ARTIFICER_SOLILOQUY.5
msgctxt "STRINGS.STAGEACTOR.ARTIFICER_SOLILOQUY.5"
msgid "HA HA HA HA HA!"
msgstr ""

#. STRINGS.STAGEACTOR.ARTIFICER_SOLILOQUY.6
msgctxt "STRINGS.STAGEACTOR.ARTIFICER_SOLILOQUY.6"
msgid "How many lifetimes would it take"
msgstr ""

#. STRINGS.STAGEACTOR.ARTIFICER_SOLILOQUY.7
msgctxt "STRINGS.STAGEACTOR.ARTIFICER_SOLILOQUY.7"
msgid "to hew such a structure,"
msgstr ""

#. STRINGS.STAGEACTOR.ARTIFICER_SOLILOQUY.8
msgctxt "STRINGS.STAGEACTOR.ARTIFICER_SOLILOQUY.8"
msgid "even with my mastery?"
msgstr ""

#. STRINGS.STAGEACTOR.ARTIFICER_SOLILOQUY.9
msgctxt "STRINGS.STAGEACTOR.ARTIFICER_SOLILOQUY.9"
msgid "The Shieldbearer keeps much to her thorax."
msgstr ""

#. STRINGS.STAGEACTOR.BAD_COSTUMES.1
msgctxt "STRINGS.STAGEACTOR.BAD_COSTUMES.1"
msgid "Something's wrong!"
msgstr ""

#. STRINGS.STAGEACTOR.BAD_COSTUMES.2
msgctxt "STRINGS.STAGEACTOR.BAD_COSTUMES.2"
msgid "Check your costumes!"
msgstr ""

#. STRINGS.STAGEACTOR.BAD_COSTUMES.3
msgctxt "STRINGS.STAGEACTOR.BAD_COSTUMES.3"
msgid "We'll come back."
msgstr ""

#. STRINGS.STAGEACTOR.BAD_COSTUMES.4
msgctxt "STRINGS.STAGEACTOR.BAD_COSTUMES.4"
msgid "When you get it right!"
msgstr ""

#. STRINGS.STAGEACTOR.BLACKSMITH_SOLILOQUY.1
msgctxt "STRINGS.STAGEACTOR.BLACKSMITH_SOLILOQUY.1"
msgid "\"The Blacksmith's Soliloquy\""
msgstr ""

#. STRINGS.STAGEACTOR.BLACKSMITH_SOLILOQUY.2
msgctxt "STRINGS.STAGEACTOR.BLACKSMITH_SOLILOQUY.2"
msgid "Forging on ahead."
msgstr ""

#. STRINGS.STAGEACTOR.BLACKSMITH_SOLILOQUY.3
msgctxt "STRINGS.STAGEACTOR.BLACKSMITH_SOLILOQUY.3"
msgid "Oh little doll, little doll!"
msgstr ""

#. STRINGS.STAGEACTOR.BLACKSMITH_SOLILOQUY.4
msgctxt "STRINGS.STAGEACTOR.BLACKSMITH_SOLILOQUY.4"
msgid "Where have you gone?"
msgstr ""

#. STRINGS.STAGEACTOR.BLACKSMITH_SOLILOQUY.5
msgctxt "STRINGS.STAGEACTOR.BLACKSMITH_SOLILOQUY.5"
msgid "It's not safe for you out there"
msgstr ""

#. STRINGS.STAGEACTOR.BLACKSMITH_SOLILOQUY.6
msgctxt "STRINGS.STAGEACTOR.BLACKSMITH_SOLILOQUY.6"
msgid "in the big wide world!"
msgstr ""

#. STRINGS.STAGEACTOR.BLACKSMITH_SOLILOQUY.7
msgctxt "STRINGS.STAGEACTOR.BLACKSMITH_SOLILOQUY.7"
msgid "If it ain't broke..."
msgstr ""

#. STRINGS.STAGEACTOR.BLACKSMITH_SOLILOQUY.8
msgctxt "STRINGS.STAGEACTOR.BLACKSMITH_SOLILOQUY.8"
msgid "She'll still try to fix it."
msgstr ""

#. STRINGS.STAGEACTOR.ELYTRA_SOLILOQUY.1
msgctxt "STRINGS.STAGEACTOR.ELYTRA_SOLILOQUY.1"
msgid "Please welcome, Elytra!"
msgstr ""

#. STRINGS.STAGEACTOR.ELYTRA_SOLILOQUY.10
msgctxt "STRINGS.STAGEACTOR.ELYTRA_SOLILOQUY.10"
msgid "To Thee, Metheus, my Queen,"
msgstr ""

#. STRINGS.STAGEACTOR.ELYTRA_SOLILOQUY.11
msgctxt "STRINGS.STAGEACTOR.ELYTRA_SOLILOQUY.11"
msgid "my heart is riven to know I have failed Thee."
msgstr ""

#. STRINGS.STAGEACTOR.ELYTRA_SOLILOQUY.12
msgctxt "STRINGS.STAGEACTOR.ELYTRA_SOLILOQUY.12"
msgid "Cast Thy curse upon me,"
msgstr ""

#. STRINGS.STAGEACTOR.ELYTRA_SOLILOQUY.13
msgctxt "STRINGS.STAGEACTOR.ELYTRA_SOLILOQUY.13"
msgid "that I may bear an eternity of sorrow."
msgstr ""

#. STRINGS.STAGEACTOR.ELYTRA_SOLILOQUY.14
msgctxt "STRINGS.STAGEACTOR.ELYTRA_SOLILOQUY.14"
msgid "How much more sorrow is left for her to bear?"
msgstr ""

#. STRINGS.STAGEACTOR.ELYTRA_SOLILOQUY.15
msgctxt "STRINGS.STAGEACTOR.ELYTRA_SOLILOQUY.15"
msgid "Let's see... it's been a while now, so an eternity more?"
msgstr ""

#. STRINGS.STAGEACTOR.ELYTRA_SOLILOQUY.16
msgctxt "STRINGS.STAGEACTOR.ELYTRA_SOLILOQUY.16"
msgid "HA HA HA HA HA!"
msgstr ""

#. STRINGS.STAGEACTOR.ELYTRA_SOLILOQUY.2
msgctxt "STRINGS.STAGEACTOR.ELYTRA_SOLILOQUY.2"
msgid "Did you hear what They say about her performance?"
msgstr ""

#. STRINGS.STAGEACTOR.ELYTRA_SOLILOQUY.3
msgctxt "STRINGS.STAGEACTOR.ELYTRA_SOLILOQUY.3"
msgid "Yeah! She killed!"
msgstr ""

#. STRINGS.STAGEACTOR.ELYTRA_SOLILOQUY.4
msgctxt "STRINGS.STAGEACTOR.ELYTRA_SOLILOQUY.4"
msgid "HA HA HA HA HA!"
msgstr ""

#. STRINGS.STAGEACTOR.ELYTRA_SOLILOQUY.5
msgctxt "STRINGS.STAGEACTOR.ELYTRA_SOLILOQUY.5"
msgid "If these words reach thine ears, foolhardy explorer,"
msgstr ""

#. STRINGS.STAGEACTOR.ELYTRA_SOLILOQUY.6
msgctxt "STRINGS.STAGEACTOR.ELYTRA_SOLILOQUY.6"
msgid "then all our labors have been for naught."
msgstr ""

#. STRINGS.STAGEACTOR.ELYTRA_SOLILOQUY.7
msgctxt "STRINGS.STAGEACTOR.ELYTRA_SOLILOQUY.7"
msgid "Mercy upon those already consumed,"
msgstr ""

#. STRINGS.STAGEACTOR.ELYTRA_SOLILOQUY.8
msgctxt "STRINGS.STAGEACTOR.ELYTRA_SOLILOQUY.8"
msgid "and upon those yet to be taken by the Other."
msgstr ""

#. STRINGS.STAGEACTOR.ELYTRA_SOLILOQUY.9
msgctxt "STRINGS.STAGEACTOR.ELYTRA_SOLILOQUY.9"
msgid "..."
msgstr ""

#. STRINGS.STAGEACTOR.FOOL_SOLILOQUY.1
msgctxt "STRINGS.STAGEACTOR.FOOL_SOLILOQUY.1"
msgid "\"The Fool's Soliloquy\""
msgstr ""

#. STRINGS.STAGEACTOR.FOOL_SOLILOQUY.2
msgctxt "STRINGS.STAGEACTOR.FOOL_SOLILOQUY.2"
msgid "Who do they think they're fooling?"
msgstr ""

#. STRINGS.STAGEACTOR.FOOL_SOLILOQUY.3
msgctxt "STRINGS.STAGEACTOR.FOOL_SOLILOQUY.3"
msgid "Once I acted as I thought I should,"
msgstr ""

#. STRINGS.STAGEACTOR.FOOL_SOLILOQUY.4
msgctxt "STRINGS.STAGEACTOR.FOOL_SOLILOQUY.4"
msgid "I followed all the rules."
msgstr ""

#. STRINGS.STAGEACTOR.FOOL_SOLILOQUY.5
msgctxt "STRINGS.STAGEACTOR.FOOL_SOLILOQUY.5"
msgid "But soon I found out life's a game,"
msgstr ""

#. STRINGS.STAGEACTOR.FOOL_SOLILOQUY.6
msgctxt "STRINGS.STAGEACTOR.FOOL_SOLILOQUY.6"
msgid "and I have played the fool!"
msgstr ""

#. STRINGS.STAGEACTOR.FOOL_SOLILOQUY.7
msgctxt "STRINGS.STAGEACTOR.FOOL_SOLILOQUY.7"
msgid "My head hurts."
msgstr ""

#. STRINGS.STAGEACTOR.FOOL_SOLILOQUY.8
msgctxt "STRINGS.STAGEACTOR.FOOL_SOLILOQUY.8"
msgid "Listening to a fool will do that."
msgstr ""

#. STRINGS.STAGEACTOR.HALFWIT_SOLILOQUY.1
msgctxt "STRINGS.STAGEACTOR.HALFWIT_SOLILOQUY.1"
msgid "Hath ye seen me chums?"
msgstr ""

#. STRINGS.STAGEACTOR.HALFWIT_SOLILOQUY.2
msgctxt "STRINGS.STAGEACTOR.HALFWIT_SOLILOQUY.2"
msgid "We came as three."
msgstr ""

#. STRINGS.STAGEACTOR.HALFWIT_SOLILOQUY.3
msgctxt "STRINGS.STAGEACTOR.HALFWIT_SOLILOQUY.3"
msgid "Now 'tis just me."
msgstr ""

#. STRINGS.STAGEACTOR.HALFWIT_SOLILOQUY.4
msgctxt "STRINGS.STAGEACTOR.HALFWIT_SOLILOQUY.4"
msgid "Hath ye seen me chums?"
msgstr ""

#. STRINGS.STAGEACTOR.KING_SOLILOQUY.1
msgctxt "STRINGS.STAGEACTOR.KING_SOLILOQUY.1"
msgid "\"The King's Soliloquy\""
msgstr ""

#. STRINGS.STAGEACTOR.KING_SOLILOQUY.2
msgctxt "STRINGS.STAGEACTOR.KING_SOLILOQUY.2"
msgid "He's King for now, anyway."
msgstr ""

#. STRINGS.STAGEACTOR.KING_SOLILOQUY.3
msgctxt "STRINGS.STAGEACTOR.KING_SOLILOQUY.3"
msgid "How different might things have been,"
msgstr ""

#. STRINGS.STAGEACTOR.KING_SOLILOQUY.4
msgctxt "STRINGS.STAGEACTOR.KING_SOLILOQUY.4"
msgid "if I never sought the crown?"
msgstr ""

#. STRINGS.STAGEACTOR.KING_SOLILOQUY.5
msgctxt "STRINGS.STAGEACTOR.KING_SOLILOQUY.5"
msgid "I suppose the world would be a bit brighter."
msgstr ""

#. STRINGS.STAGEACTOR.KING_SOLILOQUY.6
msgctxt "STRINGS.STAGEACTOR.KING_SOLILOQUY.6"
msgid "What a terrible thought indeed."
msgstr ""

#. STRINGS.STAGEACTOR.KING_SOLILOQUY.7
msgctxt "STRINGS.STAGEACTOR.KING_SOLILOQUY.7"
msgid "Heavy is the head who wears the crown."
msgstr ""

#. STRINGS.STAGEACTOR.KING_SOLILOQUY.8
msgctxt "STRINGS.STAGEACTOR.KING_SOLILOQUY.8"
msgid "His head is bigger than most."
msgstr ""

#. STRINGS.STAGEACTOR.KNIGHT_SOLILOQUY.BIRD1_1
msgctxt "STRINGS.STAGEACTOR.KNIGHT_SOLILOQUY.BIRD1_1"
msgid "Tell us a joke!"
msgstr ""

#. STRINGS.STAGEACTOR.KNIGHT_SOLILOQUY.BIRD1_3
msgctxt "STRINGS.STAGEACTOR.KNIGHT_SOLILOQUY.BIRD1_3"
msgid "Quit stall-in!"
msgstr ""

#. STRINGS.STAGEACTOR.KNIGHT_SOLILOQUY.BIRD1_6
msgctxt "STRINGS.STAGEACTOR.KNIGHT_SOLILOQUY.BIRD1_6"
msgid "What a foal!"
msgstr ""

#. STRINGS.STAGEACTOR.KNIGHT_SOLILOQUY.BIRD2_2
msgctxt "STRINGS.STAGEACTOR.KNIGHT_SOLILOQUY.BIRD2_2"
msgid "Straight from the horse's mouth!"
msgstr ""

#. STRINGS.STAGEACTOR.KNIGHT_SOLILOQUY.BIRD2_4
msgctxt "STRINGS.STAGEACTOR.KNIGHT_SOLILOQUY.BIRD2_4"
msgid "Feeling a little horse?"
msgstr ""

#. STRINGS.STAGEACTOR.KNIGHT_SOLILOQUY.BIRD2_5
msgctxt "STRINGS.STAGEACTOR.KNIGHT_SOLILOQUY.BIRD2_5"
msgid "So much for a mane attraction!"
msgstr ""

#. STRINGS.STAGEACTOR.KNIGHT_SOLILOQUY.BIRD_7
msgctxt "STRINGS.STAGEACTOR.KNIGHT_SOLILOQUY.BIRD_7"
msgid "HA HA HA HA HA!"
msgstr ""

#. STRINGS.STAGEACTOR.KNIGHT_SOLILOQUY.LINE1_KNIGHT
msgctxt "STRINGS.STAGEACTOR.KNIGHT_SOLILOQUY.LINE1_KNIGHT"
msgid "..."
msgstr ""

#. STRINGS.STAGEACTOR.KNIGHT_SOLILOQUY.LINE2_KNIGHT
msgctxt "STRINGS.STAGEACTOR.KNIGHT_SOLILOQUY.LINE2_KNIGHT"
msgid "..."
msgstr ""

#. STRINGS.STAGEACTOR.NO_SCRIPT.1
msgctxt "STRINGS.STAGEACTOR.NO_SCRIPT.1"
msgid "Something's off."
msgstr ""

#. STRINGS.STAGEACTOR.NO_SCRIPT.2
msgctxt "STRINGS.STAGEACTOR.NO_SCRIPT.2"
msgid "They're going off-script!"
msgstr ""

#. STRINGS.STAGEACTOR.NO_SCRIPT.3
msgctxt "STRINGS.STAGEACTOR.NO_SCRIPT.3"
msgid "I didn't come for improv!"
msgstr ""

#. STRINGS.STAGEACTOR.NO_SCRIPT.4
msgctxt "STRINGS.STAGEACTOR.NO_SCRIPT.4"
msgid "We're out."
msgstr ""

#. STRINGS.STAGEACTOR.PRINCESS_SOLILOQUY.BIRD1_1
msgctxt "STRINGS.STAGEACTOR.PRINCESS_SOLILOQUY.BIRD1_1"
msgid "Who's that?"
msgstr ""

#. STRINGS.STAGEACTOR.PRINCESS_SOLILOQUY.BIRD1_3
msgctxt "STRINGS.STAGEACTOR.PRINCESS_SOLILOQUY.BIRD1_3"
msgid "A queen? More like a spoiled princess!"
msgstr ""

#. STRINGS.STAGEACTOR.PRINCESS_SOLILOQUY.BIRD1_5
msgctxt "STRINGS.STAGEACTOR.PRINCESS_SOLILOQUY.BIRD1_5"
msgid "Relax, princess. They'll be here soon."
msgstr ""

#. STRINGS.STAGEACTOR.PRINCESS_SOLILOQUY.BIRD2_2
msgctxt "STRINGS.STAGEACTOR.PRINCESS_SOLILOQUY.BIRD2_2"
msgid "She looks... equine."
msgstr ""

#. STRINGS.STAGEACTOR.PRINCESS_SOLILOQUY.BIRD2_6
msgctxt "STRINGS.STAGEACTOR.PRINCESS_SOLILOQUY.BIRD2_6"
msgid "Yeah, hold your horses!"
msgstr ""

