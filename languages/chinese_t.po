msgid "Heave, ho, let's go!"
msgstr "用力，來，咱們走！"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.SEAFARING_PROTOTYPER.BURNT
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.SEAFARING_PROTOTYPER.BURNT"
msgid "The fire caused it to expire!"
msgstr "數天無雨，付之一炬！"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.SEAFARING_PROTOTYPER.GENERIC
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.SEAFARING_PROTOTYPER.GENERIC"
msgid "For a mind as vast as the sea is deep!"
msgstr "像大海一樣廣闊而深邃的知識！"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.SEAFOODGUMBO
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.SEAFOODGUMBO"
msgid "Gleefully gilly gumbo!"
msgstr "歡樂魚鰓濃湯！"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.SEASTACK
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.SEASTACK"
msgid "It would be quite a shock to hit that rock."
msgstr "如若碰撞，必遭重創。"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.SECURITY_PULSE_CAGE
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.SECURITY_PULSE_CAGE"
msgid "It's orbless, more or less."
msgstr "終究少了幾顆球。"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.SECURITY_PULSE_CAGE_FULL
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.SECURITY_PULSE_CAGE_FULL"
msgid "It absorbed the orb!"
msgstr "它吸收了球球！"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.SEEDPOUCH
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.SEEDPOUCH"
msgid "For my gardening needs, a place to store seeds!"
msgstr "工欲善其事，必先利其器！"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.SEEDS
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.SEEDS"
msgid "Let's give them some soil, before they spoil."
msgstr "趕緊埋土裡種起來，不然壞了怎麼辦。"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.SEEDS_COOKED
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.SEEDS_COOKED"
msgid "The seeds have been cooked."
msgstr "種子做熟了。"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.SENTRYWARD
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.SENTRYWARD"
msgid "Hyuyu! What a mischievous way to spy!"
msgstr "哼！這種偵查的方式真調皮！"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.SEWING_KIT
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.SEWING_KIT"
msgid "Sew and stitch, it's quite the fix!"
msgstr "縫縫補補，修理的好辦法！"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.SEWING_MANNEQUIN.BURNT
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.SEWING_MANNEQUIN.BURNT"
msgid "Is it in fashion to look so ashen?"
msgstr "時下的流行色是煙灰？"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.SEWING_MANNEQUIN.GENERIC
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.SEWING_MANNEQUIN.GENERIC"
msgid "Not one for chatter, I gather?"
msgstr "你話不多嘍？"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.SEWING_TAPE
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.SEWING_TAPE"
msgid "Are you sure it's not magic?"
msgstr "確定不是魔法嗎？"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.SHADOWDANCER
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.SHADOWDANCER"
msgid "Dance shadow man, dance! Hyuyu!"
msgstr "盡情的舞蹈吧，影子！哼！"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.SHADOWDIGGER
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.SHADOWDIGGER"
msgid "So, what's he paying you?"
msgstr "他給了你多少好處？"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.SHADOWHEART
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.SHADOWHEART"
msgid "Oh, how neat! It continues to beat."
msgstr "太炫了！它還在跳呢。"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.SHADOWRIFT_PORTAL
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.SHADOWRIFT_PORTAL"
msgid "Hyuyu, watch your step!"
msgstr "哼，小心腳下！"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.SHADOWTHRALL_CENTIPEDE.BODY
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.SHADOWTHRALL_CENTIPEDE.BODY"
msgid "Hard to make a dent in that segment!"
msgstr "那一截硬得很，凹痕難留半分！"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.SHADOWTHRALL_CENTIPEDE.FLIPPED
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.SHADOWTHRALL_CENTIPEDE.FLIPPED"
msgid "A heck of a train wreck!"
msgstr "大型翻車現場！"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.SHADOWTHRALL_CENTIPEDE.HEAD
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.SHADOWTHRALL_CENTIPEDE.HEAD"
msgid "Two heads? What about a butt?"
msgstr "兩個腦袋？屁股往哪擺？"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.SHADOWTHRALL_HANDS
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.SHADOWTHRALL_HANDS"
msgid "This one's all topsy-turvy, hyuyu!"
msgstr "這傢伙徹底顛倒了，哼！"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.SHADOWTHRALL_HORNS
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.SHADOWTHRALL_HORNS"
msgid "You wouldn't want to eat a sweet little imp like me!"
msgstr "你不會忍心吃掉我這個乖乖小惡魔的！"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.SHADOWTHRALL_MOUTH
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.SHADOWTHRALL_MOUTH"
msgid "I'd rather see that smile from a mile."
msgstr "我寧願在一公里外看到那個笑容。"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.SHADOWTHRALL_PARASITE
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.SHADOWTHRALL_PARASITE"
msgid "That thingy looks clingy."
msgstr "那東西看起來很粘人。"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.SHADOWTHRALL_WINGS
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.SHADOWTHRALL_WINGS"
msgid "A fright, taken flight!"
msgstr "起飛的恐懼！"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.SHADOW_BATTLEAXE
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.SHADOW_BATTLEAXE"
msgid "Foes will take pause, when they see the claws."
msgstr "當敵人看到利爪，他們就會停下。"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.SHADOW_BEEF_BELL
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.SHADOW_BEEF_BELL"
msgid "A bell to bring back the beef!"
msgstr "可以把牛肉帶回來的鈴鐺！"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.SHADOW_FORGE
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.SHADOW_FORGE"
msgid "Those idle hands should be put to work, hyuyu!"
msgstr "這雙遊手好閒的手應該去投入工作，哼！"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.SHADOW_FORGE_KIT
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.SHADOW_FORGE_KIT"
msgid "All work and no play makes for an irritable imp."
msgstr "只工作，不玩耍，小小惡魔脾氣炸。"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.SHADOW_HEART_VEIN
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.SHADOW_HEART_VEIN"
msgid "And even there, it's a snare!"
msgstr "那兒有圈套，實在難逃！"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.SHALLOW_GRAVE
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.SHALLOW_GRAVE"
msgid "Poor soul."
msgstr "可憐的靈魂。"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.SHARK
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.SHARK"
msgid "Don't eat me, you'll get fur stuck in your teeth!"
msgstr "不要吃我，我的毛髮會塞在你的牙齒上的！"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.SHARKBOI
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.SHARKBOI"
msgid "That's one cool customer, hyuyu!"
msgstr "這個消費者挺酷的，哼！"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.SHELLWEAVER
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.SHELLWEAVER"
msgid "Halt! Do we have enough salt?"
msgstr "停一下！咱們的鹽夠不夠啊？"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.SHELL_CLUSTER
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.SHELL_CLUSTER"
msgid "I wonder if there's any goodies inside?"
msgstr "不知道裡面有沒有什麼好東西？"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.SHIELDOFTERROR
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.SHIELDOFTERROR"
msgid "I stole the grin right off of him, hyuyu!"
msgstr "我把他的笑臉偷走了，哼！"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.SHOVEL
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.SHOVEL"
msgid "I could dig a hole where I belong!"
msgstr "想在哪挖洞，就在哪挖洞！"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.SHOVEL_LUNARPLANT
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.SHOVEL_LUNARPLANT"
msgid "Dig a hole to who knows where!"
msgstr "挖個誰都不知道通向哪裡的洞！"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.SHROOMBAIT
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.SHROOMBAIT"
msgid "As sure as the oozing, this'll have you snoozing."
msgstr "滲出的髒水將助你安睡。"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.SHROOMCAKE
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.SHROOMCAKE"
msgid "There's no room in my stomach, I'm afraid."
msgstr "我的胃裡恐怕沒有空間了。"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.SHROOM_SKIN
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.SHROOM_SKIN"
msgid "Spotty and stinky!"
msgstr "斑斑點點，還臭不可聞！"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.SIESTAHUT.BURNT
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.SIESTAHUT.BURNT"
msgid "Burnt down, down to the ground."
msgstr "燒成了平地。"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.SIESTAHUT.GENERIC
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.SIESTAHUT.GENERIC"
msgid "I could catch a wink, I think."
msgstr "好吧，我可以午睡一下。"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.SILK
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.SILK"
msgid "A present from the spider's ilk."
msgstr "蜘蛛的親戚送的禮物。"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.SINGINGSHELL_OCTAVE3.GENERIC
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.SINGINGSHELL_OCTAVE3.GENERIC"
msgid "A barnacled baritone!"
msgstr "貝殼男中音！"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.SINGINGSHELL_OCTAVE4.GENERIC
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.SINGINGSHELL_OCTAVE4.GENERIC"
msgid "Sweet singing seashells!"
msgstr "甜美的唱歌貝殼！"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.SINGINGSHELL_OCTAVE5.GENERIC
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.SINGINGSHELL_OCTAVE5.GENERIC"
msgid "Such a high pitch, it makes my ears itch..."
msgstr "曲高和寡，溫文爾雅……"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.SISTURN.GENERIC
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.SISTURN.GENERIC"
msgid "A touching tribute to a treasured twin."
msgstr "對孿生姐妹的哀思令人感動。"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.SISTURN.LOTS_OF_FLOWERS
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.SISTURN.LOTS_OF_FLOWERS"
msgid "Maybe I should keep my distance..."
msgstr "我應當保持距離……"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.SISTURN.LOTS_OF_FLOWERS_BLOSSOM
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.SISTURN.LOTS_OF_FLOWERS_BLOSSOM"
msgid "No one around to make that sound."
msgstr "無聲無人地，卻有異響起。"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.SISTURN.LOTS_OF_FLOWERS_EVIL
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.SISTURN.LOTS_OF_FLOWERS_EVIL"
msgid "Floral vanity at the cost of my sanity! Hyuyu!"
msgstr "花豔奪目理智散，虛榮背後是瘋狂！哼哼！"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.SISTURN.SOME_FLOWERS
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.SISTURN.SOME_FLOWERS"
msgid "A flowery addition for our apparition!"
msgstr "花下亡魂！"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.SKELETON
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.SKELETON"
msgid "The soul is long gone."
msgstr "靈魂已遠走。"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.SKELETONHAT
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.SKELETONHAT"
