msgstr "嗯...烤火龍果。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.WORMWOOD_MUTANTPROXY_FRUITDRAGON.SLEEPING
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.WORMWOOD_MUTANTPROXY_FRUITDRAGON.SLEEPING"
