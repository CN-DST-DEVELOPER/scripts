msgstr "好漂亮的一堆柴火！"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.YOTB_STAGE
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.YOTB_STAGE"
msgid "You think you can judge me?!"
msgstr "你覺得你能評判我？！"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.YOTB_STAGE_ITEM
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.YOTB_STAGE_ITEM"
