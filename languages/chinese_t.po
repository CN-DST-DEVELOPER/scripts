msgstr "嘿！這是緊急燃料啊！"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.MESSAGEBOTTLEEMPTY
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.MESSAGEBOTTLEEMPTY"
msgid "Just a boring old bottle."
msgstr "無聊的舊罐子。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.MIGHTY_GYM.BURNT
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.MIGHTY_GYM.BURNT"
