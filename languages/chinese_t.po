msgstr "將保持小船的安全。"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.BOAT_CANNON.AMMOLOADED
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.BOAT_CANNON.AMMOLOADED"
