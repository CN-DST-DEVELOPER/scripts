msgstr "跟我的牙齒一樣鋒利！"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.GLOMMER.GENERIC
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.GLOMMER.GENERIC"
