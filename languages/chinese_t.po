msgstr "簡直掃興。"

#. STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_WX_SCANNER_NEW_FOUND
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_WX_SCANNER_NEW_FOUND"
