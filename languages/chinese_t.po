#. STRINGS.SKILLTREE.WOODIE.WOODIE_HUMAN_TREEGUARD_1_DESC
msgctxt "STRINGS.SKILLTREE.WOODIE.WOODIE_HUMAN_TREEGUARD_1_DESC"
msgid "Deal a fair amount more damage to Treeguards."
msgstr "對樹精守衛造成更多的傷害。"

#. STRINGS.SKILLTREE.WOODIE.WOODIE_HUMAN_TREEGUARD_1_TITLE
