msgstr "是植物。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.MARSH_TREE.BURNING
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.MARSH_TREE.BURNING"
