msgstr "露西，我可以解釋！"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.SHADOW_BEEF_BELL
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.SHADOW_BEEF_BELL"
