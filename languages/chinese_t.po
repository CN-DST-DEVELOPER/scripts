msgstr "是來自月亮的小碎片！"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.MOONSPIDERDEN
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.MOONSPIDERDEN"
