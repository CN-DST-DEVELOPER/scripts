msgctxt "STRINGS.DIRECTIONS.SW"
msgid "Southwest"
msgstr "西南"

#. STRINGS.DIRECTIONS.W
msgctxt "STRINGS.DIRECTIONS.W"
msgid "West"
msgstr "西"

