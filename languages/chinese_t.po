msgstr "only_used_by_wx78"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.SPOILED_FISH.GENERIC
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.SPOILED_FISH.GENERIC"
