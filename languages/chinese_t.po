msgstr "這才像話。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.YOTC_CARRAT_RACE_FINISH.GENERIC
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.YOTC_CARRAT_RACE_FINISH.GENERIC"
