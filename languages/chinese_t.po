msgstr "凝結並密封！"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.GELBLOB_STORAGE.GENERIC
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.GELBLOB_STORAGE.GENERIC"
