msgid "The rain hurts my mighty skin."
msgstr "雨水對我健美的皮膚不好。"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.UNAGI
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.UNAGI"
msgid "Food makes me mighty!"
msgstr "食物讓我強大！"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.UNIMPLEMENTED
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.UNIMPLEMENTED"
msgid "I do not trust unfinished business."
msgstr "我不相信未完成的東西。"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.VAULT_CHANDELIER_BROKEN
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.VAULT_CHANDELIER_BROKEN"
msgid "That belong on ceiling."
msgstr "那個是天花板上的。"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.VAULT_COMPASS.GENERIC
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.VAULT_COMPASS.GENERIC"
msgid "Wolfgang knows the way! ...But compass helps."
msgstr "沃爾夫岡知道路！……但導航儀有幫助。"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.VAULT_COMPASS.KEYROOM
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.VAULT_COMPASS.KEYROOM"
msgid "We are here! Just like Wolfgang said!"
msgstr "我們到了！沃爾夫岡一早就説沒問題！"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.VAULT_COMPASS.NOTVAULT
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.VAULT_COMPASS.NOTVAULT"
msgid "Is broken! How will Wolfgang know where to go?!"
msgstr "壞了！沃爾夫岡怎麼知道往哪兒走？！"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.VAULT_CRAWLER.GENERIC
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.VAULT_CRAWLER.GENERIC"
msgid "Rock bug needs little push!"
msgstr "石頭蟲子需要推一下！"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.VAULT_CRAWLER.SOCKETED
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.VAULT_CRAWLER.SOCKETED"
msgid "You stay there, rock bug!"
msgstr "你待在那，石頭蟲子！"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.VAULT_CRAWLER_LEVER
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.VAULT_CRAWLER_LEVER"
msgid "Stand back! Wolfgang will pull!"
msgstr "退後！沃爾夫岡要拉了！"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.VAULT_DECON_DOOR
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.VAULT_DECON_DOOR"
msgid "Would be hard for even mighty Wolfgang to break down."
msgstr "就算強大的沃爾夫岡也很難撞開。"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.VAULT_DECON_MISTER
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.VAULT_DECON_MISTER"
msgid "Chases scary shadows away. Wolfgang like!"
msgstr "能趕走嚇人的影子。沃爾夫岡喜歡！"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.VAULT_KEY
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.VAULT_KEY"
msgid "Will weird rock help bring Wolfgang home?"
msgstr "怪石頭會幫沃爾夫岡回家嗎？"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.VAULT_KEY_ACTIVATOR
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.VAULT_KEY_ACTIVATOR"
msgid "Has place for putting something inside."
msgstr "有個地方可以放東西進去。"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.VAULT_KEY_EXIT
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.VAULT_KEY_EXIT"
msgid "Nowhere for Wolfgang to tie rope!"
msgstr "沒地方給沃爾夫岡繫繩子！"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.VAULT_KEY_PEDESTAL.GENERIC
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.VAULT_KEY_PEDESTAL.GENERIC"
msgid "Time for Wolfgang to claim prize!"
msgstr "沃爾夫岡該領獎了！"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.VAULT_KEY_PEDESTAL.PICKED
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.VAULT_KEY_PEDESTAL.PICKED"
msgid "Nothing there for Wolfgang."
msgstr "那裏沒有給沃爾夫岡的東西。"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.VAULT_LOBBY_EXIT
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.VAULT_LOBBY_EXIT"
msgid "Too dark to see bottom... maybe Wolfgang climb down with rope, just to be safe."
msgstr "太黑，看不到底……也許沃爾夫岡用繩子爬下去，安全一點。"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.VAULT_ORB
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.VAULT_ORB"
msgid "It is not ball for fun."
msgstr "這不是用來玩的球。"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.VAULT_ORB_REFINED
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.VAULT_ORB_REFINED"
msgid "So pretty and shiny."
msgstr "好漂亮，好閃亮。"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.VAULT_PILLAR_GUARD
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.VAULT_PILLAR_GUARD"
msgid "Wolfgang does not like ancient interior decorating."
msgstr "沃爾夫岡不喜歡古代的內裝。"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.VAULT_PILLAR_GUARD_CONSTR
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.VAULT_PILLAR_GUARD_CONSTR"
msgid "Wolfgang can't wait!"
msgstr "沃爾夫岡等不及了！"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.VAULT_PILLAR_GUARD_CONSTR_PLANS
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.VAULT_PILLAR_GUARD_CONSTR_PLANS"
msgid "Wolfgang need good spot to put."
msgstr "沃爾夫岡需要找好地方放。"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.VAULT_PILLAR_GUARD_CRAFTED
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.VAULT_PILLAR_GUARD_CRAFTED"
msgid "But is it as mighty as Wolfgang? Of course not!"
msgstr "所以它有沃爾夫岡強大嗎？當然沒有！"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.VAULT_PILLAR_GUARD_DORMANT
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.VAULT_PILLAR_GUARD_DORMANT"
msgid "Ancient tower looks mighty."
msgstr "古塔看起來很強大。"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.VAULT_PILLAR_GUARD_DORMANT_CRAFTED
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.VAULT_PILLAR_GUARD_DORMANT_CRAFTED"
msgid "It need power source to become mighty!"
msgstr "它需要能量才能變強大！"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.VAULT_PILLAR_GUARD_PIECE
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.VAULT_PILLAR_GUARD_PIECE"
msgid "This must belong to big brick guy."
msgstr "這多半是那個磚頭砌的大塊頭的東西。"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.VAULT_REFINER_PEDESTAL
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.VAULT_REFINER_PEDESTAL"
msgid "What will Wolfgang make here?"
msgstr "沃爾夫岡在這做點什麼？"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.VAULT_RUNE
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.VAULT_RUNE"
msgid "Cute scribblemarks."
msgstr "可愛的塗鴉標記。"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.VAULT_STATUE.LORE1
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.VAULT_STATUE.LORE1"
msgid "Is very tragic."
msgstr "很悲慘。"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.VAULT_STATUE.LORE2
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.VAULT_STATUE.LORE2"
msgid "Is just bugs. Why Wolfgang heart breaking?"
msgstr "只是蟲子而已。可是為什麼沃爾夫岡好心疼？"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.VAULT_STATUE.LORE3
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.VAULT_STATUE.LORE3"
msgid "Lucky they are statue, or Wolfgang squish them all!"
msgstr "還好它們是雕像，不然沃爾夫岡會把它們全都碾碎！"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.VAULT_TELEPORTER.BROKEN
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.VAULT_TELEPORTER.BROKEN"
msgid "Maybe we leave it like this."
msgstr "不如我們就讓它這樣別管。"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.VAULT_TELEPORTER.GENERIC
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.VAULT_TELEPORTER.GENERIC"
msgid "Will be same Wolfgang on other side?"
msgstr "從另一邊出來的會是同一個沃爾夫岡嗎？"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.VAULT_TELEPORTER.UNPOWERED
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.VAULT_TELEPORTER.UNPOWERED"
msgid "It lacks power!"
msgstr "它缺少能量！"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.VAULT_TORCH.BROKEN
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.VAULT_TORCH.BROKEN"
msgid "It is broken?"
msgstr "它壞掉了？"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.VAULT_TORCH.GENERIC
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.VAULT_TORCH.GENERIC"
msgid "Oh good, bright light for Wolfgang."
msgstr "太好了，沃爾夫岡有亮光了。"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.VEGGIEOMLET
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.VEGGIEOMLET"
msgid "Egg with vegetables, a mighty breakfast!"
msgstr "雞蛋配蔬菜，強大的早餐！"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.VEGGIE_OVERSIZED_ROTTEN
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.VEGGIE_OVERSIZED_ROTTEN"
msgid "Wolfgang was going to eat that..."
msgstr "沃爾夫岡本來打算要吃那個……"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.VEGSTINGER
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.VEGSTINGER"
msgid "Hoo! Is spicy!"
msgstr "喔！辣！"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.VICTORIAN_BLUEPRINT
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.VICTORIAN_BLUEPRINT"
msgid "Looks very complicated to Wolfgang."
msgstr "沃爾夫岡覺得它很複雜。"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.VOIDCLOTH
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.VOIDCLOTH"
msgid "Scary little rags."
msgstr "可怕的小破布。"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.VOIDCLOTHHAT
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.VOIDCLOTHHAT"
msgid "Eep! Is too dark in there!"
msgstr "咦！裡面好暗！"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.VOIDCLOTH_BOOMERANG
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.VOIDCLOTH_BOOMERANG"
msgid "Wolfgang never miss... most of time."
msgstr "沃爾夫岡不會失手...大多數時候。"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.VOIDCLOTH_KIT
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.VOIDCLOTH_KIT"
msgid "Wolfgang will fix, good as new!"
msgstr "沃爾夫岡會修好，就像新的一樣！"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.VOIDCLOTH_SCYTHE
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.VOIDCLOTH_SCYTHE"
msgid "Wolfgang will cut with one mighty swipe!"
msgstr "沃爾夫岡強力一揮什麼都能砍倒！"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.VOIDCLOTH_UMBRELLA
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.VOIDCLOTH_UMBRELLA"
msgid "Wolfgang would like less spooky umbrella, please."
msgstr "沃爾夫岡想要不那麼嚇人的雨傘，拜託。"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.VOLTGOATJELLY
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.VOLTGOATJELLY"
msgid "Is look very nice, tasty-making friend!"
msgstr "看起來很好吃，製作美味的朋友！"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.WAFFLES
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.WAFFLES"
msgid "Why does bread have holes?"
msgstr "為什麼麵包上有孔？"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.WAGBOSS_ROBOT
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.WAGBOSS_ROBOT"
msgid "Big machine guy look strong, but Wolfgang stronger."
msgstr "大機器只是看起來壯，沃爾夫岡比它更壯。"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.WAGBOSS_ROBOT_CONSTRUCTIONSITE
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.WAGBOSS_ROBOT_CONSTRUCTIONSITE"
msgid "Wolfgang can't wait to fight big scary machine guy!"
msgstr "沃爾夫岡等不及跟嚇人的大機器人打一架了！"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.WAGBOSS_ROBOT_CONSTRUCTIONSITE_KIT
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.WAGBOSS_ROBOT_CONSTRUCTIONSITE_KIT"
msgid "Look at tiny machine guy, all tiny!"
msgstr "看這個小機器人，簡直太小了！"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.WAGBOSS_ROBOT_CREATION_PARTS
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.WAGBOSS_ROBOT_CREATION_PARTS"
msgid "Hurry and finish build big machine guy!"
msgstr "快點動手造大機器人！"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.WAGBOSS_ROBOT_LEG
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.WAGBOSS_ROBOT_LEG"
msgid "See? Wolfgang leg stronger and don't fall off like big machine guy!"
msgstr "看到沒？沃爾夫岡的腿更強壯，不會像大機器那樣掉下來！"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.WAGBOSS_ROBOT_POSSESSED
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.WAGBOSS_ROBOT_POSSESSED"
msgid "No fair! Wolfgang no have rockets!"
msgstr "不公平！沃爾夫岡為什麼沒火箭！"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.WAGBOSS_ROBOT_SECRET
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.WAGBOSS_ROBOT_SECRET"
msgid "Wolfgang love a big reveal!"
msgstr "沃爾夫岡喜歡大揭秘！"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.WAGDRONE_BEACON
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.WAGDRONE_BEACON"
msgid "Haha! Little robot cannot cross invisible wall."
msgstr "哈哈！哈哈！小機器人過不了隱形牆。"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.WAGDRONE_FLYING.DAMAGED
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.WAGDRONE_FLYING.DAMAGED"
msgid "It parts can only give life to another now... sigh."
msgstr "它的零件現在只能給別人生命了……唉。"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.WAGDRONE_FLYING.GENERIC
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.WAGDRONE_FLYING.GENERIC"
msgid "Is giving Wolfgang headache!"
msgstr "讓沃爾夫岡頭疼了！"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.WAGDRONE_FLYING.INACTIVE
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.WAGDRONE_FLYING.INACTIVE"
msgid "Little machine sleeping."
msgstr "小機器在睡覺。"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.WAGDRONE_PARTS
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.WAGDRONE_PARTS"
msgid "We can use to fix little spinny guy."
msgstr "可以用來修理小轉動機器人。"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.WAGDRONE_ROLLING.DAMAGED
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.WAGDRONE_ROLLING.DAMAGED"
msgid "Aww, little guy can be fixed, or harvest for parts... sniff."
msgstr "啊，小傢伙可以修好，或者拆零件……抽鼻子。"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.WAGDRONE_ROLLING.FRIENDLY
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.WAGDRONE_ROLLING.FRIENDLY"
msgid "We are friends now."
msgstr "我們現在是朋友了。"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.WAGDRONE_ROLLING.GENERIC
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.WAGDRONE_ROLLING.GENERIC"
msgid "Spin over here so Wolfgang can crush you!"
msgstr "滾過來讓沃爾夫岡碾碎你！"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.WAGDRONE_ROLLING.INACTIVE
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.WAGDRONE_ROLLING.INACTIVE"
msgid "Little machine sleeping."
msgstr "小機器在睡覺。"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.WAGPUNKBITS_KIT
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.WAGPUNKBITS_KIT"
msgid "Is robot armor fixer."
msgstr "修理機器盔甲用的。"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.WAGPUNKHAT
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.WAGPUNKHAT"
msgid "Robot hat make Wolfgang more deadly? Impossible. Give to me."
msgstr "機器帽子能讓沃爾夫岡變得更致命？不可能。給我。"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.WAGPUNK_BITS
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.WAGPUNK_BITS"
msgid "Funny metal bits."
msgstr "好玩的小金屬片。"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.WAGPUNK_CAGEWALL
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.WAGPUNK_CAGEWALL"
msgid "Nothing can contain mighty Wolfgang! Unless he allow it."
msgstr "沒什麼能困住強大的沃爾夫岡！除非他自願。"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.WAGPUNK_FLOOR_KIT
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.WAGPUNK_FLOOR_KIT"
msgid "Wolfgang have more place to do pushup."
msgstr "沃爾夫岡有更多地方做俯臥撐了。"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.WAGPUNK_LEVER
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.WAGPUNK_LEVER"
msgid "What does it do? Wolfgang just curious."
msgstr "這是幹嘛的？沃爾夫岡好奇了。"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.WAGPUNK_WORKSTATION
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.WAGPUNK_WORKSTATION"
msgid "Wolfgang not afraid of technology."
msgstr "沃爾夫岡不怕科技。"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.WAGSTAFF_ITEM_1
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.WAGSTAFF_ITEM_1"
msgid "Glove is real? Wolfgang confused."
msgstr "手套是真的？沃爾夫岡不明白。"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.WAGSTAFF_ITEM_2
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.WAGSTAFF_ITEM_2"
msgid "Clipboard is not strange projection? Strange."
msgstr "剪貼板不是奇怪的投影？奇怪。"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.WAGSTAFF_MACHINERY
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.WAGSTAFF_MACHINERY"
msgid "Wolfgang is not sure he likes old man leaving garbage around."
msgstr "沃爾夫岡不確定他是否喜歡老人亂丟垃圾。"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.WAGSTAFF_MUTATIONS_NOTE
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.WAGSTAFF_MUTATIONS_NOTE"
msgid "Wolfgang has no interest in old man scribblemarks."
msgstr "沃爾夫岡對老人的亂寫亂畫沒興趣。"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.WAGSTAFF_NPC
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.WAGSTAFF_NPC"
msgid "Do not worry, Wolfgang is here to help flickery science man."
msgstr "別擔心，沃爾夫岡來幫閃爍的科學男了。"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.WAGSTAFF_NPC_MUTATIONS
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.WAGSTAFF_NPC_MUTATIONS"
msgid "Flickery science man is back!"
msgstr "閃爍的科學人回來了！"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.WAGSTAFF_NPC_WAGPUNK
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.WAGSTAFF_NPC_WAGPUNK"
msgid "Wait for Wolfgang!"
msgstr "等著沃爾夫岡！"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.WAGSTAFF_TOOL_1
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.WAGSTAFF_TOOL_1"
msgid "Wolfgang found thing for funny old man!"
msgstr "沃爾夫岡替好玩的老傢伙找到他要的東西了！"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.WAGSTAFF_TOOL_2
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.WAGSTAFF_TOOL_2"
