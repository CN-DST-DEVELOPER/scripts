msgstr "這個讓我們感覺不對勁。"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.HERMITCRABTEA_SUCCULENT_PICKED
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.HERMITCRABTEA_SUCCULENT_PICKED"
