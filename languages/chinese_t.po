msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.WX78MODULE_LIGHT"
msgid "Are you the brightest bulb of the bunch?"
msgstr "你是夜空中最閃亮的燈泡麼？"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.WX78MODULE_LIGHT2
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.WX78MODULE_LIGHT2"
msgid "Are you the brightest bulb of the bunch?"
msgstr "你是夜空中最閃亮的燈泡麼？"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.WX78MODULE_MAXHEALTH
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.WX78MODULE_MAXHEALTH"
msgid "Are you the brightest bulb of the bunch?"
msgstr "你是夜空中最閃亮的燈泡麼？"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.WX78MODULE_MAXHEALTH2
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.WX78MODULE_MAXHEALTH2"
msgid "Are you the brightest bulb of the bunch?"
msgstr "你是夜空中最閃亮的燈泡麼？"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.WX78MODULE_MAXHUNGER
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.WX78MODULE_MAXHUNGER"
msgid "Are you the brightest bulb of the bunch?"
msgstr "你是夜空中最閃亮的燈泡麼？"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.WX78MODULE_MAXHUNGER1
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.WX78MODULE_MAXHUNGER1"
msgid "Are you the brightest bulb of the bunch?"
msgstr "你是夜空中最閃亮的燈泡麼？"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.WX78MODULE_MAXSANITY
