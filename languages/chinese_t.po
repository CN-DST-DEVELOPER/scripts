msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.SPIDERQUEENCORPSE.GENERIC"
msgid "Eww! I feel sick."
msgstr "呃！我覺得噁心。"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.SPIDERQUEENCORPSE.REVIVING
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.SPIDERQUEENCORPSE.REVIVING"
msgid "This is not good."
msgstr "這下糟了。"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.SPIDER_DROPPER
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.SPIDER_DROPPER"
msgid "Note to self: Don't look up."
msgstr "自我提醒：別向上看。"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.SPIDER_HEALER
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.SPIDER_HEALER"
