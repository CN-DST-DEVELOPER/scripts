msgctxt "STRINGS.UI.LOBBYSCREEN.CANCEL"
msgid "Cancel"
msgstr "取消"

#. STRINGS.UI.LOBBYSCREEN.CHAT
msgctxt "STRINGS.UI.LOBBYSCREEN.CHAT"
