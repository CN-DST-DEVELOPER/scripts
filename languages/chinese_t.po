#. STRINGS.CHARACTERS.WANDA.ACTIONFAIL.REPAIR.WRONGPIECE
msgctxt "STRINGS.CHARACTERS.WANDA.ACTIONFAIL.REPAIR.WRONGPIECE"
msgid "Oh botheration. I need something else."
msgstr "嗷，麻煩呐。我還需要點別的東西。"

#. STRINGS.CHARACTERS.WANDA.ACTIONFAIL.REPLATE.MISMATCH
msgctxt "STRINGS.CHARACTERS.WANDA.ACTIONFAIL.REPLATE.MISMATCH"
