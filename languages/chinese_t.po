msgstr "這其實是在挽救它。"

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BIRDCORPSE.GENERIC
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BIRDCORPSE.GENERIC"
