msgstr "這樣做值得嗎？"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.MARSH_PLANT
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.MARSH_PLANT"
