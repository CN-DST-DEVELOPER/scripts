msgstr "可以收穫了。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.QUAGMIRE_SALT_RACK_ITEM
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.QUAGMIRE_SALT_RACK_ITEM"
