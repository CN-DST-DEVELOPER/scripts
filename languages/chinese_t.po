msgstr "過了火的惡作劇。"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.YOTC_CARRAT_GYM_DIRECTION.GENERIC
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.YOTC_CARRAT_GYM_DIRECTION.GENERIC"
