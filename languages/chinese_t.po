msgstr "要把它安裝好。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.QUAGMIRE_SAP
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.QUAGMIRE_SAP"
