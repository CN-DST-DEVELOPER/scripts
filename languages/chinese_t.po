msgstr "裡面也許有嚇人的東西。"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.MOONSTORM_GLASS.GENERIC
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.MOONSTORM_GLASS.GENERIC"
