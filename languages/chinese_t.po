msgstr "搖晃的甜點。"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.YOTR_FOOD4
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.YOTR_FOOD4"
