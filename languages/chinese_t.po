msgstr "今天去湖裡劃個船也好。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.OAR_DRIFTWOOD
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.OAR_DRIFTWOOD"
msgid "Nice day for rowin', eh?."
msgstr "很適合划船的一天，對不？"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.OAR_MONKEY
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.OAR_MONKEY"
msgid "That paddle looks like it could do some damage."
msgstr "那東西看起來能製造破壞。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.OASISLAKE.EMPTY
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.OASISLAKE.EMPTY"
msgid "There's nothin' but dirt here."
msgstr "除了土什麼都沒有。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.OASISLAKE.GENERIC
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.OASISLAKE.GENERIC"
