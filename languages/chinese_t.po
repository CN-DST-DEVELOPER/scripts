msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.SKELETON_PLAYER.FEMALE"
msgid "%s got disassembled by %s."
msgstr "%s被%s拆了"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.SKELETON_PLAYER.MALE
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.SKELETON_PLAYER.MALE"
msgid "%s got disassembled by %s."
msgstr "%s被%s拆了"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.SKELETON_PLAYER.ROBOT
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.SKELETON_PLAYER.ROBOT"
msgid "%s got disassembled by %s."
msgstr "%s被%s拆了"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.SKETCH
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.SKETCH"
