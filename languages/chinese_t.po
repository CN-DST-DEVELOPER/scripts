msgstr "臭蟲子。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.QUAGMIRE_SUGARWOODTREE.TAPPED_EMPTY
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.QUAGMIRE_SUGARWOODTREE.TAPPED_EMPTY"
