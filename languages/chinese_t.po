msgstr "哈！我可以盯著看一天。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.YOTC_CARRAT_GYM_REACTION_ITEM
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.YOTC_CARRAT_GYM_REACTION_ITEM"
