msgstr "“陛下”"

#. STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_ROYALTY_JOKER.3
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_ROYALTY_JOKER.3"
msgid "You wear that \"crown\" well."
msgstr "你戴那頂“王冠”很合適。"

#. STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_RUINS_RESET
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_RUINS_RESET"
msgid "Careful, the monsters are back."
msgstr "小心，怪獸回來了。"

#. STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_SACREDCHEST_NO
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_SACREDCHEST_NO"
msgid "Shoot. I thought I had it."
msgstr "可惜啊，我本來很有把握的。"

#. STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_SACREDCHEST_YES
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_SACREDCHEST_YES"
msgid "That did the trick."
msgstr "起作用了。"

#. STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_SCRAPBOOK_FULL
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_SCRAPBOOK_FULL"
msgid "My scrapbook has already been completed."
msgstr "我的圖鑒已經完成了。"

#. STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_SECURITY_PULSE_FOLLOWING
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_SECURITY_PULSE_FOLLOWING"
msgid "It is attracted to this device."
msgstr "這台裝置吸引着它。"

#. STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_SHADOWTHRALL_STEALTH
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_SHADOWTHRALL_STEALTH"
msgid "I've been bitten by a camouflaged creature!"
msgstr "我被隱秘的生物咬了！"

#. STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_SHADOW_RIFT_MAX
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.ANNOUNCE_SHADOW_RIFT_MAX"
