msgstr "別弄得太簡單。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.CARNIVALGAME_GOLF_TEE.GENERIC
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.CARNIVALGAME_GOLF_TEE.GENERIC"
