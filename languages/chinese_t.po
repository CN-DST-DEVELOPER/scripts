msgstr "別把我的球吹來吹去！"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.CARNIVALGAME_GOLFPROP_FENCE
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.CARNIVALGAME_GOLFPROP_FENCE"
