msgstr "哼，好像誰會懷疑我會贏一樣。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.YOTC_CARRAT_RACE_FINISH.SOMEONE_ELSE_WON
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.YOTC_CARRAT_RACE_FINISH.SOMEONE_ELSE_WON"
msgid "{winner} was just lucky, I'm winning the next one."
msgstr "{winner}不過是走運罷了，下一場我一定贏。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.YOTC_CARRAT_RACE_FINISH_ITEM
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.YOTC_CARRAT_RACE_FINISH_ITEM"
msgid "Let's see, where's a good spot for me to win?"
msgstr "來看看，哪個好位置容易讓我贏？"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.YOTC_CARRAT_RACE_START
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.YOTC_CARRAT_RACE_START"
