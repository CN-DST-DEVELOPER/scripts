msgstr "簡單的目標。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.CARNIVALGAME_GOLF_HOLE_KIT
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.CARNIVALGAME_GOLF_HOLE_KIT"
