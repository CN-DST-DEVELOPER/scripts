msgstr "是荊棘。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.MARSH_BUSH.PICKED
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.MARSH_BUSH.PICKED"
