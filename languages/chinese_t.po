msgstr "會把沃爾夫岡的鬍鬚弄毛燥！"

#. STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.MOONSTORM_STATIC
msgctxt "STRINGS.CHARACTERS.WOLFGANG.DESCRIBE.MOONSTORM_STATIC"
