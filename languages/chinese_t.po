msgstr "船體維修工具。"

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BOATPATCH_KELP
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.BOATPATCH_KELP"
