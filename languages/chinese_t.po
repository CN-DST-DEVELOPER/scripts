msgstr "額，它死了。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.WORMWOOD_MUTANTPROXY_CARRAT.GENERIC
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.WORMWOOD_MUTANTPROXY_CARRAT.GENERIC"
