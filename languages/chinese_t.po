msgstr "這兔子什麼都照不亮。"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.YOTR_DECOR_1_ITEM
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.YOTR_DECOR_1_ITEM"
msgid "I know just the place for it."
msgstr "我知道把它放在哪。"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.YOTR_DECOR_2.GENERAL
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.YOTR_DECOR_2.GENERAL"
msgid "That rabbit can really light up a room."
msgstr "那只兔子真的可以點亮一個房間。"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.YOTR_DECOR_2.OUT
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.YOTR_DECOR_2.OUT"
msgid "That rabbit isn't lighting up anything."
msgstr "這兔子什麼都照不亮。"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.YOTR_DECOR_2_ITEM
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.YOTR_DECOR_2_ITEM"
msgid "I know just the place for it."
msgstr "我知道把它放在哪。"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.YOTR_FIGHTRING_BELL.GENERIC
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.YOTR_FIGHTRING_BELL.GENERIC"
msgid "It's peaceful, for now."
msgstr "暫時平靜下來了。"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.YOTR_FIGHTRING_BELL.PLAYING
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.YOTR_FIGHTRING_BELL.PLAYING"
