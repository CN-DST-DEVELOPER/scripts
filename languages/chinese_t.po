msgstr "薇洛！"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.YOTS_SNAKESHRINE.EMPTY
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.YOTS_SNAKESHRINE.EMPTY"
msgid "It has a monstrous appetite."
msgstr "它有怪獸般的吞噬欲。"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.YOTS_SNAKESHRINE.GENERIC
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.YOTS_SNAKESHRINE.GENERIC"
