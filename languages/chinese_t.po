msgstr "柱定在哪裡？"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.YOTS_SNAKESHRINE.BURNT
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.YOTS_SNAKESHRINE.BURNT"
