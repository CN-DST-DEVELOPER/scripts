msgstr "它现在没什么用了。"

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.RESURRECTIONSTATUE.GENERIC
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.RESURRECTIONSTATUE.GENERIC"
