msgstr "也许有一天它会再长回来。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.GROTTO_POOL_BIG
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.GROTTO_POOL_BIG"
