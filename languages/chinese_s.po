msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.WX78MODULE_TASER"
msgid "Are you the brightest bulb of the bunch?"
msgstr "你是夜空中最闪亮的灯泡么？"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.WX78_BACKUPBODY.GENERIC
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.WX78_BACKUPBODY.GENERIC"
msgid "No fair! Spare hardware!"
msgstr "公平何在？备用硬件他不该！"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.WX78_DRONE_DELIVERY
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.WX78_DRONE_DELIVERY"
msgid "WX Express!"
msgstr "WX速递！"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.WX78_DRONE_SCOUT
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.WX78_DRONE_SCOUT"
msgid "It has flown to parts unknown!"
msgstr "振翅飞翔，飞往未知的远方！"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.WX78_DRONE_ZAP
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.WX78_DRONE_ZAP"
msgid "It shoots lightning? How frightening!"
msgstr "它竟射出闪电？当真心惊胆战！"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.WX78_DRONE_ZAP_REMOTE.GENERIC
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.WX78_DRONE_ZAP_REMOTE.GENERIC"
msgid "It won't respond to a non-automaton."
msgstr "不是机器人它就不认。"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.WX78_FOODBRICK.GENERIC
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.WX78_FOODBRICK.GENERIC"
msgid "Not appetizing without first moisturizing."
msgstr "不用水润，难下口吞。"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.WX78_FOODBRICK.WET
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.WX78_FOODBRICK.WET"
msgid "Moisturized, yet still not appetized."
msgstr "已然水润，仍不想吞。"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.WX78_GESTALTTRAPPER
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.WX78_GESTALTTRAPPER"
msgid "They plan to host a ghost..."
msgstr "想法独特，请鬼做客……"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.WX78_INVENTORYCONTAINER.GENERIC
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.WX78_INVENTORYCONTAINER.GENERIC"
msgid "Once a case with endless space, dropped by ol' metal face!"
msgstr "此箱曾无底，金属脸所弃。"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.WX78_INVENTORYCONTAINER.HELD
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.WX78_INVENTORYCONTAINER.HELD"
msgid "only_used_by_wx78"
msgstr "only_used_by_wx78"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.WX78_MODULEREMOVER
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.WX78_MODULEREMOVER"
msgid "It'll work in a pinch, hyuyu!"
msgstr "这是专门用来掐机器人的，哼哼！"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.WX78_POSSESSEDBODY
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.WX78_POSSESSEDBODY"
msgid "Is this what you wanted? That your body be haunted?"
msgstr "所得皆所求？身体被占有？"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.WX78_SCANNER.GENERIC
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.WX78_SCANNER.GENERIC"
msgid "My my, how the tin flies!"
msgstr "感慨万千，铁皮飞天！"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.WX78_SCANNER.HUNTING
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.WX78_SCANNER.HUNTING"
msgid "My my, how the tin flies!"
msgstr "感慨万千，铁皮飞天！"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.WX78_SCANNER.SCANNING
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.WX78_SCANNER.SCANNING"
msgid "My my, how the tin flies!"
msgstr "感慨万千，铁皮飞天！"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.WX78_SCANNER_ITEM
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.WX78_SCANNER_ITEM"
msgid "The tiny tin terror's tuckered out!"
msgstr "那片金属疲倦了！"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.WX78_SCANNER_SUCCEEDED
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.WX78_SCANNER_SUCCEEDED"
msgid "It's done its toil, now our friend must collect the spoils."
msgstr "有它辛苦在前，才有主人的方便。"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.WX78_SHADOWDRONE_DEBUFFER
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.WX78_SHADOWDRONE_DEBUFFER"
msgid "It's got eyes on the bad guys! Hyuyu!"
msgstr "盯牢坏蛋！哼哼！"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.WX78_SHADOWDRONE_HARVESTER
