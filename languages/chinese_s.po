msgstr "真脏。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.SPIDERQUEENCORPSE.REVIVING
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.SPIDERQUEENCORPSE.REVIVING"
