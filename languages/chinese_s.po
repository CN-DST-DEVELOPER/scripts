msgstr "已经被摘掉了。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.QUAGMIRE_SPOTSPICE_SPRIG
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.QUAGMIRE_SPOTSPICE_SPRIG"
