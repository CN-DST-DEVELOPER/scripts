msgstr "可算找到你了，我的小猫猫！"

#. STRINGS.CHARACTERS.WARLY.ANNOUNCE_KITCOON_HIDANDSEEK_FOUND.3
msgctxt "STRINGS.CHARACTERS.WARLY.ANNOUNCE_KITCOON_HIDANDSEEK_FOUND.3"
msgid "Ah, there you are!"
msgstr "啊，你在这里！"

#. STRINGS.CHARACTERS.WARLY.ANNOUNCE_KITCOON_HIDANDSEEK_FOUND.4
msgctxt "STRINGS.CHARACTERS.WARLY.ANNOUNCE_KITCOON_HIDANDSEEK_FOUND.4"
