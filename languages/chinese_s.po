msgstr "一场耳朵的盛宴！"

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.RECORD_DRSTYLE
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.RECORD_DRSTYLE"
msgid "What a sweet sound it makes."
msgstr "它发出的声音多么甜美。"

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.RECORD_DUSK
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.RECORD_DUSK"
msgid "What a sweet sound it makes."
msgstr "它发出的声音多么甜美。"

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.RECORD_EFS
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.RECORD_EFS"
msgid "A feast for the ears!"
msgstr "一场耳朵的盛宴！"

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.RECORD_END
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.RECORD_END"
msgid "A feast for the ears!"
msgstr "一场耳朵的盛宴！"

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.RECORD_HALLOWEDNIGHTS
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.RECORD_HALLOWEDNIGHTS"
msgid "It really sets the mood."
msgstr "它制造的氛围真绝了。"

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.RECORD_MAIN
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.RECORD_MAIN"
msgid "What a sweet sound it makes."
msgstr "它发出的声音多么甜美。"

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.RECORD_WORKTOBEDONE
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.RECORD_WORKTOBEDONE"
msgid "What a sweet sound it makes."
msgstr "它发出的声音多么甜美。"

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.REDGEM
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.REDGEM"
msgid "A deep fire burns within."
msgstr "里面燃烧着深邃的火焰。"

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.REDLANTERN
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.REDLANTERN"
msgid "I do like festivals like this."
msgstr "我喜欢这样的庆典。"

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.REDMOONEYE
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.REDMOONEYE"
