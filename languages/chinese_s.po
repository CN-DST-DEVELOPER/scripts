msgid "Tragopogon"
msgstr "婆罗门参"

#. STRINGS.BUNNYMANNAMES.13
msgctxt "STRINGS.BUNNYMANNAMES.13"
msgid "Ipomoea"
msgstr "番薯"

#. STRINGS.BUNNYMANNAMES.14
msgctxt "STRINGS.BUNNYMANNAMES.14"
msgid "Manihot"
msgstr "木薯"

#. STRINGS.BUNNYMANNAMES.15
msgctxt "STRINGS.BUNNYMANNAMES.15"
msgid "Mirabilis"
