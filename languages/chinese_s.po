msgstr "它们可能是飞累了下来歇歇。"

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_LUNARHAIL_BIRD_SOUNDS
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_LUNARHAIL_BIRD_SOUNDS"
msgid "Those birds don't sound happy."
msgstr "那些鸟儿听起来不开心呢。"

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_LUNAR_RIFT_MAX
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_LUNAR_RIFT_MAX"
