msgstr "啊啊！！不要压扁我们！"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.VAULT_PILLAR_GUARD_CONSTR
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.VAULT_PILLAR_GUARD_CONSTR"
msgid "We're building something fun!"
msgstr "我们在造好玩的东西！"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.VAULT_PILLAR_GUARD_CONSTR_PLANS
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.VAULT_PILLAR_GUARD_CONSTR_PLANS"
msgid "We'll put it in the best spot!"
msgstr "我们要把它放在最好的地方！"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.VAULT_PILLAR_GUARD_CRAFTED
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.VAULT_PILLAR_GUARD_CRAFTED"
msgid "Will you play with us?"
msgstr "你要和我们一起玩吗？"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.VAULT_PILLAR_GUARD_DORMANT
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.VAULT_PILLAR_GUARD_DORMANT"
msgid "So tall! Hope it doesn't fall on us!"
msgstr "真高呀！希望不会砸到我们！"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.VAULT_PILLAR_GUARD_DORMANT_CRAFTED
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.VAULT_PILLAR_GUARD_DORMANT_CRAFTED"
msgid "Why won't it turn on? What's missing?"
msgstr "它为什么不动？少了什么？"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.VAULT_PILLAR_GUARD_PIECE
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.VAULT_PILLAR_GUARD_PIECE"
msgid "What does it do?"
msgstr "它有什么用处？"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.VAULT_REFINER_PEDESTAL
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.VAULT_REFINER_PEDESTAL"
msgid "What does it make? Toys?"
msgstr "它能做什么？玩具吗？"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.VAULT_RUNE
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.VAULT_RUNE"
msgid "Nice drawings."
msgstr "画得真好看。"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.VAULT_STATUE.LORE1
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.VAULT_STATUE.LORE1"
msgid "He's not okay."
msgstr "他不太舒服。"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.VAULT_STATUE.LORE2
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.VAULT_STATUE.LORE2"
msgid "Oh no..."
msgstr "噢，不..."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.VAULT_STATUE.LORE3
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.VAULT_STATUE.LORE3"
msgid "They look mean!"
msgstr "他们看起来很凶！"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.VAULT_TELEPORTER.BROKEN
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.VAULT_TELEPORTER.BROKEN"
msgid "Aw, it's broken!"
msgstr "啊，它坏了！"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.VAULT_TELEPORTER.GENERIC
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.VAULT_TELEPORTER.GENERIC"
msgid "We like this game."
msgstr "我们喜欢这个游戏。"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.VAULT_TELEPORTER.UNPOWERED
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.VAULT_TELEPORTER.UNPOWERED"
msgid "Why won't it turn on?"
msgstr "它为什么不启动？"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.VAULT_TORCH.BROKEN
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.VAULT_TORCH.BROKEN"
msgid "Aw, it's broken."
msgstr "啊，它坏了。"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.VAULT_TORCH.GENERIC
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.VAULT_TORCH.GENERIC"
msgid "We know how it works!"
msgstr "我们知道怎么用！"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.VEGGIEOMLET
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.VEGGIEOMLET"
msgid "Stop trying to trick us into eating our veggies!"
msgstr "别再骗我们吃蔬菜了！"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.VEGGIE_OVERSIZED_ROTTEN
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.VEGGIE_OVERSIZED_ROTTEN"
msgid "Blech, no thank you."
msgstr "呃，不用了，谢谢。"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.VEGSTINGER
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.VEGSTINGER"
msgid "It's a drink with vegetables in it."
msgstr "一种含有蔬菜的饮料。"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.VICTORIAN_BLUEPRINT
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.VICTORIAN_BLUEPRINT"
msgid "It's so fancy! We hope it's not too hard to make..."
msgstr "好花哨啊！希望做起来不是太难……"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.VOIDCLOTH
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.VOIDCLOTH"
msgid "It's definitely not spider silk."
msgstr "这绝对不是蜘蛛丝。"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.VOIDCLOTHHAT
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.VOIDCLOTHHAT"
msgid "It makes us look pretty spooky."
msgstr "它让我们看起来很吓人。"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.VOIDCLOTH_BOOMERANG
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.VOIDCLOTH_BOOMERANG"
msgid "Oooh, fun!"
msgstr "哦，好玩！"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.VOIDCLOTH_KIT
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.VOIDCLOTH_KIT"
msgid "Mum would be proud to see how good we are at this!"
msgstr "看到我们做得这么好妈妈会很自豪的！"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.VOIDCLOTH_SCYTHE
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.VOIDCLOTH_SCYTHE"
msgid "He never used anything like this back on the farm."
msgstr "他原先在农场时从来没用过这样的东西。"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.VOIDCLOTH_UMBRELLA
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.VOIDCLOTH_UMBRELLA"
msgid "It keeps us dry, and gives us lots of shade!"
msgstr "它让我们保持干燥，并为我们提供大量的阴凉！"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.VOLTGOATJELLY
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.VOLTGOATJELLY"
msgid "WOW! Gelatin!"
msgstr "哇！果冻！"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.WAFFLES
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.WAFFLES"
msgid "Yummy!"
msgstr "好吃！"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.WAGBOSS_ROBOT
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.WAGBOSS_ROBOT"
msgid "Does it give rides?"
msgstr "它能让我们搭下车吗？"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.WAGBOSS_ROBOT_CONSTRUCTIONSITE
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.WAGBOSS_ROBOT_CONSTRUCTIONSITE"
msgid "Maybe it won't be so cranky this time."
msgstr "也许它这次不会乱发脾气。"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.WAGBOSS_ROBOT_CONSTRUCTIONSITE_KIT
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.WAGBOSS_ROBOT_CONSTRUCTIONSITE_KIT"
msgid "A fun and dangerous toy to build!"
msgstr "来做一个有趣的危险玩具吧！"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.WAGBOSS_ROBOT_CREATION_PARTS
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.WAGBOSS_ROBOT_CREATION_PARTS"
msgid "More parts!"
msgstr "更多的零件！"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.WAGBOSS_ROBOT_LEG
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.WAGBOSS_ROBOT_LEG"
msgid "Luckily we have more than three legs!"
msgstr "幸好我们不止有三条腿！"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.WAGBOSS_ROBOT_POSSESSED
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.WAGBOSS_ROBOT_POSSESSED"
msgid "We just wanted to play!"
msgstr "我们只是想玩一下！"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.WAGBOSS_ROBOT_SECRET
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.WAGBOSS_ROBOT_SECRET"
msgid "We love surprises!"
msgstr "我们最喜欢惊喜啦！"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.WAGDRONE_BEACON
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.WAGDRONE_BEACON"
