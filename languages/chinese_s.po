msgstr "我们可以在戏里穿它！"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.COSTUME_KING_BODY
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.COSTUME_KING_BODY"
msgid "We can wear it in the play!"
msgstr "我们可以在戏里穿它！"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.COSTUME_MIRROR_BODY
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.COSTUME_MIRROR_BODY"
msgid "We can wear it in the play!"
msgstr "我们可以在戏里穿它！"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.COSTUME_PRINCESS_BODY
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.COSTUME_PRINCESS_BODY"
