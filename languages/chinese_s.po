msgstr "天赐良机！我居然找到了盐！"

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.SALTSTACK.GENERIC
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.SALTSTACK.GENERIC"
msgid "What beautiful formations!"
msgstr "多么美丽的构造！"

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.SALTSTACK.GROWING
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.SALTSTACK.GROWING"
msgid "The sea is capable of amazing things."
