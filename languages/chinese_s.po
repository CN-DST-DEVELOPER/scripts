msgstr "不知道它可不可以燃烧..."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.GLOMMERFLOWER.GENERIC
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.GLOMMERFLOWER.GENERIC"
