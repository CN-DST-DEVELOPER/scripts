msgstr "尘归尘，土归土。"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.QUAGMIRE_PEBBLECRAB
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.QUAGMIRE_PEBBLECRAB"
