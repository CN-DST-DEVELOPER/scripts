msgstr "结实耐用。"

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.SADDLE_WATHGRITHR
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.SADDLE_WATHGRITHR"
