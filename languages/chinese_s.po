msgid "'Tis as dry as an empty well!"
msgstr "干如枯井！"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MEATRACK_HERMIT_MULTI.DONE_SALT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MEATRACK_HERMIT_MULTI.DONE_SALT"
msgid "Salt! A gift from the gods to season my meats!"
msgstr "盐！众神恩赐，为吾之肉食调味！"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MEATRACK_HERMIT_MULTI.DRYING
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MEATRACK_HERMIT_MULTI.DRYING"
msgid "It's being prepared just the way I like it."
msgstr "正是我喜欢的制备方式。"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MEATRACK_HERMIT_MULTI.DRYINGINRAIN
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MEATRACK_HERMIT_MULTI.DRYINGINRAIN"
msgid "All this rain isn't helping."
msgstr "下雨对这个没什么帮助。"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MEATRACK_HERMIT_MULTI.DRYINGINRAIN_NOTMEAT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MEATRACK_HERMIT_MULTI.DRYINGINRAIN_NOTMEAT"
msgid "All this rain isn't helping."
msgstr "下雨对这个没什么帮助。"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MEATRACK_HERMIT_MULTI.DRYING_NOTMEAT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MEATRACK_HERMIT_MULTI.DRYING_NOTMEAT"
msgid "It's drying out nicely."
msgstr "风干的更好。"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MEATRACK_HERMIT_MULTI.GENERIC
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MEATRACK_HERMIT_MULTI.GENERIC"
msgid "Quite a formidable drying rack!"
msgstr "好威风的晾肉架！"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MEATYSALAD
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MEATYSALAD"
msgid "My instincts scream against this."
msgstr "我的直觉尖叫着让我不要吃这个。"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MEAT_DRIED
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MEAT_DRIED"
msgid "Excellent battle provisions."
msgstr "极好的战斗食物供应。"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MEGAFLARE
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MEGAFLARE"
msgid "I fear no enemy. Let them come!"
msgstr "吾不惧强敌。放马过来吧！"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MERM
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MERM"
msgid "Die soggy beast fish!"
msgstr "去死吧，湿腻腻的鱼兽！"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MERMARMORHAT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MERMARMORHAT"
msgid "'Tis not for me."
msgstr "不是给我戴的。"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MERMARMORUPGRADEDHAT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MERMARMORUPGRADEDHAT"
msgid "'Tis not for me."
msgstr "不是给我戴的。"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MERMCORPSE.BURNING
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MERMCORPSE.BURNING"
msgid "Good riddance to foul company."
msgstr "总算摆脱了讨厌的家伙。"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MERMCORPSE.GENERIC
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MERMCORPSE.GENERIC"
msgid "'Tis but another fallen fish beast."
msgstr "不过是又一个倒下的鱼怪。"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MERMCORPSE.REVIVING
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MERMCORPSE.REVIVING"
msgid "You've returned for a second helping of my steel, have you?"
msgstr "你回来是想再尝尝我的利刃吗？"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MERMGUARD
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MERMGUARD"
msgid "A formidable warrior, to be sure."
msgstr "无疑是令人敬畏的勇士。"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MERMGUARD_LUNAR
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MERMGUARD_LUNAR"
msgid "The fish beast is tinged with the essence of Mani."
msgstr "鱼类猛兽身上有玛尼的精华。"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MERMGUARD_SHADOW
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MERMGUARD_SHADOW"
msgid "Warriors, denied their ascension to Valhalla..."
msgstr "这些战士被剥夺了飞升英灵殿的机会……"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MERMHAT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MERMHAT"
msgid "'Tis a deceitful mask."
msgstr "此乃欺骗的面具。"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MERMHEAD.BURNT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MERMHEAD.BURNT"
msgid "Beheaded. Burnt. Stinky."
msgstr "被斩首。被焚烧。恶臭。"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MERMHEAD.GENERIC
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MERMHEAD.GENERIC"
msgid "I could smell it from back there!"
msgstr "这么远我都能闻到它的臭味！"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MERMHOUSE.BURNT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MERMHOUSE.BURNT"
msgid "I won't miss it."
msgstr "我不会想念它的。"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MERMHOUSE.GENERIC
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MERMHOUSE.GENERIC"
msgid "Is this dwelling made of fish?"
msgstr "这屋子是用鱼做的吗？"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MERMHOUSE_CRAFTED.BURNT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MERMHOUSE_CRAFTED.BURNT"
msgid "'Tis the way of things."
msgstr "世事无常。"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MERMHOUSE_CRAFTED.GENERIC
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MERMHOUSE_CRAFTED.GENERIC"
msgid "A home fit for a fish beast."
msgstr "适合鱼类猛兽的家。"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MERMKING
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MERMKING"
msgid "Lord of the fish beasts!"
msgstr "鱼类猛兽之王！"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MERMTHRONE.BURNT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MERMTHRONE.BURNT"
msgid "The throne hath been set ablaze!"
msgstr "王座燃起了熊熊烈火！"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MERMTHRONE.GENERIC
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MERMTHRONE.GENERIC"
msgid "Have you chosen a chieftain?"
msgstr "你们选出了酋长了吗？"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MERMTHRONE_CONSTRUCTION.BURNT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MERMTHRONE_CONSTRUCTION.BURNT"
msgid "'Tis a sad day for the fish beasts."
msgstr "对鱼类猛兽来说这是悲伤的一天。"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MERMTHRONE_CONSTRUCTION.GENERIC
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MERMTHRONE_CONSTRUCTION.GENERIC"
msgid "The little beast toils away."
msgstr "小野兽在卖力苦干。"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MERMWATCHTOWER_NOKING
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MERMWATCHTOWER_NOKING"
msgid "They are lost without their chieftain."
msgstr "少了酋长，他们显得无所适从。"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MERMWATCHTOWER_REGULAR
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MERMWATCHTOWER_REGULAR"
msgid "'Tis a fine fortress for a fish beast."
msgstr "鱼类猛兽的坚固堡垒。"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MERM_ARMORY
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MERM_ARMORY"
msgid "The armory of the fish beast warriors."
msgstr "鱼类猛兽的军械库。"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MERM_ARMORY_UPGRADED
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MERM_ARMORY_UPGRADED"
msgid "The armory of the fish beast warriors."
msgstr "鱼类猛兽的军械库。"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MERM_LUNAR
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MERM_LUNAR"
msgid "The fish beast is tinged with the essence of Mani."
msgstr "鱼类猛兽身上有玛尼的精华。"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MERM_PRINCE
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MERM_PRINCE"
msgid "Thou art certain he is fit to be leader?"
msgstr "尔等肯定他适合当领袖吗？"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MERM_SHADOW
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MERM_SHADOW"
msgid "They are but shades."
msgstr "它们不过是阴影而已。"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MERM_TOOL
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MERM_TOOL"
msgid "I suppose 'tis better than using one's hands."
msgstr "用它总比用手强吧。"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MERM_TOOLSHED
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MERM_TOOLSHED"
msgid "'Tis a place for workers, not warriors."
msgstr "那是工人待的地方，不适合战士。"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MERM_TOOLSHED_UPGRADED
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MERM_TOOLSHED_UPGRADED"
msgid "'Tis a place for workers, not warriors."
msgstr "那是工人待的地方，不适合战士。"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MERM_TOOL_UPGRADED
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MERM_TOOL_UPGRADED"
msgid "I suppose 'tis better than using one's hands."
msgstr "用它总比用手强吧。"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MESSAGEBOTTLE
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MESSAGEBOTTLE"
msgid "What's this? Battle plans?"
msgstr "这是什么？战斗计划吗？"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MESSAGEBOTTLEEMPTY
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MESSAGEBOTTLEEMPTY"
msgid "This vessel might have some use."
msgstr "这载具也许有些用处。"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MIGHTY_GYM.BURNT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MIGHTY_GYM.BURNT"
msgid "'Twas a fiery display indeed!"
msgstr "一番火热的景象！"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MIGHTY_GYM.GENERIC
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MIGHTY_GYM.GENERIC"
msgid "My friend doth possess strength that could rival mighty Thor's!"
msgstr "我的朋友拥有可以与强大的雷神相媲美的力量！"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MILKYWHITES
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MILKYWHITES"
msgid "The goopy spoils of victory!"
msgstr "粘稠的战利品！"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MINERHAT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MINERHAT"
msgid "A lighted helm! For the darkness."
msgstr "会发光的头盔！适合在黑暗中使用。"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MINIBOATLANTERN
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MINIBOATLANTERN"
msgid "The small vessel shall light my way."
msgstr "这个小东西将会为我照亮前路。"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MINIFAN
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MINIFAN"
msgid "The chilling breeze reminds me of my frigid home."
msgstr "寒风使我记起我那寒冷的老家。"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MINIFLARE
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MINIFLARE"
msgid "Never split thy party!"
msgstr "绝对不要跟战友分开！"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MINISIGN.GENERIC
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MINISIGN.GENERIC"
msgid "The runes hath been drawn!"
msgstr "画好了符文！"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MINISIGN.UNDRAWN
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MINISIGN.UNDRAWN"
msgid "Tis blank as the cloudless sky."
msgstr "它和无云的天空一样空白。"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MINISIGN_ITEM
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MINISIGN_ITEM"
msgid "A surface on which to inscribe ancient runes."
msgstr "用来雕刻古老的符文的表面。"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MINOTAUR
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MINOTAUR"
msgid "What wonders. Let us duel!"
msgstr "我可是见过大世面的。来决斗吧！"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MINOTAURCHEST
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MINOTAURCHEST"
msgid "The conquest chest!"
msgstr "战利品宝箱！"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MINOTAURHORN
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MINOTAURHORN"
msgid "Can I add it to my helmet?"
msgstr "我能把它加到我的头盔上吗？"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MITEGLAND.COLD
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MITEGLAND.COLD"
msgid "It burns no more."
msgstr "它没再烧了。"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MITEGLAND.GENERIC
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MITEGLAND.GENERIC"
msgid "It holds the fire of Logi within it."
msgstr "其中藏有洛吉之焰。"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MITEGLAND_COOKED
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MITEGLAND_COOKED"
msgid "Roasted entrails."
msgstr "内脏烧烤。"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MOLE.ABOVEGROUND
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MOLE.ABOVEGROUND"
msgid "He burrows with reckless abandon."
msgstr "它随心所欲地到处挖洞。"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MOLE.HELD
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MOLE.HELD"
msgid "A friend for my pocket."
msgstr "可以装在口袋里的朋友。"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MOLE.UNDERGROUND
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MOLE.UNDERGROUND"
msgid "Who's under there?"
msgstr "谁在下面？"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MOLEBAT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MOLEBAT"
msgid "Have at thee, rodent!"
msgstr "放马过来吧，鼠辈！"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MOLEBATHILL
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MOLEBATHILL"
msgid "Your mucousy defenses will not deter me, morsel!"
msgstr "你们的粘液防御工事不会阻挡我的脚步，小肉肉！"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MOLEHAT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MOLEHAT"
msgid "It's best to use every part of the animal."
msgstr "最好是充分利用动物的每一部分。"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MOLEHILL
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MOLEHILL"
msgid "Something fiendish lives down there."
msgstr "有狡猾的东西住在那下面。"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MONKEY
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MONKEY"
msgid "I don't trust you."
msgstr "我不信任你。"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MONKEYBARREL
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MONKEYBARREL"
msgid "What horrors dwell within?"
msgstr "里面装着什么样的怪物？"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MONKEYHUT.BURNT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MONKEYHUT.BURNT"
msgid "Burned to the ground!"
msgstr "烧成了平地！"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MONKEYHUT.GENERIC
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MONKEYHUT.GENERIC"
msgid "Hark! We have found the raiders' fortress!"
msgstr "听着！我们已经找到了掠夺者的老巢。"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MONKEYISLAND_PORTAL
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MONKEYISLAND_PORTAL"
msgid "What strange magic is this? I cannot get through!"
msgstr "这是什么奇怪的魔法？我无法通过！"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MONKEYISLAND_PORTAL_DEBRIS
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MONKEYISLAND_PORTAL_DEBRIS"
msgid "It doth not seem to belong here."
msgstr "它似乎不属于这里。"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MONKEYPILLAR
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MONKEYPILLAR"
msgid "These trees did not grow from the earth."
msgstr "这些树不是从地里长出来的。"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MONKEYQUEEN
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MONKEYQUEEN"
msgid "Her eyes are cunning, she should not be underestimated."
msgstr "她的眼神十分狡猾，万万不可轻敌。"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MONKEYTAIL
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MONKEYTAIL"
msgid "Art thou plants or monkey parts? Make up thine mind!"
msgstr "汝是植物还是猴子的器官？想清楚点！"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MONKEY_MEDIUMHAT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MONKEY_MEDIUMHAT"
msgid "The helm of one who knows the sea."
msgstr "舵手之冠。"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MONKEY_SMALLHAT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MONKEY_SMALLHAT"
msgid "It still smells of monkey."
msgstr "还能闻到猴子的臭味。"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MONSTERLASAGNA
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MONSTERLASAGNA"
msgid "Monster casserole."
msgstr "怪兽炖菜。"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MONSTERMEAT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MONSTERMEAT"
msgid "Meat of the dark beasts."
msgstr "黑暗野兽的肉。"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MONSTERMEAT_DRIED
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MONSTERMEAT_DRIED"
msgid "All dried up."
msgstr "全部干了。"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MONSTERTARTARE
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MONSTERTARTARE"
msgid "Still quivering."
msgstr "肉还在颤动。"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MOONBASE.BROKEN
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MOONBASE.BROKEN"
msgid "Perhaps it crashed from the heavens."
msgstr "可能它是从天空掉落下来的。"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MOONBASE.GENERIC
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MOONBASE.GENERIC"
msgid "What dost thou want, altar?"
msgstr "你想要什么呢，祭坛？"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MOONBASE.MOONSTAFF
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MOONBASE.MOONSTAFF"
msgid "It feeds from the power of Mani!"
msgstr "它以玛尼的力量为食！"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MOONBASE.STAFFED
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MOONBASE.STAFFED"
msgid "Prepare for glorious battle!"
msgstr "可能是为了光荣的战斗！"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MOONBASE.WRONGSTAFF
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MOONBASE.WRONGSTAFF"
msgid "This shall not please the gods."
msgstr "这不会让诸神开心。"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MOONBUTTERFLY.GENERIC
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MOONBUTTERFLY.GENERIC"
msgid "Tis light as a feather on the breeze!"
msgstr "轻如鸿毛！"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MOONBUTTERFLY.HELD
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MOONBUTTERFLY.HELD"
msgid "It is my ward, now."
msgstr "它现在是我的守卫了。"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MOONBUTTERFLYWINGS
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MOONBUTTERFLYWINGS"
msgid "Fare thee well, little moth."
msgstr "再见了，小蛾子。"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MOONBUTTERFLY_SAPLING
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MOONBUTTERFLY_SAPLING"
msgid "Tis but a small tree."
msgstr "不过是一颗小树。"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MOONDIAL.CAVE
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MOONDIAL.CAVE"
msgid "Mani cannot see us here."
msgstr "在这里玛尼看不见我们。"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MOONDIAL.GENERIC
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MOONDIAL.GENERIC"
msgid "Mani's visage remains, even in the light of day."
msgstr "即使是在日光之下，玛尼的模样也不变。"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MOONDIAL.GLASSED
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MOONDIAL.GLASSED"
msgid "By the gods! The water hath turned to solid glass!"
msgstr "诸神啊！水已经变成了固体玻璃！"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MOONDIAL.NIGHT_FULL
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MOONDIAL.NIGHT_FULL"
msgid "Mani claims the skies!"
msgstr "玛尼赢得了天空！"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MOONDIAL.NIGHT_NEW
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MOONDIAL.NIGHT_NEW"
msgid "Mani's retired to his realm for the eve."
msgstr "玛尼退回到了傍晚的王国。"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MOONDIAL.NIGHT_WANE
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MOONDIAL.NIGHT_WANE"
msgid "Mani's power is on the wane."
msgstr "玛尼的力量正在逐渐衰弱。"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MOONDIAL.NIGHT_WAX
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MOONDIAL.NIGHT_WAX"
msgid "Mani's power grows!"
msgstr "玛尼的力量增加了！"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MOONGLASS
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MOONGLASS"
msgid "Tis a most divine substance."
msgstr "是种神圣的物质。"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MOONGLASSAXE
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MOONGLASSAXE"
msgid "Spirits of the woods stand no chance against me."
msgstr "森林之魂无法反抗我了。"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MOONGLASS_CHARGED
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MOONGLASS_CHARGED"
msgid "Tis lit by a strange power."
msgstr "它被一种奇怪的力量所照亮。"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MOONGLASS_ROCK
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MOONGLASS_ROCK"
msgid "Mani sent it down himself."
msgstr "玛尼亲自送下来的。"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MOONGLASS_WOBSTER_DEN
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MOONGLASS_WOBSTER_DEN"
msgid "That must be their fortress."
msgstr "那一定是它们的堡垒。"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MOONROCKCRATER
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MOONROCKCRATER"
msgid "Mani's gift may have some use yet!"
msgstr "玛尼的礼物可能还有些用处！"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MOONROCKIDOL
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MOONROCKIDOL"
msgid "I shall make an offering!"
msgstr "我要献供!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MOONROCKNUGGET
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MOONROCKNUGGET"
msgid "A gift from Mani."
msgstr "来自玛尼的礼物。"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MOONROCKSEED
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MOONROCKSEED"
msgid "It hath knowledge within!"
msgstr "内有知识！"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MOONROCK_PIECES
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MOONROCK_PIECES"
msgid "It has faced Mani's wrath."
msgstr "它已经面对了玛尼的暴怒。"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MOONSPIDERDEN
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MOONSPIDERDEN"
msgid "I sense battle on the horizon."
msgstr "我能感觉到战斗即将到来。"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MOONSTORM_GLASS.GENERIC
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MOONSTORM_GLASS.GENERIC"
msgid "The power hath faded from it."
msgstr "那股力量已经从它身上褪去。"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MOONSTORM_GLASS.INFUSED
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MOONSTORM_GLASS.INFUSED"
msgid "It hath been imbued with a strange power."
msgstr "它被赋予了一种不同寻常的力量。"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MOONSTORM_GOGGLESHAT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MOONSTORM_GOGGLESHAT"
msgid "No mere storm can stop me!"
msgstr "什么样的风暴都不能阻止我！"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MOONSTORM_SPARK
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MOONSTORM_SPARK"
msgid "It sends a curious tickle through my bones."
msgstr "它让我的骨头都痒痒的。"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MOONSTORM_STATIC
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MOONSTORM_STATIC"
msgid "Tis a strange kind of power."
msgstr "这是一种奇怪的力量。"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MOONSTORM_STATIC_CATCHER
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MOONSTORM_STATIC_CATCHER"
msgid "'Tis empty."
msgstr "空无一物。"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MOONSTORM_STATIC_ITEM
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MOONSTORM_STATIC_ITEM"
msgid "A strange power rests inside."
msgstr "里面有一种奇异的力量在休眠。"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MOONSTORM_STATIC_ROAMER
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MOONSTORM_STATIC_ROAMER"
msgid "The power roams free."
msgstr "能量在随处游荡。"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MOON_ALTAR.GENERIC
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MOON_ALTAR.GENERIC"
msgid "Tis a direct line to Mani himself!"
msgstr "直达玛尼本人的月神热线！"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MOON_ALTAR.MOON_ALTAR_WIP
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MOON_ALTAR.MOON_ALTAR_WIP"
msgid "You shall soon be complete once more."
msgstr "你马上就能再次完整了。"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MOON_ALTAR_ASTRAL
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MOON_ALTAR_ASTRAL"
msgid "I hear the whispers of Mani."
msgstr "我听到了玛尼的低语。"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MOON_ALTAR_COSMIC
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MOON_ALTAR_COSMIC"
msgid "It is grateful, but my work is not yet done."
msgstr "优雅动人，但是我还有工作要做。"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MOON_ALTAR_CROWN
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MOON_ALTAR_CROWN"
msgid "I wonder how that creature got his claws on this?"
msgstr "不知道那个生物是怎么拿到这个的？"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MOON_ALTAR_GLASS
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MOON_ALTAR_GLASS"
msgid "What doth thou want, fair jewel?"
msgstr "美丽的珠宝，汝意欲何为？"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MOON_ALTAR_ICON
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MOON_ALTAR_ICON"
msgid "It calls out to me, I must take heed."
msgstr "它在召唤我，我必须响应它的召唤。"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MOON_ALTAR_IDOL
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MOON_ALTAR_IDOL"
msgid "Make thy will known to me, idol!"
msgstr "神像啊，倾诉你的意志吧！"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MOON_ALTAR_LINK
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MOON_ALTAR_LINK"
msgid "What have we summoned forth?"
msgstr "我们召唤出了什么？"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MOON_ALTAR_ROCK_GLASS
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MOON_ALTAR_ROCK_GLASS"
msgid "The gods call me to it, I shall not resist."
msgstr "诸神召唤我于此，我不会忤逆。"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MOON_ALTAR_ROCK_IDOL
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MOON_ALTAR_ROCK_IDOL"
msgid "The gods call me to it, I shall not resist."
msgstr "诸神召唤我于此，我不会忤逆。"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MOON_ALTAR_ROCK_SEED
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MOON_ALTAR_ROCK_SEED"
msgid "The gods call me to it, I shall not resist."
msgstr "诸神召唤我于此，我不会忤逆。"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MOON_ALTAR_SEED
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MOON_ALTAR_SEED"
msgid "The gods commune to me through thee."
msgstr "诸神通过汝与吾交谈。"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MOON_ALTAR_WARD
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MOON_ALTAR_WARD"
msgid "It has chosen me to safeguard its passage home."
msgstr "它选中了我来包围它回家的路。"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MOON_CAP
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MOON_CAP"
msgid "Despicable non-meat!"
msgstr "卑鄙的非肉！"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MOON_CAP_COOKED
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MOON_CAP_COOKED"
msgid "Such a thing will never pass my lips!"
msgstr "这种的东西绝不能通过我的嘴唇！"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MOON_DEVICE.CONSTRUCTION1
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MOON_DEVICE.CONSTRUCTION1"
msgid "I know not its purpose. A tribute to Mani, perhaps?"
msgstr "我摸不清它的目的。也许为了供奉玛尼？"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MOON_DEVICE.CONSTRUCTION2
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MOON_DEVICE.CONSTRUCTION2"
msgid "The more I build, the stranger it appears."
msgstr "我越是建造，它越是显得离奇。"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MOON_DEVICE.GENERIC
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MOON_DEVICE.GENERIC"
msgid "Mere mortals were not meant to tamper so with the power of the gods..."
msgstr "小小凡人怎敢如此亵渎神的力量……"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MOON_FISSURE.GENERIC
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MOON_FISSURE.GENERIC"
msgid "An eternal light shines from within!"
msgstr "从里面照出一道永恒之光！"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MOON_FISSURE.NOLIGHT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MOON_FISSURE.NOLIGHT"
msgid "But a crack in the earth."
msgstr "不过是地上的一道裂缝。"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MOON_FISSURE_PLUGGED
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MOON_FISSURE_PLUGGED"
msgid "The old crone has been waging war against the moon's apparitions."
msgstr "丑老太婆一直在跟月光的幻影开战。"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MOON_TREE.BURNING
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MOON_TREE.BURNING"
msgid "Tis consumed by flame!"
msgstr "被烈火吞噬了！"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MOON_TREE.BURNT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MOON_TREE.BURNT"
msgid "This tree, 'twas burnt to the ground."
msgstr "烈火把树烧倒了。"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MOON_TREE.CHOPPED
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MOON_TREE.CHOPPED"
msgid "Chopped by the warrior of the woods!"
msgstr "被森林中的勇士所砍倒！"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MOON_TREE.GENERIC
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MOON_TREE.GENERIC"
msgid "Tis lovely as Yggdrasil's picture in my mind."
msgstr "如同我脑海中的世界树一样可爱动人。"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MOON_TREE_BLOSSOM
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MOON_TREE_BLOSSOM"
msgid "Tis most beauteous in the moonlight."
msgstr "在皎洁月光下最为动人。"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MOON_TREE_BLOSSOM_DRIED
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MOON_TREE_BLOSSOM_DRIED"
msgid "T'would make a most worthy offering to the gods!"
msgstr "堪为敬奉诸神的顶级供品！"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MOOSE
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MOOSE"
msgid "I wish I could ride it into battle."
msgstr "我希望我能骑着它去战斗。"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MOOSEEGG
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MOOSEEGG"
msgid "Something is bouncing around inside."
msgstr "有东西在里面弹来弹去。"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MOOSE_NESTING_GROUND
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MOOSE_NESTING_GROUND"
msgid "A nest of adorable villainy."
msgstr "一窝可爱的乌合之众。"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MOQUECA
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MOQUECA"
msgid "A treat for mine senses!"
msgstr "感官盛宴！"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MOSQUITO.GENERIC
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MOSQUITO.GENERIC"
msgid "Ugh! These things are useless!"
msgstr "嗷！这些东西一无所用！"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MOSQUITO.HELD
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MOSQUITO.HELD"
msgid "Settle demon fury!"
msgstr "承受我的怒火吧！"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MOSQUITOBOMB
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MOSQUITOBOMB"
msgid "There is little honor in using such a weapon, yet I am intrigued."
msgstr "尽管这样的武器并不光彩，但我仍然很感兴趣。"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MOSQUITOFERTILIZER
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MOSQUITOFERTILIZER"
msgid "Leave it for the farmers."
msgstr "把它留给农民吧。"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MOSQUITOMERMSALVE
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MOSQUITOMERMSALVE"
msgid "'Tis the mark of a noble leader to care for her warriors so."
msgstr "如此关爱战士，是高贵领袖的标志。"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MOSQUITOMUSK
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MOSQUITOMUSK"
msgid "'Tis rather useful for a foul little doll."
msgstr "这小臭布偶还怪有用的。"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MOSQUITOSACK
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MOSQUITOSACK"
msgid "The blood will make me strong."
msgstr "血将使我强大。"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MOSSLING
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MOSSLING"
msgid "You are not large enough to be a steed."
msgstr "你还不够大，当不了坐骑。"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MOUND.DUG
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MOUND.DUG"
msgid "Loot trumped desecration!"
msgstr "洗劫就是亵渎！"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MOUND.GENERIC
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MOUND.GENERIC"
msgid "Are there treasures beneath the gravestones?"
msgstr "墓碑下面有宝藏吗？"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MULLEDDRINK
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MULLEDDRINK"
msgid "Ha ha! Another!"
msgstr "哈哈！再来一杯！"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MULTIPLAYER_PORTAL
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MULTIPLAYER_PORTAL"
msgid "It makes me long for the stage!"
msgstr "它让我渴望舞台！"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MULTIPLAYER_PORTAL_MOONROCK
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MULTIPLAYER_PORTAL_MOONROCK"
msgid "It hath a glow about it."
msgstr "它熠熠生辉。"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MULTITOOL_AXE_PICKAXE
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MULTITOOL_AXE_PICKAXE"
msgid "A warrior's tool!"
msgstr "战士的工具！"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MUSHGNOME
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MUSHGNOME"
msgid "Foul vegetable, you will taste my spear!"
msgstr "肮脏的蔬菜，你会尝到我长矛的厉害！"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MUSHROOMBOMB
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MUSHROOMBOMB"
msgid "Defend thyselves, my allies!"
msgstr "保护好自己，我的盟友们！"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MUSHROOMHAT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MUSHROOMHAT"
msgid "This helm runs flush with the forest's magic!"
msgstr "这个舵柄在森林魔法的帮助下运行得很顺利！"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MUSHROOMSPROUT.BURNT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MUSHROOMSPROUT.BURNT"
msgid "Naught but ash."
msgstr "一无是处，除了变成灰。"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MUSHROOMSPROUT.GENERIC
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MUSHROOMSPROUT.GENERIC"
msgid "Destroy the source of its unholy power!"
msgstr "毁坏不洁之力的来源！"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MUSHROOM_FARM.BURNT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MUSHROOM_FARM.BURNT"
msgid "'Twas consumed by a mighty inferno!"
msgstr "它在熊熊烈火中化为乌有！"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MUSHROOM_FARM.EMPTY
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MUSHROOM_FARM.EMPTY"
msgid "An empty home for forest sprites."
msgstr "森林精灵们空空如也的家。"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MUSHROOM_FARM.LOTS
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MUSHROOM_FARM.LOTS"
msgid "It is growing strong and hearty."
msgstr "它成长得很健壮。"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MUSHROOM_FARM.ROTTEN
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MUSHROOM_FARM.ROTTEN"
msgid "A blight has beset this log. Another!"
msgstr "枯萎病袭击了这块木头。又一块木头！"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MUSHROOM_FARM.SNOWCOVERED
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MUSHROOM_FARM.SNOWCOVERED"
msgid "Not all can withstand the frost giant's touch."
msgstr "不是所有人都能抵挡得住森林巨人的触摸。"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MUSHROOM_FARM.SOME
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MUSHROOM_FARM.SOME"
msgid "The forest sprite has taken root."
msgstr "森林精灵已经生根发芽了。"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MUSHROOM_FARM.STUFFED
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MUSHROOM_FARM.STUFFED"
msgid "The forest sprite has returned a glorious bounty!"
msgstr "森林精灵送回了可观的礼物！"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MUSHROOM_LIGHT.BURNT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MUSHROOM_LIGHT.BURNT"
msgid "Laid to waste."
msgstr "糟蹋。"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MUSHROOM_LIGHT.OFF
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MUSHROOM_LIGHT.OFF"
msgid "A gift from the earth."
msgstr "来自大地的礼物。"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MUSHROOM_LIGHT.ON
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MUSHROOM_LIGHT.ON"
msgid "Tis a spotted spotlight!"
msgstr "这是一个有斑点的聚光灯！"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MUSHROOM_LIGHT2.BURNT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MUSHROOM_LIGHT2.BURNT"
msgid "'Twas consumed by Hel's fire."
msgstr "它被赫尔火焰所消耗。"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MUSHROOM_LIGHT2.OFF
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MUSHROOM_LIGHT2.OFF"
msgid "I demand strong, passionate colors. Red!"
msgstr "我要求强烈热情的颜色。红色！"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MUSHROOM_LIGHT2.ON
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MUSHROOM_LIGHT2.ON"
msgid "Behold! It blazes bright!"
msgstr "看！它明亮地燃烧着！"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MUSHTREE_MEDIUM.ACIDCOVERED
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MUSHTREE_MEDIUM.ACIDCOVERED"
msgid "The smell fills me with loathing."
msgstr "这种气味让我满是厌恶。"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MUSHTREE_MEDIUM.BLOOM
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MUSHTREE_MEDIUM.BLOOM"
msgid "What a great effect!"
msgstr "好棒的效果！"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MUSHTREE_MEDIUM.GENERIC
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MUSHTREE_MEDIUM.GENERIC"
msgid "I do like its glow."
msgstr "我喜欢它发出的光。"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MUSHTREE_MOON
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MUSHTREE_MOON"
msgid "Strange magic indeed."
msgstr "果然是古怪的魔法。"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MUSHTREE_SMALL.ACIDCOVERED
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MUSHTREE_SMALL.ACIDCOVERED"
msgid "The smell fills me with loathing."
msgstr "这种气味让我满是厌恶。"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MUSHTREE_SMALL.BLOOM
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MUSHTREE_SMALL.BLOOM"
msgid "I'll fight alongside you any day!"
msgstr "我会一直在你身边共同战斗！"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MUSHTREE_SMALL.GENERIC
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MUSHTREE_SMALL.GENERIC"
msgid "I don't care for mushrooms."
msgstr "我不喜欢蘑菇。"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MUSHTREE_TALL.ACIDCOVERED
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MUSHTREE_TALL.ACIDCOVERED"
msgid "The smell fills me with loathing."
msgstr "这种气味让我满是厌恶。"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MUSHTREE_TALL.BLOOM
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MUSHTREE_TALL.BLOOM"
msgid "An enthusiastic performance!"
msgstr "充满激情的表演！"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MUSHTREE_TALL.GENERIC
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MUSHTREE_TALL.GENERIC"
msgid "What magic is this?"
msgstr "这是什么魔法？"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MUSHTREE_TALL_WEBBED.ACIDCOVERED
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MUSHTREE_TALL_WEBBED.ACIDCOVERED"
msgid "The smell fills me with loathing."
msgstr "这种气味让我满是厌恶。"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MUSHTREE_TALL_WEBBED.GENERIC
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MUSHTREE_TALL_WEBBED.GENERIC"
msgid "This mushroom needs to be retired."
msgstr "这蘑菇该退休了。"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MUTATEDBEARGER
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MUTATEDBEARGER"
msgid "The beast seeks vengeance!"
msgstr "野兽要报仇！"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MUTATEDBIRD
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MUTATEDBIRD"
msgid "'Tis cursed!"
msgstr "受诅之物！"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MUTATEDBUZZARD_GESTALT.EATING_CORPSE
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MUTATEDBUZZARD_GESTALT.EATING_CORPSE"
msgid "Curses! The dead devoureth the dead!"
msgstr "诅咒啊！亡者竟噬亡者！"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MUTATEDBUZZARD_GESTALT.GENERIC
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MUTATEDBUZZARD_GESTALT.GENERIC"
msgid "Thou art blasphemy made flesh!"
msgstr "汝乃亵渎所化之肉身！"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MUTATEDDEERCLOPS
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MUTATEDDEERCLOPS"
msgid "The beast hath been changed by strange magicks!"
msgstr "这只野兽被异魔法改变了！"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MUTATEDHOUND.DEAD
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MUTATEDHOUND.DEAD"
msgid "May you find rest."
msgstr "愿你安息。"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MUTATEDHOUND.GENERIC
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MUTATEDHOUND.GENERIC"
msgid "What infernal creature doth mine eyes see!"
msgstr "我的双眼看到了烈狱的生物！"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MUTATEDHOUND.SLEEPING
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MUTATEDHOUND.SLEEPING"
msgid "The beast slumbers soundly."
msgstr "猛兽在熟睡中。"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MUTATEDWARG
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MUTATEDWARG"
msgid "It is possessed by angry spirits!"
msgstr "它被愤怒的灵魂附体了！"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MUTATED_PENGUIN.DEAD
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MUTATED_PENGUIN.DEAD"
msgid "Rest well, wicked spirit."
msgstr "安息吧，恶灵。"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MUTATED_PENGUIN.GENERIC
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MUTATED_PENGUIN.GENERIC"
msgid "Hel's influence has corrupted thee, no doubt!"
msgstr "冥界无疑腐化了你！"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MUTATED_PENGUIN.SLEEPING
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MUTATED_PENGUIN.SLEEPING"
msgid "It slumbers soundly."
msgstr "它睡得真香。"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MUTATOR_DROPPER
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MUTATOR_DROPPER"
msgid "They look like the little beasts, but lack the ferocity."
msgstr "它们虽然看起来像小野兽，但却缺少了它们的凶猛。"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MUTATOR_HEALER
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MUTATOR_HEALER"
msgid "They look like the little beasts, but lack the ferocity."
msgstr "它们虽然看起来像小野兽，但却缺少了它们的凶猛。"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MUTATOR_HIDER
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MUTATOR_HIDER"
msgid "They look like the little beasts, but lack the ferocity."
msgstr "它们虽然看起来像小野兽，但却缺少了它们的凶猛。"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MUTATOR_MOON
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MUTATOR_MOON"
msgid "They look like the little beasts, but lack the ferocity."
msgstr "它们虽然看起来像小野兽，但却缺少了它们的凶猛。"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MUTATOR_SPITTER
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MUTATOR_SPITTER"
msgid "They look like the little beasts, but lack the ferocity."
msgstr "它们虽然看起来像小野兽，但却缺少了它们的凶猛。"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MUTATOR_WARRIOR
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MUTATOR_WARRIOR"
msgid "They look like the little beasts, but lack the ferocity."
msgstr "它们虽然看起来像小野兽，但却缺少了它们的凶猛。"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MUTATOR_WATER
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.MUTATOR_WATER"
msgid "They look like the little beasts, but lack the ferocity."
msgstr "它们虽然看起来像小野兽，但却缺少了它们的凶猛。"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.NATURE_BLUEPRINT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.NATURE_BLUEPRINT"
msgid "Flowers won't protect you in battle!"
msgstr "鲜花在战场上是保护不了你的!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.NIGHTCAPHAT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.NIGHTCAPHAT"
msgid "Prepare for slumber!"
msgstr "准备沉睡！"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.NIGHTLIGHT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.NIGHTLIGHT"
msgid "I'm more comfortable around my own fire."
msgstr "还是在我自己的火旁更自在一些。"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.NIGHTMAREFUEL
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.NIGHTMAREFUEL"
msgid "The fuel of darkness!"
msgstr "暗黑燃料！"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.NIGHTMAREGROWTH
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.NIGHTMAREGROWTH"
msgid "The very ground hath split and released nightmares upon us!"
msgstr "大地裂开了，向我们释放了梦魇！"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.NIGHTMARELIGHT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.NIGHTMARELIGHT"
msgid "It harnesses dark powers from beneath."
msgstr "它利用来自地下的黑暗能量。"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.NIGHTMAREPIE
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.NIGHTMAREPIE"
msgid "I am wary of this pie."
msgstr "我要警惕这块饼。"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.NIGHTMARE_TIMEPIECE.CALM
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.NIGHTMARE_TIMEPIECE.CALM"
msgid "Nothing stirs."
msgstr "没有动静。"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.NIGHTMARE_TIMEPIECE.DAWN
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.NIGHTMARE_TIMEPIECE.DAWN"
msgid "Barely any magic remains."
msgstr "几乎没剩下任何魔力。"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.NIGHTMARE_TIMEPIECE.NOMAGIC
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.NIGHTMARE_TIMEPIECE.NOMAGIC"
msgid "The magic slumbers far from here."
msgstr "魔力在远方沉睡。"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.NIGHTMARE_TIMEPIECE.STEADY
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.NIGHTMARE_TIMEPIECE.STEADY"
msgid "The magic power holds steady."
msgstr "魔力水平保持稳定。"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.NIGHTMARE_TIMEPIECE.WANING
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.NIGHTMARE_TIMEPIECE.WANING"
msgid "It's starting to retreat!"
msgstr "它开始撤退了！"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.NIGHTMARE_TIMEPIECE.WARN
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.NIGHTMARE_TIMEPIECE.WARN"
msgid "It's starting..."
msgstr "开始了..."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.NIGHTMARE_TIMEPIECE.WAXING
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.NIGHTMARE_TIMEPIECE.WAXING"
msgid "The magic is heightening!"
msgstr "魔力正在变强！"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.NIGHTSTICK
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.NIGHTSTICK"
msgid "A weapon worthy of Thor."
msgstr "一把配得上索尔的武器。"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.NIGHTSWORD
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.NIGHTSWORD"
msgid "It takes a brave warrior to wield this sword."
msgstr "只有勇敢的战士才能运用这件武器。"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.NITRE
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.NITRE"
msgid "It contains explosive components."
msgstr "它包含易爆成分。"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.NITRE_FORMATION
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.NITRE_FORMATION"
msgid "A boon from the burning rain."
msgstr "灼烧雨水带来的恩赐。"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.NONSLIPGRIT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.NONSLIPGRIT"
msgid "With this, my grip shan't falter!"
msgstr "有此在手，吾之握持必不松懈！"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.NONSLIPGRITBOOSTED
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.NONSLIPGRITBOOSTED"
msgid "Cast it upon the ground, and thine footing shall be true."
msgstr "将其撒于地面，汝之步履必将稳健。"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.NUTRIENTSGOGGLESHAT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.NUTRIENTSGOGGLESHAT"
msgid "I care not for learning about that which sprouts from the dirt."
msgstr "我才不想知道泥土里会钻出什么来。"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.OAR
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.OAR"
msgid "The Norseman's way to sail!"
msgstr "北欧人的航海术！"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.OAR_DRIFTWOOD
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.OAR_DRIFTWOOD"
msgid "Back to the sea!"
msgstr "重归大海！"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.OAR_MONKEY
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.OAR_MONKEY"
msgid "In a true warrior's hands, anything might be a weapon."
msgstr "在一个真正的战士手中，任何东西都能成为武器。"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.OASISLAKE.EMPTY
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.OASISLAKE.EMPTY"
msgid "Naught but a barren basin."
msgstr "只剩一个贫瘠的盆地。"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.OASISLAKE.GENERIC
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.OASISLAKE.GENERIC"
msgid "Perhaps a sword-wielding maiden lies beneath."
msgstr "或许下面躺着一个挥刀的少女。"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.OCEANFISHABLEFLOTSAM
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.OCEANFISHABLEFLOTSAM"
msgid "Tis naught but a clump of mud and grass!"
msgstr "就是一坨泥土跟草！"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.OCEANFISHINGBOBBER_BALL
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.OCEANFISHINGBOBBER_BALL"
msgid "My keen hunter's eyes can detect the smallest nibble!"
msgstr "我锐利的猎手之眼能察觉最轻微的咬钩！"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.OCEANFISHINGBOBBER_CANARY
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.OCEANFISHINGBOBBER_CANARY"
msgid "Fly straight and true!"
msgstr "展翅高飞吧！"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.OCEANFISHINGBOBBER_CROW
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.OCEANFISHINGBOBBER_CROW"
msgid "Fly straight and true!"
msgstr "展翅高飞吧！"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.OCEANFISHINGBOBBER_GOOSE
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.OCEANFISHINGBOBBER_GOOSE"
msgid "Njord, guide my line!"
msgstr "尼约德，指引我的鱼线吧！"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.OCEANFISHINGBOBBER_MALBATROSS
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.OCEANFISHINGBOBBER_MALBATROSS"
msgid "Njord, guide my line!"
msgstr "尼约德，指引我的鱼线吧！"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.OCEANFISHINGBOBBER_NONE
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.OCEANFISHINGBOBBER_NONE"
msgid "The line hath need of a float."
msgstr "鱼线需要浮漂支持。"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.OCEANFISHINGBOBBER_OVAL
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.OCEANFISHINGBOBBER_OVAL"
msgid "My keen hunter's eyes can detect the smallest nibble!"
msgstr "我锐利的猎手之眼能察觉最轻微的咬钩！"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.OCEANFISHINGBOBBER_ROBIN
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.OCEANFISHINGBOBBER_ROBIN"
msgid "Fly straight and true!"
msgstr "展翅高飞吧！"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.OCEANFISHINGBOBBER_ROBIN_WINTER
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.OCEANFISHINGBOBBER_ROBIN_WINTER"
msgid "Fly straight and true!"
msgstr "展翅高飞吧！"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.OCEANFISHINGLURE_HERMIT_DROWSY
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.OCEANFISHINGLURE_HERMIT_DROWSY"
msgid "It doth feel a bit like cheating..."
msgstr "感觉好像是在作弊……"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.OCEANFISHINGLURE_HERMIT_HEAVY
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.OCEANFISHINGLURE_HERMIT_HEAVY"
msgid "Only the greatest of fish will dare take a bite!"
msgstr "只有最大的鱼才敢咬！"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.OCEANFISHINGLURE_HERMIT_RAIN
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.OCEANFISHINGLURE_HERMIT_RAIN"
msgid "The old crone has enchanted it to work best in the rain."
msgstr "丑老太婆给它附过魔，在雨天最有用。"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.OCEANFISHINGLURE_HERMIT_SNOW
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.OCEANFISHINGLURE_HERMIT_SNOW"
msgid "The old crone has enchanted it to work best in the snow."
msgstr "丑老太婆给它附过魔，在雪天最有用。"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.OCEANFISHINGLURE_SPINNER_BLUE
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.OCEANFISHINGLURE_SPINNER_BLUE"
msgid "A cunning ruse, indeed."
msgstr "好一条狡诈的诡计。"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.OCEANFISHINGLURE_SPINNER_GREEN
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.OCEANFISHINGLURE_SPINNER_GREEN"
msgid "A cunning ruse, indeed."
msgstr "好一条狡诈的诡计。"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.OCEANFISHINGLURE_SPINNER_RED
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.OCEANFISHINGLURE_SPINNER_RED"
msgid "A cunning ruse, indeed."
msgstr "好一条狡诈的诡计。"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.OCEANFISHINGLURE_SPOON_BLUE
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.OCEANFISHINGLURE_SPOON_BLUE"
msgid "This should attract their attention!"
msgstr "应该会引起它们的注意！"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.OCEANFISHINGLURE_SPOON_GREEN
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.OCEANFISHINGLURE_SPOON_GREEN"
msgid "This should attract their attention!"
msgstr "应该会引起它们的注意！"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.OCEANFISHINGLURE_SPOON_RED
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.OCEANFISHINGLURE_SPOON_RED"
msgid "This should attract their attention!"
msgstr "应该会引起它们的注意！"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.OCEANFISHINGROD
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.OCEANFISHINGROD"
msgid "Tremble before me, creatures of the deep!"
msgstr "颤抖吧，深海的生物们！"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.OCEANFISH_MEDIUM_1
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.OCEANFISH_MEDIUM_1"
msgid "Meat is meat."
msgstr "肉就是肉。"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.OCEANFISH_MEDIUM_2
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.OCEANFISH_MEDIUM_2"
msgid "You will make a fine meal!"
msgstr "你能做成一道好菜！"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.OCEANFISH_MEDIUM_3
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.OCEANFISH_MEDIUM_3"
msgid "The beastie put up an admirable fight."
msgstr "野兽做了光荣的战斗。"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.OCEANFISH_MEDIUM_4
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.OCEANFISH_MEDIUM_4"
msgid "There's an air of ill luck around this one..."
msgstr "它散发出一种不祥……"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.OCEANFISH_MEDIUM_5
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.OCEANFISH_MEDIUM_5"
msgid "This looks suspiciously veggie-like."
msgstr "看起来非常像蔬菜。"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.OCEANFISH_MEDIUM_6
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.OCEANFISH_MEDIUM_6"
msgid "Your bad luck is my good fortune, beastie."
msgstr "你的厄运是我的好运，小野兽。"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.OCEANFISH_MEDIUM_7
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.OCEANFISH_MEDIUM_7"
msgid "Your bad luck is my good fortune, beastie."
msgstr "你的厄运是我的好运，小野兽。"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.OCEANFISH_MEDIUM_8
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.OCEANFISH_MEDIUM_8"
msgid "It must hail from the icy waters of Niflheim."
msgstr "它定是来自尼福尔海姆的寒冰之海。"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.OCEANFISH_MEDIUM_9
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.OCEANFISH_MEDIUM_9"
msgid "Are ye fish or fruit? My eyes hath been decieved before!"
msgstr "你们是鱼还是水果？我的眼睛曾被骗过！"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.OCEANFISH_SMALL_1
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.OCEANFISH_SMALL_1"
msgid "Tis barely a morsel!"
msgstr "一小口都不够！"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.OCEANFISH_SMALL_2
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.OCEANFISH_SMALL_2"
msgid "There's barely any meat on these fishbones!"
msgstr "鱼骨上基本都没肉！"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.OCEANFISH_SMALL_3
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.OCEANFISH_SMALL_3"
msgid "Tis only a wee beastie."
msgstr "就是个小野兽。"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.OCEANFISH_SMALL_4
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.OCEANFISH_SMALL_4"
msgid "This amount of meat will hardly satisfy a Viking!"
msgstr "这点肉根本满足不了维京人！"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.OCEANFISH_SMALL_5
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.OCEANFISH_SMALL_5"
msgid "Tis naught but a small snack."
msgstr "就是小吃。"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.OCEANFISH_SMALL_6
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.OCEANFISH_SMALL_6"
msgid "It is suspiciously leafy."
msgstr "叶子有些可疑。"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.OCEANFISH_SMALL_7
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.OCEANFISH_SMALL_7"
msgid "Are ye fish or flower?"
msgstr "你是鱼还是花？"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.OCEANFISH_SMALL_8
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.OCEANFISH_SMALL_8"
msgid "By Sól! It wields the power of the sun!"
msgstr "太阳神啊！它使用着太阳的能量！"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.OCEANFISH_SMALL_9
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.OCEANFISH_SMALL_9"
msgid "You dare spit at a Viking warrior?"
msgstr "你敢对一个维京战士吐口水？"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.OCEANTREE
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.OCEANTREE"
msgid "It hath been hardened by the sea."
msgstr "它被海洋硬化了。"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.OCEANTREENUT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.OCEANTREENUT"
msgid "May the roots of the worldtree spread far and wide!"
msgstr "愿世界树的根系触达得更远更广！"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.OCEANTREE_PILLAR
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.OCEANTREE_PILLAR"
msgid "Yon tree shall guard us from the treacherous sun."
msgstr "这棵树将保护我们不受奸诈的太阳的伤害。"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.OCEANVINE
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.OCEANVINE"
msgid "Ropes from the branches of Yggdrasil."
msgstr "世界树枝条抽出的绳索。"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.OCEANVINE_COCOON
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.OCEANVINE_COCOON"
msgid "The nest of the water walking beasts!"
msgstr "这是水面行走的野兽的巢穴！"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.OCEANVINE_COCOON_BURNT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.OCEANVINE_COCOON_BURNT"
msgid "'Twas consumed by flames."
msgstr "被火焰所吞噬了。"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.OCEANWHIRLBIGPORTALEXIT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.OCEANWHIRLBIGPORTALEXIT"
msgid "Sea spoils!"
msgstr "大海的战利品！"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.OCEANWHIRLPORTAL
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.OCEANWHIRLPORTAL"
msgid "Oh, beautiful maelström. Into thy hungry mouth we doth sail."
msgstr "啊，美丽的大漩涡。让我们驶入您饥饿的巨口吧。"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.OCEAN_TRAWLER.CAUGHT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.OCEAN_TRAWLER.CAUGHT"
msgid "Njord has bestowed his bounty upon us!"
msgstr "尼约德将他的恩惠赐予了我们！"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.OCEAN_TRAWLER.ESCAPED
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.OCEAN_TRAWLER.ESCAPED"
msgid "Fie! The sea-meat has evaded us!"
msgstr "呸！让海肉给逃走了！"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.OCEAN_TRAWLER.FIXED
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.OCEAN_TRAWLER.FIXED"
msgid "It is ready to hunt again."
msgstr "它已准备好再次狩猎。"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.OCEAN_TRAWLER.GENERIC
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.OCEAN_TRAWLER.GENERIC"
msgid "A harvester of sea-meat."
msgstr "海肉收割机。"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.OCEAN_TRAWLER.LOWERED
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.OCEAN_TRAWLER.LOWERED"
msgid "May you have a successful hunt."
msgstr "祝愿狩猎成功。"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.OCEAN_TRAWLER_KIT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.OCEAN_TRAWLER_KIT"
msgid "I hunger for sea-meat!"
msgstr "我渴望吃到海肉！"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.OFFERING_POT.GENERIC
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.OFFERING_POT.GENERIC"
msgid "The fish beasts hunger for that vile weed of the sea."
msgstr "鱼类猛兽渴求海中的可恶杂草。"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.OFFERING_POT.LOTS_OF_KELP
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.OFFERING_POT.LOTS_OF_KELP"
msgid "'Tis enough to gorge themselves to the gills!"
msgstr "足够它们把鳃帮子都吃撑了！"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.OFFERING_POT.SOME_KELP
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.OFFERING_POT.SOME_KELP"
msgid "More? They want more?!"
msgstr "还要？他们还要？"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.OFFERING_POT_UPGRADED.GENERIC
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.OFFERING_POT_UPGRADED.GENERIC"
msgid "The fish beasts hunger for that vile weed of the sea."
msgstr "鱼类猛兽渴求海中的可恶杂草。"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.OFFERING_POT_UPGRADED.LOTS_OF_KELP
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.OFFERING_POT_UPGRADED.LOTS_OF_KELP"
msgid "'Tis enough to gorge themselves to the gills!"
msgstr "足够它们把鳃帮子都吃撑了！"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.OFFERING_POT_UPGRADED.SOME_KELP
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.OFFERING_POT_UPGRADED.SOME_KELP"
msgid "More? They want more?!"
msgstr "还要？他们还要？"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.ONEMANBAND
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.ONEMANBAND"
msgid "Sing with me! We are the guardians of Asgard!"
msgstr "跟我一起唱！我们是神域的守护者！"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.ONION
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.ONION"
msgid "I dare thee, provoke tears from mine eyes!"
msgstr "有胆就让我流下眼泪！"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.ONION_COOKED
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.ONION_COOKED"
msgid "It has been vanquished with fire."
msgstr "被火焰征服了。"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.ONION_OVERSIZED
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.ONION_OVERSIZED"
msgid "You will draw no tears from my eyes on this day!"
msgstr "你今天不会从我的眼睛里榨出一滴泪水!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.ONION_SEEDS
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.ONION_SEEDS"
msgid "'Tis a handful of seeds, for not-meat."
msgstr "这一把种子，可以做成非肉类食物。"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.OPALPRECIOUSGEM
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.OPALPRECIOUSGEM"
msgid "The spoils of war!"
msgstr "战利品！"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.OPALSTAFF
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.OPALSTAFF"
msgid "It weaves the cold from thin air!"
msgstr "它从稀薄的空气编织出寒冷！"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.ORANGEAMULET
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.ORANGEAMULET"
msgid "Gathering has never been so easy."
msgstr "拾取物品从未如此简单。"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.ORANGEGEM
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.ORANGEGEM"
msgid "A stone of orange."
msgstr "橙色的石头。"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.ORANGEMOONEYE
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.ORANGEMOONEYE"
msgid "May Odin guide us."
msgstr "希望奥丁引导我们。"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.ORANGESTAFF
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.ORANGESTAFF"
msgid "A staff of magical movement."
msgstr "魔法瞬移手杖。"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.OTTER
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.OTTER"
msgid "A crafty pillager. I cannot help but respect it."
msgstr "一个狡猾的掠夺者。我不禁对它肃然起敬。"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.OTTERDEN.GENERIC
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.OTTERDEN.GENERIC"
msgid "Empty, alas."
msgstr "可惜是空的。"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.OTTERDEN.HAS_LOOT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.OTTERDEN.HAS_LOOT"
msgid "There is loot for the taking."
msgstr "有战利品可拿。"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.OTTERDEN_DEAD
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.OTTERDEN_DEAD"
msgid "Then sink, wretched raft! A Viking hath no fear of the sea!"
msgstr "尽管沉吧，该死的木筏！维京人不惧大海！"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.PALMCONETREE
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.PALMCONETREE"
msgid "It hath a most hardy exterior."
msgstr "它有着最坚韧的外壳。"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.PALMCONE_SAPLING
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.PALMCONE_SAPLING"
msgid "May you grow tall and strong."
msgstr "愿你长得又高又壮。"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.PALMCONE_SCALE
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.PALMCONE_SCALE"
msgid "A shard of tree armor."
msgstr "一块树甲的碎片。"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.PALMCONE_SEED
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.PALMCONE_SEED"
msgid "It must be returned to the earth."
msgstr "它必须回到大地。"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.PANDORASCHEST
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.PANDORASCHEST"
msgid "It contains a mystery."
msgstr "其中蘊含著一個謎。"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.PANETTONE
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.PANETTONE"
msgid "My eyes doth deceive me, tis surely meat."
msgstr "我的双眼必定蒙骗了我，这无疑是肉。"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.PANFLUTE
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.PANFLUTE"
msgid "I prefer to face my enemies awake."
msgstr "我更喜欢醒着对敌。"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.PAPYRUS
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.PAPYRUS"
msgid "May it carry forth the record of my saga."
msgstr "但愿它将我的事迹传颂。"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.PAVLOVA
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.PAVLOVA"
msgid "Once the berries hath been removed, tis a fine dessert indeed."
msgstr "拿掉浆果后，它就是一道精美甜点。"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.PEGHOOK
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.PEGHOOK"
msgid "You will be felled this day."
msgstr "今天你会被击倒。"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.PENGUIN
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.PENGUIN"
msgid "Birds of the sea, come from afar."
msgstr "大海中的鸟，从远方来。"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.PENGUINCORPSE.BURNING
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.PENGUINCORPSE.BURNING"
msgid "It shall not rise from these ashes."
msgstr "汝必于灰烬中泯灭，不得重生。"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.PENGUINCORPSE.GENERIC
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.PENGUINCORPSE.GENERIC"
msgid "A bad omen."
msgstr "此乃凶兆。"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.PENGUINCORPSE.REVIVING
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.PENGUINCORPSE.REVIVING"
msgid "Unnatural metamorphosis!"
msgstr "非自然的蜕生！"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.PEPPER
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.PEPPER"
msgid "Its mere presence offends me."
msgstr "光是这个样子就惹到我了。"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.PEPPERPOPPER
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.PEPPERPOPPER"
msgid "Back, vile vegetables!"
msgstr "退后，恶毒的蔬菜！"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.PEPPER_COOKED
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.PEPPER_COOKED"
msgid "It is not worthy of my consumption."
msgstr "不配我吃。"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.PEPPER_OVERSIZED
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.PEPPER_OVERSIZED"
msgid "You are the champion of the peppers, then?"
msgstr "那你就是辣椒界的冠军了？"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.PEPPER_SEEDS
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.PEPPER_SEEDS"
msgid "Smaller versions of vegetables still offend me."
msgstr "小个头的蔬菜还是会惹到我。"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.PERD
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.PERD"
msgid "You cannot run forever!"
msgstr "有本事就一直跑！"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.PERDFAN
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.PERDFAN"
msgid "Tis a fan for mine hand."
msgstr "一把手扇。"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.PERDSHRINE.BURNT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.PERDSHRINE.BURNT"
msgid "Laid to waste."
msgstr "糟蹋。"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.PERDSHRINE.EMPTY
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.PERDSHRINE.EMPTY"
msgid "We must give it the gift of life."
msgstr "我们得给它生命的馈赠。"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.PERDSHRINE.GENERIC
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.PERDSHRINE.GENERIC"
msgid "What treasures shall I bestow upon thee?"
msgstr "我应该授予你什么财宝呢？"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.PEROGIES
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.PEROGIES"
msgid "Pockets of meat."
msgstr "肉饺子。"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.PETALS
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.PETALS"
msgid "Thank you Froh for this gift!"
msgstr "感谢福神赐予的礼物！"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.PETALS_DRIED
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.PETALS_DRIED"
msgid "T'would make a most worthy offering to the gods!"
msgstr "堪为敬奉诸神的顶级供品！"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.PETALS_EVIL
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.PETALS_EVIL"
msgid "These were not made by Froh."
msgstr "这些不是福神创造的。"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.PETALS_EVIL_DRIED
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.PETALS_EVIL_DRIED"
msgid "T'would make a most worthy offering to the gods!"
msgstr "堪为敬奉诸神的顶级供品！"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.PETRIFIED_TREE
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.PETRIFIED_TREE"
msgid "My mere presence struck terror into their tree-hearts!"
msgstr "我一出现就让这些树胆战心惊！"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.PHLEGM
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.PHLEGM"
msgid "The secretions of a terrible beast!"
msgstr "可怕野兽的分泌物！"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.PHONOGRAPH
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.PHONOGRAPH"
msgid "A mechanical songstress."
msgstr "机械女歌手。"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.PICKAXE
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.PICKAXE"
msgid "A trusty tool for securing spear and helm materials."
msgstr "保护长矛和头盔的可靠工具。"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.PICKAXE_LUNARPLANT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.PICKAXE_LUNARPLANT"
msgid "Neither stone nor structure shall stand in my way!"
msgstr "管你是石头还是建筑，什么都别想拦住我！"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.PICKLEDHERRING
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.PICKLEDHERRING"
msgid "A briny taste of the sea!"
msgstr "有海水的咸味！"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.PIGELITE1
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.PIGELITE1"
msgid "The warrior spirit runs deep within him."
msgstr "战士的血液流淌在他的内心深处。"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.PIGELITE2
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.PIGELITE2"
msgid "He rages with berserker fury."
msgstr "他怒火中烧。"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.PIGELITE3
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.PIGELITE3"
msgid "He shall not soil mine warrior reputation!"
msgstr "他玷污不了我作为战士的名声！"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.PIGELITE4
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.PIGELITE4"
msgid "Hath the strength of Yggdrasil."
msgstr "拥有着世界树的力量。"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.PIGELITEFIGHTER1
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.PIGELITEFIGHTER1"
msgid "The warrior spirit runs deep within him."
msgstr "战士的血液流淌在他的内心深处。"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.PIGELITEFIGHTER2
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.PIGELITEFIGHTER2"
msgid "He rages with berserker fury."
msgstr "他怒火中烧。"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.PIGELITEFIGHTER3
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.PIGELITEFIGHTER3"
msgid "He shall not soil mine warrior reputation!"
msgstr "他玷污不了我作为战士的名声！"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.PIGELITEFIGHTER4
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.PIGELITEFIGHTER4"
msgid "Hath the strength of Yggdrasil."
msgstr "拥有着世界树的力量"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.PIGGUARD
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.PIGGUARD"
msgid "He is battle ready, I can tell."
msgstr "看得出来，他已经做好了战斗准备。"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.PIGGYBACK
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.PIGGYBACK"
msgid "The pig died with honor, then gave to me this pack."
msgstr "那只猪光荣战死，然后把这个背包给了我。"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.PIGHEAD.BURNT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.PIGHEAD.BURNT"
msgid "Normally I like a good roast, but this is not right."
msgstr "一般来说，我喜欢烤肉，但这是不对的。"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.PIGHEAD.GENERIC
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.PIGHEAD.GENERIC"
msgid "This is savagery."
msgstr "这太残暴了。"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.PIGHOUSE.BURNT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.PIGHOUSE.BURNT"
msgid "Loge did not smile upon you this day."
msgstr "罗格今天没有对你微笑。"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.PIGHOUSE.FULL
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.PIGHOUSE.FULL"
msgid "Come out and go to war with me!"
msgstr "出来和我一起去战斗吧！"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.PIGHOUSE.GENERIC
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.PIGHOUSE.GENERIC"
msgid "I did not think pigs could make houses."
msgstr "我原先不知道猪还能建房子。"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.PIGHOUSE.LIGHTSOUT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.PIGHOUSE.LIGHTSOUT"
msgid "Do you not hunger for battle, pig?"
msgstr "你不渴望战斗吗，猪兄？"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.PIGKING
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.PIGKING"
msgid "Is it pig-Odin?"
msgstr "那是猪中的奥丁吗？"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.PIGMAN.DEAD
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.PIGMAN.DEAD"
msgid "He died with honor."
msgstr "他光荣战死。"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.PIGMAN.FOLLOWER
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.PIGMAN.FOLLOWER"
msgid "We ride to battle!"
msgstr "奔赴沙场！"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.PIGMAN.GENERIC
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.PIGMAN.GENERIC"
msgid "Will you fight alongside me, pig?"
msgstr "你会和我并肩作战吗，猪兄？"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.PIGMAN.GUARD
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.PIGMAN.GUARD"
msgid "That pig looks brave."
msgstr "那只猪看上去很勇敢。"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.PIGMAN.WEREPIG
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.PIGMAN.WEREPIG"
msgid "It has been tainted by Fenrir."
msgstr "它被芬里厄腐化了。"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.PIGSHRINE.BURNT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.PIGSHRINE.BURNT"
msgid "Laid to waste."
msgstr "糟蹋。"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.PIGSHRINE.EMPTY
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.PIGSHRINE.EMPTY"
msgid "Like me, it hungers only for meat."
msgstr "和我一样，它只想吃肉。"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.PIGSHRINE.GENERIC
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.PIGSHRINE.GENERIC"
msgid "'Tis a tribute worthy of the Pig Gods."
msgstr "这是向猪神致以敬意。"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.PIGSKIN
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.PIGSKIN"
msgid "The hide of a pig creature."
msgstr "猪的皮。"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.PIGTENT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.PIGTENT"
msgid "It smells of breakfast!"
msgstr "闻起来像早餐的味道！"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.PIGTORCH
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.PIGTORCH"
msgid "Do these pigs worship Loge?"
msgstr "这些猪崇拜罗格吗？"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.PIG_COIN
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.PIG_COIN"
msgid "The king of pigs hath granted me this favor."
msgstr "猪王赠与了我这个人情。"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.PIG_TOKEN
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.PIG_TOKEN"
msgid "The belt of a mighty pig warrior."
msgstr "强大的猪战士的腰带。"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.PINECONE
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.PINECONE"
msgid "This baby tree is well protected by spiky armor."
msgstr "这颗树宝宝受到多刺盔甲的良好保护。"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.PINECONE_SAPLING
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.PINECONE_SAPLING"
msgid "It has shed its armor. Grow, baby tree!"
msgstr "它已经脱掉了盔甲。好好生长吧，小树苗！"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.PIRATE_FLAG_POLE
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.PIRATE_FLAG_POLE"
msgid "The banner of the monkey raiders!"
msgstr "猴子掠夺者的战旗！"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.PIRATE_STASH
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.PIRATE_STASH"
msgid "There lies the treasure!"
msgstr "宝藏就在那里！"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.PITCHFORK
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.PITCHFORK"
msgid "A weapon for farmers."
msgstr "农夫的武器。"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.PLANTMEAT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.PLANTMEAT"
msgid "I suppose it's close enough."
msgstr "我觉得它很接近了。"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.PLANTMEAT_COOKED
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.PLANTMEAT_COOKED"
msgid "Still green, but it'll do."
msgstr "还是绿色的，但行了。"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.PLANTREGISTRYHAT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.PLANTREGISTRYHAT"
msgid "This is no helm for a warrior!"
msgstr "这不是一个战士的头盔!"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.PLANT_NORMAL.GENERIC
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.PLANT_NORMAL.GENERIC"
msgid "A plant."
msgstr "一株植物。"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.PLANT_NORMAL.GROWING
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.PLANT_NORMAL.GROWING"
msgid "I am a shieldmaiden, not a farmer!"
msgstr "我是个女战士，不是农夫！"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.PLANT_NORMAL.READY
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.PLANT_NORMAL.READY"
msgid "Ugh, vegetables. I'm not sure what I expected..."
msgstr "呃，蔬菜。我不确定我期望什么..."

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.PLANT_NORMAL.WITHERED
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.PLANT_NORMAL.WITHERED"
msgid "Bested by the sun."
msgstr "给太阳打败了。"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.PLAYBILL_THE_DOLL
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.PLAYBILL_THE_DOLL"
msgid "I am not familiar with the playwright."
msgstr "我对该剧作家不熟悉。"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.PLAYBILL_THE_PRINCESS_YOTH
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.PLAYBILL_THE_PRINCESS_YOTH"
msgid "An epic tale of noble creatures."
msgstr "一篇记载了高贵生物的史诗。"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.PLAYBILL_THE_VAULT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.PLAYBILL_THE_VAULT"
msgid "A timeless tale."
msgstr "一个永恒的故事。"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.PLAYBILL_THE_VEIL
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.PLAYBILL_THE_VEIL"
msgid "Hmm. 'Tis avant-garde."
msgstr "呣。真是前卫。"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.PLAYER.ATTACKER
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.PLAYER.ATTACKER"
msgid "If %s is looking for trouble, I shall give it to them!"
msgstr "要是%s找麻烦，我就给他麻烦！"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.PLAYER.FIRESTARTER
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.PLAYER.FIRESTARTER"
msgid "Forged in flame!"
msgstr "在火焰中锻造！"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.PLAYER.GENERIC
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.PLAYER.GENERIC"
msgid "Good health to you, %s!"
msgstr "祝你健康，%s！"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.PLAYER.GHOST
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.PLAYER.GHOST"
msgid "%s's restless spirit could be revived with a heart."
msgstr "%s的不安精神可以用心恢复。"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.PLAYER.MURDERER
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.PLAYER.MURDERER"
msgid "Murderer! To battle!"
msgstr "你这个杀人凶手！战斗吧！"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.PLAYER.REVIVER
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.PLAYER.REVIVER"
msgid "Freya smiles on %s."
msgstr "芙蕾雅青睐%s。"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.PLAYER_HOSTED.GENERIC
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.PLAYER_HOSTED.GENERIC"
msgid "I shall take no pleasure in destroying you, friend."
msgstr "朋友，毁灭你不会为我带来乐趣。"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.PLAYER_HOSTED.ME
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.PLAYER_HOSTED.ME"
msgid "'Tis an abomination!"
msgstr "这简直就是罪恶！"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.PLAYING_CARD
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.PLAYING_CARD"
msgid "A wayward card."
msgstr "一张任性的牌。"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.POCKETWATCH_DISMANTLER
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.POCKETWATCH_DISMANTLER"
msgid "The tools of a craftswoman."
msgstr "女匠人的工具。"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.POCKETWATCH_HEAL.GENERIC
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.POCKETWATCH_HEAL.GENERIC"
msgid "A Viking warrior can tell the time by the position of the sun."
msgstr "维京勇士可以通过太阳的位置来判断时间。"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.POCKETWATCH_HEAL.RECHARGING
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.POCKETWATCH_HEAL.RECHARGING"
msgid "'Tis merely biding its time."
msgstr "它在伺机而动。"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.POCKETWATCH_PARTS
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.POCKETWATCH_PARTS"
msgid "Be this the work of dark magic?"
msgstr "这是黑魔法在作祟吗？"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.POCKETWATCH_PORTAL.GENERIC
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.POCKETWATCH_PORTAL.GENERIC"
msgid "A Viking warrior can tell the time by the position of the sun."
msgstr "维京勇士可以通过太阳的位置来判断时间。"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.POCKETWATCH_PORTAL.RECHARGING
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.POCKETWATCH_PORTAL.RECHARGING"
msgid "'Tis merely biding its time."
msgstr "它在伺机而动。"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.POCKETWATCH_PORTAL_ENTRANCE.DIFFERENTSHARD
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.POCKETWATCH_PORTAL_ENTRANCE.DIFFERENTSHARD"
msgid "Charge!!"
msgstr "冲锋！！"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.POCKETWATCH_PORTAL_ENTRANCE.GENERIC
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.POCKETWATCH_PORTAL_ENTRANCE.GENERIC"
msgid "Charge!!"
msgstr "冲锋！！"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.POCKETWATCH_PORTAL_EXIT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.POCKETWATCH_PORTAL_EXIT"
msgid "Be it up so high to test our landing prowess?"
msgstr "升这么高难道是为了测试我们的着陆能力？"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.POCKETWATCH_RECALL.GENERIC
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.POCKETWATCH_RECALL.GENERIC"
msgid "A Viking warrior can tell the time by the position of the sun."
msgstr "维京勇士可以通过太阳的位置来判断时间。"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.POCKETWATCH_RECALL.RECHARGING
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.POCKETWATCH_RECALL.RECHARGING"
msgid "'Tis merely biding its time."
msgstr "它在伺机而动。"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.POCKETWATCH_REVIVE.GENERIC
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.POCKETWATCH_REVIVE.GENERIC"
msgid "A Viking warrior can tell the time by the position of the sun."
msgstr "维京勇士可以通过太阳的位置来判断时间。"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.POCKETWATCH_REVIVE.RECHARGING
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.POCKETWATCH_REVIVE.RECHARGING"
msgid "'Tis merely biding its time."
msgstr "它在伺机而动。"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.POCKETWATCH_WARP.GENERIC
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.POCKETWATCH_WARP.GENERIC"
msgid "A Viking warrior can tell the time by the position of the sun."
msgstr "维京勇士可以通过太阳的位置来判断时间。"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.POCKETWATCH_WARP.RECHARGING
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.POCKETWATCH_WARP.RECHARGING"
msgid "'Tis merely biding its time."
msgstr "它在伺机而动。"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.POCKETWATCH_WEAPON.GENERIC
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.POCKETWATCH_WEAPON.GENERIC"
msgid "Aha! 'Tis not a time-teller, but a weapon in disguise!"
msgstr "啊哈！原来不是看时间的，而是伪装的武器！"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.POCKET_SCALE
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.POCKET_SCALE"
msgid "How did I fare with my catch?"
msgstr "我的战利品有多少？"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.POLISHCOOKIE
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.POLISHCOOKIE"
msgid "My nose shall not be deceived, these are surely meat!"
msgstr "我的鼻子错不了，这些必定是肉！"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.POLLY_ROGERS
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.POLLY_ROGERS"
msgid "She is a small, but stalwart ally."
msgstr "她个头虽小，但却是一名坚韧不拔的盟友。"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.POLLY_ROGERSHAT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.POLLY_ROGERSHAT"
msgid "I think it shall suit me well."
msgstr "我戴肯定合适。"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.POMEGRANATE
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.POMEGRANATE"
msgid "Fruity flesh."
msgstr "果肉。"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.POMEGRANATE_COOKED
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.POMEGRANATE_COOKED"
msgid "Seared fruit flesh."
msgstr "烧焦的果肉。"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.POMEGRANATE_OVERSIZED
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.POMEGRANATE_OVERSIZED"
msgid "Its great size impresses me naught."
msgstr "它的巨大尺寸一点都没有让我感到震撼。"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.POMEGRANATE_SEEDS
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.POMEGRANATE_SEEDS"
msgid "Tiny nature bits."
msgstr "微小的自然产物。"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.POND
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.POND"
msgid "Something lurks in the deep."
msgstr "有东西潜藏在深处。"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.PONDEEL
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.PONDEEL"
msgid "Delicious slimy snake fish."
msgstr "美味的黏滑蛇鱼。"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.PONDFISH
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.PONDFISH"
msgid "Pond meat!"
msgstr "池塘的肉！"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.POND_ALGAE
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.POND_ALGAE"
msgid "Ancient flora."
msgstr "古老的水藻。"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.POOP
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.POOP"
msgid "If only I could use it as camouflage from predators."
msgstr "要是我能用它进行伪装，躲避捕食者的侵袭就好了。"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.PORTABLEBLENDER_ITEM
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.PORTABLEBLENDER_ITEM"
msgid "It does battle with food."
msgstr "它跟食物战斗。"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.PORTABLECOOKPOT_ITEM.COOKING_LONG
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.PORTABLECOOKPOT_ITEM.COOKING_LONG"
msgid "My belly rumbles... make haste, cookpot!"
msgstr "我的肚皮在咕咕叫……麻利点，锅子！"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.PORTABLECOOKPOT_ITEM.COOKING_SHORT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.PORTABLECOOKPOT_ITEM.COOKING_SHORT"
msgid "This will be done swiftly!"
msgstr "马上就能完成！"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.PORTABLECOOKPOT_ITEM.DONE
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.PORTABLECOOKPOT_ITEM.DONE"
msgid "Is there meat to be consumed?"
msgstr "有肉吃吗？"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.PORTABLECOOKPOT_ITEM.EMPTY
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.PORTABLECOOKPOT_ITEM.EMPTY"
msgid "Not even a morsel left inside..."
msgstr "一口都没剩……"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.PORTABLECOOKPOT_ITEM.GENERIC
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.PORTABLECOOKPOT_ITEM.GENERIC"
msgid "Cooking, a noble profession."
msgstr "烹饪，高尚的职业。"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.PORTABLEFIREPIT_ITEM
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.PORTABLEFIREPIT_ITEM"
msgid "Prometheus himself would burn with envy!"
msgstr "连普罗米修斯都要嫉妒得冒火！"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.PORTABLESPICER_ITEM.DONE
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.PORTABLESPICER_ITEM.DONE"
msgid "Its task has come to an end."
msgstr "它的任务到头了。"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.PORTABLESPICER_ITEM.GENERIC
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.PORTABLESPICER_ITEM.GENERIC"
msgid "A formidable weapon against bad meals."
msgstr "对付难吃的菜的有力武器。"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.PORTABLETENT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.PORTABLETENT"
msgid "'Tis a finely made shelter indeed!"
msgstr "这的确是一个很好的庇护所！"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.PORTABLETENT_ITEM
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.PORTABLETENT_ITEM"
msgid "My talent lies in battle, not in building."
msgstr "我的天赋在于战斗，而不是建筑。"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.POTATO
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.POTATO"
msgid "Vileness emerged from the earth."
msgstr "从土地里钻出的卑劣之物。"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.POTATOSACK
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.POTATOSACK"
msgid "I have no use for a sack of non-meats."
msgstr "我要这袋非肉有何用。"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.POTATOSOUFFLE
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.POTATOSOUFFLE"
msgid "What treachery is this?"
msgstr "这是什么样的背叛？"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.POTATOTORNADO
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.POTATOTORNADO"
msgid "Blech."
msgstr "呕。"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.POTATO_COOKED
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.POTATO_COOKED"
msgid "It is of no use to me."
msgstr "它对我来说没有用处。"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.POTATO_OVERSIZED
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.POTATO_OVERSIZED"
msgid "An embarrassment of non-meat."
msgstr "非肉的尴尬。"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.POTATO_SEEDS
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.POTATO_SEEDS"
msgid "'Tis a handful of seeds, for not-meat."
msgstr "这一把种子，可以做成非肉类食物。"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.POTTEDFERN
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.POTTEDFERN"
msgid "What are you meant to do with such a thing?"
msgstr "这种东西你想用来做什么？"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.POWCAKE
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.POWCAKE"
msgid "What in the name of the unicorn is this?"
msgstr "这到底是什么鬼东西？"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.POWDER_MONKEY
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.POWDER_MONKEY"
msgid "Raiders! Attaaaaaack!!"
msgstr "是掠夺者！出击！！"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.PREMIUMWATERINGCAN.EMPTY
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.PREMIUMWATERINGCAN.EMPTY"
msgid "There is no water to be found within."
msgstr "里面没有水。"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.PREMIUMWATERINGCAN.GENERIC
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.PREMIUMWATERINGCAN.GENERIC"
msgid "Why must we coddle the plants thus?"
msgstr "为什么我们一定要这样溺爱植物呢？"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.PRIME_MATE
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.PRIME_MATE"
msgid "Art thou the captain of this ship? Then you shall go down with it!"
msgstr "你是这艘船的船长吗？那你就跟着船一起沉入海底吧！"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.PUFFIN.GENERIC
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.PUFFIN.GENERIC"
msgid "Cutest flying meat."
msgstr "最可爱的飞行肉！"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.PUFFIN.HELD
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.PUFFIN.HELD"
msgid "Thou art safe with me, sea meat."
msgstr "汝可安于吾处，海肉！"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.PUFFIN.SLEEPING
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.PUFFIN.SLEEPING"
msgid "Grabbest thy shut eye!"
msgstr "合眼睡会吧！"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.PUMPKIN
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.PUMPKIN"
msgid "It might make a good bludgeon, at least."
msgstr "至少可以用它给敌人来一记重击。"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.PUMPKINCARVER
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.PUMPKINCARVER"
msgid "A child's toy."
msgstr "孩童的玩具。"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.PUMPKINCOOKIE
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.PUMPKINCOOKIE"
msgid "Baked all the life out of it."
msgstr "所有的生命精华都被烤出来了。"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.PUMPKINHAT.GENERIC
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.PUMPKINHAT.GENERIC"
msgid "The trickster children shall tremble as I don this ghoulish helm!"
msgstr "当我戴上这恐怖头盔时，小捣蛋鬼们必将颤抖！"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.PUMPKINHAT.UNCARVED
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.PUMPKINHAT.UNCARVED"
msgid "This gourd doth lack a visage!"
msgstr "这南瓜缺张脸！"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.PUMPKINPIE
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.PUMPKINPIE"
msgid "Tis surely a delicious meat pie in disguise!"
msgstr "绝对是伪装的美味肉饼！"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.PUMPKIN_COOKED
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.PUMPKIN_COOKED"
msgid "Piping hot orange mush."
msgstr "橙色的热糊糊。"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.PUMPKIN_LANTERN
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.PUMPKIN_LANTERN"
msgid "Do you wish to fight, vegetable?"
msgstr "你想战斗吗，蔬菜？"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.PUMPKIN_OVERSIZED
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.PUMPKIN_OVERSIZED"
msgid "Quite formidable, for a vegetable."
msgstr "对于一个蔬菜来说，可以说相当厉害了。"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.PUMPKIN_SEEDS
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.PUMPKIN_SEEDS"
msgid "Tiny nature bits."
msgstr "微小的自然产物。"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.PUNCHINGBAG
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.PUNCHINGBAG"
msgid "Alas, 'tis not a very lively sparring partner."
msgstr "可惜啊，它不是一个十分活泼的训练伙伴。"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.PUREBRILLIANCE
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.PUREBRILLIANCE"
msgid "Like staring up into the spotlights..."
msgstr "仿佛仰望聚光灯一样……"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.PURPLEAMULET
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.PURPLEAMULET"
msgid "An amulet of dark powers."
msgstr "一块黑暗力量护符。"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.PURPLEGEM
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.PURPLEGEM"
msgid "It is clouded by a mysterious energy."
msgstr "它笼罩着神秘的能量。"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.PURPLEMOONEYE
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.PURPLEMOONEYE"
msgid "Odin's eye guides our path."
msgstr "奥丁的眼睛引导着我们的路。"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_ALTAR.FULL
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_ALTAR.FULL"
msgid "Accept my offering, oh mighty gods."
msgstr "伟大的诸神啊，请接收我供奉的祭品吧。"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_ALTAR.GENERIC
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_ALTAR.GENERIC"
msgid "The beast grows restless when tis not fed."
msgstr "那头野兽在没有吃饱的时候会变得焦躁不安。"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_ALTAR_BOLLARD
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_ALTAR_BOLLARD"
msgid "'Tis a post. Unworthy of mine attention."
msgstr "这是一根柱子，不值得我的关注。"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_ALTAR_IVY
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_ALTAR_IVY"
msgid "It climbeth the walls."
msgstr "它是爬墙高手。"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_ALTAR_QUEEN
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_ALTAR_QUEEN"
msgid "A colossal queen."
msgstr "巨大的女王。"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_ALTAR_STATUE1
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_ALTAR_STATUE1"
msgid "Servant of a terrible god."
msgstr "一个可怕神灵的仆人。"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_ALTAR_STATUE2
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_ALTAR_STATUE2"
msgid "'Tis dedicated to its god."
msgstr "献给它的神。"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_BEEFALO
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_BEEFALO"
msgid "Its days of war are past."
msgstr "它作战的日子已成往事。"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_BERRYBUSH
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_BERRYBUSH"
msgid "'Tis barren."
msgstr "它荒芜了。"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_BOWL_SILVER
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_BOWL_SILVER"
msgid "'Tis a fancy bowl."
msgstr "好一只精美的碗。"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_CARROT_SEEDS
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_CARROT_SEEDS"
msgid "'Tis a handful of seeds, for not-meat."
msgstr "这一把种子，可以做成非肉类食物。"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_CASSEROLEDISH
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_CASSEROLEDISH"
msgid "It will hold much meat."
msgstr "它能装下很多肉。"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_CASSEROLEDISH_SMALL
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_CASSEROLEDISH_SMALL"
msgid "A container for food."
msgstr "一个装食物的容器。"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_COIN1
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_COIN1"
msgid "Treasure!"
msgstr "宝藏！"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_COIN2
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_COIN2"
msgid "Coin! Prepare to be spent!"
msgstr "硬币！等着被花掉吧！"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_COIN3
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_COIN3"
msgid "Fortune is mine!"
msgstr "财富归我所有！"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_COIN4
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_COIN4"
msgid "I have earned the god's favor!"
msgstr "我赢得了神的青睐！"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_CRABMEAT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_CRABMEAT"
msgid "T'would be an honor to be fed to the sky god, beast."
msgstr "作为天空之神的供品，是你的荣耀。"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_CRABMEAT_COOKED
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_CRABMEAT_COOKED"
msgid "Tis a delicacy!"
msgstr "好一道珍馐美味！"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_CRABTRAP
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_CRABTRAP"
msgid "It doth trap sea-meat."
msgstr "它能诱捕海洋里的肉。"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_FERN
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_FERN"
msgid "Tis not food fit for a god."
msgstr "这不适合作为神的供品。"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_FLOUR
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_FLOUR"
msgid "The wheat hath fallen in battle."
msgstr "小麦已战死沙场。"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_FOLIAGE_COOKED
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_FOLIAGE_COOKED"
msgid "This is certain to anger the god."
msgstr "这肯定会激怒神。"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_FOOD.GENERIC
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_FOOD.GENERIC"
msgid "I shall offer it to the great god!"
msgstr "我会把它献给伟大的神灵！"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_FOOD.MATCH
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_FOOD.MATCH"
msgid "This shall quench the god's appetite."
msgstr "这会满足神的胃口。"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_FOOD.MATCH_BUT_SNACK
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_FOOD.MATCH_BUT_SNACK"
msgid "'Tis what the Gnaw desires, paltry though it is."
msgstr "这是饕餮想要的，尽管微不足道。"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_FOOD.MISMATCH
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_FOOD.MISMATCH"
msgid "The Gnaw desires... not this."
msgstr "饕餮想要的，不是它。"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_FOOD_BURNT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_FOOD_BURNT"
msgid "Consumed by Hel's fire."
msgstr "被赫尔之火吞噬。"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_GARLIC
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_GARLIC"
msgid "Foul ingredient for sacrificial foods!"
msgstr "祭品用的难闻配料！"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_GARLIC_COOKED
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_GARLIC_COOKED"
msgid "The stench!"
msgstr "一股难闻的味道！"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_GARLIC_SEEDS
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_GARLIC_SEEDS"
msgid "'Tis a handful of seeds, for not-meat."
msgstr "这一把种子，可以做成非肉类食物。"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_GOATKID
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_GOATKID"
msgid "Ah, the sweet innocence of youth."
msgstr "啊，美好、纯真的青春。"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_GOATMILK
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_GOATMILK"
msgid "It came from an animal, yet is still not meat!"
msgstr "来源于动物，却不是肉！"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_GOATMUM
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_GOATMUM"
msgid "A woman of good taste, like mineself!"
msgstr "和我一样，是有品味女士！"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_GRILL
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_GRILL"
msgid "It touches meat with the fires of Hel."
msgstr "用赫尔之火烤肉。"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_GRILL_ITEM
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_GRILL_ITEM"
msgid "An instrument of the savory."
msgstr "烹制美味的工具。"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_GRILL_SMALL
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_GRILL_SMALL"
msgid "It touches meat with the fires of Hel."
msgstr "用赫尔之火烤肉。"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_GRILL_SMALL_ITEM
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_GRILL_SMALL_ITEM"
msgid "It doth not work like this."
msgstr "它不是这样用的。"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_HOE
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_HOE"
msgid "Tis a farming weapon."
msgstr "这是农耕武器。"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_KEY
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_KEY"
msgid "'Tis the key to treasure!"
msgstr "这是开启宝藏的钥匙！"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_KEY_PARK
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_KEY_PARK"
msgid "Tis the key to Valhalla's gates."
msgstr "这是开启英灵殿大门的钥匙。"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_LAMP_POST
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_LAMP_POST"
msgid "Tis a magic light, surely."
msgstr "这肯定是一盏神灯。"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_LAMP_SHORT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_LAMP_SHORT"
msgid "'Tis a magic light of short stature."
msgstr "个头虽小，散发的是神奇之光。"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_MEALINGSTONE
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_MEALINGSTONE"
msgid "A weapon for wheat!"
msgstr "用来对付小麦的武器！"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_MERMHOUSE
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_MERMHOUSE"
msgid "What horrid home!"
msgstr "好可怕的房子！"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_MERM_CART1
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_MERM_CART1"
msgid "'Tis full of goods."
msgstr "它装满了好东西。"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_MERM_CART2
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_MERM_CART2"
msgid "'Tis full of goods."
msgstr "它装满了好东西。"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_MUSHROOMS
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_MUSHROOMS"
msgid "Non-meat, I shall not consume thee!"
msgstr "非肉类食物，我不吃你！"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_MUSHROOMSTUMP.GENERIC
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_MUSHROOMSTUMP.GENERIC"
msgid "Growing non-meat fungus."
msgstr "生长中的非肉类食用菌。"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_MUSHROOMSTUMP.PICKED
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_MUSHROOMSTUMP.PICKED"
msgid "'Tis vanquished."
msgstr "全没了。"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_ONION
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_ONION"
msgid "I dare thee, provoke tears from mine eyes!"
msgstr "有胆就让我流下眼泪！"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_ONION_COOKED
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_ONION_COOKED"
msgid "The gods shall deal with thee!"
msgstr "诸神会收拾你！"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_ONION_SEEDS
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_ONION_SEEDS"
msgid "'Tis a handful of seeds, for not-meat."
msgstr "这一把种子，可以做成非肉类食物。"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_OVEN
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_OVEN"
msgid "I shall cook things in thee!"
msgstr "我要用你烹饪食物！"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_OVEN_ITEM
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_OVEN_ITEM"
msgid "'Tis an instrument to vanquish food."
msgstr "这是用来对付食物的工具。"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_PARKSPIKE
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_PARKSPIKE"
msgid "'Tis a fencing spear."
msgstr "这是栅栏长矛。"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_PARK_ANGEL
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_PARK_ANGEL"
msgid "'Tis a Valkyrie."
msgstr "这是女武神瓦尔基里。"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_PARK_ANGEL2
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_PARK_ANGEL2"
msgid "'Tis a Valkyrie."
msgstr "这是女武神瓦尔基里。"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_PARK_FOUNTAIN
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_PARK_FOUNTAIN"
msgid "Water of life! But no water!"
msgstr "生命之水！但是没有水！"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_PARK_GATE.GENERIC
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_PARK_GATE.GENERIC"
msgid "Valhalla's gate is opened to me."
msgstr "英灵殿的大门向我敞开了。"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_PARK_GATE.LOCKED
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_PARK_GATE.LOCKED"
msgid "Thou shalt not keep me out!"
msgstr "你阻止不了我进入！"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_PARK_OBELISK
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_PARK_OBELISK"
msgid "'Tis a runestone."
msgstr "这是符文。"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_PARK_URN
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_PARK_URN"
msgid "Remnants of a Viking funeral."
msgstr "维京式葬礼的残留物。"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_PEBBLECRAB
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_PEBBLECRAB"
msgid "Thou cannot hide from me!"
msgstr "你躲不开我！"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_PIGEON.DEAD
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_PIGEON.DEAD"
msgid "Tis slain."
msgstr "它被灭掉了。"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_PIGEON.GENERIC
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_PIGEON.GENERIC"
msgid "Be you tasty?"
msgstr "你是不是很美味？"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_PIGEON.SLEEPING
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_PIGEON.SLEEPING"
msgid "It slumbers soundly."
msgstr "它睡得真香。"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_PLATE_SILVER
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_PLATE_SILVER"
msgid "'Tis a fancy plate."
msgstr "好一只精美的盘子。"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_POND_SALT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_POND_SALT"
msgid "Be it a hot spring?"
msgstr "这是温泉吗？"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_PORTAL
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_PORTAL"
msgid "Tis closed to us."
msgstr "它将我们拒之门外。"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_PORTAL_KEY
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_PORTAL_KEY"
msgid "'Tis the key to another world."
msgstr "这是通往另一个世界的钥匙。"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_POT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_POT"
msgid "Room for more meat!"
msgstr "有地方放更多肉了！"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_POTATO
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_POTATO"
msgid "Vileness emerged from the earth."
msgstr "从土地里钻出的卑劣之物。"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_POTATO_COOKED
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_POTATO_COOKED"
msgid "Useful only for sacrifice."
msgstr "只能当作祭品。"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_POTATO_SEEDS
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_POTATO_SEEDS"
msgid "'Tis a handful of seeds, for not-meat."
msgstr "这一把种子，可以做成非肉类食物。"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_POT_HANGER
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_POT_HANGER"
msgid "It hangeth pots."
msgstr "可以用它把锅挂起来。"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_POT_HANGER_ITEM
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_POT_HANGER_ITEM"
msgid "'Tis no use to me in this form."
msgstr "它这个样子对我没什么用。"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_POT_SMALL
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_POT_SMALL"
msgid "We shall fill thee with meat!"
msgstr "我们要用你来装肉！"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_POT_SYRUP
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_POT_SYRUP"
msgid "For the making of godly nectars!"
msgstr "用来制作神圣的花蜜！"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_ROTTEN_CROP
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_ROTTEN_CROP"
msgid "T'would never grace a hall in Valhalla."
msgstr "它绝对不配进入英灵殿的大厅。"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_RUBBLE_BIKE
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_RUBBLE_BIKE"
msgid "A felled metal steed."
msgstr "倒下的金属坐骑。"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_RUBBLE_CARRIAGE
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_RUBBLE_CARRIAGE"
msgid "'Twas pillaged long ago."
msgstr "它是很久以前掠夺来的。"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_RUBBLE_CATHEDRAL
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_RUBBLE_CATHEDRAL"
msgid "'Twas the site of a vicious raid."
msgstr "这里曾是一场激烈战斗的现场。"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_RUBBLE_CHIMNEY
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_RUBBLE_CHIMNEY"
msgid "It hath fallen."
msgstr "它倒下了。"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_RUBBLE_CHIMNEY2
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_RUBBLE_CHIMNEY2"
msgid "Nothing of value remains."
msgstr "没剩下有价值的东西。"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_RUBBLE_CLOCK
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_RUBBLE_CLOCK"
msgid "The time is nigh!"
msgstr "到时候了！"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_RUBBLE_CLOCKTOWER
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_RUBBLE_CLOCKTOWER"
msgid "The time is nigh!"
msgstr "到时候了！"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_RUBBLE_HOUSE.1
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_RUBBLE_HOUSE.1"
msgid "Pillaged. But by what?"
msgstr "被抢掠了。但是，是什么东西干的？"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_RUBBLE_HOUSE.2
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_RUBBLE_HOUSE.2"
msgid "If only they'd had a warrior to fight for them."
msgstr "如果有一名战士为他们而战，结果就不会是现在这个样子了。"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_RUBBLE_HOUSE.3
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_RUBBLE_HOUSE.3"
msgid "What foul being caused such destruction?"
msgstr "哪种恶魔造成了这样的毁灭？"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_RUBBLE_PUBDOOR
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_RUBBLE_PUBDOOR"
msgid "It once led to adventure. Alas, no more."
msgstr "它曾经带着人们历险。唉，俱往矣。"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_RUBBLE_ROOF
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_RUBBLE_ROOF"
msgid "It offers no sanctuary."
msgstr "它不能给你遮风挡雨。"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_SAFE.GENERIC
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_SAFE.GENERIC"
msgid "'Twas left by cities past."
msgstr "这是过去的城市留下来的。"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_SAFE.LOCKED
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_SAFE.LOCKED"
msgid "Tis sealed away from prying eyes and prying hands."
msgstr "它被封存起来，防止人们窥视和盗抢。"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_SALMON
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_SALMON"
msgid "Tis a most delicious fish!"
msgstr "这是最美味的鱼！"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_SALMON_COOKED
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_SALMON_COOKED"
msgid "A feast from the sea."
msgstr "来自海洋的盛宴。"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_SALT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_SALT"
msgid "Twill make the meat even more divine."
msgstr "它会让肉更加美味。"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_SALTROCK
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_SALTROCK"
msgid "Tis the salt of the earth."
msgstr "这是地球的盐。"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_SALT_RACK.GENERIC
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_SALT_RACK.GENERIC"
msgid "An ally to meat!"
msgstr "肉类的盟友！"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_SALT_RACK.READY
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_SALT_RACK.READY"
msgid "'Tis ready to be pillaged!"
msgstr "它已经可以被掠夺了！"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_SALT_RACK_ITEM
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_SALT_RACK_ITEM"
msgid "I shall put thee to good use."
msgstr "我要好好利用你。"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_SAP
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_SAP"
msgid "Nectar of the gods."
msgstr "献给诸神的蜂蜜。"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_SAPBUCKET
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_SAPBUCKET"
msgid "For pillaging from the trees."
msgstr "用来掠夺树上的好东西。"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_SAPLING
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_SAPLING"
msgid "'Twill never again grow to its former glory."
msgstr "它再也不会恢复昔日的荣耀。"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_SAP_SPOILED
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_SAP_SPOILED"
msgid "Alas, the nectar 'tis no longer sweet!"
msgstr "唉，蜜不甜了！"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_SEEDPACKET
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_SEEDPACKET"
msgid "Baby non-meats."
msgstr "非肉宝宝。"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_SLAUGHTERTOOL
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_SLAUGHTERTOOL"
msgid "'Tis a weapon of beastly slaughter!"
msgstr "这是一种屠杀野兽的武器！"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_SPOTSPICE_GROUND
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_SPOTSPICE_GROUND"
msgid "It contains the flavoring!"
msgstr "它含有调味料！"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_SPOTSPICE_SHRUB.GENERIC
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_SPOTSPICE_SHRUB.GENERIC"
msgid "Spice for the fanciest of foods."
msgstr "用来制作美味食物的香料。"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_SPOTSPICE_SHRUB.PICKED
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_SPOTSPICE_SHRUB.PICKED"
msgid "Thine growing taketh too long!"
msgstr "你的生长速度太慢了！"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_SPOTSPICE_SPRIG
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_SPOTSPICE_SPRIG"
msgid "'Tis a flavoring sprig."
msgstr "这个小枝可以用来调味。"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_SUGARWOODTREE.GENERIC
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_SUGARWOODTREE.GENERIC"
msgid "The nectar of the gods dwells within."
msgstr "献给诸神的蜜汁就在里面。"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_SUGARWOODTREE.STUMP
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_SUGARWOODTREE.STUMP"
msgid "It has been chopped."
msgstr "它被砍掉了。"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_SUGARWOODTREE.TAPPED_BUGS
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_SUGARWOODTREE.TAPPED_BUGS"
msgid "It hath been fouled by tiny beasts!"
msgstr "它被小怪物糟蹋了！"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_SUGARWOODTREE.TAPPED_EMPTY
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_SUGARWOODTREE.TAPPED_EMPTY"
msgid "I've no patience for thee, sap!"
msgstr "我对你可没什么耐心，汁液！"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_SUGARWOODTREE.TAPPED_READY
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_SUGARWOODTREE.TAPPED_READY"
msgid "I have acquired the nectar!"
msgstr "我得到蜂蜜了！"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_SUGARWOODTREE.WOUNDED
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_SUGARWOODTREE.WOUNDED"
msgid "It hath been wounded!"
msgstr "它被弄伤了！"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_SWAMPIG
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_SWAMPIG"
msgid "You would make a most honorable warrior."
msgstr "你可以成为一名光荣的战士。"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_SWAMPIGELDER.GENERIC
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_SWAMPIGELDER.GENERIC"
msgid "Your liege."
msgstr "领主大人。"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_SWAMPIGELDER.SLEEPING
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_SWAMPIGELDER.SLEEPING"
msgid "It slumbers soundly."
msgstr "它睡得真香。"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_SWAMPIG_HOUSE
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_SWAMPIG_HOUSE"
msgid "Lodgings of mine enemy."
msgstr "我的敌人住的地方。"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_SWAMPIG_HOUSE_RUBBLE
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_SWAMPIG_HOUSE_RUBBLE"
msgid "Laid to ruin."
msgstr "毁了。"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_SYRUP
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_SYRUP"
msgid "Nectar of the gods, for the gods."
msgstr "诸神的花蜜，献给诸神。"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_TOMATO
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_TOMATO"
msgid "Will this not anger the gods?"
msgstr "这不会触怒诸神吗？"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_TOMATO_COOKED
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_TOMATO_COOKED"
msgid "It boasts reddest guts, yet 'tis not meat!"
msgstr "它的内部红通通的，却不是肉！"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_TOMATO_SEEDS
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_TOMATO_SEEDS"
msgid "'Tis a handful of seeds, for not-meat."
msgstr "这一把种子，可以做成非肉类食物。"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_TRADER_MERM
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_TRADER_MERM"
msgid "Prepare to barter!"
msgstr "准备交易吧！"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_TRADER_MERM2
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_TRADER_MERM2"
msgid "'Tis a jaunty-hatted beast."
msgstr "这是个活泼的带帽怪物。"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_TURNIP
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_TURNIP"
msgid "The gods have strange tastes."
msgstr "诸神的口味很奇特。"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_TURNIP_COOKED
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_TURNIP_COOKED"
msgid "Ach! I shall not eat thee!"
msgstr "哎！我不吃你！"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_TURNIP_SEEDS
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_TURNIP_SEEDS"
msgid "'Tis a handful of seeds, for not-meat."
msgstr "这一把种子，可以做成非肉类食物。"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_WHEAT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_WHEAT"
msgid "O, glorious wheat!"
msgstr "噢，光荣的小麦！"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_WHEAT_SEEDS
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.QUAGMIRE_WHEAT_SEEDS"
msgid "'Tis a handful of seeds, for not-meat."
msgstr "这一把种子，可以做成非肉类食物。"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.RABBIT.GENERIC
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.RABBIT.GENERIC"
msgid "Jump into my mouth!"
msgstr "跳进我的嘴里来！"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.RABBIT.HELD
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.RABBIT.HELD"
msgid "There is no escape!"
msgstr "你跑不了的！"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.RABBITHAT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.RABBITHAT"
msgid "Ridiculous."
msgstr "真荒唐。"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.RABBITHOLE.GENERIC
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.RABBITHOLE.GENERIC"
msgid "Showtime, rabbits!"
msgstr "好戏上演，兔子！"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.RABBITHOLE.SPRING
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.RABBITHOLE.SPRING"
msgid "It must be intermission for the rabbits."
msgstr "好像是兔子的中场休息时间。"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.RABBITHOUSE.BURNT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.RABBITHOUSE.BURNT"
msgid "Good riddance, giant carrot."
msgstr "巨型胡萝卜，终于摆脱你了。"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.RABBITHOUSE.GENERIC
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.RABBITHOUSE.GENERIC"
msgid "What's to be done with a carrot that big?"
msgstr "该拿那么大的胡萝卜怎么办？"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.RABBITKINGHORN
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.RABBITKINGHORN"
msgid "The rabbit had best heed my call."
msgstr "兔子最好听从我的召唤。"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.RABBITKINGHORN_CHEST
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.RABBITKINGHORN_CHEST"
msgid "The rabbits pledge to safeguard my loot within their lair."
msgstr "兔子们发誓会在它们的巢穴里保护我的战利品。"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.RABBITKINGMINION_BUNNYMAN
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.RABBITKINGMINION_BUNNYMAN"
msgid "I shall send you to the endless carrot patch."
msgstr "我将带你去无尽的胡萝卜地。"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.RABBITKINGSPEAR
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.RABBITKINGSPEAR"
msgid "It shall be a delightful insult to mine enemies to perish by rabbit antler."
msgstr "如果我的敌人死于兔角，那将是一种令人愉快的侮辱。"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.RABBITKING_AGGRESSIVE
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.RABBITKING_AGGRESSIVE"
msgid "How adorable!"
msgstr "多可爱啊！"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.RABBITKING_LUCKY
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.RABBITKING_LUCKY"
msgid "I must capture it alive!"
msgstr "我一定要活捉它！"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.RABBITKING_PASSIVE
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.RABBITKING_PASSIVE"
msgid "The diminutive lord seeks commerce!"
msgstr "矮小的领主寻求合作！"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.RAINCOAT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.RAINCOAT"
msgid "Armor for rain."
msgstr "防雨水的护甲。"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.RAINHAT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.RAINHAT"
msgid "We will fight in the rain."
msgstr "我们将在雨中战斗。"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.RAINOMETER.BURNT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.RAINOMETER.BURNT"
msgid "Its prophecy days are done."
msgstr "它预言的日子结束了。"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.RAINOMETER.GENERIC
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.RAINOMETER.GENERIC"
msgid "It foretells the coming of rains."
msgstr "预告雨的到来。"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.RATATOUILLE
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.RATATOUILLE"
msgid "A pile of vegetables. No thanks."
msgstr "一堆蔬菜。不了，谢谢。"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.RAZOR
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.RAZOR"
msgid "A small blade, but a blade nonetheless."
msgstr "小刀片，但也算是把刀。"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.RECORD
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.RECORD"
msgid "T'would be a kindness to keep it from reaching the ears of my ally."
msgstr "行善举，别让它传到我盟友的耳朵里。"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.RECORD_BALATRO
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.RECORD_BALATRO"
msgid "'Tis a ballad of good hap!"
msgstr "唱响好运之歌！"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.RECORD_CREEPYFOREST
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.RECORD_CREEPYFOREST"
msgid "Music is nourishment for thy soul!"
msgstr "音乐是你灵魂的营养！"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.RECORD_DANGER
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.RECORD_DANGER"
msgid "Let us play a rousing war song!"
msgstr "奏响一曲振奋人心的战歌吧！"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.RECORD_DAWN
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.RECORD_DAWN"
msgid "Thy melody is most soothing."
msgstr "这旋律舒缓至极。"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.RECORD_DRSTYLE
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.RECORD_DRSTYLE"
msgid "The musicians play with such passion!"
msgstr "音乐家们演奏得如此热情！"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.RECORD_DUSK
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.RECORD_DUSK"
msgid "Thy melody is most soothing."
msgstr "这旋律舒缓至极。"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.RECORD_EFS
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.RECORD_EFS"
msgid "Doth the tempo not make one's heart race with excitement?"
msgstr "这节奏不让人心跳加速吗？"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.RECORD_END
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.RECORD_END"
msgid "The showstopper!"
msgstr "精彩绝伦！"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.RECORD_HALLOWEDNIGHTS
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.RECORD_HALLOWEDNIGHTS"
msgid "A serenade for the ghosts and ghouls."
msgstr "幽灵和食尸鬼的小夜曲。"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.RECORD_MAIN
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.RECORD_MAIN"
msgid "Music is nourishment for thy soul!"
msgstr "音乐是你灵魂的营养！"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.RECORD_WORKTOBEDONE
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.RECORD_WORKTOBEDONE"
msgid "Music is nourishment for thy soul!"
msgstr "音乐是你灵魂的营养！"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.REDGEM
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.REDGEM"
msgid "It is hot to the touch."
msgstr "摸上去很热。"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.REDLANTERN
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.REDLANTERN"
msgid "A lucky ward to guard against the night."
msgstr "抵抗夜晚的好物。"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.REDMOONEYE
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.REDMOONEYE"
msgid "Odin's eye, grant us wisdom!"
msgstr "奥丁的眼睛，给予我们智慧！"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.REDPOUCH
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.REDPOUCH"
msgid "A blessing of good fortune!"
msgstr "幸运的祝福！"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.RED_CAP
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.RED_CAP"
msgid "Umami or not, I don't want it."
msgstr "我不想要它。"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.RED_CAP_COOKED
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.RED_CAP_COOKED"
msgid "I don't want it, but I'm glad it survived trial by fire."
msgstr "我不想要，但很开心它经受了烈火的试炼。"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.RED_MUSHROOM.GENERIC
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.RED_MUSHROOM.GENERIC"
msgid "At least it's got a nice color."
msgstr "至少它的颜色很漂亮。"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.RED_MUSHROOM.INGROUND
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.RED_MUSHROOM.INGROUND"
msgid "And stay down there!"
msgstr "永远别出来！"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.RED_MUSHROOM.PICKED
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.RED_MUSHROOM.PICKED"
msgid "Good riddance."
msgstr "不在了就好。"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.REEDS.BURNING
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.REEDS.BURNING"
msgid "See you in Asgard, reeds!"
msgstr "神域见，芦苇！"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.REEDS.GENERIC
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.REEDS.GENERIC"
msgid "Those are some hardy reeds."
msgstr "一些结实的芦苇。"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.REEDS.PICKED
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.REEDS.PICKED"
msgid "Cut down in their prime."
msgstr "在它最茁壮的时候割下。"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.REFINED_DUST
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.REFINED_DUST"
msgid "The dust hath been forged into a solid block."
msgstr "尘埃已被锻造成坚固的块状。"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.REFLECTIVEVEST
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.REFLECTIVEVEST"
msgid "Ha! The sun is no warrior if it cannot penetrate this."
msgstr "哈！如果太阳连这个都穿不透，就不算个勇士。"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.RELIC
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.RELIC"
msgid "Fit for Asgard."
msgstr "适合神域。"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.RESEARCHLAB.BURNT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.RESEARCHLAB.BURNT"
msgid "Ashes to ashes."
msgstr "尘归尘。"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.RESEARCHLAB.GENERIC
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.RESEARCHLAB.GENERIC"
msgid "I prefer battle to science."
msgstr "比起科学我更喜欢战斗。"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.RESEARCHLAB2.BURNT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.RESEARCHLAB2.BURNT"
msgid "Dust to dust."
msgstr "土归土。"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.RESEARCHLAB2.GENERIC
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.RESEARCHLAB2.GENERIC"
msgid "Perhaps science can enhance my combat skills."
msgstr "也许科学能提高我的战斗技巧。"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.RESEARCHLAB3.BURNT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.RESEARCHLAB3.BURNT"
msgid "Its strange power did not protect it from fire."
msgstr "它虽有怪异的能力，但还是被烧成了灰。"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.RESEARCHLAB3.GENERIC
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.RESEARCHLAB3.GENERIC"
msgid "A mystical thing."
msgstr "一个神秘的东西。"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.RESEARCHLAB4.BURNT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.RESEARCHLAB4.BURNT"
msgid "No more meat will come from here!"
msgstr "这儿再也产不出肉了！"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.RESEARCHLAB4.GENERIC
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.RESEARCHLAB4.GENERIC"
msgid "It is an absurd machine that makes meat."
msgstr "制造肉的荒诞机器。"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.RESKIN_TOOL
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.RESKIN_TOOL"
msgid "In the blink of an eye, what once was is no more!"
msgstr "眨眼间，曾经存在的就消失了！"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.RESURRECTIONSTATUE.BURNT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.RESURRECTIONSTATUE.BURNT"
msgid "Valhalla, we come!"
msgstr "英灵殿，我们来了！"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.RESURRECTIONSTATUE.GENERIC
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.RESURRECTIONSTATUE.GENERIC"
msgid "Might the gods witness this visage and offer protection."
msgstr "愿诸神见到此景并提供庇佑。"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.RESURRECTIONSTONE
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.RESURRECTIONSTONE"
msgid "It holds me back from Valhalla."
msgstr "它能把我从英灵殿拉回来。"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.REVIVER
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.REVIVER"
msgid "Feel the passion inside!"
msgstr "感受内心的激情！"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.RHINODRILL
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.RHINODRILL"
msgid "Thy machismo frighten me not!"
msgstr "你的威风吓不到我！"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.ROASTTURKEY
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.ROASTTURKEY"
msgid "A glorious feast indeed!"
msgstr "光荣的盛宴！"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.ROBIN.GENERIC
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.ROBIN.GENERIC"
msgid "Red like blood."
msgstr "像血一样红。"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.ROBIN.HELD
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.ROBIN.HELD"
msgid "I prefer your black brethren."
msgstr "我更喜欢你黑色的同胞。"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.ROBIN_WINTER.GENERIC
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.ROBIN_WINTER.GENERIC"
msgid "This bird knows about the cold."
msgstr "这只鸟了解寒冷。"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.ROBIN_WINTER.HELD
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.ROBIN_WINTER.HELD"
msgid "Such fluffy feathers."
msgstr "多么蓬松的羽毛。"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.ROBOT_BLUEPRINT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.ROBOT_BLUEPRINT"
msgid "Armor of iron for my steed!"
msgstr "我坐骑的铁甲！"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.ROBOT_PUPPET
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.ROBOT_PUPPET"
msgid "A prisoner!"
msgstr "一个囚犯！"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.ROCK
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.ROCK"
msgid "Smash!"
msgstr "打碎！"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.ROCKS
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.ROCKS"
msgid "Some pretty normal rocks."
msgstr "一些很普通的石头。"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.ROCKY
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.ROCKY"
msgid "He may be a worthy combat comrade."
msgstr "他也许是一位值得尊敬的战友。"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.ROCK_AVOCADO_BUSH.BARREN
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.ROCK_AVOCADO_BUSH.BARREN"
msgid "Tis barren as the rainless desert."
msgstr "如无雨之沙漠一般贫瘠。"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.ROCK_AVOCADO_BUSH.BURNING
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.ROCK_AVOCADO_BUSH.BURNING"
msgid "Tis consumed by flame!"
msgstr "被烈火吞噬了！"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.ROCK_AVOCADO_BUSH.DISEASED
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.ROCK_AVOCADO_BUSH.DISEASED"
msgid "The plague hath overwhelmed it completely!"
msgstr "瘟疫已将它完全征服！"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.ROCK_AVOCADO_BUSH.DISEASING
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.ROCK_AVOCADO_BUSH.DISEASING"
msgid "A plague festers within it!"
msgstr "瘟疫蔓延其中。"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.ROCK_AVOCADO_BUSH.GENERIC
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.ROCK_AVOCADO_BUSH.GENERIC"
msgid "Hark, be wary! Tis fruit I see."
msgstr "听，当心！我看到了水果。"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.ROCK_AVOCADO_BUSH.PICKED
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.ROCK_AVOCADO_BUSH.PICKED"
msgid "It hath been stripped of its bounty."
msgstr "莫待无果空折枝。"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.ROCK_AVOCADO_BUSH.WITHERED
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.ROCK_AVOCADO_BUSH.WITHERED"
msgid "It had not the strength to withstand this heat."
msgstr "没能经得住热浪的摧残。"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.ROCK_AVOCADO_FRUIT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.ROCK_AVOCADO_FRUIT"
msgid "Tis either a rock or vegetable. Neither are food."
msgstr "此乃石头或蔬菜，二者皆不可食。"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.ROCK_AVOCADO_FRUIT_RIPE
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.ROCK_AVOCADO_FRUIT_RIPE"
msgid "Yuck."
msgstr "真讨厌。"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.ROCK_AVOCADO_FRUIT_RIPE_COOKED
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.ROCK_AVOCADO_FRUIT_RIPE_COOKED"
msgid "I shall not eat that."
msgstr "我不要吃这个。"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.ROCK_AVOCADO_FRUIT_SPROUT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.ROCK_AVOCADO_FRUIT_SPROUT"
msgid "The rock veggie is sprouting."
msgstr "石头蔬菜发芽了。"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.ROCK_ICE.GENERIC
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.ROCK_ICE.GENERIC"
msgid "A miniature frozen mountain."
msgstr "迷你冰山。"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.ROCK_ICE.MELTED
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.ROCK_ICE.MELTED"
msgid "Poor glacier!"
msgstr "可怜的冰山！"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.ROCK_ICE_MELTED
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.ROCK_ICE_MELTED"
msgid "Poor glacier!"
msgstr "可怜的冰山！"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.ROCK_LIGHT.GENERIC
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.ROCK_LIGHT.GENERIC"
msgid "The lava crust is firm."
msgstr "岩浆壳很坚实。"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.ROCK_LIGHT.LOW
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.ROCK_LIGHT.LOW"
msgid "The lava crust is reforming."
msgstr "岩浆壳正在重新形成。"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.ROCK_LIGHT.NORMAL
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.ROCK_LIGHT.NORMAL"
msgid "Beautiful light!"
msgstr "美丽的光！"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.ROCK_LIGHT.OUT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.ROCK_LIGHT.OUT"
msgid "Looks delicate."
msgstr "看上去很微弱。"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.ROCK_MOON
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.ROCK_MOON"
msgid "A gift from Mani."
msgstr "来自玛尼的礼物。"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.ROCK_PETRIFIED_TREE
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.ROCK_PETRIFIED_TREE"
msgid "My mere presence struck terror into their tree-hearts!"
msgstr "我一出现就让这些树胆战心惊！"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.ROCK_PETRIFIED_TREE_OLD
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.ROCK_PETRIFIED_TREE_OLD"
msgid "My mere presence struck terror into their tree-hearts!"
msgstr "我一出现就让这些树胆战心惊！"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.ROOK
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.ROOK"
msgid "Chaaaarge!"
msgstr "冲啊！！！"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.ROOK_NIGHTMARE
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.ROOK_NIGHTMARE"
msgid "You don't frighten me!"
msgstr "你吓唬不了我！"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.ROPE
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.ROPE"
msgid "Strong enough to bind the sails of my longship."
msgstr "够结实了，可以用来绑我的船帆。"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.ROPE_BRIDGE_KIT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.ROPE_BRIDGE_KIT"
msgid "'Tis no Bifrost, but 'twill do."
msgstr "这不是彩虹桥，但也可以用。"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.ROSEGLASSESHAT.GENERIC
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.ROSEGLASSESHAT.GENERIC"
msgid "They reveal visions to my ally. I just hope she remains wary."
msgstr "它为我的盟友提供视野。我只希望她保持警惕。"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.ROSEGLASSESHAT.MISSINGSKILL
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.ROSEGLASSESHAT.MISSINGSKILL"
msgid "only_used_by_winona"
msgstr "only_used_by_winona"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.ROTTENEGG.GENERIC
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.ROTTENEGG.GENERIC"
msgid "Ruined for eating, but primed for battle."
msgstr "没法吃了，但在战斗中很好用。"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.ROYAL_JELLY
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.ROYAL_JELLY"
msgid "To absorb the felled queen's power!"
msgstr "吸收被击倒的女王的力量！"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.RUBBLE
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.RUBBLE"
msgid "A pile of ancient rocks."
msgstr "一堆古老的岩石。"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.RUINSHAT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.RUINSHAT"
msgid "A crown... that fights!"
msgstr "一顶皇冠，对战斗很有帮助！"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.RUINS_BAT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.RUINS_BAT"
msgid "A warrior's wand!"
msgstr "勇士之杖！"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.RUINS_RUBBLE
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.RUINS_RUBBLE"
msgid "Its days are not done."
msgstr "它的日子还没结束。"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SACRED_CHEST.GENERIC
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SACRED_CHEST.GENERIC"
msgid "What foul manner of chest is this?"
msgstr "这是一个什么箱子？"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SACRED_CHEST.LOCKED
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SACRED_CHEST.LOCKED"
msgid "I shall submit to the gods' judgment."
msgstr "我应交由诸神判断。"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SADDLEHORN
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SADDLEHORN"
msgid "Mighty steeds can be unsaddled with this."
msgstr "可以用来取下鞍具。"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SADDLE_BASIC
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SADDLE_BASIC"
msgid "Now to find a faithful steed."
msgstr "现在找一匹忠诚的战马吧。"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SADDLE_RACE
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SADDLE_RACE"
msgid "Oh to fly on the wings of Valkyrie!"
msgstr "噢，飞到女武神瓦尔基里的翅膀上！"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SADDLE_SHADOW
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SADDLE_SHADOW"
msgid "A fine saddle for slaying."
msgstr "一个精美鞍具，用以杀戮。"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SADDLE_WAR
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SADDLE_WAR"
msgid "I ride to victory or death!"
msgstr "要么胜利，要么死亡！"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SADDLE_WATHGRITHR
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SADDLE_WATHGRITHR"
msgid "We ride to victory!"
msgstr "向着胜利驰骋！"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SALSA
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SALSA"
msgid "A disappointing mush."
msgstr "令人失望的糊状食物。"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SALTBOX
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SALTBOX"
msgid "A fine place to store meats!"
msgstr "贮藏肉类的好地方！"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SALTLICK
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SALTLICK"
msgid "Minerals, not meat."
msgstr "矿物质，不要肉。"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SALTLICK_IMPROVED
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SALTLICK_IMPROVED"
msgid "So the meat can season itself."
msgstr "这样，肉就能自己调味了。"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SALTROCK
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SALTROCK"
msgid "It hath a strange shape to it."
msgstr "外形奇特。"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SALTSTACK.GENERIC
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SALTSTACK.GENERIC"
msgid "Tis the form of a sea nymph!"
msgstr "外形像海中仙子！"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SALTSTACK.GROWING
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SALTSTACK.GROWING"
msgid "Formed as if by Odin's hand!"
msgstr "好像是奥丁亲手捏成！"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SALTSTACK.MINED_OUT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SALTSTACK.MINED_OUT"
msgid "Naught but a stump!"
msgstr "剩下个没用的桩子！"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SALTY_DOG
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SALTY_DOG"
msgid "To me, my briny ally!"
msgstr "到我这儿来，我咸涩的盟友！"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SALTY_DOGHAT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SALTY_DOGHAT"
msgid "The helm of one who holds command over the seas."
msgstr "这乃四海大统帅的头盔。"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SANDBLOCK
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SANDBLOCK"
msgid "Tis a castle of sand!"
msgstr "这是一座沙子堆起的城堡！"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SANDSPIKE
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SANDSPIKE"
msgid "The earth itself dares to fight me!"
msgstr "大地敢与我对决吗！"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SANITYROCK.ACTIVE
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SANITYROCK.ACTIVE"
msgid "I do not think I can best this rock in combat."
msgstr "我不认为我能在战斗中打败这块石头。"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SANITYROCK.INACTIVE
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SANITYROCK.INACTIVE"
msgid "Clever rock, you cannot surprise a warrior!"
msgstr "聪明的石头，你无法惊吓一位勇士！"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SAPLING.BURNING
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SAPLING.BURNING"
msgid "Nooo! My spears!"
msgstr "不！我的长矛！"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SAPLING.DISEASED
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SAPLING.DISEASED"
msgid "Disease festers within its soul."
msgstr "疾病在它的灵魂里恶化。"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SAPLING.DISEASING
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SAPLING.DISEASING"
msgid "It is weakening before mine eyes!"
msgstr "它在我面前变弱了！"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SAPLING.GENERIC
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SAPLING.GENERIC"
msgid "It longs to be a spear."
msgstr "它渴望成为长矛。"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SAPLING.PICKED
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SAPLING.PICKED"
msgid "The small tree has been slain!"
msgstr "这小树已经被灭了！"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SAPLING.WITHERED
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SAPLING.WITHERED"
msgid "It has been shriveled by the heat."
msgstr "在高温下干枯了。"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SCANDATA
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SCANDATA"
msgid "The metal scout's report!"
msgstr "金属侦察兵的报告！"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SCARECROW.BURNING
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SCARECROW.BURNING"
msgid "The scarecrow burns."
msgstr "稻草人燃烧起来了。"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SCARECROW.BURNT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SCARECROW.BURNT"
msgid "The scarecrow dost yearn for nothing, now."
msgstr "稻草人现在什么也不想要了。"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SCARECROW.GENERIC
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SCARECROW.GENERIC"
msgid "Dost thou yearn for a brain?"
msgstr "你想要一个大脑吗？"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SCORCHED_SKELETON
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SCORCHED_SKELETON"
msgid "Rest easy, spirit. Your fight is over."
msgstr "小精灵，放宽心。你的战争结束了。"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SCRAPBOOK_PAGE
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SCRAPBOOK_PAGE"
msgid "From whence hath you come, mysterious page?"
msgstr "你从哪里来，未解的篇章？"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SCRAPHAT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SCRAPHAT"
msgid "'Twas won in an invigorating battle!"
msgstr "它是在一场令人振奋的战斗中赢得的！"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SCRAP_MONOCLEHAT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SCRAP_MONOCLEHAT"
msgid "An enchanted eye, to view the whole battlefield at once."
msgstr "一只附了魔的眼睛，一眼就能遍览整个战场。"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SCULPTINGTABLE.BLOCK
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SCULPTINGTABLE.BLOCK"
msgid "May the muses guide our hands!"
msgstr "希望缪斯指导我们的双手！"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SCULPTINGTABLE.BURNT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SCULPTINGTABLE.BURNT"
msgid "Lain to waste."
msgstr "糟蹋。"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SCULPTINGTABLE.EMPTY
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SCULPTINGTABLE.EMPTY"
msgid "A transformative altar for the stone gods."
msgstr "石头诸神用来变形的祭坛。"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SCULPTINGTABLE.SCULPTURE
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SCULPTINGTABLE.SCULPTURE"
msgid "The muses have been kind this day."
msgstr "缪斯今天很友善。"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SCULPTURE_BISHOPBODY.COVERED
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SCULPTURE_BISHOPBODY.COVERED"
msgid "More apt for the halls of Valhalla."
msgstr "更适合英灵殿大堂。"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SCULPTURE_BISHOPBODY.FINISHED
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SCULPTURE_BISHOPBODY.FINISHED"
msgid "Will this please the gods? Or anger them?"
msgstr "这会让诸神开心吗？或者会让他们生气？"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SCULPTURE_BISHOPBODY.READY
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SCULPTURE_BISHOPBODY.READY"
msgid "The beast has been roused beneath!"
msgstr "下面的野兽被唤醒了！"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SCULPTURE_BISHOPBODY.UNCOVERED
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SCULPTURE_BISHOPBODY.UNCOVERED"
msgid "We've freed the figure slumbering in the stone."
msgstr "我们释放了在石头中沉睡的那个人物。"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SCULPTURE_BISHOPHEAD
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SCULPTURE_BISHOPHEAD"
msgid "A follower of Mimir, mayhaps?"
msgstr "也许是密米尔的跟随者？"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SCULPTURE_KNIGHTBODY.COVERED
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SCULPTURE_KNIGHTBODY.COVERED"
msgid "An abandoned monument to the gods?"
msgstr "一块诸神遗弃的纪念碑？"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SCULPTURE_KNIGHTBODY.FINISHED
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SCULPTURE_KNIGHTBODY.FINISHED"
msgid "Might we come to regret this action?"
msgstr "我们会后悔这一行动吗？"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SCULPTURE_KNIGHTBODY.READY
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SCULPTURE_KNIGHTBODY.READY"
msgid "The beast has been roused beneath!"
msgstr "下面的野兽被唤醒了！"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SCULPTURE_KNIGHTBODY.UNCOVERED
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SCULPTURE_KNIGHTBODY.UNCOVERED"
msgid "An icon of evil, surely!"
msgstr "当然是邪恶的象征！"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SCULPTURE_KNIGHTHEAD
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SCULPTURE_KNIGHTHEAD"
msgid "Dost thou yearn for a body?"
msgstr "你想要一个身体吗？"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SCULPTURE_ROOKBODY.COVERED
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SCULPTURE_ROOKBODY.COVERED"
msgid "Warriors are not concerned with decorative sculptures."
msgstr "战士们不关心装饰性的雕像。"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SCULPTURE_ROOKBODY.FINISHED
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SCULPTURE_ROOKBODY.FINISHED"
msgid "Gods help us on Mani's night."
msgstr "请诸神在玛尼的夜晚帮助我们。"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SCULPTURE_ROOKBODY.READY
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SCULPTURE_ROOKBODY.READY"
msgid "The beast has been roused beneath!"
msgstr "下面的野兽被唤醒了！"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SCULPTURE_ROOKBODY.UNCOVERED
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SCULPTURE_ROOKBODY.UNCOVERED"
msgid "I fear we've unleashed a great evil."
msgstr "我恐怕我们已经放出了一个强大的魔鬼。"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SCULPTURE_ROOKNOSE
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SCULPTURE_ROOKNOSE"
msgid "It has strayed from the warrior's path."
msgstr "它已经偏离战士的路了。"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SEAFARING_PROTOTYPER.BURNT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SEAFARING_PROTOTYPER.BURNT"
msgid "Tis no more."
msgstr "不复存在。"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SEAFARING_PROTOTYPER.GENERIC
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SEAFARING_PROTOTYPER.GENERIC"
msgid "A seafaring Viking is keen of mind and sharp of wit."
msgstr "航海的维京人热心机智。"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SEAFOODGUMBO
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SEAFOODGUMBO"
msgid "A meal fit for a Viking queen."
msgstr "维京女王的御膳。"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SEASTACK
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SEASTACK"
msgid "I shall not dash mine ship upon thee!"
msgstr "吾之船万万不能撞上汝！"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SECURITY_PULSE_CAGE
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SECURITY_PULSE_CAGE"
msgid "'Tis a trap!"
msgstr "这是一个陷阱！"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SECURITY_PULSE_CAGE_FULL
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SECURITY_PULSE_CAGE_FULL"
msgid "It burns bright like the sword of Surtr."
msgstr "像苏尔特尔之剑一样明亮地燃烧着。"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SEEDPOUCH
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SEEDPOUCH"
msgid "For carrying worthless seeds."
msgstr "可以携带不值钱的种子。"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SEEDS
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SEEDS"
msgid "Tiny nature bits."
msgstr "微小的自然产物。"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SEEDS_COOKED
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SEEDS_COOKED"
msgid "Tiny nature bits, cooked to death."
msgstr "微小的自然产物，给烤死了。"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SENTRYWARD
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SENTRYWARD"
msgid "May the secrets of this land be divulged by the gods."
msgstr "希望这片土地的秘密会被诸神所泄露。"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SEWING_KIT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SEWING_KIT"
msgid "I am no seamstress, but repairs are sometimes necessary."
msgstr "虽然我不是女裁缝，但偶尔也得缝缝补补。"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SEWING_MANNEQUIN.BURNT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SEWING_MANNEQUIN.BURNT"
msgid "The stuffed man hath met a fiery end."
msgstr "那个填充而成的人被烧干了。"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SEWING_MANNEQUIN.GENERIC
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SEWING_MANNEQUIN.GENERIC"
msgid "It shall make for some fine target practice."
msgstr "它拿来当靶子应该不错。"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SEWING_TAPE
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SEWING_TAPE"
msgid "Luckily I need be no seamstress with this!"
msgstr "幸好，我不需要使用这个变成女裁缝！"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SHADOWDANCER
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SHADOWDANCER"
msgid "This serf is not being treated with dignity."
msgstr "这个农奴没有得到尊重。"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SHADOWDIGGER
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SHADOWDIGGER"
msgid "I hope this serf is being treated with dignity."
msgstr "我希望这个农奴能受到尊重。"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SHADOWHEART
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SHADOWHEART"
msgid "Blackest hearts. Darkest omens."
msgstr "最黑暗的心。最黑暗的预兆。"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SHADOWRIFT_PORTAL
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SHADOWRIFT_PORTAL"
msgid "A chasm to Hel itself."
msgstr "通往赫尔本尊的裂隙。"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SHADOWTHRALL_CENTIPEDE.BODY
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SHADOWTHRALL_CENTIPEDE.BODY"
msgid "The beast be clad in formidable armor."
msgstr "该兽身披可畏之甲。"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SHADOWTHRALL_CENTIPEDE.FLIPPED
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SHADOWTHRALL_CENTIPEDE.FLIPPED"
msgid "Overthrown, yet the beast's fury remaineth!"
msgstr "虽已倾覆，然该兽之怒依旧！"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SHADOWTHRALL_CENTIPEDE.HEAD
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SHADOWTHRALL_CENTIPEDE.HEAD"
msgid "A twain-headed beast!"
msgstr "双首之兽！"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SHADOWTHRALL_HANDS
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SHADOWTHRALL_HANDS"
msgid "To arms, fiend!"
msgstr "拿起武器吧，小魔鬼！"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SHADOWTHRALL_HORNS
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SHADOWTHRALL_HORNS"
msgid "All thou shall taste is the bite of my spear!"
msgstr "吃我一矛！"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SHADOWTHRALL_MOUTH
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SHADOWTHRALL_MOUTH"
msgid "I shall wipe that grin off thine face."
msgstr "我要把你脸上的笑容抹掉。"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SHADOWTHRALL_PARASITE
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SHADOWTHRALL_PARASITE"
msgid "Keep away thy cursed embrace."
msgstr "别过来，你的拥抱被诅咒了。"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SHADOWTHRALL_WINGS
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SHADOWTHRALL_WINGS"
msgid "Thou art swift, but not swift enough!"
msgstr "你是快，但还不够快！"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SHADOW_BATTLEAXE
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SHADOW_BATTLEAXE"
msgid "I shall bring down many a beast with that cursed axe."
msgstr "我将用这把被诅咒的斧头砍倒许多野兽。"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SHADOW_BEEF_BELL
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SHADOW_BEEF_BELL"
msgid "We shall ride again!"
msgstr "我们将再次出发！"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SHADOW_FORGE
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SHADOW_FORGE"
msgid "It doth conjure powerful, accursed things..."
msgstr "它能编织出强大的被诅咒之物……"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SHADOW_FORGE_KIT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SHADOW_FORGE_KIT"
msgid "Dare I toy with such a thing?"
msgstr "我真敢玩这个吗？"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SHADOW_HEART_VEIN
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SHADOW_HEART_VEIN"
msgid "Such gifts bear ill fortune."
msgstr "这样的馈赠往往带来厄运。"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SHALLOW_GRAVE
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SHALLOW_GRAVE"
msgid "They deserved better."
msgstr "当为逝者提供更好的安息之所。"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SHARK
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SHARK"
msgid "Do you come to challenge me, sea beast?"
msgstr "你是来挑战我的吗，海兽？"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SHARKBOI
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SHARKBOI"
msgid "Whether land or sea, a shallow grave waits for thee."
msgstr "无论是陆地还是大海，等着你都是一座矮坟。"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SHELLWEAVER
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SHELLWEAVER"
msgid "The sea witch hath shared her ways with us. A high honor, indeed."
msgstr "海巫婆将秘技传授于我等——实乃殊荣。"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SHELL_CLUSTER
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SHELL_CLUSTER"
msgid "Tis naught but a clump of shells."
msgstr "不过是一簇贝壳尔尔。"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SHIELDOFTERROR
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SHIELDOFTERROR"
msgid "Why cower behind a shield when you can strike with it!"
msgstr "既然能用盾牌攻击，为什么要畏缩在盾牌后面呢？"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SHOVEL
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SHOVEL"
msgid "I'd prefer a ship burial, though this might have its uses."
msgstr "虽然我更喜欢船葬，但它可能有别的用处。"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SHOVEL_LUNARPLANT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SHOVEL_LUNARPLANT"
msgid "The ground stands no chance against me."
msgstr "我不会给大地任何机会。"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SHROOMBAIT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SHROOMBAIT"
msgid "What coward wouldst sedate a beast?"
msgstr "什么样的懦夫才会给野兽喂镇静剂？"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SHROOMCAKE
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SHROOMCAKE"
msgid "A Viking would never stoop to eat such an unworthy thing."
msgstr "维京人绝对不会弯腰吃这种东西。"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SHROOM_SKIN
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SHROOM_SKIN"
msgid "A trophy of our battles!"
msgstr "我们战斗的战利品！"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SIESTAHUT.BURNT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SIESTAHUT.BURNT"
msgid "It has been razed."
msgstr "它被彻底摧毁了。"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SIESTAHUT.GENERIC
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SIESTAHUT.GENERIC"
msgid "A place to rest one's battle-weary head."
msgstr "在这里，人们因战斗而疲倦的头脑得到休息。"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SILK
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SILK"
msgid "Useful for binding, and for remembering victories past."
msgstr "可用于缝合东西和记住胜利事迹。"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SINGINGSHELL_OCTAVE3.GENERIC
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SINGINGSHELL_OCTAVE3.GENERIC"
msgid "{note}? I expected it to sound more like a war bugle."
msgstr "{note}? 我本来期待它发出军号的声音。"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SINGINGSHELL_OCTAVE4.GENERIC
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SINGINGSHELL_OCTAVE4.GENERIC"
msgid "It sings a siren's song. In {note}."
msgstr "它唱着塞壬的歌曲。{note} 的音。"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SINGINGSHELL_OCTAVE5.GENERIC
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SINGINGSHELL_OCTAVE5.GENERIC"
msgid "{note}... an impressively high register for a wee sea beast."
msgstr "{note}……小小的海洋野兽竟有如此高的音域。"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SISTURN.GENERIC
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SISTURN.GENERIC"
msgid "A small langhús for the ghostly warrior to regain her strength."
msgstr "能让亡灵勇士重获力量的小长屋。"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SISTURN.LOTS_OF_FLOWERS
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SISTURN.LOTS_OF_FLOWERS"
msgid "'Tis a fine monument indeed."
msgstr "好一个纪念碑。"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SISTURN.LOTS_OF_FLOWERS_BLOSSOM
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SISTURN.LOTS_OF_FLOWERS_BLOSSOM"
msgid "Call'th to memory the lays of the Havfrue."
msgstr "唤起我对美人鱼歌谣的回忆。"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SISTURN.LOTS_OF_FLOWERS_EVIL
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SISTURN.LOTS_OF_FLOWERS_EVIL"
msgid "'Tis marring mine musings."
msgstr "扰乱了我的思绪。"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SISTURN.SOME_FLOWERS
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SISTURN.SOME_FLOWERS"
msgid "Flowers doth please this spirit."
msgstr "鲜花确实会取悦这个精灵。"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SKELETON
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SKELETON"
msgid "Rest easy in Valhalla."
msgstr "在英灵殿中安息吧。"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SKELETONHAT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SKELETONHAT"
msgid "Immortal's sight was not meant for thee."
msgstr "你不应该有神明的洞见。"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SKELETON_NOTPLAYER
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SKELETON_NOTPLAYER"
msgid "Didst thou fall in battle, beast?"
msgstr "你倒在了沙场吗，野兽？"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SKELETON_PLAYER.DEFAULT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SKELETON_PLAYER.DEFAULT"
msgid "%s was felled by %s. Live on in Valhalla."
msgstr "%s被%s击倒。在英灵殿生活。"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SKELETON_PLAYER.FEMALE
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SKELETON_PLAYER.FEMALE"
msgid "%s was felled by %s. She will live on in Valhalla."
msgstr "%s被%s击倒。她将在英灵殿生活。"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SKELETON_PLAYER.MALE
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SKELETON_PLAYER.MALE"
msgid "%s was felled by %s. He will live on in Valhalla."
msgstr "%s被%s击倒。他将在英灵殿生活。"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SKELETON_PLAYER.ROBOT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SKELETON_PLAYER.ROBOT"
msgid "%s was felled by %s. They will live on in Valhalla."
msgstr "%s被%s击倒。它将在英灵殿生活。"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SKETCH
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SKETCH"
msgid "The muses' knowledge, inscribed upon an ancient scroll!"
msgstr "缪斯的知识，铭刻于古老的卷轴上！"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SKULLCHEST
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SKULLCHEST"
msgid "Ah, that was a good battle."
msgstr "哦，那是场不错的战斗。"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SLEEPBOMB
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SLEEPBOMB"
msgid "Those who enter thy circle shalt know rest."
msgstr "进入你的循环的人应该知道休息。"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SLINGSHOT.GENERIC
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SLINGSHOT.GENERIC"
msgid "I prefer weapons at close range."
msgstr "我更喜欢近距离的武器。"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SLINGSHOTAMMO_CONTAINER
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SLINGSHOTAMMO_CONTAINER"
msgid "Though I prefer a blade, the lad slings with honor."
msgstr "虽然我更喜欢刀剑，但这小子用弹弓打出了荣耀。"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SLINGSHOTAMMO_DREADSTONE
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SLINGSHOTAMMO_DREADSTONE"
msgid "What fun is a battle without hand to hand combat?"
msgstr "没有肉搏的战斗，何来乐趣？"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SLINGSHOTAMMO_FREEZE
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SLINGSHOTAMMO_FREEZE"
msgid "What fun is a battle without hand to hand combat?"
msgstr "没有肉搏的战斗，何来乐趣？"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SLINGSHOTAMMO_GELBLOB
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SLINGSHOTAMMO_GELBLOB"
msgid "What fun is a battle without hand to hand combat?"
msgstr "没有肉搏的战斗，何来乐趣？"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SLINGSHOTAMMO_GOLD
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SLINGSHOTAMMO_GOLD"
msgid "What fun is a battle without hand to hand combat?"
msgstr "没有肉搏的战斗，何来乐趣？"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SLINGSHOTAMMO_GUNPOWDER
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SLINGSHOTAMMO_GUNPOWDER"
msgid "What fun is a battle without hand to hand combat?"
msgstr "没有肉搏的战斗，何来乐趣？"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SLINGSHOTAMMO_HONEY
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SLINGSHOTAMMO_HONEY"
msgid "What fun is a battle without hand to hand combat?"
msgstr "没有肉搏的战斗，何来乐趣？"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SLINGSHOTAMMO_HORRORFUEL
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SLINGSHOTAMMO_HORRORFUEL"
msgid "What fun is a battle without hand to hand combat?"
msgstr "没有肉搏的战斗，何来乐趣？"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SLINGSHOTAMMO_LUNARPLANTHUSK
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SLINGSHOTAMMO_LUNARPLANTHUSK"
msgid "What fun is a battle without hand to hand combat?"
msgstr "没有肉搏的战斗，何来乐趣？"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SLINGSHOTAMMO_MARBLE
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SLINGSHOTAMMO_MARBLE"
msgid "What fun is a battle without hand to hand combat?"
msgstr "没有肉搏的战斗，何来乐趣？"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SLINGSHOTAMMO_MOONGLASS
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SLINGSHOTAMMO_MOONGLASS"
msgid "What fun is a battle without hand to hand combat?"
msgstr "没有肉搏的战斗，何来乐趣？"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SLINGSHOTAMMO_POOP
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SLINGSHOTAMMO_POOP"
msgid "I could do without the stench..."
msgstr "奇丑无比……"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SLINGSHOTAMMO_PUREBRILLIANCE
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SLINGSHOTAMMO_PUREBRILLIANCE"
msgid "What fun is a battle without hand to hand combat?"
msgstr "没有肉搏的战斗，何来乐趣？"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SLINGSHOTAMMO_ROCK
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SLINGSHOTAMMO_ROCK"
msgid "What fun is a battle without hand to hand combat?"
msgstr "没有肉搏的战斗，何来乐趣？"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SLINGSHOTAMMO_SCRAPFEATHER
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SLINGSHOTAMMO_SCRAPFEATHER"
msgid "What fun is a battle without hand to hand combat?"
msgstr "没有肉搏的战斗，何来乐趣？"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SLINGSHOTAMMO_SLOW
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SLINGSHOTAMMO_SLOW"
msgid "What fun is a battle without hand to hand combat?"
msgstr "没有肉搏的战斗，何来乐趣？"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SLINGSHOTAMMO_STINGER
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SLINGSHOTAMMO_STINGER"
msgid "What fun is a battle without hand to hand combat?"
msgstr "没有肉搏的战斗，何来乐趣？"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SLINGSHOTAMMO_THULECITE
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SLINGSHOTAMMO_THULECITE"
msgid "What fun is a battle without hand to hand combat?"
msgstr "没有肉搏的战斗，何来乐趣？"

#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SLINGSHOTMODKIT
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SLINGSHOTMODKIT"
msgid "The young scout doth come into his own."
msgstr "年轻的童子军已经开始独当一面了。"

