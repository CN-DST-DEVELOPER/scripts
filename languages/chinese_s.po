msgstr "齐射"

#. STRINGS.ENGINEER_REMOTE.ELEMENTAL_VOLLEY
msgctxt "STRINGS.ENGINEER_REMOTE.ELEMENTAL_VOLLEY"
msgid "Planar Strike"
msgstr "位面袭击"

#. STRINGS.ENGINEER_REMOTE.VOLLEY
msgctxt "STRINGS.ENGINEER_REMOTE.VOLLEY"
