msgstr "它会做出编造的墙！"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.WAGDRONE_FLYING.DAMAGED
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.WAGDRONE_FLYING.DAMAGED"
msgid "We can't fix it, but we can take its insides."
msgstr "我们修不好它，但可以拿走它里面的瓤子。"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.WAGDRONE_FLYING.GENERIC
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.WAGDRONE_FLYING.GENERIC"
msgid "No fair! We can't fly!"
msgstr "不公平！我们不会飞！"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.WAGDRONE_FLYING.INACTIVE
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.WAGDRONE_FLYING.INACTIVE"
msgid "Can we play with it?"
msgstr "我们能玩这个吗？"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.WAGDRONE_PARTS
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.WAGDRONE_PARTS"
msgid "Can we use that to fix a broken one?"
msgstr "我们可以用这个修好坏掉的机器吗？"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.WAGDRONE_ROLLING.DAMAGED
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.WAGDRONE_ROLLING.DAMAGED"
msgid "We can fix it, or take its insides!"
msgstr "我们可以修好它，或者拿走它里面的瓤子！"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.WAGDRONE_ROLLING.FRIENDLY
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.WAGDRONE_ROLLING.FRIENDLY"
msgid "We love how it spins and spins and spins."
msgstr "我们好喜欢它转转转的样子！"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.WAGDRONE_ROLLING.GENERIC
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.WAGDRONE_ROLLING.GENERIC"
msgid "Nasty little robots."
msgstr "坏蛋小机器人。"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.WAGDRONE_ROLLING.INACTIVE
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.WAGDRONE_ROLLING.INACTIVE"
msgid "Can we play with it?"
msgstr "我们能玩这个吗？"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.WAGPUNKBITS_KIT
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.WAGPUNKBITS_KIT"
msgid "We want to play with the toy!"
msgstr "我们想玩玩具！"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.WAGPUNKHAT
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.WAGPUNKHAT"
msgid "What's one more voice in our head?"
msgstr "脑袋里多个声音怕什么？"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.WAGPUNK_BITS
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.WAGPUNK_BITS"
msgid "We love puzzles!"
msgstr "我们喜欢拼图！"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.WAGPUNK_CAGEWALL
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.WAGPUNK_CAGEWALL"
msgid "Now we can't cross the line?"
msgstr "现在我们不能越界了吗？"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.WAGPUNK_FLOOR_KIT
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.WAGPUNK_FLOOR_KIT"
msgid "We'll have more room to play."
msgstr "我们会有更多玩耍的空间啦。"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.WAGPUNK_LEVER
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.WAGPUNK_LEVER"
msgid "It's our turn to pull it!"
msgstr "总算轮到我们来拉它了！"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.WAGPUNK_WORKSTATION
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.WAGPUNK_WORKSTATION"
msgid "Can we build something fun?"
msgstr "我们能造些好玩的东西吗？"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.WAGSTAFF_ITEM_1
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.WAGSTAFF_ITEM_1"
msgid "We can touch the glove!"
msgstr "我们可以摸到有手套！"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.WAGSTAFF_ITEM_2
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.WAGSTAFF_ITEM_2"
msgid "It's real? We don't understand."
msgstr "这是真的吗？我们有点蒙了。"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.WAGSTAFF_MACHINERY
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.WAGSTAFF_MACHINERY"
msgid "We're not supposed to play in scrap piles, no matter how much we want to."
msgstr "不管我们有多想，我们都不能在垃圾堆里玩。"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.WAGSTAFF_MUTATIONS_NOTE
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.WAGSTAFF_MUTATIONS_NOTE"
msgid "Is it a story?"
msgstr "这是一个故事吗？"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.WAGSTAFF_NPC
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.WAGSTAFF_NPC"
msgid "Should we help him? I don't mind, but he's not so sure..."
msgstr "我们应该帮他吗？我不介意，可是他看起来不是很确定……"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.WAGSTAFF_NPC_MUTATIONS
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.WAGSTAFF_NPC_MUTATIONS"
msgid "Hi Mister, do you have any games we can play instead?"
msgstr "先生您好，您有什么别的我们可以玩的游戏吗？"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.WAGSTAFF_NPC_WAGPUNK
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.WAGSTAFF_NPC_WAGPUNK"
msgid "Should we play follow the leader?"
msgstr "我们要玩追随领袖的游戏吗？"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.WAGSTAFF_TOOL_1
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.WAGSTAFF_TOOL_1"
msgid "Is that the thing we're looking for?"
msgstr "那个就是我们一直在找的东西吗？"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.WAGSTAFF_TOOL_2
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.WAGSTAFF_TOOL_2"
msgid "It looks like some kind of tool... maybe it's what he was looking for!"
msgstr "它看起来像是某种工具……也许这就是他在找的东西！"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.WAGSTAFF_TOOL_3
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.WAGSTAFF_TOOL_3"
msgid "We found it! He'll be so happy!"
msgstr "我们找到了！他一定会很开心！"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.WAGSTAFF_TOOL_4
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.WAGSTAFF_TOOL_4"
msgid "We found a tool! Maybe it's the one he's looking for?"
msgstr "我们找到一个工具了！也许这就是他在找的东西？"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.WAGSTAFF_TOOL_5
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.WAGSTAFF_TOOL_5"
msgid "Maybe this is what he was looking for?"
msgstr "也许他想找到就是这个？"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.WALKINGPLANK
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.WALKINGPLANK"
msgid "It's the least fun diving board."
msgstr "最无聊的跳水板。"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.WALKINGPLANK_ANCIENT
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.WALKINGPLANK_ANCIENT"
msgid "It's the least fun diving board."
msgstr "最无聊的跳水板。"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.WALKINGPLANK_GRASS
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.WALKINGPLANK_GRASS"
msgid "It's the least fun diving board."
msgstr "最无聊的跳水板。"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.WALKINGPLANK_YOTD
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.WALKINGPLANK_YOTD"
msgid "It's not much fun, but at least it's pretty."
msgstr "不太好玩，但是很漂亮。"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.WALKING_STICK
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.WALKING_STICK"
msgid "It's sticky, but not like a web."
msgstr "它有粘性，但不像网。"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.WALL_DREADSTONE
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.WALL_DREADSTONE"
msgid "It looks kinda scary..."
msgstr "看起来有些可怕……"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.WALL_DREADSTONE_ITEM
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.WALL_DREADSTONE_ITEM"
msgid "Do we have to build it?"
msgstr "我们一定要建吗？"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.WALL_HAY.BURNT
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.WALL_HAY.BURNT"
msgid "It didn't keep the fire out."
msgstr "但它挡不住火。"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.WALL_HAY.GENERIC
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.WALL_HAY.GENERIC"
msgid "This will keep all sorts of things out!"
msgstr "这可以挡住任何东西！"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.WALL_HAY_ITEM
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.WALL_HAY_ITEM"
msgid "Some grass tied together."
msgstr "绑在一起的草。"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.WALL_MOONROCK
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.WALL_MOONROCK"
msgid "We feel safe behind this wall... it makes us sleepy..."
msgstr "这堵墙让我们觉得很安全...它让我们很想睡觉..."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.WALL_MOONROCK_ITEM
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.WALL_MOONROCK_ITEM"
msgid "We thought \"moon\" meant something totally different!"
msgstr "我们曾以为“月亮”代表着另一种完全不同的东西！"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.WALL_RUINS
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.WALL_RUINS"
msgid "Looks sturdy."
msgstr "看起来很坚固。"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.WALL_RUINS_2
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.WALL_RUINS_2"
msgid "Looks sturdy."
msgstr "看起来很坚固。"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.WALL_RUINS_ITEM
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.WALL_RUINS_ITEM"
msgid "Wow, these are really heavy."
msgstr "噢！太重了。"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.WALL_SCRAP
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.WALL_SCRAP"
msgid "Junk, junk, junk!"
msgstr "垃圾，垃圾！"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.WALL_SCRAP_ITEM
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.WALL_SCRAP_ITEM"
msgid "Junk, junk, junk!"
msgstr "垃圾，垃圾！"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.WALL_STONE
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.WALL_STONE"
msgid "Bow to the base-building masters!"
msgstr "向建造营地的大师鞠躬！"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.WALL_STONE_2
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.WALL_STONE_2"
msgid "Bow to the base-building masters!"
msgstr "向建造营地的大师鞠躬！"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.WALL_STONE_ITEM
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.WALL_STONE_ITEM"
msgid "These should come in handy."
msgstr "这些迟早派得上用场。"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.WALL_WOOD.BURNT
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.WALL_WOOD.BURNT"
msgid "Turns out wood burns really well."
msgstr "木头果然是最容易烧着的东西。"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.WALL_WOOD.GENERIC
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.WALL_WOOD.GENERIC"
msgid "Like a pillow fort, but wood!"
msgstr "像一座枕头城堡，不过是木头做的！"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.WALL_WOOD_ITEM
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.WALL_WOOD_ITEM"
msgid "They won't keep us safe if we keep holding them."
msgstr "如果我们就这样拿着它们，那它们是没法保卫我们安全的。"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.WALRUS
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.WALRUS"
msgid "I don't think he wants to be friends with us."
msgstr "他应该不想和我们交朋友吧。"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.WALRUSHAT
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.WALRUSHAT"
msgid "Reminds me of grandpa."
msgstr "让我想起了爷爷。"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.WALRUS_CAMP.EMPTY
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.WALRUS_CAMP.EMPTY"
msgid "I think someone was here."
msgstr "我猜这里以前有人住过。"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.WALRUS_CAMP.GENERIC
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.WALRUS_CAMP.GENERIC"
msgid "Maybe they'll invite us in?"
msgstr "也许他们会邀请我们进去？"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.WALRUS_TUSK
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.WALRUS_TUSK"
msgid "Maybe we can use it for arts and crafts."
msgstr "也许我们可以用它来合成其他东西。"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.WALTER.ATTACKER
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.WALTER.ATTACKER"
msgid "That wasn't very nice, %s!"
msgstr "这样不好，%s！"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.WALTER.FIRESTARTER
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.WALTER.FIRESTARTER"
msgid "Oh... s-should we start making a fire too?"
msgstr "哦.……我们要不要也生个火？"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.WALTER.GENERIC
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.WALTER.GENERIC"
msgid "Hey %s! Can we pet Woby?"
msgstr "嘿 %s！我能摸摸沃比吗？"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.WALTER.GHOST
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.WALTER.GHOST"
msgid "Oh no! What should we do, %s?"
msgstr "噢，不！我们应该怎么做，%s?"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.WALTER.MURDERER
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.WALTER.MURDERER"
msgid "%s? We thought we were all friends!"
msgstr "%s？我们一直把你当朋友的！"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.WALTER.REVIVER
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.WALTER.REVIVER"
msgid "%s is the best!"
msgstr "%s最棒了！"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.WALTERHAT
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.WALTERHAT"
msgid "Can we be a Pioneer too?"
msgstr "我们能不能也加入先锋队？"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.WANDA.ATTACKER
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.WANDA.ATTACKER"
msgid "That's not very nice, %s!"
msgstr "那样可不好，%s！"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.WANDA.FIRESTARTER
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.WANDA.FIRESTARTER"
msgid "Stop it, %s! You're gonna get in trouble!"
msgstr "住手，%s！你会惹上麻烦的！"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.WANDA.GENERIC
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.WANDA.GENERIC"
msgid "Hey %s! Have you been any-when interesting lately?"
msgstr "嘿，%s！你最近看到有意思的事情了吗？"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.WANDA.GHOST
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.WANDA.GHOST"
msgid "Uh oh, %s needs help!"
msgstr "啊噢，%s需要帮助！"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.WANDA.MURDERER
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.WANDA.MURDERER"
msgid "We never wanna see you again, not after what you did!"
msgstr "在你做了那事之后，我们再也不想见到你了！"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.WANDA.REVIVER
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.WANDA.REVIVER"
msgid "Thanks %s! We hope it didn't take up too much of your time..."
msgstr "多谢，%s！希望没有太占用你的时间……"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.WANDERINGTRADER.GENERIC
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.WANDERINGTRADER.GENERIC"
msgid "It looks weird."
msgstr "它看起来很奇怪。"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.WANDERINGTRADER.REVEALED
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.WANDERINGTRADER.REVEALED"
msgid "What does he have for us?"
msgstr "他给我们带了些什么？"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.WARDROBE.BURNING
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.WARDROBE.BURNING"
msgid "Fire fire fire!"
msgstr "燃烧，尽情地燃烧吧！"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.WARDROBE.BURNT
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.WARDROBE.BURNT"
msgid "We can't hide in there any more."
msgstr "我们再也不能躲在里面了。"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.WARDROBE.GENERIC
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.WARDROBE.GENERIC"
msgid "We like to pop out and scare our friends sometimes. Haha!"
msgstr "有时我们喜欢蹦出来，吓吓朋友。哈哈！"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.WARG
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.WARG"
msgid "I don't think that puppy is very happy."
msgstr "这只狗狗看起来不太高兴。"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.WARGCORPSE.BURNING
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.WARGCORPSE.BURNING"
msgid "Good-bye puppy."
msgstr "再见小狗。"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.WARGCORPSE.GENERIC
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.WARGCORPSE.GENERIC"
msgid "We shouldn't just leave him like that..."
msgstr "我们不应该就这样离开他……"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.WARGCORPSE.REVIVING
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.WARGCORPSE.REVIVING"
msgid "W-we don't think that's supposed to happen!"
msgstr "怎么还能这样！"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.WARGLET
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.WARGLET"
msgid "N-nice puppy..."
msgstr "乖...乖狗狗……"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.WARGSHRINE.BURNT
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.WARGSHRINE.BURNT"
msgid "The fire destroyed it."
msgstr "大火摧毁了它。"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.WARGSHRINE.EMPTY
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.WARGSHRINE.EMPTY"
msgid "Let's put the torch in!"
msgstr "我们把火把放进去吧！"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.WARGSHRINE.GENERIC
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.WARGSHRINE.GENERIC"
msgid "It wants to give us presents!"
msgstr "它想送我们礼物！"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.WARLY.ATTACKER
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.WARLY.ATTACKER"
msgid "%s, don't you think you should say sorry?"
msgstr "%s，你是不是应该道歉？"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.WARLY.FIRESTARTER
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.WARLY.FIRESTARTER"
msgid "We don't think you were supposed to start that fire."
msgstr "我们觉得你不该放那把火。"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.WARLY.GENERIC
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.WARLY.GENERIC"
msgid "Hey %s! Do you have any snacks?"
msgstr "嘿%s！你还有零食吗？"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.WARLY.GHOST
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.WARLY.GHOST"
msgid "Oh no, %s is hurt!"
msgstr "哦不，%s受伤了！"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.WARLY.MURDERER
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.WARLY.MURDERER"
msgid "We thought you were nice!"
msgstr "我们还以为你很善良呢！"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.WARLY.REVIVER
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.WARLY.REVIVER"
msgid "Thanks a bunch, %s!"
msgstr "多谢啦，%s！"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.WAR_BLUEPRINT
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.WAR_BLUEPRINT"
msgid "Our beefalo might look scary in this, but we know they're really a big softy!"
msgstr "我们的皮弗娄牛穿上这个虽然看起来会很吓人，但我们知道它其实很温柔!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.WASPHIVE
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.WASPHIVE"
msgid "Sounds like anger!"
msgstr "它们好像发怒了！"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.WATERBALLOON
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.WATERBALLOON"
msgid "We have to be gentle with our claws if we try to hold it!"
msgstr "握住爪爪时，得当心！"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.WATERINGCAN.EMPTY
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.WATERINGCAN.EMPTY"
msgid "Hey, there's no water in it!"
msgstr "嘿，这里面没有水了！"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.WATERINGCAN.GENERIC
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.WATERINGCAN.GENERIC"
msgid "We're going to go water the garden now!"
