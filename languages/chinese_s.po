msgstr "太咸了。"

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.SALTLICK_IMPROVED
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.SALTLICK_IMPROVED"
