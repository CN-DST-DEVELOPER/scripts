msgstr "总要有人组装锚，就让我来吧。"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.ANCIENTFRUIT_GEM
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.ANCIENTFRUIT_GEM"
msgid "For a fruit, it's one tough nut to crack."
msgstr "这个水果皮真厚。"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.ANCIENTFRUIT_NIGHTVISION
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.ANCIENTFRUIT_NIGHTVISION"
msgid "I don't think berries are supposed to do that."
msgstr "浆果还能做这个？"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.ANCIENTFRUIT_NIGHTVISION_COOKED
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.ANCIENTFRUIT_NIGHTVISION_COOKED"
msgid "At least it ain't pulsin'."
msgstr "至少它不会脉动了。"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.ANCIENTTREE_GEM.GENERIC
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.ANCIENTTREE_GEM.GENERIC"
msgid "That tree has got fire in its belly."
msgstr "那棵树肚子里有火。"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.ANCIENTTREE_GEM.STUMP
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.ANCIENTTREE_GEM.STUMP"
msgid "Just a pile of rubble now."
msgstr "现在只剩下一堆瓦砾。"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.ANCIENTTREE_NIGHTVISION.GENERIC
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.ANCIENTTREE_NIGHTVISION.GENERIC"
msgid "That is one gloomy tree."
msgstr "这棵树真够阴沉的。"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.ANCIENTTREE_NIGHTVISION.STUMP
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.ANCIENTTREE_NIGHTVISION.STUMP"
msgid "Can't say I'm sad to see it gone."
msgstr "它没了我没有难过。"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.ANCIENTTREE_SAPLING.GENERIC
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.ANCIENTTREE_SAPLING.GENERIC"
msgid "Looks like it's on its way."
msgstr "看起来它会成长的。"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.ANCIENTTREE_SAPLING.WRONG_SEASON
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.ANCIENTTREE_SAPLING.WRONG_SEASON"
msgid "I don't think the time is right."
msgstr "我觉得现在这个时间还不对。"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.ANCIENTTREE_SAPLING.WRONG_TILE
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.ANCIENTTREE_SAPLING.WRONG_TILE"
msgid "Maybe it ain't in the right spot."
msgstr "也许是它位置不对。"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.ANCIENTTREE_SAPLING_ITEM
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.ANCIENTTREE_SAPLING_ITEM"
msgid "This might be one of them finicky trees."
msgstr "这可能是其中一棵很挑剔的树。"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.ANCIENTTREE_SEED
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.ANCIENTTREE_SEED"
msgid "I believe this goes in the dirt."
msgstr "我确定这个是要放进土里的。"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.ANCIENT_ALTAR
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.ANCIENT_ALTAR"
msgid "Some incredible stuff could be assembled here."
msgstr "可以在这里组装一些奇妙的东西。"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.ANCIENT_ALTAR_BROKEN
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.ANCIENT_ALTAR_BROKEN"
msgid "Needs a good fixin'."
msgstr "需要好好修理一番。"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.ANCIENT_HUSK
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.ANCIENT_HUSK"
msgid "That looks... complicated."
msgstr "那个看起来……很复杂。"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.ANCIENT_STATUE
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.ANCIENT_STATUE"
msgid "I'd never wanna meet one in person."
msgstr "我可不想真正遇到一个。"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.ANIMAL_TRACK
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.ANIMAL_TRACK"
msgid "Something tasty passed through here."
msgstr "有什么美味经过了这里。"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.ANTCHOVIES
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.ANTCHOVIES"
msgid "We all feel like a fish outta water sometimes."
msgstr "有时候，我们自己也会感觉到像离开水的鱼一样。"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.ANTLION.GENERIC
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.ANTLION.GENERIC"
msgid "How's the weather up there?"
msgstr "天气怎么样？"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.ANTLION.UNHAPPY
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.ANTLION.UNHAPPY"
msgid "That is not a happy monster."
msgstr "那只怪物看起来不怎么开心。"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.ANTLION.VERYHAPPY
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.ANTLION.VERYHAPPY"
msgid "Looks like we're safe for awhile."
msgstr "看来我们暂时安全了。"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.ANTLIONHAT
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.ANTLIONHAT"
msgid "It sure makes landscaping a breeze!"
msgstr "它能让园林绿化工作变得轻而易举！"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.ANTLIONTRINKET
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.ANTLIONTRINKET"
msgid "It's a colorful bucket."
msgstr "这是一只五颜六色的桶。"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.ARCHIVE_CENTIPEDE
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.ARCHIVE_CENTIPEDE"
msgid "Feelin' feisty now, are we?"
msgstr "现在感觉很有活力，是吗？"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.ARCHIVE_CENTIPEDE_HUSK
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.ARCHIVE_CENTIPEDE_HUSK"
msgid "Wonder what made these things tick?"
msgstr "不知道是什么让这些东西动起来的？"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.ARCHIVE_COOKPOT.BURNT
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.ARCHIVE_COOKPOT.BURNT"
msgid "You guys like gristle, right?"
msgstr "你们喜欢吃脆骨吧，是不是？"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.ARCHIVE_COOKPOT.COOKING_LONG
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.ARCHIVE_COOKPOT.COOKING_LONG"
msgid "Still got a bit of a wait."
msgstr "还要等一会。"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.ARCHIVE_COOKPOT.COOKING_SHORT
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.ARCHIVE_COOKPOT.COOKING_SHORT"
msgid "Almost!"
msgstr "就快好了！"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.ARCHIVE_COOKPOT.DONE
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.ARCHIVE_COOKPOT.DONE"
msgid "Soup's on!"
msgstr "上汤了！"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.ARCHIVE_COOKPOT.EMPTY
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.ARCHIVE_COOKPOT.EMPTY"
msgid "Seems to be the only thing those critters haven't dusted."
msgstr "似乎是那些小动物唯一没有掸过的东西。"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.ARCHIVE_LOCKBOX
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.ARCHIVE_LOCKBOX"
msgid "I'm thinkin' this might be a cog for a larger machine."
msgstr "我想这可能是一个更大的机器的齿轮。"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.ARCHIVE_LOCKBOX_DISPENCER.GENERIC
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.ARCHIVE_LOCKBOX_DISPENCER.GENERIC"
msgid "Now that's one fine piece of engineering!"
msgstr "这真是一件工程杰作啊！"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.ARCHIVE_LOCKBOX_DISPENCER.POWEROFF
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.ARCHIVE_LOCKBOX_DISPENCER.POWEROFF"
msgid "Looks like it needs some power to get it going."
msgstr "看来它需要一些动力才能启动。"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.ARCHIVE_MOON_STATUE
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.ARCHIVE_MOON_STATUE"
msgid "All that material wasted on some decoration."
msgstr "那么多材料都浪费在装饰上了。"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.ARCHIVE_ORCHESTRINA_MAIN
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.ARCHIVE_ORCHESTRINA_MAIN"
msgid "Some mighty complicated engineering went into this."
msgstr "这东西经过了强大的工程制造。"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.ARCHIVE_PORTAL.GENERIC
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.ARCHIVE_PORTAL.GENERIC"
msgid "Come on! Why won't you work?"
msgstr "什么情况！你为什么不工作？"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.ARCHIVE_PORTAL.POWEROFF
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.ARCHIVE_PORTAL.POWEROFF"
msgid "Is that... a portal? Maybe we can get it up and running!"
msgstr "那是……一扇传送门吗？也许我们可以让它运转起来！"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.ARCHIVE_RESONATOR.GENERIC
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.ARCHIVE_RESONATOR.GENERIC"
msgid "Might as well see where the trail leads."
msgstr "看看这条小路会通向哪里。"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.ARCHIVE_RESONATOR.IDLE
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.ARCHIVE_RESONATOR.IDLE"
msgid "Guess we got 'em all!"
msgstr "这下全给我们找到了！"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.ARCHIVE_RESONATOR_ITEM
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.ARCHIVE_RESONATOR_ITEM"
msgid "They sure knew how to build 'em back in the day."
msgstr "当年他们肯定知道如何建造它们。"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.ARCHIVE_RUNE_STATUE.LINE_1
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.ARCHIVE_RUNE_STATUE.LINE_1"
msgid "I can't make heads or tails of it."
msgstr "我完全摸不着头脑。"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.ARCHIVE_RUNE_STATUE.LINE_2
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.ARCHIVE_RUNE_STATUE.LINE_2"
msgid "Ancient writing ain't exactly my specialty."
msgstr "古文写作并不是我的专长。"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.ARCHIVE_RUNE_STATUE.LINE_3
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.ARCHIVE_RUNE_STATUE.LINE_3"
msgid "I can't make heads or tails of it."
msgstr "我完全摸不着头脑。"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.ARCHIVE_RUNE_STATUE.LINE_4
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.ARCHIVE_RUNE_STATUE.LINE_4"
msgid "Ancient writing ain't exactly my specialty."
msgstr "古文写作并不是我的专长。"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.ARCHIVE_RUNE_STATUE.LINE_5
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.ARCHIVE_RUNE_STATUE.LINE_5"
msgid "I can't make heads or tails of it."
msgstr "我完全摸不着头脑。"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.ARCHIVE_SECURITY_DESK.GENERIC
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.ARCHIVE_SECURITY_DESK.GENERIC"
msgid "They really built things to last back then."
msgstr "那时候他们造的东西可以说是经久耐用。"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.ARCHIVE_SECURITY_DESK.POWEROFF
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.ARCHIVE_SECURITY_DESK.POWEROFF"
msgid "Bet if it had some power it'd start right up."
msgstr "如果它通能后，一定会马上启动。"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.ARCHIVE_SECURITY_PULSE
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.ARCHIVE_SECURITY_PULSE"
msgid "Just where do you think you're going?"
msgstr "你觉得你要去哪里？"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.ARCHIVE_SWITCH.GEMS
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.ARCHIVE_SWITCH.GEMS"
msgid "This one needs a power source."
msgstr "这个需要一个能量源。"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.ARCHIVE_SWITCH.VALID
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.ARCHIVE_SWITCH.VALID"
msgid "Seems like all three need a power source to complete the circuit."
msgstr "看来三者都需要一个能量源来完成电路。"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.ARMORDRAGONFLY
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.ARMORDRAGONFLY"
msgid "Bit flashy, hey?"
msgstr "有点花哨，不是吗？"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.ARMORDREADSTONE
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.ARMORDREADSTONE"
msgid "That's some real high-grade protective equipment."
msgstr "那才是真正的高级防护设备。"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.ARMORGRASS
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.ARMORGRASS"
msgid "Not at all useful."
msgstr "没一点用。"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.ARMORMARBLE
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.ARMORMARBLE"
msgid "Protects your inner workings."
msgstr "保护你的五脏六腑。"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.ARMORRUINS
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.ARMORRUINS"
msgid "Not a bad piece of work."
msgstr "做工还不赖。"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.ARMORSKELETON
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.ARMORSKELETON"
msgid "A bit creepy, isn't it?"
msgstr "有点吓人，是吧？"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.ARMORSLURPER
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.ARMORSLURPER"
msgid "So tight I barely remember the gnawing hunger!"
msgstr "紧得我都忘了肚子饿！"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.ARMORSNURTLESHELL
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.ARMORSNURTLESHELL"
msgid "Go ahead, give'it a punch."
msgstr "来，打一拳试试看。"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.ARMORWAGPUNK
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.ARMORWAGPUNK"
msgid "Well ain't that a fancy lil' robo-romper."
msgstr "瞧瞧那条花哨的机械连体裤。"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.ARMORWOOD
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.ARMORWOOD"
msgid "Punch me! It does nothing! Ha!"
msgstr "锤我一拳吧！挠痒一样！哈哈！"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.ARMOR_BRAMBLE
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.ARMOR_BRAMBLE"
msgid "Odd design. How do you wear it without pricking yourself?"
msgstr "古怪的设计。怎么穿才能不刺伤自己呢？"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.ARMOR_CARROTLURE
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.ARMOR_CARROTLURE"
msgid "Huh. Guess ya can make clothes out of just about anything."
msgstr "哈哈，什么东西都可以用来制作衣服了。"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.ARMOR_LUNARPLANT
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.ARMOR_LUNARPLANT"
msgid "Built to last!"
msgstr "经久耐用！"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.ARMOR_LUNARPLANT_HUSK
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.ARMOR_LUNARPLANT_HUSK"
msgid "Pretty well constructed, for a plant."
msgstr "对于植物来说，构造相当精巧。"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.ARMOR_SANITY
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.ARMOR_SANITY"
msgid "Soothingly unsettling."
msgstr "让人心神不宁。"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.ARMOR_VOIDCLOTH
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.ARMOR_VOIDCLOTH"
msgid "Looks pretty tattered, will it really protect me from anything?"
msgstr "看起来这么破烂，真的能保护我不受伤害吗？"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.ARMOR_YOTH_KNIGHT
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.ARMOR_YOTH_KNIGHT"
msgid "I'd know that rose anywhere."
msgstr "那朵玫瑰我走到哪都认得。"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.ARROWSIGN_PANEL.BURNT
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.ARROWSIGN_PANEL.BURNT"
msgid "Burnt to cinders."
msgstr "烧成灰烬。"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.ARROWSIGN_PANEL.GENERIC
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.ARROWSIGN_PANEL.GENERIC"
msgid "I'll take this as a sign."
msgstr "大概是个标识牌。"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.ARROWSIGN_PANEL.UNWRITTEN
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.ARROWSIGN_PANEL.UNWRITTEN"
msgid "Just waiting for some scribbles."
msgstr "需要谁写点东西上去。"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.ARROWSIGN_POST.BURNT
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.ARROWSIGN_POST.BURNT"
msgid "Burnt to cinders."
msgstr "烧成灰烬。"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.ARROWSIGN_POST.GENERIC
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.ARROWSIGN_POST.GENERIC"
msgid "I'll take this as a sign."
msgstr "大概是个标识牌。"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.ARROWSIGN_POST.UNWRITTEN
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.ARROWSIGN_POST.UNWRITTEN"
msgid "Just waiting for some scribbles."
msgstr "需要谁写点东西上去。"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.ASH.GENERIC
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.ASH.GENERIC"
msgid "Sooty."
msgstr "黑乎乎的。"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.ASH.REMAINS_EYE_BONE
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.ASH.REMAINS_EYE_BONE"
msgid "Burnt up eye stick."
msgstr "被烧焦的眼杖。"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.ASH.REMAINS_GLOMMERFLOWER
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.ASH.REMAINS_GLOMMERFLOWER"
msgid "Burnt bits of big ol' buzzer."
msgstr "被烧成了灰。"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.ASH.REMAINS_THINGIE
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.ASH.REMAINS_THINGIE"
msgid "That was a... Y'know! A thing."
msgstr "那是……你懂的！一个什么东西。"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.ASPARAGUS
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.ASPARAGUS"
msgid "Makes ya big and strong."
msgstr "让你变得强壮。"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.ASPARAGUSSOUP
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.ASPARAGUSSOUP"
msgid "Huh. Interesting choice but I ain't complainin'!"
msgstr "哈。这个选择有意思，不过我没在抱怨！"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.ASPARAGUS_COOKED
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.ASPARAGUS_COOKED"
msgid "I'm not fussy."
msgstr "我不挑。"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.ASPARAGUS_OVERSIZED
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.ASPARAGUS_OVERSIZED"
msgid "I'll bet there's a ton of iron in that."
msgstr "里面一定有成吨的铁元素。"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.ASPARAGUS_SEEDS
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.ASPARAGUS_SEEDS"
msgid "What's this going to grow into, I wonder."
msgstr "我好奇会长出什么。"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.ATRIUM_GATE.CHARGING
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.ATRIUM_GATE.CHARGING"
msgid "It's gearing up for something."
msgstr "它正在预备着什么。"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.ATRIUM_GATE.COOLDOWN
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.ATRIUM_GATE.COOLDOWN"
msgid "It won't be running again for awhile."
msgstr "一时半会儿是不能用了。"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.ATRIUM_GATE.DESTABILIZING
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.ATRIUM_GATE.DESTABILIZING"
msgid "I don't think we oughta be here when it goes off!"
msgstr "它要启动的时候我们不该待在这！"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.ATRIUM_GATE.OFF
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.ATRIUM_GATE.OFF"
msgid "Oughta turn on somehow."
msgstr "应该有什么方法可以启动。"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.ATRIUM_GATE.ON
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.ATRIUM_GATE.ON"
msgid "Not sure I trust strange portals anymore."
msgstr "不确定我还会不会再相信这些奇怪的传送门。"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.ATRIUM_KEY
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.ATRIUM_KEY"
msgid "Some sort of old power source."
msgstr "某种古老的力量来源。"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.ATRIUM_LIGHT.OFF
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.ATRIUM_LIGHT.OFF"
msgid "I think it's supposed to turn on."
msgstr "我猜它本来应该是亮着的。"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.ATRIUM_LIGHT.ON
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.ATRIUM_LIGHT.ON"
msgid "Not sure how it works."
msgstr "不确定它是怎么工作的。"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.ATRIUM_OVERGROWTH
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.ATRIUM_OVERGROWTH"
msgid "Don't think it's supposed to look like that."
msgstr "我觉得它不应该是那个样子的。"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.ATRIUM_RUBBLE.LINE_1
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.ATRIUM_RUBBLE.LINE_1"
msgid "There's a picture on it of some strangely shaped people."
msgstr "上面有一幅画，画的是一些奇形怪状的人。"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.ATRIUM_RUBBLE.LINE_2
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.ATRIUM_RUBBLE.LINE_2"
msgid "Can't make heads or tails of this picture."
msgstr "弄不清这幅画的含义。"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.ATRIUM_RUBBLE.LINE_3
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.ATRIUM_RUBBLE.LINE_3"
msgid "The people are drowning in axle grease."
msgstr "一群人被润滑油淹没了。"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.ATRIUM_RUBBLE.LINE_4
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.ATRIUM_RUBBLE.LINE_4"
msgid "Yuck. Something grotesque is happening in this picture."
msgstr "呃。这幅画上尽是一些光怪陆离的东西。"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.ATRIUM_RUBBLE.LINE_5
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.ATRIUM_RUBBLE.LINE_5"
msgid "A picture of a beautiful, well engineered city."
msgstr "画的是一座美丽而设计巧妙的城市。"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.ATRIUM_STATUE
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.ATRIUM_STATUE"
msgid "It's giving me goosebumps."
msgstr "它让我浑身起鸡皮疙瘩。"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.AXE
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.AXE"
msgid "I was never the \"woodsy\" type."
msgstr "我对伐木兴致不高。"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.BABYBEEFALO.GENERIC
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.BABYBEEFALO.GENERIC"
msgid "You're not too young to work."
msgstr "小家伙也应该去干活。"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.BABYBEEFALO.SLEEPING
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.BABYBEEFALO.SLEEPING"
msgid "You're too young to be lazy."
msgstr "小小年纪睡什么觉。"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.BACKPACK
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.BACKPACK"
msgid "I don't mind playing pack mule."
msgstr "我不介意当送货的骡子。"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.BACONEGGS
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.BACONEGGS"
msgid "A hearty breakfast for a full day's work."
msgstr "一天劳作之前的丰盛早餐。"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.BALATRO_MACHINE
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.BALATRO_MACHINE"
msgid "What could go wrong?"
msgstr "会出什么问题？"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.BALLOON
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.BALLOON"
msgid "Oh! A balloon."
msgstr "喔！一个气球。"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.BALLOONHAT
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.BALLOONHAT"
msgid "Cute, but it won't protect your noggin' from much."
msgstr "很可爱，但它保护不了你。"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.BALLOONPARTY
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.BALLOONPARTY"
msgid "We can celebrate once the work is done."
msgstr "等工作做完了再庆祝。"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.BALLOONSPEED.DEFLATED
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.BALLOONSPEED.DEFLATED"
msgid "Better not leave that unattended."
msgstr "最好不要让它无人看管。"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.BALLOONSPEED.GENERIC
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.BALLOONSPEED.GENERIC"
msgid "It's full of get up and go!"
msgstr "充满了干劲！"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.BALLOONS_EMPTY
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.BALLOONS_EMPTY"
msgid "No fun without Wes."
msgstr "韦斯不在就不好玩了。"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.BALLOONVEST
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.BALLOONVEST"
msgid "I think he's trying to be helpful... in his own way."
msgstr "我想他在用自己的方式……帮大家。"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.BANANABUSH
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.BANANABUSH"
msgid "Sure beats goin' down to the caves."
msgstr "肯定比下洞穴去好。"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.BANANAJUICE
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.BANANAJUICE"
msgid "Would ya look at that, you can juice 'em too!"
msgstr "你瞧瞧，你还可以给它们榨汁！"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.BANANAPOP
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.BANANAPOP"
msgid "Cool and refreshin'!"
msgstr "清凉醒脑！"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.BANDAGE
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.BANDAGE"
msgid "Takes care of workplace injuries."
msgstr "可以用来应对工伤。"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.BANDAGE_BUTTERFLYWINGS
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.BANDAGE_BUTTERFLYWINGS"
msgid "Almost makes me wish I had a lil' boo-boo."
msgstr "我都想给自己弄出个小伤口来了。"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.BARNACLE
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.BARNACLE"
msgid "Took a bit of elbow grease to harvest 'em."
msgstr "花了点力气收割了它们。"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.BARNACLEPITA
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.BARNACLEPITA"
msgid "That's good eatin!"
msgstr "吃得真香！"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.BARNACLESTUFFEDFISHHEAD
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.BARNACLESTUFFEDFISHHEAD"
msgid "I'm all for using the materials you've got."
msgstr "我十分赞成利用好手里的材料做菜。"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.BARNACLESUSHI
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.BARNACLESUSHI"
msgid "Can't say I've ever tasted somethin' quite like that before."
msgstr "我以前还真没吃过这种东西。"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.BARNACLE_COOKED
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.BARNACLE_COOKED"
msgid "They're kinda chewier than I expected."
msgstr "它们比我想象的要有嚼劲。"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.BARNACLINGUINE
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.BARNACLINGUINE"
msgid "Nothin' like a pot full of pasta."
msgstr "没有什么能比得上一锅满满的意大利面。"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.BASALT
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.BASALT"
msgid "Great, it's a rock."
msgstr "好极了，一块石头。"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.BAT
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.BAT"
msgid "Flyin' rodent."
msgstr "会飞的啮齿动物。"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.BATBAT
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.BATBAT"
msgid "Ha! Clever."
msgstr "哈！聪明。"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.BATCAVE
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.BATCAVE"
msgid "I'm gonna leave that right alone."
msgstr "我还是不去惹它吧。"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.BATHBOMB
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.BATHBOMB"
msgid "I'm not really the frou-frou type."
msgstr "我不喜欢花俏的东西。"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.BATNOSE
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.BATNOSE"
msgid "Got yer nose!"
msgstr "抓住你的鼻子了！"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.BATNOSEHAT
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.BATNOSEHAT"
msgid "Pretty practical if you ask me."
msgstr "你问我意见的话，我会说很实用。"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.BATNOSE_COOKED
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.BATNOSE_COOKED"
msgid "I ain't picky."
msgstr "我不挑食。"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.BATTLESONG_CONTAINER
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.BATTLESONG_CONTAINER"
msgid "That is some fancy song holder."
msgstr "这曲筒真是高级。"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.BATTLESONG_DURABILITY
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.BATTLESONG_DURABILITY"
msgid "Opera's a bit hoity-toity for me."
msgstr "歌剧是那些势利眼才喜欢的东西。"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.BATTLESONG_FIRERESISTANCE
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.BATTLESONG_FIRERESISTANCE"
msgid "Opera's a bit hoity-toity for me."
msgstr "歌剧是那些势利眼才喜欢的东西。"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.BATTLESONG_HEALTHGAIN
