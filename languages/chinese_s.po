msgstr "让我想起了妈妈！"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.SPEAR
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.SPEAR"
msgid "It lacks the heft of a good solid axe."
msgstr "比起一把坚实的好斧子，它的重量还轻了点。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.SPEAR_GUNGNIR
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.SPEAR_GUNGNIR"
msgid "I'd take a stab at it."
msgstr "我来试试它。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.SPEAR_LANCE
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.SPEAR_LANCE"
msgid "I could give it a whirl."
msgstr "我可以试试它。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.SPEAR_WATHGRITHR
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.SPEAR_WATHGRITHR"
msgid "Who needs a spear when you got ol'Luce?"
msgstr "有了老露西时，谁还需要长矛？"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.SPEAR_WATHGRITHR_LIGHTNING
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.SPEAR_WATHGRITHR_LIGHTNING"
msgid "Luce, I swear. Lightning attacks aren't important to me."
msgstr "露西，我发誓：闪电攻击对我一点都不重要。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.SPICEPACK
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.SPICEPACK"
msgid "A handy knapsack for conserving food!"
msgstr "装饰物的方便小包！"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.SPICE_CHILI
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.SPICE_CHILI"
msgid "Yep. That's a spicy sauce."
msgstr "嗯，是种辣酱。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.SPICE_GARLIC
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.SPICE_GARLIC"
msgid "I suppose some spice couldn't hurt."
msgstr "加点调味品挺好的。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.SPICE_SALT
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.SPICE_SALT"
msgid "Good fer melting ice, too!"
msgstr "还能用来融冰融雪！"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.SPICE_SUGAR
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.SPICE_SUGAR"
msgid "I prefer my syrup to be maple."
msgstr "糖浆我只吃枫叶糖浆。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.SPIDER.DEAD
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.SPIDER.DEAD"
