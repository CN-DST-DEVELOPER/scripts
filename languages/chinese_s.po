msgstr "我要给它找到实际的用处。"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.MALBATROSS_FEATHERED_WEAVE
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.MALBATROSS_FEATHERED_WEAVE"
msgid "Now that's some fancy fabric."
msgstr "这些是高级布料。"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.MALE_PUPPET
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.MALE_PUPPET"
msgid "He doesn't look none too happy."
msgstr "他看起来不太高兴。"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.MANDRAKE
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.MANDRAKE"
msgid "Dead as a doornail."
msgstr "死翘翘。"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.MANDRAKESOUP
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.MANDRAKESOUP"
