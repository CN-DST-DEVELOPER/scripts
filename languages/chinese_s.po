msgid "How are you, boo?"
msgstr "你还好吗，小样？"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.ABIGAIL_FLOWER.GENERIC
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.ABIGAIL_FLOWER.GENERIC"
msgid "What a nice little flower."
msgstr "好一朵漂亮的小花。"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.ABIGAIL_FLOWER.HAUNTED_GROUND
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.ABIGAIL_FLOWER.HAUNTED_GROUND"
msgid "What do you want? Water?"
msgstr "你想要什么？水？"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.ABIGAIL_FLOWER.HAUNTED_POCKET
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.ABIGAIL_FLOWER.HAUNTED_POCKET"
msgid "It wants down."
msgstr "它想下来。"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.ABIGAIL_FLOWER.LEVEL1
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.ABIGAIL_FLOWER.LEVEL1"
msgid "Looks like someone needed a break."
msgstr "看起来有人需要休个假。"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.ABIGAIL_FLOWER.LEVEL2
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.ABIGAIL_FLOWER.LEVEL2"
msgid "Up'n'attem! The day's a-wasting!"
msgstr "忙起来！别磨洋工！"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.ABIGAIL_FLOWER.LEVEL3
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.ABIGAIL_FLOWER.LEVEL3"
msgid "That flower looks raring to go."
msgstr "那朵花看起来想要怒放。"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.ABIGAIL_FLOWER.LONG
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.ABIGAIL_FLOWER.LONG"
msgid "What a nice little flower."
msgstr "好一朵漂亮的小花。"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.ABIGAIL_FLOWER.MEDIUM
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.ABIGAIL_FLOWER.MEDIUM"
msgid "It's getting antsy."
msgstr "有点焦躁不安了。"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.ABIGAIL_FLOWER.SOON
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.ABIGAIL_FLOWER.SOON"
msgid "Something's coming."
msgstr "有什么要来了。"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.ABYSSPILLAR_MINION.ACTIVATED
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.ABYSSPILLAR_MINION.ACTIVATED"
msgid "Hey, quit it!"
msgstr "嘿，别闹了！"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.ABYSSPILLAR_MINION.GENERIC
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.ABYSSPILLAR_MINION.GENERIC"
msgid "I don't trust them statues."
msgstr "我信不过雕像。"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.ABYSSPILLAR_TRIAL
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.ABYSSPILLAR_TRIAL"
msgid "Levers were made for pullin'."
msgstr "杠杆做出来就是用来拉的。"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.ACCOMPLISHMENT_SHRINE
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.ACCOMPLISHMENT_SHRINE"
msgid "A testament to my achievements. Or lack of them."
msgstr "我丰功伟绩或一事无成的证明。"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.ACORN
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.ACORN"
msgid "Everything you need to build a tree."
msgstr "长成一棵大树所需要的一切。"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.ACORN_COOKED
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.ACORN_COOKED"
msgid "Looks edible. One way to find out!"
msgstr "看上去可以吃，试试就知道了！"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.ACORN_SAPLING
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.ACORN_SAPLING"
msgid "This tree's still under construction."
msgstr "这棵树仍在成长中。"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.ADVENTURE_PORTAL
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.ADVENTURE_PORTAL"
msgid "I ain't jumping willy-nilly through strange portals!"
msgstr "我才不会随随便便地跳进奇怪的传送门！"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.ALTERGUARDIANHAT
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.ALTERGUARDIANHAT"
msgid "It's a pretty heady experience havin' that much power. Ha..."
msgstr "拥有这种头部能量相当令人振奋。哈……"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.ALTERGUARDIANHATSHARD
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.ALTERGUARDIANHATSHARD"
msgid "There's still a heck of a lot of power left in this one little piece."
msgstr "别看就这么点儿，仍然有很大的力量。"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.ALTERGUARDIAN_CONTAINED
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.ALTERGUARDIAN_CONTAINED"
msgid "The machine's sucking up all the energy from that thing..."
msgstr "这台机器正在吸走那东西的所有能量……"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.ALTERGUARDIAN_PHASE1.DEAD
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.ALTERGUARDIAN_PHASE1.DEAD"
msgid "Well, glad that's done with."
msgstr "呼，总算完事了。"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.ALTERGUARDIAN_PHASE1.GENERIC
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.ALTERGUARDIAN_PHASE1.GENERIC"
msgid "That thing went and busted up all our hard work!"
msgstr "那家伙把我们的辛苦工作弄坏了！"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.ALTERGUARDIAN_PHASE1_LUNARRIFT
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.ALTERGUARDIAN_PHASE1_LUNARRIFT"
msgid "Looks like it's gonna burst."
msgstr "看着要炸了似的。"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.ALTERGUARDIAN_PHASE1_LUNARRIFT_GESTALT
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.ALTERGUARDIAN_PHASE1_LUNARRIFT_GESTALT"
msgid "Whoa. I ain't seen one like that before."
msgstr "哇哦。我还没见过这玩意儿。"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.ALTERGUARDIAN_PHASE2.DEAD
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.ALTERGUARDIAN_PHASE2.DEAD"
msgid "Yeesh, this thing doesn't know when to quit!"
msgstr "哎呦喂，这东西真没眼色！"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.ALTERGUARDIAN_PHASE2.GENERIC
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.ALTERGUARDIAN_PHASE2.GENERIC"
msgid "Uh-oh, the gloves are really comin' off now."
msgstr "哎呀，这下真要摘手套了。"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.ALTERGUARDIAN_PHASE2SPIKE
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.ALTERGUARDIAN_PHASE2SPIKE"
msgid "Some pretty slap-dash construction work, if you ask me."
msgstr "你要问我的话，施工相当草率。"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.ALTERGUARDIAN_PHASE3
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.ALTERGUARDIAN_PHASE3"
msgid "Next time I see the bossman I'm asking for extra hazard pay..."
msgstr "下回我碰见老板得要危险补偿。"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.ALTERGUARDIAN_PHASE3DEAD
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.ALTERGUARDIAN_PHASE3DEAD"
msgid "Might as well salvage what we can from what's left."
msgstr "不妨从剩下的东西中挑拣出一点有用的东西。"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.ALTERGUARDIAN_PHASE3DEADORB
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.ALTERGUARDIAN_PHASE3DEADORB"
msgid "Mr. Wagstaff... did you plan for this?"
msgstr "瓦格斯塔夫先生……这也是你的计划么？"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.ALTERGUARDIAN_PHASE3TRAP
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.ALTERGUARDIAN_PHASE3TRAP"
msgid "Nice try, you won't catch me sleeping on the job!"
msgstr "谁都不会抓到我在干活时睡觉。"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.ALTERGUARDIAN_PHASE4_LUNARRIFT
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.ALTERGUARDIAN_PHASE4_LUNARRIFT"
msgid "It don't make no sense!"
msgstr "这根本不合常理！"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.AMULET
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.AMULET"
msgid "Jewelry ain't really my thing."
msgstr "珠宝不是我的菜。"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.ANCHOR
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.ANCHOR"
msgid "That'll keep the boat right where we want it."
msgstr "它会把船固定在我们想的地方。"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.ANCHOR_ITEM
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.ANCHOR_ITEM"
