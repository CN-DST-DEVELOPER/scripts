msgstr "看起来要搭建一下才行。"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.YOTC_CARRATSHRINE.BURNT
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.YOTC_CARRATSHRINE.BURNT"
msgid "Smells like roasted carrots."
msgstr "烤胡萝卜的气味。"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.YOTC_CARRATSHRINE.EMPTY
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.YOTC_CARRATSHRINE.EMPTY"
msgid "Hm... what does a carrat like to eat?"
msgstr "嗯……胡萝卜鼠喜欢吃什么呢？"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.YOTC_CARRATSHRINE.GENERIC
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.YOTC_CARRATSHRINE.GENERIC"
msgid "What to make..."
msgstr "做什么呢……"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.YOTC_CARRAT_GYM_DIRECTION.BURNT
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.YOTC_CARRAT_GYM_DIRECTION.BURNT"
msgid "My training regimen crashed and burned."
msgstr "我的训练计划灰飞烟灭。"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.YOTC_CARRAT_GYM_DIRECTION.GENERIC
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.YOTC_CARRAT_GYM_DIRECTION.GENERIC"
msgid "This'll get things moving in the right direction."
msgstr "为训练指明方向。"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.YOTC_CARRAT_GYM_DIRECTION.RAT
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.YOTC_CARRAT_GYM_DIRECTION.RAT"
msgid "You would make an excellent lab rat."
msgstr "你能当一只优秀的小白鼠。"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.YOTC_CARRAT_GYM_DIRECTION_ITEM
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.YOTC_CARRAT_GYM_DIRECTION_ITEM"
msgid "I'd better get training!"
msgstr "我也该练练了！"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.YOTC_CARRAT_GYM_REACTION.BURNT
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.YOTC_CARRAT_GYM_REACTION.BURNT"
msgid "A small loss to take in the pursuit of science."
msgstr "追求科学的过程中付出的微小代价。"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.YOTC_CARRAT_GYM_REACTION.GENERIC
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.YOTC_CARRAT_GYM_REACTION.GENERIC"
msgid "Let's train those carrat-like reflexes!"
msgstr "我们来训练胡萝卜鼠的反应速度！"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.YOTC_CARRAT_GYM_REACTION.RAT
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.YOTC_CARRAT_GYM_REACTION.RAT"
msgid "The subject's response time is steadily improving!"
msgstr "对象的反应时间正在稳步提高！"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.YOTC_CARRAT_GYM_REACTION_ITEM
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.YOTC_CARRAT_GYM_REACTION_ITEM"
msgid "This should improve my carrat's reaction time considerably."
msgstr "这个应该能显著提高胡萝卜鼠的反应时间。"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.YOTC_CARRAT_GYM_SPEED.BURNT
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.YOTC_CARRAT_GYM_SPEED.BURNT"
msgid "I may have overdone it."
msgstr "我可能放太多燃料了。"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.YOTC_CARRAT_GYM_SPEED.GENERIC
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.YOTC_CARRAT_GYM_SPEED.GENERIC"
msgid "I need to get my carrat up to speed."
msgstr "我需要提高胡萝卜鼠的速度。"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.YOTC_CARRAT_GYM_SPEED.RAT
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.YOTC_CARRAT_GYM_SPEED.RAT"
msgid "Faster... faster!"
msgstr "快点……快点！"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.YOTC_CARRAT_GYM_SPEED_ITEM
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.YOTC_CARRAT_GYM_SPEED_ITEM"
msgid "I'd better get this assembled."
msgstr "我最好把这个组装起来。"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.YOTC_CARRAT_GYM_STAMINA.BURNT
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.YOTC_CARRAT_GYM_STAMINA.BURNT"
msgid "You can't stop progress! But this will delay it..."
msgstr "谁都阻挡不了进步！但这个会推迟它……"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.YOTC_CARRAT_GYM_STAMINA.GENERIC
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.YOTC_CARRAT_GYM_STAMINA.GENERIC"
msgid "Getting strong now!"
msgstr "变得更加强壮了！"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.YOTC_CARRAT_GYM_STAMINA.RAT
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.YOTC_CARRAT_GYM_STAMINA.RAT"
msgid "This carrat... will be unstoppable!!"
msgstr "这只胡萝卜鼠……将无人能挡！！"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.YOTC_CARRAT_GYM_STAMINA_ITEM
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.YOTC_CARRAT_GYM_STAMINA_ITEM"
msgid "This should help improve my carrat's stamina"
msgstr "这个会改善胡萝卜鼠的耐力"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.YOTC_CARRAT_RACE_CHECKPOINT
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.YOTC_CARRAT_RACE_CHECKPOINT"
msgid "You've made your point."
msgstr "关键的一点。"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.YOTC_CARRAT_RACE_CHECKPOINT_ITEM
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.YOTC_CARRAT_RACE_CHECKPOINT_ITEM"
msgid "That checks out."
msgstr "总会抵达终点。"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.YOTC_CARRAT_RACE_FINISH.BURNT
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.YOTC_CARRAT_RACE_FINISH.BURNT"
msgid "It's all gone up in flames!"
msgstr "一把火烧的干干净净！"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.YOTC_CARRAT_RACE_FINISH.GENERIC
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.YOTC_CARRAT_RACE_FINISH.GENERIC"
msgid "It's really more of a finish circle than a line."
msgstr "与其说是终点线，不如说是终点圈。"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.YOTC_CARRAT_RACE_FINISH.I_WON
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.YOTC_CARRAT_RACE_FINISH.I_WON"
msgid "Ha HA! Science prevails!"
msgstr "哈哈！科学胜出了！"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.YOTC_CARRAT_RACE_FINISH.SOMEONE_ELSE_WON
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.YOTC_CARRAT_RACE_FINISH.SOMEONE_ELSE_WON"
msgid "Sigh... congratulations, {winner}."
msgstr "哎……恭喜了，{winner}。"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.YOTC_CARRAT_RACE_FINISH_ITEM
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.YOTC_CARRAT_RACE_FINISH_ITEM"
msgid "The end's in sight."
msgstr "大限将至。"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.YOTC_CARRAT_RACE_START
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.YOTC_CARRAT_RACE_START"
msgid "It's a good enough place to start."
msgstr "不错的起点。"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.YOTC_CARRAT_RACE_START_ITEM
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.YOTC_CARRAT_RACE_START_ITEM"
msgid "Well, it's a start."
msgstr "好吧，算是个开始。"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.YOTC_CARRAT_SCALE.BURNT
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.YOTC_CARRAT_SCALE.BURNT"
msgid "What a mess."
msgstr "真是一团糟"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.YOTC_CARRAT_SCALE.CARRAT
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.YOTC_CARRAT_SCALE.CARRAT"
msgid "I suppose no matter what, it's still just a sentient vegetable."
msgstr "它终究只是一个有知觉的蔬菜。"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.YOTC_CARRAT_SCALE.CARRAT_GOOD
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.YOTC_CARRAT_SCALE.CARRAT_GOOD"
msgid "This carrat looks ripe for racing!"
msgstr "胡萝卜鼠熟到可以赛跑了！"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.YOTC_CARRAT_SCALE.GENERIC
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.YOTC_CARRAT_SCALE.GENERIC"
msgid "Hopefully the scales tip in my favor."
msgstr "希望天平向我倾斜。"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.YOTC_CARRAT_SCALE_ITEM
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.YOTC_CARRAT_SCALE_ITEM"
msgid "This will help car-rate my car-rat."
msgstr "可以秤我的胡萝卜鼠。"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.YOTC_SEEDPACKET
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.YOTC_SEEDPACKET"
msgid "Looks pretty seedy, if you ask me."
msgstr "如果你问我，我会说看起来很多籽。"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.YOTC_SEEDPACKET_RARE
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.YOTC_SEEDPACKET_RARE"
msgid "Hey there, fancy-plants!"
msgstr "哟，还是稀罕货啊！"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.YOTD_ANCHOR
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.YOTD_ANCHOR"
msgid "I wouldn't want my boat to fly away."
msgstr "我可不能让我的小船飞走了。"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.YOTD_ANCHOR_ITEM
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.YOTD_ANCHOR_ITEM"
msgid "Now I can build an anchor."
msgstr "现在我能造出锚了。"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.YOTD_DRAGONSHRINE.BURNT
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.YOTD_DRAGONSHRINE.BURNT"
msgid "Things got a little heated."
msgstr "稍微有些过火了。"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.YOTD_DRAGONSHRINE.EMPTY
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.YOTD_DRAGONSHRINE.EMPTY"
msgid "It might like a piece of charcoal."
msgstr "它也许想要块木炭。"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.YOTD_DRAGONSHRINE.GENERIC
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.YOTD_DRAGONSHRINE.GENERIC"
msgid "I'm burning with curiosity to see what's on offer."
msgstr "供品会是什么？我的好奇心在燃烧。"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.YOTD_OAR
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.YOTD_OAR"
msgid "It's a really handy paddle."
msgstr "好方便的船桨。"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.YOTD_STEERINGWHEEL
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.YOTD_STEERINGWHEEL"
