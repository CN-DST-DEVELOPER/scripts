msgstr "哦，快看呐！兔子帽啊！"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.RABBITHOLE.GENERIC
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.RABBITHOLE.GENERIC"
