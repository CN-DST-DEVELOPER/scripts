msgstr "吊桥效应！"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.ROSEGLASSESHAT.GENERIC
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.ROSEGLASSESHAT.GENERIC"
