msgstr "不！我现在不能慢下来！"

#. STRINGS.CHARACTERS.WANDA.ANNOUNCE_DIG_DISEASE_WARNING
msgctxt "STRINGS.CHARACTERS.WANDA.ANNOUNCE_DIG_DISEASE_WARNING"
