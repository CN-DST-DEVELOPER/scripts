#. STRINGS.CHARACTERS.WINONA.DESCRIBE.BIGFOOT
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.BIGFOOT"
msgid "At least it doesn't have steel-toed workboots!"
msgstr "至少它没有铁头靴！"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.BIRCHNUTDRAKE
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.BIRCHNUTDRAKE"
msgid "Shoo! Get outta here!"
msgstr "嘘！滚出去！"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.BIRDCAGE.DEAD
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.BIRDCAGE.DEAD"
msgid "I think it was my turn to feed her."
msgstr "我猜我没喂好。"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.BIRDCAGE.GENERIC
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.BIRDCAGE.GENERIC"
msgid "That's some proper metalwork."
msgstr "那是正儿八经的金属制品。"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.BIRDCAGE.HUNGRY
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.BIRDCAGE.HUNGRY"
msgid "Hey! Is it my turn to feed the bird?"
msgstr "嘿！轮到我喂鸟了吗？"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.BIRDCAGE.OCCUPIED
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.BIRDCAGE.OCCUPIED"
msgid "She was just a patsy."
msgstr "一只傻鸟。"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.BIRDCAGE.SKELETON
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.BIRDCAGE.SKELETON"
msgid "Let's uh... just sweep that under the rug."
msgstr "呃，我们把它扫到地毯下吧。"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.BIRDCAGE.SLEEPING
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.BIRDCAGE.SLEEPING"
msgid "Why are you tired? Your life is so cushy."
msgstr "你为什么累了？你的生活如此轻松。"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.BIRDCAGE.STARVING
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.BIRDCAGE.STARVING"
msgid "This poor bird's a bag of bones."
msgstr "这只可怜的鸟儿只剩皮包骨了。"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.BIRDCORPSE.BURNING
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.BIRDCORPSE.BURNING"
msgid "That'll do the trick."
msgstr "那会成功的。"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.BIRDCORPSE.GENERIC
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.BIRDCORPSE.GENERIC"
msgid "It ain't the end."
msgstr "还没完呢。"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.BIRDCORPSE.REVIVING
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.BIRDCORPSE.REVIVING"
msgid "Great. We missed our chance."
msgstr "得，我们错失了机会。"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.BIRDTRAP
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.BIRDTRAP"
msgid "Birds of a feather get trapped together."
msgstr "同种笨鸟同被抓。"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.BIRD_EGG
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.BIRD_EGG"
msgid "Breakfast."
msgstr "早餐。"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.BIRD_EGG_COOKED
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.BIRD_EGG_COOKED"
msgid "I always get bits of shell in there by accident."
msgstr "里面总是会有碎蛋壳。"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.BIRD_MUTANT
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.BIRD_MUTANT"
msgid "That bird gives me the creeps."
msgstr "那只鸟让我毛骨悚然。"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.BIRD_MUTANT_SPITTER
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.BIRD_MUTANT_SPITTER"
msgid "There's something... off about it."
msgstr "它有点……不寻常。"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.BISHOP
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.BISHOP"
msgid "How industrial."
msgstr "好工业化。"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.BISHOP_CHARGE_HIT
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.BISHOP_CHARGE_HIT"
msgid "Yeow!"
msgstr "噢！"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.BISHOP_NIGHTMARE
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.BISHOP_NIGHTMARE"
msgid "You look awful!"
msgstr "你看起来糟透了！"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.BLACKFLAG
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.BLACKFLAG"
msgid "Not the cheeriest, is it?"
msgstr "不是很欢快，对吗？"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.BLOWDART_FIRE
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.BLOWDART_FIRE"
msgid "Simple, but effective."
msgstr "简单但高效。"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.BLOWDART_LAVA
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.BLOWDART_LAVA"
msgid "Efficient, and painful!"
msgstr "高效，而又痛苦！"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.BLOWDART_LAVA2
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.BLOWDART_LAVA2"
msgid "That's right up my alley!"
msgstr "那个太合我心意了！"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.BLOWDART_PIPE
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.BLOWDART_PIPE"
msgid "Ptoo!"
msgstr "卟突！"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.BLOWDART_SLEEP
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.BLOWDART_SLEEP"
msgid "Inflicts the very worst thing... laziness."
msgstr "感染最糟糕的东西……懒惰。"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.BLOWDART_YELLOW
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.BLOWDART_YELLOW"
msgid "I'm gonna shoot this at the bot's butt."
msgstr "我要用这个射机器人的屁股。"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.BLUEAMULET
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.BLUEAMULET"
msgid "Now I don't have to take breaks to cool off."
msgstr "现在我不用停下来等冷却了。"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.BLUEGEM
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.BLUEGEM"
msgid "It's a gem. A gem that's blue."
msgstr "是宝石，蓝色的宝石。"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.BLUEMOONEYE
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.BLUEMOONEYE"
msgid "It saw me standing alone."
msgstr "它看着孤单单的我。"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.BLUEPRINT.COMMON
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.BLUEPRINT.COMMON"
msgid "Blueprint paper just smells right."
msgstr "蓝图纸闻起来真不赖。"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.BLUEPRINT.RARE
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.BLUEPRINT.RARE"
msgid "Progress on paper!"
msgstr "纸上的进度！"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.BLUE_CAP
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.BLUE_CAP"
msgid "Yep. Blue mushroom."
msgstr "没错，蓝蘑菇。"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.BLUE_CAP_COOKED
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.BLUE_CAP_COOKED"
msgid "Well, I don't THINK it's poison."
msgstr "嗯，我不觉得它有毒。"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.BLUE_MUSHROOM.GENERIC
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.BLUE_MUSHROOM.GENERIC"
msgid "It's some sorta blue mushroom."
msgstr "是一种蓝蘑菇。"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.BLUE_MUSHROOM.INGROUND
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.BLUE_MUSHROOM.INGROUND"
msgid "Lazy mushroom."
msgstr "懒惰的蘑菇。"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.BLUE_MUSHROOM.PICKED
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.BLUE_MUSHROOM.PICKED"
msgid "Got'er done."
msgstr "被摘过了。"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.BOARDS
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.BOARDS"
msgid "Oh, the possibilities."
msgstr "哦，太多可能性了。"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.BOARON
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.BOARON"
msgid "Who's ready fer some bacon?!"
msgstr "有谁想吃培根吗？！"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.BOARRIOR
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.BOARRIOR"
msgid "Let's cut him down to size!"
msgstr "我们把他大卸八块吧！"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.BOATFRAGMENT03
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.BOATFRAGMENT03"
msgid "Busted right up, hey?"
msgstr "被拍的稀碎，哈？"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.BOATFRAGMENT04
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.BOATFRAGMENT04"
msgid "Busted right up, hey?"
msgstr "被拍的稀碎，哈？"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.BOATFRAGMENT05
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.BOATFRAGMENT05"
msgid "Busted right up, hey?"
msgstr "被拍的稀碎，哈？"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.BOATPATCH
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.BOATPATCH"
msgid "Never know when you might need one."
msgstr "不知道什么时候就需要这个东西了。"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.BOATPATCH_KELP
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.BOATPATCH_KELP"
msgid "Just a quick fix until I can do some proper repairs."
msgstr "先简单应付一下，等我有空再好好修。"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.BOATRACE_CHECKPOINT
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.BOATRACE_CHECKPOINT"
msgid "Checkpoint ahead!"
msgstr "前面有检查点！"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.BOATRACE_CHECKPOINT_THROWABLE_DEPLOYKIT
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.BOATRACE_CHECKPOINT_THROWABLE_DEPLOYKIT"
msgid "Better roll up my sleeves and get to buildin'."
msgstr "卷起袖子造吧！"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.BOATRACE_PRIMEMATE
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.BOATRACE_PRIMEMATE"
msgid "Tryin' to throw a monkeywrench in my race, sis?"
msgstr "跟我的比赛里耍猴戏呢，妹子？"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.BOATRACE_SEASTACK
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.BOATRACE_SEASTACK"
msgid "Buoy ahead!"
msgstr "前方有浮标！"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.BOATRACE_SEASTACK_MONKEY
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.BOATRACE_SEASTACK_MONKEY"
msgid "Buoy ahead!"
msgstr "前方有浮标！"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.BOATRACE_SEASTACK_MONKEY_THROWABLE_DEPLOYKIT
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.BOATRACE_SEASTACK_MONKEY_THROWABLE_DEPLOYKIT"
msgid "Better watch where I throw it, wouldn't wanna bust up someone's boat."
msgstr "最好小心点扔，我可不想砸了别人的船。"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.BOATRACE_SEASTACK_THROWABLE_DEPLOYKIT
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.BOATRACE_SEASTACK_THROWABLE_DEPLOYKIT"
msgid "Better watch where I throw it, wouldn't wanna bust up someone's boat."
msgstr "最好小心点扔，我可不想砸了别人的船。"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.BOATRACE_SPECTATOR_DRAGONLING
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.BOATRACE_SPECTATOR_DRAGONLING"
msgid "Must be the new supervisor."
msgstr "想必是新来的主管。"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.BOATRACE_START
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.BOATRACE_START"
msgid "No sense stallin', let's go!"
msgstr "没必要拖了，咱们走！"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.BOATRACE_START_THROWABLE_DEPLOYKIT
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.BOATRACE_START_THROWABLE_DEPLOYKIT"
msgid "Better get started!"
msgstr "快开始吧！"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.BOAT_ANCIENT_CONTAINER
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.BOAT_ANCIENT_CONTAINER"
msgid "Plenty of space for storage."
msgstr "有的是储存空间。"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.BOAT_ANCIENT_ITEM
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.BOAT_ANCIENT_ITEM"
