msgstr "我们真希望它刚才不是在睡觉。"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.GENERIC_CORPSE.GENERIC
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.GENERIC_CORPSE.GENERIC"
