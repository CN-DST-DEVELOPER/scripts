msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.FUMAROLE_FARM_HOE.GENERIC"
msgid "It's lookin' a little flimsy."
msgstr "看起来有点不结实呀。"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.FUMAROLE_FARM_HOE.HOT
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.FUMAROLE_FARM_HOE.HOT"
msgid "Anybody got some safety gloves?"
msgstr "谁带了防护手套了？"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.FUMAROLE_FARM_HOE.LUKEWARM
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.FUMAROLE_FARM_HOE.LUKEWARM"
msgid "It's coolin' off."
msgstr "在冷却了。"

