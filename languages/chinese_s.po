msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_WEIGHT_HEAVY"
msgid "Weight: {weight}\nEr... I don't suppose anyone would help me carry this?"
msgstr "重量: {weight}\n额……会有人帮我搬这个吗?"

