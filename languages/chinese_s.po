msgstr "一场适合我的盛宴。"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.YOTP_FOOD2
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.YOTP_FOOD2"
