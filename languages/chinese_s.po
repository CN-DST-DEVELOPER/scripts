msgstr "它们好像不怎么怕人。"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.QUAGMIRE_SWAMPIGELDER.GENERIC
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.QUAGMIRE_SWAMPIGELDER.GENERIC"
