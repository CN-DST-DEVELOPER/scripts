msgstr "里面是个鬼魂吗，沃比！太神奇了！"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.WX78_SCANNER.GENERIC
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.WX78_SCANNER.GENERIC"
