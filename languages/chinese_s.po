msgstr "重量: {weight}\n收获日: {day}\n棒极！"

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.TROPHYSCALE_OVERSIZEDVEGGIES.HAS_ITEM_HEAVY
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.TROPHYSCALE_OVERSIZEDVEGGIES.HAS_ITEM_HEAVY"
