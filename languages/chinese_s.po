msgstr "它不会重新长出来了。"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.QUAGMIRE_SUGARWOODTREE.TAPPED_BUGS
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.QUAGMIRE_SUGARWOODTREE.TAPPED_BUGS"
