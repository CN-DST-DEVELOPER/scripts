msgstr "瞧瞧这小腿跑的！"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.YOTC_CARRAT_GYM_SPEED_ITEM
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.YOTC_CARRAT_GYM_SPEED_ITEM"
