#. STRINGS.SHARKBOI_ACCEPT_BIG_OCEANFISH.1
msgctxt "STRINGS.SHARKBOI_ACCEPT_BIG_OCEANFISH.1"
msgid "HOLY MACKEREL, THAT'S A BIG ONE."
msgstr "马鲛鱼神啊，这可是个大家伙。"

#. STRINGS.SHARKBOI_ACCEPT_OCEANFISH.1
msgctxt "STRINGS.SHARKBOI_ACCEPT_OCEANFISH.1"
msgid "NOW, THAT IS A BEAUTIFUL FISH."
msgstr "好俊的鱼啊！"

#. STRINGS.SHARKBOI_REFUSE_EMPTY.1
msgctxt "STRINGS.SHARKBOI_REFUSE_EMPTY.1"
msgid "AIN'T GOT NO MORE. I'M CLEANED OUT."
msgstr "没了，没了。库存清空了。"

#. STRINGS.SHARKBOI_REFUSE_NOT_OCEANFISH.1
msgctxt "STRINGS.SHARKBOI_REFUSE_NOT_OCEANFISH.1"
msgid "IF IT AIN'T A FISH FROM THE OCEAN, I DON'T WANT IT."
msgstr "不是海鱼我可不要。"

#. STRINGS.SHARKBOI_REFUSE_TOO_SMALL.1
msgctxt "STRINGS.SHARKBOI_REFUSE_TOO_SMALL.1"
msgid "DON'T INSULT ME WITH THIS PUNY THING. GIMME A BIG ONE."
msgstr "别拿这个小东西来侮辱我。给我来条大的。"

#. STRINGS.SHARKBOI_TALK_ATTEMPT_TRADE.1
msgctxt "STRINGS.SHARKBOI_TALK_ATTEMPT_TRADE.1"
msgid "INTERESTIN', REEL INTERESTIN'."
msgstr "有意思，真有意思。"

#. STRINGS.SHARKBOI_TALK_ATTEMPT_TRADE.2
msgctxt "STRINGS.SHARKBOI_TALK_ATTEMPT_TRADE.2"
msgid "WHAT WE GOT HERE?"
msgstr "拿出来看看？"

#. STRINGS.SHARKBOI_TALK_ATTEMPT_TRADE.3
msgctxt "STRINGS.SHARKBOI_TALK_ATTEMPT_TRADE.3"
msgid "LET'S SEA WHATCHA GOT."
msgstr "那就看看你有点啥。"

#. STRINGS.SHARKBOI_TALK_ATTEMPT_TRADE.4
msgctxt "STRINGS.SHARKBOI_TALK_ATTEMPT_TRADE.4"
msgid "WHATCHA FISHIN' FOR?"
msgstr "你钓了什么鱼？"

#. STRINGS.SHARKBOI_TALK_ATTEMPT_TRADE.5
msgctxt "STRINGS.SHARKBOI_TALK_ATTEMPT_TRADE.5"
msgid "HOPE YOUSE AIN'T WASTIN' MY TIME."
msgstr "可不要浪费我的时间。"

#. STRINGS.SHARKBOI_TALK_ATTEMPT_TRADE.6
msgctxt "STRINGS.SHARKBOI_TALK_ATTEMPT_TRADE.6"
msgid "BETTER NOT BE NO RAW DEAL."
msgstr "可别让我做亏本买卖。"

#. STRINGS.SHARKBOI_TALK_ATTEMPT_TRADE.7
msgctxt "STRINGS.SHARKBOI_TALK_ATTEMPT_TRADE.7"
msgid "I DON'T WANT NO BAIT N' SWITCH."
msgstr "别给我来狸猫换太子。"

#. STRINGS.SHARKBOI_TALK_ATTEMPT_TRADE.8
msgctxt "STRINGS.SHARKBOI_TALK_ATTEMPT_TRADE.8"
msgid "OKAY, YOU REELED ME IN. WHATCHA GOT?"
msgstr "好吧，我上了你的钩。你有啥？"

#. STRINGS.SHARKBOI_TALK_CHEER.1
msgctxt "STRINGS.SHARKBOI_TALK_CHEER.1"
msgid "PUT 'EM ON ICE!"
msgstr "把他们放在冰上！"

#. STRINGS.SHARKBOI_TALK_CHEER.10
msgctxt "STRINGS.SHARKBOI_TALK_CHEER.10"
msgid "FIN-ISH 'EM!"
msgstr "收拾他们！"

#. STRINGS.SHARKBOI_TALK_CHEER.2
msgctxt "STRINGS.SHARKBOI_TALK_CHEER.2"
msgid "WHACK 'EM!"
msgstr "打碎他们！"

#. STRINGS.SHARKBOI_TALK_CHEER.3
msgctxt "STRINGS.SHARKBOI_TALK_CHEER.3"
msgid "GIVE 'EM THE OL' ONE-TWO!"
msgstr "给他们来个一击必杀！"

#. STRINGS.SHARKBOI_TALK_CHEER.4
msgctxt "STRINGS.SHARKBOI_TALK_CHEER.4"
msgid "FROSTBITE!"
msgstr "冻伤来了！"

#. STRINGS.SHARKBOI_TALK_CHEER.5
msgctxt "STRINGS.SHARKBOI_TALK_CHEER.5"
msgid "CHOMP! CHOMP!"
msgstr "我咬！我咬！"

#. STRINGS.SHARKBOI_TALK_CHEER.6
msgctxt "STRINGS.SHARKBOI_TALK_CHEER.6"
msgid "CLIP 'EM!"
msgstr "夹死他们！"

#. STRINGS.SHARKBOI_TALK_CHEER.7
msgctxt "STRINGS.SHARKBOI_TALK_CHEER.7"
msgid "ICE 'EM!"
msgstr "冻死他们！"

#. STRINGS.SHARKBOI_TALK_CHEER.8
msgctxt "STRINGS.SHARKBOI_TALK_CHEER.8"
msgid "THEY AIN'T NO FRIEND OF OURS!"
msgstr "他们不是我们的朋友！"

#. STRINGS.SHARKBOI_TALK_CHEER.9
msgctxt "STRINGS.SHARKBOI_TALK_CHEER.9"
msgid "THIS IS OUR TURF!"
msgstr "这是我们的地盘！"

#. STRINGS.SHARKBOI_TALK_FIGHT.1
msgctxt "STRINGS.SHARKBOI_TALK_FIGHT.1"
msgid "TOUGH GUY, EH?"
msgstr "硬汉，诶？"

#. STRINGS.SHARKBOI_TALK_FIGHT.10
msgctxt "STRINGS.SHARKBOI_TALK_FIGHT.10"
msgid "YOU'LL BE SLEEPIN' WITH THE FISHES!"
msgstr "送你去跟鱼儿一起睡！"

#. STRINGS.SHARKBOI_TALK_FIGHT.11
msgctxt "STRINGS.SHARKBOI_TALK_FIGHT.11"
msgid "I'M NOT GONNA LET THIS SLIDE!"
msgstr "我不会放过你的！"

#. STRINGS.SHARKBOI_TALK_FIGHT.12
msgctxt "STRINGS.SHARKBOI_TALK_FIGHT.12"
msgid "ICE TO EAT YA! HEH HEH."
msgstr "很高兴吃掉你！啊哈哈哈。"

#. STRINGS.SHARKBOI_TALK_FIGHT.2
msgctxt "STRINGS.SHARKBOI_TALK_FIGHT.2"
msgid "YOU'LL NEVER CATCH ME, SEE."
msgstr "你永远都抓不到我，看着吧。"

#. STRINGS.SHARKBOI_TALK_FIGHT.3
msgctxt "STRINGS.SHARKBOI_TALK_FIGHT.3"
msgid "YOUSE DON'T STAND A CHANCE."
msgstr "你根本没机会。"

#. STRINGS.SHARKBOI_TALK_FIGHT.4
msgctxt "STRINGS.SHARKBOI_TALK_FIGHT.4"
msgid "IT'S BITIN' TIME!"
msgstr "撕咬时间到！"

#. STRINGS.SHARKBOI_TALK_FIGHT.5
msgctxt "STRINGS.SHARKBOI_TALK_FIGHT.5"
msgid "YOU'RE A REAL PIECE OF WORK, BUDDY."
msgstr "你可真行啊，伙计。"

#. STRINGS.SHARKBOI_TALK_FIGHT.6
msgctxt "STRINGS.SHARKBOI_TALK_FIGHT.6"
msgid "YOU DON'T GET NO PASS."
msgstr "你过不去了。"

#. STRINGS.SHARKBOI_TALK_FIGHT.7
msgctxt "STRINGS.SHARKBOI_TALK_FIGHT.7"
msgid "I'LL PUT YOUSE ON ICE!"
msgstr "看我把你冻成冰鲜！"

#. STRINGS.SHARKBOI_TALK_FIGHT.8
msgctxt "STRINGS.SHARKBOI_TALK_FIGHT.8"
msgid "FREEZE!"
msgstr "站住！"

#. STRINGS.SHARKBOI_TALK_FIGHT.9
msgctxt "STRINGS.SHARKBOI_TALK_FIGHT.9"
msgid "YOUSE ON THIN ICE NOW!"
msgstr "你现在如履薄冰！"

#. STRINGS.SHARKBOI_TALK_FOLLOWWILSON.1
msgctxt "STRINGS.SHARKBOI_TALK_FOLLOWWILSON.1"
msgid "SURE, SKIP!"
msgstr "好，老大。"

#. STRINGS.SHARKBOI_TALK_FOLLOWWILSON.10
msgctxt "STRINGS.SHARKBOI_TALK_FOLLOWWILSON.10"
msgid "LEMME AT 'EM."
msgstr "让我看看。"

#. STRINGS.SHARKBOI_TALK_FOLLOWWILSON.11
msgctxt "STRINGS.SHARKBOI_TALK_FOLLOWWILSON.11"
msgid "I'D NEVER EAT YOU, BOSS."
msgstr "我永远不会吃了你，老板。"

#. STRINGS.SHARKBOI_TALK_FOLLOWWILSON.12
msgctxt "STRINGS.SHARKBOI_TALK_FOLLOWWILSON.12"
msgid "JUST SAY THE WORD, BOSS."
msgstr "只要你一句话，老板。"

#. STRINGS.SHARKBOI_TALK_FOLLOWWILSON.13
msgctxt "STRINGS.SHARKBOI_TALK_FOLLOWWILSON.13"
msgid "I GOT YOUR BACK."
msgstr "我挺你。"

#. STRINGS.SHARKBOI_TALK_FOLLOWWILSON.14
msgctxt "STRINGS.SHARKBOI_TALK_FOLLOWWILSON.14"
msgid "YOU SAY SOMETHIN', BOSS?"
msgstr "你说什么，老板？"

#. STRINGS.SHARKBOI_TALK_FOLLOWWILSON.15
msgctxt "STRINGS.SHARKBOI_TALK_FOLLOWWILSON.15"
msgid "BOSS IS THE BEST."
msgstr "老板是最棒的。"

#. STRINGS.SHARKBOI_TALK_FOLLOWWILSON.16
msgctxt "STRINGS.SHARKBOI_TALK_FOLLOWWILSON.16"
msgid "WHO WE WHACKIN' BOSS?"
msgstr "我们去揍谁，老版？"

#. STRINGS.SHARKBOI_TALK_FOLLOWWILSON.17
msgctxt "STRINGS.SHARKBOI_TALK_FOLLOWWILSON.17"
msgid "LOOKIN' SHARP, BOSS."
msgstr "你看着真犀利，老板。"

#. STRINGS.SHARKBOI_TALK_FOLLOWWILSON.18
msgctxt "STRINGS.SHARKBOI_TALK_FOLLOWWILSON.18"
msgid "WHERE TO, SKIP?"
msgstr "去哪，老大？"

#. STRINGS.SHARKBOI_TALK_FOLLOWWILSON.2
msgctxt "STRINGS.SHARKBOI_TALK_FOLLOWWILSON.2"
msgid "OK, BOSS!"
msgstr "欧克，老板！"

#. STRINGS.SHARKBOI_TALK_FOLLOWWILSON.3
msgctxt "STRINGS.SHARKBOI_TALK_FOLLOWWILSON.3"
msgid "AY CAP'N!"
msgstr "是，船长！"

#. STRINGS.SHARKBOI_TALK_FOLLOWWILSON.4
msgctxt "STRINGS.SHARKBOI_TALK_FOLLOWWILSON.4"
msgid "TIL MY LAST BREATH!"
msgstr "直到我咽下最后一口气！"

#. STRINGS.SHARKBOI_TALK_FOLLOWWILSON.5
msgctxt "STRINGS.SHARKBOI_TALK_FOLLOWWILSON.5"
msgid "EASY PEASY."
msgstr "轻松加愉快。"

#. STRINGS.SHARKBOI_TALK_FOLLOWWILSON.6
msgctxt "STRINGS.SHARKBOI_TALK_FOLLOWWILSON.6"
msgid "WHATCHA NEED, BOSS?"
msgstr "你需要什么，老板？"

#. STRINGS.SHARKBOI_TALK_FOLLOWWILSON.7
msgctxt "STRINGS.SHARKBOI_TALK_FOLLOWWILSON.7"
msgid "YOU'RE A FRIEND OF OURS."
msgstr "你是我们的朋友。"

#. STRINGS.SHARKBOI_TALK_FOLLOWWILSON.8
msgctxt "STRINGS.SHARKBOI_TALK_FOLLOWWILSON.8"
msgid "YOU GOT IT, BOSS."
msgstr "没问题，老板。"

#. STRINGS.SHARKBOI_TALK_FOLLOWWILSON.9
msgctxt "STRINGS.SHARKBOI_TALK_FOLLOWWILSON.9"
msgid "WHY SO GLUM, CHUM?"
msgstr "怎么哭丧着脸，伙计？"

#. STRINGS.SHARKBOI_TALK_FRIENDLY.1
msgctxt "STRINGS.SHARKBOI_TALK_FRIENDLY.1"
msgid "WOAH, WOAH! NO HARD FEELINGS, ALRIGHT?"
msgstr "哇哦，哇哦！咱们不计前嫌，好吧？"

#. STRINGS.SHARKBOI_TALK_FRIENDLY.10
msgctxt "STRINGS.SHARKBOI_TALK_FRIENDLY.10"
msgid "I'M ON A SEA FOOD DIET. I ONLY EATS IT IF IT'S FROM THE SEA."
msgstr "我只吃海鲜。我只吃海生海长的东西。"

#. STRINGS.SHARKBOI_TALK_FRIENDLY.2
msgctxt "STRINGS.SHARKBOI_TALK_FRIENDLY.2"
msgid "I CAN MAKE YOUSE AN OFFER... IF YOUSE GOT THE GOODS."
msgstr "我可以给你个提议……你要是有货的话。"

#. STRINGS.SHARKBOI_TALK_FRIENDLY.3
msgctxt "STRINGS.SHARKBOI_TALK_FRIENDLY.3"
msgid "LET'S COME TO AN ARRANGEMENT, IF YOU CATCH MY DRIFT."
msgstr "要是真有心，那咱们就能谈生意。"

#. STRINGS.SHARKBOI_TALK_FRIENDLY.4
msgctxt "STRINGS.SHARKBOI_TALK_FRIENDLY.4"
msgid "LISTEN, MAYBE YOUSE AND ME AIN'T SO DIFFERENT."
msgstr "其实想想你和我也没那么不一样。"

#. STRINGS.SHARKBOI_TALK_FRIENDLY.5
msgctxt "STRINGS.SHARKBOI_TALK_FRIENDLY.5"
msgid "I THINK WE COULD DO SOME BUSINESS, YOU AND ME."
msgstr "我觉得咱俩能做成生意。"

#. STRINGS.SHARKBOI_TALK_FRIENDLY.6
msgctxt "STRINGS.SHARKBOI_TALK_FRIENDLY.6"
msgid "HOWSABOUT YOU SCRATCH MY FIN AND I SCRATCH YOURS?"
msgstr "咱俩互惠互利一下好不好？"

#. STRINGS.SHARKBOI_TALK_FRIENDLY.7
msgctxt "STRINGS.SHARKBOI_TALK_FRIENDLY.7"
msgid "WHADAYA SAY TO A LIL' SQUID PRO QUO?"
msgstr "你帮我，我也帮你，可以吗？"

#. STRINGS.SHARKBOI_TALK_FRIENDLY.8
msgctxt "STRINGS.SHARKBOI_TALK_FRIENDLY.8"
msgid "I AIN'T ONE TO REFUSE A NICE JUICY FISH. BIGGER THE BETTER."
msgstr "我不会拒绝鲜美多汁的鱼。越大越好。"

#. STRINGS.SHARKBOI_TALK_FRIENDLY.9
msgctxt "STRINGS.SHARKBOI_TALK_FRIENDLY.9"
msgid "DON'T WANT NO STINKIN' POND SCUM."
msgstr "我不要臭水塘里捞起来的鱼渣。"

#. STRINGS.SHARKBOI_TALK_GIVEUP.1
msgctxt "STRINGS.SHARKBOI_TALK_GIVEUP.1"
msgid "I BIT OFF MORE THAN I CAN CHEW."
msgstr "我贪多嚼不烂了。"

#. STRINGS.SHARKBOI_TALK_GIVEUP.10
msgctxt "STRINGS.SHARKBOI_TALK_GIVEUP.10"
msgid "SPARE ME. I DIDN'T KNOW YOUSE WAS SO STRONG."
msgstr "放过我吧。没想到你这么猛。"

#. STRINGS.SHARKBOI_TALK_GIVEUP.11
msgctxt "STRINGS.SHARKBOI_TALK_GIVEUP.11"
msgid "I GIVE UP, I GIVE UP. YEESH."
msgstr "我投降，我投降。咦。"

#. STRINGS.SHARKBOI_TALK_GIVEUP.12
msgctxt "STRINGS.SHARKBOI_TALK_GIVEUP.12"
msgid "HOW DO YA FEEL ABOUT CATCH AND RELEASE?"
msgstr "你对捕捉后放生是什么看法？"

#. STRINGS.SHARKBOI_TALK_GIVEUP.13
msgctxt "STRINGS.SHARKBOI_TALK_GIVEUP.13"
msgid "ALRIGHT IT'S YOUR TURF NOW, BOSS."
msgstr "好吧，现在这是你的地盘了，老大。"

#. STRINGS.SHARKBOI_TALK_GIVEUP.14
msgctxt "STRINGS.SHARKBOI_TALK_GIVEUP.14"
msgid "OKAY, YOU CAUGHT ME FAIR AND SQUARE."
msgstr "好吧，你完全抓住我了。"

#. STRINGS.SHARKBOI_TALK_GIVEUP.15
msgctxt "STRINGS.SHARKBOI_TALK_GIVEUP.15"
msgid "HOW'S ABOUT A TRUCE?"
msgstr "休战如何？"

#. STRINGS.SHARKBOI_TALK_GIVEUP.16
msgctxt "STRINGS.SHARKBOI_TALK_GIVEUP.16"
msgid "I CAN'T GO BACK INSIDE, LEMME WORK FOR YOU, BOSS."
msgstr "我不能回去了，让我给你干吧，老板。"

#. STRINGS.SHARKBOI_TALK_GIVEUP.17
msgctxt "STRINGS.SHARKBOI_TALK_GIVEUP.17"
msgid "MERCY, MERCY! YOU GOT ME."
msgstr "手下留情，留情啊！你赢了。"

#. STRINGS.SHARKBOI_TALK_GIVEUP.18
msgctxt "STRINGS.SHARKBOI_TALK_GIVEUP.18"
msgid "OWW. YOU GOT WATER IN MY EYE. THAT REALLY HURT."
msgstr "噢。你把水弄到我眼睛里了。好疼。"

#. STRINGS.SHARKBOI_TALK_GIVEUP.19
msgctxt "STRINGS.SHARKBOI_TALK_GIVEUP.19"
msgid "I SURRENDER, QUIT WHALE'N ON ME."
msgstr "我投降，我激流勇退。"

#. STRINGS.SHARKBOI_TALK_GIVEUP.2
msgctxt "STRINGS.SHARKBOI_TALK_GIVEUP.2"
msgid "I WAS OUTTA MY DEPTH."
msgstr "是我不自量力。"

#. STRINGS.SHARKBOI_TALK_GIVEUP.3
msgctxt "STRINGS.SHARKBOI_TALK_GIVEUP.3"
msgid "UNCLE! UNCLE!"
msgstr "叔叔！叔叔！"

#. STRINGS.SHARKBOI_TALK_GIVEUP.4
msgctxt "STRINGS.SHARKBOI_TALK_GIVEUP.4"
msgid "CAN'T WE WORK SOMETHIN' OUT?"
msgstr "咱们能好好说吗？"

#. STRINGS.SHARKBOI_TALK_GIVEUP.5
msgctxt "STRINGS.SHARKBOI_TALK_GIVEUP.5"
msgid "YOU GOT ME BY THE GILLS."
msgstr "你抓我的鱼鳃了。"

#. STRINGS.SHARKBOI_TALK_GIVEUP.6
msgctxt "STRINGS.SHARKBOI_TALK_GIVEUP.6"
msgid "I'M FIN-ISHED."
msgstr "我完了。"

#. STRINGS.SHARKBOI_TALK_GIVEUP.7
msgctxt "STRINGS.SHARKBOI_TALK_GIVEUP.7"
msgid "I FEEL S- SO COLD..."
msgstr "我感觉好冷……"

#. STRINGS.SHARKBOI_TALK_GIVEUP.8
msgctxt "STRINGS.SHARKBOI_TALK_GIVEUP.8"
msgid "COLD-BLOODED, ACE. COLD-BLOODED."
msgstr "冷血啊，强。冷血。"

#. STRINGS.SHARKBOI_TALK_GIVEUP.9
msgctxt "STRINGS.SHARKBOI_TALK_GIVEUP.9"
msgid "I'M A FISH OUTTA WATER."
msgstr "我是离开了水的鱼。"

#. STRINGS.SHARKBOI_TALK_GLOAT.1
msgctxt "STRINGS.SHARKBOI_TALK_GLOAT.1"
msgid "YOUSE BEEN ICED."
msgstr "你已经凉了。"

#. STRINGS.SHARKBOI_TALK_GLOAT.10
msgctxt "STRINGS.SHARKBOI_TALK_GLOAT.10"
msgid "VICTORY TASTES GOOD."
msgstr "胜利如此美味。"

#. STRINGS.SHARKBOI_TALK_GLOAT.11
msgctxt "STRINGS.SHARKBOI_TALK_GLOAT.11"
msgid "GUTTED."
msgstr "开肠破肚。"

#. STRINGS.SHARKBOI_TALK_GLOAT.12
msgctxt "STRINGS.SHARKBOI_TALK_GLOAT.12"
msgid "SLEEPIN' WITH THE FISHES."
msgstr "去跟鱼儿睡。"

#. STRINGS.SHARKBOI_TALK_GLOAT.13
msgctxt "STRINGS.SHARKBOI_TALK_GLOAT.13"
msgid "YOU'RE DONE, CHUM."
msgstr "你完了，伙计。"

#. STRINGS.SHARKBOI_TALK_GLOAT.14
msgctxt "STRINGS.SHARKBOI_TALK_GLOAT.14"
msgid "WHERE YOU BELONG, BOTTOM-FEEDER."
msgstr "这就是你的最终归宿，底层生物。"

#. STRINGS.SHARKBOI_TALK_GLOAT.15
msgctxt "STRINGS.SHARKBOI_TALK_GLOAT.15"
msgid "I GOT BIGGER FISH TO FRY."
msgstr "我还有更大的鱼要炸。"

#. STRINGS.SHARKBOI_TALK_GLOAT.16
msgctxt "STRINGS.SHARKBOI_TALK_GLOAT.16"
msgid "LOOKIN' A LIL' GREEN AROUND THE GILLS THERE, MAC."
msgstr "你有点鼻青脸肿啊，小朋友。"

#. STRINGS.SHARKBOI_TALK_GLOAT.2
msgctxt "STRINGS.SHARKBOI_TALK_GLOAT.2"
msgid "SEE YOUSE IN THE NEXT LIFE."
msgstr "下辈子见。"

#. STRINGS.SHARKBOI_TALK_GLOAT.3
msgctxt "STRINGS.SHARKBOI_TALK_GLOAT.3"
msgid "FUHGEDDABOUDIT."
msgstr "叭哈哈哈哈。"

#. STRINGS.SHARKBOI_TALK_GLOAT.4
msgctxt "STRINGS.SHARKBOI_TALK_GLOAT.4"
msgid "END OF THE LINE."
msgstr "到终点了。"

#. STRINGS.SHARKBOI_TALK_GLOAT.5
msgctxt "STRINGS.SHARKBOI_TALK_GLOAT.5"
msgid "YOU GOT CAUGHT."
msgstr "你被逮住了。"

#. STRINGS.SHARKBOI_TALK_GLOAT.6
msgctxt "STRINGS.SHARKBOI_TALK_GLOAT.6"
msgid "YOU'RE FIN-ISHED."
msgstr "你完蛋了。"

#. STRINGS.SHARKBOI_TALK_GLOAT.7
msgctxt "STRINGS.SHARKBOI_TALK_GLOAT.7"
msgid "BELLY-UP."
msgstr "你翻白肚喽。"

#. STRINGS.SHARKBOI_TALK_GLOAT.8
msgctxt "STRINGS.SHARKBOI_TALK_GLOAT.8"
msgid "GAVE 'EM A BURIAL AT SEA."
msgstr "给你来个海葬。"

