msgstr "它和水连在一起很长时间了。"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.QUAGMIRE_PARK_GATE.GENERIC
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.QUAGMIRE_PARK_GATE.GENERIC"
