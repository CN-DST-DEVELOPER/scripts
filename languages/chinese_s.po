msgstr "干活时睡觉。"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.QUAGMIRE_SWAMPIG_HOUSE
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.QUAGMIRE_SWAMPIG_HOUSE"
