msgstr "它不会重新长出来了。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.QUAGMIRE_SAP_SPOILED
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.QUAGMIRE_SAP_SPOILED"
