msgid "only_used_by_wolfgang"
msgstr "only_used_by_wolfgang"

#. STRINGS.CHARACTERS.WATHGRITHR.ANNOUNCE_COACH.6
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.ANNOUNCE_COACH.6"
msgid "only_used_by_wolfgang"
msgstr "only_used_by_wolfgang"

