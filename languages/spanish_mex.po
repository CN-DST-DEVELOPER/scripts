#. STRINGS.LAVAARENA_CHARACTER_DESCRIPTIONS.webber
msgctxt "STRINGS.LAVAARENA_CHARACTER_DESCRIPTIONS.webber"
msgid "*Accompanied by itsy bitsy spiders\n\n\n\nExpertise:\nDarts"
msgstr "*Sus arañitas lo acompañan a todos lados\n\n\n\nEspecialidad:\nDardos"

#. STRINGS.LAVAARENA_CHARACTER_DESCRIPTIONS.wendy
msgctxt "STRINGS.LAVAARENA_CHARACTER_DESCRIPTIONS.wendy"
msgid "*Protected by her twin sister, Abigail\n\n\n\nExpertise:\nDarts, Staves"
msgstr "*Su hermana gemela, Abigail, la protege a donde vaya\n\n\n\nEspecialidad:\nDardos, báculos"

#. STRINGS.LAVAARENA_CHARACTER_DESCRIPTIONS.wes
msgctxt "STRINGS.LAVAARENA_CHARACTER_DESCRIPTIONS.wes"
msgid "*Can be revived twice as quickly\n*Gains minimal aggro when attacking\n*Less likely to lose aggro once drawn\n\nExpertise:\nMelee, Darts, Staves"
msgstr "*Revive hasta dos veces más rápido\n*Obtiene una cantidad mínima de agresividad cuando ataca\n*Es menos probable que pierda agresividad una vez provocado\n\nEspecialidad:\nCuerpo a cuerpo, dardos, báculos"

#. STRINGS.LAVAARENA_CHARACTER_DESCRIPTIONS.wickerbottom
msgctxt "STRINGS.LAVAARENA_CHARACTER_DESCRIPTIONS.wickerbottom"
msgid "*Gains a buff after dealing sufficient damage, amplifying her next spell\n\n\nExpertise:\nBooks, Staves"
msgstr "*Después de infligir el daño suficiente, obtiene una mejora que amplifica su siguiente conjuro\n\n\nEspecialidad:\nLibros, báculos"

#. STRINGS.LAVAARENA_CHARACTER_DESCRIPTIONS.willow
msgctxt "STRINGS.LAVAARENA_CHARACTER_DESCRIPTIONS.willow"
msgid "*Protected by Bernie the Bear\n*Fire and Explosive attack damage increased by 10%\n\nExpertise:\nDarts, Staves"
msgstr "*Bernie el Oso es su protector\n*Aumenta en un 10 % el daño de fuego y explosivo\n\nEspecialidad:\nDardos, báculos"

#. STRINGS.LAVAARENA_CHARACTER_DESCRIPTIONS.wilson
msgctxt "STRINGS.LAVAARENA_CHARACTER_DESCRIPTIONS.wilson"
msgid "*Revives allies twice as quickly\n*Restores three times more health when reviving allies\n\nExpertise:\nMelee, Darts, Staves"
msgstr "*Revive a los aliados hasta dos veces más rápido\n*Recupera el triple de salud cuando revive a los aliados\n\nEspecialidad:\nCuerpo a cuerpo, dardos, báculos"

#. STRINGS.LAVAARENA_CHARACTER_DESCRIPTIONS.winona
msgctxt "STRINGS.LAVAARENA_CHARACTER_DESCRIPTIONS.winona"
msgid "*All ability cooldowns are 10% faster\n\n\n\nExpertise:\nMelee, Darts, Staves"
msgstr "*Todas las recargas de habilidades son un 10 % más rápidas\n\n\n\nEspecialidad:\nCuerpo a cuerpo, dardos, báculos"

#. STRINGS.LAVAARENA_CHARACTER_DESCRIPTIONS.wolfgang
msgctxt "STRINGS.LAVAARENA_CHARACTER_DESCRIPTIONS.wolfgang"
msgid "*Becomes Mighty when health is low, increasing attack power, defense, and movement speed for 10 seconds\n\nExpertise:\nMelee"
msgstr "*Se convierte en poderoso cuando tiene poca salud, lo que aumenta su poder de ataque, defensa y velocidad de movimiento durante 10 segundos\nEspecialidad:\n\nCuerpo a cuerpo"

#. STRINGS.LAVAARENA_CHARACTER_DESCRIPTIONS.wonkey
msgctxt "STRINGS.LAVAARENA_CHARACTER_DESCRIPTIONS.wonkey"
msgid "PLACEHOLDER\n\n\n\nExpertise:\nPLACEHOLDER"
msgstr "*PLACEHOLDER\n\n\n\nEspecialidad:\nPLACEHOLDER"

#. STRINGS.LAVAARENA_CHARACTER_DESCRIPTIONS.woodie
msgctxt "STRINGS.LAVAARENA_CHARACTER_DESCRIPTIONS.woodie"
msgid "*Lucy returns to Woodie when thrown\n*Attack speed increased when wielding Lucy\n\nExpertise:\nMelee"
msgstr "*Lucy regresa a Woodie cuando la arroja\n*La velocidad de ataque aumenta cuando tiene a Lucy en la mano\n\nEspecialidad:\nCuerpo a cuerpo"

#. STRINGS.LAVAARENA_CHARACTER_DESCRIPTIONS.woodie_canada
msgctxt "STRINGS.LAVAARENA_CHARACTER_DESCRIPTIONS.woodie_canada"
msgid "*Lucy returns to Woodie when thrown\n*Attack speed increased when wielding Lucy\n\nExpertise:\nMelee"
msgstr "*Lucy regresa a Woodie cuando la arroja\n*La velocidad de ataque aumenta cuando tiene a Lucy en la mano\n\nEspecialidad:\nCuerpo a cuerpo"

#. STRINGS.LAVAARENA_CHARACTER_DESCRIPTIONS.woodie_us
msgctxt "STRINGS.LAVAARENA_CHARACTER_DESCRIPTIONS.woodie_us"
msgid "*Lucy returns to Woodie when thrown\n*Attack speed increased when wielding Lucy\n\nExpertise:\nMelee"
msgstr "*Lucy regresa a Woodie cuando la arroja\n*La velocidad de ataque aumenta cuando tiene a Lucy en la mano\n\nEspecialidad:\nCuerpo a cuerpo"

#. STRINGS.LAVAARENA_CHARACTER_DESCRIPTIONS.wormwood
msgctxt "STRINGS.LAVAARENA_CHARACTER_DESCRIPTIONS.wormwood"
msgid "*PLACEHOLDER\n\n\n\nExpertise:\nPLACEHOLDER"
msgstr "*PLACEHOLDER\n\n\n\nEspecialidad:\nPLACEHOLDER"

#. STRINGS.LAVAARENA_CHARACTER_DESCRIPTIONS.wortox
msgctxt "STRINGS.LAVAARENA_CHARACTER_DESCRIPTIONS.wortox"
msgid "*PLACEHOLDER\n\n\n\nExpertise:\nPLACEHOLDER"
msgstr "*PLACEHOLDER\n\n\n\nEspecialidad:\nPLACEHOLDER"

#. STRINGS.LAVAARENA_CHARACTER_DESCRIPTIONS.wurt
msgctxt "STRINGS.LAVAARENA_CHARACTER_DESCRIPTIONS.wurt"
msgid "*PLACEHOLDER\n\n\n\nExpertise:\nPLACEHOLDER"
msgstr "*PLACEHOLDER\n\n\n\nEspecialidad:\nPLACEHOLDER"

#. STRINGS.LAVAARENA_CHARACTER_DESCRIPTIONS.wx78
msgctxt "STRINGS.LAVAARENA_CHARACTER_DESCRIPTIONS.wx78"
msgid "*Shocks enemies when attacked\n*Electric attack damage increased by 50%\n\nExpertise:\nMelee"
msgstr "*Inflige una descarga eléctrica a sus enemigos cuando le atacan\n*Aumenta en un 50 % el daño de ataques eléctricos\n\nEspecialidad:\nCuerpo a cuerpo"

#. STRINGS.LAVALUCY.equipped.1
msgctxt "STRINGS.LAVALUCY.equipped.1"
msgid "It's so hot!"
msgstr "¡Está que arde!"

#. STRINGS.LAVALUCY.equipped.2
msgctxt "STRINGS.LAVALUCY.equipped.2"
msgid "Throw me!"
msgstr "¡Lánzame!"

#. STRINGS.LAVALUCY.equipped.3
msgctxt "STRINGS.LAVALUCY.equipped.3"
msgid "I think we're winning!"
msgstr "¡Creo que llevamos la delantera!"

#. STRINGS.LAVALUCY.equipped.4
msgctxt "STRINGS.LAVALUCY.equipped.4"
msgid "They don't stand a chance!"
msgstr "¡No tienen oportunidad alguna!"

#. STRINGS.LAVALUCY.equipped.5
msgctxt "STRINGS.LAVALUCY.equipped.5"
msgid "Gosh it's hot in here."
msgstr "Uf, qué calor."

#. STRINGS.LAVALUCY.equipped.6
msgctxt "STRINGS.LAVALUCY.equipped.6"
msgid "Fight! Fight!"
msgstr "¡Pelea! ¡Pelea!"

#. STRINGS.LAVALUCY.equipped.7
msgctxt "STRINGS.LAVALUCY.equipped.7"
msgid "Get'em!"
msgstr "¡Atrápalos!"

#. STRINGS.LAVALUCY.equipped.8
msgctxt "STRINGS.LAVALUCY.equipped.8"
msgid "Give them the chop!"
msgstr "¡Tálales la cabeza!"

#. STRINGS.LAVALUCY.equipped.9
msgctxt "STRINGS.LAVALUCY.equipped.9"
msgid "The crowd is so loud!"
msgstr "¡El público quiere más!"

#. STRINGS.LAVALUCY.missedenemy.1
msgctxt "STRINGS.LAVALUCY.missedenemy.1"
msgid "Whoops!"
msgstr "¡Ups!"

#. STRINGS.LAVALUCY.missedenemy.2
msgctxt "STRINGS.LAVALUCY.missedenemy.2"
msgid "I missed!"
msgstr "¡Fallé!"

#. STRINGS.LAVALUCY.missedenemy.3
msgctxt "STRINGS.LAVALUCY.missedenemy.3"
msgid "Shoot!"
msgstr "¡Dispara!"

#. STRINGS.LAVALUCY.missedenemy.4
msgctxt "STRINGS.LAVALUCY.missedenemy.4"
msgid "Hey!"
msgstr "¡Ey!"

#. STRINGS.LAVALUCY.missedenemy.5
msgctxt "STRINGS.LAVALUCY.missedenemy.5"
msgid "Get back here!"
msgstr "¡Vuelve!"

#. STRINGS.LAVALUCY.other_owner.1
msgctxt "STRINGS.LAVALUCY.other_owner.1"
msgid "I'm not too crazy about this."
msgstr "No es que me emocione demasiado."

#. STRINGS.LAVALUCY.other_owner.2
msgctxt "STRINGS.LAVALUCY.other_owner.2"
msgid "You're not holding me right!"
msgstr "¡Tienes que sostenerme mejor!"

#. STRINGS.LAVALUCY.other_owner.3
msgctxt "STRINGS.LAVALUCY.other_owner.3"
msgid "Your hands are clammy."
msgstr "Tienes las manos pegajosas."

#. STRINGS.LAVALUCY.other_owner.4
msgctxt "STRINGS.LAVALUCY.other_owner.4"
msgid "Just throw me already!"
msgstr "¡Lánzame de una vez!"

#. STRINGS.LAVALUCY.other_owner.5
msgctxt "STRINGS.LAVALUCY.other_owner.5"
msgid "This won't be a regular thing."
msgstr "No creo que se repita seguido."

#. STRINGS.LAVALUCY.other_owner.6
msgctxt "STRINGS.LAVALUCY.other_owner.6"
msgid "Don't read too much into this."
msgstr "No lo pienses demasiado."

#. STRINGS.LAVALUCY.struckenemy.1
msgctxt "STRINGS.LAVALUCY.struckenemy.1"
msgid "Gotcha!"
msgstr "¡Te tengo!"

#. STRINGS.LAVALUCY.struckenemy.2
msgctxt "STRINGS.LAVALUCY.struckenemy.2"
msgid "Take that!"
msgstr "¡Toma eso!"

#. STRINGS.LAVALUCY.struckenemy.3
msgctxt "STRINGS.LAVALUCY.struckenemy.3"
msgid "Take this!"
msgstr "¡Toma!"

#. STRINGS.LAVALUCY.struckenemy.4
msgctxt "STRINGS.LAVALUCY.struckenemy.4"
msgid "Bull's eye!"
msgstr "¡En el blanco!"

#. STRINGS.LAVALUCY.struckenemy.5
msgctxt "STRINGS.LAVALUCY.struckenemy.5"
msgid "Ha!"
msgstr "¡Ja!"

#. STRINGS.LAVALUCY.struckenemy.6
msgctxt "STRINGS.LAVALUCY.struckenemy.6"
msgid "Thwack!"
msgstr "¡Toma!"

#. STRINGS.LUCY.beaver_down_early.1
msgctxt "STRINGS.LUCY.beaver_down_early.1"
msgid "Are you okay?"
msgstr "¿Estás bien?"

#. STRINGS.LUCY.beaver_down_early.2
msgctxt "STRINGS.LUCY.beaver_down_early.2"
msgid "You alright, big guy?"
msgstr "¿Estás bien, grandulón?"

#. STRINGS.LUCY.beaver_down_early.3
msgctxt "STRINGS.LUCY.beaver_down_early.3"
msgid "What's wrong?"
msgstr "¿Qué ocurre?"

#. STRINGS.LUCY.beaver_down_early.4
msgctxt "STRINGS.LUCY.beaver_down_early.4"
msgid "Are you sure you're feeling alright?"
msgstr "¿Seguro que te sientes bien?"

#. STRINGS.LUCY.beaver_down_early.5
msgctxt "STRINGS.LUCY.beaver_down_early.5"
msgid "You're looking extra gruff today."
msgstr "Hoy pareces realmente brusco."

#. STRINGS.LUCY.beaver_down_early.6
msgctxt "STRINGS.LUCY.beaver_down_early.6"
msgid "You look distracted."
msgstr "Pareces distraído."

#. STRINGS.LUCY.beaver_down_early.7
msgctxt "STRINGS.LUCY.beaver_down_early.7"
msgid "Why are you making that face?"
msgstr "¿Por qué pones esa cara?"

#. STRINGS.LUCY.beaver_down_early.8
msgctxt "STRINGS.LUCY.beaver_down_early.8"
msgid "Try to take deep breaths, okay?"
msgstr "Trata de respirar hondo, ¿sí?"

#. STRINGS.LUCY.beaver_down_late.1
msgctxt "STRINGS.LUCY.beaver_down_late.1"
msgid "You're overdoing it!"
msgstr "¡Te estás pasando!"

#. STRINGS.LUCY.beaver_down_late.2
msgctxt "STRINGS.LUCY.beaver_down_late.2"
msgid "You're not pacing yourself!"
msgstr "¡No estás yendo a tu ritmo!"

#. STRINGS.LUCY.beaver_down_late.3
msgctxt "STRINGS.LUCY.beaver_down_late.3"
msgid "You're about to change!"
msgstr "¡Estás a punto de cambiar!"

#. STRINGS.LUCY.beaver_down_late.4
msgctxt "STRINGS.LUCY.beaver_down_late.4"
msgid "Take it easy!"
msgstr "¡Tómatelo con calma!"

#. STRINGS.LUCY.beaver_down_late.5
msgctxt "STRINGS.LUCY.beaver_down_late.5"
msgid "You've gotta slow down!"
msgstr "¡Tienes que frenarte!"

#. STRINGS.LUCY.beaver_down_late.6
msgctxt "STRINGS.LUCY.beaver_down_late.6"
msgid "Slow down, I'm worried about you!"
msgstr "¡Para, me estás preocupando!"

#. STRINGS.LUCY.beaver_down_late.7
msgctxt "STRINGS.LUCY.beaver_down_late.7"
msgid "Watch out! You're going to turn!"
msgstr "¡Cuidado! ¡Vas a torcerte!"

#. STRINGS.LUCY.beaver_down_mid.1
msgctxt "STRINGS.LUCY.beaver_down_mid.1"
msgid "Hello? Can you hear me?"
msgstr "¿Hola? ¿Me oyes?"

#. STRINGS.LUCY.beaver_down_mid.2
msgctxt "STRINGS.LUCY.beaver_down_mid.2"
msgid "Isn't it about time for a nice wood snack?"
msgstr "¿No es hora de un buen aperitivo de madera?"

#. STRINGS.LUCY.beaver_down_mid.3
msgctxt "STRINGS.LUCY.beaver_down_mid.3"
msgid "Woodie! Remember to eat your twigs!"
msgstr "¡Woodie! ¡Acuérdate de comer tus ramas!"

#. STRINGS.LUCY.beaver_down_mid.4
msgctxt "STRINGS.LUCY.beaver_down_mid.4"
msgid "You might want to eat a log."
msgstr "Tal vez quieras comer un tronco."

#. STRINGS.LUCY.beaver_down_mid.5
msgctxt "STRINGS.LUCY.beaver_down_mid.5"
msgid "Mmm, bark... doesn't that sound good right now? Hm?"
msgstr "Mmm, corteza... ¿no te apetece? ¿Mmm?"

#. STRINGS.LUCY.beaver_down_mid.6
msgctxt "STRINGS.LUCY.beaver_down_mid.6"
msgid "Have you been putting off your wood meals again?"
msgstr "¿Has estado otra vez posponiendo tus comidas de madera?"

#. STRINGS.LUCY.beaver_down_mid.7
msgctxt "STRINGS.LUCY.beaver_down_mid.7"
msgid "Hey, hey, have a woodchip."
msgstr "Eh, eh, toma tus chips de madera."

#. STRINGS.LUCY.beaver_down_mid.8
msgctxt "STRINGS.LUCY.beaver_down_mid.8"
msgid "You know what happens if you don't eat enough wood!"
msgstr "¡Ya sabes lo que pasa si no comes suficiente madera!"

#. STRINGS.LUCY.beaver_up_waslow.1
msgctxt "STRINGS.LUCY.beaver_up_waslow.1"
msgid "That was a close one!"
msgstr "¡Eso estuvo cerca!"

#. STRINGS.LUCY.beaver_up_waslow.2
msgctxt "STRINGS.LUCY.beaver_up_waslow.2"
msgid "I think we'll be alright."
msgstr "Creo que estaremos bien."

#. STRINGS.LUCY.beaver_up_waslow.3
msgctxt "STRINGS.LUCY.beaver_up_waslow.3"
msgid "You're looking much better now."
msgstr "Ahora luces mucho mejor."

#. STRINGS.LUCY.beaver_up_waslow.4
msgctxt "STRINGS.LUCY.beaver_up_waslow.4"
msgid "It's passed. For now."
msgstr "Ya pasó. Por ahora."

#. STRINGS.LUCY.beaver_up_waslow.5
msgctxt "STRINGS.LUCY.beaver_up_waslow.5"
msgid "I was silly to doubt you."
msgstr "Fui tonta por dudar de ti."

#. STRINGS.LUCY.beaver_up_waslow.6
msgctxt "STRINGS.LUCY.beaver_up_waslow.6"
msgid "Wow, I was afraid you were in for it!"
msgstr "¡Oh, tenía miedo de perderte!"

#. STRINGS.LUCY.beaver_up_waslow.7
msgctxt "STRINGS.LUCY.beaver_up_waslow.7"
msgid "I think the colour's returning to your cheeks."
msgstr "Creo que el color está regresando a tus mejillas."

#. STRINGS.LUCY.beaver_up_waslow.8
msgctxt "STRINGS.LUCY.beaver_up_waslow.8"
msgid "It's back in the lodge. Phew!"
msgstr "Volvió a la cabaña. ¡Fiu!"

#. STRINGS.LUCY.carve_walking_stick.1
msgctxt "STRINGS.LUCY.carve_walking_stick.1"
msgid "Only the best for you, buddy!"
msgstr "¡Solo lo mejor para ti, compa!"

#. STRINGS.LUCY.carve_walking_stick.2
msgctxt "STRINGS.LUCY.carve_walking_stick.2"
msgid "Heh, this one's gonna be something special!"
msgstr "¡Je, este tiene que ser especial!"

#. STRINGS.LUCY.carve_woodcarvedhat.1
msgctxt "STRINGS.LUCY.carve_woodcarvedhat.1"
msgid "Gotta protect that pretty head of yours!"
msgstr "¡Tienes que proteger tu cerebrito!"

#. STRINGS.LUCY.carve_woodcarvedhat.2
msgctxt "STRINGS.LUCY.carve_woodcarvedhat.2"
msgid "Watch me work my magic!"
msgstr "¡Observa la magia!"

#. STRINGS.LUCY.carve_woodie_boards.1
msgctxt "STRINGS.LUCY.carve_woodie_boards.1"
msgid "Don't get a splinter!"
msgstr "¡No te claves una astilla!"

#. STRINGS.LUCY.carve_woodie_boards.2
msgctxt "STRINGS.LUCY.carve_woodie_boards.2"
msgid "You want boards? I'll show you boards! Hee-YAH!"
msgstr "¿Quieres tablas? ¡Te mostraré unas buenas tablas! ¡Yupi!"

#. STRINGS.LUCY.equipped.1
msgctxt "STRINGS.LUCY.equipped.1"
msgid "Let's chop some trees!"
msgstr "¡Vamos a talar algunos árboles!"

#. STRINGS.LUCY.equipped.10
msgctxt "STRINGS.LUCY.equipped.10"
msgid "Chop chop chop. Heh."
msgstr "Talar, talar, talar. Je."

#. STRINGS.LUCY.equipped.11
msgctxt "STRINGS.LUCY.equipped.11"
msgid "Chop, c-c-chop!"
msgstr "¡Tala, taaala!"

#. STRINGS.LUCY.equipped.12
msgctxt "STRINGS.LUCY.equipped.12"
msgid "So, stone trees... what's up with that?"
msgstr "Así que árboles de piedra... ¿y eso?"

#. STRINGS.LUCY.equipped.13
msgctxt "STRINGS.LUCY.equipped.13"
msgid "Let's find a small grove and just go nuts!"
msgstr "¡Encontremos una pequeña arboleda y talemos sin parar!"

#. STRINGS.LUCY.equipped.2
msgctxt "STRINGS.LUCY.equipped.2"
msgid "Nice day for a walk!"
msgstr "¡Bonito día para dar un paseo!"

#. STRINGS.LUCY.equipped.3
msgctxt "STRINGS.LUCY.equipped.3"
msgid "We make a good team!"
msgstr "¡Hacemos un gran equipo!"

#. STRINGS.LUCY.equipped.4
msgctxt "STRINGS.LUCY.equipped.4"
msgid "There must be some trees around here somewhere."
msgstr "Debe de haber algunos árboles por aquí."

#. STRINGS.LUCY.equipped.5
msgctxt "STRINGS.LUCY.equipped.5"
msgid "This is perfect chopping weather."
msgstr "El tiempo perfecto para talar."

#. STRINGS.LUCY.equipped.6
msgctxt "STRINGS.LUCY.equipped.6"
msgid "A perfect day for some chopping."
msgstr "El día perfecto para talar un poco."

#. STRINGS.LUCY.equipped.7
msgctxt "STRINGS.LUCY.equipped.7"
msgid "You've got chops, buddy."
msgstr "Vamos a talar, compa."

#. STRINGS.LUCY.equipped.8
msgctxt "STRINGS.LUCY.equipped.8"
msgid "Hey! Chop some trees!"
msgstr "¡Eh! ¡Tala algunos árboles!"

#. STRINGS.LUCY.equipped.9
msgctxt "STRINGS.LUCY.equipped.9"
msgid "All work and no play makes me want to chop some trees."
msgstr "Trabajar y no jugar me hace querer talar algunos árboles."

#. STRINGS.LUCY.in_container.1
msgctxt "STRINGS.LUCY.in_container.1"
msgid "It's dark in here!"
msgstr "¡Está oscuro aquí!"

#. STRINGS.LUCY.in_container.10
msgctxt "STRINGS.LUCY.in_container.10"
msgid "I can't see anything!"
msgstr "¡No veo nada!"

#. STRINGS.LUCY.in_container.11
msgctxt "STRINGS.LUCY.in_container.11"
msgid "This is honestly the worst."
msgstr "La verdad, esto es lo peor."

#. STRINGS.LUCY.in_container.12
msgctxt "STRINGS.LUCY.in_container.12"
msgid "I hate it in here."
msgstr "Odio estar aquí."

#. STRINGS.LUCY.in_container.13
msgctxt "STRINGS.LUCY.in_container.13"
msgid "What did I ever do to you?"
msgstr "¿Qué te hice yo?"

#. STRINGS.LUCY.in_container.2
msgctxt "STRINGS.LUCY.in_container.2"
msgid "I'm scared!"
msgstr "¡Tengo miedo!"

#. STRINGS.LUCY.in_container.3
msgctxt "STRINGS.LUCY.in_container.3"
msgid "Help! Get me out!"
msgstr "¡Ayuda! ¡Sáquenme de aquí!"

#. STRINGS.LUCY.in_container.4
msgctxt "STRINGS.LUCY.in_container.4"
msgid "There's nothing to chop in here!"
msgstr "¡No hay nada que talar aquí!"

#. STRINGS.LUCY.in_container.5
msgctxt "STRINGS.LUCY.in_container.5"
msgid "This sucks."
msgstr "Qué asco."

#. STRINGS.LUCY.in_container.6
msgctxt "STRINGS.LUCY.in_container.6"
msgid "Getttt meeee outttt!"
msgstr "¡Sáquenmeeeeee de aquííí!"

#. STRINGS.LUCY.in_container.7
msgctxt "STRINGS.LUCY.in_container.7"
msgid "I'm claustrophobic!"
msgstr "¡Tengo claustrofobia!"

#. STRINGS.LUCY.in_container.8
msgctxt "STRINGS.LUCY.in_container.8"
msgid "I have a fear of tight spaces!"
msgstr "¡Me dan miedo los espacios reducidos!"

#. STRINGS.LUCY.in_container.9
msgctxt "STRINGS.LUCY.in_container.9"
msgid "I can't breathe! Wait."
msgstr "¡No puedo respirar! Espera."

#. STRINGS.LUCY.on_chopped.1
msgctxt "STRINGS.LUCY.on_chopped.1"
msgid "Woooooo!"
msgstr "¡Woooooo!"

#. STRINGS.LUCY.on_chopped.10
msgctxt "STRINGS.LUCY.on_chopped.10"
msgid "Woo-hoohoo!"
msgstr "¡Yujuuuuu!"

#. STRINGS.LUCY.on_chopped.11
msgctxt "STRINGS.LUCY.on_chopped.11"
msgid "RAAAA!"
msgstr "¡AAAAH!"

#. STRINGS.LUCY.on_chopped.12
msgctxt "STRINGS.LUCY.on_chopped.12"
msgid "Die! Die!"
msgstr "¡Muere! ¡Muere!"

#. STRINGS.LUCY.on_chopped.13
msgctxt "STRINGS.LUCY.on_chopped.13"
msgid "Chop! Chop!"
msgstr "¡Tala! ¡Tala!"

#. STRINGS.LUCY.on_chopped.14
msgctxt "STRINGS.LUCY.on_chopped.14"
msgid "Destruction!"
msgstr "¡Destrucción!"

#. STRINGS.LUCY.on_chopped.15
msgctxt "STRINGS.LUCY.on_chopped.15"
msgid "CHOP!"
msgstr "¡CORTA!"

#. STRINGS.LUCY.on_chopped.16
msgctxt "STRINGS.LUCY.on_chopped.16"
msgid "This is AWESOME!"
msgstr "¡IMPRESIONANTE!"

#. STRINGS.LUCY.on_chopped.17
msgctxt "STRINGS.LUCY.on_chopped.17"
msgid "Death to all trees!"
msgstr "¡Muerte a todos los árboles!"

#. STRINGS.LUCY.on_chopped.18
msgctxt "STRINGS.LUCY.on_chopped.18"
msgid "Again! Let's chop another!"
msgstr "¡Otra vez! ¡Vamos a talar otro!"

#. STRINGS.LUCY.on_chopped.19
msgctxt "STRINGS.LUCY.on_chopped.19"
msgid "Nice swing!"
msgstr "¡Buen movimiento!"

#. STRINGS.LUCY.on_chopped.2
msgctxt "STRINGS.LUCY.on_chopped.2"
msgid "Yeah!"
msgstr "¡Sí!"

#. STRINGS.LUCY.on_chopped.20
msgctxt "STRINGS.LUCY.on_chopped.20"
msgid "Too easy!"
msgstr "¡Qué fácil!"

#. STRINGS.LUCY.on_chopped.3
msgctxt "STRINGS.LUCY.on_chopped.3"
msgid "Stupid tree!"
msgstr "¡Estúpido árbol!"

#. STRINGS.LUCY.on_chopped.4
msgctxt "STRINGS.LUCY.on_chopped.4"
msgid "Nom nom nom!"
msgstr "¡Ñam, ñam, ñam!"

#. STRINGS.LUCY.on_chopped.5
msgctxt "STRINGS.LUCY.on_chopped.5"
msgid "We did it!"
msgstr "¡Lo logramos!"

#. STRINGS.LUCY.on_chopped.6
msgctxt "STRINGS.LUCY.on_chopped.6"
msgid "I feel ALIVE!"
msgstr "¡Me siento VIVA!"

#. STRINGS.LUCY.on_chopped.7
msgctxt "STRINGS.LUCY.on_chopped.7"
msgid "HaHAHA!"
msgstr "¡JA, JA, JA!"

#. STRINGS.LUCY.on_chopped.8
msgctxt "STRINGS.LUCY.on_chopped.8"
msgid "YEEEESS!"
msgstr "¡SÍÍÍÍÍÍÍ!"

#. STRINGS.LUCY.on_chopped.9
msgctxt "STRINGS.LUCY.on_chopped.9"
msgid "This is what I live for!"
msgstr "¡Para esto vivo!"

#. STRINGS.LUCY.on_dropped.1
msgctxt "STRINGS.LUCY.on_dropped.1"
msgid "You'll come back, right?"
msgstr "Volverás, ¿verdad?"

#. STRINGS.LUCY.on_dropped.10
msgctxt "STRINGS.LUCY.on_dropped.10"
msgid "Aren't we friends?"
msgstr "¿Es que no somos amigos?"

#. STRINGS.LUCY.on_dropped.11
msgctxt "STRINGS.LUCY.on_dropped.11"
msgid "Who chucks a talking axe?!"
msgstr "¿¡Quién lanza un hacha que habla!?"

#. STRINGS.LUCY.on_dropped.12
msgctxt "STRINGS.LUCY.on_dropped.12"
msgid "I... don't understand!"
msgstr "¡No... no lo entiendo!"

#. STRINGS.LUCY.on_dropped.13
msgctxt "STRINGS.LUCY.on_dropped.13"
msgid "Can we talk about this?"
msgstr "¿Podemos hablar sobre esto?"

#. STRINGS.LUCY.on_dropped.14
msgctxt "STRINGS.LUCY.on_dropped.14"
msgid "Don't forget about me!"
msgstr "¡No te olvides de mí!"

#. STRINGS.LUCY.on_dropped.15
msgctxt "STRINGS.LUCY.on_dropped.15"
msgid "Oof!"
msgstr "¡Uf!"

#. STRINGS.LUCY.on_dropped.16
msgctxt "STRINGS.LUCY.on_dropped.16"
msgid "I don't like where this is going."
msgstr "No me gusta hacia dónde va esto."

#. STRINGS.LUCY.on_dropped.17
msgctxt "STRINGS.LUCY.on_dropped.17"
msgid "Are... are you gonna make like a tree?"
msgstr "¿Vas... a hacerme como a un árbol?"

#. STRINGS.LUCY.on_dropped.18
msgctxt "STRINGS.LUCY.on_dropped.18"
msgid "Ouch!"
msgstr "¡Auch!"

#. STRINGS.LUCY.on_dropped.2
msgctxt "STRINGS.LUCY.on_dropped.2"
msgid "What did I say?"
msgstr "¿Qué te dije?"

#. STRINGS.LUCY.on_dropped.3
msgctxt "STRINGS.LUCY.on_dropped.3"
msgid "Oh, that's low."
msgstr "Oh, qué bajo."

#. STRINGS.LUCY.on_dropped.4
msgctxt "STRINGS.LUCY.on_dropped.4"
msgid "Don't leave! I... I think I smell roses!"
msgstr "¡No te vayas! ¡Creo... creo que huelo a rosas!"

#. STRINGS.LUCY.on_dropped.5
msgctxt "STRINGS.LUCY.on_dropped.5"
msgid "I know this is only temporary..."
msgstr "Ya sé que esto es solo temporal..."

#. STRINGS.LUCY.on_dropped.6
msgctxt "STRINGS.LUCY.on_dropped.6"
msgid "Awww..."
msgstr "Aaay..."

#. STRINGS.LUCY.on_dropped.7
msgctxt "STRINGS.LUCY.on_dropped.7"
msgid "Oh, is that how it is?!"
msgstr "¿¡Oh, así que esto es lo que hay!?"

#. STRINGS.LUCY.on_dropped.8
msgctxt "STRINGS.LUCY.on_dropped.8"
msgid "Hey! I'd never throw you away!"
msgstr "¡Eh! ¡Yo nunca te tiraría!"

#. STRINGS.LUCY.on_dropped.9
msgctxt "STRINGS.LUCY.on_dropped.9"
msgid "Why would you throw me away?"
msgstr "¿Por qué quieres tirarme?"

#. STRINGS.LUCY.on_ground.1
msgctxt "STRINGS.LUCY.on_ground.1"
msgid "Come back! Take me with you!"
msgstr "¡No te vayas! ¡Llévame contigo!"

#. STRINGS.LUCY.on_ground.10
msgctxt "STRINGS.LUCY.on_ground.10"
msgid "Hey! Get back over here!"
msgstr "¡Eh! ¡Vuelve aquí!"

#. STRINGS.LUCY.on_ground.11
msgctxt "STRINGS.LUCY.on_ground.11"
msgid "I can't chop trees by myself!"
msgstr "¡No puedo talar los árboles yo sola!"

#. STRINGS.LUCY.on_ground.12
msgctxt "STRINGS.LUCY.on_ground.12"
msgid "So... lonely..."
msgstr "Tan... solitaria..."

#. STRINGS.LUCY.on_ground.13
msgctxt "STRINGS.LUCY.on_ground.13"
msgid "I guess I'll just stay here then..."
msgstr "Supongo que me quedaré aquí entonces..."

#. STRINGS.LUCY.on_ground.14
msgctxt "STRINGS.LUCY.on_ground.14"
msgid "What if I get stolen?!"
msgstr "¿Y si me alguien me roba?"

#. STRINGS.LUCY.on_ground.2
msgctxt "STRINGS.LUCY.on_ground.2"
msgid "Where did you go?"
msgstr "¿Dónde te habías ido?"

#. STRINGS.LUCY.on_ground.3
msgctxt "STRINGS.LUCY.on_ground.3"
msgid "Take me with you!"
msgstr "¡Llévame contigo!"

#. STRINGS.LUCY.on_ground.4
msgctxt "STRINGS.LUCY.on_ground.4"
msgid "It's cold!"
msgstr "¡Hace frío!"

#. STRINGS.LUCY.on_ground.5
msgctxt "STRINGS.LUCY.on_ground.5"
msgid "I'm getting dirty!"
msgstr "¡Me estoy ensuciando!"

#. STRINGS.LUCY.on_ground.6
msgctxt "STRINGS.LUCY.on_ground.6"
msgid "There's monsters around you know!"
msgstr "¡Hay monstruos alrededor!"

#. STRINGS.LUCY.on_ground.7
msgctxt "STRINGS.LUCY.on_ground.7"
msgid "I resent that!"
msgstr "¡Me molesta eso!"

#. STRINGS.LUCY.on_ground.8
msgctxt "STRINGS.LUCY.on_ground.8"
msgid "You're abandoning me?!"
msgstr "¿¡Me estás abandonando!?"

#. STRINGS.LUCY.on_ground.9
msgctxt "STRINGS.LUCY.on_ground.9"
msgid "But... but we're inseparable!"
msgstr "¡Pero... pero somos inseparables!"

#. STRINGS.LUCY.on_haunt.1
msgctxt "STRINGS.LUCY.on_haunt.1"
msgid "Ouch, that hurts."
msgstr "Ay, eso duele."

#. STRINGS.LUCY.on_haunt.10
msgctxt "STRINGS.LUCY.on_haunt.10"
msgid "What did I ever do to you!?"
msgstr "¿¡Pero qué te hice!?"

#. STRINGS.LUCY.on_haunt.11
msgctxt "STRINGS.LUCY.on_haunt.11"
msgid "You're the ghostest with the mostest!"
msgstr "¡Eres el fantasma más fantasma!"

#. STRINGS.LUCY.on_haunt.12
msgctxt "STRINGS.LUCY.on_haunt.12"
msgid "Don't take it out on me just 'cause you're dead!"
msgstr "¡No la tomes conmigo solo porque estás muerto!"

#. STRINGS.LUCY.on_haunt.13
msgctxt "STRINGS.LUCY.on_haunt.13"
msgid "If you were corporeal I'd chop you!"
msgstr "¡Si fueses corpóreo te talaría!"

#. STRINGS.LUCY.on_haunt.14
msgctxt "STRINGS.LUCY.on_haunt.14"
msgid "OOooOOooOOoo! Haha, just kidding."
msgstr "¡OOooOOooOOoo! Ja, ja, era broma."

#. STRINGS.LUCY.on_haunt.15
msgctxt "STRINGS.LUCY.on_haunt.15"
msgid "Creepy!"
msgstr "¡Espeluznante!"

#. STRINGS.LUCY.on_haunt.16
msgctxt "STRINGS.LUCY.on_haunt.16"
msgid "Brrr! You're cold!"
msgstr "¡Brrr! ¡Estás frío!"

#. STRINGS.LUCY.on_haunt.17
msgctxt "STRINGS.LUCY.on_haunt.17"
msgid "You got ectoplasm on my handle!!"
msgstr "¡¡Tienes ectoplasma en mi empuñadura!!"

#. STRINGS.LUCY.on_haunt.18
msgctxt "STRINGS.LUCY.on_haunt.18"
msgid "Knock it off!"
msgstr "¡Déjame!"

#. STRINGS.LUCY.on_haunt.19
msgctxt "STRINGS.LUCY.on_haunt.19"
msgid "Rude!"
msgstr "¡Grosero!"

#. STRINGS.LUCY.on_haunt.2
msgctxt "STRINGS.LUCY.on_haunt.2"
msgid "ooOOoooOO to you too."
msgstr "ooOOoooOO a ti también."

#. STRINGS.LUCY.on_haunt.20
msgctxt "STRINGS.LUCY.on_haunt.20"
msgid "I am an axe possessed!"
msgstr "¡Soy un hacha poseída!"

#. STRINGS.LUCY.on_haunt.21
msgctxt "STRINGS.LUCY.on_haunt.21"
msgid "Pick on someone your own size!"
msgstr "¡Búscate a alguien de tu tamaño!"

#. STRINGS.LUCY.on_haunt.22
msgctxt "STRINGS.LUCY.on_haunt.22"
msgid "Hey!"
msgstr "¡Ey!"

#. STRINGS.LUCY.on_haunt.23
msgctxt "STRINGS.LUCY.on_haunt.23"
msgid "Jeez! Did I anger you in a past life?"
msgstr "¡Ay! ¿Te molesté en una vida pasada?"

#. STRINGS.LUCY.on_haunt.24
msgctxt "STRINGS.LUCY.on_haunt.24"
msgid "I'm white as a sheet."
msgstr "Estoy blanca como una hoja."

#. STRINGS.LUCY.on_haunt.25
msgctxt "STRINGS.LUCY.on_haunt.25"
msgid "You're looking boo-tiful today."
msgstr "Tienes un aspecto de muerte hoy."

#. STRINGS.LUCY.on_haunt.3
msgctxt "STRINGS.LUCY.on_haunt.3"
msgid "Now I'm a HAUNTED axe."
msgstr "Ahora soy un hacha ENCANTADA."

#. STRINGS.LUCY.on_haunt.4
msgctxt "STRINGS.LUCY.on_haunt.4"
msgid "I'm not scared of you, ghost!"
msgstr "¡No me asustas, fantasma!"

#. STRINGS.LUCY.on_haunt.5
msgctxt "STRINGS.LUCY.on_haunt.5"
msgid "Boo who?"
msgstr "¿Uuuh a quién?"

#. STRINGS.LUCY.on_haunt.6
msgctxt "STRINGS.LUCY.on_haunt.6"
msgid "I've seen scarier."
msgstr "He visto cosas más aterradoras."

#. STRINGS.LUCY.on_haunt.7
msgctxt "STRINGS.LUCY.on_haunt.7"
msgid "You think I'm afraid of you?"
msgstr "¿Crees que me das miedo?"

#. STRINGS.LUCY.on_haunt.8
msgctxt "STRINGS.LUCY.on_haunt.8"
msgid "Do you worst, ghost."
msgstr "Piérdete, fantasma."

#. STRINGS.LUCY.on_haunt.9
msgctxt "STRINGS.LUCY.on_haunt.9"
msgid "Go bother someBODY else! Haha."
msgstr "¡Ve a molestar a otra PERSONA! Ja, ja."

#. STRINGS.LUCY.on_pickedup.1
msgctxt "STRINGS.LUCY.on_pickedup.1"
msgid "I missed you so much!"
msgstr "¡Te extrañé tanto!"

#. STRINGS.LUCY.on_pickedup.10
msgctxt "STRINGS.LUCY.on_pickedup.10"
msgid "Did you miss me?"
msgstr "¿Tú me extrañaste?"

#. STRINGS.LUCY.on_pickedup.11
msgctxt "STRINGS.LUCY.on_pickedup.11"
msgid "Together again!"
msgstr "¡Juntos de nuevo!"

#. STRINGS.LUCY.on_pickedup.2
msgctxt "STRINGS.LUCY.on_pickedup.2"
msgid "Ahhh, I'm back where I belong."
msgstr "Aaah, regreso a mi lugar."

#. STRINGS.LUCY.on_pickedup.3
msgctxt "STRINGS.LUCY.on_pickedup.3"
msgid "It feels so good to be reunited!"
msgstr "¡Cómo me gusta reunirme de nuevo!"

#. STRINGS.LUCY.on_pickedup.4
msgctxt "STRINGS.LUCY.on_pickedup.4"
msgid "I was afraid you'd never come back."
msgstr "Tenía miedo de que nunca volverías."

#. STRINGS.LUCY.on_pickedup.5
msgctxt "STRINGS.LUCY.on_pickedup.5"
msgid "You came back for me!"
msgstr "¡Has vuelto a mí!"

#. STRINGS.LUCY.on_pickedup.6
msgctxt "STRINGS.LUCY.on_pickedup.6"
msgid "Oh, thank goodness."
msgstr "Oh, gracias a Dios."

#. STRINGS.LUCY.on_pickedup.7
msgctxt "STRINGS.LUCY.on_pickedup.7"
msgid "Oh, it was awful!"
msgstr "¡Oh, fue horrible!"

#. STRINGS.LUCY.on_pickedup.8
msgctxt "STRINGS.LUCY.on_pickedup.8"
msgid "Never do that again! My little heart can't take it."
msgstr "¡No vuelvas a hacerlo! Mi corazón no puede soportarlo."

#. STRINGS.LUCY.on_pickedup.9
msgctxt "STRINGS.LUCY.on_pickedup.9"
msgid "From now on we'll be inseparable."
msgstr "A partir de ahora seremos inseparables."

#. STRINGS.LUCY.on_woodie_pickedup_other.1
msgctxt "STRINGS.LUCY.on_woodie_pickedup_other.1"
msgid "You two-timer!"
msgstr "¡Vuélvete con la otra!"

#. STRINGS.LUCY.on_woodie_pickedup_other.10
msgctxt "STRINGS.LUCY.on_woodie_pickedup_other.10"
msgid "She's an impostor!"
msgstr "¡Es una impostora!"

#. STRINGS.LUCY.on_woodie_pickedup_other.11
msgctxt "STRINGS.LUCY.on_woodie_pickedup_other.11"
msgid "It's like you don't even know me!"
msgstr "¡Es como si ya no me reconocieses!"

#. STRINGS.LUCY.on_woodie_pickedup_other.12
msgctxt "STRINGS.LUCY.on_woodie_pickedup_other.12"
msgid "Get rid of her! It's freaking me out."
msgstr "¡Deshazte de ella! Me vuelve loca."

#. STRINGS.LUCY.on_woodie_pickedup_other.13
msgctxt "STRINGS.LUCY.on_woodie_pickedup_other.13"
msgid "I'm having an identity crisis over here."
msgstr "Estoy teniendo una crisis de identidad."

#. STRINGS.LUCY.on_woodie_pickedup_other.14
msgctxt "STRINGS.LUCY.on_woodie_pickedup_other.14"
msgid "Oh, you're just AXING for trouble!"
msgstr "¡Oh, estás talando mis ilusiones!"

#. STRINGS.LUCY.on_woodie_pickedup_other.15
msgctxt "STRINGS.LUCY.on_woodie_pickedup_other.15"
msgid "You can't have two Lucys!"
msgstr "¡No puedes tener dos Lucys!"

#. STRINGS.LUCY.on_woodie_pickedup_other.16
msgctxt "STRINGS.LUCY.on_woodie_pickedup_other.16"
msgid "You can't have him! He's mine!"
msgstr "¡No puedes tenerlo! ¡Es mío!"

#. STRINGS.LUCY.on_woodie_pickedup_other.2
msgctxt "STRINGS.LUCY.on_woodie_pickedup_other.2"
msgid "But I'M your one and only Lucy!"
msgstr "¡Pero YO soy tu única Lucy!"

#. STRINGS.LUCY.on_woodie_pickedup_other.3
msgctxt "STRINGS.LUCY.on_woodie_pickedup_other.3"
msgid "There can be only one!"
msgstr "¡Solo puede haber una!"

#. STRINGS.LUCY.on_woodie_pickedup_other.4
msgctxt "STRINGS.LUCY.on_woodie_pickedup_other.4"
msgid "How dare you do this to me!"
msgstr "¿¡Cómo te atreves a hacerme esto!?"

#. STRINGS.LUCY.on_woodie_pickedup_other.5
msgctxt "STRINGS.LUCY.on_woodie_pickedup_other.5"
msgid "You're replacing me?!"
msgstr "¿¡Me estás sustituyendo!?"

#. STRINGS.LUCY.on_woodie_pickedup_other.6
msgctxt "STRINGS.LUCY.on_woodie_pickedup_other.6"
msgid "That's not me!"
msgstr "¡Esa no soy yo!"

#. STRINGS.LUCY.on_woodie_pickedup_other.7
msgctxt "STRINGS.LUCY.on_woodie_pickedup_other.7"
msgid "Betrayal!"
msgstr "¡Traidor!"

#. STRINGS.LUCY.on_woodie_pickedup_other.8
msgctxt "STRINGS.LUCY.on_woodie_pickedup_other.8"
msgid "Ooo I'll remember that!"
msgstr "¡Oooh, recordaré esto!"

#. STRINGS.LUCY.on_woodie_pickedup_other.9
msgctxt "STRINGS.LUCY.on_woodie_pickedup_other.9"
msgid "Hey! Can't you tell us apart?"
msgstr "¡Eh! ¿Es que no nos diferencias?"

#. STRINGS.LUCY.other_owner.1
msgctxt "STRINGS.LUCY.other_owner.1"
msgid "I don't know you."
msgstr "No te conozco."

#. STRINGS.LUCY.other_owner.10
msgctxt "STRINGS.LUCY.other_owner.10"
msgid "Get your mitts off me!"
msgstr "¡Quita tus guantes de encima!"

#. STRINGS.LUCY.other_owner.11
msgctxt "STRINGS.LUCY.other_owner.11"
msgid "Drop me this instant!"
msgstr "¡Suéltame ahora mismo!"

#. STRINGS.LUCY.other_owner.12
msgctxt "STRINGS.LUCY.other_owner.12"
msgid "How dare you pick me up?!"
msgstr "¿¡Cómo te atreves a levantarme!?"

#. STRINGS.LUCY.other_owner.13
msgctxt "STRINGS.LUCY.other_owner.13"
msgid "Yuck, your hands are greasy!"
msgstr "¡Puaj, tus manos están grasientas!"

#. STRINGS.LUCY.other_owner.14
msgctxt "STRINGS.LUCY.other_owner.14"
msgid "Let me go!"
msgstr "¡Déjame!"

#. STRINGS.LUCY.other_owner.15
msgctxt "STRINGS.LUCY.other_owner.15"
msgid "Help! I'm being kidnapped."
msgstr "¡Ayuda! Me están secuestrando."

#. STRINGS.LUCY.other_owner.16
msgctxt "STRINGS.LUCY.other_owner.16"
msgid "Stranger danger!"
msgstr "¡Peligro, un extraño!"

#. STRINGS.LUCY.other_owner.2
msgctxt "STRINGS.LUCY.other_owner.2"
msgid "Put me down!"
msgstr "¡Suéltame!"

#. STRINGS.LUCY.other_owner.3
msgctxt "STRINGS.LUCY.other_owner.3"
msgid "Hey! Fresh!"
msgstr "¡Eh! ¡Caradura!"

#. STRINGS.LUCY.other_owner.4
msgctxt "STRINGS.LUCY.other_owner.4"
msgid "Gross."
msgstr "Qué asquerosidad."

#. STRINGS.LUCY.other_owner.5
msgctxt "STRINGS.LUCY.other_owner.5"
msgid "Excuse you!"
msgstr "¿Disculpa?"

#. STRINGS.LUCY.other_owner.6
msgctxt "STRINGS.LUCY.other_owner.6"
msgid "Ummmm, EXCUSE me??"
msgstr "Mmmmm, ¿DISCULPA?"

#. STRINGS.LUCY.other_owner.7
msgctxt "STRINGS.LUCY.other_owner.7"
msgid "Leave me alone, you brute!"
msgstr "¡Déjame en paz, bruto!"

#. STRINGS.LUCY.other_owner.8
msgctxt "STRINGS.LUCY.other_owner.8"
msgid "Put me down! You smell!"
msgstr "¡Suéltame! ¡Apestas!"

#. STRINGS.LUCY.other_owner.9
msgctxt "STRINGS.LUCY.other_owner.9"
msgid "Did I say you could take me?"
msgstr "¿Te dije que podías llevarme?"

#. STRINGS.LUCY.transform_beaver.1
msgctxt "STRINGS.LUCY.transform_beaver.1"
msgid "Oh no!"
msgstr "¡Ay, no!"

#. STRINGS.LUCY.transform_beaver.2
msgctxt "STRINGS.LUCY.transform_beaver.2"
msgid "You have to fight it!"
msgstr "¡Tienes que pelear!"

#. STRINGS.LUCY.transform_beaver.3
msgctxt "STRINGS.LUCY.transform_beaver.3"
msgid "No! Fight it!"
msgstr "¡No! ¡Pelea!"

#. STRINGS.LUCY.transform_beaver.4
msgctxt "STRINGS.LUCY.transform_beaver.4"
msgid "You've gotta resist!"
msgstr "¡Tienes que resistir!"

#. STRINGS.LUCY.transform_beaver.5
msgctxt "STRINGS.LUCY.transform_beaver.5"
msgid "It happened again!"
msgstr "¡Sucedió de vuelta!"

#. STRINGS.LUCY.transform_beaver.6
msgctxt "STRINGS.LUCY.transform_beaver.6"
msgid "The curse!"
msgstr "¡La maldición!"

#. STRINGS.LUCY.transform_beaver.7
msgctxt "STRINGS.LUCY.transform_beaver.7"
msgid "Not again!"
msgstr "¡No de nuevo!"

#. STRINGS.LUCY.transform_beaver.8
msgctxt "STRINGS.LUCY.transform_beaver.8"
msgid "You don't have to do this!"
msgstr "¡No tienes que hacer esto!"

#. STRINGS.LUCY.transform_beaver.9
msgctxt "STRINGS.LUCY.transform_beaver.9"
msgid "I warned you!"
msgstr "¡Te lo advertí!"

#. STRINGS.LUCY.transform_woodie.1
msgctxt "STRINGS.LUCY.transform_woodie.1"
msgid "You're back!"
msgstr "¡Volviste!"

#. STRINGS.LUCY.transform_woodie.10
msgctxt "STRINGS.LUCY.transform_woodie.10"
msgid "You look much better."
msgstr "Te ves mucho mejor."

#. STRINGS.LUCY.transform_woodie.11
msgctxt "STRINGS.LUCY.transform_woodie.11"
msgid "Phew! That was scary!"
msgstr "¡Uf! ¡Qué miedo!"

#. STRINGS.LUCY.transform_woodie.12
msgctxt "STRINGS.LUCY.transform_woodie.12"
msgid "I'm glad it's over..."
msgstr "Me alegro de que se haya acabado..."

#. STRINGS.LUCY.transform_woodie.13
msgctxt "STRINGS.LUCY.transform_woodie.13"
msgid "Let's not do that again."
msgstr "No hagamos otra vez eso."

#. STRINGS.LUCY.transform_woodie.14
msgctxt "STRINGS.LUCY.transform_woodie.14"
msgid "Remember your breathing exercises!"
msgstr "¡Recuerda tus ejercicios de respiración!"

#. STRINGS.LUCY.transform_woodie.15
msgctxt "STRINGS.LUCY.transform_woodie.15"
msgid "Everything is going to be fine. Just focus!"
msgstr "Todo irá bien. ¡Solo concéntrate!"

#. STRINGS.LUCY.transform_woodie.2
msgctxt "STRINGS.LUCY.transform_woodie.2"
msgid "Are you okay?"
msgstr "¿Estás bien?"

#. STRINGS.LUCY.transform_woodie.3
msgctxt "STRINGS.LUCY.transform_woodie.3"
msgid "That was a rough one, huh?"
msgstr "Eso ha estado mal, ¿eh?"

#. STRINGS.LUCY.transform_woodie.4
msgctxt "STRINGS.LUCY.transform_woodie.4"
msgid "Don't let that happen again!"
msgstr "¡No dejes que vuelva a suceder!"

#. STRINGS.LUCY.transform_woodie.5
msgctxt "STRINGS.LUCY.transform_woodie.5"
msgid "You scared me!"
msgstr "¡Me asustaste!"

#. STRINGS.LUCY.transform_woodie.6
msgctxt "STRINGS.LUCY.transform_woodie.6"
msgid "I think that creepy girl is mad at you."
msgstr "Creo que esa chica rara está enfadada contigo."

#. STRINGS.LUCY.transform_woodie.7
msgctxt "STRINGS.LUCY.transform_woodie.7"
msgid "I'm so glad you're alright!"
msgstr "¡Me alegro de que estés bien!"

#. STRINGS.LUCY.transform_woodie.8
msgctxt "STRINGS.LUCY.transform_woodie.8"
msgid "Whew! Still in one piece?"
msgstr "¡Uf! ¿Todavía de una pieza?"

#. STRINGS.LUCY.transform_woodie.9
msgctxt "STRINGS.LUCY.transform_woodie.9"
msgid "It's good to have you back, buddy."
msgstr "Es bueno tenerte de vuelta, amigo."

#. STRINGS.MAPRECORDER.LOCATION.CAVE
msgctxt "STRINGS.MAPRECORDER.LOCATION.CAVE"
msgid " in the caves"
msgstr " en las cuevas"

#. STRINGS.MAPRECORDER.LOCATION.DEFAULT
msgctxt "STRINGS.MAPRECORDER.LOCATION.DEFAULT"
msgid ""
msgstr ""

#. STRINGS.MAPRECORDER.MAPDESC
msgctxt "STRINGS.MAPRECORDER.MAPDESC"
msgid "Mapped{location} by {author} on day {day}."
msgstr "Mapeado en{location} por {author} el {day}."

#. STRINGS.MAPRECORDER.UNKNOWN_AUTHOR
msgctxt "STRINGS.MAPRECORDER.UNKNOWN_AUTHOR"
msgid "an explorer"
msgstr "un explorador"

#. STRINGS.MAPRECORDER.UNKNOWN_DAY
msgctxt "STRINGS.MAPRECORDER.UNKNOWN_DAY"
msgid "???"
msgstr "¿¿¿???"

#. STRINGS.MAXWELL_ADVENTUREINTROS.LEVEL_1.ONE
msgctxt "STRINGS.MAXWELL_ADVENTUREINTROS.LEVEL_1.ONE"
msgid "Oh, you found my portal did you?"
msgstr "Oh, encontraste mi portal, ¿eh?"

#. STRINGS.MAXWELL_ADVENTUREINTROS.LEVEL_1.THREE
msgctxt "STRINGS.MAXWELL_ADVENTUREINTROS.LEVEL_1.THREE"
msgid "Hmm. Let's try something a little more challenging, shall we?"
msgstr "Mmm. Probemos algo un poco más desafiante, ¿sí?"

#. STRINGS.MAXWELL_ADVENTUREINTROS.LEVEL_1.TWO
msgctxt "STRINGS.MAXWELL_ADVENTUREINTROS.LEVEL_1.TWO"
msgid "You'd think you would have learned your lesson by now."
msgstr "Ya deberías haber aprendido la lección."

#. STRINGS.MAXWELL_ADVENTUREINTROS.LEVEL_2.ONE
msgctxt "STRINGS.MAXWELL_ADVENTUREINTROS.LEVEL_2.ONE"
msgid "Well would you look at that, you survived."
msgstr "Vaya, sobreviviste."

#. STRINGS.MAXWELL_ADVENTUREINTROS.LEVEL_2.TWO
msgctxt "STRINGS.MAXWELL_ADVENTUREINTROS.LEVEL_2.TWO"
msgid "One down, four to go!"
msgstr "¡Uno menos, quedan cuatro!"

#. STRINGS.MAXWELL_ADVENTUREINTROS.LEVEL_3.ONE
msgctxt "STRINGS.MAXWELL_ADVENTUREINTROS.LEVEL_3.ONE"
msgid "What? You're still here?"
msgstr "¿Qué? ¿Todavía sigues aquí?"

#. STRINGS.MAXWELL_ADVENTUREINTROS.LEVEL_3.TWO
msgctxt "STRINGS.MAXWELL_ADVENTUREINTROS.LEVEL_3.TWO"
msgid "Impressive. But you should probably stop while you're ahead."
msgstr "Impresionante. Pero probablemente deberías detenerte mientras estés a tiempo."

#. STRINGS.MAXWELL_ADVENTUREINTROS.LEVEL_4.ONE
msgctxt "STRINGS.MAXWELL_ADVENTUREINTROS.LEVEL_4.ONE"
msgid "Say, pal."
msgstr "Habla, amigo."

#. STRINGS.MAXWELL_ADVENTUREINTROS.LEVEL_4.THREE
msgctxt "STRINGS.MAXWELL_ADVENTUREINTROS.LEVEL_4.THREE"
msgid "Turn back now, or I may have to resort to drastic measures."
msgstr "Lárgate o puede que tenga que tomar medidas drásticas."

#. STRINGS.MAXWELL_ADVENTUREINTROS.LEVEL_4.TWO
msgctxt "STRINGS.MAXWELL_ADVENTUREINTROS.LEVEL_4.TWO"
msgid "You're really pushing your luck."
msgstr "Estás tentando tu suerte."

#. STRINGS.MAXWELL_ADVENTUREINTROS.LEVEL_5.ONE
msgctxt "STRINGS.MAXWELL_ADVENTUREINTROS.LEVEL_5.ONE"
msgid "You insolent, pitiful, insignificant ant!"
msgstr "¡Hormiga insolente, lastimera e insignificante!"

#. STRINGS.MAXWELL_ADVENTUREINTROS.LEVEL_5.THREE
msgctxt "STRINGS.MAXWELL_ADVENTUREINTROS.LEVEL_5.THREE"
msgid "You will regret coming any further..."
msgstr "Lamentarás haber llegado tan lejos..."

#. STRINGS.MAXWELL_ADVENTUREINTROS.LEVEL_5.TWO
msgctxt "STRINGS.MAXWELL_ADVENTUREINTROS.LEVEL_5.TWO"
msgid "Do not arouse the wrath of the Great Maxwell!"
msgstr "¡No despiertes la ira del Gran Maxwell!"

#. STRINGS.MAXWELL_ADVENTUREINTROS.LEVEL_6.COMBATFAIL.1
msgctxt "STRINGS.MAXWELL_ADVENTUREINTROS.LEVEL_6.COMBATFAIL.1"
msgid "Where would be the sport in that?"
msgstr "¿Qué sacamos a cambio?"

#. STRINGS.MAXWELL_ADVENTUREINTROS.LEVEL_6.COMBATFAIL.2
msgctxt "STRINGS.MAXWELL_ADVENTUREINTROS.LEVEL_6.COMBATFAIL.2"
msgid "Who do you think allowed you to make that?"
msgstr "¿Quién te crees que te ha permitido hacer eso?"

#. STRINGS.MAXWELL_ADVENTUREINTROS.LEVEL_6.CONVERSATION.1
msgctxt "STRINGS.MAXWELL_ADVENTUREINTROS.LEVEL_6.CONVERSATION.1"
msgid "Is this what you were expecting?"
msgstr "¿Es esto lo que esperabas?"

#. STRINGS.MAXWELL_ADVENTUREINTROS.LEVEL_6.CONVERSATION.10
msgctxt "STRINGS.MAXWELL_ADVENTUREINTROS.LEVEL_6.CONVERSATION.10"
msgid "Just dust. And the void. And Them."
msgstr "Solo polvo. Y el vacío. Y ellos."

#. STRINGS.MAXWELL_ADVENTUREINTROS.LEVEL_6.CONVERSATION.11
msgctxt "STRINGS.MAXWELL_ADVENTUREINTROS.LEVEL_6.CONVERSATION.11"
msgid "I've learned so much since then. I've built so much."
msgstr "Aprendí tanto desde entonces. Construí mucho."

#. STRINGS.MAXWELL_ADVENTUREINTROS.LEVEL_6.CONVERSATION.12
msgctxt "STRINGS.MAXWELL_ADVENTUREINTROS.LEVEL_6.CONVERSATION.12"
msgid "But even a King is bound to the board."
msgstr "Pero incluso un rey juega la partida."

#. STRINGS.MAXWELL_ADVENTUREINTROS.LEVEL_6.CONVERSATION.13
msgctxt "STRINGS.MAXWELL_ADVENTUREINTROS.LEVEL_6.CONVERSATION.13"
msgid "You can't change the rules of the game."
msgstr "No puedes cambiar las reglas del juego."

#. STRINGS.MAXWELL_ADVENTUREINTROS.LEVEL_6.CONVERSATION.14
msgctxt "STRINGS.MAXWELL_ADVENTUREINTROS.LEVEL_6.CONVERSATION.14"
msgid "I don't know what they want. They... they just watch."
msgstr "No sé lo que quieren. Solo... solo observan."

#. STRINGS.MAXWELL_ADVENTUREINTROS.LEVEL_6.CONVERSATION.15
msgctxt "STRINGS.MAXWELL_ADVENTUREINTROS.LEVEL_6.CONVERSATION.15"
msgid "Unless you get too close. Then..."
msgstr "A menos que te acerques demasiado. Entonces..."

#. STRINGS.MAXWELL_ADVENTUREINTROS.LEVEL_6.CONVERSATION.16
msgctxt "STRINGS.MAXWELL_ADVENTUREINTROS.LEVEL_6.CONVERSATION.16"
msgid "Well, there's a reason I stay so dapper."
msgstr "Bueno, hay una razón por la que sigo siendo tan pulcro."

#. STRINGS.MAXWELL_ADVENTUREINTROS.LEVEL_6.CONVERSATION.17
msgctxt "STRINGS.MAXWELL_ADVENTUREINTROS.LEVEL_6.CONVERSATION.17"
msgid "What year is it out there? Time moves differently here."
msgstr "¿Qué año es ahí fuera? El tiempo avanza de forma diferente aquí."

#. STRINGS.MAXWELL_ADVENTUREINTROS.LEVEL_6.CONVERSATION.18
msgctxt "STRINGS.MAXWELL_ADVENTUREINTROS.LEVEL_6.CONVERSATION.18"
msgid "Go on, stay a while. Keep us company."
msgstr "Vamos, quédate un rato. Haznos compañía."

#. STRINGS.MAXWELL_ADVENTUREINTROS.LEVEL_6.CONVERSATION.19
msgctxt "STRINGS.MAXWELL_ADVENTUREINTROS.LEVEL_6.CONVERSATION.19"
msgid "Or put the key in the box. It's your decision."
msgstr "O mete la llave en la caja. Es decisión tuya."

#. STRINGS.MAXWELL_ADVENTUREINTROS.LEVEL_6.CONVERSATION.2
msgctxt "STRINGS.MAXWELL_ADVENTUREINTROS.LEVEL_6.CONVERSATION.2"
msgid "Forgive me if I don't get up."
msgstr "Perdóname si no me levanto."

#. STRINGS.MAXWELL_ADVENTUREINTROS.LEVEL_6.CONVERSATION.20
msgctxt "STRINGS.MAXWELL_ADVENTUREINTROS.LEVEL_6.CONVERSATION.20"
msgid "Either way, you're just delaying the inevitable."
msgstr "Sea como fuere, estás retrasando lo inevitable."

#. STRINGS.MAXWELL_ADVENTUREINTROS.LEVEL_6.CONVERSATION.21
msgctxt "STRINGS.MAXWELL_ADVENTUREINTROS.LEVEL_6.CONVERSATION.21"
msgid "Reality is like that, sometimes."
msgstr "La realidad es así, a veces."

#. STRINGS.MAXWELL_ADVENTUREINTROS.LEVEL_6.CONVERSATION.22
msgctxt "STRINGS.MAXWELL_ADVENTUREINTROS.LEVEL_6.CONVERSATION.22"
msgid "I think I've said enough."
msgstr "Creo que ya dije demasiado."

#. STRINGS.MAXWELL_ADVENTUREINTROS.LEVEL_6.CONVERSATION.23
msgctxt "STRINGS.MAXWELL_ADVENTUREINTROS.LEVEL_6.CONVERSATION.23"
msgid "..."
msgstr "..."

#. STRINGS.MAXWELL_ADVENTUREINTROS.LEVEL_6.CONVERSATION.3
msgctxt "STRINGS.MAXWELL_ADVENTUREINTROS.LEVEL_6.CONVERSATION.3"
msgid "You've been an interesting plaything, but I've grown tired of this game."
msgstr "Has sido un juguete interesante, pero ya me cansé de este juego."

#. STRINGS.MAXWELL_ADVENTUREINTROS.LEVEL_6.CONVERSATION.4
msgctxt "STRINGS.MAXWELL_ADVENTUREINTROS.LEVEL_6.CONVERSATION.4"
msgid "Or maybe They've grown tired of me."
msgstr "O quizá se han cansado de mí."

#. STRINGS.MAXWELL_ADVENTUREINTROS.LEVEL_6.CONVERSATION.5
msgctxt "STRINGS.MAXWELL_ADVENTUREINTROS.LEVEL_6.CONVERSATION.5"
msgid "Heh. Took them long enough."
msgstr "Je. Tardaron bastante tiempo."

#. STRINGS.MAXWELL_ADVENTUREINTROS.LEVEL_6.CONVERSATION.6
msgctxt "STRINGS.MAXWELL_ADVENTUREINTROS.LEVEL_6.CONVERSATION.6"
msgid "They'll show you terrible, beautiful things."
msgstr "Te mostrarán cosas horribles y hermosas."

#. STRINGS.MAXWELL_ADVENTUREINTROS.LEVEL_6.CONVERSATION.7
msgctxt "STRINGS.MAXWELL_ADVENTUREINTROS.LEVEL_6.CONVERSATION.7"
msgid "It will change you, like it did me."
msgstr "Te cambiará, como hizo conmigo."

#. STRINGS.MAXWELL_ADVENTUREINTROS.LEVEL_6.CONVERSATION.8
msgctxt "STRINGS.MAXWELL_ADVENTUREINTROS.LEVEL_6.CONVERSATION.8"
msgid "It's best not to fight it."
msgstr "Es mejor no resistirse."

#. STRINGS.MAXWELL_ADVENTUREINTROS.LEVEL_6.CONVERSATION.9
msgctxt "STRINGS.MAXWELL_ADVENTUREINTROS.LEVEL_6.CONVERSATION.9"
msgid "There wasn't much here when I showed up."
msgstr "No había mucho por aquí cuando llegué."

#. STRINGS.MAXWELL_ADVENTUREINTROS.LEVEL_6.ONE
msgctxt "STRINGS.MAXWELL_ADVENTUREINTROS.LEVEL_6.ONE"
msgid "Well, this is it."
msgstr "Bien, ya está."

#. STRINGS.MAXWELL_ADVENTUREINTROS.LEVEL_6.TELEPORTFAIL
msgctxt "STRINGS.MAXWELL_ADVENTUREINTROS.LEVEL_6.TELEPORTFAIL"
msgid "Don't you think I've tried that?"
msgstr "¿No crees que ya he intentado eso?"

#. STRINGS.MAXWELL_ADVENTUREINTROS.LEVEL_6.TELEPORTFAIL2
msgctxt "STRINGS.MAXWELL_ADVENTUREINTROS.LEVEL_6.TELEPORTFAIL2"
msgid "This is the end of the line. We have no escape."
msgstr "Este es el final del camino. No tenemos escapatoria."

#. STRINGS.MAXWELL_ADVENTUREINTROS.LEVEL_6.TWO
msgctxt "STRINGS.MAXWELL_ADVENTUREINTROS.LEVEL_6.TWO"
msgid "You found me. Now, what are you going to do?"
msgstr "Me encontraste. ¿Qué vas a hacer ahora?"

#. STRINGS.MAXWELL_ADVENTUREINTROS.TWOLANDS.FOUR
msgctxt "STRINGS.MAXWELL_ADVENTUREINTROS.TWOLANDS.FOUR"
msgid "All I want in return is a truce."
msgstr "Lo único que quiero a cambio es un trato."

#. STRINGS.MAXWELL_ADVENTUREINTROS.TWOLANDS.ONE
msgctxt "STRINGS.MAXWELL_ADVENTUREINTROS.TWOLANDS.ONE"
msgid "Say, pal."
msgstr "Habla, amigo."

#. STRINGS.MAXWELL_ADVENTUREINTROS.TWOLANDS.THREE
msgctxt "STRINGS.MAXWELL_ADVENTUREINTROS.TWOLANDS.THREE"
msgid "I'll give you food, gold, pigs, whatever you need."
msgstr "Te daré comida, oro, cerdos, lo que necesites."

#. STRINGS.MAXWELL_ADVENTUREINTROS.TWOLANDS.TWO
msgctxt "STRINGS.MAXWELL_ADVENTUREINTROS.TWOLANDS.TWO"
msgid "Let's make a deal. You can stay here. Settle down, even."
msgstr "Hagamos un trato. Te puedes quedar aquí. Instalarte y todo."

#. STRINGS.MAXWELL_ADVENTURETHRONE.LEVEL_6.HIT.ONE
msgctxt "STRINGS.MAXWELL_ADVENTURETHRONE.LEVEL_6.HIT.ONE"
msgid "The throne won't allow that. I've tried."
msgstr "El trono no permitirá eso. Lo he intentado."

#. STRINGS.MAXWELL_ADVENTURETHRONE.LEVEL_6.INTRO.ONE
msgctxt "STRINGS.MAXWELL_ADVENTURETHRONE.LEVEL_6.INTRO.ONE"
msgid "Is this how it ends?"
msgstr "¿Es así como termina esto?"

#. STRINGS.MAXWELL_ADVENTURETHRONE.LEVEL_6.NOUNLOCK.ONE
msgctxt "STRINGS.MAXWELL_ADVENTURETHRONE.LEVEL_6.NOUNLOCK.ONE"
msgid "Ah, I am a fool. I had dared to hope."
msgstr "Ah, soy un idiota. Tenía esperanzas."

#. STRINGS.MAXWELL_ADVENTURETHRONE.LEVEL_6.PHONOGRAPHOFF.ONE
msgctxt "STRINGS.MAXWELL_ADVENTURETHRONE.LEVEL_6.PHONOGRAPHOFF.ONE"
msgid "Thank you. I have been listening to that song for an eternity."
msgstr "Gracias. Llevo escuchando esa canción una eternidad."

#. STRINGS.MAXWELL_ADVENTURETHRONE.LEVEL_6.PHONOGRAPHON.ONE
msgctxt "STRINGS.MAXWELL_ADVENTURETHRONE.LEVEL_6.PHONOGRAPHON.ONE"
msgid "I guess I deserve that."
msgstr "Supongo que me lo merezco."

#. STRINGS.MAXWELL_ADVENTURE_HEAD.LEVEL_4.ONE
msgctxt "STRINGS.MAXWELL_ADVENTURE_HEAD.LEVEL_4.ONE"
msgid "Fine. Just remember that you chose this."
msgstr "Bien. Solo recuerda que tú elegiste esto."

#. STRINGS.MAXWELL_ADVENTURE_HEAD.LEVEL_6.FOUR.ONE
msgctxt "STRINGS.MAXWELL_ADVENTURE_HEAD.LEVEL_6.FOUR.ONE"
msgid "It's just that..."
msgstr "Es solo que..."

#. STRINGS.MAXWELL_ADVENTURE_HEAD.LEVEL_6.FOUR.TWO
msgctxt "STRINGS.MAXWELL_ADVENTURE_HEAD.LEVEL_6.FOUR.TWO"
msgid "I've become accustomed to winning."
msgstr "Me acostumbré a ganar."

#. STRINGS.MAXWELL_ADVENTURE_HEAD.LEVEL_6.ONE
msgctxt "STRINGS.MAXWELL_ADVENTURE_HEAD.LEVEL_6.ONE"
msgid "We're not so different, you and I."
msgstr "Tú y yo no somos tan diferentes."

#. STRINGS.MAXWELL_ADVENTURE_HEAD.LEVEL_6.THREE.ONE
msgctxt "STRINGS.MAXWELL_ADVENTURE_HEAD.LEVEL_6.THREE.ONE"
msgid "Oh, did you think you were the first?"
msgstr "Ah, ¿creías que tú llegarías primero?"

#. STRINGS.MAXWELL_ADVENTURE_HEAD.LEVEL_6.THREE.TWO
msgctxt "STRINGS.MAXWELL_ADVENTURE_HEAD.LEVEL_6.THREE.TWO"
msgid "HA!"
msgstr "¡JA!"

#. STRINGS.MAXWELL_ADVENTURE_HEAD.LEVEL_6.TWO.ONE
msgctxt "STRINGS.MAXWELL_ADVENTURE_HEAD.LEVEL_6.TWO.ONE"
msgid "That's why I brought you here."
msgstr "Por eso te traje aquí."

#. STRINGS.MAXWELL_ADVENTURE_HEAD.LEVEL_6.TWO.TWO
msgctxt "STRINGS.MAXWELL_ADVENTURE_HEAD.LEVEL_6.TWO.TWO"
msgid "That's why I brought all of them here."
msgstr "Por eso los traje a todos aquí."

#. STRINGS.MAXWELL_SANDBOXINTROS.ONE
msgctxt "STRINGS.MAXWELL_SANDBOXINTROS.ONE"
msgid "Say pal, you don't look so good."
msgstr "Camarada, no tienes muy buena pinta."

#. STRINGS.MAXWELL_SANDBOXINTROS.TWO
msgctxt "STRINGS.MAXWELL_SANDBOXINTROS.TWO"
msgid "You'd better find something to eat before night comes!"
msgstr "¡Será mejor que encuentres algo de comer antes de que caiga la noche!"

#. STRINGS.MERM1_TALK_GREETING.1
msgctxt "STRINGS.MERM1_TALK_GREETING.1"
msgid "Thoughts don't come to me like they used to."
msgstr "Mis pensamientos no vienen a la cabeza como solían."

#. STRINGS.MERM1_TALK_GREETING.2
msgctxt "STRINGS.MERM1_TALK_GREETING.2"
msgid "Who's Mumsy again? Ah, right. Nice lady."
msgstr "¿Quién es mami? Ah, bueno. Una buena mujer."

#. STRINGS.MERM1_TALK_GREETING.3
msgctxt "STRINGS.MERM1_TALK_GREETING.3"
msgid "Been havin' odd cravings for fish lately. Hmf."
msgstr "Últimamente tengo un antojo extraño de pescado. Mmm."

#. STRINGS.MERM1_TALK_GREETING.4
msgctxt "STRINGS.MERM1_TALK_GREETING.4"
msgid "Pip's too uptight. Always worryin' about me."
msgstr "La gente es demasiado tensa. Siempre preocupándose por mí."

#. STRINGS.MERM1_TALK_GREETING.5
msgctxt "STRINGS.MERM1_TALK_GREETING.5"
msgid "Hey, trade with ol'Sammy!"
msgstr "¡Eh, comercia con el viejo Sammy!"

#. STRINGS.MERM1_TALK_GREETING.6
msgctxt "STRINGS.MERM1_TALK_GREETING.6"
msgid "SEEDS! SEEDS HERE!"
msgstr "¡SEMILLAS! ¡SEMILLAS AQUÍ!"

#. STRINGS.MERM1_TALK_GREETING.7
msgctxt "STRINGS.MERM1_TALK_GREETING.7"
msgid "What was I doing? ...Oh, SEEDS HERE!"
msgstr "¿Qué estaba haciendo...? ¡OH, HAY SEMILLAS AQUÍ!"

#. STRINGS.MERM1_TALK_TRADE.1
msgctxt "STRINGS.MERM1_TALK_TRADE.1"
msgid "Alright, alright, get a move on."
msgstr "Bien, bien, muévete."

#. STRINGS.MERM1_TALK_TRADE.2
msgctxt "STRINGS.MERM1_TALK_TRADE.2"
msgid "'Pleasure."
msgstr "Un placer."

#. STRINGS.MERM1_TALK_TRADE.3
msgctxt "STRINGS.MERM1_TALK_TRADE.3"
msgid "Always in a rush, you lot."
msgstr "Siempre están con prisa."

#. STRINGS.MERM1_TALK_TRADE.4
msgctxt "STRINGS.MERM1_TALK_TRADE.4"
msgid "The plague ain't so bad, y'know."
msgstr "La plaga no es tan mala, ya sabes."

#. STRINGS.MERM1_TALK_TRADE.5
msgctxt "STRINGS.MERM1_TALK_TRADE.5"
msgid "Come back now, y'hear?"
msgstr "¿Regresa, oíste?"

#. STRINGS.MERM1_TALK_TRADE.6
msgctxt "STRINGS.MERM1_TALK_TRADE.6"
msgid "Who're you again?"
msgstr "¿Quién eras tú otra vez?"

#. STRINGS.MERM1_TALK_TRADE.7
msgctxt "STRINGS.MERM1_TALK_TRADE.7"
msgid "Thanks, stranger."
msgstr "Gracias, forastero."

#. STRINGS.MERM2_TALK_GREETING.1
msgctxt "STRINGS.MERM2_TALK_GREETING.1"
msgid "Good afternoon! Care to trade?"
msgstr "¡Buenas tardes! ¿Quieres comerciar?"

#. STRINGS.MERM2_TALK_GREETING.2
msgctxt "STRINGS.MERM2_TALK_GREETING.2"
msgid "At least the sickness didn't take my moustache. Ho ho!"
msgstr "Al menos la enfermedad no me quitó el bigote. ¡Jo, jo!"

#. STRINGS.MERM2_TALK_GREETING.3
msgctxt "STRINGS.MERM2_TALK_GREETING.3"
msgid "Sammy's faculties are slipping, but you didn't hear it from me."
msgstr "Las facultades de Sammy están decayendo, pero yo no te he dicho nada."

#. STRINGS.MERM2_TALK_GREETING.4
msgctxt "STRINGS.MERM2_TALK_GREETING.4"
msgid "Many of our sick disappeared into the sea. Odd, that."
msgstr "Muchos de nuestros enfermos desaparecieron en el mar. Qué raro."

#. STRINGS.MERM2_TALK_GREETING.5
msgctxt "STRINGS.MERM2_TALK_GREETING.5"
msgid "Shame you couldn't see the town in its glory days."
msgstr "Una pena que no puedas ver la ciudad en sus días de gloria."

#. STRINGS.MERM2_TALK_GREETING.6
msgctxt "STRINGS.MERM2_TALK_GREETING.6"
msgid "I've only the finest goods for sale."
msgstr "Solo tengo los mejores artículos a la venta."

#. STRINGS.MERM2_TALK_GREETING.7
msgctxt "STRINGS.MERM2_TALK_GREETING.7"
msgid "This is a dreadful place for a kid to grow up in."
msgstr "Este es un lugar horrible para que un niño crezca."

#. STRINGS.MERM2_TALK_TRADE.1
msgctxt "STRINGS.MERM2_TALK_TRADE.1"
msgid "In a hurry, then?"
msgstr "¿Tienes prisa entonces?"

#. STRINGS.MERM2_TALK_TRADE.2
msgctxt "STRINGS.MERM2_TALK_TRADE.2"
msgid "Don't tarry now, friend."
msgstr "No tardes ahora."

#. STRINGS.MERM2_TALK_TRADE.3
msgctxt "STRINGS.MERM2_TALK_TRADE.3"
msgid "I'll not waste anymore of your time."
msgstr "No te haré perder más el tiempo."

#. STRINGS.MERM2_TALK_TRADE.4
msgctxt "STRINGS.MERM2_TALK_TRADE.4"
msgid "I tip my hat to you."
msgstr "Me quito el sombrero."

#. STRINGS.MERM2_TALK_TRADE.5
msgctxt "STRINGS.MERM2_TALK_TRADE.5"
msgid "It's been a pleasure."
msgstr "Ha sido un placer."

#. STRINGS.MERM2_TALK_TRADE.6
msgctxt "STRINGS.MERM2_TALK_TRADE.6"
msgid "Gnaw smile on you."
msgstr "Las Fauces te sonríen."

