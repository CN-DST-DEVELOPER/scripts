msgstr "No me gusta el nuevo estilo."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.MUTATED_PENGUIN.DEAD
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.MUTATED_PENGUIN.DEAD"
