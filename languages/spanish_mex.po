msgstr "La cocinaron demasiado."

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.YOTC_CARRAT_SCALE.CARRAT
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.YOTC_CARRAT_SCALE.CARRAT"
