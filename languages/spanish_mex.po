msgid "Hyuyu!"
msgstr "¡Jiu, ju!"

#. STRINGS.CHARACTERS.WORTOX.ACTIONFAIL.USEKLAUSSACKKEY.QUAGMIRE_WRONGKEY
msgctxt "STRINGS.CHARACTERS.WORTOX.ACTIONFAIL.USEKLAUSSACKKEY.QUAGMIRE_WRONGKEY"
msgid "I believe there is another way."
msgstr "Creo que hay otra forma."

#. STRINGS.CHARACTERS.WORTOX.ACTIONFAIL.USEKLAUSSACKKEY.WRONGKEY
msgctxt "STRINGS.CHARACTERS.WORTOX.ACTIONFAIL.USEKLAUSSACKKEY.WRONGKEY"
msgid "Either the key is wrong, or the lock is."
msgstr "O la llave es incorrecta o la cerradura."

#. STRINGS.CHARACTERS.WORTOX.ACTIONFAIL.WRAPBUNDLE.EMPTY
msgctxt "STRINGS.CHARACTERS.WORTOX.ACTIONFAIL.WRAPBUNDLE.EMPTY"
msgid "I need something to bind within."
msgstr "Necesito algo para atar."

#. STRINGS.CHARACTERS.WORTOX.ACTIONFAIL.WRITE.GENERIC
msgctxt "STRINGS.CHARACTERS.WORTOX.ACTIONFAIL.WRITE.GENERIC"
msgid "What is written cannot be unwrote!"
msgstr "No se puede borrar lo que está escrito."

#. STRINGS.CHARACTERS.WORTOX.ACTIONFAIL.WRITE.INUSE
msgctxt "STRINGS.CHARACTERS.WORTOX.ACTIONFAIL.WRITE.INUSE"
msgid "Someone else has command of it."
msgstr "Alguien más lo controla."

#. STRINGS.CHARACTERS.WORTOX.ACTIONFAIL.YOTB_STARTCONTEST.ALREADYACTIVE
msgctxt "STRINGS.CHARACTERS.WORTOX.ACTIONFAIL.YOTB_STARTCONTEST.ALREADYACTIVE"
msgid "Perhaps he too likes to travel between planes? Hyuyuyu!"
msgstr "¿Quizá a él también le gusta viajar de un plano a otro? ¡Jiu, ju, ju!"

#. STRINGS.CHARACTERS.WORTOX.ACTIONFAIL.YOTB_STARTCONTEST.DOESNTWORK
msgctxt "STRINGS.CHARACTERS.WORTOX.ACTIONFAIL.YOTB_STARTCONTEST.DOESNTWORK"
msgid "Oh ho! Something's gone awry!"
msgstr "¡Oh, jo! Algo salió mal."

#. STRINGS.CHARACTERS.WORTOX.ACTIONFAIL.YOTB_UNLOCKSKIN.ALREADYKNOWN
msgctxt "STRINGS.CHARACTERS.WORTOX.ACTIONFAIL.YOTB_UNLOCKSKIN.ALREADYKNOWN"
msgid "Oh what a bore, I've seen it before."
msgstr "Qué aburrición. Ya lo he visto en otra ocasión."

#. STRINGS.CHARACTERS.WORTOX.ACTIONFAIL_GENERIC
msgctxt "STRINGS.CHARACTERS.WORTOX.ACTIONFAIL_GENERIC"
msgid "No, no, no."
msgstr "No, no, no."

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_ABIGAIL_HIDING
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_ABIGAIL_HIDING"
msgid "only_used_by_wendy"
msgstr "only_used_by_wendy"

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_ACCOMPLISHMENT
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_ACCOMPLISHMENT"
msgid "I feel excellent about myself!"
msgstr "¡Me siento excelente conmigo mismo!"

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_ACCOMPLISHMENT_DONE
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_ACCOMPLISHMENT_DONE"
msgid "I've done the thing!"
msgstr "¡Hice eso!"

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_ACIDBATS
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_ACIDBATS"
msgid "That sounds like bats."
msgstr "Suena a murciélagos."

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_ADVENTUREFAIL
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_ADVENTUREFAIL"
msgid "I've had enough plane hopping."
msgstr "Ya me cansé de viajar de un plano a otro."

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_ANTLION_SINKHOLE.1
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_ANTLION_SINKHOLE.1"
msgid "Tremors and trembles!"
msgstr "¡Temblores y tembleques!"

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_ANTLION_SINKHOLE.2
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_ANTLION_SINKHOLE.2"
msgid "Crumbles and cracks!"
msgstr "¡Rajaduras y ranuras!"

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_ANTLION_SINKHOLE.3
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_ANTLION_SINKHOLE.3"
msgid "Seismic shivers, seismic shakes!"
msgstr "¡Sacudones sísmicos, sacudidas sísmicas!"

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_ANTLION_TRIBUTE.1
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_ANTLION_TRIBUTE.1"
msgid "Tidings and tithings to you!"
msgstr "¡Diezmos y detalles para ti!"

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_ANTLION_TRIBUTE.2
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_ANTLION_TRIBUTE.2"
msgid "Chin up!"
msgstr "¡Ánimo!"

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_ANTLION_TRIBUTE.3
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_ANTLION_TRIBUTE.3"
msgid "Gifts all around! Or for you, at least."
msgstr "¡Regalos para todos! O para ti, al menos."

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_ARCHIVE_NEW_KNOWLEDGE
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_ARCHIVE_NEW_KNOWLEDGE"
msgid "Oooh, now there's an interesting idea!"
msgstr "Oooh, ¡qué idea tan interesante!"

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_ARCHIVE_NO_POWER
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_ARCHIVE_NO_POWER"
msgid "What great power could wake it from its slumber?"
msgstr "¿Qué poder pondría empeño para despertarlo de su sueño?"

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_ARCHIVE_OLD_KNOWLEDGE
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_ARCHIVE_OLD_KNOWLEDGE"
msgid "Oh drat, I already knew that."
msgstr "Oh, mala mía. Eso ya lo sabía."

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_ATRIUM_DESTABILIZING.1
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_ATRIUM_DESTABILIZING.1"
msgid "Hyuyuyu, time to go!"
msgstr "¡Jiu, ju, ju! ¡Hora de irse!"

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_ATRIUM_DESTABILIZING.2
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_ATRIUM_DESTABILIZING.2"
msgid "Oh my, something's stirring."
msgstr "Vaya, algo se está moviendo."

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_ATRIUM_DESTABILIZING.3
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_ATRIUM_DESTABILIZING.3"
msgid "Hmm, did you hear something?"
msgstr "Mmm, ¿oyeron algo?"

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_ATTACH_BUFF_ATTACK
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_ATTACH_BUFF_ATTACK"
msgid "Hyuyu, I'm ready to play!"
msgstr "Jiu, ju, ¡estoy listo para jugar!"

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_ATTACH_BUFF_ELECTRICATTACK
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_ATTACH_BUFF_ELECTRICATTACK"
msgid "I'm an electric imp!"
msgstr "¡Soy un diablillo eléctrico!"

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_ATTACH_BUFF_MOISTUREIMMUNITY
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_ATTACH_BUFF_MOISTUREIMMUNITY"
msgid "There will be no wet fur smell for this imp! Hyuyu!"
msgstr "¡Este diablillo no olerá a pelo mojado! ¡Jiu, ju!"

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_ATTACH_BUFF_PLAYERABSORPTION
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_ATTACH_BUFF_PLAYERABSORPTION"
msgid "I feel just great! Must've been something I ate!"
msgstr "¡Que bien me siento, sí! ¡Debe ser algo que comí!"

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_ATTACH_BUFF_SLEEPRESISTANCE
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_ATTACH_BUFF_SLEEPRESISTANCE"
msgid "You won't catch this imp sleeping, hyuyu!"
msgstr "No encontrarán durmiendo a este diablillo, ¡jiu, ju!"

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_ATTACH_BUFF_WORKEFFECTIVENESS
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_ATTACH_BUFF_WORKEFFECTIVENESS"
msgid "That was just the thing to give my step a spring!"
msgstr "¡Necesitaba justo eso para caminar más presto!"

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_BECOMEGHOST
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_BECOMEGHOST"
msgid "ooOooooO!"
msgstr "¡ooOooooO!"

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_BEES
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_BEES"
msgid "Fiddle dee dee, HERE COMES A BEE!"
msgstr "Como dicen las viejas, aquí viene una abeja."

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_BOAT_LEAK
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_BOAT_LEAK"
msgid "Now this ride's getting fun!"
msgstr "¡Este viaje se está poniendo divertido!"

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_BOAT_SINK
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_BOAT_SINK"
msgid "Into the drink I go, hyuyu!"
msgstr "¡A sumergirse, jiu, ju!"

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_BOOMERANG
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_BOOMERANG"
msgid "Hyuyu!"
msgstr "¡Jiu, ju!"

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_BRAVERY_POTION
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_BRAVERY_POTION"
msgid "Okay, let's play!"
msgstr "¡Bueno, juguemos!"

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_BURNT
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_BURNT"
msgid "Too hot for my impish paws!"
msgstr "¡Demasiado caliente para mis zarpas de diablillo!"

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_CALL_BEEF
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_CALL_BEEF"
msgid "Over here, beefalo dear!"
msgstr "¡Por aquí! ¡Bífalo, ven a mí!"

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_CANFIX
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_CANFIX"
msgid "\nI could restore it."
msgstr "\nPodría restaurar eso."

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_CANNOT_BUILD.NO_INGREDIENTS
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_CANNOT_BUILD.NO_INGREDIENTS"
msgid "I seem to be missing a thing or two."
msgstr "Me faltan un par de cosas."

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_CANNOT_BUILD.NO_STATION
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_CANNOT_BUILD.NO_STATION"
msgid "No, no, this just won't do."
msgstr "No, no. Con esto no basta."

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_CANNOT_BUILD.NO_TECH
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_CANNOT_BUILD.NO_TECH"
msgid "Its making is a mystery to me."
msgstr "Desconozco cómo se construye."

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_CANTBUILDHERE_YOTB_POST
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_CANTBUILDHERE_YOTB_POST"
msgid "Alas, I fear I can't build that here."
msgstr "Ay de mí, no puedo construir aquí."

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_CANT_ESCAPE_CURSE
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_CANT_ESCAPE_CURSE"
msgid "Oh dear, I really should have known better."
msgstr "Ay, cielos. Debería haberme dado cuenta."

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_CARRAT_ERROR_FELL_ASLEEP
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_CARRAT_ERROR_FELL_ASLEEP"
msgid "Oh pardon me, does this race bore you?"
msgstr "Disculpa, ¿te aburre esta carrera?"

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_CARRAT_ERROR_STUNNED
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_CARRAT_ERROR_STUNNED"
msgid "Gotten cold feet? And have they frozen to the ground?"
msgstr "¿Te quedaste patitiesa? ¿Y eso te impide correr?"

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_CARRAT_ERROR_WALKING
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_CARRAT_ERROR_WALKING"
msgid "If you don't quicken your pace, we'll lose this race!"
msgstr "¡Si no apuras el paso, la carrera será un fracaso!"

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_CARRAT_ERROR_WRONG_WAY.1
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_CARRAT_ERROR_WRONG_WAY.1"
msgid "Your route seems rather roundabout."
msgstr "Tu recorrido parece algo retorcido."

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_CARRAT_ERROR_WRONG_WAY.2
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_CARRAT_ERROR_WRONG_WAY.2"
msgid "The path to victory is the other way, my friend!"
msgstr "¡El camino a la victoria es por el otro lado, amiga!"

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_CARRAT_START_RACE
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_CARRAT_START_RACE"
msgid "Let the race begin, I'm sure to win!"
msgstr "Que empiece la carrera. ¡Le ganaré a cualquiera!"

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_CAVEIN
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_CAVEIN"
msgid "I'd best hop on out of here!"
msgstr "¡Mejor me largo de aquí!"

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_CHAIR_ON_FIRE
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_CHAIR_ON_FIRE"
msgid "This is fine."
msgstr "Está todo bien."

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_CHARLIE
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_CHARLIE"
msgid "What manner of imp was that??"
msgstr "¿Qué clase de diablillo fue ese?"

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_CHARLIESAVE.1
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_CHARLIESAVE.1"
msgid "only_used_by_winona"
msgstr "only_used_by_winona"

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_CHARLIE_ATTACK
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_CHARLIE_ATTACK"
msgid "OWIE-HEE-HEE!"
msgstr "¡AIA, JI, JI!"

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_COACH.1
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_COACH.1"
msgid "only_used_by_wolfgang"
msgstr "only_used_by_wolfgang"

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_COACH.2
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_COACH.2"
msgid "only_used_by_wolfgang"
msgstr "only_used_by_wolfgang"

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_COACH.3
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_COACH.3"
msgid "only_used_by_wolfgang"
msgstr "only_used_by_wolfgang"

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_COACH.4
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_COACH.4"
msgid "only_used_by_wolfgang"
msgstr "only_used_by_wolfgang"

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_COACH.5
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_COACH.5"
msgid "only_used_by_wolfgang"
msgstr "only_used_by_wolfgang"

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_COACH.6
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_COACH.6"
msgid "only_used_by_wolfgang"
msgstr "only_used_by_wolfgang"

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_COACH.7
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_COACH.7"
msgid "only_used_by_wolfgang"
msgstr "only_used_by_wolfgang"

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_COACH.8
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_COACH.8"
msgid "only_used_by_wolfgang"
msgstr "only_used_by_wolfgang"

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_COACH.9
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_COACH.9"
msgid "only_used_by_wolfgang"
msgstr "only_used_by_wolfgang"

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_COLD
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_COLD"
msgid "It's finally frozen over!"
msgstr "¡Al fin se congeló!"

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_COMPASS_OUT
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_COMPASS_OUT"
msgid "My compass has pass-ed out!"
msgstr "¡Mi brújula perdió el norte!"

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_COZY_SLEEP
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_COZY_SLEEP"
msgid "This imp feels best after a cozy rest."
msgstr "Soy un primor tras un descanso reparador."

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_CRAFTING_FAIL
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_CRAFTING_FAIL"
msgid "My hands are truly cursed."
msgstr "Mis manos están malditas."

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_DAMP
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_DAMP"
msgid "The world is giving me a shower!"
msgstr "¡El mundo me está dando una ducha!"

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_DEERCLOPS
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_DEERCLOPS"
msgid "A massive brute is en route!"
msgstr "¡Una bestia brutal está a por llegar!"

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_DESPAWN
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_DESPAWN"
msgid "Hyuyu, fare thee well!"
msgstr "¡Jiu, ju, que te vaya bien!"

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_DETACH_BUFF_ATTACK
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_DETACH_BUFF_ATTACK"
msgid "It was all just a prank!"
msgstr "¡Era solo una broma!"

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_DETACH_BUFF_ELECTRICATTACK
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_DETACH_BUFF_ELECTRICATTACK"
msgid "I think I gave them quite a shock! Hyuyu!"
msgstr "¡Creo que le di un golpe electrizante! ¡Jiu, ju!"

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_DETACH_BUFF_MOISTUREIMMUNITY
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_DETACH_BUFF_MOISTUREIMMUNITY"
msgid "Alas and alack, the dampness is back."
msgstr "Qué entuerto, la humedad ha vuelto."

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_DETACH_BUFF_PLAYERABSORPTION
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_DETACH_BUFF_PLAYERABSORPTION"
msgid "That was fun, let's do it again!"
msgstr "Fue divertido. ¡Hagámoslo otra vez!"

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_DETACH_BUFF_SLEEPRESISTANCE
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_DETACH_BUFF_SLEEPRESISTANCE"
msgid "Maybe I could do with a wink or two..."
msgstr "Me vendría bien un descansito..."

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_DETACH_BUFF_WORKEFFECTIVENESS
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_DETACH_BUFF_WORKEFFECTIVENESS"
msgid "All work and no play doesn't suit an imp. Hyuyu!"
msgstr "Un diablillo no puede trabajar a sol y sombra. ¡Jiu, ju!"

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_DIG_DISEASE_WARNING
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_DIG_DISEASE_WARNING"
msgid "I've helped it!"
msgstr "¡Lo ayudé!"

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_DUSK
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_DUSK"
msgid "The night soon approaches. Hyuyu!"
msgstr "La noche se acerca. ¡Jiu, ju!"

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_EAT.GENERIC
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_EAT.GENERIC"
msgid "Mmm! Soul free!"
msgstr "¡Mmm! ¡Un alma libre!"

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_EAT.INVALID
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_EAT.INVALID"
msgid "Not even I could eat that."
msgstr "Ni siquiera yo podría comer eso."

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_EAT.PAINFUL
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_EAT.PAINFUL"
msgid "Ouch! Hyuyu!"
msgstr "¡Ay! ¡Jiu, ju!"

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_EAT.SPOILED
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_EAT.SPOILED"
msgid "Blech! At least souls never spoil."
msgstr "¡Puaj! Al menos las almas nunca se pudren."

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_EAT.STALE
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_EAT.STALE"
msgid "How unpleasant!"
msgstr "¡Qué desagradable!"

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_EAT.YUCKY
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_EAT.YUCKY"
msgid "I'd rather eat my own tail!"
msgstr "¡Prefiero comerme mi propia cola!"

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_EATING_NOT_FEASTING
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_EATING_NOT_FEASTING"
msgid "I'm not going to eat it, might as well give it to the mortals."
msgstr "No voy a comer, así que bien podría darles todo a los mortales."

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_ELIXIR_BOOSTED
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_ELIXIR_BOOSTED"
msgid "I feel like a new imp!"
msgstr ""

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_ELIXIR_GHOSTVISION
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_ELIXIR_GHOSTVISION"
msgid "See like the dead, they said."
msgstr ""

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_ELIXIR_PLAYER_SPEED
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_ELIXIR_PLAYER_SPEED"
msgid "I have the strength of ten imps!"
msgstr ""

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_ENCUMBERED.1
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_ENCUMBERED.1"
msgid "Huff... puff..."
msgstr "Ufff... pufff..."

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_ENCUMBERED.2
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_ENCUMBERED.2"
msgid "Hoof..."
msgstr "Juf..."

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_ENCUMBERED.3
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_ENCUMBERED.3"
msgid "What... a terrible burden..."
msgstr "Qué... carga tan terrible..."

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_ENCUMBERED.4
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_ENCUMBERED.4"
msgid "Hyu... yu... yu...."
msgstr "Jiu... ju... ju..."

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_ENCUMBERED.5
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_ENCUMBERED.5"
msgid "Hff!"
msgstr "¡Af!"

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_ENCUMBERED.6
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_ENCUMBERED.6"
msgid "Imps were not... made for this!"
msgstr "¡Los diablillos no están... hechos para esto!"

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_ENCUMBERED.7
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_ENCUMBERED.7"
msgid "Puff... huff..."
msgstr "Pufff... ufff..."

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_ENCUMBERED.8
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_ENCUMBERED.8"
msgid "I cannot... go on!"
msgstr "¡No puedo... seguir!"

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_ENCUMBERED.9
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_ENCUMBERED.9"
msgid "What... a weight... to bear!"
msgstr "¡Cómo... pesa... esto!"

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_ENGINEERING_CAN_DOWNGRADE
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_ENGINEERING_CAN_DOWNGRADE"
msgid "only_used_by_winona"
msgstr "only_used_by_winona"

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_ENGINEERING_CAN_SIDEGRADE
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_ENGINEERING_CAN_SIDEGRADE"
msgid "only_used_by_winona"
msgstr "only_used_by_winona"

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_ENGINEERING_CAN_UPGRADE
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_ENGINEERING_CAN_UPGRADE"
msgid "only_used_by_winona"
msgstr "only_used_by_winona"

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_ENTER_DARK
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_ENTER_DARK"
msgid "I've been banished to the darkness plane!"
msgstr "¡Me desterraron al plano de la oscuridad!"

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_ENTER_LIGHT
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_ENTER_LIGHT"
msgid "I return to this plane of existence!"
msgstr "¡Regreso a este plano existencial!"

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_EXIT_GELBLOB
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_EXIT_GELBLOB"
msgid "I could've died inside!"
msgstr "¡Podría haber muerto dentro!"

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_EXLIIR_TOO_SUPER
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_EXLIIR_TOO_SUPER"
msgid "Don't think I can take that drink!"
msgstr ""

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_EYEOFTERROR_ARRIVE
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_EYEOFTERROR_ARRIVE"
msgid "I don't suppose this is a friendly visit? Hyuyu..."
msgstr "No creo que sea una visita social... Jiu, ju."

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_EYEOFTERROR_FLYAWAY
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_EYEOFTERROR_FLYAWAY"
msgid "The light of day keeps the eye at bay!"
msgstr "¡Ante la luz día, el ojo huye con cobardía!"

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_EYEOFTERROR_FLYBACK
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_EYEOFTERROR_FLYBACK"
msgid "Hyuyu, back for more fun?"
msgstr "Jiu, ju. ¿Quieres más?"

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_FAN_OUT
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_FAN_OUT"
msgid "I've lost a fan!"
msgstr "¡Se quedó sin aire!"

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_FERTILIZER_RESEARCHED
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_FERTILIZER_RESEARCHED"
msgid "I'm getting the scoop on this gardening goop."
msgstr "Le pongo mucho esmero a este pegote jardinero."

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_FIRENETTLE_TOXIN.1
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_FIRENETTLE_TOXIN.1"
msgid "Such nasty nettles!"
msgstr "¡Qué osadía la de estas ortigas!"

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_FIRENETTLE_TOXIN.2
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_FIRENETTLE_TOXIN.2"
msgid "Ouch! There wasn't any silver in those nettles, was there?"
msgstr "¡Auch! No había nada de plata entre esas ortigas, ¿no?"

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_FIRENETTLE_TOXIN_DONE
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_FIRENETTLE_TOXIN_DONE"
msgid "It seems I've beat the heat!"
msgstr "¡Al ardor le dije «no, señor»!"

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_FLARE_SEEN
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_FLARE_SEEN"
msgid "One of my friends is inviting me to play!"
msgstr "¡Una amistad me invita a una divertida actividad!"

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_FOODMEMORY
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_FOODMEMORY"
msgid "only_used_by_warly"
msgstr "only_used_by_warly"

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_FREEDOM
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_FREEDOM"
msgid "I am unbound!"
msgstr "¡No tengo ataduras!"

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_GATHER_MERM
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_GATHER_MERM"
msgid "only_used_by_wurt"
msgstr "only_used_by_wurt"

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_GHOSTDRAIN
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_GHOSTDRAIN"
msgid "Ghosts play... strange games..."
msgstr "Los fantasmas juegan a... juegos extraños..."

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_GHOST_QUEST
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_GHOST_QUEST"
msgid "only_used_by_wendy"
msgstr "only_used_by_wendy"

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_HEALINGSALVE_ACIDBUFF_DONE
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_HEALINGSALVE_ACIDBUFF_DONE"
msgid "Oh what a pain, I'm not safe from acid rain!"
msgstr "¡Qué molesto! Hay lluvia ácida y estoy expuesto."

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_HIGHRESEARCH
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_HIGHRESEARCH"
msgid "My brain's grown three sizes this day!"
msgstr "¡Hoy mi cerebro aumentó tres talles!"

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_HOT
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_HOT"
msgid "Hot, hot, hot!"
msgstr "¡Caliente, caliente, caliente!"

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_HOUNDS
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_HOUNDS"
msgid "The beasts are baying!"
msgstr "¡Las bestias están aullando!"

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_HUNGRY
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_HUNGRY"
msgid "Oh no, I'm hungry again."
msgstr "Oh, no, tengo hambre otra vez."

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_HUNT_AVOID_FORK
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_HUNT_AVOID_FORK"
msgid "A trail for the tenderfooted."
msgstr "Un sendero para novatos."

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_HUNT_BEAST_NEARBY
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_HUNT_BEAST_NEARBY"
msgid "I love a game of hide and seek!"
msgstr "¡Me encanta jugar a las escondidas!"

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_HUNT_LOST_TRAIL
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_HUNT_LOST_TRAIL"
msgid "You win this round!"
msgstr "¡Ganaste esta ronda!"

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_HUNT_LOST_TRAIL_SPRING
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_HUNT_LOST_TRAIL_SPRING"
msgid "Sabotaged by this realm's mushiness."
msgstr "La humedad de este reino me saboteó."

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_HUNT_START_FORK
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_HUNT_START_FORK"
msgid "The game is afoot! Or rather, a claw! Hyuyu!"
msgstr "¡El juego está en marcha! ¿O en marcha atrás? ¡Jiu, ju!"

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_HUNT_SUCCESSFUL_FORK
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_HUNT_SUCCESSFUL_FORK"
msgid "Aha! Advantage goes to the imp."
msgstr "¡Ajá! ¡El diablillo tiene ventaja!"

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_HUNT_WRONG_FORK
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_HUNT_WRONG_FORK"
msgid "My impish senses are tingling - something watches!"
msgstr "Mi sentido de diablillo me produce un cosquilleo. ¡Algo me observa!"

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_INSUFFICIENTFERTILIZER
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_INSUFFICIENTFERTILIZER"
msgid "It needs some plant food."
msgstr "Necesita comida para plantas."

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_INV_FULL
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_INV_FULL"
msgid "I only have two paws."
msgstr "Solo tengo dos zarpas."

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_IS_FEASTING
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_IS_FEASTING"
msgid "A fancy feast... or a fancied feast? Hyuyu!"
msgstr "¿Un festín copioso... o un festín copión? ¡Jiu, ju!"

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_KITCOON_FOUND_IN_THE_WILD
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_KITCOON_FOUND_IN_THE_WILD"
msgid "And what are you doing over here?"
msgstr "¿Y tú que haces por aquí?"

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_KITCOON_HIDANDSEEK_FOUND.1
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_KITCOON_HIDANDSEEK_FOUND.1"
msgid "I found a cat, but no fiddle, hyuyu!"
msgstr "Encontré un gato, pero sin botas, ¡jiu, ju!"

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_KITCOON_HIDANDSEEK_FOUND.2
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_KITCOON_HIDANDSEEK_FOUND.2"
msgid "The cat's out of the bag, hyuyu!"
msgstr "Ya no hay gato encerrado, ¡jiu, ju!"

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_KITCOON_HIDANDSEEK_FOUND.3
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_KITCOON_HIDANDSEEK_FOUND.3"
msgid "Your tail's a tattletale!"
msgstr "¡Tu cola es una delatora!"

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_KITCOON_HIDANDSEEK_FOUND.4
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_KITCOON_HIDANDSEEK_FOUND.4"
msgid "Always at the last place I would look!"
msgstr "Siempre en el último lugar donde buscaría."

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_KITCOON_HIDANDSEEK_FOUND_LAST_ONE
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_KITCOON_HIDANDSEEK_FOUND_LAST_ONE"
msgid "Smile from ear to ear, the cats are all here!"
msgstr "¡Festejaré un largo rato! Aquí están todos los gatos."

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_KITCOON_HIDANDSEEK_FOUND_LAST_ONE_TEAM
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_KITCOON_HIDANDSEEK_FOUND_LAST_ONE_TEAM"
msgid "I found, we found, the cats all around!"
msgstr "Encontramos juntos todos los gatos ocultos."

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_KITCOON_HIDANDSEEK_FOUND_ONE_MORE
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_KITCOON_HIDANDSEEK_FOUND_ONE_MORE"
msgid "The last one better hide with all their might, hyuyu!"
msgstr "Más vale que el último se esconda con todas sus fuerzas, ¡jiu, ju!"

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_KITCOON_HIDANDSEEK_LOSEGAME
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_KITCOON_HIDANDSEEK_LOSEGAME"
msgid "I'll have to note down those hiding spots, hyuyu."
msgstr "Tendré que tomar nota de los escondites, ¡jiu, ju!"

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_KITCOON_HIDANDSEEK_TIME_ALMOST_UP
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_KITCOON_HIDANDSEEK_TIME_ALMOST_UP"
msgid "I'm late! I'm late! I'll lose at this rate."
msgstr "¡Me atrasé! ¡Me atrasé! A este ritmo, sin duda perderé."

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_KITCOON_HIDANDSEEK_TOOFAR
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_KITCOON_HIDANDSEEK_TOOFAR"
msgid "No furry mortal would hide far far away!"
msgstr "¡Ningún mortal peludo se escondería tan lejos!"

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_KITCOON_HIDANDSEEK_TOOFAR_RETURN
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_KITCOON_HIDANDSEEK_TOOFAR_RETURN"
msgid "Back to the guessing game, hyuyu."
msgstr "Otra vez tendré que adivinar, jiu, ju."

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_KITCOON_HIDEANDSEEK_JOIN
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_KITCOON_HIDEANDSEEK_JOIN"
msgid "Oh, what fun, I'll help find one!"
msgstr "¡Qué divertido! ¡Encontraré un gatito escondido!"

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_KITCOON_HIDEANDSEEK_START
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_KITCOON_HIDEANDSEEK_START"
msgid "The cats have run, the game's begun!"
msgstr "Los gatos partieron. Que comience el juego."

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_KLAUS_CALLFORHELP
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_KLAUS_CALLFORHELP"
msgid "Well that's no fun, friend!"
msgstr "¡Eso no es divertido, amigo!"

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_KLAUS_ENRAGE
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_KLAUS_ENRAGE"
msgid "Time to hop out of here!"
msgstr "¡Hora de largarme de aquí!"

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_KLAUS_UNCHAINED
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_KLAUS_UNCHAINED"
msgid "Shall we dance?"
msgstr "¿Bailamos?"

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_KNOCKEDOUT
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_KNOCKEDOUT"
msgid "Oh, good morning!"
msgstr "¡Ah, buenos días!"

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_LIGHTNING_DAMAGE_AVOIDED
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_LIGHTNING_DAMAGE_AVOIDED"
msgid "Hyuyu! Can't catch me!"
msgstr "¡Jiu, ju! ¡No puedes atraparme!"

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_LOWRESEARCH
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_LOWRESEARCH"
msgid "That wasn't very enlightening."
msgstr "Eso no fue muy esclarecedor."

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_LUNAR_RIFT_MAX
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_LUNAR_RIFT_MAX"
msgid "That odd moonlight has caught my sight."
msgstr "A esa luz lunar rara se dirige mi mirada."

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_MEGA_FLARE_SEEN
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_MEGA_FLARE_SEEN"
msgid "An open invitation! Who knows what might drop by?"
msgstr "¡Una invitación abierta! ¿Quién vendrá?"

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_MONKEY_CURSE_1
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_MONKEY_CURSE_1"
msgid "As curses go, it could be worse."
msgstr "Hay maldiciones mucho peores."

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_MONKEY_CURSE_CHANGE
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_MONKEY_CURSE_CHANGE"
msgid "Hyuyu you've made a monkey out of me!"
msgstr "¡Jiu, ju! Ahora soy un simio. ¡Me han ensimiado!"

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_MONKEY_CURSE_CHANGEBACK
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_MONKEY_CURSE_CHANGEBACK"
msgid "All's well that ends spells."
msgstr "No hay hechizo que dure cien años."

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_MOONALTAR_MINE.GLASS_LOW
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_MOONALTAR_MINE.GLASS_LOW"
msgid "Yoo-hyuyu!"
msgstr "¡Juuu, jiu, ju!"

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_MOONALTAR_MINE.GLASS_MED
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_MOONALTAR_MINE.GLASS_MED"
msgid "Time to come out and play, okay?"
msgstr "Hora de salir a jugar, ¿sí?"

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_MOONALTAR_MINE.GLASS_REVEAL
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_MOONALTAR_MINE.GLASS_REVEAL"
msgid "Hello there!"
msgstr "¡Hola!"

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_MOONALTAR_MINE.IDOL_LOW
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_MOONALTAR_MINE.IDOL_LOW"
msgid "Yoo-hyuyu!"
msgstr "¡Juuu, jiu, ju!"

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_MOONALTAR_MINE.IDOL_MED
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_MOONALTAR_MINE.IDOL_MED"
msgid "Time to come out and play, okay?"
msgstr "Hora de salir a jugar, ¿sí?"

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_MOONALTAR_MINE.IDOL_REVEAL
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_MOONALTAR_MINE.IDOL_REVEAL"
msgid "Hello there!"
msgstr "¡Hola!"

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_MOONALTAR_MINE.SEED_LOW
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_MOONALTAR_MINE.SEED_LOW"
msgid "Yoo-hyuyu!"
msgstr "¡Juuu, jiu, ju!"

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_MOONALTAR_MINE.SEED_MED
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_MOONALTAR_MINE.SEED_MED"
msgid "Time to come out and play, okay?"
msgstr "Hora de salir a jugar, ¿sí?"

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_MOONALTAR_MINE.SEED_REVEAL
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_MOONALTAR_MINE.SEED_REVEAL"
msgid "Hello there!"
msgstr "¡Hola!"

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_MOONPOTION_FAILED
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_MOONPOTION_FAILED"
msgid "Oh, you're no fun at all."
msgstr "Oh, qué mala onda."

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_MOSQUITOS
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_MOSQUITOS"
msgid "Mosquitos! Do I even have blood??"
msgstr "¡Mosquitos! ¿Acaso tengo sangre?"

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_MOUNT_LOWHEALTH
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_MOUNT_LOWHEALTH"
msgid "Its soul hangs by a thread."
msgstr "Su alma pende de un hilo."

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_NODANGERGIFT
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_NODANGERGIFT"
msgid "Presents later, playtime now!"
msgstr "¡Los regalos más tarde! Ahora a jugar."

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_NODANGERSIESTA
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_NODANGERSIESTA"
msgid "Why sleep when there's fun afoot?"
msgstr "¿Por qué dormir cuando nos estamos divirtiendo?"

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_NODANGERSLEEP
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_NODANGERSLEEP"
msgid "Who could sleep when there's fun to be had?"
msgstr "¿Quién querría dormir cuando puede divertirse?"

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_NODAYSLEEP
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_NODAYSLEEP"
msgid "I wouldn't want to mess up my sleep schedule."
msgstr "No quiero alterar mi horario de sueño."

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_NODAYSLEEP_CAVE
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_NODAYSLEEP_CAVE"
msgid "An imp must stay on guard when underground."
msgstr "Un diablillo debe permanecer alerta cuando está bajo tierra."

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_NOHUNGERSIESTA
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_NOHUNGERSIESTA"
msgid "I'm too soul-famished to siesta."
msgstr "Tengo demasiada hambre de almas para una siesta."

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_NOHUNGERSLEEP
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_NOHUNGERSLEEP"
msgid "I'm too soul-famished to sleep."
msgstr "Tengo demasiada hambre de almas para dormir."

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_NOMOUNTEDGIFT
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_NOMOUNTEDGIFT"
msgid "I must depart this sweet beast first."
msgstr "Primero, debo dejar a esta encantadora bestia."

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_NONIGHTSIESTA
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_NONIGHTSIESTA"
msgid "No honorable imp would siesta at night."
msgstr "Ningún diablillo que se precie dormiría una siesta por la noche."

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_NONIGHTSIESTA_CAVE
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_NONIGHTSIESTA_CAVE"
msgid "An imp must stay on guard when underground."
msgstr "Un diablillo debe permanecer alerta cuando está bajo tierra."

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_NOPUMPKINCARVINGONFIRE
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_NOPUMPKINCARVINGONFIRE"
msgid "I weren't done, this burnt one!"
msgstr ""

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_NOSLEEPHASPERMANENTLIGHT
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_NOSLEEPHASPERMANENTLIGHT"
msgid "It's far too bright to sleep tonight."
msgstr "Hay demasiada luz para dormir esta noche."

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_NOSLEEPONFIRE
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_NOSLEEPONFIRE"
msgid "I'd prefer not to singe my fur."
msgstr "Prefiero no chamuscarme el pelaje."

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_NOWARDROBEONFIRE
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_NOWARDROBEONFIRE"
msgid "I'd prefer not to singe my fur."
msgstr "Prefiero no chamuscarme el pelaje."

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_NO_ABIGAIL_FLOWER
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_NO_ABIGAIL_FLOWER"
msgid "only_used_by_wendy"
msgstr "only_used_by_wendy"

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_NO_TRAP
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_NO_TRAP"
msgid "Can't catch me!"
msgstr "¡No puedes atraparme!"

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_OCEANFISHING_BADCAST
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_OCEANFISHING_BADCAST"
msgid "Try and try again!"
msgstr "¡Inténtalo una y otra vez!"

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_OCEANFISHING_GOTAWAY
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_OCEANFISHING_GOTAWAY"
msgid "Hyuyu, what a slippery little fellow!"
msgstr "Jiu, ju, ¡qué muchacho tan escurridizo!"

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_OCEANFISHING_IDLE_QUOTE.1
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_OCEANFISHING_IDLE_QUOTE.1"
msgid "Surely there's more fun ways to catch a fish."
msgstr "Seguro que hay formas más divertidas de atrapar un pez."

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_OCEANFISHING_IDLE_QUOTE.2
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_OCEANFISHING_IDLE_QUOTE.2"
msgid "I'm really only interested in catching soles."
msgstr "Solo me interesan las almas, no las escamas."

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_OCEANFISHING_IDLE_QUOTE.3
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_OCEANFISHING_IDLE_QUOTE.3"
msgid "I do hope a fish will fall for my prank."
msgstr "Espero que un pez pique con mi broma."

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_OCEANFISHING_IDLE_QUOTE.4
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_OCEANFISHING_IDLE_QUOTE.4"
msgid "Perhaps they're still spawning."
msgstr "Quizá todavía estén desovando."

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_OCEANFISHING_LINESNAP
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_OCEANFISHING_LINESNAP"
msgid "Well drat, I guess that's that."
msgstr "Oh, qué mal. Punto final."

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_OCEANFISHING_LINETOOLOOSE
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_OCEANFISHING_LINETOOLOOSE"
msgid "The line's gone slack, best reel it back!"
msgstr "El sedal está flojo, ¡mejor lo recojo!"

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_OCEAN_SILHOUETTE_INCOMING
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_OCEAN_SILHOUETTE_INCOMING"
msgid "Hyuyu, something's come to play!"
msgstr "Jiu, ju, ¡algo vino a jugar!"

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_OFF_SCRIPT
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_OFF_SCRIPT"
msgid "You slipped, that's not in the script! Hyuyuyu!"
msgstr "Te diste un tropezón que no estaba en el guion. ¡Jiu, ju!"

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_OTTERBOAT_DENBROKEN
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_OTTERBOAT_DENBROKEN"
msgid "I shouldn't have shattered the den, then?"
msgstr "¿Fue muy hostil haber destrozado el cubil?"

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_OTTERBOAT_OUTOFSHALLOWS
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_OTTERBOAT_OUTOFSHALLOWS"
msgid "I knew I otter keep to the shallows, hyuyu!"
msgstr "Nutria hay que salirse del agua poco profunda. ¡Jiu, ju!"

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_PANFLUTE_BUFF_ACTIVE.1
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_PANFLUTE_BUFF_ACTIVE.1"
msgid "I feel the call to toot my flute! Hyuyu!"
msgstr ""

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_PANFLUTE_BUFF_ACTIVE.2
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_PANFLUTE_BUFF_ACTIVE.2"
msgid "My flute's my muse, I can't refuse!"
msgstr ""

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_PANFLUTE_BUFF_USED.1
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_PANFLUTE_BUFF_USED.1"
msgid "What a hoot, to play my flute!"
msgstr ""

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_PANFLUTE_BUFF_USED.2
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_PANFLUTE_BUFF_USED.2"
msgid "A treat that feeds the soul! Hyuyu!"
msgstr ""

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_PECKED
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_PECKED"
msgid "But why!"
msgstr "Pero ¿por qué?"

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_PETRIFED_TREES
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_PETRIFED_TREES"
msgid "The trees are playing a funny prank!"
msgstr "¡Los árboles nos están haciendo una broma!"

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_PICK_DISEASE_WARNING
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_PICK_DISEASE_WARNING"
msgid "Its soul has not left its body, yet still it stinks."
msgstr "Su alma todavía sigue en el cuerpo, pero aun así apesta."

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_PIRATES_ARRIVE
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_PIRATES_ARRIVE"
msgid "Something scurvy this way comes."
msgstr "¡Se acerca algo con escorbuto!"

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_PLANT_RANDOMSEED
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_PLANT_RANDOMSEED"
msgid "What will grow from this seed is a mystery, indeed!"
msgstr "¿Qué crecerá de esta semilla? ¿Será una maravilla?"

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_PLANT_RESEARCHED.1
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_PLANT_RESEARCHED.1"
msgid "I'm learning a lot about this plant I've got!"
msgstr "¡Esta planta sí que me desasna!"

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_POCKETWATCH_PORTAL
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_POCKETWATCH_PORTAL"
msgid "It's not nearly as comfortable as my kind's way of traveling..."
msgstr "Es mucho más incómodo que mi forma de viajar."

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_PREFALLINVOID
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_PREFALLINVOID"
msgid "No time to rhyme, lest we hear death's chime!"
msgstr "¡No hay tiempo para rimar o la campana de la muerte sonará!"

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_QUAKE
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_QUAKE"
msgid "Shiver and shake, that's a quake!"
msgstr "¡Sacudones y sacudidas! ¡Un terremoto!"

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_RABBITKINGHORN_BADSPAWNPOINT
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_RABBITKINGHORN_BADSPAWNPOINT"
msgid "Not quite the site."
msgstr "No es exactamente el sitio."

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_RABBITKING_AGGRESSIVE
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_RABBITKING_AGGRESSIVE"
msgid "I'm serious, what approaches sounds furious!"
msgstr "¡Hablo en serio, lo que se acerca suena furioso!"

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_RABBITKING_LUCKY
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_RABBITKING_LUCKY"
msgid "A special rabbit! Please don't stab it!"
msgstr "¡Un conejo especial! ¡No lo apuñales, por favor!"

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_RABBITKING_LUCKYCAUGHT
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_RABBITKING_LUCKYCAUGHT"
msgid "Got it!"
msgstr "¡La tengo!"

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_RABBITKING_PASSIVE
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_RABBITKING_PASSIVE"
msgid "What's that sound from underground?"
msgstr "¿Qué es ese sonido subterráneo?"

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_REPELLED
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_REPELLED"
msgid "What trickery is this!"
msgstr "¿Qué clase de artimaña es esta?"

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_RESEARCH
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_RESEARCH"
msgid "My mind has expanded!"
msgstr "¡Mi mente se expandió!"

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_REVIVED_FROM_CORPSE
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_REVIVED_FROM_CORPSE"
msgid "The imp returns!"
msgstr "¡El diablillo volvió!"

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_REVIVED_OTHER_CORPSE
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_REVIVED_OTHER_CORPSE"
msgid "Up and at'em!"
msgstr "¡Levántate y ve por ellos!"

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_REVIVING_CORPSE
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_REVIVING_CORPSE"
msgid "C'mon back, silly goose."
msgstr "Regresa, cabeza de chorlito."

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_RUINS_RESET
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_RUINS_RESET"
msgid "Oh good. The monsters have returned."
msgstr "Oh, bien. Los monstruos volvieron."

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_SACREDCHEST_NO
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_SACREDCHEST_NO"
msgid "It seems my soul is too tarnished."
msgstr "Parece que mi alma está demasiado mancillada."

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_SACREDCHEST_YES
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_SACREDCHEST_YES"
msgid "I'm... worthy?"
msgstr "¿Soy... digno?"

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_SCRAPBOOK_FULL
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_SCRAPBOOK_FULL"
msgid "I already know everything there is to know, hyuyu!"
msgstr "Ya sé todo lo que hay que saber, ¡jiu, ju!"

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_SHADOWTHRALL_STEALTH
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_SHADOWTHRALL_STEALTH"
msgid "I felt a keen blow, from an unseen foe!"
msgstr "Sentí un fuerte impacto de un enemigo oculto en el acto."

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_SHADOW_RIFT_MAX
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_SHADOW_RIFT_MAX"
msgid "Calling that \"light\" wouldn't be quite right."
msgstr "Si eso es una luz, yo soy un angelito."

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_SHELTER
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_SHELTER"
msgid "Ah, much better!"
msgstr "¡Ah, mucho mejor!"

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_SISTURN_FULL_BLOSSOM
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_SISTURN_FULL_BLOSSOM"
msgid "only_used_by_wendy"
msgstr "only_used_by_wendy"

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_SISTURN_FULL_EVIL
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_SISTURN_FULL_EVIL"
msgid "only_used_by_wendy"
msgstr "only_used_by_wendy"

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_SNARED
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_SNARED"
msgid "I've been bound!"
msgstr "¡Me atraparon!"

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_SNARED_IVY
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_SNARED_IVY"
msgid "Oh ho! You think you can contain me?"
msgstr "¡Oh, jo! ¿Crees que puedes sujetarme?"

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_SNOWBALL_NO_SNOW
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_SNOWBALL_NO_SNOW"
msgid "It won't grow without more snow."
msgstr ""

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_SNOWBALL_TOO_BIG
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_SNOWBALL_TOO_BIG"
msgid "I tell no lies! It's at full size!"
msgstr ""

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_SOAKED
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_SOAKED"
msgid "I AM DRENCHED!"
msgstr "¡ESTOY EMPAPADO!"

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_SOUL_EMPTY.1
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_SOUL_EMPTY.1"
msgid "Woe be to a soul-starved imp!"
msgstr "¡Ay del diablillo hambriento de almas!"

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_SOUL_EMPTY.2
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_SOUL_EMPTY.2"
msgid "I don't want to suck anymore souls!"
msgstr "¡No quiero devorar más almas!"

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_SOUL_EMPTY.3
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_SOUL_EMPTY.3"
msgid "What gruesome things I must do to live!"
msgstr "¡Qué cosas horribles debo hacer para vivir!"

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_SOUL_EMPTY_NAUGHTY.1
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_SOUL_EMPTY_NAUGHTY.1"
msgid "I am absolutely famished!"
msgstr ""

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_SOUL_EMPTY_NAUGHTY.2
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_SOUL_EMPTY_NAUGHTY.2"
msgid "I'm starved for some delicious souls!"
msgstr ""

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_SOUL_EMPTY_NAUGHTY.3
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_SOUL_EMPTY_NAUGHTY.3"
msgid "I yearn for those tasty treats!"
msgstr ""

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_SOUL_EMPTY_NICE.1
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_SOUL_EMPTY_NICE.1"
msgid "I'm afraid I must feed soon."
msgstr ""

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_SOUL_EMPTY_NICE.2
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_SOUL_EMPTY_NICE.2"
msgid "Curse my need to feed!"
msgstr ""

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_SOUL_EMPTY_NICE.3
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_SOUL_EMPTY_NICE.3"
msgid "It is tragic that they must die so that I may have life."
msgstr ""

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_SOUL_FEW.1
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_SOUL_FEW.1"
msgid "I'll need more souls soon."
msgstr "Pronto necesitaré más almas."

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_SOUL_FEW.2
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_SOUL_FEW.2"
msgid "I feel the soul hunger stirring."
msgstr "Siento que despierta el hambre de almas."

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_SOUL_FEW_NAUGHTY.1
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_SOUL_FEW_NAUGHTY.1"
msgid "My collection is running low."
msgstr ""

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_SOUL_FEW_NAUGHTY.2
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_SOUL_FEW_NAUGHTY.2"
msgid "I'll need a soul snack soon."
msgstr ""

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_SOUL_FEW_NICE.1
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_SOUL_FEW_NICE.1"
msgid "Oh dear. Running low on souls, I fear."
msgstr ""

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_SOUL_FEW_NICE.2
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_SOUL_FEW_NICE.2"
msgid "I have precious few souls left."
msgstr ""

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_SOUL_MANY.1
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_SOUL_MANY.1"
msgid "I've enough souls to sustain me."
msgstr "Tengo suficientes almas para nutrirme."

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_SOUL_MANY.2
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_SOUL_MANY.2"
msgid "I hope I was not too greedy."
msgstr "Espero no haber sido demasiado glotón."

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_SOUL_MANY_NAUGHTY.1
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_SOUL_MANY_NAUGHTY.1"
msgid "When is enough enough? Never! Hyuyu!"
msgstr ""

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_SOUL_MANY_NAUGHTY.2
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_SOUL_MANY_NAUGHTY.2"
msgid "I love a feast of souls."
msgstr ""

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_SOUL_MANY_NICE.1
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_SOUL_MANY_NICE.1"
msgid "Oh my, I've taken so many!"
msgstr ""

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_SOUL_MANY_NICE.2
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_SOUL_MANY_NICE.2"
msgid "Such abundance. Many thanks!"
msgstr ""

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_SOUL_OVERLOAD.1
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_SOUL_OVERLOAD.1"
msgid "I can't handle that much soul power!"
msgstr "¡No puedo con tanto poder de almas!"

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_SOUL_OVERLOAD.2
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_SOUL_OVERLOAD.2"
msgid "That was one soul too many!"
msgstr "¡Fueron demasiadas almas!"

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_SOUL_OVERLOAD_AVOIDED.1
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_SOUL_OVERLOAD_AVOIDED.1"
msgid "My brim is back from making a crack."
msgstr ""

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_SOUL_OVERLOAD_AVOIDED.2
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_SOUL_OVERLOAD_AVOIDED.2"
msgid "I had to stop before I popped."
msgstr ""

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_SOUL_OVERLOAD_NAUGHTY.1
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_SOUL_OVERLOAD_NAUGHTY.1"
msgid "My precious souls!"
msgstr ""

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_SOUL_OVERLOAD_NAUGHTY.2
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_SOUL_OVERLOAD_NAUGHTY.2"
msgid "Those were mine! All mine!"
msgstr ""

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_SOUL_OVERLOAD_NICE.1
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_SOUL_OVERLOAD_NICE.1"
msgid "I was too greedy!"
msgstr ""

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_SOUL_OVERLOAD_NICE.2
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_SOUL_OVERLOAD_NICE.2"
msgid "Those poor souls have gone to waste!"
msgstr ""

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_SOUL_OVERLOAD_WARNING.1
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_SOUL_OVERLOAD_WARNING.1"
msgid "The souls are going to burst my brim!"
msgstr ""

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_SOUL_OVERLOAD_WARNING.2
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_SOUL_OVERLOAD_WARNING.2"
msgid "The burden of souls is certain to pop!"
msgstr ""

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_SPOOKED
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_SPOOKED"
msgid "What a s-silly prank!"
msgstr "¡Qué b-broma más tonta!"

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_TALK_TO_PLANTS.1
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_TALK_TO_PLANTS.1"
msgid "A pleasant day to you, my good greenery!"
msgstr "¡Buenos días, estimada vegetación!"

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_TALK_TO_PLANTS.2
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_TALK_TO_PLANTS.2"
msgid "I'm so sorry, I'm afraid I'm not quite fluent in plant."
msgstr "Lo siento. Me cuesta hablar el idioma de las plantas."

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_TALK_TO_PLANTS.3
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_TALK_TO_PLANTS.3"
msgid "How dull to spend your life stuck in the ground! Luckily I'm here to make it more exciting!"
msgstr "¡Qué tedioso pasarte la vida fija en el suelo! Por suerte vine para hacerla más emocionante."

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_TALK_TO_PLANTS.4
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_TALK_TO_PLANTS.4"
msgid "You like hearing the sound of my voice almost as much as I do, hyuyu!"
msgstr "Te gusta el sonido de mi voz casi tanto como a mí, ¡jiu, ju!"

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_TALK_TO_PLANTS.5
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_TALK_TO_PLANTS.5"
msgid "Let's pull a prank! What do you think the mortals would do if you sprouted into a sheep?"
msgstr "¡Hagamos una broma! ¿Qué harían los mortales si brotaras y te convirtieras en oveja?"

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_THORNS
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_THORNS"
msgid "It pricked me!"
msgstr "¡Me pincharon!"

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_THURIBLE_OUT
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_THURIBLE_OUT"
msgid "Oh dear, I think our truce just expired."
msgstr "Ay, caramba. Nuestra tregua acaba de terminar."

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_TICOON_ABANDONED
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_TICOON_ABANDONED"
msgid "I did my best, now I'll rest."
msgstr "Lo di todo. Ahora me toca el reposo."

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_TICOON_DEAD
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_TICOON_DEAD"
msgid "My guide is gone, do I carry on?"
msgstr "Mi guía desapareció. ¿Cómo sigo?"

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_TICOON_GET_LEADER_ATTENTION
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_TICOON_GET_LEADER_ATTENTION"
msgid "Oh, is it me you're looking for?"
msgstr "Ah, ¿me estás buscando a mí?"

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_TICOON_LOST_KITCOON
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_TICOON_LOST_KITCOON"
msgid "Oh me, oh my, they passed me by!"
msgstr "Estoy consternado. Se me han escapado."

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_TICOON_NEAR_KITCOON
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_TICOON_NEAR_KITCOON"
msgid "We're close, closer, yet closer!"
msgstr "Estamos cerca, cada vez más cerca."

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_TICOON_NOTHING_TO_TRACK
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_TICOON_NOTHING_TO_TRACK"
msgid "No tracks, no clue, I say we're through."
msgstr "No hay huellas ni pistas. Chau, hasta la vista."

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_TICOON_START_TRACKING
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_TICOON_START_TRACKING"
msgid "He'll get us nowhere fast, hyuyu!"
msgstr "¡Va a paso de tortuga asmática, jiu, ju!"

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_TICOON_WAITING_FOR_LEADER
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_TICOON_WAITING_FOR_LEADER"
msgid "He won't go ahead unless I keep my step, hyuyu!"
msgstr "Me está esperando para seguir avanzando, ¡jiu, ju!"

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_TOADESCAPED
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_TOADESCAPED"
msgid "It's gone home."
msgstr "Taza, taza, se fue a su casa."

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_TOADESCAPING
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_TOADESCAPING"
msgid "Don't flee! Play with me!"
msgstr "¡No huyas! ¡Juega conmigo!"

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_TOOL_SLIP
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_TOOL_SLIP"
msgid "Whoops-a-doodle, hyuyu!"
msgstr "Uy, metí la pata, ¡jiu, ju!"

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_TOOL_TOOWEAK
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_TOOL_TOOWEAK"
msgid "This tool is too weak for what I seek."
msgstr "A esta herramienta le falta polenta."

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_TORCH_OUT
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_TORCH_OUT"
msgid "Farewell, sweet flame!"
msgstr "¡Adiós, dulce llama!"

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_TOWNPORTALTELEPORT
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_TOWNPORTALTELEPORT"
msgid "Never fear, the imp is here!"
msgstr "¡No teman! ¡El diablillo se acerca!"

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_TRAP_WENT_OFF
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_TRAP_WENT_OFF"
msgid "Oh dear, oh dear."
msgstr "Ay, caramba. Ay, caramba."

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_UNIMPLEMENTED
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_UNIMPLEMENTED"
msgid "What on earth could it be!"
msgstr "¿Qué diablos podría ser?"

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_WASHED_ASHORE
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_WASHED_ASHORE"
msgid "I escaped the threat, but now I'm wet!"
msgstr "¡Me he salvado, pero ahora estoy mojado!"

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_WEAK_RAT
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_WEAK_RAT"
msgid "Time has nearly run out for this would-be racer."
msgstr "A esta aspirante a corredora casi se le terminó el tiempo."

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_WEIGHT
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_WEIGHT"
msgid "Weight: {weight}"
msgstr "Peso: {weight}"

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_WEIGHT_HEAVY
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_WEIGHT_HEAVY"
msgid "Weight: {weight}\nI got my wish, a hefty fish!"
msgstr "Peso: {weight}\n¡Conseguí finalmente un pez bien contundente!"

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_WENDY_BABYSITTER_SET
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_WENDY_BABYSITTER_SET"
msgid "only_used_by_wendy"
msgstr "only_used_by_wendy"

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_WENDY_BABYSITTER_STOP
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_WENDY_BABYSITTER_STOP"
msgid "only_used_by_wendy"
msgstr "only_used_by_wendy"

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_WET
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_WET"
msgid "There is wet imp smell in my future."
msgstr "En mi futuro, hay olor a diablillo mojado."

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_WETTER
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_WETTER"
msgid "I am the soggiest imp!"
msgstr "¡Soy el diablillo más empapado!"

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_WINCH_CLAW_MISS
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_WINCH_CLAW_MISS"
msgid "I thought I'd be better at this game."
msgstr "Pensé que será más hábil en este juego."

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_WINCH_CLAW_NO_ITEM
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_WINCH_CLAW_NO_ITEM"
msgid "It's come up with nothing."
msgstr "No capturó nada."

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_WINTERS_FEAST_BUFF
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_WINTERS_FEAST_BUFF"
msgid "Hyuyu, how splendid!"
msgstr "Jiu, ju, ¡espléndido!"

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_WINTERS_FEAST_BUFF_OVER
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_WINTERS_FEAST_BUFF_OVER"
msgid "I'll never lose the impish sparkle in my eye."
msgstr "Mis ojos nunca perderán la chispa diabólica."

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_WOLFGANG_BEGIN_COACHING
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_WOLFGANG_BEGIN_COACHING"
msgid "only_used_by_wolfang"
msgstr "only_used_by_wolfgang"

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_WOLFGANG_END_COACHING
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_WOLFGANG_END_COACHING"
msgid "only_used_by_wolfang"
msgstr "only_used_by_wolfgang"

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_WOLFGANG_MIGHTY_COACHING
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_WOLFGANG_MIGHTY_COACHING"
msgid "only_used_by_wolfang"
msgstr "only_used_by_wolfgang"

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_WOLFGANG_NOTEAM.1
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_WOLFGANG_NOTEAM.1"
msgid "only_used_by_wolfang"
msgstr "only_used_by_wolfgang"

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_WOLFGANG_NOTEAM.2
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_WOLFGANG_NOTEAM.2"
msgid "only_used_by_wolfang"
msgstr "only_used_by_wolfgang"

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_WOLFGANG_NOTEAM.3
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_WOLFGANG_NOTEAM.3"
msgid "only_used_by_wolfang"
msgstr "only_used_by_wolfgang"

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_WOLFGANG_WIMPY_COACHING
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_WOLFGANG_WIMPY_COACHING"
msgid "only_used_by_wolfgang"
msgstr "only_used_by_wolfgang"

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_WORMHOLE
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_WORMHOLE"
msgid "Hyuyu, how grotesque that was!"
msgstr "¡Jiu, ju! Eso fue grotesco."

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_WORMS
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_WORMS"
msgid "Something approaches from beneath!"
msgstr "¡Algo se acerca desde abajo!"

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_WORMS_BOSS
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_WORMS_BOSS"
msgid "Don't bumble about, upon that rumble, no doubt!"
msgstr "No vayas a tropezar cuando el suelo empiece a vibrar."

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_WORTOX_REVIVER_FAILTELEPORT
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_WORTOX_REVIVER_FAILTELEPORT"
msgid "Oh dear, still here!"
msgstr ""

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_WX_SCANNER_NEW_FOUND
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_WX_SCANNER_NEW_FOUND"
msgid "only_used_by_wx78"
msgstr "only_used_by_wx78"

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_YOTB_LEARN_NEW_PATTERN
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_YOTB_LEARN_NEW_PATTERN"
msgid "Hyuyu! A new plan has taken shape!"
msgstr "¡Jiu, ju! Se formó un nuevo plano."

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_YOTD_NOBOATS
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_YOTD_NOBOATS"
msgid "Me and the start are too far apart."
msgstr "La largada está a una distancia muy larga."

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_YOTD_NOCHECKPOINTS
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_YOTD_NOCHECKPOINTS"
msgid "Whoopsie! I'll make a point to check first."
msgstr "¡Uia! No hay ningún marcador marcado."

#. STRINGS.CHARACTERS.WORTOX.ANNOUNCE_YOTD_NOTENOUGHBOATS
msgctxt "STRINGS.CHARACTERS.WORTOX.ANNOUNCE_YOTD_NOTENOUGHBOATS"
msgid "I should make space, so someone can join the race."
msgstr "Debería dejar espacio delante para otros participantes."

#. STRINGS.CHARACTERS.WORTOX.BATTLECRY.DEER
msgctxt "STRINGS.CHARACTERS.WORTOX.BATTLECRY.DEER"
msgid "You look like fun, dear."
msgstr "Ciervamente pareces divertido."

#. STRINGS.CHARACTERS.WORTOX.BATTLECRY.GENERIC
msgctxt "STRINGS.CHARACTERS.WORTOX.BATTLECRY.GENERIC"
msgid "Let's have some fun."
msgstr "¡Vamos a divertirnos!"

#. STRINGS.CHARACTERS.WORTOX.BATTLECRY.PIG
msgctxt "STRINGS.CHARACTERS.WORTOX.BATTLECRY.PIG"
msgid "Dance with me, piggy pig!"
msgstr "¡Baila conmigo, cerdito!"

#. STRINGS.CHARACTERS.WORTOX.BATTLECRY.PREY
msgctxt "STRINGS.CHARACTERS.WORTOX.BATTLECRY.PREY"
msgid "I want to play!"
msgstr "¡Quiero jugar!"

#. STRINGS.CHARACTERS.WORTOX.BATTLECRY.SPIDER
msgctxt "STRINGS.CHARACTERS.WORTOX.BATTLECRY.SPIDER"
msgid "Let's play, let's play!"
msgstr "¡Vamos a jugar, vamos a jugar!"

#. STRINGS.CHARACTERS.WORTOX.BATTLECRY.SPIDER_WARRIOR
msgctxt "STRINGS.CHARACTERS.WORTOX.BATTLECRY.SPIDER_WARRIOR"
msgid "Do you dance?"
msgstr "¿Bailas?"

#. STRINGS.CHARACTERS.WORTOX.COMBAT_QUIT.GENERIC
msgctxt "STRINGS.CHARACTERS.WORTOX.COMBAT_QUIT.GENERIC"
msgid "I am the wimp imp!"
msgstr "¡Soy el diablillo cobarde!"

#. STRINGS.CHARACTERS.WORTOX.COMBAT_QUIT.PIG
msgctxt "STRINGS.CHARACTERS.WORTOX.COMBAT_QUIT.PIG"
msgid "Never mind, I've forgotten my dancing shoes."
msgstr "Olvídalo. No traje mis zapatos de baile."

#. STRINGS.CHARACTERS.WORTOX.COMBAT_QUIT.PREY
msgctxt "STRINGS.CHARACTERS.WORTOX.COMBAT_QUIT.PREY"
msgid "You no longer entertain me."
msgstr "Ya no me entretienes."

#. STRINGS.CHARACTERS.WORTOX.COMBAT_QUIT.SPIDER
msgctxt "STRINGS.CHARACTERS.WORTOX.COMBAT_QUIT.SPIDER"
msgid "I am the wimp imp!"
msgstr "¡Soy el diablillo cobarde!"

#. STRINGS.CHARACTERS.WORTOX.COMBAT_QUIT.SPIDER_WARRIOR
msgctxt "STRINGS.CHARACTERS.WORTOX.COMBAT_QUIT.SPIDER_WARRIOR"
msgid "I'll take my leave. Hyuyu!"
msgstr "Me retiro. ¡Jiu, ju!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.ABIGAIL.LEVEL1.1
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.ABIGAIL.LEVEL1.1"
msgid "Poor soul."
msgstr "Pobre alma."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.ABIGAIL.LEVEL1.2
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.ABIGAIL.LEVEL1.2"
msgid "Poor soul."
msgstr "Pobre alma."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.ABIGAIL.LEVEL2.1
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.ABIGAIL.LEVEL2.1"
msgid "Poor soul."
msgstr "Pobre alma."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.ABIGAIL.LEVEL2.2
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.ABIGAIL.LEVEL2.2"
msgid "Poor soul."
msgstr "Pobre alma."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.ABIGAIL.LEVEL3.1
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.ABIGAIL.LEVEL3.1"
msgid "Poor soul."
msgstr "Pobre alma."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.ABIGAIL.LEVEL3.2
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.ABIGAIL.LEVEL3.2"
msgid "Poor soul."
msgstr "Pobre alma."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.ABIGAIL_FLOWER.GENERIC
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.ABIGAIL_FLOWER.GENERIC"
msgid "I think it eats souls, too."
msgstr "Creo que también come almas."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.ABIGAIL_FLOWER.HAUNTED_GROUND
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.ABIGAIL_FLOWER.HAUNTED_GROUND"
msgid "Ohh, you're hungry too."
msgstr "Ah, tú también tienes hambre."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.ABIGAIL_FLOWER.HAUNTED_POCKET
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.ABIGAIL_FLOWER.HAUNTED_POCKET"
msgid "Sadly, it is not mine to keep."
msgstr "Por desgracia, no me puedo quedar con esto."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.ABIGAIL_FLOWER.LEVEL1
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.ABIGAIL_FLOWER.LEVEL1"
msgid "No need to hide from me... tasty as you might be."
msgstr "No hay razón para esconderte... por apetecible que te encuentre."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.ABIGAIL_FLOWER.LEVEL2
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.ABIGAIL_FLOWER.LEVEL2"
msgid "How are you doing in there?"
msgstr "¿Cómo te va por ahí?"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.ABIGAIL_FLOWER.LEVEL3
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.ABIGAIL_FLOWER.LEVEL3"
msgid "My, you're looking spirited! Hyuyu!"
msgstr "¡Se te ve muy animada! ¡Jiu, ju!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.ABIGAIL_FLOWER.LONG
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.ABIGAIL_FLOWER.LONG"
msgid "It's very sad. Full of regrets."
msgstr "Qué triste. Está llena de arrepentimientos."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.ABIGAIL_FLOWER.MEDIUM
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.ABIGAIL_FLOWER.MEDIUM"
msgid "Waking up, are we?"
msgstr "Ya te despiertas, ¿verdad?"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.ABIGAIL_FLOWER.SOON
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.ABIGAIL_FLOWER.SOON"
msgid "It seems the fun will soon begin."
msgstr "Parece que la diversión comenzará pronto."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.ACCOMPLISHMENT_SHRINE
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.ACCOMPLISHMENT_SHRINE"
msgid "I did indeed do that!"
msgstr "¡Sí que lo hice!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.ACORN
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.ACORN"
msgid "It's nutty, like me!"
msgstr "¡Es dura, como yo!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.ACORN_COOKED
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.ACORN_COOKED"
msgid "I'll only eat it if I have to."
msgstr "La comeré solo si es estrictamente necesario."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.ACORN_SAPLING
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.ACORN_SAPLING"
msgid "You know how to grow!"
msgstr "¡Sabes cómo crecer!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.ADVENTURE_PORTAL
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.ADVENTURE_PORTAL"
msgid "I want to play a game with you!"
msgstr "¡Quiero jugar a un juego contigo!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.ALTERGUARDIANHAT
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.ALTERGUARDIANHAT"
msgid "It tells me the most delicious secrets, hyuyu!"
msgstr "Me cuenta sus secretos más deliciosos, ¡jiu, ju!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.ALTERGUARDIANHATSHARD
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.ALTERGUARDIANHATSHARD"
msgid "It won't be too hard to find a use for this shard."
msgstr "En un momento le encontraré utilidad a este fragmento."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.ALTERGUARDIAN_CONTAINED
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.ALTERGUARDIAN_CONTAINED"
msgid "Oh ho! It seems he has some tricks up his sleeve."
msgstr "¡Oh, jo! Tiene algunos trucos bajo la manga."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.ALTERGUARDIAN_PHASE1.DEAD
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.ALTERGUARDIAN_PHASE1.DEAD"
msgid "Send my regards to your master!"
msgstr "¡Le mando saludos a tu amo!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.ALTERGUARDIAN_PHASE1.GENERIC
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.ALTERGUARDIAN_PHASE1.GENERIC"
msgid "We got off to a rocky start, didn't we? Hyuyu!"
msgstr "El comienzo de esta relación fue duro, ¿no? ¡Jiu, ju!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.ALTERGUARDIAN_PHASE2.DEAD
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.ALTERGUARDIAN_PHASE2.DEAD"
msgid "Now with any luck it kicked the bucket."
msgstr "Si tenemos suerte, habrá estirado la pata."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.ALTERGUARDIAN_PHASE2.GENERIC
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.ALTERGUARDIAN_PHASE2.GENERIC"
msgid "Hoohoo! It seems there's more in store!"
msgstr "¡Ju, ju! ¡Esto todavía no termina!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.ALTERGUARDIAN_PHASE2SPIKE
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.ALTERGUARDIAN_PHASE2SPIKE"
msgid "This imp will not be contained so easily."
msgstr "No pueden sujetar tan fácilmente a este diablillo."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.ALTERGUARDIAN_PHASE3
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.ALTERGUARDIAN_PHASE3"
msgid "The time is right to end this fight!"
msgstr "Es la ocasión oportuna para que la lucha concluya."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.ALTERGUARDIAN_PHASE3DEAD
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.ALTERGUARDIAN_PHASE3DEAD"
msgid "Shall we see what's left behind?"
msgstr "¿Vemos que dejó?"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.ALTERGUARDIAN_PHASE3DEADORB
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.ALTERGUARDIAN_PHASE3DEADORB"
msgid "Energy, but no soul to snack on. A pity."
msgstr "Energía, pero no un alma para comer. Qué pena."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.ALTERGUARDIAN_PHASE3TRAP
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.ALTERGUARDIAN_PHASE3TRAP"
msgid "Hoohoo, this imp knows a trick when he sees one."
msgstr "¡Ju, ju! Este diablillo sabe reconocer un engaño."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.AMULET
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.AMULET"
msgid "A glimmering jewel that's rife with life."
msgstr "Una joya reluciente que rebosa de vida."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.ANCHOR
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.ANCHOR"
msgid "Drop it to stop it."
msgstr "Para parar solo la hay que soltar."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.ANCHOR_ITEM
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.ANCHOR_ITEM"
msgid "Such funny ship things I could build."
msgstr "Cuántas cosas divertidas para barcos que podría construir."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.ANCIENTFRUIT_GEM
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.ANCIENTFRUIT_GEM"
msgid "Don't try to eat it, better to heat it!"
msgstr "Mejor calentarla que tragarla."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.ANCIENTFRUIT_NIGHTVISION
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.ANCIENTFRUIT_NIGHTVISION"
msgid "Just one bite to help my sight at night."
msgstr "Con un solo bocado, mi visión nocturna habrá mejorado."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.ANCIENTFRUIT_NIGHTVISION_COOKED
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.ANCIENTFRUIT_NIGHTVISION_COOKED"
msgid "I miss the wriggle, it made me giggle."
msgstr "La forma en que se movía me divertía."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.ANCIENTTREE_GEM.GENERIC
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.ANCIENTTREE_GEM.GENERIC"
msgid "The tree furnace burns in earnest."
msgstr "Este árbol llameante sí que es interesante."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.ANCIENTTREE_GEM.STUMP
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.ANCIENTTREE_GEM.STUMP"
msgid "Once a tree, now debris."
msgstr "Los restos de un exarbol."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.ANCIENTTREE_NIGHTVISION.GENERIC
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.ANCIENTTREE_NIGHTVISION.GENERIC"
msgid "Is it so scary for a tree to be hairy?"
msgstr "¿Da tanto miedo que un árbol tenga pelo?"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.ANCIENTTREE_NIGHTVISION.STUMP
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.ANCIENTTREE_NIGHTVISION.STUMP"
msgid "It's leafy life was cut short."
msgstr "Cercenaron su vida vegetal."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.ANCIENTTREE_SAPLING.GENERIC
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.ANCIENTTREE_SAPLING.GENERIC"
msgid "Not to get sappy, I'm glad it's happy."
msgstr "Me alegra mucho que esté tan a gusto."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.ANCIENTTREE_SAPLING.WRONG_SEASON
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.ANCIENTTREE_SAPLING.WRONG_SEASON"
msgid "What now? Oh, not now."
msgstr "¿Ahora qué? Ah, ahora no."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.ANCIENTTREE_SAPLING.WRONG_TILE
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.ANCIENTTREE_SAPLING.WRONG_TILE"
msgid "Not the picky plant's preferred placement?"
msgstr "¿No es la posición preferida de esta planta puntillosa?"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.ANCIENTTREE_SAPLING_ITEM
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.ANCIENTTREE_SAPLING_ITEM"
msgid "It's tricky with a tree so picky."
msgstr "Qué complicado este árbol tan delicado."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.ANCIENTTREE_SEED
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.ANCIENTTREE_SEED"
msgid "I see a seed to sow, hyuyu!"
msgstr "Veo una semilla para sembrar, ¡jiu, ju!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.ANCIENT_ALTAR
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.ANCIENT_ALTAR"
msgid "A fun place to do some naughty magic."
msgstr "Un lugar divertido para hacer magia traviesa."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.ANCIENT_ALTAR_BROKEN
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.ANCIENT_ALTAR_BROKEN"
msgid "Oh dear oh dear, that will not do."
msgstr "Ah, caramba. Así no funcionará."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.ANCIENT_STATUE
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.ANCIENT_STATUE"
msgid "Hyuyu, how spooky!"
msgstr "¡Jiu, ju, qué miedo!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.ANIMAL_TRACK
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.ANIMAL_TRACK"
msgid "Those aren't my hoofprints!"
msgstr "¡Esas no son mis huellas de pezuñas!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.ANTCHOVIES
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.ANTCHOVIES"
msgid "Squirmy, wormy, fishy food."
msgstr "Comida pescadil, gusanil y serpentil."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.ANTLION.GENERIC
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.ANTLION.GENERIC"
msgid "You need only tell me what you desire."
msgstr "Solo tienes que decirme lo que deseas."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.ANTLION.UNHAPPY
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.ANTLION.UNHAPPY"
msgid "Apologies, dear beast! I am but a worm!"
msgstr "¡Perdona, querida bestia! ¡Soy solo un gusano!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.ANTLION.VERYHAPPY
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.ANTLION.VERYHAPPY"
msgid "Are you not pleased, my friend?"
msgstr "¿No estás satisfecha, amiga mía?"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.ANTLIONHAT
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.ANTLIONHAT"
msgid "I'd be lion if I said I wasn't antsy to try it, hyuyu!"
msgstr "¡Con este sombrero hormigable armaré un gran ja-leo, jiu, ju!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.ANTLIONTRINKET
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.ANTLIONTRINKET"
msgid "Better get a bucket!"
msgstr "¡Hay que conseguir un cubo!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.ARCHIVE_CENTIPEDE
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.ARCHIVE_CENTIPEDE"
msgid "The message is clear, it does not want me here."
msgstr "El mensaje está claro: no me quiere a su lado."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.ARCHIVE_CENTIPEDE_HUSK
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.ARCHIVE_CENTIPEDE_HUSK"
msgid "An empty, soulless shell."
msgstr "Una cáscara vacía y sin alma."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.ARCHIVE_COOKPOT.BURNT
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.ARCHIVE_COOKPOT.BURNT"
msgid "I don't understand how to make mortal food."
msgstr "No entiendo cómo preparar comida para mortales."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.ARCHIVE_COOKPOT.COOKING_LONG
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.ARCHIVE_COOKPOT.COOKING_LONG"
msgid "It will take quite some time."
msgstr "Va a tardar un tiempo."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.ARCHIVE_COOKPOT.COOKING_SHORT
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.ARCHIVE_COOKPOT.COOKING_SHORT"
msgid "I'm shivering with anticipation!"
msgstr "¡Estoy temblando de la emoción!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.ARCHIVE_COOKPOT.DONE
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.ARCHIVE_COOKPOT.DONE"
msgid "Looks like my treat is ready to eat!"
msgstr "¡Mi plato está listo para ser degustado!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.ARCHIVE_COOKPOT.EMPTY
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.ARCHIVE_COOKPOT.EMPTY"
msgid "I think whatever was cooking has gone cold."
msgstr "Lo que haya cocinado ya se ha enfriado."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.ARCHIVE_LOCKBOX
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.ARCHIVE_LOCKBOX"
msgid "Oh ho! A puzzling piece indeed!"
msgstr "¡Oh, jo! Un artefacto que me deja estupefacto."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.ARCHIVE_LOCKBOX_DISPENCER.GENERIC
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.ARCHIVE_LOCKBOX_DISPENCER.GENERIC"
msgid "Do you have any secrets for me?"
msgstr "¿Tienes algún secreto para mí?"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.ARCHIVE_LOCKBOX_DISPENCER.POWEROFF
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.ARCHIVE_LOCKBOX_DISPENCER.POWEROFF"
msgid "What a shame, these machines have no souls to claim."
msgstr "Qué terrible. Estas máquinas no tienen un alma comestible."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.ARCHIVE_MOON_STATUE
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.ARCHIVE_MOON_STATUE"
msgid "My, that looks heavy."
msgstr "Vaya, parece muy pesada."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.ARCHIVE_ORCHESTRINA_MAIN
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.ARCHIVE_ORCHESTRINA_MAIN"
msgid "This floor is soundly built, hyuyu!"
msgstr "Este piso resuena, ¡jiu, ju!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.ARCHIVE_PORTAL.GENERIC
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.ARCHIVE_PORTAL.GENERIC"
msgid "My my, someone didn't want this door opened."
msgstr "Vaya, vaya. Alguien no quería que abrieran esta puerta."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.ARCHIVE_PORTAL.POWEROFF
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.ARCHIVE_PORTAL.POWEROFF"
msgid "I won't tell the mortals it's here, it'll just get their poor hopes up."
msgstr "No les contaré a los mortales que está aquí porque los haría ilusionarse."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.ARCHIVE_RESONATOR.GENERIC
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.ARCHIVE_RESONATOR.GENERIC"
msgid "There's something hidden that it seeks."
msgstr "Está buscando algo oculto."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.ARCHIVE_RESONATOR.IDLE
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.ARCHIVE_RESONATOR.IDLE"
msgid "We've finished the deed, nowhere left to lead."
msgstr "Su tarea está cumplida. Ya a ningún lado nos guía."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.ARCHIVE_RESONATOR_ITEM
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.ARCHIVE_RESONATOR_ITEM"
msgid "What a curious contraption!"
msgstr "¡Qué artilugio tan atípico!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.ARCHIVE_RUNE_STATUE.LINE_1
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.ARCHIVE_RUNE_STATUE.LINE_1"
msgid "Oh, what's this? A bit of light reading?"
msgstr "¿Qué es esto? ¿Algo para leer un rato?"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.ARCHIVE_RUNE_STATUE.LINE_2
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.ARCHIVE_RUNE_STATUE.LINE_2"
msgid "It seems they were quite enamoured with our fickle moon once."
msgstr "Parece que sentían fascinación por nuestra voluble luna."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.ARCHIVE_RUNE_STATUE.LINE_3
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.ARCHIVE_RUNE_STATUE.LINE_3"
msgid "Now this one doesn't make much sense at all. Unless..."
msgstr "Esto no tiene mucho sentido. A menos que..."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.ARCHIVE_RUNE_STATUE.LINE_4
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.ARCHIVE_RUNE_STATUE.LINE_4"
msgid "Oh my! My, my my!"
msgstr "¡Ay, caramba! ¡Caramba!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.ARCHIVE_RUNE_STATUE.LINE_5
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.ARCHIVE_RUNE_STATUE.LINE_5"
msgid "Hyuyu, I shouldn't spoil the surprise!"
msgstr "¡Jiu, ju! No debería arruinar la sorpresa."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.ARCHIVE_SECURITY_DESK.GENERIC
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.ARCHIVE_SECURITY_DESK.GENERIC"
msgid "Oooh how fun! A trap!"
msgstr "¡Oh, qué divertido! ¡Una trampa!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.ARCHIVE_SECURITY_DESK.POWEROFF
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.ARCHIVE_SECURITY_DESK.POWEROFF"
msgid "Now what are you, and what did you do?"
msgstr "¿Tú qué eres y qué hiciste?"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.ARCHIVE_SECURITY_PULSE
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.ARCHIVE_SECURITY_PULSE"
msgid "A fellow fae come to show me the way? I think not, hyuyu!"
msgstr "¿Otro ser fantástico viene a mostrarme el camino? ¡No lo creo, jiu, ju!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.ARCHIVE_SWITCH.GEMS
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.ARCHIVE_SWITCH.GEMS"
msgid "It craves something glittery."
msgstr "Ansía algo brillante."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.ARCHIVE_SWITCH.VALID
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.ARCHIVE_SWITCH.VALID"
msgid "It's clutching tightly to that treasure."
msgstr "Se aferra con fuerza a ese tesoro."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.ARMORDRAGONFLY
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.ARMORDRAGONFLY"
msgid "Ooo, I've always wanted to be scaly."
msgstr "Ah, siempre quise ser escamoso."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.ARMORDREADSTONE
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.ARMORDREADSTONE"
msgid "All blows will be blocked by this armor of rock."
msgstr "Esta armadura de roca bloquea todos los golpes que afronta."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.ARMORGRASS
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.ARMORGRASS"
msgid "Protect oneself with a swish and a wish!"
msgstr "¡Te protege de una forma gramillosa!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.ARMORMARBLE
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.ARMORMARBLE"
msgid "Stone cold!"
msgstr "¡Fría como una piedra!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.ARMORRUINS
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.ARMORRUINS"
msgid "This thulecite sure is a delight!"
msgstr "¡Esta thulecita es muy bonita!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.ARMORSKELETON
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.ARMORSKELETON"
msgid "This fashion's all the rage... it's an external rib cage!"
msgstr "¡Este modelo hace furor! ¡Te temblarán los huesos de la emoción!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.ARMORSLURPER
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.ARMORSLURPER"
msgid "If it means I eat less often, count me in!"
msgstr "¡Si me hará comer menos, cuenta conmigo!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.ARMORSNURTLESHELL
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.ARMORSNURTLESHELL"
msgid "Little bits of snurtle, yes."
msgstr "Trocitos de torturol, sí."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.ARMORWAGPUNK
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.ARMORWAGPUNK"
msgid "Don't leer at my gear."
msgstr "Una armadura dura dura."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.ARMORWOOD
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.ARMORWOOD"
msgid "Knock on wood, they say, they say!"
msgstr "¡Toca madera, eso dicen, eso dicen!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.ARMOR_BRAMBLE
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.ARMOR_BRAMBLE"
msgid "Who'd like to give an imp a hug? Hyuyu!"
msgstr "¿Quién quiere abrazar a este diablillo? ¡Jiu, ju!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.ARMOR_CARROTLURE
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.ARMOR_CARROTLURE"
msgid "Carrot? Wear it!"
msgstr "¿Zanahoria? ¡Para vestir!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.ARMOR_LUNARPLANT
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.ARMOR_LUNARPLANT"
msgid "Strong and light, quite good in a fight."
msgstr "Fuerte y ligera, ideal para una pelea."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.ARMOR_LUNARPLANT_HUSK
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.ARMOR_LUNARPLANT_HUSK"
msgid "Prickly plant protection, perfection!"
msgstr "Protección vegetal espinosa, ¡qué buena cosa!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.ARMOR_SANITY
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.ARMOR_SANITY"
msgid "Keeps the flesh body safe! The mind's another story."
msgstr "¡Mantiene el cuerpo a salvo! La mente es otro tema."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.ARMOR_VOIDCLOTH
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.ARMOR_VOIDCLOTH"
msgid "It broke the chains of its previous plane."
msgstr "Se ha liberado de su anterior plano."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.ARROWSIGN_PANEL.BURNT
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.ARROWSIGN_PANEL.BURNT"
msgid "A silly prank to be sure."
msgstr "Una broma tonta, está claro."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.ARROWSIGN_PANEL.GENERIC
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.ARROWSIGN_PANEL.GENERIC"
msgid "It really doesn't matter which way I go!"
msgstr "¡Da igual hacia dónde vaya!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.ARROWSIGN_PANEL.UNWRITTEN
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.ARROWSIGN_PANEL.UNWRITTEN"
msgid "Nothing to be seen here, I fear."
msgstr "Me temo que no hay nada que ver aquí."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.ARROWSIGN_POST.BURNT
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.ARROWSIGN_POST.BURNT"
msgid "A silly prank to be sure."
msgstr "Una broma tonta, está claro."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.ARROWSIGN_POST.GENERIC
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.ARROWSIGN_POST.GENERIC"
msgid "It really doesn't matter which way I go!"
msgstr "¡Da igual hacia dónde vaya!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.ARROWSIGN_POST.UNWRITTEN
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.ARROWSIGN_POST.UNWRITTEN"
msgid "Nothing to be seen here, I fear."
msgstr "Me temo que no hay nada que ver aquí."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.ASH.GENERIC
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.ASH.GENERIC"
msgid "Cinders, cinders, cinders."
msgstr "Cenizas, cenizas y cenizas."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.ASH.REMAINS_EYE_BONE
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.ASH.REMAINS_EYE_BONE"
msgid "The planar hop has destroyed this bone!"
msgstr "¡El salto a otro plano destruyó este hueso!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.ASH.REMAINS_GLOMMERFLOWER
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.ASH.REMAINS_GLOMMERFLOWER"
msgid "The planar hop has destroyed this flower!"
msgstr "¡El salto a otro plano destruyó esta flor!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.ASH.REMAINS_THINGIE
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.ASH.REMAINS_THINGIE"
msgid "It could not exist on this plane."
msgstr "No podría existir en este plano."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.ASPARAGUS
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.ASPARAGUS"
msgid "A spear I guess. Hyuyu!"
msgstr "Espárrago. ¿O no es párrago? ¡Jiu, ju!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.ASPARAGUSSOUP
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.ASPARAGUSSOUP"
msgid "Even for human food, this is odd."
msgstr "Es rara, incluso para ser comida de humanos."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.ASPARAGUS_COOKED
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.ASPARAGUS_COOKED"
msgid "I'd rather not."
msgstr "Mejor no."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.ASPARAGUS_OVERSIZED
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.ASPARAGUS_OVERSIZED"
msgid "None for me, thank you."
msgstr "Para mí no, gracias."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.ASPARAGUS_SEEDS
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.ASPARAGUS_SEEDS"
msgid "Strange little seeds, indeed, indeed."
msgstr "Unas semillitas peculiares por estos lares."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.ATRIUM_GATE.CHARGING
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.ATRIUM_GATE.CHARGING"
msgid "Oh, we're going to have some fun!"
msgstr "¡Ah, cómo nos vamos a divertir!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.ATRIUM_GATE.COOLDOWN
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.ATRIUM_GATE.COOLDOWN"
msgid "Playtime's over."
msgstr "Se acabó la hora de juegos."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.ATRIUM_GATE.DESTABILIZING
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.ATRIUM_GATE.DESTABILIZING"
msgid "Hyuyu, it's getting weird!"
msgstr "¡Jiu, ju! Esto se está poniendo raro."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.ATRIUM_GATE.OFF
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.ATRIUM_GATE.OFF"
msgid "The thing I hopped through!"
msgstr "Entré por esta cosa."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.ATRIUM_GATE.ON
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.ATRIUM_GATE.ON"
msgid "That's how you get imps. Hyuyu!"
msgstr "Por aquí aparecen los diablillos. ¡Jiu, ju!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.ATRIUM_KEY
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.ATRIUM_KEY"
msgid "An imp could do mischievous things with this."
msgstr "Un diablillo podría hacer travesuras con esto."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.ATRIUM_LIGHT.OFF
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.ATRIUM_LIGHT.OFF"
msgid "I'm not sure how to play with this."
msgstr "No sé muy bien cómo jugar con esto."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.ATRIUM_LIGHT.ON
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.ATRIUM_LIGHT.ON"
msgid "Ooo, it turned on!"
msgstr "¡Oooh, se encendió!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.ATRIUM_OVERGROWTH
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.ATRIUM_OVERGROWTH"
msgid "Ooo, there's some naughty magic at play here!"
msgstr "¡Oooh, alguien hizo un poco de magia traviesa!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.ATRIUM_RUBBLE.LINE_1
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.ATRIUM_RUBBLE.LINE_1"
msgid "A bunch of mortals. They look very bored."
msgstr "Un montón de mortales. Parecen muy aburridos."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.ATRIUM_RUBBLE.LINE_2
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.ATRIUM_RUBBLE.LINE_2"
msgid "There's some magic residue on the stone. Not much else."
msgstr "Queda algo de residuo mágico en la piedra. No mucho más."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.ATRIUM_RUBBLE.LINE_3
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.ATRIUM_RUBBLE.LINE_3"
msgid "Ooo, it's about to get good!"
msgstr "¡Oooh, esto se va a poner bueno!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.ATRIUM_RUBBLE.LINE_4
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.ATRIUM_RUBBLE.LINE_4"
msgid "What a hoot! The mortals are slithering out their skins!"
msgstr "¡Qué risa! Los mortales se están saliendo de su piel."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.ATRIUM_RUBBLE.LINE_5
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.ATRIUM_RUBBLE.LINE_5"
msgid "They probably shouldn't have used that much magic."
msgstr "No deberían haber usado tanta magia."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.ATRIUM_STATUE
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.ATRIUM_STATUE"
msgid "Hyuyu, did you lose a game?"
msgstr "Jiu, ju, ¿perdiste a algún juego?"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.AXE
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.AXE"
msgid "To whack and to chop."
msgstr "Para pegar y talar."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.BABYBEEFALO.GENERIC
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.BABYBEEFALO.GENERIC"
msgid "It belongs with its momma."
msgstr "Debe estar con su mamá."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.BABYBEEFALO.SLEEPING
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.BABYBEEFALO.SLEEPING"
msgid "Sleep softly sweet soul."
msgstr "Que duermas bien, dulce alma."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.BACKPACK
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.BACKPACK"
msgid "Behold this burden on my back!"
msgstr "¡He aquí la carga que llevo en la espalda!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.BACONEGGS
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.BACONEGGS"
msgid "A mortal favorite."
msgstr "Una comida favorita de los mortales."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.BALLOON
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.BALLOON"
msgid "I often feel like I might float away. Hyuyu!"
msgstr "A menudo siento que podría irme flotando. ¡Jiu, ju!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.BALLOONHAT
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.BALLOONHAT"
msgid "I'm likely to get lightheaded from wearing it, hyuyuyu!"
msgstr "Podría usarlo con total liviandad, ¡jiu, ju!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.BALLOONPARTY
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.BALLOONPARTY"
msgid "A party! Am I invited?"
msgstr "¡Una fiesta! ¿Me invitaron?"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.BALLOONSPEED.DEFLATED
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.BALLOONSPEED.DEFLATED"
msgid "Its magic is spent."
msgstr "Se agotó su magia."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.BALLOONSPEED.GENERIC
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.BALLOONSPEED.GENERIC"
msgid "With this gift, I'll be more swift!"
msgstr "Con este regalo, seré veloz como un rayo."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.BALLOONS_EMPTY
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.BALLOONS_EMPTY"
msgid "Stores one's breath for later spells."
msgstr "Guarda el aliento para lanzar hechizos después."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.BALLOONVEST
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.BALLOONVEST"
msgid "A bright balloon vest to wear across my chest."
msgstr "Un colorido chaleco de globos para usar en el torso."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.BANANABUSH
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.BANANABUSH"
msgid "Hyuyu, little shrub, are you waving at me?"
msgstr "Jiu, ju, arbustito, ¿me estás saludando?"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.BANANAJUICE
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.BANANAJUICE"
msgid "Mortals will eat bananas in just about any form."
msgstr "Los mortales comen bananas en todas sus formas."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.BANANAPOP
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.BANANAPOP"
msgid "Hyuyu, what will the mortals think of next?"
msgstr "Jiu, ju, ¿qué más inventarán los mortales?"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.BANDAGE
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.BANDAGE"
msgid "A wrap for wounds."
msgstr "Una venda para las heridas."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.BARNACLE
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.BARNACLE"
msgid "A briny bunch of barnacles."
msgstr "Percibo un puñado de percebes."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.BARNACLEPITA
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.BARNACLEPITA"
msgid "Unless this pocket is filled with souls, I'll pass."
msgstr "A menos que esté relleno de almas, paso."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.BARNACLESTUFFEDFISHHEAD
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.BARNACLESTUFFEDFISHHEAD"
msgid "Hyuyu, no talking with your mouth full!"
msgstr "Jiu, ju, ¡no hables con la boca llena!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.BARNACLESUSHI
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.BARNACLESUSHI"
msgid "Perhaps one of the mortals will enjoy it."
msgstr "Quizá le guste a alguno de los mortales."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.BARNACLE_COOKED
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.BARNACLE_COOKED"
msgid "I'd rather not."
msgstr "Mejor no."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.BARNACLINGUINE
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.BARNACLINGUINE"
msgid "Oodles of fishy noodles."
msgstr "Una pila de pasta con pescado."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.BASALT
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.BASALT"
msgid "Big, big rock, for sure, for sure."
msgstr "Una roca grande grande. Está claro."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.BAT
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.BAT"
msgid "I'm quite batty myself! Hyuyu!"
msgstr "¡Un murciélago! ¿O era murciégalo? ¡Jiu, ju!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.BATBAT
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.BATBAT"
msgid "Extra batty!"
msgstr "¡Murciélago al máximo!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.BATCAVE
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.BATCAVE"
msgid "Where the bats lie in wait."
msgstr "Aquí esperan los murciélagos."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.BATHBOMB
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.BATHBOMB"
msgid "Sweetly stinking, bombs for bathing."
msgstr "Bombas para baño de asqueroso aroma."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.BATNOSE
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.BATNOSE"
msgid "Oh my, looks like somebody blew it."
msgstr "A alguien lo llevan de las narices."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.BATNOSEHAT
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.BATNOSEHAT"
msgid "What will the mortals cook up next."
msgstr "¿Qué más cocinarán los mortales?"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.BATNOSE_COOKED
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.BATNOSE_COOKED"
msgid "This smells! I think it's gone off!"
msgstr "¡Cómo huele! Creo que está podrida."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.BATTLESONG_CONTAINER
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.BATTLESONG_CONTAINER"
msgid "I've been told I can carry a tune."
msgstr "Me han dicho que canto bien."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.BATTLESONG_DURABILITY
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.BATTLESONG_DURABILITY"
msgid "Singing is good for the soul."
msgstr "Cantar hace bien al alma."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.BATTLESONG_FIRERESISTANCE
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.BATTLESONG_FIRERESISTANCE"
msgid "Singing is good for the soul."
msgstr "Cantar hace bien al alma."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.BATTLESONG_HEALTHGAIN
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.BATTLESONG_HEALTHGAIN"
msgid "Singing is good for the soul."
msgstr "Cantar hace bien al alma."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.BATTLESONG_INSTANT_PANIC
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.BATTLESONG_INSTANT_PANIC"
msgid "Oooh, yay! Are we putting on a play?"
msgstr "¡Viva! ¿Vamos a representar una obra de teatro?"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.BATTLESONG_INSTANT_REVIVE
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.BATTLESONG_INSTANT_REVIVE"
msgid "Singing is good for the soul."
msgstr "Cantar hace bien al alma."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.BATTLESONG_INSTANT_TAUNT
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.BATTLESONG_INSTANT_TAUNT"
msgid "Oooh, yay! Are we putting on a play?"
msgstr "¡Viva! ¿Vamos a representar una obra de teatro?"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.BATTLESONG_LUNARALIGNED
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.BATTLESONG_LUNARALIGNED"
msgid "Singing is good for the soul."
msgstr "Cantar hace bien al alma."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.BATTLESONG_SANITYAURA
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.BATTLESONG_SANITYAURA"
msgid "Singing is good for the soul."
msgstr "Cantar hace bien al alma."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.BATTLESONG_SANITYGAIN
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.BATTLESONG_SANITYGAIN"
msgid "Singing is good for the soul."
msgstr "Cantar hace bien al alma."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.BATTLESONG_SHADOWALIGNED
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.BATTLESONG_SHADOWALIGNED"
msgid "Singing is good for the soul."
msgstr "Cantar hace bien al alma."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.BATWING
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.BATWING"
msgid "Look at that! The wing of a bat."
msgstr "¡Mira eso! El ala de un murciélago."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.BATWING_COOKED
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.BATWING_COOKED"
msgid "Perhaps I'll find a hungry mortal to give it to."
msgstr "Tal vez encuentre un mortal hambriento para dársela."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.BEARDHAIR
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.BEARDHAIR"
msgid "Mortal fur."
msgstr "Pelo de mortal."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.BEARGER
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.BEARGER"
msgid "Do not eat me, oh please, oh please!"
msgstr "¡No me comas, por favor, por favor!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.BEARGERCORPSE.BURNING
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.BEARGERCORPSE.BURNING"
msgid "I'd love some toast to go with this roast!"
msgstr "Acompañaría ese asado con un pan tostado."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.BEARGERCORPSE.GENERIC
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.BEARGERCORPSE.GENERIC"
msgid "Hibernation? More like termination! Hyuyu!"
msgstr "¿Hibernación? ¡Más bien aniquilación! ¡Jiu, ju!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.BEARGERCORPSE.REVIVING
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.BEARGERCORPSE.REVIVING"
msgid "The brute is reviving. Who did the unaliving?"
msgstr "La bestia está reviviendo. ¿Quién hizo la desmorición?"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.BEARGERFUR_SACK
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.BEARGERFUR_SACK"
msgid "Is that where the mortals pack food away for the winter?"
msgstr "¿Aquí es donde los mortales guardan comida para el invierno?"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.BEARGERVEST
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.BEARGERVEST"
msgid "Sometimes you want to wear someone else's fur."
msgstr "A veces uno quiere ponerse en el pelaje de otro."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.BEARGER_FUR
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.BEARGER_FUR"
msgid "You won't be eating me today!"
msgstr "¡Hoy no me vas a comer!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.BEAST_BLUEPRINT
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.BEAST_BLUEPRINT"
msgid "Lucky, hm? Perhaps it's made with fairy gold."
msgstr "De la suerte, ¿eh? Quizá esté hecho de oro de hadas."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.BEDROLL_FURRY
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.BEDROLL_FURRY"
msgid "Fur upon fur!"
msgstr "¡Pelaje sobre pelaje!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.BEDROLL_STRAW
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.BEDROLL_STRAW"
msgid "To lay my sweet little head down."
msgstr "Para que repose mi dulce cabecita."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.BEE.GENERIC
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.BEE.GENERIC"
msgid "Buzz buzz buzz, tiny bee!"
msgstr "¡Zzzz, abejita, zzzz!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.BEE.HELD
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.BEE.HELD"
msgid "Careful now, little mortal."
msgstr "Ten cuidado, pequeña mortal."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.BEEBOX.BURNT
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.BEEBOX.BURNT"
msgid "Mayhaps it's caramelized within!"
msgstr "¡Quizás esté caramelizada por dentro!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.BEEBOX.FULLHONEY
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.BEEBOX.FULLHONEY"
msgid "So much honey! The mortals will be overjoyed!"
msgstr "¡Cuánta miel! ¡Los mortales se regocijarán!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.BEEBOX.GENERIC
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.BEEBOX.GENERIC"
msgid "A box full of bees would make a great prank."
msgstr "Una caja llena de abejas sería una broma estupenda."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.BEEBOX.NOHONEY
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.BEEBOX.NOHONEY"
msgid "Nothing inside but bees, oh yes!"
msgstr "¡Dentro solo hay abejas! ¡Sí!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.BEEBOX.READY
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.BEEBOX.READY"
msgid "So much honey! The mortals will be overjoyed!"
msgstr "¡Cuánta miel! ¡Los mortales se regocijarán!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.BEEBOX.SOMEHONEY
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.BEEBOX.SOMEHONEY"
msgid "We could scrape a bit of honey out."
msgstr "Podríamos sacarle un poco de miel."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.BEEBOX_HERMIT.BURNT
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.BEEBOX_HERMIT.BURNT"
msgid "Mayhaps it's caramelized within!"
msgstr "¡Quizás esté caramelizada por dentro!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.BEEBOX_HERMIT.FULLHONEY
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.BEEBOX_HERMIT.FULLHONEY"
msgid "So much honey! That crabby mortal might crack a smile!"
msgstr "¡Cuánta miel! ¡Esa cangreja mortal quizá sonría!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.BEEBOX_HERMIT.GENERIC
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.BEEBOX_HERMIT.GENERIC"
msgid "The whole hive is abuzz!"
msgstr "¡Toda la colmena zumba!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.BEEBOX_HERMIT.NOHONEY
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.BEEBOX_HERMIT.NOHONEY"
msgid "Nothing inside but bees, oh yes!"
msgstr "¡Dentro solo hay abejas! ¡Sí!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.BEEBOX_HERMIT.READY
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.BEEBOX_HERMIT.READY"
msgid "So much honey! That crabby mortal might crack a smile!"
msgstr "¡Cuánta miel! ¡Esa cangreja mortal quizá sonría!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.BEEBOX_HERMIT.SOMEHONEY
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.BEEBOX_HERMIT.SOMEHONEY"
msgid "We could scrape a bit of honey out."
msgstr "Podríamos sacarle un poco de miel."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.BEEFALO.DEAD
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.BEEFALO.DEAD"
msgid "Someone's ride has died."
msgstr "Murió el transporte de alguien."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.BEEFALO.DEAD_MYPARTNER
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.BEEFALO.DEAD_MYPARTNER"
msgid "Say it ain't so, m'fellow beefalo!"
msgstr "¡No me digas, mi querido bífalo!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.BEEFALO.DOMESTICATED
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.BEEFALO.DOMESTICATED"
msgid "I believe we've made a friend!"
msgstr "¡Creo que hicimos un amigo!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.BEEFALO.FOLLOWER
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.BEEFALO.FOLLOWER"
msgid "Hyuyu! Are we playing follow the leader?"
msgstr "¡Jiu, ju! ¿Estamos jugando a seguir al líder?"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.BEEFALO.GENERIC
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.BEEFALO.GENERIC"
msgid "Hello, hello, dear beefalo!"
msgstr "¡Hola, hola, querido bífalo!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.BEEFALO.MYPARTNER
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.BEEFALO.MYPARTNER"
msgid "We're kindred souls, wouldn't you say?"
msgstr "Somos almas afines, ¿no crees?"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.BEEFALO.NAKED
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.BEEFALO.NAKED"
msgid "Hyuyuyu! That's too good!"
msgstr "¡Jiu, ju, ju! ¡Qué bueno!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.BEEFALO.ORNERY
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.BEEFALO.ORNERY"
msgid "Don't you feel just hopping mad?"
msgstr "¿No te sientes loco de furia?"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.BEEFALO.PUDGY
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.BEEFALO.PUDGY"
msgid "Its soul is chubby too, hyuyu!"
msgstr "¡Su alma también es gordita, jiu, ju!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.BEEFALO.RIDER
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.BEEFALO.RIDER"
msgid "Don't you want to carry me?"
msgstr "¿No quieres llevarme?"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.BEEFALO.SLEEPING
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.BEEFALO.SLEEPING"
msgid "Shhh."
msgstr "Shhh."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.BEEFALOFEED
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.BEEFALOFEED"
msgid "It really sticks to the ribs, hyuyu!"
msgstr "¡Te deja bien relleno, jiu, ju!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.BEEFALOHAT
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.BEEFALOHAT"
msgid "Horn replacements."
msgstr "Repuestos de cuerno."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.BEEFALOTREAT
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.BEEFALOTREAT"
msgid "A beef so sweet deserves a treat."
msgstr "Un animal tan cariñoso merece algo sabroso."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.BEEFALOWOOL
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.BEEFALOWOOL"
msgid "Ex-beefalo."
msgstr "Exbífalo."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.BEEFALO_GROOMER.BURNT
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.BEEFALO_GROOMER.BURNT"
msgid "Hyuyuyu how silly!"
msgstr "¡Jiu, ju, ju! ¡Qué tontería!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.BEEFALO_GROOMER.GENERIC
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.BEEFALO_GROOMER.GENERIC"
msgid "I'll groom beefalo hair with my signature flair."
msgstr "Acicalaré a esta bestia para mejorar su presencia."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.BEEFALO_GROOMER.OCCUPIED
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.BEEFALO_GROOMER.OCCUPIED"
msgid "Fancy some fancying up? Hyuyu!"
msgstr "¿Quieres un cambio de look? ¡Jiu, ju!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.BEEFALO_GROOMER_ITEM
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.BEEFALO_GROOMER_ITEM"
msgid "Let's prepare to style beefalo hair!"
msgstr "Vamos a alistarnos para acicalarlo."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.BEEF_BELL
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.BEEF_BELL"
msgid "What a strange enchantment!"
msgstr "¡Qué encantamiento tan extraño!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.BEEGUARD
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.BEEGUARD"
msgid "Beeee gentle with me!"
msgstr "¡Ojo con ese aguijón!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.BEEHAT
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.BEEHAT"
msgid "What if my horns get stung?"
msgstr "¿Y si me pican los cuernos?"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.BEEHIVE
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.BEEHIVE"
msgid "One swift kick and it becomes a great prank."
msgstr "Una patadita y se convierte en una broma genial."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.BEEMINE
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.BEEMINE"
msgid "This will be a funny prank."
msgstr "Será una broma divertida."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.BEEMINE_MAXWELL
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.BEEMINE_MAXWELL"
msgid "That's not a funny prank at all!"
msgstr "¡No es una broma divertida, para nada!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.BEEQUEEN
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.BEEQUEEN"
msgid "Tweeheehe! You're a big bee!"
msgstr "¡Ji, ji, ji! ¡Eres una abejota!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.BEEQUEENHIVE.GENERIC
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.BEEQUEENHIVE.GENERIC"
msgid "My hooves would get stuck in it."
msgstr "Mis pezuñas se quedarían atrapadas."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.BEEQUEENHIVE.GROWING
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.BEEQUEENHIVE.GROWING"
msgid "Ooo, a new mystery!"
msgstr "¡Oooh, un misterio nuevo!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.BEEQUEENHIVEGROWN
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.BEEQUEENHIVEGROWN"
msgid "The mystery grows!"
msgstr "¡El misterio crece!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.BEESWAX
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.BEESWAX"
msgid "None of mine!"
msgstr "Que cera cera..."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.BEESWAX_SPRAY
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.BEESWAX_SPRAY"
msgid "A frightful fragrance for freezing flora!"
msgstr "¡Un aroma aterrador que congela la vegetación!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.BEETLETAUR
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.BEETLETAUR"
msgid "My oh my, you're a big guy!"
msgstr "¡Uy, mortal, sí que eres colosal!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.BELL
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.BELL"
msgid "I believe it might bring forth delight."
msgstr "La verdad es que podría traer felicidad."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.BERNIE_ACTIVE
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.BERNIE_ACTIVE"
msgid "Good sir, are you aware you've no soul?"
msgstr "Señor, ¿se da cuenta de que no tiene alma?"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.BERNIE_BIG
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.BERNIE_BIG"
msgid "It's grown to new heights to win all our fights!"
msgstr "¡Ha crecido bien alto para ganar nuestros asaltos!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.BERNIE_INACTIVE.BROKEN
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.BERNIE_INACTIVE.BROKEN"
msgid "He seemed a fine chap."
msgstr "Parecía buen tipo."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.BERNIE_INACTIVE.GENERIC
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.BERNIE_INACTIVE.GENERIC"
msgid "What a pity."
msgstr "Qué lástima."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.BERRIES
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.BERRIES"
msgid "A handful of mortal treats."
msgstr "Un puñado de frutas mortales."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.BERRIES_COOKED
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.BERRIES_COOKED"
msgid "I hear they last longer this way."
msgstr "Tengo entendido que duran más así."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.BERRIES_JUICY
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.BERRIES_JUICY"
msgid "Mortals eat them as a snack."
msgstr "Los mortales las comen como bocadillo."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.BERRIES_JUICY_COOKED
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.BERRIES_JUICY_COOKED"
msgid "I hear they last longer this way."
msgstr "Tengo entendido que duran más así."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.BERRYBUSH.BARREN
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.BERRYBUSH.BARREN"
msgid "It won't be returning to this plane."
msgstr "No volverá a este plano."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.BERRYBUSH.BURNING
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.BERRYBUSH.BURNING"
msgid "Whoops-a-doodle."
msgstr "Metí la pata."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.BERRYBUSH.DISEASED
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.BERRYBUSH.DISEASED"
msgid "Now it stinks really good!"
msgstr "¡Ahora sí que apesta!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.BERRYBUSH.DISEASING
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.BERRYBUSH.DISEASING"
msgid "It's started to stink."
msgstr "Empezó a apestar."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.BERRYBUSH.GENERIC
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.BERRYBUSH.GENERIC"
msgid "Mortals say they're sweet to eat."
msgstr "Los mortales dicen que son dulces."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.BERRYBUSH.PICKED
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.BERRYBUSH.PICKED"
msgid "Gone, all gone."
msgstr "No queda nada de nada."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.BERRYBUSH.WITHERED
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.BERRYBUSH.WITHERED"
msgid "Feeling down, are you?"
msgstr "Estás deprimido, ¿verdad?"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.BERRYBUSH_JUICY.BARREN
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.BERRYBUSH_JUICY.BARREN"
msgid "Salted earth, none will return."
msgstr "Tierra salada, no crecerá nada."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.BERRYBUSH_JUICY.BURNING
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.BERRYBUSH_JUICY.BURNING"
msgid "Whoops-a-doodle."
msgstr "Metí la pata."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.BERRYBUSH_JUICY.DISEASED
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.BERRYBUSH_JUICY.DISEASED"
msgid "Now it stinks really good!"
msgstr "¡Ahora sí que apesta!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.BERRYBUSH_JUICY.DISEASING
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.BERRYBUSH_JUICY.DISEASING"
msgid "It's started to stink."
msgstr "Empezó a apestar."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.BERRYBUSH_JUICY.GENERIC
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.BERRYBUSH_JUICY.GENERIC"
msgid "The humans like them, yes indeed."
msgstr "A los humanos les gustan, sip."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.BERRYBUSH_JUICY.PICKED
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.BERRYBUSH_JUICY.PICKED"
msgid "Gone, all gone."
msgstr "No queda nada de nada."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.BERRYBUSH_JUICY.WITHERED
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.BERRYBUSH_JUICY.WITHERED"
msgid "Feeling down, are you?"
msgstr "Estás deprimido, ¿verdad?"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.BERRYSAUCE
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.BERRYSAUCE"
msgid "Hyuyuyu, what a fun trick!"
msgstr "Jiu, ju, ¡qué truco más divertido!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.BIBINGKA
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.BIBINGKA"
msgid "I would've made a great Ani-ani."
msgstr "Yo habría sido un excelente ani-ani."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.BIGFOOT
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.BIGFOOT"
msgid "Do not step on little old me!"
msgstr "¡No me pises! ¡Soy chiquito!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.BIRCHNUTDRAKE
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.BIRCHNUTDRAKE"
msgid "Tiny forest children of hate!"
msgstr "¡Hijitos del odio del bosque!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.BIRDCAGE.DEAD
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.BIRDCAGE.DEAD"
msgid "It seems you went and met your end."
msgstr "Parece que pasaste a mejor vida."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.BIRDCAGE.GENERIC
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.BIRDCAGE.GENERIC"
msgid "A place where little birds are penned."
msgstr "Un lugar donde encierran a los pajaritos."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.BIRDCAGE.HUNGRY
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.BIRDCAGE.HUNGRY"
msgid "No worries, lunch is right around the bend."
msgstr "No te preocupes. El almuerzo está en camino."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.BIRDCAGE.OCCUPIED
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.BIRDCAGE.OCCUPIED"
msgid "Hello my singing, feathered friend."
msgstr "Hola, amigo cantarín emplumado."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.BIRDCAGE.SKELETON
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.BIRDCAGE.SKELETON"
msgid "I don't think she's exactly on the mend."
msgstr "No creo que se esté reponiendo."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.BIRDCAGE.SLEEPING
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.BIRDCAGE.SLEEPING"
msgid "No more sleepless nights you'll spend."
msgstr "Ya no pasarás más noches sin dormir."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.BIRDCAGE.STARVING
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.BIRDCAGE.STARVING"
msgid "Does no one have some seeds to lend?"
msgstr "¿Nadie me presta unas semillas?"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.BIRDTRAP
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.BIRDTRAP"
msgid "The birds will find this so funny!"
msgstr "¡A los pájaros les parecerá muy graciosa!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.BIRD_EGG
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.BIRD_EGG"
msgid "An egg from a bird, or so I've heard."
msgstr "Un huevo de un pájaro, o eso tengo entendido."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.BIRD_EGG_COOKED
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.BIRD_EGG_COOKED"
msgid "Probably a mortal thing."
msgstr "Debe ser una cosa mortal."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.BIRD_MUTANT
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.BIRD_MUTANT"
msgid "My my, you're looking rather pale!"
msgstr "Ay, ay, te veo bastante pálido."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.BIRD_MUTANT_SPITTER
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.BIRD_MUTANT_SPITTER"
msgid "This peculiar storm has changed its form."
msgstr "Esta tormenta peculiar le cambió su forma original."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.BISHOP
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.BISHOP"
msgid "You sure look mean, you nasty fiend!"
msgstr "¡Pareces muy malvado, demonio repugnante!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.BISHOP_CHARGE_HIT
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.BISHOP_CHARGE_HIT"
msgid "Hyuyu! Owie!"
msgstr "¡Jiu, ju! ¡Auch!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.BISHOP_NIGHTMARE
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.BISHOP_NIGHTMARE"
msgid "Eep! Play nice with the imp!"
msgstr "¡Ey, pillo! ¡No seas malo con el diablillo!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.BLACKFLAG
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.BLACKFLAG"
msgid "It's inspiring me to make a little mischief of my own."
msgstr "Me inspira a cometer algunas travesuras."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.BLOWDART_FIRE
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.BLOWDART_FIRE"
msgid "Ptt!"
msgstr "¡Ptt!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.BLOWDART_LAVA
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.BLOWDART_LAVA"
msgid "A gust of breath means flaming death!"
msgstr "¡Un soplido nada más y envuelto en llamas morirás!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.BLOWDART_LAVA2
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.BLOWDART_LAVA2"
msgid "A gust of breath means flaming death!"
msgstr "¡Un soplido nada más y envuelto en llamas morirás!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.BLOWDART_PIPE
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.BLOWDART_PIPE"
msgid "Ptoo!"
msgstr "¡Puf!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.BLOWDART_SLEEP
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.BLOWDART_SLEEP"
msgid "Pph!"
msgstr "¡Pffff!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.BLOWDART_YELLOW
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.BLOWDART_YELLOW"
msgid "Prrp!"
msgstr "¡Prrp!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.BLUEAMULET
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.BLUEAMULET"
msgid "The cold won't get through my chest tuft, hyuyu."
msgstr "El frío no me atraviesa el pelo del pecho, ¡jiu, ju!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.BLUEGEM
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.BLUEGEM"
msgid "Somber blue from seabeds grew."
msgstr "Surgió del mar un azul sin igual."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.BLUEMOONEYE
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.BLUEMOONEYE"
msgid "It's visible from any nook or crook."
msgstr "Es visible desde cualquier hueco o recoveco."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.BLUEPRINT.COMMON
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.BLUEPRINT.COMMON"
msgid "What knowledge will I find within?"
msgstr "¿Qué conocimientos hallaré en su interior?"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.BLUEPRINT.RARE
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.BLUEPRINT.RARE"
msgid "Ooo, secret knowledge, what fun, what power!"
msgstr "Oooh, conocimientos secretos. ¡Cuánta diversión y poder!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.BLUE_CAP
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.BLUE_CAP"
msgid "Funny tricks it tries to play."
msgstr "Intenta hacer trucos divertidos."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.BLUE_CAP_COOKED
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.BLUE_CAP_COOKED"
msgid "That changed it somehow."
msgstr "Eso lo cambió de alguna forma."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.BLUE_MUSHROOM.GENERIC
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.BLUE_MUSHROOM.GENERIC"
msgid "Found you!"
msgstr "¡Te encontré!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.BLUE_MUSHROOM.INGROUND
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.BLUE_MUSHROOM.INGROUND"
msgid "It's playing hide and seek!"
msgstr "¡Está jugando a las escondidas!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.BLUE_MUSHROOM.PICKED
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.BLUE_MUSHROOM.PICKED"
msgid "Gone, all gone."
msgstr "No queda nada de nada."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.BOARDS
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.BOARDS"
msgid "It's a board. How untoward!"
msgstr "Un tablón. ¡Qué decepción!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.BOARON
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.BOARON"
msgid "Who invited a pig to this shindig?"
msgstr "¿Quién invitó a un cerdo a la fiestita?"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.BOARRIOR
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.BOARRIOR"
msgid "Catch me if you can!"
msgstr "¡Atrápame si puedes!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.BOATFRAGMENT03
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.BOATFRAGMENT03"
msgid "Flotsam and jetsam, bits and bobs."
msgstr "Popa y proa, babor y estribor."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.BOATFRAGMENT04
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.BOATFRAGMENT04"
msgid "Flotsam and jetsam, bits and bobs."
msgstr "Popa y proa, babor y estribor."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.BOATFRAGMENT05
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.BOATFRAGMENT05"
msgid "Flotsam and jetsam, bits and bobs."
msgstr "Popa y proa, babor y estribor."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.BOATPATCH
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.BOATPATCH"
msgid "Plugging a hole sounds quite droll."
msgstr "Tapemos el hueco o el barco andará chueco."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.BOATPATCH_KELP
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.BOATPATCH_KELP"
msgid "This kelp should help!"
msgstr "¡Este algo hará alga! ¿O era al revés?"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.BOATRACE_CHECKPOINT
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.BOATRACE_CHECKPOINT"
msgid "There's a point in need of checking!"
msgstr "Un marcador de buena marca."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.BOATRACE_CHECKPOINT_THROWABLE_DEPLOYKIT
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.BOATRACE_CHECKPOINT_THROWABLE_DEPLOYKIT"
msgid "Where should I place the next stop for the race?"
msgstr "¿Dónde era la siguiente parada de la carrera?"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.BOATRACE_PRIMEMATE
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.BOATRACE_PRIMEMATE"
msgid "A challenger, I see. You won't catch me!"
msgstr "Un retador. No me atraparás, ¡no, señor!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.BOATRACE_SEASTACK
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.BOATRACE_SEASTACK"
msgid "Buoy ahoy!"
msgstr "¡Veo una boya!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.BOATRACE_SEASTACK_MONKEY
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.BOATRACE_SEASTACK_MONKEY"
msgid "Buoy ahoy!"
msgstr "¡Veo una boya!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.BOATRACE_SEASTACK_MONKEY_THROWABLE_DEPLOYKIT
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.BOATRACE_SEASTACK_MONKEY_THROWABLE_DEPLOYKIT"
msgid "Hyuyu, a bouncing baby buoy!"
msgstr "¡Jiu, ju! Una bonita boya boyando."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.BOATRACE_SEASTACK_THROWABLE_DEPLOYKIT
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.BOATRACE_SEASTACK_THROWABLE_DEPLOYKIT"
msgid "Hyuyu, a bouncing baby buoy!"
msgstr "¡Jiu, ju! Una bonita boya boyando."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.BOATRACE_SPECTATOR_DRAGONLING
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.BOATRACE_SPECTATOR_DRAGONLING"
msgid "Clap! Clap if you believe in me!"
msgstr "¡Palmas! ¡Aplaude si crees en mí!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.BOATRACE_START
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.BOATRACE_START"
msgid "The fun has just begun!"
msgstr "La diversión recién empieza."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.BOATRACE_START_THROWABLE_DEPLOYKIT
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.BOATRACE_START_THROWABLE_DEPLOYKIT"
msgid "Shall I get started?"
msgstr "¿Empiezo?"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.BOAT_ANCIENT_CONTAINER
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.BOAT_ANCIENT_CONTAINER"
msgid "To hide my prize from prying primate eyes."
msgstr "Para ocultar mi premio de esos primates de mal genio."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.BOAT_ANCIENT_ITEM
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.BOAT_ANCIENT_ITEM"
msgid "This old boat will surely float!"
msgstr "¡Este viejo barco flotará en cualquier charco!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.BOAT_BUMPER_CRABKING
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.BOAT_BUMPER_CRABKING"
msgid "A princely reward for a battle endured."
msgstr "Una recompensa principesca por la batalla que soportamos."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.BOAT_BUMPER_CRABKING_KIT
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.BOAT_BUMPER_CRABKING_KIT"
msgid "But idle hands are such good playthings!"
msgstr "¡Pero si el ocio es la madre de todas las virtudes!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.BOAT_BUMPER_KELP
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.BOAT_BUMPER_KELP"
msgid "Some friendly help from fronds of kelp."
msgstr "Una gran ayuda de estas algas hidalgas."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.BOAT_BUMPER_KELP_KIT
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.BOAT_BUMPER_KELP_KIT"
msgid "But idle hands are such good playthings!"
msgstr "¡Pero si el ocio es la madre de todas las virtudes!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.BOAT_BUMPER_SHELL
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.BOAT_BUMPER_SHELL"
msgid "We shell be well protected, hyuyu!"
msgstr "¡Estaremos acorazados, jiu, ju!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.BOAT_BUMPER_SHELL_KIT
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.BOAT_BUMPER_SHELL_KIT"
msgid "But idle hands are such good playthings!"
msgstr "¡Pero si el ocio es la madre de todas las virtudes!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.BOAT_BUMPER_YOTD
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.BOAT_BUMPER_YOTD"
msgid "Ever been bitten by a boat before?"
msgstr "¿Alguna vez te había mordido un barco?"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.BOAT_BUMPER_YOTD_KIT
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.BOAT_BUMPER_YOTD_KIT"
msgid "But idle hands are such good playthings!"
msgstr "¡Pero si el ocio es la madre de todas las virtudes!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.BOAT_CANNON.AMMOLOADED
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.BOAT_CANNON.AMMOLOADED"
msgid "Ready to fire and brimstone!"
msgstr "¡Listos para el fuego y el azufre!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.BOAT_CANNON.GENERIC
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.BOAT_CANNON.GENERIC"
msgid "Rounded stones are required for this cannon to fire."
msgstr "Para disparar una ronda, este cañón precisa piedras redondas."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.BOAT_CANNON.NOAMMO
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.BOAT_CANNON.NOAMMO"
msgid "This cannon cannot fire."
msgstr "Este cañón no puede disparar."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.BOAT_CANNON_KIT
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.BOAT_CANNON_KIT"
msgid "I'll build it quick, then put it on the ship."
msgstr "Lo construiré rapidito y lo pondré en el barquito."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.BOAT_GRASS_ITEM
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.BOAT_GRASS_ITEM"
msgid "This grass will pass for a boat, hyuyu!"
msgstr "¡Este césped parecerá un barco, jiu, ju!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.BOAT_ITEM
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.BOAT_ITEM"
msgid "Let's craft a raft!"
msgstr "¡Construyamos una balsa que no rebalsa!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.BOAT_LEAK
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.BOAT_LEAK"
msgid "Things look bleak - we have a leak!"
msgstr "La cosa se pone peliaguda, ¡tenemos una fuga!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.BOAT_MAGNET.ACTIVATED
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.BOAT_MAGNET.ACTIVATED"
msgid "I'll just sit back while it keeps me on track."
msgstr "Me quedaré tranquilo mientras me guía a mi destino."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.BOAT_MAGNET.GENERIC
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.BOAT_MAGNET.GENERIC"
msgid "Why would I row when I can be towed?"
msgstr "¿Para qué voy a remar si me pueden remolcar?"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.BOAT_MAGNET_BEACON.ACTIVATED
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.BOAT_MAGNET_BEACON.ACTIVATED"
msgid "It brought me here, so it must attract trouble, hyuyu!"
msgstr "Me trajo hasta aquí, así que atrae problemas, ¡jiu, ju!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.BOAT_MAGNET_BEACON.GENERIC
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.BOAT_MAGNET_BEACON.GENERIC"
msgid "Mortals come up with the funniest things."
msgstr "A los mortales se les ocurre cada cosa..."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.BOAT_MAGNET_KIT
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.BOAT_MAGNET_KIT"
msgid "The troubling toil never ends."
msgstr "La fatigosa faena nunca termina."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.BOAT_ROTATOR
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.BOAT_ROTATOR"
msgid "One good turn deserves another, hyuyu!"
msgstr "Habrá que poner un guiño si vamos a girar, ¡jiu, ju!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.BOAT_ROTATOR_KIT
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.BOAT_ROTATOR_KIT"
msgid "It's something or rudder!"
msgstr "Un timo grande, o sea un timón."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.BODYPILLOW_BEEFALOWOOL
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.BODYPILLOW_BEEFALOWOOL"
msgid "The beefiest pillow I ever did see."
msgstr "La almohada más bovina que he visto."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.BODYPILLOW_KELP
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.BODYPILLOW_KELP"
msgid "I'd never wish to sleep like a fish."
msgstr "No quiero dormir como un pez."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.BODYPILLOW_PETALS
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.BODYPILLOW_PETALS"
msgid "Armor doesn't often smell so nice!"
msgstr "¡Las armaduras no suelen oler tan bien!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.BODYPILLOW_STEELWOOL
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.BODYPILLOW_STEELWOOL"
msgid "A nasty thing, it'll do well in the ring!"
msgstr "Qué cosa espantosa para la lucha impiadosa."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.BOMB_LUNARPLANT
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.BOMB_LUNARPLANT"
msgid "This will be the start of some wonderful pranks."
msgstr "Esto será el comienzo de bromas maravillosas."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.BOMB_LUNARPLANT_WORMWOOD
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.BOMB_LUNARPLANT_WORMWOOD"
msgid "That plant has a mischievous streak after all, hyuyu!"
msgstr "¡Esta planta sí tiene una faceta traviesa después de todo, jiu, ju!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.BONESHARD
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.BONESHARD"
msgid "Fragmented, like my thoughts!"
msgstr "¡Está fragmentado, como mis pensamientos!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.BONESOUP
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.BONESOUP"
msgid "They spend all day cooking and then devour it in minutes."
msgstr "Se pasan el día cocinando y luego lo devoran todo en minutos."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.BONESTEW
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.BONESTEW"
msgid "Mortals like drinking goop like this."
msgstr "A los mortales les gusta beber estas porquerías."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.BOOKSTATION.BURNT
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.BOOKSTATION.BURNT"
msgid "What a shame, it went up in flames."
msgstr "Las llamas la carbonizaron. Me siento apenado."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.BOOKSTATION.GENERIC
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.BOOKSTATION.GENERIC"
msgid "Her entire collection for our inspection."
msgstr "Toda su colección disponible para la inspección."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.BOOK_BEES
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.BOOK_BEES"
msgid "I think I'll beekeeping my distance, hyuyu!"
msgstr "Prefiero mantenerme abejado, ¡jiu, ju!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.BOOK_BIRDS
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.BOOK_BIRDS"
msgid "Humans share their knowledge so freely."
msgstr "Los humanos comparten sus conocimientos muy abiertamente."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.BOOK_BRIMSTONE
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.BOOK_BRIMSTONE"
msgid "Who would leave such precious knowledge lying here?"
msgstr "¿Quién dejaría aquí conocimientos tan valiosos?"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.BOOK_ELEMENTAL
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.BOOK_ELEMENTAL"
msgid "Well, it won't summon an imp!"
msgstr "¡No podrá invocar a un diablillo!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.BOOK_FIRE
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.BOOK_FIRE"
msgid "We've no use for tomes from where I roam."
msgstr "Los tomos de mi hogar no sirven en este lugar."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.BOOK_FISH
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.BOOK_FISH"
msgid "This one's a bit fishy."
msgstr "Este es un poco escamoso."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.BOOK_FOSSIL
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.BOOK_FOSSIL"
msgid "Rock their socks off."
msgstr "Me dejó de piedra."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.BOOK_GARDENING
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.BOOK_GARDENING"
msgid "Secret knowledge of vegetables."
msgstr "Conocimiento secreto sobre vegetales."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.BOOK_HORTICULTURE
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.BOOK_HORTICULTURE"
msgid "Secret knowledge of vegetables."
msgstr "Conocimiento secreto sobre vegetales."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.BOOK_HORTICULTURE_UPGRADED
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.BOOK_HORTICULTURE_UPGRADED"
msgid "Always something to learn where gardens are concerned."
msgstr "Siempre se puede aprender novedades sobre el mundo de los vegetales."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.BOOK_LIGHT
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.BOOK_LIGHT"
msgid "Shall I sit and read for a spell?"
msgstr "¿Me siento a leer a ver si me aclara algo?"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.BOOK_LIGHT_UPGRADED
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.BOOK_LIGHT_UPGRADED"
msgid "It's quite heavy for a light book, hyuyu!"
msgstr "Es un poco oscuro para ser un libro sobre luz, ¡jiu, ju!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.BOOK_MOON
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.BOOK_MOON"
msgid "Hyuyuyu how cute! The mortals think they can hold sway over the moon!"
msgstr "¡Jiu, ju, ju! Qué ternura. Los mortales creen que pueden dominar la luna."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.BOOK_RAIN
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.BOOK_RAIN"
msgid "Mortals can take the fun out of anything."
msgstr "Los mortales le quitan la gracia a todo."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.BOOK_RESEARCH_STATION
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.BOOK_RESEARCH_STATION"
msgid "So much knowledge, and none of it forbidden!"
msgstr "¡Cuántos conocimientos, y ninguno prohibido!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.BOOK_SILVICULTURE
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.BOOK_SILVICULTURE"
msgid "Why not read it to the reeds? Hyuyuyu!"
msgstr "¿Se lo leemos juntos a los juncos? ¡Jiu, ju, ju!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.BOOK_SLEEP
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.BOOK_SLEEP"
msgid "Knowledge is power. Literally."
msgstr "El conocimiento es poder. Literalmente."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.BOOK_TEMPERATURE
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.BOOK_TEMPERATURE"
msgid "Hyuyuyu, mortals have such funny ideas."
msgstr "Jiu, ju, ju. Qué ideas raras tienen los mortales."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.BOOK_TENTACLES
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.BOOK_TENTACLES"
msgid "Imps don't disseminate precious knowledge so carelessly."
msgstr "Los diablillos no difunden los conocimientos valiosos tan descuidadamente."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.BOOK_WEB
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.BOOK_WEB"
msgid "Oh what a tangled web we read."
msgstr "Oh, qué telaraña más enmarañada leemos..."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.BOOMERANG
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.BOOMERANG"
msgid "What goes around comes around, they say, they say!"
msgstr "¡Dicen que todo vuelve! ¡Eso dicen!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.BOOTLEG
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.BOOTLEG"
msgid "Hyuyu! Who cobbled this together?"
msgstr "¡Jiu, ju! ¿Quién botó esta bota?"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.BROKEN_FORGEDITEM
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.BROKEN_FORGEDITEM"
msgid "This broken pile might still be worthwhile."
msgstr "Aunque esto esté roto, puede servir de algún modo."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.BRUSH
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.BRUSH"
msgid "Keeps imp chest tufts plush."
msgstr "El pelo del pecho de los diablillos queda precioso."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.BUGNET
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.BUGNET"
msgid "I'll bind those bugs."
msgstr "Esos bichos desgraciados quedarán atrapados."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.BULLKELP_PLANT.GENERIC
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.BULLKELP_PLANT.GENERIC"
msgid "And so it grows from out the sea."
msgstr "Y así crece en el mar."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.BULLKELP_PLANT.PICKED
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.BULLKELP_PLANT.PICKED"
msgid "The mortals picked it with such glee."
msgstr "Los mortales la recogen con alegría singular."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.BULLKELP_ROOT
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.BULLKELP_ROOT"
msgid "We plucked this whip from the side of the ship."
msgstr "Arrancamos este látigo del lateral del barco."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.BUNDLE
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.BUNDLE"
msgid "Does a nice surprise await inside?"
msgstr "¿Tiene una agradable sorpresa dentro?"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.BUNDLEWRAP
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.BUNDLEWRAP"
msgid "Bind all cursed objects!"
msgstr "¡Ata todos los objetos malditos!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.BUNNYMAN
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.BUNNYMAN"
msgid "You hop just like me!"
msgstr "¡Saltas como yo!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.BUNNYSTEW
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.BUNNYSTEW"
msgid "Are mortals attracted to this smell?"
msgstr "¿A los mortales les atrae este olor?"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.BURNT_MARSH_BUSH
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.BURNT_MARSH_BUSH"
msgid "Farewell, little bristles."
msgstr "Adiós, pequeñas púas."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.BUSHHAT
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.BUSHHAT"
msgid "Now you see me, now you don't! Hyuyu!"
msgstr "¡Ahora me ves, ahora no me ves! ¡Jiu, ju!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.BUTTER
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.BUTTER"
msgid "Essence of slipperiness."
msgstr "La esencia del deslizamiento."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.BUTTERFLY.GENERIC
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.BUTTERFLY.GENERIC"
msgid "Flutter, flutter, dearest butter!"
msgstr "Mariposa que se posa."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.BUTTERFLY.HELD
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.BUTTERFLY.HELD"
msgid "I'll try not to suck your soul out."
msgstr "Trataré de no chuparte el alma."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.BUTTERFLYMUFFIN
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.BUTTERFLYMUFFIN"
msgid "Muffin to see here, my dear."
msgstr "Qué pena, magdalena."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.BUTTERFLYWINGS
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.BUTTERFLYWINGS"
msgid "Fly away, sweet soul."
msgstr "Vete volando, dulce alma."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.BUZZARD
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.BUZZARD"
msgid "It doesn't want to feed on death. It just has to."
msgstr "No quiere alimentarse con la muerte, pero tiene que hacerlo."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.CABBAGEROLLS
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.CABBAGEROLLS"
msgid "They look so real!"
msgstr "¡Parecen tan reales!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.CACTUS.GENERIC
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.CACTUS.GENERIC"
msgid "Spiny and mean, just how I like them."
msgstr "Pinchudo y malo, como a mí me gustan."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.CACTUS.PICKED
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.CACTUS.PICKED"
msgid "To pick a cactus, you just need some prac-tus!"
msgstr "¡Para elegir un cactus, hay que tener mucho «tactus»!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.CACTUS_FLOWER
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.CACTUS_FLOWER"
msgid "How pretty! I fear to touch it."
msgstr "¡Qué bonito! Me da miedo tocarlo."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.CACTUS_MEAT
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.CACTUS_MEAT"
msgid "I don't want to eat anything prickly."
msgstr "No quiero comer nada que pinche."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.CACTUS_MEAT_COOKED
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.CACTUS_MEAT_COOKED"
msgid "The prickles are gone, but I still don't want to eat it."
msgstr "Ya no tiene pinchos, pero aun así no quiero comérmelo."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.CALIFORNIAROLL
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.CALIFORNIAROLL"
msgid "We're on a roll! Hyuyu!"
msgstr "¡No hay que enrollarse! ¡Jiu, ju!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.CAMPFIRE.EMBERS
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.CAMPFIRE.EMBERS"
msgid "Soon to extinguish."
msgstr "Pronto se extinguirá."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.CAMPFIRE.GENERIC
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.CAMPFIRE.GENERIC"
msgid "This fire will slake my thirst for warmth."
msgstr "Este fuego apagará mi sed de calor."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.CAMPFIRE.HIGH
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.CAMPFIRE.HIGH"
msgid "Those are some spicy flames."
msgstr "Qué llamas tan fieras."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.CAMPFIRE.LOW
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.CAMPFIRE.LOW"
msgid "It burns so low, so low!"
msgstr "¡Arde poco, muy poco!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.CAMPFIRE.NORMAL
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.CAMPFIRE.NORMAL"
msgid "When I roam, camp feels like home."
msgstr "Cuando salgo a rondar, el campamento es mi hogar."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.CAMPFIRE.OUT
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.CAMPFIRE.OUT"
msgid "And out it goes."
msgstr "Y se apagó."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.CANARY.GENERIC
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.CANARY.GENERIC"
msgid "Let's look out for each other, you and I."
msgstr "Cuidémonos el uno al otro, tú y yo."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.CANARY.HELD
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.CANARY.HELD"
msgid "Mind my paws now."
msgstr "Ten cuidado con mis zarpas."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.CANARY_POISONED
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.CANARY_POISONED"
msgid "Mortals don't usually look like that."
msgstr "Los mortales no suelen verse así."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.CANDYBAG
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.CANDYBAG"
msgid "It's a Wortox Sack!"
msgstr "¡Es una bolsa de Wortox!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.CANE
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.CANE"
msgid "Is it walking me, or am I walking it?"
msgstr "¿El bastón me lleva? ¿O yo lo llevo?"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.CANNONBALL_ROCK_ITEM
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.CANNONBALL_ROCK_ITEM"
msgid "Oh what a sinking feeling it brings!"
msgstr "¡Genera una sensación de pesadez!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.CARNIVALCANNON.COOLDOWN
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.CARNIVALCANNON.COOLDOWN"
msgid "Hyuyuyu, what fun!"
msgstr "Jiu, ju, ju, ¡qué divertido!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.CARNIVALCANNON.GENERIC
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.CARNIVALCANNON.GENERIC"
msgid "Oh the pranks I could pull with this!"
msgstr "¡Oh, cuántas bromas podría hacer con esto!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.CARNIVALCANNON_KIT
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.CARNIVALCANNON_KIT"
msgid "Let's start things off with a bang, shall we? Hyuyuyu!"
msgstr "Arrancamos con un estallido, ¿no? ¡Jiu, ju, ju!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.CARNIVALDECOR_BANNER
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.CARNIVALDECOR_BANNER"
msgid "Is that the glint of fairy gold?"
msgstr "¿Es el brillo del oro de hadas?"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.CARNIVALDECOR_BANNER_KIT
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.CARNIVALDECOR_BANNER_KIT"
msgid "Nearly there."
msgstr "Ya casi."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.CARNIVALDECOR_EGGRIDE
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.CARNIVALDECOR_EGGRIDE"
msgid "On and on and on it goes!"
msgstr "¡Dale que va!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.CARNIVALDECOR_EGGRIDE_KIT
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.CARNIVALDECOR_EGGRIDE_KIT"
msgid "Nearly there."
msgstr "Ya casi."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.CARNIVALDECOR_FIGURE.GENERIC
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.CARNIVALDECOR_FIGURE.GENERIC"
msgid "Mortals do love their trinkets."
msgstr "A los mortales les encantan los objetos."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.CARNIVALDECOR_FIGURE.RARE
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.CARNIVALDECOR_FIGURE.RARE"
msgid "The rarest of trinkets!"
msgstr "¡El objeto menos común!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.CARNIVALDECOR_FIGURE.UNCOMMON
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.CARNIVALDECOR_FIGURE.UNCOMMON"
msgid "Hyuyu, a fine find indeed!"
msgstr "¡Jiu, ju! ¡Qué buen hallazgo!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.CARNIVALDECOR_FIGURE_KIT
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.CARNIVALDECOR_FIGURE_KIT"
msgid "Hyuyu, how very mysterious!"
msgstr "¡Jiu, ju! Qué misterio."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.CARNIVALDECOR_FIGURE_KIT_SEASON2
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.CARNIVALDECOR_FIGURE_KIT_SEASON2"
msgid "Hyuyu, how very mysterious!"
msgstr "¡Jiu, ju! Qué misterio."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.CARNIVALDECOR_LAMP
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.CARNIVALDECOR_LAMP"
msgid "A fairy light to glow in the night."
msgstr "Una luz de hadas que ilumina la velada."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.CARNIVALDECOR_LAMP_KIT
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.CARNIVALDECOR_LAMP_KIT"
msgid "Nearly there."
msgstr "Ya casi."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.CARNIVALDECOR_PLANT
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.CARNIVALDECOR_PLANT"
msgid "We can take a small bit of the Cawnival wherever we go."
msgstr "Podemos llevarnos una partecita del Graznaval con nosotros."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.CARNIVALDECOR_PLANT_KIT
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.CARNIVALDECOR_PLANT_KIT"
msgid "Nearly there."
msgstr "Ya casi."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.CARNIVALFOOD_CORNTEA
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.CARNIVALFOOD_CORNTEA"
msgid "I think I'll go find a nice refreshing soul instead."
msgstr "Prefiero buscar una buena alma refrescante."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.CARNIVALGAME_FEEDCHICKS_FOOD
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.CARNIVALGAME_FEEDCHICKS_FOOD"
msgid "Imagine what a fun prank it would be to replace these with real worms..."
msgstr "Sería una broma divertidísima cambiarlos por gusanos de verdad."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.CARNIVALGAME_FEEDCHICKS_KIT
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.CARNIVALGAME_FEEDCHICKS_KIT"
msgid "We're almost ready for the fun to begin!"
msgstr "¡Estamos casi listos para que empiece la diversión!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.CARNIVALGAME_FEEDCHICKS_NEST
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.CARNIVALGAME_FEEDCHICKS_NEST"
msgid "A small trap door is set in the floor."
msgstr "Diviso una puertita en el piso."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.CARNIVALGAME_FEEDCHICKS_STATION.GENERIC
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.CARNIVALGAME_FEEDCHICKS_STATION.GENERIC"
msgid "Allow me to propose a trade: one shiny trinket to play your game."
msgstr "Propongo un trato en este instante: jugar a cambio de una ficha brillante."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.CARNIVALGAME_FEEDCHICKS_STATION.PLAYING
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.CARNIVALGAME_FEEDCHICKS_STATION.PLAYING"
msgid "You must be quick to feed the chicks."
msgstr "Para alimentar a los pollitos, hay que moverse rapidito."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.CARNIVALGAME_HERDING_CHICK
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.CARNIVALGAME_HERDING_CHICK"
msgid "To the center, if you please."
msgstr "Hacia el centro, por favor."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.CARNIVALGAME_HERDING_KIT
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.CARNIVALGAME_HERDING_KIT"
msgid "We're almost ready for the fun to begin!"
msgstr "¡Estamos casi listos para que empiece la diversión!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.CARNIVALGAME_HERDING_STATION.GENERIC
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.CARNIVALGAME_HERDING_STATION.GENERIC"
msgid "Allow me to propose a trade: one shiny trinket to play your game."
msgstr "Propongo un trato en este instante: jugar a cambio de una ficha brillante."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.CARNIVALGAME_HERDING_STATION.PLAYING
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.CARNIVALGAME_HERDING_STATION.PLAYING"
msgid "It's quite fun, or so I herd. Hyuyuyu!"
msgstr "¡Qué divertido! Quiero jugar de huevo. ¡Jiu, ju, ju!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.CARNIVALGAME_MEMORY_CARD.GENERIC
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.CARNIVALGAME_MEMORY_CARD.GENERIC"
msgid "A small trap door is set in the floor."
msgstr "Diviso una puertita en el piso."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.CARNIVALGAME_MEMORY_CARD.PLAYING
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.CARNIVALGAME_MEMORY_CARD.PLAYING"
msgid "This one or that one?"
msgstr "¿Esa o aquella?"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.CARNIVALGAME_MEMORY_KIT
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.CARNIVALGAME_MEMORY_KIT"
msgid "We're almost ready for the fun to begin!"
msgstr "¡Estamos casi listos para que empiece la diversión!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.CARNIVALGAME_MEMORY_STATION.GENERIC
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.CARNIVALGAME_MEMORY_STATION.GENERIC"
msgid "Allow me to propose a trade: one shiny trinket to play your game."
msgstr "Propongo un trato en este instante: jugar a cambio de una ficha brillante."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.CARNIVALGAME_MEMORY_STATION.PLAYING
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.CARNIVALGAME_MEMORY_STATION.PLAYING"
msgid "This game is sure to test one's brain."
msgstr "Este juego es un desafío para el cerebro."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.CARNIVALGAME_PUCKDROP_KIT
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.CARNIVALGAME_PUCKDROP_KIT"
msgid "We're almost ready for the fun to begin!"
msgstr "¡Estamos casi listos para que empiece la diversión!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.CARNIVALGAME_PUCKDROP_STATION.GENERIC
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.CARNIVALGAME_PUCKDROP_STATION.GENERIC"
msgid "Allow me to propose a trade: one shiny trinket to play your game."
msgstr "Propongo un trato en este instante: jugar a cambio de una ficha brillante."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.CARNIVALGAME_PUCKDROP_STATION.PLAYING
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.CARNIVALGAME_PUCKDROP_STATION.PLAYING"
msgid "There goes the ball, where will it fall?"
msgstr "Ahí va la bola. ¿Adónde caerá ahora?"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.CARNIVALGAME_SHOOTING_BUTTON.GENERIC
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.CARNIVALGAME_SHOOTING_BUTTON.GENERIC"
msgid "Allow me to propose a trade: one shiny trinket to play your game."
msgstr "Propongo un trato en este instante: jugar a cambio de una ficha brillante."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.CARNIVALGAME_SHOOTING_BUTTON.PLAYING
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.CARNIVALGAME_SHOOTING_BUTTON.PLAYING"
msgid "Hyuyuyu! What does it do?"
msgstr "¡Jiu, ju, ju! ¿Para qué sirve?"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.CARNIVALGAME_SHOOTING_KIT
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.CARNIVALGAME_SHOOTING_KIT"
msgid "We're almost ready for the fun to begin!"
msgstr "¡Estamos casi listos para que empiece la diversión!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.CARNIVALGAME_SHOOTING_STATION.GENERIC
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.CARNIVALGAME_SHOOTING_STATION.GENERIC"
msgid "Allow me to propose a trade: one shiny trinket to play your game."
msgstr "Propongo un trato en este instante: jugar a cambio de una ficha brillante."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.CARNIVALGAME_SHOOTING_STATION.PLAYING
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.CARNIVALGAME_SHOOTING_STATION.PLAYING"
msgid "For this merry game, squashing bugs is the aim."
msgstr "En este juego divertido, aplastar bichos es el objetivo."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.CARNIVALGAME_SHOOTING_TARGET.GENERIC
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.CARNIVALGAME_SHOOTING_TARGET.GENERIC"
msgid "A small trap door is set in the floor."
msgstr "Diviso una puertita en el piso."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.CARNIVALGAME_SHOOTING_TARGET.PLAYING
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.CARNIVALGAME_SHOOTING_TARGET.PLAYING"
msgid "I can't rest until I finish those pests!"
msgstr "No estaré tranquilo hasta que no aplaste esos bichos."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.CARNIVALGAME_WHEELSPIN_KIT
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.CARNIVALGAME_WHEELSPIN_KIT"
msgid "We're almost ready for the fun to begin!"
msgstr "¡Estamos casi listos para que empiece la diversión!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.CARNIVALGAME_WHEELSPIN_STATION.GENERIC
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.CARNIVALGAME_WHEELSPIN_STATION.GENERIC"
msgid "Allow me to propose a trade: one shiny trinket to play your game."
msgstr "Propongo un trato en este instante: jugar a cambio de una ficha brillante."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.CARNIVALGAME_WHEELSPIN_STATION.PLAYING
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.CARNIVALGAME_WHEELSPIN_STATION.PLAYING"
msgid "It's easy to win, just give it a spin!"
msgstr "¡Es fácil ganar, soy hay que hacerla girar!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.CARNIVAL_BALL
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.CARNIVAL_BALL"
msgid "It goes quite nicely with my fur!"
msgstr "Combina con mi pelaje."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.CARNIVAL_CROWKID
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.CARNIVAL_CROWKID"
msgid "Hyuyu, so nice to see these fine folk out and about!"
msgstr "¡Jiu, ju! Qué lindo ver a esta buena gente de paseo."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.CARNIVAL_GAMETOKEN
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.CARNIVAL_GAMETOKEN"
msgid "Who could resist such a shiny trinket?"
msgstr "¿Quién podría resistirle a un objeto tan brillante?"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.CARNIVAL_HOST
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.CARNIVAL_HOST"
msgid "How now, spirit? Whither wander you?"
msgstr "¡Buenos días! No vas a sacarme los ojos, ¿no?"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.CARNIVAL_PLAZA.GENERIC
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.CARNIVAL_PLAZA.GENERIC"
msgid "This place could use some sprucing up, don't you think?"
msgstr "Este lugar necesita un poco de decoración, ¿no?"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.CARNIVAL_PLAZA.LEVEL_2
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.CARNIVAL_PLAZA.LEVEL_2"
msgid "It's fine, but this place could use more sparkle and shine."
msgstr "No está mal, pero necesita más resplandor y esplendor."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.CARNIVAL_PLAZA.LEVEL_3
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.CARNIVAL_PLAZA.LEVEL_3"
msgid "Fittingly fancified for our fine feathered friends."
msgstr "La hemos ornamentado para nuestros amigos emplumados."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.CARNIVAL_PLAZA_KIT
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.CARNIVAL_PLAZA_KIT"
msgid "Now if I were a crow, where would I think it should go?"
msgstr "Si fuera un cuervo, ¿adónde pensaría que debería poner esto?"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.CARNIVAL_PRIZEBOOTH.GENERIC
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.CARNIVAL_PRIZEBOOTH.GENERIC"
msgid "What to choose, what to choose..."
msgstr "¿Qué elijo? ¿Qué elijo...?"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.CARNIVAL_PRIZEBOOTH_KIT
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.CARNIVAL_PRIZEBOOTH_KIT"
msgid "What kind of goodies will it have, I wonder?"
msgstr "¿Qué clase de regalitos tendrá?"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.CARNIVAL_PRIZETICKET.GENERIC
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.CARNIVAL_PRIZETICKET.GENERIC"
msgid "One ticket please, hyuyu!"
msgstr "¡Un boleto, por favor! ¡Jiu, ju!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.CARNIVAL_PRIZETICKET.GENERIC_LARGESTACK
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.CARNIVAL_PRIZETICKET.GENERIC_LARGESTACK"
msgid "I can almost see the prize before my eyes."
msgstr "¡Casi veo el premio frente a mis ojos!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.CARNIVAL_PRIZETICKET.GENERIC_SMALLSTACK
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.CARNIVAL_PRIZETICKET.GENERIC_SMALLSTACK"
msgid "A pretty pile of prize tickets."
msgstr "Un maravilloso montón de boletos de premios."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.CARNIVAL_SEEDPACKET
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.CARNIVAL_SEEDPACKET"
msgid "I'm sure they won't be offended if I dump these on the ground."
msgstr "Seguro que no se ofenderán si las arrojo al suelo."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.CARNIVAL_VEST_A
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.CARNIVAL_VEST_A"
msgid "I'm quite partial to the style."
msgstr "Este estilo me agrada bastante."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.CARNIVAL_VEST_B
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.CARNIVAL_VEST_B"
msgid "A cloak of leaves to drape around my impish frame."
msgstr "Una capa de hojas para envolverme el cuerpo de diablillo."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.CARNIVAL_VEST_C
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.CARNIVAL_VEST_C"
msgid "Short and sweet, hyuyu!"
msgstr "Cortita es más bonita, ¡jiu, ju!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.CARPENTRY_BLADE_MOONGLASS
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.CARPENTRY_BLADE_MOONGLASS"
msgid "But what does it cut?"
msgstr "¿Pero qué corta?"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.CARPENTRY_STATION.BURNT
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.CARPENTRY_STATION.BURNT"
msgid "Who misunderstood it would be good to build it all of wood?"
msgstr "¿Quién tuvo la pésima idea de construir todo de madera?"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.CARPENTRY_STATION.GENERIC
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.CARPENTRY_STATION.GENERIC"
msgid "The mortal need to feel productive, if I may be so reductive."
msgstr "Los mortales necesitan sentirse productivos, siempre digo."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.CARRAT.DEAD
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.CARRAT.DEAD"
msgid "Ding-dong, the carrot's dead."
msgstr "Ding, dong. La zanahoria se murió."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.CARRAT.GENERIC
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.CARRAT.GENERIC"
msgid "Does it have a soul, one wonders?"
msgstr "Uno se pregunta si tendrá alma."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.CARRAT.HELD
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.CARRAT.HELD"
msgid "Hello hello, strange orange soul."
msgstr "Hola, hola, extraña alma naranja."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.CARRAT.SLEEPING
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.CARRAT.SLEEPING"
msgid "Good night, sleep tight, don't let the humans bite."
msgstr "Que duermas bien y que no sueñes con los humanitos."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.CARRAT_GHOSTRACER
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.CARRAT_GHOSTRACER"
msgid "I had a feeling she liked to play games too, hyuyu!"
msgstr "Me parecía que a ella también le gustaba jugar, ¡jiu, ju!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.CARROT
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.CARROT"
msgid "Non-imps like to eat things like this."
msgstr "A los que no son diablillos les gusta comer estas cosas."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.CARROT_COOKED
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.CARROT_COOKED"
msgid "I think non-imps like it better cooked."
msgstr "Creo que los que no son diablillos las prefieren asadas."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.CARROT_OVERSIZED
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.CARROT_OVERSIZED"
msgid "I suppose the mortals might enjoy something like that."
msgstr "Supongo que a los mortales podría gustarle."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.CARROT_PLANTED
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.CARROT_PLANTED"
msgid "There's a plant underneath."
msgstr "Hay una planta debajo."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.CARROT_SEEDS
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.CARROT_SEEDS"
msgid "Grow a seed and you shall feed!"
msgstr "¡Planta una semilla y tendrás buena comida!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.CARTOGRAPHYDESK.BURNING
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.CARTOGRAPHYDESK.BURNING"
msgid "Someone's been up to some mischief."
msgstr "Alguien ha estado haciendo travesuras."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.CARTOGRAPHYDESK.BURNT
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.CARTOGRAPHYDESK.BURNT"
msgid "That's all she wrote."
msgstr "Sanseacabó."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.CARTOGRAPHYDESK.GENERIC
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.CARTOGRAPHYDESK.GENERIC"
msgid "I could make maps to anywhere and nowhere."
msgstr "Podría hacer mapas a cualquier parte y a ninguna parte."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.CATCOON
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.CATCOON"
msgid "I prefer playing with smarter mortals."
msgstr "Prefiero jugar con mortales más inteligentes."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.CATCOONDEN.EMPTY
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.CATCOONDEN.EMPTY"
msgid "Yoohoo! Anybody home?"
msgstr "¡Yuju! ¿Hay alguien en casa?"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.CATCOONDEN.GENERIC
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.CATCOONDEN.GENERIC"
msgid "A home for friends."
msgstr "Una casa para los amigos."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.CATCOONHAT
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.CATCOONHAT"
msgid "It's a stripey horn concealer."
msgstr "Un escondecuernos a rayas."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.CATTOY_MOUSE
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.CATTOY_MOUSE"
msgid "Wind the bobbin up, pull, pull!"
msgstr "Cinco ratoncitos vi, bailando bien el twist."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.CAVEIN_BOULDER.GENERIC
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.CAVEIN_BOULDER.GENERIC"
msgid "I could move it if I pleased!"
msgstr "¡Podría moverlo si quisiera!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.CAVEIN_BOULDER.RAISED
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.CAVEIN_BOULDER.RAISED"
msgid "A hop, skip and a jump too far!"
msgstr "¡Un brinco y un salto, y llegaremos muy lejos!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.CAVE_BANANA
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.CAVE_BANANA"
msgid "One of the least offensive mortal food flavors."
msgstr "Uno de los sabores de comida de mortales menos asquerosos."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.CAVE_BANANA_BURNT
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.CAVE_BANANA_BURNT"
msgid "I don't think anyone wants it now."
msgstr "No creo que nadie la quiera ahora."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.CAVE_BANANA_COOKED
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.CAVE_BANANA_COOKED"
msgid "It's cooked now."
msgstr "Ahora está cocinada."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.CAVE_BANANA_TREE
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.CAVE_BANANA_TREE"
msgid "What do I see? An underground tree!"
msgstr "¿Adónde mis pasos me llevan? ¡A un árbol en una cueva!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.CAVE_ENTRANCE
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.CAVE_ENTRANCE"
msgid "Clear the way I say!"
msgstr "¡Despeja el camino, he dicho!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.CAVE_ENTRANCE_OPEN.FULL
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.CAVE_ENTRANCE_OPEN.FULL"
msgid "A party rages down below!"
msgstr "¡Abajo hay una fiesta!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.CAVE_ENTRANCE_OPEN.GENERIC
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.CAVE_ENTRANCE_OPEN.GENERIC"
msgid "No spelunking for this little imp!"
msgstr "¡A este diablillo no le gusta la espeleología!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.CAVE_ENTRANCE_OPEN.OPEN
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.CAVE_ENTRANCE_OPEN.OPEN"
msgid "Away I go, hyuyu!"
msgstr "¡Me largo, jiu, ju!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.CAVE_ENTRANCE_RUINS
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.CAVE_ENTRANCE_RUINS"
msgid "Let me have a peek inside!"
msgstr "¡Déjenme echar un vistazo dentro!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.CAVE_EXIT.FULL
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.CAVE_EXIT.FULL"
msgid "A party rages up above!"
msgstr "¡Arriba hay una fiesta!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.CAVE_EXIT.GENERIC
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.CAVE_EXIT.GENERIC"
msgid "I like it here in the deep dark."
msgstr "Me gusta la oscuridad profunda."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.CAVE_EXIT.OPEN
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.CAVE_EXIT.OPEN"
msgid "Away I go, hyuyu!"
msgstr "¡Me largo, jiu, ju!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.CAVE_FERN
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.CAVE_FERN"
msgid "It prefers the dark."
msgstr "Prefiere la oscuridad."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.CEVICHE
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.CEVICHE"
msgid "I'd rather leave this for the humans."
msgstr "Prefiero dejárselo a los humanos."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.CHARCOAL
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.CHARCOAL"
msgid "Pre-burnt tree."
msgstr "Un árbol prequemado."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.CHARLIERESIDUE
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.CHARLIERESIDUE"
msgid "only_used_by_winona"
msgstr "only_used_by_winona"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.CHARLIEROSE
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.CHARLIEROSE"
msgid "only_used_by_winona"
msgstr "only_used_by_winona"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.CHARLIE_HAND
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.CHARLIE_HAND"
msgid "It seeks a stone of dread."
msgstr "Busca una piedra tétrica."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.CHARLIE_HECKLER
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.CHARLIE_HECKLER"
msgid "Hyuyu, what a funny pair!"
msgstr "¡Jiu, ju! ¡Qué risa esos dos!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.CHARLIE_LECTURN
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.CHARLIE_LECTURN"
msgid "Hmm, what part to play today?"
msgstr "Mmm, ¿qué papel representaré hoy?"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.CHARLIE_NPC
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.CHARLIE_NPC"
msgid "The Shadow Queen is finally seen!"
msgstr "¡La Reina de las Sombras al fin se asoma!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.CHARLIE_STAGE_POST
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.CHARLIE_STAGE_POST"
msgid "What a treat, a front-row seat!"
msgstr "¡Qué maravilla! Un asiento en la primera fila."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.CHESSJUNK1
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.CHESSJUNK1"
msgid "It looks quite broke, and that's no joke!"
msgstr "Parece bastante rota y lo digo sin sorna."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.CHESSJUNK2
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.CHESSJUNK2"
msgid "It looks quite broke, and that's no joke!"
msgstr "Parece bastante rota y lo digo sin sorna."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.CHESSJUNK3
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.CHESSJUNK3"
msgid "It looks quite broke, and that's no joke!"
msgstr "Parece bastante rota y lo digo sin sorna."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.CHESSPIECE_ANCHOR
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.CHESSPIECE_ANCHOR"
msgid "So heavy, heavy, dreary, dreary."
msgstr "Pesa tanto tanto y es tan tan deprimente."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.CHESSPIECE_ANTLION
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.CHESSPIECE_ANTLION"
msgid "An anti Ant Lion, formerly furry. Hyuyu!"
msgstr "¿Es de hormigón armado? ¡Jiu, ju!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.CHESSPIECE_BEARGER
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.CHESSPIECE_BEARGER"
msgid "I'll say a prayer for this slain bear."
msgstr "Rezaré un poco por este pobre oso."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.CHESSPIECE_BEARGER_MUTATED
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.CHESSPIECE_BEARGER_MUTATED"
msgid "It bears a strong resemblance."
msgstr "Es igual de espant-oso."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.CHESSPIECE_BEEFALO
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.CHESSPIECE_BEEFALO"
msgid "This beefalo is even more hard-headed than most!"
msgstr "Este bífalo es más cabeza dura que los otros."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.CHESSPIECE_BEEQUEEN
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.CHESSPIECE_BEEQUEEN"
msgid "Stationary majesty. Static insect."
msgstr "Insecto inmóvil. Soberbia soberana."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.CHESSPIECE_BISHOP.GENERIC
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.CHESSPIECE_BISHOP.GENERIC"
msgid "Bishop made of polished stone."
msgstr "Un alfil de piedra pulida."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.CHESSPIECE_BISHOP.STRUGGLE
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.CHESSPIECE_BISHOP.STRUGGLE"
msgid "Yes, yes, come play!"
msgstr "¡Sí, sí, ven a jugar!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.CHESSPIECE_BUTTERFLY
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.CHESSPIECE_BUTTERFLY"
msgid "It does not float, nor does it sting."
msgstr "Ni flota, ni pica."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.CHESSPIECE_CARRAT
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.CHESSPIECE_CARRAT"
msgid "Not so light on its feet now, hyuyu!"
msgstr "Ahora ya no es tan ágil, ¡jiu, ju!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.CHESSPIECE_CATCOON
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.CHESSPIECE_CATCOON"
msgid "This little guy and I don't see eye to eye, hyuyu."
msgstr "Nunca me pongo de acuerdo con este sujeto, ¡jiu, ju!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.CHESSPIECE_CLAYHOUND
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.CHESSPIECE_CLAYHOUND"
msgid "A clay hound made from that sketch we found!"
msgstr "¡Un sabueso de barro hecho con ese boceto que encontramos!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.CHESSPIECE_CLAYWARG
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.CHESSPIECE_CLAYWARG"
msgid "So scary, rendered still in stone."
msgstr "Qué miedo da así, inmóvil en la piedra."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.CHESSPIECE_CRABKING
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.CHESSPIECE_CRABKING"
msgid "He was better at sinking than being a sea king."
msgstr "Tenía más talento para naufragar que para reinar."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.CHESSPIECE_DAYWALKER
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.CHESSPIECE_DAYWALKER"
msgid "A boorish boar's bust!"
msgstr "Un busto baladí de un jabalí."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.CHESSPIECE_DAYWALKER2
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.CHESSPIECE_DAYWALKER2"
msgid "The hog heaved through heaps of junk."
msgstr ""

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.CHESSPIECE_DEERCLOPS
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.CHESSPIECE_DEERCLOPS"
msgid "That was such a fun day!"
msgstr "¡Fue un día tan divertido!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.CHESSPIECE_DEERCLOPS_MUTATED
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.CHESSPIECE_DEERCLOPS_MUTATED"
msgid "She got quite the eyeful."
msgstr "Le hicieron el mal de ojo."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.CHESSPIECE_DRAGONFLY
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.CHESSPIECE_DRAGONFLY"
msgid "Bye bye, dear dragonfly."
msgstr "Chau, chau, querida libélula."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.CHESSPIECE_EYEOFTERROR
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.CHESSPIECE_EYEOFTERROR"
msgid "He's gone, no matter how you look at it, hyuyu!"
msgstr "Desapareció desde todo punto de vista, ¡jiu, ju!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.CHESSPIECE_FORMAL
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.CHESSPIECE_FORMAL"
msgid "You've a much too competitive spirit, sir."
msgstr "Tiene un espíritu demasiado competitivo, señor."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.CHESSPIECE_GUARDIANPHASE3
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.CHESSPIECE_GUARDIANPHASE3"
msgid "In all its selenic splendour!"
msgstr "¡Con todo su esplendor selénico!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.CHESSPIECE_HORNUCOPIA
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.CHESSPIECE_HORNUCOPIA"
msgid "What a funny use for a horn!"
msgstr "¡Qué uso tan divertido para un cuerno!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.CHESSPIECE_KITCOON
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.CHESSPIECE_KITCOON"
msgid "They'll reach the sky on high!"
msgstr "Se eleva tan alto que llegaría al cielo con un salto."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.CHESSPIECE_KLAUS
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.CHESSPIECE_KLAUS"
msgid "A stagnant stag."
msgstr "«Asta» aquí llegó."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.CHESSPIECE_KNIGHT.GENERIC
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.CHESSPIECE_KNIGHT.GENERIC"
msgid "Let's play a game, you and I!"
msgstr "¡Juguemos a un juego tú y yo!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.CHESSPIECE_KNIGHT.STRUGGLE
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.CHESSPIECE_KNIGHT.STRUGGLE"
msgid "Yes, yes, come play!"
msgstr "¡Sí, sí, ven a jugar!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.CHESSPIECE_MALBATROSS
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.CHESSPIECE_MALBATROSS"
msgid "Oh my word, that was a feisty bird!"
msgstr "Vaya, vaya, ¡qué pájaro agresivo!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.CHESSPIECE_MANRABBIT
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.CHESSPIECE_MANRABBIT"
msgid "Looking at it fills me with hoppiness, hyuyu!"
msgstr "Me llena de ganas de saltar, ¡jiu, ju!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.CHESSPIECE_MINOTAUR
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.CHESSPIECE_MINOTAUR"
msgid "It's as though the Minotaur met Medusa."
msgstr "Es como el Minotauro se hubiera encontrado con Medusa."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.CHESSPIECE_MOON
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.CHESSPIECE_MOON"
msgid "The mortals thought it was made of cheese! Hyuyu!"
msgstr "¡Los mortales pensaban que estaba hecha de queso! ¡Jiu, ju!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.CHESSPIECE_MOOSEGOOSE.1
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.CHESSPIECE_MOOSEGOOSE.1"
msgid "We've established a stone goose truce."
msgstr "Acordamos una tregua con el ganso de piedra."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.CHESSPIECE_MOOSEGOOSE.2
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.CHESSPIECE_MOOSEGOOSE.2"
msgid "We've established a stone moose truce."
msgstr "Acordamos una tregua con el alce de piedra."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.CHESSPIECE_MUSE
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.CHESSPIECE_MUSE"
msgid "How whimsically elegant."
msgstr "Qué elegancia tan caprichosa."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.CHESSPIECE_PAWN
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.CHESSPIECE_PAWN"
msgid "Would you like to play?"
msgstr "¿Te gustaría jugar?"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.CHESSPIECE_PIPE
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.CHESSPIECE_PIPE"
msgid "Bubble, bubble, no such trouble."
msgstr "Pompa, pompa, da igual que se rompa."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.CHESSPIECE_ROOK.GENERIC
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.CHESSPIECE_ROOK.GENERIC"
msgid "We carved this from the rock ourselves."
msgstr "Lo tallamos nosotros mismos de la roca."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.CHESSPIECE_ROOK.STRUGGLE
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.CHESSPIECE_ROOK.STRUGGLE"
msgid "Yes, yes, come play!"
msgstr "¡Sí, sí, ven a jugar!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.CHESSPIECE_SHARKBOI
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.CHESSPIECE_SHARKBOI"
msgid "We avoided the maw of the rowdy Frostjaw."
msgstr "Escapamos por los pelos de sus fauces de hielo."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.CHESSPIECE_STALKER
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.CHESSPIECE_STALKER"
msgid "No more rattlin' bones."
msgstr "Basta de traqueteo de huesos."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.CHESSPIECE_TOADSTOOL
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.CHESSPIECE_TOADSTOOL"
msgid "A fine piece of art, especially the warts."
msgstr "Esta obra me subyuga, sobre todo por las verrugas."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.CHESSPIECE_TWINSOFTERROR
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.CHESSPIECE_TWINSOFTERROR"
msgid "What an eye-catching statue, hyuyu!"
msgstr "¡Ojito con esta estatua, jiu, ju!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.CHESSPIECE_WARG_MUTATED
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.CHESSPIECE_WARG_MUTATED"
msgid "Must we memorialize the mutated mutt?"
msgstr "¿Necesitamos un monumento para ese mestizo mutante?"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.CHESSPIECE_WORMBOSS
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.CHESSPIECE_WORMBOSS"
msgid "Its jaws were near, but I disappeared! Hyuyu!"
msgstr ""

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.CHESSPIECE_YOTD
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.CHESSPIECE_YOTD"
msgid "From hot to stone cold."
msgstr "Pasó de caliente a frío como una piedra."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.CHESTER
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.CHESTER"
msgid "Greetings! Sorry, I can't pet you."
msgstr "¡Saludos! Lo siento, no puedo acariciarte."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.CHESTER_EYEBONE.GENERIC
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.CHESTER_EYEBONE.GENERIC"
msgid "My, my, what do you see?"
msgstr "Veo, veo, ¿qué ves?"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.CHESTER_EYEBONE.WAITING
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.CHESTER_EYEBONE.WAITING"
msgid "There's no soul attuned to it."
msgstr "No hay ningún alma en sintonía con esto."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.CHESTUPGRADE_STACKSIZE
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.CHESTUPGRADE_STACKSIZE"
msgid "Now that's bending the rules a little, hyuyu!"
msgstr "Eso sí que es flexibilizar las reglas, ¡jiu, ju!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.CHEST_MIMIC_REVEALED
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.CHEST_MIMIC_REVEALED"
msgid "Why did we open it?!"
msgstr "¿Por qué razón lo abrimos?"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.CHUM
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.CHUM"
msgid "Shall we try to get chummy with the fish? Hyuyu!"
msgstr "¿Intentamos cebar el pez? ¡Jiu, ju!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.CLAYHOUND.GENERIC
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.CLAYHOUND.GENERIC"
msgid "Yip yap yelp, I need help!"
msgstr "¡Ayuda, socorro! ¡Que me ataca el cachorro!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.CLAYHOUND.STATUE
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.CLAYHOUND.STATUE"
msgid "Petrified from toe to tip!"
msgstr "¡Petrificada de la cabeza a las patas!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.CLAYWARG.GENERIC
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.CLAYWARG.GENERIC"
msgid "Growl and bark, teeth like a shark!"
msgstr "¡Ladrador y gruñón, colmillos como un tiburón!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.CLAYWARG.STATUE
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.CLAYWARG.STATUE"
msgid "Petrified from toe to tip!"
msgstr "¡Petrificada de la cabeza a las patas!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.COLDFIRE.EMBERS
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.COLDFIRE.EMBERS"
msgid "Soon to extinguish."
msgstr "Pronto se extinguirá."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.COLDFIRE.GENERIC
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.COLDFIRE.GENERIC"
msgid "Brrrning brrrright."
msgstr "Brrrr, brrr, brrrr."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.COLDFIRE.HIGH
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.COLDFIRE.HIGH"
msgid "Chilly! So chilly."
msgstr "¡Qué frío! Qué frío."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.COLDFIRE.LOW
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.COLDFIRE.LOW"
msgid "It burns so low, so low!"
msgstr "¡Arde poco, muy poco!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.COLDFIRE.NORMAL
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.COLDFIRE.NORMAL"
msgid "Brisk fire. That's new."
msgstr "Fuego frío. Es una novedad."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.COLDFIRE.OUT
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.COLDFIRE.OUT"
msgid "And out it goes."
msgstr "Y se apagó."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.COLDFIREPIT.EMBERS
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.COLDFIREPIT.EMBERS"
msgid "Soon to extinguish."
msgstr "Pronto se extinguirá."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.COLDFIREPIT.GENERIC
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.COLDFIREPIT.GENERIC"
msgid "Brrrning brrrright."
msgstr "Brrrr, brrr, brrrr."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.COLDFIREPIT.HIGH
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.COLDFIREPIT.HIGH"
msgid "Chilly! So chilly."
msgstr "¡Qué frío! Qué frío."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.COLDFIREPIT.LOW
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.COLDFIREPIT.LOW"
msgid "It burns so low, so low!"
msgstr "¡Arde poco, muy poco!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.COLDFIREPIT.NORMAL
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.COLDFIREPIT.NORMAL"
msgid "Brisk fire. That's new."
msgstr "Fuego frío. Es una novedad."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.COLDFIREPIT.OUT
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.COLDFIREPIT.OUT"
msgid "And out it goes."
msgstr "Y se apagó."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.COLLAPSEDCHEST
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.COLLAPSEDCHEST"
msgid "Infinite space, gone without a trace?"
msgstr "¿Espacio infinito que desaparece en el camino?"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.COMPASS.E
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.COMPASS.E"
msgid "East!"
msgstr "¡Este!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.COMPASS.GENERIC
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.COMPASS.GENERIC"
msgid "For when up is down and down is out."
msgstr "Para cuando arriba es abajo y abajo es afuera."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.COMPASS.N
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.COMPASS.N"
msgid "North!"
msgstr "¡Norte!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.COMPASS.NE
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.COMPASS.NE"
msgid "Northeast!"
msgstr "¡Noreste!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.COMPASS.NW
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.COMPASS.NW"
msgid "Northwest!"
msgstr "¡Noroeste!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.COMPASS.S
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.COMPASS.S"
msgid "South!"
msgstr "¡Sur!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.COMPASS.SE
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.COMPASS.SE"
msgid "Southeast!"
msgstr "¡Sureste!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.COMPASS.SW
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.COMPASS.SW"
msgid "Southwest!"
msgstr "¡Suroeste!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.COMPASS.W
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.COMPASS.W"
msgid "West!"
msgstr "¡Oeste!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.COMPOST
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.COMPOST"
msgid "Oh, I could pull some fun pranks with this."
msgstr "Podría hacer varias bromas divertidas con esto."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.COMPOSTINGBIN.BALANCED
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.COMPOSTINGBIN.BALANCED"
msgid "What a delight, it turned out just right!"
msgstr "¡Qué buen aspecto! ¡Salió perfecto!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.COMPOSTINGBIN.BURNT
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.COMPOSTINGBIN.BURNT"
msgid "How silly!"
msgstr "¡Qué tontería!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.COMPOSTINGBIN.DRY
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.COMPOSTINGBIN.DRY"
msgid "Nice try, but it's too dry."
msgstr "Buen intento, pero está muy seco."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.COMPOSTINGBIN.GENERIC
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.COMPOSTINGBIN.GENERIC"
msgid "Not exactly a barrel of laughs."
msgstr "No desborda de onda."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.COMPOSTINGBIN.WET
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.COMPOSTINGBIN.WET"
msgid "I tried and yet, it's far too wet."
msgstr "Lo probé y me temo que está húmedo en exceso."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.COMPOSTWRAP
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.COMPOSTWRAP"
msgid "It's poop. So the plants won't droop."
msgstr "Es caca. Para que las plantas no decaigan."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.CONSTRUCTION_PLANS
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.CONSTRUCTION_PLANS"
msgid "But it's more fun to wing it!"
msgstr "¡Pero es más divertido improvisar!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.COOKBOOK
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.COOKBOOK"
msgid "Oh what shall I cook up next? Hyuyu!"
msgstr "¿Qué puedo sacar del horno ahora? ¡Jiu, ju!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.COOKEDMANDRAKE
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.COOKEDMANDRAKE"
msgid "It's at peace now."
msgstr "Ahora descansa para siempre."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.COOKEDMEAT
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.COOKEDMEAT"
msgid "I don't really like having food in my stomach."
msgstr "En realidad, no me gusta tener comida en el estómago."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.COOKEDMONSTERMEAT
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.COOKEDMONSTERMEAT"
msgid "I'd still rather not eat it."
msgstr "Preferiría no comérmela."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.COOKEDSMALLMEAT
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.COOKEDSMALLMEAT"
msgid "At least it smells better now."
msgstr "Al menos ahora huele mejor."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.COOKIECUTTER
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.COOKIECUTTER"
msgid "Well, aren't you a funny fellow!"
msgstr "¡Qué tipo tan divertido!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.COOKIECUTTERHAT
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.COOKIECUTTERHAT"
msgid "With this spiny gear, I've nothing to fear!"
msgstr "Con este accesorio espinoso, ¡no volveré a estar miedoso!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.COOKIECUTTERSHELL
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.COOKIECUTTERSHELL"
msgid "The creature fell, now I take its shell!"
msgstr "La criatura cayó y me quedo con su caparazón."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.COOKINGRECIPECARD.GENERIC
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.COOKINGRECIPECARD.GENERIC"
msgid "How mysterious, the card is blank!"
msgstr "¡Qué misterio! La tarjeta está en blanco."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.COOKPOT.BURNT
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.COOKPOT.BURNT"
msgid "I don't understand how to make mortal food."
msgstr "No entiendo cómo preparar comida para mortales."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.COOKPOT.COOKING_LONG
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.COOKPOT.COOKING_LONG"
msgid "It will take quite some time."
msgstr "Va a tardar un tiempo."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.COOKPOT.COOKING_SHORT
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.COOKPOT.COOKING_SHORT"
msgid "I'm shivering with anticipation!"
msgstr "¡Estoy temblando de la emoción!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.COOKPOT.DONE
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.COOKPOT.DONE"
msgid "Looks like my treat is ready to eat!"
msgstr "¡Mi plato está listo para ser degustado!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.COOKPOT.EMPTY
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.COOKPOT.EMPTY"
msgid "Can souls simmer?"
msgstr "¿Se puede hervir las almas?"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.COONTAIL
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.COONTAIL"
msgid "Better yours than mine."
msgstr "Mejor la tuya que la mía."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.CORN
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.CORN"
msgid "I prefer not to ingest food."
msgstr "Prefiero no ingerir comida."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.CORN_COOKED
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.CORN_COOKED"
msgid "I thought it was supposed to pop."
msgstr "Pensé que iba a estallar."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.CORN_OVERSIZED
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.CORN_OVERSIZED"
msgid "Lend me your ear, hyuyu!"
msgstr "¡Oye, tienes muchos granos! ¡Jiu, ju!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.CORN_SEEDS
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.CORN_SEEDS"
msgid "Grow a seed and you shall feed!"
msgstr "¡Planta una semilla y tendrás buena comida!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.COSTUME_BLACKSMITH_BODY
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.COSTUME_BLACKSMITH_BODY"
msgid "Hyuyuyu, oh this is a fun game!"
msgstr "¡Jiu, ju! Qué juego tan divertido."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.COSTUME_DOLL_BODY
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.COSTUME_DOLL_BODY"
msgid "Hyuyuyu, oh this is a fun game!"
msgstr "¡Jiu, ju! Qué juego tan divertido."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.COSTUME_FOOL_BODY
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.COSTUME_FOOL_BODY"
msgid "Hyuyuyu, oh this is a fun game!"
msgstr "¡Jiu, ju! Qué juego tan divertido."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.COSTUME_KING_BODY
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.COSTUME_KING_BODY"
msgid "Hyuyuyu, oh this is a fun game!"
msgstr "¡Jiu, ju! Qué juego tan divertido."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.COSTUME_MIRROR_BODY
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.COSTUME_MIRROR_BODY"
msgid "Hyuyuyu, oh this is a fun game!"
msgstr "¡Jiu, ju! Qué juego tan divertido."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.COSTUME_QUEEN_BODY
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.COSTUME_QUEEN_BODY"
msgid "Hyuyuyu, oh this is a fun game!"
msgstr "¡Jiu, ju! Qué juego tan divertido."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.COSTUME_TREE_BODY
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.COSTUME_TREE_BODY"
msgid "Hyuyuyu, oh this is a fun game!"
msgstr "¡Jiu, ju! Qué juego tan divertido."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.COTL_TABERNACLE_LEVEL1.GENERIC
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.COTL_TABERNACLE_LEVEL1.GENERIC"
msgid "How it yearns for something to burn."
msgstr "Cómo anhela algo que quemar."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.COTL_TABERNACLE_LEVEL1.LIT
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.COTL_TABERNACLE_LEVEL1.LIT"
msgid "Let's linger by the light of this little lamb."
msgstr "Quedémonos al calor de este corderito."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.COTL_TABERNACLE_LEVEL2.GENERIC
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.COTL_TABERNACLE_LEVEL2.GENERIC"
msgid "How it yearns for something to burn."
msgstr "Cómo anhela algo que quemar."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.COTL_TABERNACLE_LEVEL2.LIT
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.COTL_TABERNACLE_LEVEL2.LIT"
msgid "The lamb is lit, why not stay for a bit?"
msgstr "El cordero está encendido. Merecemos un descansito."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.COTL_TABERNACLE_LEVEL3.GENERIC
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.COTL_TABERNACLE_LEVEL3.GENERIC"
msgid "How it yearns for something to burn."
msgstr "Cómo anhela algo que quemar."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.COTL_TABERNACLE_LEVEL3.LIT
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.COTL_TABERNACLE_LEVEL3.LIT"
msgid "The lamb of gold, what a sight to behold."
msgstr "¡El cordero dorado, lo más bello que he contemplado!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.COTL_TRINKET
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.COTL_TRINKET"
msgid "Hyuyu, how tempting!"
msgstr "¡Jiu, ju, qué tentador!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.COZY_BUNNYMAN
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.COZY_BUNNYMAN"
msgid "How have you found your time above-ground?"
msgstr "¿Cómo la pasaste en la superficie?"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.CRABKING.GENERIC
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.CRABKING.GENERIC"
msgid "Another cursed soul."
msgstr "Otra alma maldita."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.CRABKING.INERT
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.CRABKING.INERT"
msgid "This castle is missing its crown jewels."
msgstr "A este castillo le faltan las joyas de la corona."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.CRABKING_CANNONTOWER
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.CRABKING_CANNONTOWER"
msgid "Well don't go ballistic, hyuyu!"
msgstr "¡No dispares, jiu, ju!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.CRABKING_CLAW
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.CRABKING_CLAW"
msgid "Now that's claws for alarm, hyuyuyu!"
msgstr "¡Esas pinzas tienen mala pinta, jiu, ju!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.CRABKING_ICEWALL
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.CRABKING_ICEWALL"
msgid "Nothing nice about a wall of ice."
msgstr "Una pared de hielo no tiene nada de bueno."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.CRABKING_MOB
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.CRABKING_MOB"
msgid "Stay back, bottom feeder!"
msgstr "¡Atrás, carroñero marino!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.CRABKING_MOB_KNIGHT
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.CRABKING_MOB_KNIGHT"
msgid "I'm surely shell-shocked!"
msgstr "¡No tienes corazón, solo caparazón!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.CRITTERLAB
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.CRITTERLAB"
msgid "Ooo, I'd like a partner in pranks."
msgstr "Oooh, me gustaría tener un compañero de bromas."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.CRITTER_DRAGONLING
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.CRITTER_DRAGONLING"
msgid "Look at you, little firebreather!"
msgstr "¡Mírate nada más! ¡Una escupefuegos chiquita!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.CRITTER_EYEOFTERROR
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.CRITTER_EYEOFTERROR"
msgid "I'm glad we could make amends, my ocular friend!"
msgstr "Me alegra que nos hayamos perdonado, amigo ocular."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.CRITTER_GLOMLING
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.CRITTER_GLOMLING"
msgid "What a cute little munchkin you are."
msgstr "Qué criaturita más bonita."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.CRITTER_KITTEN
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.CRITTER_KITTEN"
msgid "What should our next prank be, little kitty?"
msgstr "¿Qué broma hacemos ahora, gatito?"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.CRITTER_LAMB
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.CRITTER_LAMB"
msgid "Just know that I'm petting you in my mind."
msgstr "Te estoy acariciando mentalmente."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.CRITTER_LUNARMOTHLING
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.CRITTER_LUNARMOTHLING"
msgid "On wings alight comes a fuzzy delight!"
msgstr "¡Volando se apresura una hermosura velluda!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.CRITTER_PERDLING
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.CRITTER_PERDLING"
msgid "You're so sweet, I could just gobble you up."
msgstr "Eres tan dulce que te comería."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.CRITTER_PUPPY
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.CRITTER_PUPPY"
msgid "Sorry I can't pet you, little friend."
msgstr "Perdona que no pueda acariciarte, amiguito."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.CROW.GENERIC
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.CROW.GENERIC"
msgid "Clever trickster."
msgstr "Un embaucador inteligente."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.CROW.HELD
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.CROW.HELD"
msgid "Careful, don't touch my hands."
msgstr "Cuidado. No me toques las manos."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.CRUMBS
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.CRUMBS"
msgid "That's the way the cookie crumbles, hyuyu!"
msgstr "No me conformaré con migajas, ¡jiu, ju!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.CURSED_MONKEY_TOKEN
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.CURSED_MONKEY_TOKEN"
msgid "Oh me oh my, I couldn't leave it if I tried!"
msgstr "Ah, qué molestia. No puedo dejarlo ni aunque quisiera."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.CUTGRASS
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.CUTGRASS"
msgid "Oh, what I could weave!"
msgstr "¡Ah, lo que podría tejer!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.CUTLESS
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.CUTLESS"
msgid "It's a cut below the rest."
msgstr "Se queda corto en cuanto a cortes."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.CUTLICHEN
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.CUTLICHEN"
msgid "I'd really rather not eat it."
msgstr "Preferiría no comerlo."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.CUTREEDS
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.CUTREEDS"
msgid "One swift yank was all it took."
msgstr "Un tironcito rápido y listo."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.CUTSTONE
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.CUTSTONE"
msgid "Brick by brick, they say, they say."
msgstr "Un ladrillo a la vez, eso dicen."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.DAYWALKER.GENERIC
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.DAYWALKER.GENERIC"
msgid "I'm sensing the answer is foe."
msgstr "Presiento que la respuesta es «enemigo»."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.DAYWALKER.IMPRISONED
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.DAYWALKER.IMPRISONED"
msgid "Friend or foe?"
msgstr "¿Eres aliado o enemigo?"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.DAYWALKER2.BURIED
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.DAYWALKER2.BURIED"
msgid "Just my luck to find him stuck… again."
msgstr "Qué mala suerte. Lo encontré atrapado... de nuevo."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.DAYWALKER2.GENERIC
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.DAYWALKER2.GENERIC"
msgid "Freed indeed."
msgstr "Es libre como el viento."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.DAYWALKER2.HOSTILE
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.DAYWALKER2.HOSTILE"
msgid "Not to belabor, but you've a pattern of behavior."
msgstr "No quiero ser pesado, pero eres bastante maleducado."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.DAYWALKER_PILLAR.EXPOSED
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.DAYWALKER_PILLAR.EXPOSED"
msgid "Why hide this stone inside?"
msgstr "Un momento. ¿Por qué hay piedra dentro?"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.DAYWALKER_PILLAR.GENERIC
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.DAYWALKER_PILLAR.GENERIC"
msgid "A terrible fate, to be locked in this state."
msgstr "Qué destino desgraciado quedar atrapado en este estado."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.DEADLYFEAST
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.DEADLYFEAST"
msgid "I desire this even less than regular food."
msgstr "Me interesa aún menos que la comida normal."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.DEAD_SEA_BONES
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.DEAD_SEA_BONES"
msgid "Bones from the sea, these look to be!"
msgstr "¡Huesos del mar, de ahí parecen brotar!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.DECIDUOUSTREE.BURNING
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.DECIDUOUSTREE.BURNING"
msgid "Twiddle dee dee, a burning tree!"
msgstr "¡Laralalaralá, el árbol arderá!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.DECIDUOUSTREE.BURNT
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.DECIDUOUSTREE.BURNT"
msgid "Well, that was fun."
msgstr "Bueno, fue divertido."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.DECIDUOUSTREE.CHOPPED
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.DECIDUOUSTREE.CHOPPED"
msgid "A funny tree prank."
msgstr "Una broma graciosa con el árbol."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.DECIDUOUSTREE.GENERIC
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.DECIDUOUSTREE.GENERIC"
msgid "Fanciful tree of papery bark."
msgstr "Un curioso árbol con corteza como de papel."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.DECIDUOUSTREE.POISON
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.DECIDUOUSTREE.POISON"
msgid "It is no longer bound to the earth!"
msgstr "¡Ya no está ligado a la tierra!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.DECOR_CENTERPIECE
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.DECOR_CENTERPIECE"
msgid "How wonderfully useless!"
msgstr "¡Maravillosamente inútil!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.DECOR_FLOWERVASE.EMPTY
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.DECOR_FLOWERVASE.EMPTY"
msgid "There's nothing placed within the vase."
msgstr "No hay nada dentro del jarrón."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.DECOR_FLOWERVASE.FRESHLIGHT
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.DECOR_FLOWERVASE.FRESHLIGHT"
msgid "A light so bright I might still see at night!"
msgstr "¡Una luz tan brillante que puedo ver en cualquier parte!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.DECOR_FLOWERVASE.GENERIC
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.DECOR_FLOWERVASE.GENERIC"
msgid "The space in the vase is filled with flowers."
msgstr "El espacio del jarrón está lleno de flores."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.DECOR_FLOWERVASE.OLDLIGHT
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.DECOR_FLOWERVASE.OLDLIGHT"
msgid "I'll try not to pout when that light soon goes out."
msgstr "Trataré de no llorar ahora que la luz se va a apagar."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.DECOR_FLOWERVASE.WILTED
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.DECOR_FLOWERVASE.WILTED"
msgid "Tiny flower on the table... you aren't looking very stable."
msgstr "Florcita sobre la mesa, estás un poco aviesa."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.DECOR_LAMP
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.DECOR_LAMP"
msgid "This little lamp's light is quite a delight."
msgstr "La luz de esta lamparita es muy bonita."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.DECOR_PICTUREFRAME.GENERIC
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.DECOR_PICTUREFRAME.GENERIC"
msgid "A limited edition artist's rendition!"
msgstr "Una representación artística de edición limitada."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.DECOR_PICTUREFRAME.UNDRAWN
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.DECOR_PICTUREFRAME.UNDRAWN"
msgid "What a shame, just an empty frame."
msgstr "Qué sombrío. Solo es un marco vacío."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.DECOR_PORTRAITFRAME
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.DECOR_PORTRAITFRAME"
msgid "A picture perfect portrait."
msgstr "Un retrato realista."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.DEER.ANTLER
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.DEER.ANTLER"
msgid "My, what a lovely horn you have!"
msgstr "¡Buenos cuernos, ciervo!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.DEER.GENERIC
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.DEER.GENERIC"
msgid "Greetings, dearest!"
msgstr "Estoy para ciervirte."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.DEERCLOPS
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.DEERCLOPS"
msgid "So large, so rude, so full of 'tude!"
msgstr "¡Qué grande, qué brutal, qué bestia descomunal!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.DEERCLOPSCORPSE.BURNING
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.DEERCLOPSCORPSE.BURNING"
msgid "I was just yearning for the smell of burning."
msgstr "Extrañaba el olor a carne quemada."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.DEERCLOPSCORPSE.GENERIC
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.DEERCLOPSCORPSE.GENERIC"
msgid "Ol' One-Eyed has gone and died!"
msgstr "¡El tuerto se ha muerto!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.DEERCLOPSCORPSE.REVIVING
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.DEERCLOPSCORPSE.REVIVING"
msgid "A refund? I'm stunned."
msgstr "¿Un secuela? Qué pésima idea."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.DEERCLOPSEYEBALL_SENTRYWARD.GENERIC
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.DEERCLOPSEYEBALL_SENTRYWARD.GENERIC"
msgid "What the eye sees stays icy! Hyuyu!"
msgstr "Está haciendo la vista gorda, ¡jiu, ju!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.DEERCLOPSEYEBALL_SENTRYWARD.NOEYEBALL
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.DEERCLOPSEYEBALL_SENTRYWARD.NOEYEBALL"
msgid "It turned a blind eye!"
msgstr "Se quedó sin ojo... Desojeado."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.DEERCLOPSEYEBALL_SENTRYWARD_KIT
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.DEERCLOPSEYEBALL_SENTRYWARD_KIT"
msgid "I'll keep my eye on the prize, hyuyu!"
msgstr "Dichosos los ojos que te ven, ¡jiu, ju!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.DEERCLOPS_EYEBALL
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.DEERCLOPS_EYEBALL"
msgid "Apologies, dear sir."
msgstr "A su ciervicio, señor."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.DEER_ANTLER
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.DEER_ANTLER"
msgid "I like mine better."
msgstr "Me gustan más los míos."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.DEER_GEMMED
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.DEER_GEMMED"
msgid "That's a good look for you!"
msgstr "¡Te queda muy bien!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.DEPLETED_GRASS.GENERIC
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.DEPLETED_GRASS.GENERIC"
msgid "It's gone away for now."
msgstr "Se fue por ahora."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.DESERTHAT
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.DESERTHAT"
msgid "I do so dislike having sand in my face fur."
msgstr "Odio tener arena en el pelaje de mi cara."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.DEVTOOL
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.DEVTOOL"
msgid "It's a prank-maker."
msgstr "Una máquina de bromas."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.DEVTOOL_NODEV
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.DEVTOOL_NODEV"
msgid "Whoops-a-doodle!"
msgstr "¡Metí la pata!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.DIRTPILE
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.DIRTPILE"
msgid "I could get my claws in there."
msgstr "Podría meter las garras ahí."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.DIVININGROD.COLD
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.DIVININGROD.COLD"
msgid "The trail's gone cold, I feel cajoled."
msgstr "El rastro se ha enfriado. Me siento presionado."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.DIVININGROD.GENERIC
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.DIVININGROD.GENERIC"
msgid "It will guide me where I wish to go."
msgstr "Me guiará hacia donde quiero ir."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.DIVININGROD.HOT
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.DIVININGROD.HOT"
msgid "Red hot! We're near the spot!"
msgstr "¡Caliente, caliente! ¡Encontrarlo es inminente!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.DIVININGROD.WARM
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.DIVININGROD.WARM"
msgid "Hey, hey, hey! We're on our way!"
msgstr "¡Sí, sí, sí! ¡Estamos llegando allí!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.DIVININGROD.WARMER
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.DIVININGROD.WARMER"
msgid "I have to boast, we're getting close!"
msgstr "¡Debo presumir, estamos llegando allí!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.DIVININGRODBASE.GENERIC
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.DIVININGRODBASE.GENERIC"
msgid "How very, very curious!"
msgstr "¡Vaya, vaya! Qué curioso."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.DIVININGRODBASE.READY
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.DIVININGRODBASE.READY"
msgid "Let's hop, skip and jump out of here!"
msgstr "¡Brincando, brincando, salgamos de aquí saltando!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.DIVININGRODBASE.UNLOCKED
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.DIVININGRODBASE.UNLOCKED"
msgid "Ooo, my fur's standing on end in anticipation!"
msgstr "¡Oooh, el pelaje se me eriza de la emoción!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.DIVININGRODSTART
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.DIVININGRODSTART"
msgid "And now begins a thrilling game!"
msgstr "¡Y ahora comienza un emocionante juego!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.DOCK_KIT
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.DOCK_KIT"
msgid "It would a-pier I have some work to do."
msgstr "La tarea llegará a buen puerto."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.DOCK_WOODPOSTS_ITEM
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.DOCK_WOODPOSTS_ITEM"
msgid "I'll fix it in post, hyuyu!"
msgstr "A la «poste», saldrá bien. ¡Jiu, ju!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.DOLL_BLUEPRINT
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.DOLL_BLUEPRINT"
msgid "Oh what a dollight! Hyuyu!"
msgstr "Pero ¡qué muñeca! ¡Jiu, ju!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.DRAGONBOAT_KIT
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.DRAGONBOAT_KIT"
msgid "Whereabouts to set this boat afloat?"
msgstr "¿Son suministros para que el barco flote solito?"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.DRAGONBOAT_PACK
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.DRAGONBOAT_PACK"
msgid "A fully-stocked boat, ready to float!"
msgstr "Un barco que acabo de equipar, listo para flotar."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.DRAGONBODYHAT
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.DRAGONBODYHAT"
msgid "Let's play imp in the middle!"
msgstr "¡Juguemos al rondo!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.DRAGONCHILISALAD
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.DRAGONCHILISALAD"
msgid "Warly spends a lot of time on this stuff."
msgstr "Warly pasa un montón de tiempo con esto."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.DRAGONFLY
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.DRAGONFLY"
msgid "Fear me! I'm a scary imp!"
msgstr "¡Tiembla de pavor! ¡Soy un diablillo aterrador!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.DRAGONFLYCHEST.GENERIC
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.DRAGONFLYCHEST.GENERIC"
msgid "Chest to impress."
msgstr "A lo hecho, pecho."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.DRAGONFLYCHEST.UPGRADED_STACKSIZE
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.DRAGONFLYCHEST.UPGRADED_STACKSIZE"
msgid "Scaled-up storage, hyuyu!"
msgstr "Almacenamiento a gran escama, ¡jiu, ju!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.DRAGONFLYFURNACE.GENERIC
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.DRAGONFLYFURNACE.GENERIC"
msgid "A cage to hold the dragon's rage."
msgstr "Una jaula para contener la rabia del dragón."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.DRAGONFLYFURNACE.HAMMERED
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.DRAGONFLYFURNACE.HAMMERED"
msgid "It lost its glamor to the hammer."
msgstr "Perdió su glamur a golpes."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.DRAGONFLYFURNACE.HIGH
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.DRAGONFLYFURNACE.HIGH"
msgid "It burns so bright both day and night."
msgstr "Arde con alegría de noche y de día."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.DRAGONFLYFURNACE.NORMAL
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.DRAGONFLYFURNACE.NORMAL"
msgid "It burns the right amount, I'd say."
msgstr "Arde lo necesario, creo."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.DRAGONFRUIT
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.DRAGONFRUIT"
msgid "Plucked fresh from the dragon. Hyuyu!"
msgstr "Recién cosechada del dragón. ¡Jiu, ju!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.DRAGONFRUIT_COOKED
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.DRAGONFRUIT_COOKED"
msgid "It's been cooked in dragonfire."
msgstr "Cocida en fuego de dragón."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.DRAGONFRUIT_OVERSIZED
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.DRAGONFRUIT_OVERSIZED"
msgid "A giant fruit, and a dragon's to boot!"
msgstr "¡Una fruta colosal, y de un dragón, además!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.DRAGONFRUIT_SEEDS
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.DRAGONFRUIT_SEEDS"
msgid "Grow a seed and you shall feed!"
msgstr "¡Planta una semilla y tendrás buena comida!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.DRAGONHEADHAT
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.DRAGONHEADHAT"
msgid "Me and my horns should be the head!"
msgstr "¡Mis cuernos y yo deberíamos ser la cabeza!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.DRAGONPIE
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.DRAGONPIE"
msgid "Chock full of genuine dragon."
msgstr "Lleno de dragón auténtico."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.DRAGONTAILHAT
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.DRAGONTAILHAT"
msgid "Put my tail at the tail end!"
msgstr "¡Pon mi cola a la cola!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.DRAGON_SCALES
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.DRAGON_SCALES"
msgid "I prefer fur to scales."
msgstr "Prefiero el pelaje a las escamas."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.DREADSTONE
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.DREADSTONE"
msgid "A stone as black as night."
msgstr "Una piedra negra como la medianoche."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.DREADSTONEHAT
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.DREADSTONEHAT"
msgid "A stone fortress for my brain."
msgstr "Una fortaleza de piedra para mi cerebro."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.DREADSTONE_STACK
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.DREADSTONE_STACK"
msgid "Who knows where it grows from?"
msgstr "¿Cómo crece? Nadie lo sabe, parece."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.DRIFTWOOD_LOG
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.DRIFTWOOD_LOG"
msgid "Naught but a log."
msgstr "No es más que un tronco."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.DRIFTWOOD_TREE.BURNING
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.DRIFTWOOD_TREE.BURNING"
msgid "Burning, burning, burning down."
msgstr "Se quema, se quema, se quema."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.DRIFTWOOD_TREE.BURNT
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.DRIFTWOOD_TREE.BURNT"
msgid "So much tinder, burnt to cinder."
msgstr "Tantas astillas reducidas a cenizas."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.DRIFTWOOD_TREE.CHOPPED
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.DRIFTWOOD_TREE.CHOPPED"
msgid "It is no more."
msgstr "Ya no existe."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.DRIFTWOOD_TREE.GENERIC
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.DRIFTWOOD_TREE.GENERIC"
msgid "An old, dead tree, beached and bleached."
msgstr "Un árbol viejo y muerto, pasado por agua y yerto."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.DRUMSTICK
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.DRUMSTICK"
msgid "Ba-dum-chhh!"
msgstr "A la pata coja."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.DRUMSTICK_COOKED
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.DRUMSTICK_COOKED"
msgid "It's been cooked now."
msgstr "Ahora está cocinado."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.DUG_BANANABUSH
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.DUG_BANANABUSH"
msgid "Hyuyu, little shrub, are you waving at me?"
msgstr "Jiu, ju, arbustito, ¿me estás saludando?"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.DUG_BERRYBUSH
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.DUG_BERRYBUSH"
msgid "A bush out of dirt is like a fish out of water."
msgstr "Un arbusto fuera de la tierra es como un pez fuera del agua."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.DUG_BERRYBUSH_JUICY
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.DUG_BERRYBUSH_JUICY"
msgid "A bush out of dirt is like a fish out of water."
msgstr "Un arbusto fuera de la tierra es como un pez fuera del agua."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.DUG_GRASS
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.DUG_GRASS"
msgid "Put it back in the dirt, before it gets hurt!"
msgstr "¡Plántalo otra vez antes de que se arruine!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.DUG_MARSH_BUSH
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.DUG_MARSH_BUSH"
msgid "Put it back in the dirt, before it gets hurt!"
msgstr "¡Plántalo otra vez antes de que se arruine!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.DUG_MONKEYTAIL
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.DUG_MONKEYTAIL"
msgid "How funny, a plant that apes monkeys!"
msgstr "Qué risa. Una planta que imita a los monos."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.DUG_SAPLING
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.DUG_SAPLING"
msgid "Put it back in the dirt, before it gets hurt!"
msgstr "¡Plántalo otra vez antes de que se arruine!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.DUG_TRAP_STARFISH
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.DUG_TRAP_STARFISH"
msgid "Planting this would be a devilish trick."
msgstr "Plantar esto sería una broma diabólica."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.DUMBBELL
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.DUMBBELL"
msgid "It's neither dumb, nor a bell. Mortals are strange, indeed."
msgstr "Decirle «pesa» a la mancuerna es raro. Los humanos son raros."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.DUMBBELL_BLUEGEM
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.DUMBBELL_BLUEGEM"
msgid "It'll knock you out cold, hyuyuyu!"
msgstr "¡Te noquearé de un golpe, jiu, ju!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.DUMBBELL_GEM
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.DUMBBELL_GEM"
msgid "He's turned those gemstones into gymstones, hyuyu!"
msgstr "¡Convirtió esas gemas en «gyms», jiu, ju!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.DUMBBELL_GOLDEN
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.DUMBBELL_GOLDEN"
msgid "It's neither dumb, nor a bell. Mortals are strange, indeed."
msgstr "Decirle «pesa» a la mancuerna es raro. Los humanos son raros."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.DUMBBELL_HEAT
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.DUMBBELL_HEAT"
msgid "A warm stone for muscle tone."
msgstr "Con una piedra caliente, el músculo se siente."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.DUMBBELL_MARBLE
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.DUMBBELL_MARBLE"
msgid "Marbellous, simply marbellous!"
msgstr "¡Me dejó de piedra! ¡Marmovilloso!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.DUMBBELL_REDGEM
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.DUMBBELL_REDGEM"
msgid "Fire and gym stone!"
msgstr "¡Piedra de fuego y de gym!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.DURIAN
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.DURIAN"
msgid "I love a good stink!"
msgstr "¡Me encanta que huela tan mal!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.DURIAN_COOKED
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.DURIAN_COOKED"
msgid "Don't mind if I do-rian."
msgstr "El durión ya estaba ma-durio."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.DURIAN_OVERSIZED
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.DURIAN_OVERSIZED"
msgid "It gives off such a stink, it's hard to think!"
msgstr "¡Su olor es tan fuerte, que nubla la mente!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.DURIAN_SEEDS
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.DURIAN_SEEDS"
msgid "Let's give them some soil, before they spoil."
msgstr "Démosles un poco de tierra antes de que se pierdan."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.DUSTMERINGUE
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.DUSTMERINGUE"
msgid "Hyuyuyu! The pranks I could pull with these!"
msgstr "¡Jiu, ju, cuántas bromas podría hacer con esto!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.DUSTMOTH
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.DUSTMOTH"
msgid "That charming creature nearly swept me off my feet, hyuyu!"
msgstr "¡Esa criaturita casi me mata, jiu, ju!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.DUSTMOTHDEN
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.DUSTMOTHDEN"
msgid "I'm afraid their nest has something I wish to possess."
msgstr "Me temo que el nido tiene algo que quiero."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.EARMUFFSHAT
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.EARMUFFSHAT"
msgid "They weren't made for floppy ears."
msgstr "No se hicieron para orejas caídas."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.EEL
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.EEL"
msgid "A slippery soul, that one."
msgstr "Un alma resbaladiza."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.EEL_COOKED
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.EEL_COOKED"
msgid "I'd rather not put that in my flesh body."
msgstr "Prefiero no meterme eso en mi cuerpo de carne."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.EGGPLANT
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.EGGPLANT"
msgid "I've never seen such a thing before!"
msgstr "¡Nunca había visto algo semejante!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.EGGPLANT_COOKED
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.EGGPLANT_COOKED"
msgid "My favorite treat... it can't be beat!"
msgstr "Mi plato favorito... ¡No comerlo es un delito!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.EGGPLANT_OVERSIZED
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.EGGPLANT_OVERSIZED"
msgid "How strange!"
msgstr "¡Qué raro!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.EGGPLANT_SEEDS
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.EGGPLANT_SEEDS"
msgid "Let's give them some soil, before they spoil."
msgstr "Démosles un poco de tierra antes de que se pierdan."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.ELIXIR_CONTAINER
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.ELIXIR_CONTAINER"
msgid "Any mixers for those elixirs?"
msgstr ""

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.EMBERLIGHT
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.EMBERLIGHT"
msgid "Aren't you a bit big for a will-o'-the-wisp?"
msgstr "¿No eres un poco grande para ser un destello andante?"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.ENDTABLE.BURNT
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.ENDTABLE.BURNT"
msgid "That was hardly necessary."
msgstr "Eso no era necesario."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.ENDTABLE.EMPTY
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.ENDTABLE.EMPTY"
msgid "Now now, let's set the table."
msgstr "Bueno, bueno, pongamos la mesa."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.ENDTABLE.FRESHLIGHT
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.ENDTABLE.FRESHLIGHT"
msgid "A light so bright I might still see at night!"
msgstr "¡Una luz tan brillante que puedo ver en cualquier parte!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.ENDTABLE.GENERIC
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.ENDTABLE.GENERIC"
msgid "I never learned my table manners."
msgstr "Nunca aprendí modales en la mesa."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.ENDTABLE.OLDLIGHT
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.ENDTABLE.OLDLIGHT"
msgid "I'll try not to pout when that light soon goes out."
msgstr "Trataré de no llorar ahora que la luz se va a apagar."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.ENDTABLE.WILTED
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.ENDTABLE.WILTED"
msgid "Tiny flower on the table... you aren't looking very stable."
msgstr "Florcita sobre la mesa, estás un poco aviesa."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.EVERGREEN.BURNING
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.EVERGREEN.BURNING"
msgid "Twiddle dee dee, a burning tree!"
msgstr "¡Laralalaralá, el árbol arderá!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.EVERGREEN.BURNT
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.EVERGREEN.BURNT"
msgid "Well, that was fun."
msgstr "Bueno, fue divertido."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.EVERGREEN.CHOPPED
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.EVERGREEN.CHOPPED"
msgid "A funny tree prank."
msgstr "Una broma graciosa con el árbol."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.EVERGREEN.GENERIC
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.EVERGREEN.GENERIC"
msgid "A hearty tree of dark green leaves."
msgstr "Un árbol frondoso de hojas de color verde oscuro."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.EVERGREEN_SPARSE.BURNING
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.EVERGREEN_SPARSE.BURNING"
msgid "Twiddle dee dee, a burning tree!"
msgstr "¡Laralalaralá, el árbol arderá!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.EVERGREEN_SPARSE.BURNT
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.EVERGREEN_SPARSE.BURNT"
msgid "Well, that was fun."
msgstr "Bueno, fue divertido."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.EVERGREEN_SPARSE.CHOPPED
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.EVERGREEN_SPARSE.CHOPPED"
msgid "A funny tree prank."
msgstr "Una broma graciosa con el árbol."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.EVERGREEN_SPARSE.GENERIC
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.EVERGREEN_SPARSE.GENERIC"
msgid "A mournful tree full of lumps and bumps."
msgstr "Un árbol triste lleno de nudos y más nudos."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.EYEBRELLAHAT
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.EYEBRELLAHAT"
msgid "A cyclops' sight stretched mighty thin."
msgstr "La vista del cíclope ahora es más poderosa."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.EYEMASKHAT
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.EYEMASKHAT"
msgid "Well, isn't this a sight for sore eyes. Hyuyuyu!"
msgstr "¡Qué regalo para mis ojos ya cansados! ¡Jiu, ju!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.EYEOFTERROR
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.EYEOFTERROR"
msgid "Whatever he says I did, it's a lie!"
msgstr "¡Sea lo que sea que haya dicho, es mentira!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.EYEOFTERROR_MINI
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.EYEOFTERROR_MINI"
msgid "I feel positively terror eyes'd!"
msgstr "¡Siento algo terror-ojo!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.EYEOFTERROR_MINI_GROUNDED
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.EYEOFTERROR_MINI_GROUNDED"
msgid "Oh my, won't you open your eye?"
msgstr "Ay, cielos. ¿Puedes abrir los ojos?"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.EYEPLANT
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.EYEPLANT"
msgid "My oh my, what a lovely eye."
msgstr "Ah, vaya, qué ojo tan bonito."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.EYETURRET
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.EYETURRET"
msgid "Oh me oh my, look at that eye!"
msgstr "¡Qué ojo tan bonito! ¡Cuando lo veo me derrito!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.EYETURRET_ITEM
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.EYETURRET_ITEM"
msgid "To build it would be all it took to fell my foes by deadly look."
msgstr "Construirla fue una gozada para derrotar a mis enemigos con la mirada."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.FARMPLOT.BURNT
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.FARMPLOT.BURNT"
msgid "A silly prank to be sure."
msgstr "Una broma tonta, está claro."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.FARMPLOT.GENERIC
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.FARMPLOT.GENERIC"
msgid "Mortal food maker."
msgstr "Crea alimentos mortales."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.FARMPLOT.GROWING
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.FARMPLOT.GROWING"
msgid "The mortals are making mortal food."
msgstr "Los mortales están creando comida mortal."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.FARMPLOT.NEEDSFERTILIZER
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.FARMPLOT.NEEDSFERTILIZER"
msgid "The semi-formed food is hungry."
msgstr "La comida semiformada tiene hambre."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.FARM_HOE
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.FARM_HOE"
msgid "I've about had my fill of tilling and toiling."
msgstr "Me estoy cansando de labrar y sudar."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.FARM_PLANT.BURNING
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.FARM_PLANT.BURNING"
msgid "Hyuyuyu, whoopsie!"
msgstr "Jiu, ju, ju, ¡upsi!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.FARM_PLANT.FULL
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.FARM_PLANT.FULL"
msgid "Oh what a sight, the crops are ripe!"
msgstr "¡Oh, qué maravilla, las cosechas listas!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.FARM_PLANT.FULL_OVERSIZED
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.FARM_PLANT.FULL_OVERSIZED"
msgid "If only I cared to eat mortal food!"
msgstr "¡Si tan solo pudiese comer comida de mortales!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.FARM_PLANT.FULL_WEED
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.FARM_PLANT.FULL_WEED"
msgid "It's a weed indeed! Hyuyuyu!"
msgstr "Una hierba, ¡jiu, ju!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.FARM_PLANT.GENERIC
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.FARM_PLANT.GENERIC"
msgid "A plant!"
msgstr "¡Una planta!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.FARM_PLANT.GROWING
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.FARM_PLANT.GROWING"
msgid "Grow big and tall, or not at all."
msgstr "¡Crece alto, crece mucho, o serás un debilucho!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.FARM_PLANT.ROTTEN
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.FARM_PLANT.ROTTEN"
msgid "Even the mortals won't eat this one."
msgstr "Ni los mortales se comerán esto."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.FARM_PLANT.ROTTEN_OVERSIZED
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.FARM_PLANT.ROTTEN_OVERSIZED"
msgid "This one's spoiled rotten!"
msgstr "¡Está podrido y corrompido!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.FARM_PLANT.SEED
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.FARM_PLANT.SEED"
msgid "Come out and join us, little one!"
msgstr "¡Sal y únete, pequeñín!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.FARM_PLOW
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.FARM_PLOW"
msgid "Plowing a plot for picky plants."
msgstr "Preparando el terreno para plantas en pleno sueño."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.FARM_PLOW_ITEM
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.FARM_PLOW_ITEM"
msgid "All work and no play makes for one unhappy imp."
msgstr "Trabajar y no jugar me hace querer abandonar."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.FARM_SOIL_DEBRIS
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.FARM_SOIL_DEBRIS"
msgid "I'm afraid I'll have to banish it from the garden."
msgstr "Me temo que tendré que eliminarlo del jardín."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.FEATHERFAN
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.FEATHERFAN"
msgid "It makes a big gust. What's all the fuss?"
msgstr "Crea un gran viento. ¿Por qué tanto desaliento?"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.FEATHERHAT
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.FEATHERHAT"
msgid "Feathers and horns go well together."
msgstr "Las plumas y los cuernos combinan bien."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.FEATHERPENCIL
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.FEATHERPENCIL"
msgid "Use this quill, I will, I will."
msgstr "Usaré esta pluma, no cabe duda."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.FEATHER_CANARY
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.FEATHER_CANARY"
msgid "A token, to remember its sweet song by."
msgstr "Un recuerdo para recordar su dulce canto."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.FEATHER_CROW
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.FEATHER_CROW"
msgid "A memento of my jet feathered friend."
msgstr "Un recuerdo de mi amigo con plumas."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.FEATHER_ROBIN
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.FEATHER_ROBIN"
msgid "To remind myself of its sweet beaky face."
msgstr "Para acordarme de su tierno rostro picudo."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.FEATHER_ROBIN_WINTER
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.FEATHER_ROBIN_WINTER"
msgid "A keepsake of a gentle blue friend."
msgstr "Un recuerdo de un delicado amigo azul."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.FEM_PUPPET
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.FEM_PUPPET"
msgid "Greetings and salutations, ma'am."
msgstr "Saludos, señora."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.FENCE
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.FENCE"
msgid "To keep you out, or keep me in?"
msgstr "¿Para dejarte afuera o para encerrarme adentro?"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.FENCE_GATE
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.FENCE_GATE"
msgid "For temporary visiting."
msgstr "Para visitas temporales."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.FENCE_GATE_ITEM
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.FENCE_GATE_ITEM"
msgid "It's of no use there on the ground."
msgstr "No sirve de nada en el suelo."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.FENCE_ITEM
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.FENCE_ITEM"
msgid "It's of no use there on the ground."
msgstr "No sirve de nada en el suelo."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.FENCE_JUNK
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.FENCE_JUNK"
msgid "A metal fence for our defense."
msgstr "Una valla de metal para evitar el mal."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.FENCE_ROTATOR
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.FENCE_ROTATOR"
msgid "A sword against fences... we've all lost our senses!"
msgstr "Con la espada en mano, nos volvemos insanos."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.FERTILIZER
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.FERTILIZER"
msgid "Hyuyu! That's some poo!"
msgstr "¡Jiu, ju! ¡Un poco de caca!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.FESTIVEFISH
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.FESTIVEFISH"
msgid "Nothing fishy here at all, hyuyu!"
msgstr "Por aquí nada huele mal, ¡jiu, ju!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.FESTIVE_BLUEPRINT
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.FESTIVE_BLUEPRINT"
msgid "My friend can frolic in this festive frock!"
msgstr "Juega con su vestido, ¡qué lindo, qué divertido!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.FIG
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.FIG"
msgid "They say the low hanging fruit is the sweetest!"
msgstr "Fruta que está a la vista es la que siempre conquista."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.FIGATONI
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.FIGATONI"
msgid "I'll pass."
msgstr "Yo paso."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.FIGKABAB
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.FIGKABAB"
msgid "Food on a stick won't do the trick."
msgstr "Comida en palito no llena el apetito."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.FIG_COOKED
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.FIG_COOKED"
msgid "The mortals seem to prefer it this way."
msgstr "Parece que los mortales prefieren esta versión."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.FIREBALLSTAFF
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.FIREBALLSTAFF"
msgid "Ooohoo, how delightfully chaotic!"
msgstr "¡Oooh, qué caos, qué maravilla!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.FIRECRACKERS
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.FIRECRACKERS"
msgid "Pop, pop!"
msgstr "¡Pop, pop!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.FIREFLIES.GENERIC
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.FIREFLIES.GENERIC"
msgid "Some natural light to grant me sight."
msgstr "Un poco de luz natural para poder ver más."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.FIREFLIES.HELD
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.FIREFLIES.HELD"
msgid "Little jittery, fluttery souls."
msgstr "Pequeñas almas nerviosas y revoloteantes."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.FIREHOUND
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.FIREHOUND"
msgid "Hyuyu, fiery!"
msgstr "¡Jiu, ju, qué ardiente!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.FIRENETTLES
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.FIRENETTLES"
msgid "Oh ho! Fiery indeed!"
msgstr "¡Jiu, ju, sí que es ardiente!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.FIREPEN
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.FIREPEN"
msgid "Hyuyuyu, the old flaming pen prank!"
msgstr "¡Jiu, ju, la broma del bolígrafo ardiente!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.FIREPIT.EMBERS
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.FIREPIT.EMBERS"
msgid "Soon to extinguish."
msgstr "Pronto se extinguirá."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.FIREPIT.GENERIC
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.FIREPIT.GENERIC"
msgid "This fire will slake my thirst for warmth."
msgstr "Este fuego apagará mi sed de calor."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.FIREPIT.HIGH
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.FIREPIT.HIGH"
msgid "Those are some spicy flames."
msgstr "Qué llamas tan fieras."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.FIREPIT.LOW
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.FIREPIT.LOW"
msgid "It burns so low, so low!"
msgstr "¡Arde poco, muy poco!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.FIREPIT.NORMAL
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.FIREPIT.NORMAL"
msgid "When I roam, camp feels like home."
msgstr "Cuando salgo a rondar, el campamento es mi hogar."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.FIREPIT.OUT
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.FIREPIT.OUT"
msgid "And out it goes."
msgstr "Y se apagó."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.FIRESTAFF
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.FIRESTAFF"
msgid "It makes fire by its own magic."
msgstr "Hace fuego con su propia magia."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.FIRESUPPRESSOR.LOWFUEL
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.FIRESUPPRESSOR.LOWFUEL"
msgid "It hungers for souls! Or fuel."
msgstr "¡Tiene hambre de almas! O de combustible."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.FIRESUPPRESSOR.OFF
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.FIRESUPPRESSOR.OFF"
msgid "Dead to the world."
msgstr "Muerto para el mundo."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.FIRESUPPRESSOR.ON
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.FIRESUPPRESSOR.ON"
msgid "It is ready to fling at a moment's notice."
msgstr "Está listo para lanzar en cualquier momento."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.FISH
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.FISH"
msgid "You are quite fragrant."
msgstr "Qué aromático eres."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.FISHINGNET
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.FISHINGNET"
msgid "A riddle! What might one cast that's not a spell?"
msgstr "¡Un acertijo! ¿Qué se lanza y no es un maleficio?"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.FISHINGROD
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.FISHINGROD"
msgid "A mortal pastime."
msgstr "Un pasatiempo mortal."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.FISHMEAT
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.FISHMEAT"
msgid "Looks like the soul's already left this one."
msgstr "Parece que este ya no tiene alma."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.FISHMEAT_COOKED
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.FISHMEAT_COOKED"
msgid "I do not wish to eat this fish."
msgstr "No tengo ningún deseo de comerme este pescado."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.FISHMEAT_SMALL
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.FISHMEAT_SMALL"
msgid "Looks like the soul's already left this one."
msgstr "Parece que este ya no tiene alma."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.FISHMEAT_SMALL_COOKED
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.FISHMEAT_SMALL_COOKED"
msgid "I do not wish to eat this fish."
msgstr "No tengo ningún deseo de comerme este pescado."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.FISHSTICKS
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.FISHSTICKS"
msgid "No thank-you."
msgstr "No, gracias."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.FISHTACOS
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.FISHTACOS"
msgid "More mortal food."
msgstr "Más comida mortal."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.FISH_BOX
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.FISH_BOX"
msgid "Fill it to the brim with bream!"
msgstr "¡Que esté hasta arriba de besugos!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.FISH_COOKED
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.FISH_COOKED"
msgid "At least it isn't suffering anymore."
msgstr "Al menos ya no sufre."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.FLINT
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.FLINT"
msgid "My eye was caught by its dull glint."
msgstr "Quedé anonadado con su brillo tenue."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.FLOWER.GENERIC
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.FLOWER.GENERIC"
msgid "Perfumed petals to pick and pluck."
msgstr "Pétalos perfumados para arrancar y llevar."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.FLOWER.ROSE
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.FLOWER.ROSE"
msgid "It's as red as I am."
msgstr "Es tan roja como yo."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.FLOWERHAT
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.FLOWERHAT"
msgid "I'll place a crown upon my head to ward away the growing dread."
msgstr "Me pondré una corona en lo alto para mantener alejado el espanto."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.FLOWERSALAD
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.FLOWERSALAD"
msgid "I don't really like eating."
msgstr "En realidad, no me gusta comer."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.FLOWER_CAVE
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.FLOWER_CAVE"
msgid "How kind of you to light my way."
msgstr "Qué amable de tu parte iluminar mi camino."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.FLOWER_EVIL
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.FLOWER_EVIL"
msgid "It's not its fault it's evil."
msgstr "No tiene la culpa de ser malvada."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.FLOWER_WITHERED
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.FLOWER_WITHERED"
msgid "Farewell sweet petals."
msgstr "Adiós, dulces pétalos."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.FOLIAGE
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.FOLIAGE"
msgid "Purpled leaves from down below."
msgstr "Hojas moradas de abajo."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.FOOTBALLHAT
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.FOOTBALLHAT"
msgid "I hope I don't get helmet horns."
msgstr "Espero que no me pongan cuernos en el casco."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.FORGETMELOTS
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.FORGETMELOTS"
msgid "They seems to have a tinge of magic about them."
msgstr "Hay algo mágico en ellos."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.FORMAL_BLUEPRINT
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.FORMAL_BLUEPRINT"
msgid "But will it really suit my beefalo? Hyuyu!"
msgstr "¿Pero quedará bien en mi bífalo? ¡Jiu, ju!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.FOSSIL_PIECE
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.FOSSIL_PIECE"
msgid "A little piece of a great big beast."
msgstr "Un pedacito de una gran bestia."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.FOSSIL_STALKER.COMPLETE
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.FOSSIL_STALKER.COMPLETE"
msgid "That looks right as rain, it does it does!"
msgstr "¡Qué bonito bajo la lluvia! ¡Sí, sí!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.FOSSIL_STALKER.FUNNY
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.FOSSIL_STALKER.FUNNY"
msgid "A silly look, that's to be sure!"
msgstr "¡Qué gracioso, sin duda!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.FOSSIL_STALKER.GENERIC
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.FOSSIL_STALKER.GENERIC"
msgid "Still could use a piece or two."
msgstr "Todavía le vendrían bien un par de piezas."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.FRESHFRUITCREPES
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.FRESHFRUITCREPES"
msgid "Fruits and berries put to bed."
msgstr "Frutas y frutos en su camita."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.FRIENDLYFRUITFLY
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.FRIENDLYFRUITFLY"
msgid "This fly has a much more tempered temper."
msgstr "Esta mosca tiene un temperamento mucho más moderado."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.FROG.DEAD
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.FROG.DEAD"
msgid "I am sorry! So sorry!"
msgstr "¡Lo siento! ¡Lo siento mucho!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.FROG.GENERIC
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.FROG.GENERIC"
msgid "I hop, you hop. Friends til the end!"
msgstr "Yo salto, tú saltas. ¡Amigos hasta el final!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.FROG.SLEEPING
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.FROG.SLEEPING"
msgid "Sleep fast little hopper."
msgstr "Duerme, amigo saltarín."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.FROGFISHBOWL
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.FROGFISHBOWL"
msgid "I'd rather have a nice fresh soul."
msgstr "Preferiría una buena alma fresca."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.FROGGLEBUNWICH
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.FROGGLEBUNWICH"
msgid "Mortals are weird."
msgstr "Los mortales son raros."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.FROGLEGS
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.FROGLEGS"
msgid "To hop no more."
msgstr "Ya no saltará."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.FROGLEGS_COOKED
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.FROGLEGS_COOKED"
msgid "Definitely no more hopping."
msgstr "Esto de saltar se terminó."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.FROGNEWTON
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.FROGNEWTON"
msgid "How do the mortals come up with these things?"
msgstr "A los mortales se les ocurre cada cosa..."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.FROZENBANANADAIQUIRI
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.FROZENBANANADAIQUIRI"
msgid "Don't the mortals like to innovate? Hyuyu."
msgstr "¿A los mortales les gusta innovar? Jiu, ju."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.FRUITDRAGON.GENERIC
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.FRUITDRAGON.GENERIC"
msgid "Little lizard, sharp and pointy!"
msgstr "Pequeño lagarto, ¡afilado y puntiagudo!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.FRUITDRAGON.RIPE
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.FRUITDRAGON.RIPE"
msgid "That color looks great on you, hyuyu!"
msgstr "Ese color te queda genial, ¡jiu, ju!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.FRUITDRAGON.SLEEPING
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.FRUITDRAGON.SLEEPING"
msgid "Hyuyu, catching some shuteye are we?"
msgstr "Jiu, ju, ¿echando un sueñecito?"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.FRUITFLY
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.FRUITFLY"
msgid "Pulling pranks on the plants, I see!"
msgstr "Bromas en el jardín, ¡no hay fin!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.FRUITFLYFRUIT
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.FRUITFLYFRUIT"
msgid "I'll just put that in my pocket and see what happens!"
msgstr "¡Lo pondré en mi bolsillo y veré qué pasa!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.FRUITMEDLEY
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.FRUITMEDLEY"
msgid "The mortals threw a bunch of plants together."
msgstr "Los mortales juntaron un montón de plantas."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.FURTUFT
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.FURTUFT"
msgid "Not from my chest!"
msgstr "¡No es de mi pecho!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.FUSED_SHADELING
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.FUSED_SHADELING"
msgid "The stuff of nightmares!"
msgstr "¡La materia de las pesadillas!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.FUSED_SHADELING_BOMB
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.FUSED_SHADELING_BOMB"
msgid "Keep away, I don't want to play!"
msgstr "¡Aléjate! ¡No quiero jugar!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.GARGOYLE_HOUND
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.GARGOYLE_HOUND"
msgid "I hope that hellhound's in on the prank."
msgstr "Espero que ese sabueso esté jugando alguna broma."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.GARGOYLE_WEREPIG
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.GARGOYLE_WEREPIG"
msgid "Let's not be here when that wakes up!"
msgstr "¡Será mejor no estar aquí cuando despierte!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.GARLIC
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.GARLIC"
msgid "Hissss!"
msgstr "¡Hissss!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.GARLIC_COOKED
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.GARLIC_COOKED"
msgid "Hissssss!"
msgstr "¡Hissssss!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.GARLIC_OVERSIZED
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.GARLIC_OVERSIZED"
msgid "Hissssss!"
msgstr "¡Hissssss!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.GARLIC_SEEDS
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.GARLIC_SEEDS"
msgid "Strange little seeds, indeed, indeed."
msgstr "Unas semillitas peculiares por estos lares."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.GAZPACHO
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.GAZPACHO"
msgid "This human food stuff seems more watery than usual."
msgstr "Esta comida humana parece más acuosa de lo normal."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.GEARS
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.GEARS"
msgid "Grind them and grind them well."
msgstr "Muele y muele bien."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.GELBLOB.GENERIC
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.GELBLOB.GENERIC"
msgid "Ick! It sticks!"
msgstr "¡Agh! ¡Se pegotea todo!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.GELBLOB.HAS_CHARACTER
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.GELBLOB.HAS_CHARACTER"
msgid "They're frowning because they're drowning! Hyuyu!"
msgstr "Están gruñones porque se ahogan en montones. ¡Jiu, ju!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.GELBLOB.HAS_ITEM
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.GELBLOB.HAS_ITEM"
msgid "Enough with the guff! Let's get that stuff!"
msgstr "¡Basta de tanto hablar, hay que trabajar!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.GELBLOB_BOTTLE
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.GELBLOB_BOTTLE"
msgid "Bottled abomination."
msgstr "Una abominación embotellada."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.GELBLOB_STORAGE.FULL
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.GELBLOB_STORAGE.FULL"
msgid "Congealed and sealed!"
msgstr "¡Solidificado y sellado!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.GELBLOB_STORAGE.GENERIC
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.GELBLOB_STORAGE.GENERIC"
msgid "I do declare, there's nothing there."
msgstr "Declaro con razón, no hay nada en cuestión."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.GELBLOB_STORAGE_KIT
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.GELBLOB_STORAGE_KIT"
msgid "Grrr... Not on the fur!"
msgstr "Grr... ¡en la piel no!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.GEMSOCKET.GEMS
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.GEMSOCKET.GEMS"
msgid "It could use some shine, if you ask me."
msgstr "Le hace falta algo de brillo, en mi opinión."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.GEMSOCKET.VALID
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.GEMSOCKET.VALID"
msgid "Magic always does provide!"
msgstr "¡La magia siempre vence!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.GESTALT
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.GESTALT"
msgid "Good evening, children!"
msgstr "¡Buenas tardes, niños!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.GESTALT_GUARD
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.GESTALT_GUARD"
msgid "They grow up so fast!"
msgstr "Crecen muy rápido."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.GHOST
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.GHOST"
msgid "An unclaimed soul!"
msgstr "¡Un alma no reclamada!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.GHOSTFLOWER
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.GHOSTFLOWER"
msgid "What a fetching phantom flower."
msgstr "Qué flor fantasma más encantadora."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.GHOSTFLOWERHAT
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.GHOSTFLOWERHAT"
msgid "Ghostly flowers yield strange powers."
msgstr ""

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.GHOSTLYELIXIR_ATTACK
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.GHOSTLYELIXIR_ATTACK"
msgid "Hyuyu! Someone's getting crafty!"
msgstr "¡Jiu, ju! ¡Alguien está siendo muy inteligente!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.GHOSTLYELIXIR_FASTREGEN
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.GHOSTLYELIXIR_FASTREGEN"
msgid "Hyuyu! Someone's getting crafty!"
msgstr "¡Jiu, ju! ¡Alguien está siendo muy inteligente!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.GHOSTLYELIXIR_LUNAR
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.GHOSTLYELIXIR_LUNAR"
msgid "Hyuyu! Someone's getting crafty!"
msgstr "¡Jiu, ju! ¡Alguien está siendo muy inteligente!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.GHOSTLYELIXIR_RETALIATION
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.GHOSTLYELIXIR_RETALIATION"
msgid "Hyuyu! Someone's getting crafty!"
msgstr "¡Jiu, ju! ¡Alguien está siendo muy inteligente!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.GHOSTLYELIXIR_REVIVE
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.GHOSTLYELIXIR_REVIVE"
msgid "Hyuyu! Someone's getting crafty!"
msgstr "¡Jiu, ju! ¡Alguien está siendo muy inteligente!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.GHOSTLYELIXIR_SHADOW
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.GHOSTLYELIXIR_SHADOW"
msgid "Hyuyu! Someone's getting crafty!"
msgstr "¡Jiu, ju! ¡Alguien está siendo muy inteligente!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.GHOSTLYELIXIR_SHIELD
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.GHOSTLYELIXIR_SHIELD"
msgid "Hyuyu! Someone's getting crafty!"
msgstr "¡Jiu, ju! ¡Alguien está siendo muy inteligente!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.GHOSTLYELIXIR_SLOWREGEN
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.GHOSTLYELIXIR_SLOWREGEN"
msgid "Hyuyu! Someone's getting crafty!"
msgstr "¡Jiu, ju! ¡Alguien está siendo muy inteligente!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.GHOSTLYELIXIR_SPEED
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.GHOSTLYELIXIR_SPEED"
msgid "Hyuyu! Someone's getting crafty!"
msgstr "¡Jiu, ju! ¡Alguien está siendo muy inteligente!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.GIFT
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.GIFT"
msgid "Presents! How fun!"
msgstr "¡Regalos! ¡Qué divertido!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.GIFTWRAP
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.GIFTWRAP"
msgid "That's a wrap!"
msgstr "Quedó bien envuelto."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.GINGERBREADHOUSE
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.GINGERBREADHOUSE"
msgid "What a charming cookie cottage."
msgstr "Qué cabaña de galleta más encantadora."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.GINGERBREADPIG
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.GINGERBREADPIG"
msgid "Here little piggy!"
msgstr "¡Hola, cerdito!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.GINGERBREADWARG
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.GINGERBREADWARG"
msgid "That cookie wants to sink its teeth into me!"
msgstr "¡Esa galleta quiere hincarme el diente!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.GLASSBLOCK
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.GLASSBLOCK"
msgid "A pretty spire, made of glass."
msgstr "Un pincho bonito hecho de vidrio."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.GLASSCUTTER
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.GLASSCUTTER"
msgid "Oh, I'm sure I'll have fun with this. Hyuyu!"
msgstr "Oh, seguro que me voy a divertir con esto. ¡Jiu, ju!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.GLASSSPIKE
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.GLASSSPIKE"
msgid "Sharp and pointy as my tooth!"
msgstr "¡Afilado y puntiagudo como mi diente!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.GLOMMER.GENERIC
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.GLOMMER.GENERIC"
msgid "What thoughts lurk within that curious noggin?"
msgstr "¿Qué pensamientos se esconden en esa cabecita?"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.GLOMMER.SLEEPING
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.GLOMMER.SLEEPING"
msgid "If only I were a sleep demon."
msgstr "Ojalá fuera un demonio del sueño."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.GLOMMERFLOWER.DEAD
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.GLOMMERFLOWER.DEAD"
msgid "Oh no, oh dear!"
msgstr "¡Oh, no! ¡Oh, cielos!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.GLOMMERFLOWER.GENERIC
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.GLOMMERFLOWER.GENERIC"
msgid "A flower that attracts a friend."
msgstr "Una flor que atrae a un amigo."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.GLOMMERFUEL
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.GLOMMERFUEL"
msgid "This stuff's so funny!"
msgstr "¡Qué divertido!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.GLOMMERWINGS
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.GLOMMERWINGS"
msgid "How dainty!"
msgstr "¡Qué delicada!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.GLOWBERRYMOUSSE
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.GLOWBERRYMOUSSE"
msgid "Seems like a lot of effort for something you eat."
msgstr "Parece demasiado esfuerzo para algo que te vas a comer."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.GNARWAIL.BROKENHORN
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.GNARWAIL.BROKENHORN"
msgid "I don't see your point, hyuyu!"
msgstr "No le veo el punto, ¡jiu, ju!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.GNARWAIL.BROKENHORN_FOLLOWER
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.GNARWAIL.BROKENHORN_FOLLOWER"
msgid "I'm afraid I don't have any spare horns."
msgstr "Me temo que no tengo cuernos de sobra."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.GNARWAIL.FOLLOWER
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.GNARWAIL.FOLLOWER"
msgid "Come along, there's a sea full of mischief to be had!"
msgstr "¡Ven conmigo, hay un océano de diabluras que cometer!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.GNARWAIL.GENERIC
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.GNARWAIL.GENERIC"
msgid "Now now, no need to put a dent in my dinghy."
msgstr "No hay necesidad de aboyar mi bote, eh."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.GNARWAIL_HORN
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.GNARWAIL_HORN"
msgid "It makes a compelling point, hyuyu!"
msgstr "Con esa asta cualquiera dice basta, ¡jiu, ju!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.GOATMILK
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.GOATMILK"
msgid "Please, no thanks."
msgstr "Por favor, no, gracias."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.GOGGLESHAT
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.GOGGLESHAT"
msgid "I have to keep up appearances."
msgstr "Tengo que mantener las apariencias."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.GOLDENAXE
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.GOLDENAXE"
msgid "Now where's my golden fiddle?"
msgstr "Bueno, ¿dónde está mi violín dorado?"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.GOLDENPICKAXE
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.GOLDENPICKAXE"
msgid "The mortals say you have to spend gold to make gold."
msgstr "Los mortales dicen que hay que gastar oro para conseguir oro."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.GOLDENPITCHFORK
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.GOLDENPITCHFORK"
msgid "Fancy mob gear. Hyuyu!"
msgstr "Una bonita herramienta para turbas iracundas. ¡Jiu, ju!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.GOLDENSHOVEL
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.GOLDENSHOVEL"
msgid "Luxuriously unnecessary! Hyuyu!"
msgstr "¡Cuánto lujo innecesario! ¡Jiu, ju!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.GOLDEN_FARM_HOE
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.GOLDEN_FARM_HOE"
msgid "How splendidly excessive! Hyuyu!"
msgstr "¡Qué espléndida y excesiva! ¡Jiu, ju!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.GOLDNUGGET
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.GOLDNUGGET"
msgid "Money is soulless."
msgstr "El dinero no tiene alma."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.GOOSE_FEATHER
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.GOOSE_FEATHER"
msgid "This feather may help one brave hot weather."
msgstr "Esta pluma ayuda a combatir el calor con bravura."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.GRASS.BARREN
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.GRASS.BARREN"
msgid "Salted earth, none will return."
msgstr "Tierra salada, no crecerá nada."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.GRASS.BURNING
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.GRASS.BURNING"
msgid "Whoops-a-doodle."
msgstr "Metí la pata."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.GRASS.DISEASED
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.GRASS.DISEASED"
msgid "Now it stinks really good!"
msgstr "¡Ahora sí que apesta!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.GRASS.DISEASING
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.GRASS.DISEASING"
msgid "It's started to stink."
msgstr "Empezó a apestar."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.GRASS.GENERIC
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.GRASS.GENERIC"
msgid "Grass that grows from richest earth."
msgstr "Césped que crece en tierra fértil."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.GRASS.PICKED
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.GRASS.PICKED"
msgid "Gone, all gone."
msgstr "No queda nada de nada."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.GRASS.WITHERED
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.GRASS.WITHERED"
msgid "Feeling down, are you?"
msgstr "Estás deprimido, ¿verdad?"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.GRASSGATOR
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.GRASSGATOR"
msgid "See you later, gator."
msgstr "Qué galán, caimán."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.GRASSGEKKO.DISEASED
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.GRASSGEKKO.DISEASED"
msgid "I can see the disease creeping into your soul."
msgstr "Veo la enfermedad que te devora el alma."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.GRASSGEKKO.GENERIC
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.GRASSGEKKO.GENERIC"
msgid "Hello dear friend! No need to drop your tail."
msgstr "¡Hola, querido amigo! No hace falta que dejes caer la cola."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.GRASS_UMBRELLA
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.GRASS_UMBRELLA"
msgid "A tool to keep the rain away."
msgstr "Una herramienta para alejar la lluvia."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.GRAVY
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.GRAVY"
msgid "It sits in a boat that doesn't float."
msgstr "Está en un bote que no hay quien reflote."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.GREENAMULET
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.GREENAMULET"
msgid "So I'll be more skilled when I rebuild."
msgstr "Seré más diestro cuando reconstruya con esto."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.GREENGEM
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.GREENGEM"
msgid "Gentlest green from lush vales gleaned."
msgstr "El verde más verde de los más exuberantes valles."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.GREENMOONEYE
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.GREENMOONEYE"
msgid "This eye of green wishes to be seen!"
msgstr "¡Este ojo verde quiere que lo vea la gente!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.GREENSTAFF
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.GREENSTAFF"
msgid "Do not treat it like a toy. Its purpose is to destroy."
msgstr "No creas que es para jugar. Su objetivo es aniquilar."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.GREEN_CAP
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.GREEN_CAP"
msgid "These mushrooms play all sorts of tricks."
msgstr "Estos hongos hacen todo tipo de bromas."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.GREEN_CAP_COOKED
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.GREEN_CAP_COOKED"
msgid "That changed it somehow."
msgstr "Eso lo cambió de alguna forma."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.GREEN_MUSHROOM.GENERIC
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.GREEN_MUSHROOM.GENERIC"
msgid "Found you!"
msgstr "¡Te encontré!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.GREEN_MUSHROOM.INGROUND
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.GREEN_MUSHROOM.INGROUND"
msgid "It's playing hide and seek!"
msgstr "¡Está jugando a las escondidas!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.GREEN_MUSHROOM.PICKED
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.GREEN_MUSHROOM.PICKED"
msgid "Gone, all gone."
msgstr "No queda nada de nada."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.GROTTO_POOL_BIG
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.GROTTO_POOL_BIG"
msgid "Perhaps it is home to a nymph."
msgstr "Quizá sea el hogar de una ninfa."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.GROTTO_POOL_SMALL
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.GROTTO_POOL_SMALL"
msgid "Perhaps it is home to a very tiny nymph."
msgstr "Quizá sea el hogar de una ninfa chiquitita."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.GUACAMOLE
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.GUACAMOLE"
msgid "I don't like to eat, unless I have to."
msgstr "No me gusta comer a menos que sea necesario."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.GUANO
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.GUANO"
msgid "It came from a bat, and that is that."
msgstr "Es guano y no es malo, hermano."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.GUNPOWDER
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.GUNPOWDER"
msgid "I'll spell your doom with a mighty BOOM!"
msgstr "¡Escribiré tu destino con explosivo desatino!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.HALLOWEENCANDY_1
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.HALLOWEENCANDY_1"
msgid "Something to sink my fangs into!"
msgstr "¡Algo en lo que clavar mis colmillos!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.HALLOWEENCANDY_10
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.HALLOWEENCANDY_10"
msgid "First time for everything, they say, they say."
msgstr "Siempre hay una primera vez para todo, o eso dicen."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.HALLOWEENCANDY_11
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.HALLOWEENCANDY_11"
msgid "Harumpf, it melts all over my claws."
msgstr "Ejem, se me derrite en las garras."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.HALLOWEENCANDY_12
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.HALLOWEENCANDY_12"
msgid "How delightfully disgusting!"
msgstr "¡Repugnante, pero delicioso!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.HALLOWEENCANDY_13
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.HALLOWEENCANDY_13"
msgid "I'll try a nibble, I will, I will."
msgstr "Probaré un bocado, sí, sí."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.HALLOWEENCANDY_14
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.HALLOWEENCANDY_14"
msgid "Ooo hoo hoo, spicy!"
msgstr "¡Uuuuuuh, qué picante!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.HALLOWEENCANDY_2
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.HALLOWEENCANDY_2"
msgid "I suppose I could eat a delightful treat."
msgstr "Supongo que podría probar un delicioso manjar."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.HALLOWEENCANDY_3
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.HALLOWEENCANDY_3"
msgid "It's just human corn."
msgstr "No es más que maíz humano."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.HALLOWEENCANDY_4
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.HALLOWEENCANDY_4"
msgid "I could be persuaded to try a taste."
msgstr "Tal vez me deje tentar y pruebe un poco."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.HALLOWEENCANDY_5
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.HALLOWEENCANDY_5"
msgid "Fweehee! Little kitties!"
msgstr "¡Ji, ji, ji! ¡Gatitos!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.HALLOWEENCANDY_6
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.HALLOWEENCANDY_6"
msgid "This prank is ingenious!"
msgstr "¡Esta broma es ingeniosa!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.HALLOWEENCANDY_7
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.HALLOWEENCANDY_7"
msgid "Hm... I don't think I'll like that."
msgstr "Mmm... No creo que me guste."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.HALLOWEENCANDY_8
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.HALLOWEENCANDY_8"
msgid "Hyuyu, a candied soul!"
msgstr "¡Jiu, ju, un alma caramelizada!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.HALLOWEENCANDY_9
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.HALLOWEENCANDY_9"
msgid "Hyuyu, it slithers all the way down!"
msgstr "¡Jiu, ju, se mueve mientras baja!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.HALLOWEENPOTION_BRAVERY
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.HALLOWEENPOTION_BRAVERY"
msgid "Tonic of anti-battiness!"
msgstr "¡Una pócima antichifladura!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.HALLOWEENPOTION_DRINKS_POTENT
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.HALLOWEENPOTION_DRINKS_POTENT"
msgid "Hyuyu! This'll put tufts on your chest!"
msgstr "¡Jiu, ju! ¡Con esto te sale pelo en el pecho!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.HALLOWEENPOTION_DRINKS_WEAK
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.HALLOWEENPOTION_DRINKS_WEAK"
msgid "How tame and timid!"
msgstr "¡Qué dócil y tímida!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.HALLOWEENPOTION_FIRE_FX
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.HALLOWEENPOTION_FIRE_FX"
msgid "Firewater!"
msgstr "¡Agua de fuego!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.HALLOWEENPOTION_MOON
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.HALLOWEENPOTION_MOON"
msgid "A brew of switcheroo!"
msgstr "¡Un preparado que metamorfosea!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.HALLOWEEN_ORNAMENT_1
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.HALLOWEEN_ORNAMENT_1"
msgid "It makes me hungry, yes indeed!"
msgstr "¡Me da hambre, oh, sí!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.HALLOWEEN_ORNAMENT_2
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.HALLOWEEN_ORNAMENT_2"
msgid "Absolutely batty!"
msgstr "¡Murcielagoso!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.HALLOWEEN_ORNAMENT_3
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.HALLOWEEN_ORNAMENT_3"
msgid "A creepy crawler for the tree."
msgstr "Un bicho asqueroso para el árbol."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.HALLOWEEN_ORNAMENT_4
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.HALLOWEEN_ORNAMENT_4"
msgid "A swirly whirly tentacle!"
msgstr "¡Un tentáculo muy retorcido!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.HALLOWEEN_ORNAMENT_5
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.HALLOWEEN_ORNAMENT_5"
msgid "Made to dangle from the tree."
msgstr "Hecha para colgar del árbol."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.HALLOWEEN_ORNAMENT_6
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.HALLOWEEN_ORNAMENT_6"
msgid "I do believe it is quite dead!"
msgstr "¡Creo que está bastante muerto!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.HAMBAT
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.HAMBAT"
msgid "I'll bring it down with a mighty hamTHWACK!"
msgstr "¡Lo derribaré de un plumazo con un poderoso muslazo!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.HAMMER
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.HAMMER"
msgid "To drive my points home."
msgstr "Todo entra a martillazos."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.HAMMER_MJOLNIR
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.HAMMER_MJOLNIR"
msgid "Clamor for the hammer!"
msgstr "¡Clamor popular para el martillo brutal!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.HANDPILLOW_BEEFALOWOOL
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.HANDPILLOW_BEEFALOWOOL"
msgid "The beefiest pillow I ever did see."
msgstr "La almohada más bovina que he visto."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.HANDPILLOW_KELP
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.HANDPILLOW_KELP"
msgid "I'd never wish to sleep like a fish."
msgstr "No quiero dormir como un pez."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.HANDPILLOW_PETALS
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.HANDPILLOW_PETALS"
msgid "For a sweet-smelling smack!"
msgstr "¡Para que los golpazos huelan bien!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.HANDPILLOW_STEELWOOL
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.HANDPILLOW_STEELWOOL"
msgid "A nasty thing, it'll do well in the ring!"
msgstr "Qué cosa espantosa para la lucha impiadosa."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.HAREBALL
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.HAREBALL"
msgid "Hyuyu! I see they're seasoned pranksters."
msgstr "¡Jiu, ju! ¡Son bromistas expertos!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.HAWAIIANSHIRT
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.HAWAIIANSHIRT"
msgid "Oh no, that's not really my style."
msgstr "Oh, no, en realidad no es mi estilo."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.HEALINGSALVE
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.HEALINGSALVE"
msgid "To remove the pain of this weary world!"
msgstr "¡Para eliminar el dolor de este mundo tedioso!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.HEALINGSALVE_ACID
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.HEALINGSALVE_ACID"
msgid "It'll heal, seal, even congeal! Get Slimy Salve today! What a steal!"
msgstr "¡Cura, sella, hasta coagula! ¡El bálsamo viscoso es una hermosura!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.HEALINGSTAFF
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.HEALINGSTAFF"
msgid "A little heal will improve how you feel."
msgstr "Un poco de curación mejorará tu situación."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.HEATROCK.COLD
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.HEATROCK.COLD"
msgid "Slightly chilled, to be sure."
msgstr "Un poco fría, sin dudas."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.HEATROCK.FROZEN
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.HEATROCK.FROZEN"
msgid "Frozen hard as a rock! Hyuyu."
msgstr "¡Congelada y dura como una piedra! ¡Jiu, ju!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.HEATROCK.GENERIC
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.HEATROCK.GENERIC"
msgid "My goodness! A rock!"
msgstr "¡Caramba! ¡Una roca!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.HEATROCK.HOT
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.HEATROCK.HOT"
msgid "So cozy it's almost unpleasant."
msgstr "Tan calentita que es casi desagradable."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.HEATROCK.WARM
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.HEATROCK.WARM"
msgid "Quite cozy!"
msgstr "¡Qué calentita!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.HEDGEHOUND
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.HEDGEHOUND"
msgid "You wouldn't eat a fellow trickster, would you?"
msgstr "No te comerías a un colega bromista, ¿no?"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.HEDGEHOUND_BUSH
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.HEDGEHOUND_BUSH"
msgid "Did those vines just whine? I'm sure it's fine."
msgstr "¿Esas enredaderas acaban de chillar? No me voy a preocupar."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.HERMITCRAB
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.HERMITCRAB"
msgid "Hyuyu, let's see if we can't coax this crab out of her shell!"
msgstr "Jiu, ju, ¡veamos si podemos hacer que esa cangreja salga de su caparazón!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.HERMITHOUSE.BUILTUP
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.HERMITHOUSE.BUILTUP"
msgid "A little care can cause remarkable transformations."
msgstr "Un poco de atención puede conseguir grandes cambios."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.HERMITHOUSE.GENERIC
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.HERMITHOUSE.GENERIC"
msgid "What a sad little house for that cranky old louse."
msgstr "Qué triste casita para una cascarrabias viejita."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.HERMIT_BUNDLE
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.HERMIT_BUNDLE"
msgid "A bundle of goodies for our good deeds!"
msgstr "¡Un premio por habernos portado bien!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.HERMIT_BUNDLE_SHELLS
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.HERMIT_BUNDLE_SHELLS"
msgid "Oh swell, a bundle of shells."
msgstr "¡Ah, hola! Muchas caracolas."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.HERMIT_CRACKED_PEARL
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.HERMIT_CRACKED_PEARL"
msgid "A shattered hope."
msgstr "Una esperanza hecha pedazos."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.HERMIT_PEARL
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.HERMIT_PEARL"
msgid "A treasured treasure."
msgstr "Un tesoro atesorado."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.HIVEHAT
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.HIVEHAT"
msgid "Hyuyu! I'm the king!"
msgstr "¡Jiu, ju! ¡Soy el rey!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.HOME
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.HOME"
msgid "Yoohoo! Anyone home?"
msgstr "¡Yuju! ¿Hay alguien en casa?"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.HOMESIGN.BURNT
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.HOMESIGN.BURNT"
msgid "A silly prank to be sure."
msgstr "Una broma tonta, está claro."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.HOMESIGN.GENERIC
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.HOMESIGN.GENERIC"
msgid "\"You are here\" it says, it says."
msgstr "Dice «Usted está aquí», sip."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.HOMESIGN.UNWRITTEN
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.HOMESIGN.UNWRITTEN"
msgid "Nothing to be seen here, I fear."
msgstr "No hay nada que ver aquí, oh, sí."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.HONEY
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.HONEY"
msgid "It can help heal injuries if I use it right."
msgstr "Puede ayudar a curar heridas si la uso bien."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.HONEYCOMB
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.HONEYCOMB"
msgid "Former bee home. Sorry bees."
msgstr "Una antigua casa de abejas. Lo siento, abejas."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.HONEYHAM
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.HONEYHAM"
msgid "Mortals have so many ways of preparing meat."
msgstr "Los mortales tienen muchas formas de preparar carne."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.HONEYNUGGETS
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.HONEYNUGGETS"
msgid "I guess they do look kind of good."
msgstr "Supongo que tienen buen aspecto."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.HORN
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.HORN"
msgid "Phew! Not one of mine."
msgstr "¡Qué alivio! No es mío."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.HORRORFUEL
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.HORRORFUEL"
msgid "A goop most foul."
msgstr "Un pegote espantoso."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.HOTCHILI
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.HOTCHILI"
msgid "I don't \"digest\" well."
msgstr "No «digiero» bien."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.HOTSPRING.BOMBED
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.HOTSPRING.BOMBED"
msgid "Mortals love good smells."
msgstr "A los mortales les encantan los buenos olores."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.HOTSPRING.EMPTY
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.HOTSPRING.EMPTY"
msgid "Oh me, oh my, the spring's run dry."
msgstr "Qué complicado. El agua del manantial se ha terminado."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.HOTSPRING.GENERIC
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.HOTSPRING.GENERIC"
msgid "I don't want to get my fur wet."
msgstr "No me quiero mojar el pelaje."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.HOTSPRING.GLASS
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.HOTSPRING.GLASS"
msgid "All that glass sure froze fast!"
msgstr "El cristal transparente se congeló velozmente."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.HOUND
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.HOUND"
msgid "Hyuyu, you're so badly behaved!"
msgstr "¡Jiu, ju, te portas muy mal!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.HOUNDBONE
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.HOUNDBONE"
msgid "Short work made by gnashing teeth."
msgstr "Obra de una dentadura voraz."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.HOUNDCORPSE.BURNING
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.HOUNDCORPSE.BURNING"
msgid "Sizzle sizzle, pop and crack."
msgstr "Crepita, cruje y chisporrotea."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.HOUNDCORPSE.GENERIC
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.HOUNDCORPSE.GENERIC"
msgid "A corpse is a corpse, of course, of course."
msgstr "Un cadáver es un cadáver, a ver, a ver."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.HOUNDCORPSE.REVIVING
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.HOUNDCORPSE.REVIVING"
msgid "I do believe I'll take my leave!"
msgstr "¡Amigo, creo que me despido!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.HOUNDMOUND
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.HOUNDMOUND"
msgid "It's the dog house!"
msgstr "¡Es la cucha del perro!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.HOUNDSTOOTH
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.HOUNDSTOOTH"
msgid "You cannot compete with my fangs, no, no."
msgstr "No puedes competir con mis colmillos, no, no."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.HOUNDSTOOTH_BLOWPIPE
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.HOUNDSTOOTH_BLOWPIPE"
msgid "A toothsome tooter shooter."
msgstr "Un lanzacolmillos pillo."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.HOUNDWHISTLE
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.HOUNDWHISTLE"
msgid "Ooo, ouch! My ears!"
msgstr "¡Ay, ay! ¡Me duelen los oídos!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.HUTCH
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.HUTCH"
msgid "Hello, hello, my small cave friend."
msgstr "Hola, hola, amiguito de las cuevas."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.HUTCH_FISHBOWL.GENERIC
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.HUTCH_FISHBOWL.GENERIC"
msgid "It is on the inside looking out."
msgstr "Está dentro mirando hacia afuera."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.HUTCH_FISHBOWL.WAITING
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.HUTCH_FISHBOWL.WAITING"
msgid "Its heart is weeping for its friend."
msgstr "Su corazón llora por su amigo."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.ICE
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.ICE"
msgid "It's such a novelty, hyuyu."
msgstr "Qué novedad, jiu, ju."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.ICEBERG.GENERIC
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.ICEBERG.GENERIC"
msgid "Glistening ice, it looks quite nice."
msgstr "Hielo reluciente. Es excelente."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.ICEBERG.MELTED
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.ICEBERG.MELTED"
msgid "Teeny tiny, drippy droppy iceberg."
msgstr "Un tempanito que gotea de a poquito."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.ICEBERG_MELTED
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.ICEBERG_MELTED"
msgid "Teeny tiny, drippy droppy iceberg."
msgstr "Un tempanito que gotea de a poquito."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.ICEBOX
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.ICEBOX"
msgid "Freeze mortal foods for midday feasts."
msgstr "Congela alimentos mortales para festines diurnos."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.ICECREAM
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.ICECREAM"
msgid "I could probably stomach that."
msgstr "Quizás podría soportar comerlo."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.ICEHAT
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.ICEHAT"
msgid "Horns on ice!"
msgstr "¡Cuernos en el hielo!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.ICEHOUND
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.ICEHOUND"
msgid "You wouldn't want to eat an imp. Much too stringy."
msgstr "No te gustaría comer un diablillo. Son demasiados fibrosos."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.ICEPACK
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.ICEPACK"
msgid "Chilly, chilly, to be sure!"
msgstr "¡Sí que está frío!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.ICESTAFF
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.ICESTAFF"
msgid "I'll freeze who I please."
msgstr "Congelo a quien yo quiero."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.ICE_BLUEPRINT
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.ICE_BLUEPRINT"
msgid "I just got chills! Hyuyuyu!"
msgstr "¡Me dio escalofríos! ¡Jiu, ju, ju!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.INSANITYROCK.ACTIVE
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.INSANITYROCK.ACTIVE"
msgid "My mind's in a tizzy!"
msgstr "¡Mi mente está agitada!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.INSANITYROCK.INACTIVE
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.INSANITYROCK.INACTIVE"
msgid "It wants to see me lose my marbles!"
msgstr "¡Quiere que pierda los estribos!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.INSPECTACLESBOX
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.INSPECTACLESBOX"
msgid "only_used_by_winona"
msgstr "only_used_by_winona"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.INSPECTACLESBOX2
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.INSPECTACLESBOX2"
msgid "only_used_by_winona"
msgstr "only_used_by_winona"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.INSPECTACLESHAT.GENERIC
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.INSPECTACLESHAT.GENERIC"
msgid "She's made the decision to follow his vision?"
msgstr "¿Tomó la decisión de seguir su visión?"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.INSPECTACLESHAT.MISSINGSKILL
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.INSPECTACLESHAT.MISSINGSKILL"
msgid "only_used_by_winona"
msgstr "only_used_by_winona"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.INSPECTSELF
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.INSPECTSELF"
msgid "What a handsome devil. Hyuyu!"
msgstr "Qué diablo tan apuesto. ¡Jiu, ju!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.IPECACSYRUP
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.IPECACSYRUP"
msgid "Hyuyu! Who knew the plant was such a prankster?"
msgstr "¡Jiu, ju! ¿Quién diría que esa planta sería tan bromista?"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.IVY_SNARE
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.IVY_SNARE"
msgid "That seemed like an overreaction."
msgstr "Me pareció una exageración."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.JAMMYPRESERVES
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.JAMMYPRESERVES"
msgid "Oh no, it's in my fur."
msgstr "Ay, no. Se me pegó en el pelaje."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.JELLYBEAN
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.JELLYBEAN"
msgid "I do not want those in my bellybean!"
msgstr "¡No los quiero en mi barrigola!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.JUNK_PILE
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.JUNK_PILE"
msgid "Could it hide a surprise inside?"
msgstr "¿Esconderá una sorpresa dentro?"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.JUNK_PILE_BIG
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.JUNK_PILE_BIG"
msgid "I won't fall for that, hyuyu!"
msgstr "¡No me dejaré engañar, jiu, ju!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.JUSTEGGS
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.JUSTEGGS"
msgid "Mortals do love their eggs."
msgstr "A los mortales les encantan los huevos."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.KABOBS
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.KABOBS"
msgid "More mortal food it seems, it seems."
msgstr "Más comida mortal, eso parece."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.KELP
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.KELP"
msgid "Kelp would be of no help."
msgstr "Un alga no presta ayuda que valga."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.KELPHAT
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.KELPHAT"
msgid "To rest uncomfortably upon my horns."
msgstr "Para ponérmelo incómodamente sobre los cuernos."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.KELP_COOKED
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.KELP_COOKED"
msgid "Mortals have such funny tastes."
msgstr "Los mortales tienen gustos muy raros."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.KELP_DRIED
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.KELP_DRIED"
msgid "I do not want it, no siree."
msgstr "No lo quiero. No, señor."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.KILLERBEE.GENERIC
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.KILLERBEE.GENERIC"
msgid "Please don't sting my delicate imp skin."
msgstr "Ni se te ocurra picar mi piel singular."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.KILLERBEE.HELD
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.KILLERBEE.HELD"
msgid "My claws will sting you right back."
msgstr "Yo también te picaré con las garras."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.KITCOONDECOR1.BURNT
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.KITCOONDECOR1.BURNT"
msgid "A burnt toy brings no fun."
msgstr "Un juguete que se quemó a nadie alegró."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.KITCOONDECOR1.GENERIC
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.KITCOONDECOR1.GENERIC"
msgid "Let it spin and wobble if it doesn't squabble."
msgstr "Que gire y se bambolee, si puede."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.KITCOONDECOR1_KIT
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.KITCOONDECOR1_KIT"
msgid "To make a toy is such a joy!"
msgstr "¡Un juguete diversión promete!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.KITCOONDECOR2.BURNT
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.KITCOONDECOR2.BURNT"
msgid "A burnt toy brings no fun."
msgstr "Un juguete que se quemó a nadie alegró."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.KITCOONDECOR2.GENERIC
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.KITCOONDECOR2.GENERIC"
msgid "This fish will be no dish, hyuyu."
msgstr "Este pez no morirá por la boca, jiu, ju."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.KITCOONDECOR2_KIT
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.KITCOONDECOR2_KIT"
msgid "To make a toy is such a joy!"
msgstr "¡Un juguete diversión promete!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.KITCOONDEN.BURNT
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.KITCOONDEN.BURNT"
msgid "Just a little prank, hyuyu!"
msgstr "Es solo una bromita, jiu, ju."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.KITCOONDEN.GENERIC
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.KITCOONDEN.GENERIC"
msgid "Where all the furry mortals go."
msgstr "Donde van todos los mortales peludos."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.KITCOONDEN.PLAYING_HIDEANDSEEK
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.KITCOONDEN.PLAYING_HIDEANDSEEK"
msgid "They've gone out to play!"
msgstr "¡Se fueron a jugar!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.KITCOONDEN.PLAYING_HIDEANDSEEK_TIME_ALMOST_UP
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.KITCOONDEN.PLAYING_HIDEANDSEEK_TIME_ALMOST_UP"
msgid "Playtime's almost over, hyuyu!"
msgstr "Casi se acabó la hora de jugar, jiu, ju."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.KITCOONDEN_KIT
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.KITCOONDEN_KIT"
msgid "They're here to play, or so they say, hyuyu!"
msgstr "Vinieron a jugar. Lo digo sin vacilar. ¡Jiu, ju!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.KITCOON_DECIDUOUS
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.KITCOON_DECIDUOUS"
msgid "I prefer playing with smarter mortals."
msgstr "Prefiero jugar con mortales más inteligentes."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.KITCOON_DESERT
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.KITCOON_DESERT"
msgid "Oh kitty, what big ears you have!"
msgstr "Gatito, qué orejas tan grandes tienes."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.KITCOON_FOREST
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.KITCOON_FOREST"
msgid "They could prank, hide around, and never be found!"
msgstr "Podrían bromear y esconderse, y nadie los podría encontrar."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.KITCOON_GRASS
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.KITCOON_GRASS"
msgid "Ooo, the fingers your fur could prick, hyuyu."
msgstr "¡Tu pelaje podría pinchar muchos dedos, jiu, ju!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.KITCOON_MARSH
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.KITCOON_MARSH"
msgid "There's no tentacle in that fur, right? Hyuyu."
msgstr "Ese pelaje no esconder tentáculos, ¿no? Jiu, ju."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.KITCOON_MOON
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.KITCOON_MOON"
msgid "The kit jumped over the moon, hyuyu!"
msgstr "¡El gatito saltó sobre la luna, jiu, ju!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.KITCOON_NAMETAG
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.KITCOON_NAMETAG"
msgid "To help identify who's theirs and who's mine."
msgstr "Para identificar quién es de quién."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.KITCOON_ROCKY
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.KITCOON_ROCKY"
msgid "Oh my friend, why the stone face?"
msgstr "Amigo, ¿por qué estás con cara de piedra?"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.KITCOON_SAVANNA
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.KITCOON_SAVANNA"
msgid "Your stripes can't trick my eyes!"
msgstr "¡Tus rayas no me engañarán la vista!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.KITCOON_YOT
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.KITCOON_YOT"
msgid "Oh what a date, let's celebrate!"
msgstr "¡Qué fecha especial! Amerita festejar."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.KLAUS
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.KLAUS"
msgid "Are we not brethren?"
msgstr "¿Acaso no somos hermanos?"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.KLAUSSACKKEY
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.KLAUSSACKKEY"
msgid "Now where oh where did he leave that stash."
msgstr "¿Dónde? ¿Dónde habrá guardado ese botín?"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.KLAUS_SACK
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.KLAUS_SACK"
msgid "What tasty treats lie within?"
msgstr "¿Qué manjares habrá dentro?"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.KNIGHT
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.KNIGHT"
msgid "A knight in rusted armor!"
msgstr "¡Un caballero en una armadura oxidada!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.KNIGHT_NIGHTMARE
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.KNIGHT_NIGHTMARE"
msgid "Eep! Play nice with the imp!"
msgstr "¡Ey, pillo! ¡No seas malo con el diablillo!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.KOALEFANT_CARCASS
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.KOALEFANT_CARCASS"
msgid "Once gentle beast, now someone's feast."
msgstr "Una bestia gentil se convirtió en festín."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.KOALEFANT_SUMMER
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.KOALEFANT_SUMMER"
msgid "A gentle beast with tiny horns."
msgstr "Una bestia gentil con cuernitos."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.KOALEFANT_WINTER
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.KOALEFANT_WINTER"
msgid "How do you do? Why are you blue?"
msgstr "¿Cómo estás tú? ¿Por qué estás azul?"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.KOALEFIG_TRUNK
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.KOALEFIG_TRUNK"
msgid "As mortal dishes go, that looks particularly revolting."
msgstr "Entre los platos mortales, este es particularmente asqueroso."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.KRAMPUS
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.KRAMPUS"
msgid "Heh heh. No hard feelings?"
msgstr "Je, je. Sin resentimientos, ¿eh?"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.KRAMPUS_SACK
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.KRAMPUS_SACK"
msgid "He should have known I would not hold back."
msgstr "Debería haber sabido que no me contendría."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.LANTERN
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.LANTERN"
msgid "Guide my way!"
msgstr "¡Guía mi camino!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.LATKES
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.LATKES"
msgid "I wonder what would happen if I took a bite."
msgstr "¿Qué pasaría si les diera un mordisco?"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.LAVAARENA_ARMOREXTRAHEAVY
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.LAVAARENA_ARMOREXTRAHEAVY"
msgid "I can barely move my little imp legs in it!"
msgstr "¡Casi ni puedo mover mis patitas de diablillo!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.LAVAARENA_ARMORHEAVY
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.LAVAARENA_ARMORHEAVY"
msgid "Hyuyu, that looks heavy!"
msgstr "¡Ji, ji, parece pesada!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.LAVAARENA_ARMORLIGHT
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.LAVAARENA_ARMORLIGHT"
msgid "So light and breezy!"
msgstr "¡Qué ligera y veloz!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.LAVAARENA_ARMORLIGHTSPEED
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.LAVAARENA_ARMORLIGHTSPEED"
msgid "Skittery imp!"
msgstr "¡Diablillo escurridizo!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.LAVAARENA_ARMORMEDIUM
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.LAVAARENA_ARMORMEDIUM"
msgid "Knock on wood for protection!"
msgstr "¡Toca madera para protegerte!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.LAVAARENA_ARMORMEDIUMDAMAGER
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.LAVAARENA_ARMORMEDIUMDAMAGER"
msgid "Covered in claws!"
msgstr "¡Cubierta de garras!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.LAVAARENA_ARMORMEDIUMRECHARGER
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.LAVAARENA_ARMORMEDIUMRECHARGER"
msgid "Better! Faster!"
msgstr "¡Mejor! ¡Más rápida!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.LAVAARENA_ARMOR_HP
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.LAVAARENA_ARMOR_HP"
msgid "Fortified imp!"
msgstr "¡Diablillo blindado!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.LAVAARENA_BATTLESTANDARD
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.LAVAARENA_BATTLESTANDARD"
msgid "Break that stake!"
msgstr "¡Rompe ese poste!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.LAVAARENA_BERNIE
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.LAVAARENA_BERNIE"
msgid "How do you do, fine sir?"
msgstr "¿Cómo está usted, estimado?"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.LAVAARENA_BOARLORD
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.LAVAARENA_BOARLORD"
msgid "I have no real quest, I'm just here to jest!"
msgstr "¡No quiero nada en particular, solo busco bromear!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.LAVAARENA_CROWNDAMAGERHAT
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.LAVAARENA_CROWNDAMAGERHAT"
msgid "Hyuyu, oh the magic!"
msgstr "¡Jiu, ju! ¡Ah, la magia!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.LAVAARENA_ELEMENTAL
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.LAVAARENA_ELEMENTAL"
msgid "Hyuyu, what are you!"
msgstr "¡Jiu, ju! ¿Qué eres tú?"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.LAVAARENA_EYECIRCLETHAT
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.LAVAARENA_EYECIRCLETHAT"
msgid "Ooo, I feel so fancy!"
msgstr "¡Aaahh, me siento tan elegante!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.LAVAARENA_FEATHERCROWNHAT
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.LAVAARENA_FEATHERCROWNHAT"
msgid "It tickles my horns!"
msgstr "¡Me hace cosquillas en los cuernos!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.LAVAARENA_FIREBOMB
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.LAVAARENA_FIREBOMB"
msgid "Boom! Kabloom! Doom!!"
msgstr "¡Pum! ¡Cataplún! ¡Buuuuuuum!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.LAVAARENA_HEALINGFLOWERHAT
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.LAVAARENA_HEALINGFLOWERHAT"
msgid "I don't want to die, hyuyu!"
msgstr "¡No quiero morir, jiu, ju!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.LAVAARENA_HEALINGGARLANDHAT
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.LAVAARENA_HEALINGGARLANDHAT"
msgid "A bloom to do a bit of good!"
msgstr "¡Una flor para repartir amor!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.LAVAARENA_HEAVYBLADE
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.LAVAARENA_HEAVYBLADE"
msgid "A giant sword to cut down this horde!"
msgstr "¡Una espada gorda para acabar con esta horda!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.LAVAARENA_KEYHOLE
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.LAVAARENA_KEYHOLE"
msgid "It's a one-piece puzzle."
msgstr "Un rompecabezas de una pieza."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.LAVAARENA_KEYHOLE_FULL
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.LAVAARENA_KEYHOLE_FULL"
msgid "And away I go!"
msgstr "¡Y así me largo!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.LAVAARENA_LIGHTDAMAGERHAT
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.LAVAARENA_LIGHTDAMAGERHAT"
msgid "Gives me a bit of extra bite!"
msgstr "¡Me da un empujoncito!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.LAVAARENA_LUCY
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.LAVAARENA_LUCY"
msgid "Axe to the max!"
msgstr "¡Hachas al poder!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.LAVAARENA_PORTAL.GENERIC
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.LAVAARENA_PORTAL.GENERIC"
msgid "A fire-powered hopper."
msgstr "Un portal de fuego."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.LAVAARENA_PORTAL.ON
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.LAVAARENA_PORTAL.ON"
msgid "Hop, skip and a jump! Hyuyu!"
msgstr "¡Un brinco y un salto! ¡Jiu, ju!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.LAVAARENA_RECHARGERHAT
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.LAVAARENA_RECHARGERHAT"
msgid "More power, faster!"
msgstr "¡Más energía, más rápido!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.LAVAARENA_SPAWNER
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.LAVAARENA_SPAWNER"
msgid "Short range hoppery!"
msgstr "¡Saltos de corto alcance!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.LAVAARENA_STRONGDAMAGERHAT
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.LAVAARENA_STRONGDAMAGERHAT"
msgid "Gives me a lot of extra bite!"
msgstr "¡Me da un buen empujón!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.LAVAARENA_TIARAFLOWERPETALSHAT
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.LAVAARENA_TIARAFLOWERPETALSHAT"
msgid "This imp is here to help!"
msgstr "¡Este diablillo está para ayudar!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.LAVAE
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.LAVAE"
msgid "I remember when I was that age."
msgstr "Recuerdo cuando tenía esa edad."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.LAVAE_COCOON
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.LAVAE_COCOON"
msgid "A friend is sleeping deep within."
msgstr "Hay un amigo durmiendo dentro."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.LAVAE_EGG.GENERIC
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.LAVAE_EGG.GENERIC"
msgid "Is there a sweet pet inside?"
msgstr "¿Hay una tierna mascota dentro?"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.LAVAE_EGG_CRACKED.COLD
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.LAVAE_EGG_CRACKED.COLD"
msgid "My oh my, you're much too cold!"
msgstr "¡Ay, cielos! ¡Estás demasiado frío!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.LAVAE_EGG_CRACKED.COMFY
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.LAVAE_EGG_CRACKED.COMFY"
msgid "Sweet and cozy as a clam."
msgstr "Dulce y feliz como una lombriz."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.LAVAE_PET.CONTENT
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.LAVAE_PET.CONTENT"
msgid "What a happy wyrm you are."
msgstr "Qué gusanito tan alegre."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.LAVAE_PET.GENERIC
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.LAVAE_PET.GENERIC"
msgid "You are blessed with eternal youth! Yes you are!"
msgstr "¡Recibiste la bendición de la juventud eterna! ¡Sí!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.LAVAE_PET.HUNGRY
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.LAVAE_PET.HUNGRY"
msgid "Do you eat souls?"
msgstr "¿Comes almas?"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.LAVAE_PET.STARVING
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.LAVAE_PET.STARVING"
msgid "Oh gracious, it's starving!"
msgstr "¡Por todos los cielos, se muere de hambre!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.LAVAE_TOOTH
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.LAVAE_TOOTH"
msgid "My mom still has mine somewhere."
msgstr "Mi mamá aún tiene los míos en alguna parte."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.LAVASPIT.COOL
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.LAVASPIT.COOL"
msgid "It cannot hurt my hooves now!"
msgstr "¡Ahora no puede lastimarme las pezuñas!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.LAVASPIT.HOT
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.LAVASPIT.HOT"
msgid "If I don't get bit I'll burn in spit!"
msgstr "¡Esa bestia encendida me quema con su saliva!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.LAVA_POND
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.LAVA_POND"
msgid "I won't dip my toe in."
msgstr "No pienso meter un dedo."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.LAVA_POND_ROCK
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.LAVA_POND_ROCK"
msgid "Cold lava."
msgstr "Lava fría."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.LEAFLOAF
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.LEAFLOAF"
msgid "Even the mortals don't seem to care for it."
msgstr "Ni siquiera les gusta a los mortales."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.LEAFYMEATBURGER
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.LEAFYMEATBURGER"
msgid "Mortals seem to get quite irritated when you mess with their food."
msgstr "Los mortales se irritan bastante cuando uno se mete con su comida."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.LEAFYMEATSOUFFLE
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.LEAFYMEATSOUFFLE"
msgid "I'll stick to souls, thank you."
msgstr "Me limitaré a las almas, gracias."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.LEIF
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.LEIF"
msgid "No need to fight, my great tree friend!"
msgstr "¡No hace falta luchar, amigote árbol!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.LEIF_IDOL
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.LEIF_IDOL"
msgid "A nice carving, but the pose is a little wooden, hyuyu!"
msgstr "Es una linda escultura, pero la postura está algo rígida, jiu, ju."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.LEIF_SPARSE
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.LEIF_SPARSE"
msgid "No need to fight, my great tree friend!"
msgstr "¡No hace falta luchar, amigote árbol!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.LICHEN
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.LICHEN"
msgid "Last resort underground foodstuffs."
msgstr "Comida subterránea como último recurso."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.LIFEINJECTOR
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.LIFEINJECTOR"
msgid "On further reflection, I don't want an injection."
msgstr "Lo pensé mejor y no quiero una inyección."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.LIGHTBULB
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.LIGHTBULB"
msgid "Magnificent, I do dare say."
msgstr "Magnífica, me atrevo a decir."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.LIGHTCRAB
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.LIGHTCRAB"
msgid "They're brighter than the monkeys at least."
msgstr "Por lo menos son más brillantes que los monos."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.LIGHTER
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.LIGHTER"
msgid "A tool to set fire, if you desire."
msgstr "Una herramienta para prender fuego, si es tu deseo."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.LIGHTFLIER
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.LIGHTFLIER"
msgid "Bloom and glow!"
msgstr "¡Florece y reluce!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.LIGHTNINGGOAT.CHARGED
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.LIGHTNINGGOAT.CHARGED"
msgid "That one got zapped recently."
msgstr "A esa le cayó un rayo hace poco."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.LIGHTNINGGOAT.GENERIC
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.LIGHTNINGGOAT.GENERIC"
msgid "Your horns aren't so great."
msgstr "Tus cuernos no son la gran cosa."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.LIGHTNINGGOATHORN
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.LIGHTNINGGOATHORN"
msgid "It's okay."
msgstr "No está mal."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.LIGHTNING_ROD.CHARGED
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.LIGHTNING_ROD.CHARGED"
msgid "For peace of mind."
msgstr "Para quedarte tranquilo."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.LIGHTNING_ROD.GENERIC
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.LIGHTNING_ROD.GENERIC"
msgid "It's brimming with elemental energy."
msgstr "Rebosa de energía elemental."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.LITTLE_WALRUS
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.LITTLE_WALRUS"
msgid "I could play twenty tricks on you!"
msgstr "¡Podría hacerte veinte bromas!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.LIVINGLOG
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.LIVINGLOG"
msgid "Don't look at me with those sad eyes!"
msgstr "¡No me mires con esos ojos tan tristes!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.LIVINGTREE
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.LIVINGTREE"
msgid "A tree as perplexing as it is vexing."
msgstr "Un árbol tan desconcertante como inquietante."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.LIVINGTREE_ROOT
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.LIVINGTREE_ROOT"
msgid "Rooty toot toot!"
msgstr "¡Raíz, qué feliz!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.LIVINGTREE_SAPLING
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.LIVINGTREE_SAPLING"
msgid "Hyuyu, what a cutie!"
msgstr "¡Jiu, ju, qué retoño!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.LOBSTERBISQUE
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.LOBSTERBISQUE"
msgid "Mortals seem to enjoy turning anything into a soup."
msgstr "A los mortales les agrada convertir todo en sopa."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.LOBSTERDINNER
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.LOBSTERDINNER"
msgid "I'm afraid I don't seafood the way most do."
msgstr "Soy muy singular. No disfruto de los frutos de mar."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.LOG.BURNING
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.LOG.BURNING"
msgid "Oh I say, it'll burn away!"
msgstr "¡Arderá ya!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.LOG.GENERIC
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.LOG.GENERIC"
msgid "A piece of what was once a tree."
msgstr "Un trozo de lo que una vez fue un árbol."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.LORDFRUITFLY
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.LORDFRUITFLY"
msgid "Hyuyu! I would expect more civility from the nobility!"
msgstr "¡Jiu, ju! Pensé que la nobleza sería más noble."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.LOST_TOY_1
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.LOST_TOY_1"
msgid "You're not from around this plane, are you?"
msgstr "Tú no eres de este plano, ¿verdad?"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.LOST_TOY_10
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.LOST_TOY_10"
msgid "You're not from around this plane, are you?"
msgstr "Tú no eres de este plano, ¿verdad?"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.LOST_TOY_11
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.LOST_TOY_11"
msgid "You're not from around this plane, are you?"
msgstr "Tú no eres de este plano, ¿verdad?"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.LOST_TOY_14
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.LOST_TOY_14"
msgid "You're not from around this plane, are you?"
msgstr "Tú no eres de este plano, ¿verdad?"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.LOST_TOY_18
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.LOST_TOY_18"
msgid "You're not from around this plane, are you?"
msgstr "Tú no eres de este plano, ¿verdad?"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.LOST_TOY_19
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.LOST_TOY_19"
msgid "You're not from around this plane, are you?"
msgstr "Tú no eres de este plano, ¿verdad?"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.LOST_TOY_2
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.LOST_TOY_2"
msgid "You're not from around this plane, are you?"
msgstr "Tú no eres de este plano, ¿verdad?"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.LOST_TOY_42
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.LOST_TOY_42"
msgid "You're not from around this plane, are you?"
msgstr "Tú no eres de este plano, ¿verdad?"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.LOST_TOY_43
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.LOST_TOY_43"
msgid "You're not from around this plane, are you?"
msgstr "Tú no eres de este plano, ¿verdad?"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.LOST_TOY_7
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.LOST_TOY_7"
msgid "You're not from around this plane, are you?"
msgstr "Tú no eres de este plano, ¿verdad?"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.LUCKY_GOLDNUGGET
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.LUCKY_GOLDNUGGET"
msgid "Oh what luck I feel, I feel."
msgstr "Oh, siento mucha suerte, sip."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.LUCY
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.LUCY"
msgid "An axe is an axe, those are the facts."
msgstr "Un hacha es un hacha, vayas donde vayas."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.LUMPY_SAPLING
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.LUMPY_SAPLING"
msgid "A tiny little baby tree!"
msgstr "¡Un arbolito bebé!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.LUNARFROG
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.LUNARFROG"
msgid "Ever seen such a sight as a hopping night light?"
msgstr "¿Habías visto una luz nocturna saltarina?"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.LUNARPLANTHAT
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.LUNARPLANTHAT"
msgid "It has me looking on the bright side, hyuyu!"
msgstr "Me hace sentir resplandeciente, jiu, ju."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.LUNARPLANT_HUSK
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.LUNARPLANT_HUSK"
msgid "Unoccupied."
msgstr "No la están usando."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.LUNARPLANT_KIT
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.LUNARPLANT_KIT"
msgid "A stitch here and there for a quick repair."
msgstr "Un par de puntadas y la cosa queda reparada."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.LUNARRIFT_CRYSTAL
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.LUNARRIFT_CRYSTAL"
msgid "Glint and glitter."
msgstr "Refulge y relumbra."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.LUNARRIFT_PORTAL
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.LUNARRIFT_PORTAL"
msgid "It's all falling apart at the seams!"
msgstr "¡Se está desgarrando!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.LUNARTHRALL_PLANT
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.LUNARTHRALL_PLANT"
msgid "A long way from home, aren't we?"
msgstr "Estás muy lejos de casa, ¿no?"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.LUNARTHRALL_PLANT_VINE_END
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.LUNARTHRALL_PLANT_VINE_END"
msgid "The weeds are whacking."
msgstr "Las malezas hacen vilezas."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.LUNAR_FORGE
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.LUNAR_FORGE"
msgid "There isn't any iron in that forge, is there?"
msgstr "No hay nada de hierro en esa forja, ¿no?"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.LUNAR_FORGE_KIT
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.LUNAR_FORGE_KIT"
msgid "Shall we forge ahead?"
msgstr "Forjemos nuestro destino."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.LUNAR_GRAZER
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.LUNAR_GRAZER"
msgid "My my, are those teeth I spy?"
msgstr "Ay, cielos, ¿son dientes lo que veo?"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.LUREPLANT
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.LUREPLANT"
msgid "As the spider catches the fly."
msgstr "Como una araña atrapa una mosca."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.LUREPLANTBULB
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.LUREPLANTBULB"
msgid "There's hunger deep within that eye."
msgstr "Hay hambre en lo más profundo de ese ojo."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.LUTEFISK
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.LUTEFISK"
msgid "It smells real enough."
msgstr "Huele bastante real."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.MADSCIENCE_LAB
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.MADSCIENCE_LAB"
msgid "A place to stew my magic brew."
msgstr "El mejor rincón para preparar mi mágica poción."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.MAGICIAN_CHEST
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.MAGICIAN_CHEST"
msgid "A clever trick to transport things quick."
msgstr "Un truco de ingenio para transportar cosas con apremio."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.MALBATROSS
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.MALBATROSS"
msgid "It's bad luck to shoot it down, but what do I know? Hyuyu!"
msgstr "Da mala suerte dispararle, pero ¿yo qué sé? ¡Jiu, ju!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.MALBATROSS_BEAK
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.MALBATROSS_BEAK"
msgid "It squawks no more."
msgstr "Ya no graznará más."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.MALBATROSS_FEATHER
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.MALBATROSS_FEATHER"
msgid "A feather for me, from the bird of the sea."
msgstr "Una pluma peculiar del pájaro del mar."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.MALBATROSS_FEATHERED_WEAVE
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.MALBATROSS_FEATHERED_WEAVE"
msgid "This fabric tickles, hyuyu."
msgstr "Esta tela me hace cosquillas, jiu, ju."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.MALE_PUPPET
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.MALE_PUPPET"
msgid "Greetings and salutations, sir."
msgstr "Saludos, estimado señor."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.MANDRAKE
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.MANDRAKE"
msgid "It's out of prank juice."
msgstr "Se quedó sin combustible bromista."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.MANDRAKESOUP
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.MANDRAKESOUP"
msgid "Soon I'll sip a sleepy soup."
msgstr "Pronto sorberé una sopa somnolienta."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.MANDRAKE_ACTIVE
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.MANDRAKE_ACTIVE"
msgid "Stop that or I'll steal your voice."
msgstr "Ya basta o te robaré la voz."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.MANDRAKE_COOKED
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.MANDRAKE_COOKED"
msgid "Oh, dear."
msgstr "Ay, cielos."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.MANDRAKE_PLANTED
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.MANDRAKE_PLANTED"
msgid "It's a prank plant."
msgstr "Una planta bromista."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.MANRABBIT_TAIL
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.MANRABBIT_TAIL"
msgid "A tail from those great big bunnies."
msgstr "Una cola de esos conejotes."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.MAPSCROLL
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.MAPSCROLL"
msgid "It doesn't really matter which way you go."
msgstr "En verdad no importa en qué dirección vayas."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.MARBLE
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.MARBLE"
msgid "Little stone slab, soon statues will be."
msgstr "Estas pequeñas losas pronto serán estatuas."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.MARBLEBEAN
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.MARBLEBEAN"
msgid "Big bean, made of marble."
msgstr "Un frijol grande hecho de mármol."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.MARBLEBEAN_SAPLING
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.MARBLEBEAN_SAPLING"
msgid "How does it grow? I just do not know!"
msgstr "¿Cómo crece? ¡Qué gran misterio parece!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.MARBLEPILLAR
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.MARBLEPILLAR"
msgid "A column of marble, so tall and so cold."
msgstr "Una columna de mármol, tan alta, tan fría."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.MARBLESHRUB
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.MARBLESHRUB"
msgid "A shubbery!"
msgstr "¡Un arbusto!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.MARBLETREE
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.MARBLETREE"
msgid "And here we see... a marble tree!"
msgstr "Y aquí tenemos un árbol... ¡y es de mármol!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.MARSH_BUSH.BURNING
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.MARSH_BUSH.BURNING"
msgid "Shh, shush! I see ahead a burning bush!"
msgstr "¡Calla, calla! ¡Veo un arbusto en llamas!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.MARSH_BUSH.BURNT
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.MARSH_BUSH.BURNT"
msgid "Ashes to ashes."
msgstr "Ceniciento."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.MARSH_BUSH.GENERIC
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.MARSH_BUSH.GENERIC"
msgid "Yikes! Spikes."
msgstr "¡Madre mía! Tiene espinas."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.MARSH_BUSH.PICKED
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.MARSH_BUSH.PICKED"
msgid "Gone, all gone."
msgstr "No queda nada de nada."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.MARSH_PLANT
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.MARSH_PLANT"
msgid "Move, I'm gazing here."
msgstr "Muévete, estoy mirando."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.MARSH_TREE.BURNING
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.MARSH_TREE.BURNING"
msgid "It seems to be a burning tree!"
msgstr "¡Parece ser un árbol ardiendo!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.MARSH_TREE.BURNT
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.MARSH_TREE.BURNT"
msgid "Goodbye, dear spikes."
msgstr "Adiós, queridas espinas."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.MARSH_TREE.CHOPPED
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.MARSH_TREE.CHOPPED"
msgid "Taken in its prime. Hyuyu!"
msgstr "Lo talaron en su mejor momento. ¡Jiu, ju!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.MARSH_TREE.GENERIC
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.MARSH_TREE.GENERIC"
msgid "A sickly tree, so sharp and slender."
msgstr "Un árbol enfermizo, puntiagudo y delgado."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.MASHEDPOTATOES
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.MASHEDPOTATOES"
msgid "Humans mush stuff up sometimes. That's just how it is."
msgstr "A veces los humanos hacen papilla con las cosas. Así son."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.MASK_BLACKSMITHHAT
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.MASK_BLACKSMITHHAT"
msgid "A mask to place upon my face."
msgstr "Una máscara para ponerme en la cara."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.MASK_DOLLBROKENHAT
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.MASK_DOLLBROKENHAT"
msgid "A mask to place upon my face."
msgstr "Una máscara para ponerme en la cara."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.MASK_DOLLHAT
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.MASK_DOLLHAT"
msgid "A mask to place upon my face."
msgstr "Una máscara para ponerme en la cara."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.MASK_DOLLREPAIREDHAT
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.MASK_DOLLREPAIREDHAT"
msgid "A mask to place upon my face."
msgstr "Una máscara para ponerme en la cara."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.MASK_FOOLHAT
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.MASK_FOOLHAT"
msgid "A mask to place upon my face."
msgstr "Una máscara para ponerme en la cara."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.MASK_HALFWITHAT
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.MASK_HALFWITHAT"
msgid "Who's down to clown?"
msgstr ""

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.MASK_KINGHAT
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.MASK_KINGHAT"
msgid "A mask to place upon my face."
msgstr "Una máscara para ponerme en la cara."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.MASK_MIRRORHAT
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.MASK_MIRRORHAT"
msgid "A mask to place upon my face."
msgstr "Una máscara para ponerme en la cara."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.MASK_QUEENHAT
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.MASK_QUEENHAT"
msgid "A mask to place upon my face."
msgstr "Una máscara para ponerme en la cara."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.MASK_SAGEHAT
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.MASK_SAGEHAT"
msgid "Hard to despise this disguise!"
msgstr ""

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.MASK_TOADYHAT
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.MASK_TOADYHAT"
msgid "A mask fit for the task!"
msgstr ""

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.MASK_TREEHAT
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.MASK_TREEHAT"
msgid "A mask to place upon my face."
msgstr "Una máscara para ponerme en la cara."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.MAST
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.MAST"
msgid "A sail on the mast will move our boat fast."
msgstr "Una vela en el mástil hará que el barco se mueva ágil."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.MASTUPGRADE_LAMP_ITEM
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.MASTUPGRADE_LAMP_ITEM"
msgid "A light to lead us through the night."
msgstr "La claridad que nos guía en la oscuridad."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.MASTUPGRADE_LAMP_ITEM_YOTD
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.MASTUPGRADE_LAMP_ITEM_YOTD"
msgid "A light to lead us through the night."
msgstr "La claridad que nos guía en la oscuridad."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.MASTUPGRADE_LAMP_YOTD
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.MASTUPGRADE_LAMP_YOTD"
msgid "How kind to share your bright glare!"
msgstr "Compartes tu resplandor. ¡Qué primor!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.MASTUPGRADE_LIGHTNINGROD_ITEM
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.MASTUPGRADE_LIGHTNINGROD_ITEM"
msgid "Now mayhaps, we won't get zapped!"
msgstr "¡Ahora quizá no nos electrocutemos!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.MAST_ITEM
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.MAST_ITEM"
msgid "A mast to sail the ocean vast."
msgstr "Con un mástil, navegar es fácil."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.MAST_MALBATROSS
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.MAST_MALBATROSS"
msgid "It fought to no avail, and became our sail!"
msgstr "¡Luchó con mucha entrega, pero se convirtió en nuestra vela!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.MAST_MALBATROSS_ITEM
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.MAST_MALBATROSS_ITEM"
msgid "Ah at last, a fancy new mast!"
msgstr "Finalmente, un mástil como la gente."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.MAST_YOTD
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.MAST_YOTD"
msgid "Sails of shimmering scales."
msgstr "Velas de escamas que destellan."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.MAST_YOTD_ITEM
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.MAST_YOTD_ITEM"
msgid "A mast to sail the ocean vast."
msgstr "Con un mástil, navegar es fácil."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.MAXWELL
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.MAXWELL"
msgid "You have no power over me, heehee!"
msgstr "¡No tienes ningún poder sobre mí, ji, ji!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.MAXWELLHEAD
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.MAXWELLHEAD"
msgid "Hyuyu, that's a good trick!"
msgstr "¡Jiu, ju, qué buen truco!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.MAXWELLLIGHT
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.MAXWELLLIGHT"
msgid "Ooohoohoo, it warms in my presence!"
msgstr "¡Oooh, oooh, se calienta en mi presencia!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.MAXWELLLOCK
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.MAXWELLLOCK"
msgid "Now let's see, where is the key?"
msgstr "Bueno, a ver, ¿y la llave qué?"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.MAXWELLPHONOGRAPH
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.MAXWELLPHONOGRAPH"
msgid "Ooo, music! I'm practically giddy!"
msgstr "¡Ah, música! ¡Me da vueltas la cabeza!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.MAXWELLTHRONE
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.MAXWELLTHRONE"
msgid "A precarious place to rest one's rump."
msgstr "Un lugar precario para descansar las posaderas."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.MEAT
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.MEAT"
msgid "Ex-animal."
msgstr "Un exanimal."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.MEATBALLS
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.MEATBALLS"
msgid "Physical food is so hilarious."
msgstr "La comida física es graciosísima."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.MEATRACK.BURNT
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.MEATRACK.BURNT"
msgid "A silly prank to be sure."
msgstr "Una broma tonta, está claro."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.MEATRACK.DONE
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.MEATRACK.DONE"
msgid "The jerky is ready."
msgstr "El charqui está listo."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.MEATRACK.DONE_NOTMEAT
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.MEATRACK.DONE_NOTMEAT"
msgid "The food's ready."
msgstr "La comida está lista."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.MEATRACK.DRYING
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.MEATRACK.DRYING"
msgid "It's drying."
msgstr "Se está secando."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.MEATRACK.DRYINGINRAIN
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.MEATRACK.DRYINGINRAIN"
msgid "It's undrying day."
msgstr "No es día para secar."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.MEATRACK.DRYINGINRAIN_NOTMEAT
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.MEATRACK.DRYINGINRAIN_NOTMEAT"
msgid "It's undrying day."
msgstr "No es día para secar."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.MEATRACK.DRYING_NOTMEAT
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.MEATRACK.DRYING_NOTMEAT"
msgid "It's drying."
msgstr "Se está secando."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.MEATRACK.GENERIC
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.MEATRACK.GENERIC"
msgid "I don't have much use for this."
msgstr "No me sirve de mucho."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.MEATRACK_HERMIT.BURNT
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.MEATRACK_HERMIT.BURNT"
msgid "A silly prank to be sure."
msgstr "Una broma tonta, está claro."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.MEATRACK_HERMIT.DONE
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.MEATRACK_HERMIT.DONE"
msgid "The jerky is ready."
msgstr "El charqui está listo."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.MEATRACK_HERMIT.DONE_NOTMEAT
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.MEATRACK_HERMIT.DONE_NOTMEAT"
msgid "The food's ready."
msgstr "La comida está lista."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.MEATRACK_HERMIT.DRYING
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.MEATRACK_HERMIT.DRYING"
msgid "It's drying."
msgstr "Se está secando."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.MEATRACK_HERMIT.DRYINGINRAIN
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.MEATRACK_HERMIT.DRYINGINRAIN"
msgid "It's undrying day."
msgstr "No es día para secar."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.MEATRACK_HERMIT.DRYINGINRAIN_NOTMEAT
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.MEATRACK_HERMIT.DRYINGINRAIN_NOTMEAT"
msgid "It's undrying day."
msgstr "No es día para secar."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.MEATRACK_HERMIT.DRYING_NOTMEAT
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.MEATRACK_HERMIT.DRYING_NOTMEAT"
msgid "It's drying."
msgstr "Se está secando."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.MEATRACK_HERMIT.GENERIC
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.MEATRACK_HERMIT.GENERIC"
msgid "Her hooks are bare, but should I care?"
msgstr "Sus anzuelos no tienen carne. ¿Debería importarme?"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.MEATYSALAD
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.MEATYSALAD"
msgid "Hyuyuyu! What a deliciously deceptive prank!"
msgstr "¡Jiu, ju, ju! ¡Qué exquisito engaño!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.MEAT_DRIED
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.MEAT_DRIED"
msgid "Mortals like this more than when it's wet."
msgstr "A los mortales les gusta más así que húmeda."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.MEGAFLARE
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.MEGAFLARE"
msgid "Hyuyuyu, this might get interesting!"
msgstr "¡Jiu, ju, ju! Esto podría ponerse interesante."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.MERM
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.MERM"
msgid "Aren't you intimidated by my massive horns?"
msgstr "¿No te intimidan mis cuernos enormes?"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.MERMARMORHAT
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.MERMARMORHAT"
msgid "It will find its home on a merm’s fishy dome."
msgstr "Sin discusión, su lugar es la testa de un tritón."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.MERMARMORUPGRADEDHAT
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.MERMARMORUPGRADEDHAT"
msgid "It will find its home on a merm’s fishy dome."
msgstr "Sin discusión, su lugar es la testa de un tritón."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.MERMGUARD
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.MERMGUARD"
msgid "The horns are an improvement."
msgstr "Los cuernos son una mejora."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.MERMGUARD_LUNAR
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.MERMGUARD_LUNAR"
msgid "An ugly mutant from the Marsh. Pardon me, was that too harsh?"
msgstr "Un mutante feo del pantano. Disculpa, ¿fui desubicado?"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.MERMGUARD_SHADOW
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.MERMGUARD_SHADOW"
msgid "And they say there are no second chances, hyuyu!"
msgstr "Y dicen que no existen las segundas oportunidades. ¡Jiu, ju!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.MERMHAT
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.MERMHAT"
msgid "Some would call me two-faced, hyuyu!"
msgstr "Algunos dirían que muestro dos caras, ¡jiu, ju!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.MERMHEAD.BURNT
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.MERMHEAD.BURNT"
msgid "So long, repulsive head."
msgstr "Adiós, cabeza repulsiva."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.MERMHEAD.GENERIC
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.MERMHEAD.GENERIC"
msgid "I guess there are more distasteful things than soul consumption."
msgstr "Supongo que hay cosas más desagradables que consumir almas."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.MERMHOUSE.BURNT
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.MERMHOUSE.BURNT"
msgid "Goodbye, ugly domicile."
msgstr "Ya no te verá nadie, casa desagradable."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.MERMHOUSE.GENERIC
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.MERMHOUSE.GENERIC"
msgid "A stinky structure, to be sure."
msgstr "Te digo una cosa: qué estructura tan apestosa."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.MERMHOUSE_CRAFTED.BURNT
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.MERMHOUSE_CRAFTED.BURNT"
msgid "Someone's already had their fun."
msgstr "Alguien ya se divirtió."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.MERMHOUSE_CRAFTED.GENERIC
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.MERMHOUSE_CRAFTED.GENERIC"
msgid "An abode fit for a toad, hyuyu!"
msgstr "Una residencia digna de una excrecencia, ¡jiu, ju!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.MERMKING
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.MERMKING"
msgid "Slimy is the head that wears the crown."
msgstr "Viscosa es la cabeza que lleva la corona."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.MERMTHRONE.BURNT
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.MERMTHRONE.BURNT"
msgid "A little rain could have saved their reign."
msgstr "Si hubiera llovido, su reino habría tenido otro destino."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.MERMTHRONE.GENERIC
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.MERMTHRONE.GENERIC"
msgid "A mat made for a monarch."
msgstr "Una alfombrilla digna de un rey."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.MERMTHRONE_CONSTRUCTION.BURNT
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.MERMTHRONE_CONSTRUCTION.BURNT"
msgid "Looks like someone played a little prank!"
msgstr "¡Parece que alguien hizo una bromita!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.MERMTHRONE_CONSTRUCTION.GENERIC
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.MERMTHRONE_CONSTRUCTION.GENERIC"
msgid "My my, what mischief are you making?"
msgstr "Vaya, vaya, ¿qué travesura estás preparando?"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.MERMWATCHTOWER_NOKING
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.MERMWATCHTOWER_NOKING"
msgid "Guards with no king, like puppets with no string."
msgstr "Guardias sin rey, como arado sin buey."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.MERMWATCHTOWER_REGULAR
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.MERMWATCHTOWER_REGULAR"
msgid "There's a terrible stench of fish..."
msgstr "Hay una horrible peste a pescado..."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.MERM_ARMORY
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.MERM_ARMORY"
msgid "A Merm millinery."
msgstr "Una sombrerería de tritones."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.MERM_ARMORY_UPGRADED
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.MERM_ARMORY_UPGRADED"
msgid "A Merm millinery."
msgstr "Una sombrerería de tritones."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.MERM_LUNAR
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.MERM_LUNAR"
msgid "Ah, the latest from young Wurt. I wonder if those spikes hurt."
msgstr "Ah, la última novedad de la joven Wurt. ¿Esas espinas harán doler?"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.MERM_PRINCE
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.MERM_PRINCE"
msgid "Hyuyuyu, a prince! Charming!"
msgstr "Jiu, ju, ju, ¡un príncipe, pero no es azul!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.MERM_SHADOW
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.MERM_SHADOW"
msgid "I'm afraid retirement will have to wait."
msgstr "Todavía no te toca jubilarte."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.MERM_TOOL
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.MERM_TOOL"
msgid "A Merm's multi-tool."
msgstr "Una multiherramienta de tritones."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.MERM_TOOLSHED
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.MERM_TOOLSHED"
msgid "Does appear we're not welcome here."
msgstr "Parece que aquí no nos quieren."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.MERM_TOOLSHED_UPGRADED
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.MERM_TOOLSHED_UPGRADED"
msgid "Does appear we're not welcome here."
msgstr "Parece que aquí no nos quieren."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.MERM_TOOL_UPGRADED
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.MERM_TOOL_UPGRADED"
msgid "Meticulously manufactured for Merms."
msgstr "Fabricada con meticulosidad para tritones."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.MESSAGEBOTTLE
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.MESSAGEBOTTLE"
msgid "I'm tempted to take a peek!"
msgstr "¡Estoy tentado de echar un vistazo!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.MESSAGEBOTTLEEMPTY
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.MESSAGEBOTTLEEMPTY"
msgid "An empty vessel."
msgstr "Un recipiente vacío."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.MIGHTY_GYM.BURNT
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.MIGHTY_GYM.BURNT"
msgid "The exercise has been exorcised."
msgstr "El ejercicio ya no ejerce nada."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.MIGHTY_GYM.GENERIC
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.MIGHTY_GYM.GENERIC"
msgid "Mortals have such curious ways."
msgstr "Los mortales hacen cosas tan raras."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.MILKYWHITES
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.MILKYWHITES"
msgid "This loot from our fight does not bring delight."
msgstr "El botín de la pelea no nos alegra."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.MINERHAT
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.MINERHAT"
msgid "A head light to brighten my dreary thoughts."
msgstr "Una luz de cabeza para iluminar mis pensamientos sombríos."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.MINIBOATLANTERN
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.MINIBOATLANTERN"
msgid "I'm sorry, but the souls I take cannot follow you."
msgstr "Lo siento, pero las almas que tomo no pueden seguirte."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.MINIFAN
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.MINIFAN"
msgid "Round and round and round it goes."
msgstr "Gira y gira y gira sin parar."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.MINIFLARE
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.MINIFLARE"
msgid "Mortals get lost sometimes, hyuyu."
msgstr "A veces los mortales se pierden, jiu, ju."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.MINISIGN.GENERIC
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.MINISIGN.GENERIC"
msgid "Hyuyu, draw me next!"
msgstr "¡Jiu, ju, ahora dibújame a mí!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.MINISIGN.UNDRAWN
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.MINISIGN.UNDRAWN"
msgid "Time for a little doodle, yes?"
msgstr "Hora de un garabato, ¿sí?"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.MINISIGN_ITEM
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.MINISIGN_ITEM"
msgid "A bunch of wood to plant in the ground."
msgstr "Un montón de madera para plantarla donde sea."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.MINOTAUR
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.MINOTAUR"
msgid "Goodness gracious, aren't you fearsome."
msgstr "Cielos, sí que eres temible."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.MINOTAURCHEST
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.MINOTAURCHEST"
msgid "Perhaps a surprise awaits inside."
msgstr "Quizás haya una sorpresa dentro."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.MINOTAURHORN
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.MINOTAURHORN"
msgid "Harumph. It doesn't even spiral."
msgstr "Mmmm. Ni siquiera tiene forma de espiral."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.MOLE.ABOVEGROUND
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.MOLE.ABOVEGROUND"
msgid "The mole has left its hole!"
msgstr "¡El topo se fue de su hoyo!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.MOLE.HELD
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.MOLE.HELD"
msgid "Careful, I don't want to accidentally touch you."
msgstr "Cuidado. No quiero tocarte por accidente."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.MOLE.UNDERGROUND
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.MOLE.UNDERGROUND"
msgid "The mole is sheltered in its hole."
msgstr "El topo está resguardado en su hoyo."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.MOLEBAT
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.MOLEBAT"
msgid "Hyuyu, what a nosy creature!"
msgstr "¡Jiu, ju, qué naso tiene esa criatura!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.MOLEBATHILL
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.MOLEBATHILL"
msgid "This snotty collection needs further inspection."
msgstr "Esta colección de mocos es una cosa de locos."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.MOLEHAT
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.MOLEHAT"
msgid "It lets me see on every plane!"
msgstr "¡Puedo ver en cada plano!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.MOLEHILL
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.MOLEHILL"
msgid "Peering inside it makes my brow furrow."
msgstr "Cuando miro dentro, se me frunce el ceño."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.MONKEY
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.MONKEY"
msgid "How do you do, little sir?"
msgstr "¿Cómo está, señorito?"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.MONKEYBARREL
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.MONKEYBARREL"
msgid "Home of the little sirs."
msgstr "El hogar de los señoritos."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.MONKEYHUT.BURNT
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.MONKEYHUT.BURNT"
msgid "It looks like I missed all the fun!"
msgstr "¡Parece que me perdí toda la dirección!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.MONKEYHUT.GENERIC
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.MONKEYHUT.GENERIC"
msgid "Knock knock! Won't you let me in?"
msgstr "Toc, toc. ¿Me dejas entrar?"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.MONKEYISLAND_PORTAL
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.MONKEYISLAND_PORTAL"
msgid "Poor mortals, they have so much trouble traveling from plane to plane!"
msgstr "Pobres mortales. ¡Les cuesta tanto viajar de un plano a otro!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.MONKEYISLAND_PORTAL_DEBRIS
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.MONKEYISLAND_PORTAL_DEBRIS"
msgid "Hyuyuyu, someone's been up to some mischief!"
msgstr "Jiu, ju, ju. Alguien ha estado haciendo travesuras."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.MONKEYPILLAR
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.MONKEYPILLAR"
msgid "Are these the pillars of monkey society?"
msgstr "¿Son los pilares de la sociedad de los monos?"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.MONKEYQUEEN
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.MONKEYQUEEN"
msgid "Her kingdom for a swing!"
msgstr "¡Su reino por un columpio!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.MONKEYTAIL
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.MONKEYTAIL"
msgid "How funny, a plant that apes monkeys!"
msgstr "Qué risa. Una planta que imita a los monos."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.MONKEY_MEDIUMHAT
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.MONKEY_MEDIUMHAT"
msgid "I hope this tricorn fits around my horns."
msgstr "Espero que mi cornamenta quepa en este tricornio."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.MONKEY_SMALLHAT
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.MONKEY_SMALLHAT"
msgid "When at sea, do as the monkeys do, hyuyu!"
msgstr "En el mar, los monos mandan. ¡Jiu, ju!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.MONSTERLASAGNA
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.MONSTERLASAGNA"
msgid "Even the mortals dislike it."
msgstr "Ni a los mortales les gusta."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.MONSTERMEAT
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.MONSTERMEAT"
msgid "I hope *I* don't look like that inside."
msgstr "Espero que YO no sea así por dentro."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.MONSTERMEAT_DRIED
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.MONSTERMEAT_DRIED"
msgid "I still do not wish to eat it."
msgstr "Aun así, no quiero comérmela."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.MONSTERTARTARE
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.MONSTERTARTARE"
msgid "Monster flesh that's very fresh."
msgstr "Carne de monstruo recién carneado."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.MOONBASE.BROKEN
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.MOONBASE.BROKEN"
msgid "We can't perform the ritual like this."
msgstr "No podemos completar el ritual así."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.MOONBASE.GENERIC
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.MOONBASE.GENERIC"
msgid "What are the conditions for this ritual?"
msgstr "¿Cuáles son las condiciones para este ritual?"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.MOONBASE.MOONSTAFF
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.MOONBASE.MOONSTAFF"
msgid "It is done!"
msgstr "¡Ya está!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.MOONBASE.STAFFED
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.MOONBASE.STAFFED"
msgid "It's time! Call upon the moon!"
msgstr "¡Es el momento! ¡Invoca a la luna!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.MOONBASE.WRONGSTAFF
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.MOONBASE.WRONGSTAFF"
msgid "Hyuyu. That's just silly."
msgstr "Jiu, ju. Qué tontería."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.MOONBUTTERFLY.GENERIC
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.MOONBUTTERFLY.GENERIC"
msgid "A glimmering moth on wings alight."
msgstr "Una trémula polilla que brillante aletea."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.MOONBUTTERFLY.HELD
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.MOONBUTTERFLY.HELD"
msgid "Watch my claws now, dearest friend."
msgstr "Cuidado con mis garras, amiguita."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.MOONBUTTERFLYWINGS
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.MOONBUTTERFLYWINGS"
msgid "Gossamer wings of pale, pale green."
msgstr "Alas de gasa de pálido pálido verde."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.MOONBUTTERFLY_SAPLING
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.MOONBUTTERFLY_SAPLING"
msgid "Grow now, safe and sound."
msgstr "Crece ahora, sano y salvo."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.MOONDIAL.CAVE
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.MOONDIAL.CAVE"
msgid "It was so silly to build it down here!"
msgstr "¡Qué tontería construirlo aquí abajo!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.MOONDIAL.GENERIC
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.MOONDIAL.GENERIC"
msgid "What a handsome devil I see in the water!"
msgstr "¡Qué diablo tan apuesto veo en el agua!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.MOONDIAL.GLASSED
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.MOONDIAL.GLASSED"
msgid "They certainly are keeping a watchful eye over us, hyuyu!"
msgstr "No cabe duda de que nos vigilan con atención, ¡jiu, ju!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.MOONDIAL.NIGHT_FULL
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.MOONDIAL.NIGHT_FULL"
msgid "Hyuyu, I feel a bit loony!"
msgstr "¡Jiu, ju, me siento un poco chiflado!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.MOONDIAL.NIGHT_NEW
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.MOONDIAL.NIGHT_NEW"
msgid "A newest moon!"
msgstr "¡Una luna más nueva!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.MOONDIAL.NIGHT_WANE
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.MOONDIAL.NIGHT_WANE"
msgid "It's on the wane, oh yes indeed."
msgstr "Está menguando. Oh, sí."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.MOONDIAL.NIGHT_WAX
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.MOONDIAL.NIGHT_WAX"
msgid "It's waxing, yes oh yes it is."
msgstr "Está creciendo. Oh, sí. Oh, sí."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.MOONGLASS
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.MOONGLASS"
msgid "In its green sheen I see selene."
msgstr "Me gusta que emita un brillo verde selenita."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.MOONGLASSAXE
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.MOONGLASSAXE"
msgid "Swing and a chop, all the trees drop!"
msgstr "¡Un buen hachazo y todos los árboles talo!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.MOONGLASS_CHARGED
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.MOONGLASS_CHARGED"
msgid "I should make haste before they go to waste."
msgstr "Me tengo que apurar para no desperdiciar."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.MOONGLASS_ROCK
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.MOONGLASS_ROCK"
msgid "A handsome devil is reflected back at me! Hyuyu!"
msgstr "¡Veo que mi reflejo es el de un diablo apuesto! ¡Jiu, ju!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.MOONGLASS_WOBSTER_DEN
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.MOONGLASS_WOBSTER_DEN"
msgid "A home made of glass? I think I'll pass."
msgstr "¿Una casa hecha de cristal? No me voy a acercar."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.MOONROCKCRATER
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.MOONROCKCRATER"
msgid "It might be an eye, were gems in supply."
msgstr "Podría servir para ver si hubiera gemas por doquier."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.MOONROCKIDOL
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.MOONROCKIDOL"
msgid "What, pray tell, do you desire?"
msgstr "Dime, por favor, ¿qué deseas?"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.MOONROCKNUGGET
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.MOONROCKNUGGET"
msgid "It was hewn from solid moon."
msgstr "Proviene de la luna sólida."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.MOONROCKSEED
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.MOONROCKSEED"
msgid "I bet you know some fun secrets."
msgstr "Seguro que conoces secretos divertidos."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.MOONROCK_PIECES
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.MOONROCK_PIECES"
msgid "Smashable, crashable fun to be had."
msgstr "Diversión aplastante y rompible."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.MOONSPIDERDEN
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.MOONSPIDERDEN"
msgid "I should not like to see inside!"
msgstr "¡No quiero mirar dentro!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.MOONSTORM_GLASS.GENERIC
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.MOONSTORM_GLASS.GENERIC"
msgid "Shiny and sharp."
msgstr "Brillante y filoso."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.MOONSTORM_GLASS.INFUSED
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.MOONSTORM_GLASS.INFUSED"
msgid "Ah, what a healthy glow!"
msgstr "¡Qué resplandor tan agradable!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.MOONSTORM_GOGGLESHAT
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.MOONSTORM_GOGGLESHAT"
msgid "What a lune-y invention, hyuyu!"
msgstr "Qué invento lunático, ¡jiu, ju!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.MOONSTORM_SPARK
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.MOONSTORM_SPARK"
msgid "Hyuyu, it tickles!"
msgstr "¡Jiu, ju! ¡Hace cosquillas!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.MOONSTORM_STATIC
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.MOONSTORM_STATIC"
msgid "Best stay back if I don't want to get zapped!"
msgstr "¡Mejor me alejo si no quiero electrocutarme!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.MOONSTORM_STATIC_ITEM
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.MOONSTORM_STATIC_ITEM"
msgid "It makes my fur stand on end."
msgstr "Me pone el pelaje de punta."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.MOON_ALTAR.GENERIC
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.MOON_ALTAR.GENERIC"
msgid "Hyuyu, moon secrets are so fun!"
msgstr "Jiu, ju, ¡qué divertidos son los secretos lunares!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.MOON_ALTAR.MOON_ALTAR_WIP
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.MOON_ALTAR.MOON_ALTAR_WIP"
msgid "Hyuyu, you'll owe me one after this!"
msgstr "Jiu, ju, ¡me debes una después de esto!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.MOON_ALTAR_ASTRAL
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.MOON_ALTAR_ASTRAL"
msgid "All together again. You must be over the moon, hyuyu!"
msgstr "Ya estás armado de nuevo. Qué «alunante», ¡jiu, ju!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.MOON_ALTAR_COSMIC
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.MOON_ALTAR_COSMIC"
msgid "The stage is nearly set!"
msgstr "¡El escenario está casi listo!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.MOON_ALTAR_CROWN
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.MOON_ALTAR_CROWN"
msgid "Well, you've had quite the adventure, hyuyu!"
msgstr "Bueno, qué aventura tuviste, ¡jiu, ju!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.MOON_ALTAR_GLASS
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.MOON_ALTAR_GLASS"
msgid "Let's see if we can put you back together again."
msgstr "Veamos si podemos armarte de nuevo."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.MOON_ALTAR_ICON
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.MOON_ALTAR_ICON"
msgid "You hid away with quite some skill, you're lucky that I had a drill!"
msgstr "Te encontré de milagro. ¡Por suerte, tengo un taladro!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.MOON_ALTAR_IDOL
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.MOON_ALTAR_IDOL"
msgid "You've really fallen apart, huh?"
msgstr "Te has desmoronado, ¿no?"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.MOON_ALTAR_LINK
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.MOON_ALTAR_LINK"
msgid "Oh, this is going to be fun! Hyuyuyu!"
msgstr "Esto va a ser divertido. ¡Jiu, ju, ju!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.MOON_ALTAR_ROCK_GLASS
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.MOON_ALTAR_ROCK_GLASS"
msgid "There's a surprise inside!"
msgstr "¡Hay una sorpresa dentro!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.MOON_ALTAR_ROCK_IDOL
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.MOON_ALTAR_ROCK_IDOL"
msgid "There's a surprise inside!"
msgstr "¡Hay una sorpresa dentro!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.MOON_ALTAR_ROCK_SEED
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.MOON_ALTAR_ROCK_SEED"
msgid "There's a surprise inside!"
msgstr "¡Hay una sorpresa dentro!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.MOON_ALTAR_SEED
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.MOON_ALTAR_SEED"
msgid "What a funny voice you have. How it rattles around in my head!"
msgstr "Qué voz tan rara tienes. ¡Cómo me repiquetea en la cabeza!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.MOON_ALTAR_WARD
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.MOON_ALTAR_WARD"
msgid "Lost, found, now homeward bound!"
msgstr "Se perdió. Lo encontramos y a su hogar lo mandamos."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.MOON_CAP
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.MOON_CAP"
msgid "Why not cap the day off with a little snooze? Hyuyuyu!"
msgstr "Propongo, hongo, que se presta para una siesta. ¡Jiu, ju!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.MOON_CAP_COOKED
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.MOON_CAP_COOKED"
msgid "Why you tricky thing, you've changed!"
msgstr "¡Cosa tramposa! Has cambiado."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.MOON_DEVICE.CONSTRUCTION1
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.MOON_DEVICE.CONSTRUCTION1"
msgid "I'll help a bit, but if it's no fun I'll quit!"
msgstr "Daré una mano, pero, si me aburro, me largo."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.MOON_DEVICE.CONSTRUCTION2
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.MOON_DEVICE.CONSTRUCTION2"
msgid "What mysterious machinations!"
msgstr "¡Qué misteriosas maquinaciones!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.MOON_DEVICE.GENERIC
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.MOON_DEVICE.GENERIC"
msgid "Hyuyuyu, I don't think they'll like that..."
msgstr "Jiu, ju. No creo que le guste..."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.MOON_FISSURE.GENERIC
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.MOON_FISSURE.GENERIC"
msgid "This magic makes my brain so soft and floaty!"
msgstr "¡Esta magia me deja el cerebro liviano y blando!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.MOON_FISSURE.NOLIGHT
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.MOON_FISSURE.NOLIGHT"
msgid "A deep, dark hole that knows no end!"
msgstr "¡Un agujero sin fin profundo y oscuro!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.MOON_FISSURE_PLUGGED
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.MOON_FISSURE_PLUGGED"
msgid "Hyuyu! Can you not get out, little ones?"
msgstr "¡Jiu, ju! ¿No pueden salir, pequeñines?"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.MOON_TREE.BURNING
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.MOON_TREE.BURNING"
msgid "Burning, burning, burning down."
msgstr "Se quema, se quema, se quema."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.MOON_TREE.BURNT
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.MOON_TREE.BURNT"
msgid "So much tinder, burnt to cinder."
msgstr "Tantas astillas reducidas a cenizas."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.MOON_TREE.CHOPPED
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.MOON_TREE.CHOPPED"
msgid "It is no more."
msgstr "Ya no existe."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.MOON_TREE.GENERIC
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.MOON_TREE.GENERIC"
msgid "Glimmering tree of lunar light."
msgstr "Refulgente árbol de luz lunar."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.MOON_TREE_BLOSSOM
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.MOON_TREE_BLOSSOM"
msgid "Look how it gleams in the moonlight!"
msgstr "¡Mira cómo brilla a la luz de la luna!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.MOOSE
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.MOOSE"
msgid "What manner of beast are you?"
msgstr "¿Qué clase de bestia eres?"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.MOOSEEGG
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.MOOSEEGG"
msgid "The egg of that most fearsome creature."
msgstr "El huevo de esa criatura tan temible."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.MOOSE_NESTING_GROUND
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.MOOSE_NESTING_GROUND"
msgid "It's a place to nest and rest."
msgstr "Un lugar para anidar y descansar."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.MOQUECA
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.MOQUECA"
msgid "I don't really like human food."
msgstr "No me gusta la comida humana, en realidad."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.MOSQUITO.GENERIC
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.MOSQUITO.GENERIC"
msgid "Please do not bite me."
msgstr "Por favor, no me piques."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.MOSQUITO.HELD
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.MOSQUITO.HELD"
msgid "I have no blood for you, sweet thing."
msgstr "No tengo sangre para ti, cariño."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.MOSQUITOBOMB
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.MOSQUITOBOMB"
msgid "A bombastic bag of blood-suckers!"
msgstr "¡Chorrea chupasangres! ¡Chanfle!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.MOSQUITOFERTILIZER
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.MOSQUITOFERTILIZER"
msgid "Methinks it stinks."
msgstr "¡Pardiez, qué hediondez!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.MOSQUITOMERMSALVE
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.MOSQUITOMERMSALVE"
msgid "No need to squirm, it's made for a Merm."
msgstr "No sirve para mis lesiones. Es para tritones."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.MOSQUITOMUSK
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.MOSQUITOMUSK"
msgid "A cuddly creepy-crawly!"
msgstr "¡Un bicho horrible abrazable!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.MOSQUITOSACK
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.MOSQUITOSACK"
msgid "It's full of mortal blood."
msgstr "Está lleno de sangre mortal."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.MOSSLING
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.MOSSLING"
msgid "The whirlwind of youth."
msgstr "El torbellino de la juventud."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.MOUND.DUG
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.MOUND.DUG"
msgid "The dead had no use of it, you see."
msgstr "A los muertos no les sirvió de nada."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.MOUND.GENERIC
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.MOUND.GENERIC"
msgid "I sense no souls within."
msgstr "No siento almas en su interior."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.MULLEDDRINK
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.MULLEDDRINK"
msgid "Perhaps I'll mull it over, hyuyu!"
msgstr "Una ponchada de ponche. ¡Jiu, ju!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.MULTIPLAYER_PORTAL
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.MULTIPLAYER_PORTAL"
msgid "I can come and go as I please."
msgstr "Puedo ir y venir como me plazca."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.MULTIPLAYER_PORTAL_MOONROCK
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.MULTIPLAYER_PORTAL_MOONROCK"
msgid "Ooo, what delightful games we might play in there!"
msgstr "¡Oh, ahí podríamos jugar a unos juegos muy divertidos!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.MULTITOOL_AXE_PICKAXE
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.MULTITOOL_AXE_PICKAXE"
msgid "It couldn't decide which to be, so it became both."
msgstr "No podía decidir cuál quería ser, así que se convirtió en los dos."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.MUSHGNOME
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.MUSHGNOME"
msgid "I mistook that portly fellow for a Portobello! Hyuyu!"
msgstr "Creí que ese don era un champiñón. ¡Jiu, ju!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.MUSHROOMBOMB
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.MUSHROOMBOMB"
msgid "I will stay far away!"
msgstr "¡Me mantendré bien lejos!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.MUSHROOMHAT
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.MUSHROOMHAT"
msgid "I'll have mushroom spores in my horns for days."
msgstr "Tendré esporas de hongos en los cuernos durante días."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.MUSHROOMSPROUT.BURNT
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.MUSHROOMSPROUT.BURNT"
msgid "A pity."
msgstr "Qué pena."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.MUSHROOMSPROUT.GENERIC
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.MUSHROOMSPROUT.GENERIC"
msgid "My, my! What do we have here?"
msgstr "¡Vaya, vaya! ¿Qué tenemos aquí?"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.MUSHROOM_FARM.BURNT
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.MUSHROOM_FARM.BURNT"
msgid "No more mushrooms to have here!"
msgstr "¡Aquí ya no hay más hongos!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.MUSHROOM_FARM.EMPTY
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.MUSHROOM_FARM.EMPTY"
msgid "Just a log if you ask me!"
msgstr "Para mí, no es más que un tronco."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.MUSHROOM_FARM.LOTS
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.MUSHROOM_FARM.LOTS"
msgid "Oh good! The mortals get cranky when they're hungry."
msgstr "¡Uy! Los mortales sí que se enfadan cuando no comen nada."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.MUSHROOM_FARM.ROTTEN
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.MUSHROOM_FARM.ROTTEN"
msgid "I don't think the mortals will eat that."
msgstr "No creo que los mortales se coman eso."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.MUSHROOM_FARM.SNOWCOVERED
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.MUSHROOM_FARM.SNOWCOVERED"
msgid "Little tiny icy log."
msgstr "Un tronquito helado."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.MUSHROOM_FARM.SOME
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.MUSHROOM_FARM.SOME"
msgid "I don't want them, but the mortals might."
msgstr "Yo no los quiero, pero los mortales tal vez sí."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.MUSHROOM_FARM.STUFFED
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.MUSHROOM_FARM.STUFFED"
msgid "The mortals will be very, very pleased."
msgstr "Los mortales se pondrán muy muy contentos."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.MUSHROOM_LIGHT.BURNT
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.MUSHROOM_LIGHT.BURNT"
msgid "Now we're destined to the dark."
msgstr "Ahora estamos destinados a la oscuridad."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.MUSHROOM_LIGHT.OFF
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.MUSHROOM_LIGHT.OFF"
msgid "It could use a little spark."
msgstr "Le hace falta una chispa."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.MUSHROOM_LIGHT.ON
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.MUSHROOM_LIGHT.ON"
msgid "A spotted spotlight to chase away the dark."
msgstr "Una luz moteada para ahuyentar la oscuridad."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.MUSHROOM_LIGHT2.BURNT
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.MUSHROOM_LIGHT2.BURNT"
msgid "The light has long fled."
msgstr "Hace mucho que se apagó la luz."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.MUSHROOM_LIGHT2.OFF
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.MUSHROOM_LIGHT2.OFF"
msgid "When it's out I feel great dread."
msgstr "Cuando está apagado, siento mucho miedo."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.MUSHROOM_LIGHT2.ON
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.MUSHROOM_LIGHT2.ON"
msgid "I quite like it when it's red!"
msgstr "¡Me gusta mucho cuando está rojo!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.MUSHTREE_MEDIUM.ACIDCOVERED
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.MUSHTREE_MEDIUM.ACIDCOVERED"
msgid "Me thinks it stinks."
msgstr "¡Pardiez, qué hediondez!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.MUSHTREE_MEDIUM.BLOOM
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.MUSHTREE_MEDIUM.BLOOM"
msgid "How wonderfully un-wonderful!"
msgstr "¡Qué maravillosamente no maravilloso!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.MUSHTREE_MEDIUM.GENERIC
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.MUSHTREE_MEDIUM.GENERIC"
msgid "A massive mushroom! Did I quaff a shrinking potion?"
msgstr "¡Un hongo gigante! ¿Acaso tomé una poción que me encogió?"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.MUSHTREE_MOON
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.MUSHTREE_MOON"
msgid "Someone played a prank on it."
msgstr "Alguien le hizo una broma."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.MUSHTREE_SMALL.ACIDCOVERED
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.MUSHTREE_SMALL.ACIDCOVERED"
msgid "Me thinks it stinks."
msgstr "¡Pardiez, qué hediondez!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.MUSHTREE_SMALL.BLOOM
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.MUSHTREE_SMALL.BLOOM"
msgid "Hyuyu! How wretched!"
msgstr "¡Jiu, ju! ¡Qué desgraciado!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.MUSHTREE_SMALL.GENERIC
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.MUSHTREE_SMALL.GENERIC"
msgid "A massive mushroom! Did I quaff a shrinking potion?"
msgstr "¡Un hongo gigante! ¿Acaso tomé una poción que me encogió?"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.MUSHTREE_TALL.ACIDCOVERED
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.MUSHTREE_TALL.ACIDCOVERED"
msgid "Me thinks it stinks."
msgstr "¡Pardiez, qué hediondez!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.MUSHTREE_TALL.BLOOM
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.MUSHTREE_TALL.BLOOM"
msgid "Delightfully disgusting!"
msgstr "¡Qué deliciosamente asqueroso!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.MUSHTREE_TALL.GENERIC
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.MUSHTREE_TALL.GENERIC"
msgid "A massive mushroom! Did I quaff a shrinking potion?"
msgstr "¡Un hongo gigante! ¿Acaso tomé una poción que me encogió?"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.MUSHTREE_TALL_WEBBED.ACIDCOVERED
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.MUSHTREE_TALL_WEBBED.ACIDCOVERED"
msgid "Me thinks it stinks."
msgstr "¡Pardiez, qué hediondez!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.MUSHTREE_TALL_WEBBED.GENERIC
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.MUSHTREE_TALL_WEBBED.GENERIC"
msgid "She's shy so she's wearing her veil."
msgstr "Es tan tímido que usa velo."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.MUTATEDBEARGER
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.MUTATEDBEARGER"
msgid "I prefer the bare bear... barely."
msgstr "Prefiero el osotejón sin tanta mutación."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.MUTATEDDEERCLOPS
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.MUTATEDDEERCLOPS"
msgid "My, you're looking sharp! New haircut?"
msgstr "¡Qué elegante estás! ¿Te cortaste el pelo?"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.MUTATEDHOUND.DEAD
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.MUTATEDHOUND.DEAD"
msgid "I'm surprised it had a soul!"
msgstr "¡Me sorprende que tenga alma!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.MUTATEDHOUND.GENERIC
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.MUTATEDHOUND.GENERIC"
msgid "What if I'm actually inside out, and it's rightside in?"
msgstr "¿Y si yo tuviera el cuerpo volteado al revés y de él estuviera al derecho?"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.MUTATEDHOUND.SLEEPING
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.MUTATEDHOUND.SLEEPING"
msgid "Its mind has fled far from here, hyuyu."
msgstr "Su mente anda lejos de aquí, jiu, ju."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.MUTATEDWARG
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.MUTATEDWARG"
msgid "This Rover has had quite the makeover!"
msgstr "Este canino sufrió un cambio repentino."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.MUTATED_PENGUIN.DEAD
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.MUTATED_PENGUIN.DEAD"
msgid "Dead as dead as dead could be!"
msgstr "Más muerto imposible."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.MUTATED_PENGUIN.GENERIC
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.MUTATED_PENGUIN.GENERIC"
msgid "Hyuyu! What a horrible face you have!"
msgstr "¡Jiu, ju! ¡Qué cara tan fea tienes!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.MUTATED_PENGUIN.SLEEPING
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.MUTATED_PENGUIN.SLEEPING"
msgid "Its mind has fled far from here, hyuyu."
msgstr "Su mente anda lejos de aquí, jiu, ju."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.MUTATOR_DROPPER
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.MUTATOR_DROPPER"
msgid "A tasty treat for those tiny terrors!"
msgstr "¡Un bocadito bonito para aquellos bichitos!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.MUTATOR_HEALER
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.MUTATOR_HEALER"
msgid "A tasty treat for those tiny terrors!"
msgstr "¡Un bocadito bonito para aquellos bichitos!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.MUTATOR_HIDER
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.MUTATOR_HIDER"
msgid "A tasty treat for those tiny terrors!"
msgstr "¡Un bocadito bonito para aquellos bichitos!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.MUTATOR_MOON
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.MUTATOR_MOON"
msgid "A tasty treat for those tiny terrors!"
msgstr "¡Un bocadito bonito para aquellos bichitos!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.MUTATOR_SPITTER
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.MUTATOR_SPITTER"
msgid "A tasty treat for those tiny terrors!"
msgstr "¡Un bocadito bonito para aquellos bichitos!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.MUTATOR_WARRIOR
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.MUTATOR_WARRIOR"
msgid "A tasty treat for those tiny terrors!"
msgstr "¡Un bocadito bonito para aquellos bichitos!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.MUTATOR_WATER
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.MUTATOR_WATER"
msgid "A tasty treat for those tiny terrors!"
msgstr "¡Un bocadito bonito para aquellos bichitos!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.NATURE_BLUEPRINT
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.NATURE_BLUEPRINT"
msgid "I suppose I'll reap what I sew, hyuyu!"
msgstr "Esto debe ser coser y cantar. ¡Jiu, ju!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.NIGHTCAPHAT
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.NIGHTCAPHAT"
msgid "Keep your dreams warm and snug inside your sleepy head."
msgstr "Abriga y protege los sueños en la cabeza dormilona."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.NIGHTLIGHT
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.NIGHTLIGHT"
msgid "Goodness gracious, what excellent decorations!"
msgstr "¡Por todos los cielos! Qué decoraciones excelentes."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.NIGHTMAREFUEL
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.NIGHTMAREFUEL"
msgid "Hyuyu! It's squishy."
msgstr "¡Jiu, ju! Está blandito."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.NIGHTMAREGROWTH
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.NIGHTMAREGROWTH"
msgid "Methinks we'd best be on our way!"
msgstr "Opino que mejor nos marchamos."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.NIGHTMARELIGHT
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.NIGHTMARELIGHT"
msgid "Beware, beware, it says to me."
msgstr "Cuidado, cuidado, me dice."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.NIGHTMAREPIE
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.NIGHTMAREPIE"
msgid "Hyuyu, humans sure are strange."
msgstr "Jiu, ju, ju. Qué raros son los humanos."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.NIGHTMARE_TIMEPIECE.CALM
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.NIGHTMARE_TIMEPIECE.CALM"
msgid "No games to play today."
msgstr "Hoy no se juega a nada."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.NIGHTMARE_TIMEPIECE.DAWN
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.NIGHTMARE_TIMEPIECE.DAWN"
msgid "Playtime's almost over."
msgstr "Casi se acabó la hora de jugar."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.NIGHTMARE_TIMEPIECE.NOMAGIC
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.NIGHTMARE_TIMEPIECE.NOMAGIC"
msgid "A fun medallion for a more fun rapscallion!"
msgstr "¡Un medallón divertido para un bribón atrevido!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.NIGHTMARE_TIMEPIECE.STEADY
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.NIGHTMARE_TIMEPIECE.STEADY"
msgid "Hyuyu! What fun!"
msgstr "¡Jiu, ju! ¡Qué divertido!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.NIGHTMARE_TIMEPIECE.WANING
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.NIGHTMARE_TIMEPIECE.WANING"
msgid "Aw, the chaos is dissipating."
msgstr "Ah, el caos se está disipando."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.NIGHTMARE_TIMEPIECE.WARN
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.NIGHTMARE_TIMEPIECE.WARN"
msgid "I'm getting so excited!"
msgstr "¡Me estoy emocionando!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.NIGHTMARE_TIMEPIECE.WAXING
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.NIGHTMARE_TIMEPIECE.WAXING"
msgid "Ooo, it's picking up!"
msgstr "¡Ah, está acelerándose!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.NIGHTSTICK
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.NIGHTSTICK"
msgid "Shed some light on any fight."
msgstr "Iluminación cuando lo requiere la situación."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.NIGHTSWORD
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.NIGHTSWORD"
msgid "To slash and stab!"
msgstr "¡Para cortar y apuñalar!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.NITRE
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.NITRE"
msgid "I've no earthly clue how to use this."
msgstr "No tengo ni la más remota idea de cómo usarlo."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.NITRE_FORMATION
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.NITRE_FORMATION"
msgid "After a while it formed a pile."
msgstr "El tiempo pasó y el salitre se apiló."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.NUTRIENTSGOGGLESHAT
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.NUTRIENTSGOGGLESHAT"
msgid "The gardener's crown to set upon my furry brow."
msgstr "La corona de jardinero para usar de sombrero."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.OAR
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.OAR"
msgid "I'll splash all my friends with this!"
msgstr "¡Salpicaré a todos mis camaradas con esto!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.OAR_DRIFTWOOD
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.OAR_DRIFTWOOD"
msgid "It's an oar, for shore!"
msgstr "A las pruebas me remito."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.OAR_MONKEY
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.OAR_MONKEY"
msgid "Shall I battle oar paddle?"
msgstr "Para remar y rematar."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.OASISLAKE.EMPTY
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.OASISLAKE.EMPTY"
msgid "No swimming today!"
msgstr "¡Nada de nadar hoy!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.OASISLAKE.GENERIC
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.OASISLAKE.GENERIC"
msgid "Swimming gives me wet imp smell."
msgstr "Si nado, huelo a diablillo mojado."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.OCEANFISHABLEFLOTSAM
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.OCEANFISHABLEFLOTSAM"
msgid "I will shape it into a delicious mud pie! Hyuyu."
msgstr "¡Le daré la forma de un delicioso pastel de barro! Jiu, ju"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.OCEANFISHINGBOBBER_BALL
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.OCEANFISHINGBOBBER_BALL"
msgid "I'm just having a ball! Hyuyu!"
msgstr "¡Espero no hacerme bolas! ¡Jiu, ju!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.OCEANFISHINGBOBBER_CANARY
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.OCEANFISHINGBOBBER_CANARY"
msgid "Never underestimate the power of a strong quill."
msgstr "Nunca hay que subestimar el poder de una pluma fuerte."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.OCEANFISHINGBOBBER_CROW
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.OCEANFISHINGBOBBER_CROW"
msgid "Never underestimate the power of a strong quill."
msgstr "Nunca hay que subestimar el poder de una pluma fuerte."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.OCEANFISHINGBOBBER_GOOSE
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.OCEANFISHINGBOBBER_GOOSE"
msgid "A fearsome feathery float!"
msgstr "¡Un temible flotador emplumado!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.OCEANFISHINGBOBBER_MALBATROSS
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.OCEANFISHINGBOBBER_MALBATROSS"
msgid "A fearsome feathery float!"
msgstr "¡Un temible flotador emplumado!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.OCEANFISHINGBOBBER_NONE
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.OCEANFISHINGBOBBER_NONE"
msgid "A piece of this fishing puzzle is missing."
msgstr "Falta una pieza de este rompecabezas de pesca."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.OCEANFISHINGBOBBER_OVAL
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.OCEANFISHINGBOBBER_OVAL"
msgid "This doesn't look so hard!"
msgstr "¡Esto no parece tan difícil!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.OCEANFISHINGBOBBER_ROBIN
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.OCEANFISHINGBOBBER_ROBIN"
msgid "Never underestimate the power of a strong quill."
msgstr "Nunca hay que subestimar el poder de una pluma fuerte."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.OCEANFISHINGBOBBER_ROBIN_WINTER
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.OCEANFISHINGBOBBER_ROBIN_WINTER"
msgid "Never underestimate the power of a strong quill."
msgstr "Nunca hay que subestimar el poder de una pluma fuerte."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.OCEANFISHINGLURE_HERMIT_DROWSY
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.OCEANFISHINGLURE_HERMIT_DROWSY"
msgid "Oh, the pranks I could pull with this!"
msgstr "¡Oh, cuántas bromas podría hacer con esto!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.OCEANFISHINGLURE_HERMIT_HEAVY
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.OCEANFISHINGLURE_HERMIT_HEAVY"
msgid "An enticing bait for a fish of great weight!"
msgstr "¡Una carnada para tentar a un pez descomunal!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.OCEANFISHINGLURE_HERMIT_RAIN
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.OCEANFISHINGLURE_HERMIT_RAIN"
msgid "Rain or shine, the fish will be mine!"
msgstr "¡Llueva o haga frío, el pez será mío!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.OCEANFISHINGLURE_HERMIT_SNOW
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.OCEANFISHINGLURE_HERMIT_SNOW"
msgid "How fun to go and fish in the snow!"
msgstr "¡Pescar en la nieve es lo que se viene!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.OCEANFISHINGLURE_SPINNER_BLUE
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.OCEANFISHINGLURE_SPINNER_BLUE"
msgid "What a fun prank for the fish!"
msgstr "¡Qué broma graciosa para los peces!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.OCEANFISHINGLURE_SPINNER_GREEN
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.OCEANFISHINGLURE_SPINNER_GREEN"
msgid "What a fun prank for the fish!"
msgstr "¡Qué broma graciosa para los peces!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.OCEANFISHINGLURE_SPINNER_RED
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.OCEANFISHINGLURE_SPINNER_RED"
msgid "What a fun prank for the fish!"
msgstr "¡Qué broma graciosa para los peces!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.OCEANFISHINGLURE_SPOON_BLUE
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.OCEANFISHINGLURE_SPOON_BLUE"
msgid "What a fun prank for the fish!"
msgstr "¡Qué broma graciosa para los peces!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.OCEANFISHINGLURE_SPOON_GREEN
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.OCEANFISHINGLURE_SPOON_GREEN"
msgid "What a fun prank for the fish!"
msgstr "¡Qué broma graciosa para los peces!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.OCEANFISHINGLURE_SPOON_RED
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.OCEANFISHINGLURE_SPOON_RED"
msgid "What a fun prank for the fish!"
msgstr "¡Qué broma graciosa para los peces!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.OCEANFISHINGROD
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.OCEANFISHINGROD"
msgid "I'd rather catch a soul than a sole."
msgstr "Las almas me interesan más que las escamas."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.OCEANFISH_MEDIUM_1
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.OCEANFISH_MEDIUM_1"
msgid "Your name is mud, fish!"
msgstr "¡Pez, barro eres!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.OCEANFISH_MEDIUM_2
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.OCEANFISH_MEDIUM_2"
msgid "If I hold it up, it becomes an upright bass!"
msgstr "¡Que nadie me robe mi róbalo!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.OCEANFISH_MEDIUM_3
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.OCEANFISH_MEDIUM_3"
msgid "How dandy indeed! You've a soul that I need."
msgstr "¡Qué bonito! Tienes un alma que necesito."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.OCEANFISH_MEDIUM_4
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.OCEANFISH_MEDIUM_4"
msgid "Oooh, how delightfully superstitious!"
msgstr "Oooh, ¡qué deliciosamente supersticioso!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.OCEANFISH_MEDIUM_5
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.OCEANFISH_MEDIUM_5"
msgid "It looks like nature played quite the prank on this one."
msgstr "Parece que a esta la naturaleza le hizo una broma pesada."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.OCEANFISH_MEDIUM_6
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.OCEANFISH_MEDIUM_6"
msgid "I'm afraid your journey has been cut short."
msgstr "Me temo que tu travesía se ha interrumpido."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.OCEANFISH_MEDIUM_7
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.OCEANFISH_MEDIUM_7"
msgid "I'm afraid your journey has been cut short."
msgstr "Me temo que tu travesía se ha interrumpido."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.OCEANFISH_MEDIUM_8
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.OCEANFISH_MEDIUM_8"
msgid "What a chilly reception!"
msgstr "¡Qué recibimiento más frío!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.OCEANFISH_MEDIUM_9
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.OCEANFISH_MEDIUM_9"
msgid "Purple, but not a people eater."
msgstr "Es morado, pero no come gente."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.OCEANFISH_SMALL_1
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.OCEANFISH_SMALL_1"
msgid "Splash, splish, it's a tiny fish!"
msgstr "Pim, pam, qué chiquito estás."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.OCEANFISH_SMALL_2
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.OCEANFISH_SMALL_2"
msgid "This soul is so small it's hardly worth snatching."
msgstr "Esta alma es tan pequeña que ni vale la pena llevársela."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.OCEANFISH_SMALL_3
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.OCEANFISH_SMALL_3"
msgid "You took the bait, now suffer your fate!"
msgstr "¡Mordiste el anzuelo y te tocó irte al cielo!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.OCEANFISH_SMALL_4
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.OCEANFISH_SMALL_4"
msgid "It's hardly bigger than a minnow!"
msgstr "Es apenas más grande que un pececillo."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.OCEANFISH_SMALL_5
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.OCEANFISH_SMALL_5"
msgid "This one really pops, hyuyu!"
msgstr "Este sí que explota, ¡jiu, ju!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.OCEANFISH_SMALL_6
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.OCEANFISH_SMALL_6"
msgid "I'm afraid it's time for you to leaf, hyuyu!"
msgstr "Ha llegado la hoja de que te marches, ¡jiu, ju!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.OCEANFISH_SMALL_7
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.OCEANFISH_SMALL_7"
msgid "What might happen if I planted it in the garden?"
msgstr "¿Qué pasaría si lo plantara en el jardín?"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.OCEANFISH_SMALL_8
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.OCEANFISH_SMALL_8"
msgid "It has such a sunny disposition! Hyuyu!"
msgstr "Es muy simpático. ¡Es un sol! Jiu, ju."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.OCEANFISH_SMALL_9
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.OCEANFISH_SMALL_9"
msgid "A fellow prankster, I see!"
msgstr "¡Un colega bromista!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.OCEANTREE
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.OCEANTREE"
msgid "How is ocean life treating you?"
msgstr "¿Cómo te trata la vida marina?"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.OCEANTREENUT
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.OCEANTREENUT"
msgid "The sea is a nutty place to plant a tree."
msgstr "Plantar un árbol en el mar es «descabellotado»."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.OCEANTREE_PILLAR
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.OCEANTREE_PILLAR"
msgid "They grow up so fast!"
msgstr "Crecen muy rápido."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.OCEANVINE
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.OCEANVINE"
msgid "A fine enough vine."
msgstr "Una enredadera marinera."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.OCEANVINE_COCOON
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.OCEANVINE_COCOON"
msgid "Rock-a-bye spiders, in the treetop..."
msgstr "Una araña se balanceaba sobre la tela de una araña..."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.OCEANVINE_COCOON_BURNT
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.OCEANVINE_COCOON_BURNT"
msgid "What a shame, it went up in flames."
msgstr "Qué lástima. Se prendió fuego."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.OCEANWHIRLPORTAL
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.OCEANWHIRLPORTAL"
msgid "Oooh goodie! A watery vortex for little ol' Wortox!"
msgstr "¡Fantástico! Un vórtice de agua para Wortox."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.OCEAN_TRAWLER.CAUGHT
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.OCEAN_TRAWLER.CAUGHT"
msgid "Filled with riches of fishes."
msgstr "Desbordado de pescado."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.OCEAN_TRAWLER.ESCAPED
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.OCEAN_TRAWLER.ESCAPED"
msgid "They got away, no fish today."
msgstr "Se escaparon. Hoy no hay pescado."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.OCEAN_TRAWLER.FIXED
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.OCEAN_TRAWLER.FIXED"
msgid "It was a simple fix. I just had to pull a few strings, hyuyu!"
msgstr "Fue fácil de arreglar. Solo tuve que mover los hilos. ¡Jiu, ju!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.OCEAN_TRAWLER.GENERIC
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.OCEAN_TRAWLER.GENERIC"
msgid "The mortals wish to capture fish."
msgstr "Los mortales desean capturar peces."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.OCEAN_TRAWLER.LOWERED
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.OCEAN_TRAWLER.LOWERED"
msgid "How many will get caught up in the net?"
msgstr "¿Cuántos quedarán atrapados en la red?"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.OCEAN_TRAWLER_KIT
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.OCEAN_TRAWLER_KIT"
msgid "I've been taught toil only leads to trouble!"
msgstr "¡Me enseñaron que el trabajo solo trae problemas!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.OFFERING_POT.GENERIC
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.OFFERING_POT.GENERIC"
msgid "A saddening scarcity of seaweed, I see."
msgstr "Una acuciante ausencia de algas."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.OFFERING_POT.LOTS_OF_KELP
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.OFFERING_POT.LOTS_OF_KELP"
msgid "Heaping helpings of kelp!"
msgstr "¡Algas en ansiada abundancia!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.OFFERING_POT.SOME_KELP
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.OFFERING_POT.SOME_KELP"
msgid "Would it be such a chore to add some more?"
msgstr "¿Podríamos, quizás, agregar un poco más?"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.OFFERING_POT_UPGRADED.GENERIC
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.OFFERING_POT_UPGRADED.GENERIC"
msgid "A saddening scarcity of seaweed, I see."
msgstr "Una acuciante ausencia de algas."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.OFFERING_POT_UPGRADED.LOTS_OF_KELP
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.OFFERING_POT_UPGRADED.LOTS_OF_KELP"
msgid "Heaping helpings of kelp!"
msgstr "¡Algas en ansiada abundancia!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.OFFERING_POT_UPGRADED.SOME_KELP
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.OFFERING_POT_UPGRADED.SOME_KELP"
msgid "Would it be such a chore to add some more?"
msgstr "¿Podríamos, quizás, agregar un poco más?"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.ONEMANBAND
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.ONEMANBAND"
msgid "I'll sing a song, please hum along!"
msgstr "Cantaré una canción. ¡Canten conmigo, por favor!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.ONION
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.ONION"
msgid "You'll see no tears from my eye. I cannot cry!"
msgstr "No me verás lagrimear. Soy incapaz de llorar."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.ONION_COOKED
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.ONION_COOKED"
msgid "Like tiny circles descending."
msgstr "Como circulitos en descenso."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.ONION_OVERSIZED
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.ONION_OVERSIZED"
msgid "An ourageously large onion!"
msgstr "Una cebolla exageradamente grande."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.ONION_SEEDS
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.ONION_SEEDS"
msgid "Strange little seeds, indeed, indeed."
msgstr "Unas semillitas peculiares por estos lares."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.OPALPRECIOUSGEM
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.OPALPRECIOUSGEM"
msgid "A gem like this is precious indeed."
msgstr "Una gema así no es algo baladí."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.OPALSTAFF
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.OPALSTAFF"
msgid "Chilly and bright as a moonlit night."
msgstr "Brillante y helada como una noche estrellada."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.ORANGEAMULET
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.ORANGEAMULET"
msgid "It nestles nicely on my chest fur."
msgstr "Se apoya muy bien en el pelaje de mi pecho."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.ORANGEGEM
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.ORANGEGEM"
msgid "Bright and orange like a... a..."
msgstr "Brillante y naranja como... eh..."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.ORANGEMOONEYE
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.ORANGEMOONEYE"
msgid "My oh my, what a lovely eye."
msgstr "Maravilloso. Qué ojo tan hermoso."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.ORANGESTAFF
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.ORANGESTAFF"
msgid "A touch of magic not my own."
msgstr "Un toque de magia, pero no mía."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.OTTER
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.OTTER"
msgid "Furry fish-tailed freeloader!"
msgstr "¡Pícaro peludo pisciforme!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.OTTERDEN.GENERIC
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.OTTERDEN.GENERIC"
msgid "Nada? Another otter den then."
msgstr "¿No hay nada? Pasemos a nutria cosa."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.OTTERDEN.HAS_LOOT
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.OTTERDEN.HAS_LOOT"
msgid "Let's clean out this clawed klepto."
msgstr "Llevémonos las cosas de estos cleptómanos."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.OTTERDEN_DEAD
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.OTTERDEN_DEAD"
msgid "We'll soon be sunk."
msgstr "Pronto nos hundiremos."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.PALMCONETREE
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.PALMCONETREE"
msgid "Perhaps the tough bark is for warding off sharks."
msgstr "La dura corteza lo defiende con fortaleza."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.PALMCONE_SAPLING
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.PALMCONE_SAPLING"
msgid "A tall tree you'll one day be."
msgstr "Un día de estos, serás un árbol enhiesto."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.PALMCONE_SCALE
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.PALMCONE_SCALE"
msgid "The tree's been tipped, and so has its scale."
msgstr "Este árbol se está descamando. ¡Qué sobresalto!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.PALMCONE_SEED
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.PALMCONE_SEED"
msgid "Now a seed, but soon a tree."
msgstr "Ahora es una semilla. Será un árbol algún día."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.PANDORASCHEST
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.PANDORASCHEST"
msgid "Open it, open it!"
msgstr "¡Ábrelo, ábrelo!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.PANETTONE
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.PANETTONE"
msgid "This holiday bread is all in your head!"
msgstr "¡Este pan festivo es tu único objetivo!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.PANFLUTE
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.PANFLUTE"
msgid "My flute!"
msgstr "¡Mi flauta!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.PAPYRUS
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.PAPYRUS"
msgid "An ancient scroll in the making."
msgstr "Pronto será un pergamino antiguo."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.PAVLOVA
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.PAVLOVA"
msgid "I'm afraid you can't fool me."
msgstr "Me temo que no puedes engañarme."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.PEGHOOK
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.PEGHOOK"
msgid "This will be a cinch if I don't get pinched!"
msgstr "¡Con total seguridad, al final me pinchará!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.PENGUIN
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.PENGUIN"
msgid "A bird that flies within the sea."
msgstr "Un pájaro contento que vuela mar adentro."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.PEPPER
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.PEPPER"
msgid "An impy little vegetable."
msgstr "Una hortaliza diabólica."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.PEPPERPOPPER
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.PEPPERPOPPER"
msgid "I'll stuff them with toothpaste when Warly's not looking. Hyuyu!"
msgstr "Los llenaré de pasta de dientes cuando Warly no me vea. ¡Jiu, ju!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.PEPPER_COOKED
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.PEPPER_COOKED"
msgid "Tiny toasted twisty things."
msgstr "Cositas calentitas compactas."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.PEPPER_OVERSIZED
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.PEPPER_OVERSIZED"
msgid "That will put some pep in someone's step, hyuyuyu!"
msgstr "Un pimiento inmenso para mortales hambrientos. ¡Jiu, ju!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.PEPPER_SEEDS
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.PEPPER_SEEDS"
msgid "Strange little seeds, indeed, indeed."
msgstr "Unas semillitas peculiares por estos lares."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.PERD
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.PERD"
msgid "Begone you greedy, greedy bird."
msgstr "Fuera de aquí, pájaro glotón."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.PERDFAN
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.PERDFAN"
msgid "A gust of luck from feathers plucked!"
msgstr "¡Una racha afortunada con plumas arrancadas!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.PERDSHRINE.BURNT
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.PERDSHRINE.BURNT"
msgid "That's that."
msgstr "Se acabó."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.PERDSHRINE.EMPTY
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.PERDSHRINE.EMPTY"
msgid "Rumble and grumble, it wants a bush!"
msgstr "¡Gruñe y regruñe! Quiere un arbusto."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.PERDSHRINE.GENERIC
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.PERDSHRINE.GENERIC"
msgid "Let us celebrate!"
msgstr "¡Festejemos!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.PEROGIES
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.PEROGIES"
msgid "Mortal food, this seems to be."
msgstr "Comida mortal, eso parece."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.PETALS
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.PETALS"
msgid "Evidence of flower violence."
msgstr "Evidencia de violencia contra las flores."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.PETALS_EVIL
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.PETALS_EVIL"
msgid "A tainted beauty."
msgstr "Una belleza mancillada."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.PETRIFIED_TREE
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.PETRIFIED_TREE"
msgid "Fweeheehee! A stone cold tree!"
msgstr "¿Quién lo diría? ¡Un árbol de piedra fría!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.PHLEGM
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.PHLEGM"
msgid "How very unpleasant!"
msgstr "¡Qué desagradable!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.PHONOGRAPH
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.PHONOGRAPH"
msgid "Ooo, music! I'm practically giddy!"
msgstr "¡Ah, música! ¡Me da vueltas la cabeza!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.PICKAXE
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.PICKAXE"
msgid "Heigh ho, heigh ho!"
msgstr "¡Heigh ho, heigh ho!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.PICKAXE_LUNARPLANT
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.PICKAXE_LUNARPLANT"
msgid "To bash and break."
msgstr "Para aplastar y apisonar."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.PICKLEDHERRING
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.PICKLEDHERRING"
msgid "Shall I pick a peck of pickled herring?"
msgstr "¿Puedo picar un poquín de arenque en escabeche?"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.PIGELITE1
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.PIGELITE1"
msgid "You won't beat me, no siree!"
msgstr "¡No me vencerás! ¡No, señor!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.PIGELITE2
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.PIGELITE2"
msgid "You won't beat me, no siree!"
msgstr "¡No me vencerás! ¡No, señor!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.PIGELITE3
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.PIGELITE3"
msgid "You won't beat me, no siree!"
msgstr "¡No me vencerás! ¡No, señor!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.PIGELITE4
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.PIGELITE4"
msgid "You won't beat me, no siree!"
msgstr "¡No me vencerás! ¡No, señor!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.PIGELITEFIGHTER1
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.PIGELITEFIGHTER1"
msgid "You won't beat me, no siree!"
msgstr "¡No me vencerás! ¡No, señor!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.PIGELITEFIGHTER2
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.PIGELITEFIGHTER2"
msgid "You won't beat me, no siree!"
msgstr "¡No me vencerás! ¡No, señor!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.PIGELITEFIGHTER3
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.PIGELITEFIGHTER3"
msgid "You won't beat me, no siree!"
msgstr "¡No me vencerás! ¡No, señor!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.PIGELITEFIGHTER4
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.PIGELITEFIGHTER4"
msgid "You won't beat me, no siree!"
msgstr "¡No me vencerás! ¡No, señor!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.PIGGUARD
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.PIGGUARD"
msgid "We don't have to fight, you know."
msgstr "No es necesario que luchemos, ¿sabes?"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.PIGGYBACK
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.PIGGYBACK"
msgid "So I keep my things within this little bag made of pig skin."
msgstr "Guardo mis cositas en esta bolsa de cerdo tan linda."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.PIGHEAD.BURNT
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.PIGHEAD.BURNT"
msgid "Goodbye, revolting pighead."
msgstr "Adiós, repugnante cabeza de cerdo."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.PIGHEAD.GENERIC
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.PIGHEAD.GENERIC"
msgid "Yuck."
msgstr "Puaj."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.PIGHOUSE.BURNT
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.PIGHOUSE.BURNT"
msgid "Fare thee well, hideous house."
msgstr "Que te vaya bien, casa horrible."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.PIGHOUSE.FULL
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.PIGHOUSE.FULL"
msgid "There's someone hiding, there, inside."
msgstr "Hay alguien escondido ahí dentro."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.PIGHOUSE.GENERIC
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.PIGHOUSE.GENERIC"
msgid "A house that I may never enter."
msgstr "Una casa a la que nunca voy a entrar."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.PIGHOUSE.LIGHTSOUT
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.PIGHOUSE.LIGHTSOUT"
msgid "They will not invite me across the threshold."
msgstr "No me van a invitar a cruzar el umbral."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.PIGKING
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.PIGKING"
msgid "I don't mean to pester, but please make me your jester!"
msgstr "¡No quiero molestar, pero hazme tu bufón y te divertirás!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.PIGMAN.DEAD
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.PIGMAN.DEAD"
msgid "Oh my goodness, no."
msgstr "Ay, por todos los cielos, no."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.PIGMAN.FOLLOWER
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.PIGMAN.FOLLOWER"
msgid "Hyuyu! Are we playing follow the leader?"
msgstr "¡Jiu, ju! ¿Estamos jugando a seguir al líder?"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.PIGMAN.GENERIC
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.PIGMAN.GENERIC"
msgid "Would you like to see a trick?"
msgstr "¿Te gustaría ver un truco?"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.PIGMAN.GUARD
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.PIGMAN.GUARD"
msgid "You wouldn't hit an imp, would you?!"
msgstr "No se te ocurriría pegarle a un diablillo, ¿cierto?"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.PIGMAN.WEREPIG
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.PIGMAN.WEREPIG"
msgid "Goodness! How bestial!"
msgstr "¡Cielos! ¡Qué bestial!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.PIGSHRINE.BURNT
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.PIGSHRINE.BURNT"
msgid "That's that."
msgstr "Se acabó."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.PIGSHRINE.EMPTY
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.PIGSHRINE.EMPTY"
msgid "Rumble and grumble, it wants a torch!"
msgstr "¡Gruñe y regruñe! Quiere una antorcha."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.PIGSHRINE.GENERIC
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.PIGSHRINE.GENERIC"
msgid "Let us celebrate!"
msgstr "¡Festejemos!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.PIGSKIN
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.PIGSKIN"
msgid "Not by the hair of my rumpy rump rump!"
msgstr "¡Ni por los pelos de mi colita, ita, ita!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.PIGTENT
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.PIGTENT"
msgid "Oh piggies! Let me in!"
msgstr "¡Cerditos, déjenme entrar!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.PIGTORCH
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.PIGTORCH"
msgid "It lights a flame for all to see!"
msgstr "¡Enciende una llama para que todos la vean!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.PIG_COIN
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.PIG_COIN"
msgid "A punchy pig for me? Yes please!"
msgstr "¿Un cerdito contundente para mí? ¡Sí, por favor!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.PIG_TOKEN
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.PIG_TOKEN"
msgid "Let's start the game, oh please, oh please!"
msgstr "¡Empecemos a jugar, por favor, por favor!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.PINECONE
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.PINECONE"
msgid "To plant a tree!"
msgstr "¡Para plantar un árbol!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.PINECONE_SAPLING
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.PINECONE_SAPLING"
msgid "A tiny little baby tree!"
msgstr "¡Un arbolito bebé!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.PIRATE_FLAG_POLE
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.PIRATE_FLAG_POLE"
msgid "Hyuyuyu, that flag spells trouble!"
msgstr "¡Jiu, ju, ju! Esa bandera advierte que habrá problemas."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.PIRATE_STASH
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.PIRATE_STASH"
msgid "What a splendid \"X\"! Well worth the trip."
msgstr "¡Qué «X» espléndida! El viaje valió la pena."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.PITCHFORK
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.PITCHFORK"
msgid "I do believe it suits me!"
msgstr "Creo que me queda bien."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.PLANTMEAT
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.PLANTMEAT"
msgid "I don't like it, no siree."
msgstr "No me gusta. No, señor."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.PLANTMEAT_COOKED
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.PLANTMEAT_COOKED"
msgid "I'll leave it to the mortals."
msgstr "Se lo dejaré a los mortales."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.PLANTREGISTRYHAT
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.PLANTREGISTRYHAT"
msgid "I beg your pardon, is that a hat for the garden?"
msgstr "¿Esto, inquiero, es un sombrero jardinero?"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.PLANT_NORMAL.GENERIC
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.PLANT_NORMAL.GENERIC"
msgid "A leafy little plant I see."
msgstr "Veo una plantita frondosa."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.PLANT_NORMAL.GROWING
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.PLANT_NORMAL.GROWING"
msgid "Grow big, grow tall, or not at all!"
msgstr "¡Crece alto, crece mucho, o serás un debilucho!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.PLANT_NORMAL.READY
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.PLANT_NORMAL.READY"
msgid "The mortals want your tasty eats."
msgstr "Los mortales quieren tu sabroso alimento."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.PLANT_NORMAL.WITHERED
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.PLANT_NORMAL.WITHERED"
msgid "It does not seem to be in the highest spirits."
msgstr "No parece estar de muy buen ánimo."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.PLAYBILL_THE_DOLL
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.PLAYBILL_THE_DOLL"
msgid "A curious tale of friendship and betrayal."
msgstr "Una historia de amistad y traición."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.PLAYBILL_THE_VEIL
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.PLAYBILL_THE_VEIL"
msgid "More of a controversial commercial."
msgstr ""

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.PLAYER.ATTACKER
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.PLAYER.ATTACKER"
msgid "That was a mean prank, %s!"
msgstr "¡Qué broma tan cruel, %s!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.PLAYER.FIRESTARTER
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.PLAYER.FIRESTARTER"
msgid "Ooo, who did you prank?"
msgstr "Oooh, ¿a quién le jugaste una broma?"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.PLAYER.GENERIC
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.PLAYER.GENERIC"
msgid "Hello, hello, good day, good day!"
msgstr "¡Hola, hola, buenos días, buenos días!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.PLAYER.GHOST
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.PLAYER.GHOST"
msgid "Ooo, lunch is here!"
msgstr "¡Oooh, la comida está aquí!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.PLAYER.MURDERER
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.PLAYER.MURDERER"
msgid "That wasn't a prank! That mortal's dead!"
msgstr "¡No fue una broma! ¡Mataste a un mortal!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.PLAYER.REVIVER
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.PLAYER.REVIVER"
msgid "What a kind soul you have there!"
msgstr "¡Qué alma tan amable tienes!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.PLAYER_HOSTED.GENERIC
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.PLAYER_HOSTED.GENERIC"
msgid "Can't you see, you're dead to me?"
msgstr ""

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.PLAYER_HOSTED.ME
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.PLAYER_HOSTED.ME"
msgid "As such, I've seen too much. Hyuyu..."
msgstr ""

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.POCKETWATCH_DISMANTLER
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.POCKETWATCH_DISMANTLER"
msgid "The tools of a time tinkerer."
msgstr "Las herramientas de una manipuladora del tiempo."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.POCKETWATCH_HEAL.GENERIC
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.POCKETWATCH_HEAL.GENERIC"
msgid "Mortals keep coming up with such funny tricks!"
msgstr "A los mortales siempre se les ocurren trucos raros."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.POCKETWATCH_HEAL.RECHARGING
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.POCKETWATCH_HEAL.RECHARGING"
msgid "These clocks, you will find, need some time to unwind."
msgstr "Qué problema. Estos relojes se quedaron sin cuerda."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.POCKETWATCH_PARTS
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.POCKETWATCH_PARTS"
msgid "Ooohoohoo, someone's been naughty!"
msgstr "¡Oooooooh, alguien se portó mal!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.POCKETWATCH_PORTAL.GENERIC
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.POCKETWATCH_PORTAL.GENERIC"
msgid "Mortals keep coming up with such funny tricks!"
msgstr "A los mortales siempre se les ocurren trucos raros."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.POCKETWATCH_PORTAL.RECHARGING
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.POCKETWATCH_PORTAL.RECHARGING"
msgid "These clocks, you will find, need some time to unwind."
msgstr "Qué problema. Estos relojes se quedaron sin cuerda."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.POCKETWATCH_PORTAL_ENTRANCE.DIFFERENTSHARD
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.POCKETWATCH_PORTAL_ENTRANCE.DIFFERENTSHARD"
msgid "Hyuyuyu, we'll be sure to get there in a timely manner!"
msgstr "¡Jiu, ju, ju! Seguro que llegaremos sin contratiempos."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.POCKETWATCH_PORTAL_ENTRANCE.GENERIC
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.POCKETWATCH_PORTAL_ENTRANCE.GENERIC"
msgid "Hyuyuyu, we'll be sure to get there in a timely manner!"
msgstr "¡Jiu, ju, ju! Seguro que llegaremos sin contratiempos."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.POCKETWATCH_PORTAL_EXIT
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.POCKETWATCH_PORTAL_EXIT"
msgid "You can always count on the mortals to make things needlessly complicated."
msgstr "Los mortales siempre complican todo sin necesidad."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.POCKETWATCH_RECALL.GENERIC
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.POCKETWATCH_RECALL.GENERIC"
msgid "Mortals keep coming up with such funny tricks!"
msgstr "A los mortales siempre se les ocurren trucos raros."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.POCKETWATCH_RECALL.RECHARGING
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.POCKETWATCH_RECALL.RECHARGING"
msgid "These clocks, you will find, need some time to unwind."
msgstr "Qué problema. Estos relojes se quedaron sin cuerda."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.POCKETWATCH_REVIVE.GENERIC
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.POCKETWATCH_REVIVE.GENERIC"
msgid "Mortals keep coming up with such funny tricks!"
msgstr "A los mortales siempre se les ocurren trucos raros."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.POCKETWATCH_REVIVE.RECHARGING
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.POCKETWATCH_REVIVE.RECHARGING"
msgid "These clocks, you will find, need some time to unwind."
msgstr "Qué problema. Estos relojes se quedaron sin cuerda."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.POCKETWATCH_WARP.GENERIC
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.POCKETWATCH_WARP.GENERIC"
msgid "Mortals keep coming up with such funny tricks!"
msgstr "A los mortales siempre se les ocurren trucos raros."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.POCKETWATCH_WARP.RECHARGING
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.POCKETWATCH_WARP.RECHARGING"
msgid "These clocks, you will find, need some time to unwind."
msgstr "Qué problema. Estos relojes se quedaron sin cuerda."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.POCKETWATCH_WEAPON.GENERIC
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.POCKETWATCH_WEAPON.GENERIC"
msgid "Did I hear \"one o'clock sharp\", or \"one sharp clock\"? Hyuyu!"
msgstr "¿Escuché «la una en punto» o «la una en punta»? ¡Jiu, ju!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.POCKET_SCALE
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.POCKET_SCALE"
msgid "Allow me to quickly weigh in, hyuyu!"
msgstr "Es una cuestión de peso, ¡jiu, ju!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.POLISHCOOKIE
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.POLISHCOOKIE"
msgid "You can't prank a prankster, hyuyu!"
msgstr "No puedes hacerle una broma a un bromista, ¡jiu, ju!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.POLLY_ROGERS
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.POLLY_ROGERS"
msgid "What spell compels her to help?"
msgstr "¿Por qué nos ha ayudado? ¿Acaso la han embrujado?"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.POLLY_ROGERSHAT
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.POLLY_ROGERSHAT"
msgid "A jaunty feather makes a hat look better."
msgstr "Una pluma embellece cualquier sombrero. No cabe duda."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.POMEGRANATE
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.POMEGRANATE"
msgid "You need only eat one seed. Hyuyu!"
msgstr "Solo necesitas comer una semilla. ¡Jiu, ju!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.POMEGRANATE_COOKED
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.POMEGRANATE_COOKED"
msgid "The underworld can wait."
msgstr "El inframundo puede esperar."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.POMEGRANATE_OVERSIZED
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.POMEGRANATE_OVERSIZED"
msgid "How in the underworld did you grow so big?"
msgstr "¡Por todos los inframundos! ¿Cómo creció tanto?"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.POMEGRANATE_SEEDS
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.POMEGRANATE_SEEDS"
msgid "Let's give them some soil, before they spoil."
msgstr "Démosles un poco de tierra antes de que se pierdan."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.POND
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.POND"
msgid "I could gaze upon my reflection all day!"
msgstr "¡Podría estar mirando mi reflejo todo el día!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.PONDEEL
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.PONDEEL"
msgid "A slippery soul, that one."
msgstr "Un alma resbaladiza."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.PONDFISH
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.PONDFISH"
msgid "You are quite fragrant."
msgstr "Qué aroma."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.POND_ALGAE
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.POND_ALGAE"
msgid "Little growth of winding green."
msgstr "Una planta verde retorcida."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.POOP
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.POOP"
msgid "Physical digestion is very unpleasant."
msgstr "La digestión física es muy desagradable."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.PORTABLEBLENDER_ITEM
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.PORTABLEBLENDER_ITEM"
msgid "All that chopping and no souls."
msgstr "Tanto picar y ni una sola alma."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.PORTABLECOOKPOT_ITEM.COOKING_LONG
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.PORTABLECOOKPOT_ITEM.COOKING_LONG"
msgid "I suppose I've wasted time in worse ways."
msgstr "He perdido el tiempo con cosas peores."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.PORTABLECOOKPOT_ITEM.COOKING_SHORT
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.PORTABLECOOKPOT_ITEM.COOKING_SHORT"
msgid "A meal made in haste, but not lacking in taste."
msgstr "Una comida hecha rápidamente, pero sabrosa igualmente."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.PORTABLECOOKPOT_ITEM.DONE
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.PORTABLECOOKPOT_ITEM.DONE"
msgid "A mortal meal is not really my deal."
msgstr "Es así. La comida mortal no es para mí."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.PORTABLECOOKPOT_ITEM.EMPTY
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.PORTABLECOOKPOT_ITEM.EMPTY"
msgid "All the food has been spirited away."
msgstr "Toda la comida se ha esfumado."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.PORTABLECOOKPOT_ITEM.GENERIC
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.PORTABLECOOKPOT_ITEM.GENERIC"
msgid "Does it make soul food?"
msgstr "¿Hace ensaimadas? ¿O «ensalmadas»?"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.PORTABLESPICER_ITEM.DONE
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.PORTABLESPICER_ITEM.DONE"
msgid "Mortals are so strange."
msgstr "Los mortales son muy raros."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.PORTABLESPICER_ITEM.GENERIC
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.PORTABLESPICER_ITEM.GENERIC"
msgid "Grind, grind, grind away."
msgstr "Muele que te muele."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.PORTABLETENT
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.PORTABLETENT"
msgid "So many pranks to pull! Do I push it in the lake? Toss in a snake?"
msgstr "¡Cuántas bromas posibles! ¿La tiro al lago? ¿Le meto una serpiente?"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.PORTABLETENT_ITEM
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.PORTABLETENT_ITEM"
msgid "Round and round, tent goes up and then comes down!"
msgstr "Sobre la tierra, la carpa se abre y se cierra."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.POTATO
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.POTATO"
msgid "Mortals like this in all its forms."
msgstr "A los mortales les gusta de todas las formas posibles."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.POTATOSACK
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.POTATOSACK"
msgid "Hyuyuyu, wouldn't it be fun to hide inside and give him a scare?"
msgstr "Jiu, ju, ju. Qué divertido sería meterme dentro y asustar a alguien."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.POTATOSOUFFLE
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.POTATOSOUFFLE"
msgid "I'm sure it's good, but it's not for me."
msgstr "Seguro que está bien, pero no es para mí."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.POTATOTORNADO
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.POTATOTORNADO"
msgid "I think I remember when I used to eat food. Maybe."
msgstr "Creo que me acuerdo de cuando comía comida. No estoy seguro."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.POTATO_COOKED
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.POTATO_COOKED"
msgid "A roasted mortal food."
msgstr "Comida mortal asada."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.POTATO_OVERSIZED
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.POTATO_OVERSIZED"
msgid "Oh, the mortals will be thrilled!"
msgstr "¡Oh, los mortales se pondrán muy contentos!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.POTATO_SEEDS
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.POTATO_SEEDS"
msgid "Strange little seeds, indeed, indeed."
msgstr "Unas semillitas peculiares por estos lares."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.POTTEDFERN
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.POTTEDFERN"
msgid "A plant, imprisoned for eternity."
msgstr "Una planta atrapada para toda la eternidad."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.POWCAKE
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.POWCAKE"
msgid "Hyuyu! This cake packs a wallop!"
msgstr "¡Jiu, ju! ¡Este pastel tiene mucha fuerza!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.POWDER_MONKEY
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.POWDER_MONKEY"
msgid "Be careful not to take things too far, little thief."
msgstr "No te pases de la raya, ladronzuelo."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.PREMIUMWATERINGCAN.EMPTY
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.PREMIUMWATERINGCAN.EMPTY"
msgid "The water was spilled, it must be refilled!"
msgstr "Se quedó sin agua. Hay que recargarla sin pausa."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.PREMIUMWATERINGCAN.GENERIC
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.PREMIUMWATERINGCAN.GENERIC"
msgid "This reminds me of a certain bird we ran afowl of."
msgstr "Me recuerda a un pajarraco que dejamos desplumado."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.PRIME_MATE
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.PRIME_MATE"
msgid "Monkey sea, monkey do."
msgstr "Un mono marinero. ¡Changos!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.PUFFIN.GENERIC
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.PUFFIN.GENERIC"
msgid "I'll tell you nothin', puffin."
msgstr "No te diré ni un poquillo, frailecillo."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.PUFFIN.HELD
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.PUFFIN.HELD"
msgid "Stay calm, little soul."
msgstr "Calma, pequeña alma."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.PUFFIN.SLEEPING
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.PUFFIN.SLEEPING"
msgid "Hyuyu, catching some shuteye are we?"
msgstr "Jiu, ju, ¿echando un sueñecito?"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.PUMPKIN
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.PUMPKIN"
msgid "How nice and how spooky!"
msgstr "¡Qué bonita y qué espeluznante!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.PUMPKINCARVER
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.PUMPKINCARVER"
msgid "My turn to carve the lantern!"
msgstr ""

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.PUMPKINCOOKIE
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.PUMPKINCOOKIE"
msgid "Real food is a bit hard on my stomach."
msgstr "La comida de verdad me cae mal."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.PUMPKINPIE
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.PUMPKINPIE"
msgid "Don't be shy, try the pie!"
msgstr "Prueba el pastel. Es de primer nivel."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.PUMPKIN_COOKED
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.PUMPKIN_COOKED"
msgid "Slightly easier on my impish tum."
msgstr "Es más digerible para mi panza de diablillo."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.PUMPKIN_LANTERN
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.PUMPKIN_LANTERN"
msgid "How delightfully spooky! Hyuyu!"
msgstr "¡Tan encantadora como espeluznante! ¡Jiu, ju!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.PUMPKIN_OVERSIZED
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.PUMPKIN_OVERSIZED"
msgid "Quite the plump pumpkin."
msgstr "Qué calabaza colosal."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.PUMPKIN_SEEDS
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.PUMPKIN_SEEDS"
msgid "Let's give them some soil, before they spoil."
msgstr "Démosles un poco de tierra antes de que se pierdan."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.PUNCHINGBAG
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.PUNCHINGBAG"
msgid "It does not complain, for it feels no pain!"
msgstr "Aunque le den trompadas, no siente nada."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.PUREBRILLIANCE
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.PUREBRILLIANCE"
msgid "Hyuyu, it tickles my impish brain!"
msgstr "¡Jiu, ju! ¡Me hace cosquillas en el cerebro!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.PURPLEAMULET
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.PURPLEAMULET"
msgid "I deserve these jewels, I think."
msgstr "Me merezco estas joyas, creo."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.PURPLEGEM
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.PURPLEGEM"
msgid "Dark amethyst wrenched from shadows' midst."
msgstr "Una amatista oscura arrancada de las sombras."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.PURPLEMOONEYE
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.PURPLEMOONEYE"
msgid "Jeepers peepers!"
msgstr "Pero ¿qué ven mis ojos?"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.QUAGMIRE_ALTAR.FULL
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.QUAGMIRE_ALTAR.FULL"
msgid "It's full as full can be!"
msgstr "¡Más lleno no puede estar!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.QUAGMIRE_ALTAR.GENERIC
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.QUAGMIRE_ALTAR.GENERIC"
msgid "A place to place a plate!"
msgstr "¡Un lugar para plantar un plato!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.QUAGMIRE_ALTAR_BOLLARD
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.QUAGMIRE_ALTAR_BOLLARD"
msgid "Nothing of interest to me, I see."
msgstr "No es de mi interés, ya ves."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.QUAGMIRE_ALTAR_IVY
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.QUAGMIRE_ALTAR_IVY"
msgid "Creeping ivy, growing strong."
msgstr "Hiedra rastrera, cada vez más fuerte."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.QUAGMIRE_ALTAR_QUEEN
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.QUAGMIRE_ALTAR_QUEEN"
msgid "My vessel is not her vassal."
msgstr "Mi vasija no es su vasallo."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.QUAGMIRE_ALTAR_STATUE1
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.QUAGMIRE_ALTAR_STATUE1"
msgid "A monumental statue! Hyuyu!"
msgstr "¡Una estatua monumental! ¡Jiu, ju!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.QUAGMIRE_ALTAR_STATUE2
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.QUAGMIRE_ALTAR_STATUE2"
msgid "No relation."
msgstr "Nada que ver."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.QUAGMIRE_BEEFALO
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.QUAGMIRE_BEEFALO"
msgid "I'll take the beef, you keep the \"lo\"!"
msgstr "Yo me quedo con el bife. Tú quédate con el resto del bífalo."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.QUAGMIRE_BERRYBUSH
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.QUAGMIRE_BERRYBUSH"
msgid "Mortals like berries, I think."
msgstr "A los mortales les gustan las bayas, creo."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.QUAGMIRE_BOWL_SILVER
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.QUAGMIRE_BOWL_SILVER"
msgid "The mortals like it when food looks nice."
msgstr "A los mortales les gusta cuando la comida tiene buena pinta."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.QUAGMIRE_CARROT_SEEDS
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.QUAGMIRE_CARROT_SEEDS"
msgid "Strange little seeds, indeed, indeed."
msgstr "Unas semillitas peculiares por estos lares."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.QUAGMIRE_CASSEROLEDISH
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.QUAGMIRE_CASSEROLEDISH"
msgid "I wonder how the wyrm got a taste for mortal food."
msgstr "Me pregunto cómo a la sierpe le puede gustar la comida mortal."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.QUAGMIRE_CASSEROLEDISH_SMALL
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.QUAGMIRE_CASSEROLEDISH_SMALL"
msgid "This dish is so itty bitty!"
msgstr "¡Este plato es tan pequeñito!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.QUAGMIRE_COIN1
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.QUAGMIRE_COIN1"
msgid "Pithy pennies."
msgstr "Menudas monedas."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.QUAGMIRE_COIN2
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.QUAGMIRE_COIN2"
msgid "The Gnaw expelled it from its craw."
msgstr "Las Fauces nos recompensan con una moneda."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.QUAGMIRE_COIN3
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.QUAGMIRE_COIN3"
msgid "The Gnaw has spoken. We've earned its token."
msgstr "Las Fauces han hablado. Una moneda hemos ganado."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.QUAGMIRE_COIN4
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.QUAGMIRE_COIN4"
msgid "It's a big hop token."
msgstr "¡Una moneda para portales!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.QUAGMIRE_CRABMEAT
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.QUAGMIRE_CRABMEAT"
msgid "The humans like it, they do, they do!"
msgstr "A los humanos les gusta. ¡Oh, sí, oh, sí!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.QUAGMIRE_CRABMEAT_COOKED
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.QUAGMIRE_CRABMEAT_COOKED"
msgid "They like it more like this, I hear!"
msgstr "¡Les gusta más así, eso tengo entendido!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.QUAGMIRE_CRABTRAP
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.QUAGMIRE_CRABTRAP"
msgid "They'll feel so silly once I catch them!"
msgstr "¡Se sentirán tan tontos cuando los atrape!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.QUAGMIRE_FERN
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.QUAGMIRE_FERN"
msgid "I wonder what it tastes like."
msgstr "Me pregunto qué sabor tendrá."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.QUAGMIRE_FLOUR
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.QUAGMIRE_FLOUR"
msgid "Mortal food powder!"
msgstr "¡Polvo de comida mortal!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.QUAGMIRE_FOLIAGE_COOKED
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.QUAGMIRE_FOLIAGE_COOKED"
msgid "Humans have odd palates."
msgstr "Los humanos tienen paladares extraños."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.QUAGMIRE_FOOD.GENERIC
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.QUAGMIRE_FOOD.GENERIC"
msgid "Let's roll the dice with this sacrifice!"
msgstr "¡Juguemos al azar con este manjar!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.QUAGMIRE_FOOD.MATCH
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.QUAGMIRE_FOOD.MATCH"
msgid "This meal is splendid, just as intended!"
msgstr "Esta comida es espectacular. Así se debe preparar."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.QUAGMIRE_FOOD.MATCH_BUT_SNACK
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.QUAGMIRE_FOOD.MATCH_BUT_SNACK"
msgid "Better to serve something small than nothing at all."
msgstr "Mejor servir algo diminuto que nada en absoluto."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.QUAGMIRE_FOOD.MISMATCH
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.QUAGMIRE_FOOD.MISMATCH"
msgid "This meal looks wrong, but we don't have long."
msgstr "Esta comida tiene mal aspecto, pero otra no tenemos."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.QUAGMIRE_FOOD_BURNT
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.QUAGMIRE_FOOD_BURNT"
msgid "Oospadoodle."
msgstr "Uy, uy, uy."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.QUAGMIRE_GARLIC
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.QUAGMIRE_GARLIC"
msgid "Hissss!"
msgstr "¡Sssss!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.QUAGMIRE_GARLIC_COOKED
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.QUAGMIRE_GARLIC_COOKED"
msgid "Hissssss!"
msgstr "¡Sssssssss!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.QUAGMIRE_GARLIC_SEEDS
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.QUAGMIRE_GARLIC_SEEDS"
msgid "Strange little seeds, indeed, indeed."
msgstr "Unas semillitas peculiares por estos lares."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.QUAGMIRE_GOATKID
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.QUAGMIRE_GOATKID"
msgid "And who might you be?"
msgstr "¿Y tú quién eres?"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.QUAGMIRE_GOATMILK
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.QUAGMIRE_GOATMILK"
msgid "Hyuyu! Fresh from the source."
msgstr "¡Jiu, ju! Recién ordeñada."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.QUAGMIRE_GOATMUM
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.QUAGMIRE_GOATMUM"
msgid "I'd ask hircine, but I think it's Capricorn."
msgstr "¿De qué signo será? Seguro que de Capricornio."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.QUAGMIRE_GRILL
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.QUAGMIRE_GRILL"
msgid "Mortals have lots of different cooking things."
msgstr "Los mortales tienen muchas cosas diferentes para cocinar."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.QUAGMIRE_GRILL_ITEM
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.QUAGMIRE_GRILL_ITEM"
msgid "We need to build that, yes indeed."
msgstr "Tenemos que construirla, claro que sí."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.QUAGMIRE_GRILL_SMALL
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.QUAGMIRE_GRILL_SMALL"
msgid "Mortals cook stuff on it."
msgstr "Los mortales cocinan cosas aquí."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.QUAGMIRE_GRILL_SMALL_ITEM
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.QUAGMIRE_GRILL_SMALL_ITEM"
msgid "We need to build that, yes indeed."
msgstr "Tenemos que construirla, claro que sí."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.QUAGMIRE_HOE
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.QUAGMIRE_HOE"
msgid "To turn the soil, row by row."
msgstr "Para arar la tierra, fila por fila."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.QUAGMIRE_KEY
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.QUAGMIRE_KEY"
msgid "I wish to pry into hidden supplies."
msgstr "Quiero curiosear y espiar cualquier lugar."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.QUAGMIRE_KEY_PARK
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.QUAGMIRE_KEY_PARK"
msgid "No gate can stop a sneaky imp!"
msgstr "¡Ninguna puerta puede detener a un diablillo astuto!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.QUAGMIRE_LAMP_POST
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.QUAGMIRE_LAMP_POST"
msgid "If it were raining I could sing!"
msgstr "¡Si estuviera lloviendo, podría cantar!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.QUAGMIRE_LAMP_SHORT
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.QUAGMIRE_LAMP_SHORT"
msgid "If it were raining I could sing!"
msgstr "¡Si estuviera lloviendo, podría cantar!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.QUAGMIRE_MEALINGSTONE
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.QUAGMIRE_MEALINGSTONE"
msgid "I do enjoy this mortal chore."
msgstr "Me gusta esta tarea mortal."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.QUAGMIRE_MERMHOUSE
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.QUAGMIRE_MERMHOUSE"
msgid "Looks a bit run-down."
msgstr "Parece un poco deteriorada."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.QUAGMIRE_MERM_CART1
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.QUAGMIRE_MERM_CART1"
msgid "Anything fun inside?"
msgstr "¿Habrá algo divertido dentro?"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.QUAGMIRE_MERM_CART2
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.QUAGMIRE_MERM_CART2"
msgid "Mind if I take a little peek?"
msgstr "¿Puedo echar un vistazo?"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.QUAGMIRE_MUSHROOMS
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.QUAGMIRE_MUSHROOMS"
msgid "There's morel where that came from, hyuyu!"
msgstr "¡Dispongo de muchos hongos, jiu, ju!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.QUAGMIRE_MUSHROOMSTUMP.GENERIC
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.QUAGMIRE_MUSHROOMSTUMP.GENERIC"
msgid "A mushroom metropolis!"
msgstr "¡Una metrópolis de hongos!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.QUAGMIRE_MUSHROOMSTUMP.PICKED
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.QUAGMIRE_MUSHROOMSTUMP.PICKED"
msgid "It's been picked clean."
msgstr "No han dejado nada."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.QUAGMIRE_ONION
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.QUAGMIRE_ONION"
msgid "You'll see no tears from my eye. I cannot cry!"
msgstr "No me verás lagrimear. Soy incapaz de llorar."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.QUAGMIRE_ONION_COOKED
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.QUAGMIRE_ONION_COOKED"
msgid "Cooked, but not into a dish."
msgstr "Cocinada, pero no emplatada."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.QUAGMIRE_ONION_SEEDS
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.QUAGMIRE_ONION_SEEDS"
msgid "Strange little seeds, indeed, indeed."
msgstr "Unas semillitas peculiares por estos lares."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.QUAGMIRE_OVEN
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.QUAGMIRE_OVEN"
msgid "It's a thing mortals cook with."
msgstr "Una cosa con la que cocinan los mortales."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.QUAGMIRE_OVEN_ITEM
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.QUAGMIRE_OVEN_ITEM"
msgid "We need to build that, yes indeed."
msgstr "Tenemos que construirlo, claro que sí."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.QUAGMIRE_PARKSPIKE
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.QUAGMIRE_PARKSPIKE"
msgid "A wall, a wall, so very tall."
msgstr "Un muro alto, bien alto."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.QUAGMIRE_PARK_ANGEL
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.QUAGMIRE_PARK_ANGEL"
msgid "I could draw a little moustache on it when no one's looking."
msgstr "Podría dibujarle un bigote sin que nadie se dé cuenta."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.QUAGMIRE_PARK_ANGEL2
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.QUAGMIRE_PARK_ANGEL2"
msgid "This one's already got a beard."
msgstr "Este ya tiene barba."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.QUAGMIRE_PARK_FOUNTAIN
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.QUAGMIRE_PARK_FOUNTAIN"
msgid "How disappointing, it's all dried up."
msgstr "Qué decepción. Está seca, seca."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.QUAGMIRE_PARK_GATE.GENERIC
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.QUAGMIRE_PARK_GATE.GENERIC"
msgid "This way to the park!"
msgstr "¡Al parque por aquí!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.QUAGMIRE_PARK_GATE.LOCKED
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.QUAGMIRE_PARK_GATE.LOCKED"
msgid "Let me out! Hyuyu, just kidding."
msgstr "¡Déjenme salir! Jiu, ju, era broma."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.QUAGMIRE_PARK_OBELISK
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.QUAGMIRE_PARK_OBELISK"
msgid "Nothing fun to find here."
msgstr "Aquí no hay nada divertido."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.QUAGMIRE_PARK_URN
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.QUAGMIRE_PARK_URN"
msgid "There's probably nothing fun inside."
msgstr "No creo que haya nada divertido dentro."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.QUAGMIRE_PEBBLECRAB
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.QUAGMIRE_PEBBLECRAB"
msgid "What a funny creature!"
msgstr "¡Qué criatura tan divertida!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.QUAGMIRE_PIGEON.DEAD
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.QUAGMIRE_PIGEON.DEAD"
msgid "Oh goodness, oh gracious."
msgstr "Ay, cielos. Ay, rayos."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.QUAGMIRE_PIGEON.GENERIC
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.QUAGMIRE_PIGEON.GENERIC"
msgid "I've heard they make good pie."
msgstr "Dicen que quedan bien en un pastel."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.QUAGMIRE_PIGEON.SLEEPING
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.QUAGMIRE_PIGEON.SLEEPING"
msgid "Sleep and dream, little wing."
msgstr "Duerme y sueña, pajarito."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.QUAGMIRE_PLATE_SILVER
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.QUAGMIRE_PLATE_SILVER"
msgid "Are there any souls on the menu?"
msgstr "¿Hay almas en el menú?"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.QUAGMIRE_POND_SALT
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.QUAGMIRE_POND_SALT"
msgid "It's very salty water."
msgstr "Es agua muy salada."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.QUAGMIRE_PORTAL
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.QUAGMIRE_PORTAL"
msgid "A way out or in, depending who you are."
msgstr "Una entrada o una salida, según donde estés."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.QUAGMIRE_PORTAL_KEY
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.QUAGMIRE_PORTAL_KEY"
msgid "Hyuyu! Let us hop away!"
msgstr "¡Jiu, ju! ¡Salgamos brincando de aquí!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.QUAGMIRE_POT
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.QUAGMIRE_POT"
msgid "Mortals don't like it when you burn the things inside."
msgstr "A los mortales no les gusta cuando se queman las cosas por dentro."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.QUAGMIRE_POTATO
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.QUAGMIRE_POTATO"
msgid "Mortals like this in all its forms. Will a wyrm?"
msgstr "A los mortales les gusta de todas las formas posibles. ¿Y a una sierpe?"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.QUAGMIRE_POTATO_COOKED
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.QUAGMIRE_POTATO_COOKED"
msgid "Cooked, but not into a dish."
msgstr "Cocinada, pero no emplatada."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.QUAGMIRE_POTATO_SEEDS
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.QUAGMIRE_POTATO_SEEDS"
msgid "Strange little seeds, indeed, indeed."
msgstr "Unas semillitas peculiares por estos lares."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.QUAGMIRE_POT_HANGER
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.QUAGMIRE_POT_HANGER"
msgid "You can hang a pot on it."
msgstr "Puedes colgar una olla aquí."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.QUAGMIRE_POT_HANGER_ITEM
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.QUAGMIRE_POT_HANGER_ITEM"
msgid "We need to build that, yes indeed."
msgstr "Tenemos que construirlo, claro que sí."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.QUAGMIRE_POT_SMALL
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.QUAGMIRE_POT_SMALL"
msgid "A little vessel for mortal food."
msgstr "Un pequeño recipiente para comida mortal."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.QUAGMIRE_POT_SYRUP
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.QUAGMIRE_POT_SYRUP"
msgid "Mortals don't like raw tree insides."
msgstr "A los mortales no les gustan las entrañas de árboles crudas."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.QUAGMIRE_ROTTEN_CROP
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.QUAGMIRE_ROTTEN_CROP"
msgid "Yuck, muck."
msgstr "Puaj, qué porquería."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.QUAGMIRE_RUBBLE_BIKE
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.QUAGMIRE_RUBBLE_BIKE"
msgid "Cycles spinning round and round. Bicycles double the spinning!"
msgstr "Una bicicleta son dos «cicletas» que giran sin parar."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.QUAGMIRE_RUBBLE_CARRIAGE
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.QUAGMIRE_RUBBLE_CARRIAGE"
msgid "Which squeaky wheel will get the grease?"
msgstr "¿Qué rueda chirriante recibirá grasa al instante?"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.QUAGMIRE_RUBBLE_CATHEDRAL
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.QUAGMIRE_RUBBLE_CATHEDRAL"
msgid "It all comes tumbling down."
msgstr "Todo al final se derrumba."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.QUAGMIRE_RUBBLE_CHIMNEY
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.QUAGMIRE_RUBBLE_CHIMNEY"
msgid "It all comes tumbling down."
msgstr "Todo al final se derrumba."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.QUAGMIRE_RUBBLE_CHIMNEY2
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.QUAGMIRE_RUBBLE_CHIMNEY2"
msgid "Tumbley, rumbley, falling right down."
msgstr "Esta chimenea se cayó, se cayó."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.QUAGMIRE_RUBBLE_CLOCK
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.QUAGMIRE_RUBBLE_CLOCK"
msgid "Hickory dickory dock, hyuyu!"
msgstr "¡Tic, tac, tic, tac! Jiu, ju."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.QUAGMIRE_RUBBLE_CLOCKTOWER
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.QUAGMIRE_RUBBLE_CLOCKTOWER"
msgid "The hands have stopped. Time is difficult to grasp."
msgstr "Las agujas se detuvieron. Ya no pueden pinchar el tiempo."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.QUAGMIRE_RUBBLE_HOUSE.1
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.QUAGMIRE_RUBBLE_HOUSE.1"
msgid "Rubble, ruin!"
msgstr "¡Escombros y ruinas!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.QUAGMIRE_RUBBLE_HOUSE.2
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.QUAGMIRE_RUBBLE_HOUSE.2"
msgid "No souls to see."
msgstr "No se ve ni un alma."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.QUAGMIRE_RUBBLE_HOUSE.3
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.QUAGMIRE_RUBBLE_HOUSE.3"
msgid "Huff and puff, and blow your house down!"
msgstr "¡Sopla y resopla, y derriba tu casa!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.QUAGMIRE_RUBBLE_PUBDOOR
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.QUAGMIRE_RUBBLE_PUBDOOR"
msgid "A door to nowhere, hyuyu!"
msgstr "¡Una puerta a ninguna parte, jiu, ju!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.QUAGMIRE_RUBBLE_ROOF
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.QUAGMIRE_RUBBLE_ROOF"
msgid "It all comes tumbling down."
msgstr "Todo al final se derrumba."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.QUAGMIRE_SAFE.GENERIC
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.QUAGMIRE_SAFE.GENERIC"
msgid "None can impede this imp!"
msgstr "¡Nada puede obstaculizar a este diablillo!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.QUAGMIRE_SAFE.LOCKED
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.QUAGMIRE_SAFE.LOCKED"
msgid "Oh whiskers. It's locked tight."
msgstr "Cáspita. Está bien cerrada."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.QUAGMIRE_SALMON
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.QUAGMIRE_SALMON"
msgid "It doesn't like the air, oh no."
msgstr "No le gusta el aire, no."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.QUAGMIRE_SALMON_COOKED
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.QUAGMIRE_SALMON_COOKED"
msgid "So long, sweet fish soul."
msgstr "Hasta siempre, tierna alma de pescado."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.QUAGMIRE_SALT
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.QUAGMIRE_SALT"
msgid "Mortals tongues seem to like it."
msgstr "A los paladares mortales parece gustarles."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.QUAGMIRE_SALTROCK
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.QUAGMIRE_SALTROCK"
msgid "Humans use it as a \"spice\"."
msgstr "Los humanos lo usan como «especia»."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.QUAGMIRE_SALT_RACK.GENERIC
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.QUAGMIRE_SALT_RACK.GENERIC"
msgid "The mortals crave these minerals."
msgstr "Los mortales ansían estos minerales."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.QUAGMIRE_SALT_RACK.READY
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.QUAGMIRE_SALT_RACK.READY"
msgid "The minerals are ready."
msgstr "Los minerales están listos."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.QUAGMIRE_SALT_RACK_ITEM
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.QUAGMIRE_SALT_RACK_ITEM"
msgid "It's meant to go above a pond."
msgstr "Tiene que colocarse sobre un estanque."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.QUAGMIRE_SAP
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.QUAGMIRE_SAP"
msgid "Sticky, icky sap!"
msgstr "¡Savia asquerosa y pegajosa!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.QUAGMIRE_SAPBUCKET
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.QUAGMIRE_SAPBUCKET"
msgid "It's for filling up with sap."
msgstr "Para llenarlo con savia."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.QUAGMIRE_SAPLING
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.QUAGMIRE_SAPLING"
msgid "Tiny little baby tree."
msgstr "Un arbolito bebé."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.QUAGMIRE_SAP_SPOILED
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.QUAGMIRE_SAP_SPOILED"
msgid "Whoops-a-doodle!"
msgstr "¡Metí la pata!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.QUAGMIRE_SEEDPACKET
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.QUAGMIRE_SEEDPACKET"
msgid "Plant them in a plot of land."
msgstr "Hay que plantarlas en la tierra."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.QUAGMIRE_SLAUGHTERTOOL
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.QUAGMIRE_SLAUGHTERTOOL"
msgid "I don't like this sort of prank."
msgstr "No me gusta este tipo de broma."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.QUAGMIRE_SPOTSPICE_GROUND
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.QUAGMIRE_SPOTSPICE_GROUND"
msgid "Mortals say grinding it brings out the flavor."
msgstr "Los mortales dicen que al molerla se siente el sabor."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.QUAGMIRE_SPOTSPICE_SHRUB.GENERIC
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.QUAGMIRE_SPOTSPICE_SHRUB.GENERIC"
msgid "I bet the mortals would like some of that."
msgstr "A los mortales les gustaría probar un poco."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.QUAGMIRE_SPOTSPICE_SHRUB.PICKED
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.QUAGMIRE_SPOTSPICE_SHRUB.PICKED"
msgid "Gone, all gone."
msgstr "No queda nada de nada."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.QUAGMIRE_SPOTSPICE_SPRIG
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.QUAGMIRE_SPOTSPICE_SPRIG"
msgid "Spice! ...How nice!"
msgstr "¡Picante! ¡Qué fascinante!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.QUAGMIRE_SUGARWOODTREE.GENERIC
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.QUAGMIRE_SUGARWOODTREE.GENERIC"
msgid "Fweehee, what a special tree!"
msgstr "¡Ji, ji, ji! Qué árbol tan especial."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.QUAGMIRE_SUGARWOODTREE.STUMP
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.QUAGMIRE_SUGARWOODTREE.STUMP"
msgid "That's a wrap on the sap."
msgstr "Sabía que la savia se acabaría."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.QUAGMIRE_SUGARWOODTREE.TAPPED_BUGS
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.QUAGMIRE_SUGARWOODTREE.TAPPED_BUGS"
msgid "Those bugs are tree thugs!"
msgstr "El árbol sufre el ataque de esos bichos detestables."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.QUAGMIRE_SUGARWOODTREE.TAPPED_EMPTY
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.QUAGMIRE_SUGARWOODTREE.TAPPED_EMPTY"
msgid "The tap will soon make sap!"
msgstr "Saldrá sabrosa savia."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.QUAGMIRE_SUGARWOODTREE.TAPPED_READY
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.QUAGMIRE_SUGARWOODTREE.TAPPED_READY"
msgid "Sweet, sugary sap!"
msgstr "¡Savia dulce y azucarada!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.QUAGMIRE_SUGARWOODTREE.WOUNDED
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.QUAGMIRE_SUGARWOODTREE.WOUNDED"
msgid "An unfortunate mishap befell the tree sap."
msgstr "Una desafortunada desgracia le ocurrió a la savia."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.QUAGMIRE_SWAMPIG
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.QUAGMIRE_SWAMPIG"
msgid "Do you feel it loom? Your impending doom?"
msgstr "¿Sientes cómo se acerca tu inminente condena?"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.QUAGMIRE_SWAMPIGELDER.GENERIC
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.QUAGMIRE_SWAMPIGELDER.GENERIC"
msgid "My oh my, you look ill! Low of spirit, green 'round the gill."
msgstr "¡Oh, cielos, pareces decaído! Sin ánimo, enfermo, abatido."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.QUAGMIRE_SWAMPIGELDER.SLEEPING
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.QUAGMIRE_SWAMPIGELDER.SLEEPING"
msgid "Sleeping like the fishes. Hyuyu!"
msgstr "Durmiendo como los peces. ¡Jiu, ju!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.QUAGMIRE_SWAMPIG_HOUSE
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.QUAGMIRE_SWAMPIG_HOUSE"
msgid "A house that's cobbled from bits and bobs."
msgstr "Una casa construida a base de restos."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.QUAGMIRE_SWAMPIG_HOUSE_RUBBLE
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.QUAGMIRE_SWAMPIG_HOUSE_RUBBLE"
msgid "Nothing but bits and bobs left."
msgstr "No quedan más que restos."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.QUAGMIRE_SYRUP
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.QUAGMIRE_SYRUP"
msgid "For making sweet treats."
msgstr "Para hacer dulces."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.QUAGMIRE_TOMATO
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.QUAGMIRE_TOMATO"
msgid "I could throw it at the wyrm!"
msgstr "¡Podría lanzárselo a la sierpe!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.QUAGMIRE_TOMATO_COOKED
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.QUAGMIRE_TOMATO_COOKED"
msgid "Cooked, but not into a dish."
msgstr "Cocinado, pero no emplatado."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.QUAGMIRE_TOMATO_SEEDS
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.QUAGMIRE_TOMATO_SEEDS"
msgid "Strange little seeds, indeed, indeed."
msgstr "Unas semillitas peculiares por estos lares."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.QUAGMIRE_TRADER_MERM
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.QUAGMIRE_TRADER_MERM"
msgid "What a funny face you have!"
msgstr "¡Qué cara tan graciosa tienes!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.QUAGMIRE_TRADER_MERM2
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.QUAGMIRE_TRADER_MERM2"
msgid "Hyuyu, what a funny moustache!"
msgstr "¡Jiu, ju, qué bigote tan gracioso!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.QUAGMIRE_TURNIP
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.QUAGMIRE_TURNIP"
msgid "That's a tiny turnip."
msgstr "Qué nabo chiquito."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.QUAGMIRE_TURNIP_COOKED
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.QUAGMIRE_TURNIP_COOKED"
msgid "Cooked, but not into a dish."
msgstr "Cocinado, pero no emplatado."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.QUAGMIRE_TURNIP_SEEDS
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.QUAGMIRE_TURNIP_SEEDS"
msgid "Strange little seeds, indeed, indeed."
msgstr "Unas semillitas peculiares por estos lares."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.QUAGMIRE_WHEAT
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.QUAGMIRE_WHEAT"
msgid "The mortals grind it up with big rocks."
msgstr "Los mortales lo muelen con rocas grandes."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.QUAGMIRE_WHEAT_SEEDS
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.QUAGMIRE_WHEAT_SEEDS"
msgid "Strange little seeds, indeed, indeed."
msgstr "Unas semillitas peculiares por estos lares."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.RABBIT.GENERIC
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.RABBIT.GENERIC"
msgid "A fellow hopper."
msgstr "Un saltarín como yo."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.RABBIT.HELD
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.RABBIT.HELD"
msgid "Do not touch my paws or claws."
msgstr "No me toques las patas ni las garras."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.RABBITHAT
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.RABBITHAT"
msgid "Aww, lookit that! A rabbit hat!"
msgstr "¡Mira eso! Un sombrero de conejo."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.RABBITHOLE.GENERIC
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.RABBITHOLE.GENERIC"
msgid "Hopping wonders live within."
msgstr "Dentro viven criaturas saltarinas."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.RABBITHOLE.SPRING
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.RABBITHOLE.SPRING"
msgid "You'll not be hopping through that hole!"
msgstr "¡No vas a entrar brincando por ese hoyo!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.RABBITHOUSE.BURNT
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.RABBITHOUSE.BURNT"
msgid "Burnt down to the ground."
msgstr "Se quemó del todo."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.RABBITHOUSE.GENERIC
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.RABBITHOUSE.GENERIC"
msgid "Hyuyu! How whimsical."
msgstr "¡Jiu, ju! Qué extravagante."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.RABBITKINGHORN
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.RABBITKINGHORN"
msgid "It plays a tunneling tune."
msgstr "Toca una melodía excavadora."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.RABBITKINGHORN_CHEST
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.RABBITKINGHORN_CHEST"
msgid "Subterranean storage service"
msgstr "Un dispositivo de almacenamiento subterráneo."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.RABBITKINGMINION_BUNNYMAN
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.RABBITKINGMINION_BUNNYMAN"
msgid "It's a warrin' warren!"
msgstr "¡Una conejera con pocas pulgas!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.RABBITKINGSPEAR
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.RABBITKINGSPEAR"
msgid "A bludgeon from a long-eared curmudgeon."
msgstr "Un garrote de un orejón grandote."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.RABBITKING_AGGRESSIVE
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.RABBITKING_AGGRESSIVE"
msgid "Let his kicks miss you, he's got an anger issue!"
msgstr "Esquiven las patadas de esa bestia desacatada."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.RABBITKING_LUCKY
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.RABBITKING_LUCKY"
msgid "That rabbit! Grab it!"
msgstr "¡Agarren a ese conejo!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.RABBITKING_PASSIVE
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.RABBITKING_PASSIVE"
msgid "The hare has an air about him."
msgstr "Ese bicho leporino parece ladino."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.RAINCOAT
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.RAINCOAT"
msgid "The puddles wait out there for me!"
msgstr "¡Los charcos me esperan!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.RAINHAT
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.RAINHAT"
msgid "Splish and splash!"
msgstr "¡Chapotea que chapotea!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.RAINOMETER.BURNT
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.RAINOMETER.BURNT"
msgid "A silly prank to be sure."
msgstr "Una broma tonta, está claro."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.RAINOMETER.GENERIC
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.RAINOMETER.GENERIC"
msgid "Will it rain? Or will it shine?"
msgstr "¿Lloverá? ¿O el sol saldrá?"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.RATATOUILLE
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.RATATOUILLE"
msgid "Physical food doesn't sit well with me."
msgstr "La comida física no me sienta bien."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.RAZOR
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.RAZOR"
msgid "I do not shave."
msgstr "Yo no me afeito."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.RECORD
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.RECORD"
msgid "Encore!"
msgstr "¡Otra, otra!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.RECORD_CREEPYFOREST
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.RECORD_CREEPYFOREST"
msgid "What a cheeky little tune."
msgstr "Qué canción atrevida."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.RECORD_DANGER
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.RECORD_DANGER"
msgid "Oh dear, what have we here?"
msgstr "Ay, vaya. ¿Qué tenemos aquí?"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.RECORD_DAWN
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.RECORD_DAWN"
msgid "A delight at first light!"
msgstr "¡Un placer al amanecer!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.RECORD_DRSTYLE
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.RECORD_DRSTYLE"
msgid "I think I heard this in a dream."
msgstr "Creo que la oí en un sueño."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.RECORD_DUSK
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.RECORD_DUSK"
msgid "That's it?"
msgstr "¿Eso es todo?"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.RECORD_EFS
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.RECORD_EFS"
msgid "Oh dear, what have we here?"
msgstr "Ay, vaya. ¿Qué tenemos aquí?"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.RECORD_END
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.RECORD_END"
msgid "That's it?"
msgstr "¿Eso es todo?"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.RECORD_HALLOWEDNIGHTS
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.RECORD_HALLOWEDNIGHTS"
msgid "Thrilling and chilling!"
msgstr ""

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.RECORD_MAIN
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.RECORD_MAIN"
msgid "What a cheeky little tune."
msgstr "Qué canción atrevida."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.RECORD_WORKTOBEDONE
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.RECORD_WORKTOBEDONE"
msgid "Oh dear, what have we here?"
msgstr "Ay, vaya. ¿Qué tenemos aquí?"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.REDGEM
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.REDGEM"
msgid "Deepest red, from golems bled."
msgstr "Rojo intenso de la sangre de gólems inmensos."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.REDLANTERN
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.REDLANTERN"
msgid "What a pretty sight to see!"
msgstr "¡Qué vista tan bonita!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.REDMOONEYE
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.REDMOONEYE"
msgid "Red, so red. Like the fur I shed."
msgstr "Rojo, rojo puro. Como el pelo que mudo."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.REDPOUCH
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.REDPOUCH"
msgid "The luck magic is practically radiating off it."
msgstr "La magia de la suerte irradia de ella."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.RED_CAP
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.RED_CAP"
msgid "Oh, no thank you."
msgstr "Oh, no, gracias."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.RED_CAP_COOKED
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.RED_CAP_COOKED"
msgid "My head aches just looking at it!"
msgstr "¡Me duele la cabeza de tan solo mirarlo!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.RED_MUSHROOM.GENERIC
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.RED_MUSHROOM.GENERIC"
msgid "Hyuyu! Do not think to poison me!"
msgstr "¡Jiu, ju ¡Ni se te ocurra envenenarme!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.RED_MUSHROOM.INGROUND
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.RED_MUSHROOM.INGROUND"
msgid "It's playing hide and seek!"
msgstr "¡Está jugando a las escondidas!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.RED_MUSHROOM.PICKED
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.RED_MUSHROOM.PICKED"
msgid "Gone, all gone."
msgstr "No queda nada de nada."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.REEDS.BURNING
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.REEDS.BURNING"
msgid "Whoops-a-doodle."
msgstr "Metí la pata."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.REEDS.GENERIC
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.REEDS.GENERIC"
msgid "Just my luck! There's reeds to pluck!"
msgstr "Qué desafortunado. Muchos juncos que deben ser arrancados."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.REEDS.PICKED
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.REEDS.PICKED"
msgid "Gone, all gone."
msgstr "No queda nada de nada."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.REFINED_DUST
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.REFINED_DUST"
msgid "Just a bit of faith, trust, and assorted dust."
msgstr "Solo necesitas fe, confianza y polvo de... algo."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.REFLECTIVEVEST
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.REFLECTIVEVEST"
msgid "It's bright like my personality."
msgstr "Es brillante como mi personalidad."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.RELIC
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.RELIC"
msgid "It's just a bunch of unfun stuff!"
msgstr "¡Es solo un montón de cosas aburridas!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.RESEARCHLAB.BURNT
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.RESEARCHLAB.BURNT"
msgid "Well, that was fun."
msgstr "Bueno, fue divertido."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.RESEARCHLAB.GENERIC
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.RESEARCHLAB.GENERIC"
msgid "Mortals play such silly games."
msgstr "Los mortales juegan a juegos muy tontos."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.RESEARCHLAB2.BURNT
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.RESEARCHLAB2.BURNT"
msgid "Well, that was fun."
msgstr "Bueno, fue divertido."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.RESEARCHLAB2.GENERIC
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.RESEARCHLAB2.GENERIC"
msgid "Oh, how amusing!"
msgstr "¡Oh, qué gracioso!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.RESEARCHLAB3.BURNT
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.RESEARCHLAB3.BURNT"
msgid "That's one way to nullify magic."
msgstr "Es una forma de anular la magia."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.RESEARCHLAB3.GENERIC
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.RESEARCHLAB3.GENERIC"
msgid "There's magic fun to be had here."
msgstr "Aquí te puedes divertir con magia."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.RESEARCHLAB4.BURNT
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.RESEARCHLAB4.BURNT"
msgid "That's one way to nullify magic."
msgstr "Es una forma de anular la magia."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.RESEARCHLAB4.GENERIC
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.RESEARCHLAB4.GENERIC"
msgid "It runs on silly trick power."
msgstr "Funciona con el poder de los trucos tontos."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.RESKIN_TOOL
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.RESKIN_TOOL"
msgid "Oooh, the pranks I could pull with this!"
msgstr "¡Ooh, cuántas bromas podría hacer con esto!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.RESURRECTIONSTATUE.BURNT
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.RESURRECTIONSTATUE.BURNT"
msgid "Delayed gratification imp banishment."
msgstr "Ya no sirve de nada."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.RESURRECTIONSTATUE.GENERIC
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.RESURRECTIONSTATUE.GENERIC"
msgid "I can never die! Hyuyu!"
msgstr "¡No puedo morirme nunca! ¡Jiu, ju!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.RESURRECTIONSTONE
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.RESURRECTIONSTONE"
msgid "Bring me back from death's dark planes!"
msgstr "¡Rescátame de los planos oscuros de la muerte!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.REVIVER
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.REVIVER"
msgid "So my friends might live to tell the tale!"
msgstr "¡Para que mis amigos puedan vivir para contarlo!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.RHINODRILL
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.RHINODRILL"
msgid "Is that double I do see?"
msgstr "¿Estoy viendo doble?"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.ROASTTURKEY
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.ROASTTURKEY"
msgid "It certainly looks like a turkey."
msgstr "Sin duda parece un pavo."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.ROBIN.GENERIC
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.ROBIN.GENERIC"
msgid "What a fun shade of red."
msgstr "Qué tonalidad de rojo tan divertida."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.ROBIN.HELD
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.ROBIN.HELD"
msgid "Mind my fingers."
msgstr "Ten cuidado con mis dedos."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.ROBIN_WINTER.GENERIC
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.ROBIN_WINTER.GENERIC"
msgid "That's a bird, or so I've heard."
msgstr "Es un ave, eso se sabe."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.ROBIN_WINTER.HELD
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.ROBIN_WINTER.HELD"
msgid "Mind my fingers."
msgstr "Ten cuidado con mis dedos."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.ROBOT_BLUEPRINT
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.ROBOT_BLUEPRINT"
msgid "This outfit might require a lot of ironing, hyuyu!"
msgstr "Este traje es un poco rígido, ¡jiu, ju!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.ROBOT_PUPPET
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.ROBOT_PUPPET"
msgid "Greetings and salutations, sweet compeer."
msgstr "Saludos, estimadísimo compañero."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.ROCK
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.ROCK"
msgid "What a shock! It's a rock!"
msgstr "¡Pero qué cosa! ¡Una roca!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.ROCKS
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.ROCKS"
msgid "Maybe they're boulders and I just grew really big."
msgstr "Tal vez sean pedruscos y yo me haya convertido en un gigante."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.ROCKY
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.ROCKY"
msgid "Can a rock possess a soul?"
msgstr "¿Una roca puede tener alma?"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.ROCK_AVOCADO_BUSH.BARREN
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.ROCK_AVOCADO_BUSH.BARREN"
