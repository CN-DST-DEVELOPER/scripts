msgid "That ain't coming back to life."
msgstr "No volverá a la vida."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.RESURRECTIONSTATUE.GENERIC
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.RESURRECTIONSTATUE.GENERIC"
msgid "Looks just like that egghead! Ha!"
msgstr "¡Se parece a ese cabezahuevo! ¡Ja!"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.RESURRECTIONSTONE
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.RESURRECTIONSTONE"
msgid "Does anyone actually stay dead around here?"
msgstr "¿De verdad alguien se queda muerto por aquí?"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.REVIVER
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.REVIVER"
msgid "I got heart to spare."
msgstr "Tengo corazón de sobra."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.RHINODRILL
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.RHINODRILL"
msgid "Am I supposed to be impressed?"
msgstr "¿Debo estar impresionada?"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.ROASTTURKEY
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.ROASTTURKEY"
msgid "Now that's a beautiful bird!"
msgstr "¡Esto sí que es un pájaro bonito!"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.ROBIN.GENERIC
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.ROBIN.GENERIC"
msgid "She ain't bothering no one."
msgstr "No está molestando a nadie."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.ROBIN.HELD
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.ROBIN.HELD"
msgid "She feels real fragile in my hands."
msgstr "Parece muy frágil en mis manos."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.ROBIN_WINTER.GENERIC
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.ROBIN_WINTER.GENERIC"
msgid "She ain't bothering no one."
msgstr "No está molestando a nadie."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.ROBIN_WINTER.HELD
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.ROBIN_WINTER.HELD"
msgid "You're just feather and bone."
msgstr "No eres más que plumas y huesos."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.ROBOT_BLUEPRINT
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.ROBOT_BLUEPRINT"
msgid "Now this one I can do!"
msgstr "¡Este sí puedo hacerlo!"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.ROBOT_PUPPET
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.ROBOT_PUPPET"
msgid "They don't look none too happy."
msgstr "No parecen muy felices."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.ROCK
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.ROCK"
msgid "Mhm, yep. That's a rock."
msgstr "Mmm, sí. Es una roca."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.ROCKS
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.ROCKS"
msgid "A bunch of rocks."
msgstr "Un montón de rocas."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.ROCKY
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.ROCKY"
msgid "Easy there, slugger!"
msgstr "¡Tranquilo, campeón!"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.ROCK_AVOCADO_BUSH.BARREN
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.ROCK_AVOCADO_BUSH.BARREN"
msgid "It's done making fruit. Forever."
msgstr "Ya no va a dar frutos. Nunca más."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.ROCK_AVOCADO_BUSH.BURNING
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.ROCK_AVOCADO_BUSH.BURNING"
msgid "Yeesh, that thing's on fire!"
msgstr "Uuy, ¡esta cosa está en llamas!"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.ROCK_AVOCADO_BUSH.DISEASED
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.ROCK_AVOCADO_BUSH.DISEASED"
msgid "It's definitely diseased."
msgstr "Definitivamente tiene una enfermedad."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.ROCK_AVOCADO_BUSH.DISEASING
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.ROCK_AVOCADO_BUSH.DISEASING"
msgid "I think it's coming down with something."
msgstr "Creo que se está enfermando."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.ROCK_AVOCADO_BUSH.GENERIC
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.ROCK_AVOCADO_BUSH.GENERIC"
msgid "It looks like it's growing rocks!"
msgstr "¡Parece que está dando rocas!"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.ROCK_AVOCADO_BUSH.PICKED
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.ROCK_AVOCADO_BUSH.PICKED"
msgid "Ain't got none of them little stone fruits today."
msgstr "Hoy no tiene ninguno de esas pequeñas frutas pétreas."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.ROCK_AVOCADO_BUSH.WITHERED
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.ROCK_AVOCADO_BUSH.WITHERED"
msgid "You look a little down there, bucko."
msgstr "Pareces algo bajo de ánimos, amigo."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.ROCK_AVOCADO_FRUIT
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.ROCK_AVOCADO_FRUIT"
msgid "Not sure how to crack this nut."
msgstr "No tengo claro cómo cascar esto."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.ROCK_AVOCADO_FRUIT_RIPE
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.ROCK_AVOCADO_FRUIT_RIPE"
msgid "I think I could eat it now."
msgstr "Creo que ya se puede comer."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.ROCK_AVOCADO_FRUIT_RIPE_COOKED
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.ROCK_AVOCADO_FRUIT_RIPE_COOKED"
msgid "Who knew rocks were so tasty looking inside?"
msgstr "¡Quién diría que las rocas tienen un aspecto tan apetecible por dentro!"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.ROCK_AVOCADO_FRUIT_SPROUT
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.ROCK_AVOCADO_FRUIT_SPROUT"
msgid "We could use more fruit bushes I suppose."
msgstr "Supongo que nos vendrían bien más arbustos frutales."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.ROCK_ICE.GENERIC
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.ROCK_ICE.GENERIC"
msgid "A weirdly isolated glacier."
msgstr "Un glaciar aislado de forma extraña."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.ROCK_ICE.MELTED
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.ROCK_ICE.MELTED"
msgid "Yep. That's a puddle."
msgstr "Sí. Es un charco."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.ROCK_ICE_MELTED
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.ROCK_ICE_MELTED"
msgid "Yep. That's a puddle."
msgstr "Sí. Es un charco."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.ROCK_LIGHT.GENERIC
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.ROCK_LIGHT.GENERIC"
msgid "Some sorta crusty rock."
msgstr "Algún tipo de roca costrosa."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.ROCK_LIGHT.LOW
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.ROCK_LIGHT.LOW"
msgid "It's losing heat."
msgstr "Pierde calor."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.ROCK_LIGHT.NORMAL
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.ROCK_LIGHT.NORMAL"
msgid "A real scorcher!"
msgstr "¡Eso sí que da calor!"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.ROCK_LIGHT.OUT
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.ROCK_LIGHT.OUT"
msgid "That ain't burning no one."
msgstr "No quemará a nadie."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.ROCK_MOON
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.ROCK_MOON"
msgid "Seems like just another rock to me."
msgstr "A mí me parece otra roca más."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.ROCK_PETRIFIED_TREE
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.ROCK_PETRIFIED_TREE"
msgid "Solid stone."
msgstr "Piedra sólida."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.ROCK_PETRIFIED_TREE_OLD
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.ROCK_PETRIFIED_TREE_OLD"
msgid "Solid stone."
msgstr "Piedra sólida."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.ROOK
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.ROOK"
msgid "No way that was made in a factory."
msgstr "No hay manera de que lo hayan hecho en una fábrica."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.ROOK_NIGHTMARE
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.ROOK_NIGHTMARE"
msgid "Get a load of this spalder."
msgstr "Fíjate en este pedazo de chatarra."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.ROPE
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.ROPE"
msgid "An essential building material."
msgstr "Un material de construcción esencial."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.ROPE_BRIDGE_KIT
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.ROPE_BRIDGE_KIT"
msgid "We're puttin' a lot of trust in this thing."
msgstr "Estamos teniendo mucha fe en esto."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.ROSEGLASSESHAT.GENERIC
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.ROSEGLASSESHAT.GENERIC"
msgid "Alright, Charlie. Show me the way."
msgstr "Está bien, Charlie. Enséñame el camino."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.ROSEGLASSESHAT.MISSINGSKILL
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.ROSEGLASSESHAT.MISSINGSKILL"
msgid "Something about 'em makes me really miss Charlie."
msgstr "Hay algo en esto que me hace extrañar a Charlie."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.ROTTENEGG
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.ROTTENEGG"
msgid "Yeesh, get a whiff of that. No wait, don't!"
msgstr "Uf, huele eso. ¡No, espera, no lo hagas!"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.ROYAL_JELLY
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.ROYAL_JELLY"
msgid "A big bee boogie."
msgstr "Un gran manjar de abejas."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.RUBBLE
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.RUBBLE"
msgid "The foundation's crumbling."
msgstr "La base se está desmoronando."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.RUINSHAT
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.RUINSHAT"
msgid "Transforms the wearer into the \"King of Snoot\"."
msgstr "Transforma a quien lo lleva en el «Rey de la presunción»."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.RUINS_BAT
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.RUINS_BAT"
msgid "This thulecite stuff is incredible!"
msgstr "¡Esta thulecita es increíble!"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.RUINS_RUBBLE
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.RUINS_RUBBLE"
msgid "In dire need of repairs. Good thing I'm here."
msgstr "Necesita una buena reparación. Menos mal que estoy aquí."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.SACRED_CHEST.GENERIC
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.SACRED_CHEST.GENERIC"
msgid "Yeesh, it's givin' me the creeps."
msgstr "Uy, me está poniendo los pelos de punta."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.SACRED_CHEST.LOCKED
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.SACRED_CHEST.LOCKED"
msgid "It's thinkin' real hard on it."
msgstr "Se lo está pensando mucho."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.SADDLEHORN
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.SADDLEHORN"
msgid "Takes a saddle off real quick."
msgstr "Quita la montura muy rápido."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.SADDLE_BASIC
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.SADDLE_BASIC"
msgid "How'd I get saddled with this? Ha!"
msgstr "¡Tengo que tomar las riendas del asunto! ¡Ja!"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.SADDLE_RACE
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.SADDLE_RACE"
msgid "Still wouldn't keep up with a Leapin' Lena..."
msgstr "Ni siquiera así podría aguantar el ritmo de un autito..."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.SADDLE_SHADOW
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.SADDLE_SHADOW"
msgid "Looks kinda forebodin', don't it?"
msgstr "Se ve un poco inquietante, ¿no?"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.SADDLE_WAR
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.SADDLE_WAR"
msgid "Alright, who wants to fight?"
msgstr "Bien, ¿quién quiere pelear?"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.SADDLE_WATHGRITHR
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.SADDLE_WATHGRITHR"
msgid "Goin' for that understated look, I see."
msgstr "Así que optas por un estilo sobrio, ¿eh?"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.SALSA
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.SALSA"
msgid "Wish I had some chips to go with this."
msgstr "Ojalá tuviera unas papas fritas para acompañar esto."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.SALTBOX
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.SALTBOX"
msgid "This'll keep things fresher longer!"
msgstr "¡Esto mantendrá fresco todo por más tiempo!"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.SALTLICK
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.SALTLICK"
msgid "Keeps livestock nice and docile."
msgstr "Mantiene al ganado dócil y tranquilo."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.SALTLICK_IMPROVED
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.SALTLICK_IMPROVED"
msgid "Do you sea salt?"
msgstr "¿No te marea la sal?"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.SALTROCK
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.SALTROCK"
msgid "Hey, that looks like salt!"
msgstr "Eh, ¡eso parece sal!"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.SALTSTACK.GENERIC
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.SALTSTACK.GENERIC"
msgid "Now that's just unsettlin'."
msgstr "Eso es inquietante."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.SALTSTACK.GROWING
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.SALTSTACK.GROWING"
msgid "Huh, I wonder why they grow like that?"
msgstr "Mmm, me pregunto por qué crecen así."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.SALTSTACK.MINED_OUT
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.SALTSTACK.MINED_OUT"
msgid "Ain't nothin left of that one."
msgstr "Ahí ya no queda nada."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.SANDBLOCK
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.SANDBLOCK"
msgid "Things are getting gritty!"
msgstr "¡Las cosas se están poniendo ásperas!"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.SANDSPIKE
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.SANDSPIKE"
msgid "Hit and a miss!"
msgstr "¡Fallaste!"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.SANITYROCK.ACTIVE
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.SANITYROCK.ACTIVE"
msgid "I can't begin to imagine how it works."
msgstr "No puedo ni imaginar cómo funciona."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.SANITYROCK.INACTIVE
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.SANITYROCK.INACTIVE"
msgid "What on earth is that thing?"
msgstr "¿Qué demonios es eso?"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.SAPLING.BURNING
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.SAPLING.BURNING"
msgid "Lit up brighter than a New York powergrid."
msgstr "Es más brillante que una red eléctrica de Nueva York."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.SAPLING.DISEASED
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.SAPLING.DISEASED"
msgid "That thing does not look good."
msgstr "No tiene buen aspecto."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.SAPLING.DISEASING
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.SAPLING.DISEASING"
msgid "You're smelling a little funky."
msgstr "Hueles un poquito raro."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.SAPLING.GENERIC
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.SAPLING.GENERIC"
msgid "Might be useful."
msgstr "Podría ser útil."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.SAPLING.PICKED
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.SAPLING.PICKED"
msgid "All the useful bits are gone."
msgstr "Todas las partes útiles desaparecieron."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.SAPLING.WITHERED
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.SAPLING.WITHERED"
msgid "The heat did a number on this one."
msgstr "El calor le hizo daño."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.SCANDATA
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.SCANDATA"
msgid "Yeesh, this stuff would make ol' Wickerbottom's writing seem flowery."
msgstr "Uy, esto haría que la caligrafía de Wickerbottom parezca florida."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.SCARECROW.BURNING
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.SCARECROW.BURNING"
msgid "That lit up real fast!"
msgstr "¡Eso se prendió fuego muy rápido!"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.SCARECROW.BURNT
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.SCARECROW.BURNT"
msgid "That happens when you build stuff with straw."
msgstr "Eso es lo que pasa cuando construyes cosas con material de paja."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.SCARECROW.GENERIC
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.SCARECROW.GENERIC"
msgid "Doesn't look too scary."
msgstr "No da tanto miedo."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.SCORCHED_SKELETON
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.SCORCHED_SKELETON"
msgid "Yikes. Not a good way to go."
msgstr "Uy. No es una buena forma de marcharse."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.SCRAPBOOK_PAGE
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.SCRAPBOOK_PAGE"
msgid "Let's see if there's anything interesting written on it."
msgstr "A ver si hay algo escrito interesante."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.SCRAPHAT
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.SCRAPHAT"
msgid "Now that's one industrial-strength hardhat!"
msgstr "¡Este sí que es un casco industrial fuerte!"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.SCRAP_MONOCLEHAT
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.SCRAP_MONOCLEHAT"
msgid "The bossman always said you gotta \"see the bigger picture.\""
msgstr "El jefe siempre me decía que tenía que «ver más allá»."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.SCULPTINGTABLE.BLOCK
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.SCULPTINGTABLE.BLOCK"
msgid "Ready for sculpting."
msgstr "Lista para esculpir."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.SCULPTINGTABLE.BURNT
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.SCULPTINGTABLE.BURNT"
msgid "Let's build another."
msgstr "Vamos a construir otra."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.SCULPTINGTABLE.EMPTY
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.SCULPTINGTABLE.EMPTY"
msgid "Not bad for a handmade table."
msgstr "No está mal para ser una mesa hecha a mano."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.SCULPTINGTABLE.SCULPTURE
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.SCULPTINGTABLE.SCULPTURE"
msgid "Looks great!"
msgstr "¡Se ve genial!"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.SCULPTURE_BISHOPBODY.COVERED
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.SCULPTURE_BISHOPBODY.COVERED"
msgid "I could take it or leave it."
msgstr "Podría tomarlo o dejarlo."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.SCULPTURE_BISHOPBODY.FINISHED
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.SCULPTURE_BISHOPBODY.FINISHED"
msgid "Doesn't that give you a good, satisfied feeling?"
msgstr "¿No te da una sensación de satisfacción?"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.SCULPTURE_BISHOPBODY.READY
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.SCULPTURE_BISHOPBODY.READY"
msgid "Something else needs to happen."
msgstr "Algo más tiene que pasar."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.SCULPTURE_BISHOPBODY.UNCOVERED
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.SCULPTURE_BISHOPBODY.UNCOVERED"
msgid "Needs a proper a repair job."
msgstr "Necesita un buen trabajo de reparación."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.SCULPTURE_BISHOPHEAD
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.SCULPTURE_BISHOPHEAD"
msgid "Someone's in need of a fixing."
msgstr "Alguien necesita una reparación."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.SCULPTURE_KNIGHTBODY.COVERED
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.SCULPTURE_KNIGHTBODY.COVERED"
msgid "I'd rather having building materials than art."
msgstr "Prefiero tener materiales de construcción que arte."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.SCULPTURE_KNIGHTBODY.FINISHED
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.SCULPTURE_KNIGHTBODY.FINISHED"
msgid "A job well done."
msgstr "Un trabajo bien hecho."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.SCULPTURE_KNIGHTBODY.READY
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.SCULPTURE_KNIGHTBODY.READY"
msgid "Something else needs to happen."
msgstr "Algo más tiene que pasar."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.SCULPTURE_KNIGHTBODY.UNCOVERED
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.SCULPTURE_KNIGHTBODY.UNCOVERED"
msgid "Creepy. Let's fix it."
msgstr "Espeluznante. Vamos a arreglarlo."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.SCULPTURE_KNIGHTHEAD
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.SCULPTURE_KNIGHTHEAD"
msgid "I just can't stand disrepair."
msgstr "No soporto las cosas en deterioro."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.SCULPTURE_ROOKBODY.COVERED
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.SCULPTURE_ROOKBODY.COVERED"
msgid "Looks like free marble to me."
msgstr "Parece mármol gratis."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.SCULPTURE_ROOKBODY.FINISHED
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.SCULPTURE_ROOKBODY.FINISHED"
