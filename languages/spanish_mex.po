msgstr "Mi cerebro científico se niega a percibirlo."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.GHOSTFLOWERHAT
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.GHOSTFLOWERHAT"
msgid "This makes me thirsty."
msgstr ""

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.GHOSTLYELIXIR_ATTACK
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.GHOSTLYELIXIR_ATTACK"
msgid "Ah yes. Very science-y."
msgstr "Ah, sí. Muy científico."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.GHOSTLYELIXIR_FASTREGEN
