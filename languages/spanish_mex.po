msgstr "No hay galletas. ¡Todavía!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.TRINKET_25
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.TRINKET_25"
msgid "It's stinky."
msgstr "Apesta."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.TRINKET_26
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.TRINKET_26"
msgid "You're our cuppy cup!"
msgstr "¡Eres una taza muy deliciosa!"

