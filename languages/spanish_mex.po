#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.YOTC_CARRAT_GYM_REACTION.GENERIC
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.YOTC_CARRAT_GYM_REACTION.GENERIC"
