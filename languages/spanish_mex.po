msgstr "Peso: {weight}\nCapturado por: {owner}\n¡Nunca habíamos visto un pez tan grandote!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.TROPHYSCALE_FISH.OWNER
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.TROPHYSCALE_FISH.OWNER"
msgid "Weight: {weight}\nCaught by: {owner}\nWe did it!"
msgstr "Peso: {weight}\nCapturado por: {owner}\n¡Lo logramos!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.TROPHYSCALE_FISH.OWNER_HEAVY
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.TROPHYSCALE_FISH.OWNER_HEAVY"
msgid "Weight: {weight}\nCaught by: {owner}\nWe caught it all by ourselves!"
msgstr "Peso: {weight}\nCapturado por: {owner}\n¡Lo hemos pescado solitos!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.TROPHYSCALE_OVERSIZEDVEGGIES.BURNING
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.TROPHYSCALE_OVERSIZEDVEGGIES.BURNING"
msgid "Uh oh..."
msgstr "Ah, ah..."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.TROPHYSCALE_OVERSIZEDVEGGIES.BURNT
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.TROPHYSCALE_OVERSIZEDVEGGIES.BURNT"
msgid "All burnt up."
msgstr "Se quemaron por completo."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.TROPHYSCALE_OVERSIZEDVEGGIES.GENERIC
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.TROPHYSCALE_OVERSIZEDVEGGIES.GENERIC"
msgid "We used to see these at the fair!"
msgstr "¡Me acuerdo de estas en la feria!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.TROPHYSCALE_OVERSIZEDVEGGIES.HAS_ITEM
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.TROPHYSCALE_OVERSIZEDVEGGIES.HAS_ITEM"
msgid "Weight: {weight}\nHarvested on day: {day}\nThat's pretty good!"
msgstr "Peso: {weight}\nSe cosechó el: {day}\n¡Bastante bien!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.TROPHYSCALE_OVERSIZEDVEGGIES.HAS_ITEM_HEAVY
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.TROPHYSCALE_OVERSIZEDVEGGIES.HAS_ITEM_HEAVY"
msgid "Weight: {weight}\nHarvested on day: {day}\nWow, we've never seen one so big!"
msgstr "Peso: {weight}\nSe cosechó el: {day}\n¡Guau! ¡Nunca había visto uno tan grande!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.TROPHYSCALE_OVERSIZEDVEGGIES.HAS_ITEM_LIGHT
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.TROPHYSCALE_OVERSIZEDVEGGIES.HAS_ITEM_LIGHT"
msgid "We guess it's a bit on the small side..."
msgstr "Es un bastante pequeño..."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.TRUNKVEST_SUMMER
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.TRUNKVEST_SUMMER"
msgid "It's so puffy!"
msgstr "¡Es muy suave!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.TRUNKVEST_WINTER
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.TRUNKVEST_WINTER"
msgid "You're always supposed to wear a jacket!"
msgstr "¡Se supone que siempre debes llevar chaqueta!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.TRUNK_COOKED
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.TRUNK_COOKED"
msgid "Looks filling!"
msgstr "¡Parece que llena mucho!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.TRUNK_SUMMER
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.TRUNK_SUMMER"
msgid "We took his nose!"
msgstr "¡Le quitamos la nariz!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.TRUNK_WINTER
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.TRUNK_WINTER"
msgid "He blue his nose."
msgstr "Qué trompa."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.TUMBLEWEED
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.TUMBLEWEED"
msgid "Who knows what that tumbleweed has picked up."
msgstr "¿Quién sabe lo que traerá esa planta rodadora?"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.TURFCRAFTINGSTATION
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.TURFCRAFTINGSTATION"
msgid "We always liked playing with dirt! Just remember to wash up before dinner."
msgstr "¡Siempre disfrutamos jugar en el lodo! Solo recuerda lavarte antes de cenar."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.TURF_ARCHIVE
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.TURF_ARCHIVE"
msgid "Some very old stones."
msgstr "Piedras viejas."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.TURF_BADLANDS
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.TURF_BADLANDS"
msgid "Some ground that we dug up."
msgstr "Un poco de tierra que cavamos."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.TURF_BEARD_RUG
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.TURF_BEARD_RUG"
msgid "It tickles!"
msgstr "¡Hace cosquillas!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.TURF_CARPETFLOOR
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.TURF_CARPETFLOOR"
msgid "Carpets! Just like in our old house."
msgstr "¡Alfombras! Como en nuestra antigua casa."

