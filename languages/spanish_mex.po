msgstr "No nos será muy útil ahora."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.TREASURECHEST.GENERIC
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.TREASURECHEST.GENERIC"
msgid "We could keep our toys in it!"
msgstr "¡Podríamos guardar nuestros juguetes!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.TREASURECHEST.UPGRADED_STACKSIZE
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.TREASURECHEST.UPGRADED_STACKSIZE"
