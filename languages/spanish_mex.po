msgstr "Podríamos usarla como columpio."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.OCEANVINE_COCOON
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.OCEANVINE_COCOON"
