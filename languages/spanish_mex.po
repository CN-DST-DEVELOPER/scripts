msgstr "Qué bestia tan atroz."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.MUTATED_PENGUIN.SLEEPING
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.MUTATED_PENGUIN.SLEEPING"
