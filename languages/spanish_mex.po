msgstr "Podemos ayudar a los pájaros a armar todo."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.CARNIVALGAME_PUCKDROP_STATION.GENERIC
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.CARNIVALGAME_PUCKDROP_STATION.GENERIC"
