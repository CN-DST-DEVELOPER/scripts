#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.QUAGMIRE_PARK_ANGEL
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.QUAGMIRE_PARK_ANGEL"
msgid "Not as pretty as Lucy."
msgstr "No tan bonito como Lucy."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.QUAGMIRE_PARK_ANGEL2
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.QUAGMIRE_PARK_ANGEL2"
