msgstr "Qué buen asado."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.TURNIP
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.TURNIP"
