msgstr "Nunca pensé que diría esto, pero no tiene arreglo."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.QUAGMIRE_RUBBLE_CATHEDRAL
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.QUAGMIRE_RUBBLE_CATHEDRAL"
