msgstr "Solo he hecho estofado antes de esto."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.QUAGMIRE_POT_SYRUP
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.QUAGMIRE_POT_SYRUP"
msgid "Syrup makes me sappy. Ha!"
msgstr "El sirope me pone empalagosa. ¡Ja!"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.QUAGMIRE_ROTTEN_CROP
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.QUAGMIRE_ROTTEN_CROP"
msgid "I am not a good farmer."
msgstr "No soy una buena agricultora."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.QUAGMIRE_RUBBLE_BIKE
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.QUAGMIRE_RUBBLE_BIKE"
msgid "It's busted."
msgstr "Está destrozada."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.QUAGMIRE_RUBBLE_CARRIAGE
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.QUAGMIRE_RUBBLE_CARRIAGE"
