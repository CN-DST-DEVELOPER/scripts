msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.LOST_TOY_10"
msgid "Hey! I could've sworn I didn't see anything there a second ago!"
msgstr "¡Ey! ¡Juraría que hace un momento no había nada allí!"

