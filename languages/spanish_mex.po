msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.OCEANFISHINGBOBBER_GOOSE"
msgid "Hmph. Guess birds are good for some things."
msgstr "Supongo que los pájaros sirven para algunas cosas."

