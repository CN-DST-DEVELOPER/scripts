msgstr "Es una puertita para pájaros."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.CARNIVALGAME_MEMORY_CARD.PLAYING
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.CARNIVALGAME_MEMORY_CARD.PLAYING"
