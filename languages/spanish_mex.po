msgstr "Genial, construyamos un ancla."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.YOTD_DRAGONSHRINE.BURNT
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.YOTD_DRAGONSHRINE.BURNT"
msgid "Nice."
msgstr "Qué bien."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.YOTD_DRAGONSHRINE.EMPTY
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.YOTD_DRAGONSHRINE.EMPTY"
