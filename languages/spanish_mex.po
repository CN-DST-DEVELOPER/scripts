msgstr "Sospecho que requiere carbón como tributo."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.YOTD_DRAGONSHRINE.GENERIC
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.YOTD_DRAGONSHRINE.GENERIC"
