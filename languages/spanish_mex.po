#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.BATTLESONG_SHADOWALIGNED
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.BATTLESONG_SHADOWALIGNED"
msgid "Hey look, fancy kindling!"
msgstr "Papel sofisticado para quemar."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.BATWING
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.BATWING"
