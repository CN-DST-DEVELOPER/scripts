msgstr "Parece que algo la ha destruido."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.QUAGMIRE_RUBBLE_HOUSE.1
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.QUAGMIRE_RUBBLE_HOUSE.1"
