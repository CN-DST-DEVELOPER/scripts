msgstr "Se cree que es el jefe por aquí."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.CRABKING.INERT
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.CRABKING.INERT"
msgid "The foundation doesn't look very stable."
msgstr "Los cimientos no parecen muy estables."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.CRABKING_CANNONTOWER
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.CRABKING_CANNONTOWER"
msgid "There's no way they've got a permit for that."
msgstr "No hay forma de que hayan conseguido la licencia para eso."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.CRABKING_CLAW
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.CRABKING_CLAW"
msgid "Now that's some claws for alarm. Ha!"
msgstr "¡Esas pinzas son alarmantes! ¡Ja!"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.CRABKING_ICEWALL
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.CRABKING_ICEWALL"
msgid "Heh. I think this guy's tryin' to ice me out!"
msgstr "Je. Creo que este está intentando aislarme con hielo."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.CRABKING_MOB
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.CRABKING_MOB"
msgid "Just a hired hand. Er, claw."
msgstr "Solo mano de obra. Bueno, garra."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.CRABKING_MOB_KNIGHT
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.CRABKING_MOB_KNIGHT"
msgid "I've had supervisors crabbier than him."
msgstr "Tuve supervisores más cascarrabias."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.CRITTERLAB
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.CRITTERLAB"
msgid "Come on out, don't be shy."
msgstr "Sal, no seas tímido."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.CRITTER_DRAGONLING
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.CRITTER_DRAGONLING"
msgid "You're pretty swell, for a tiny monstrosity."
msgstr "Eres bastante genial para ser un pequeño monstruito."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.CRITTER_EYEOFTERROR
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.CRITTER_EYEOFTERROR"
