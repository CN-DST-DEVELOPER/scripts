msgstr "Mamá tenía uno de estos."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.TRINKET_22
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.TRINKET_22"
