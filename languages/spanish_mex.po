#. STRINGS.SHADOW_BATTLEAXE_TALK.chopping_l2.1
msgctxt "STRINGS.SHADOW_BATTLEAXE_TALK.chopping_l2.1"
msgid "Ch- cho- chop. CHOP!"
msgstr "¡Tala! ¡Tala! ¡TALA!"

#. STRINGS.SHADOW_BATTLEAXE_TALK.chopping_l2.2
msgctxt "STRINGS.SHADOW_BATTLEAXE_TALK.chopping_l2.2"
msgid "Ch- chop tree... CHOP TREE!"
msgstr "Ta- talar árbol... ¡TALAR! ¡ÁRBOL!"

#. STRINGS.SHADOW_BATTLEAXE_TALK.chopping_l2.3
msgctxt "STRINGS.SHADOW_BATTLEAXE_TALK.chopping_l2.3"
msgid "CHOP! CHOP! CHOP!"
msgstr "TALAR, TALAR, TALAR. JE."

#. STRINGS.SHADOW_BATTLEAXE_TALK.chopping_l2.4
msgctxt "STRINGS.SHADOW_BATTLEAXE_TALK.chopping_l2.4"
msgid "Swi-ing... Swing!"
msgstr "De aquí... ¡para allá!"

#. STRINGS.SHADOW_BATTLEAXE_TALK.chopping_l2.5
msgctxt "STRINGS.SHADOW_BATTLEAXE_TALK.chopping_l2.5"
msgid "More..."
msgstr "Más..."

#. STRINGS.SHADOW_BATTLEAXE_TALK.chopping_l3.1
msgctxt "STRINGS.SHADOW_BATTLEAXE_TALK.chopping_l3.1"
msgid "No tree is safe from us."
msgstr "Ningún árbol está a salvo..."

#. STRINGS.SHADOW_BATTLEAXE_TALK.chopping_l3.2
msgctxt "STRINGS.SHADOW_BATTLEAXE_TALK.chopping_l3.2"
msgid "CHOP-CHOP!"
msgstr "¡TALA, TALA!"

#. STRINGS.SHADOW_BATTLEAXE_TALK.chopping_l3.3
msgctxt "STRINGS.SHADOW_BATTLEAXE_TALK.chopping_l3.3"
msgid "We're in full swing now, wielder!"
msgstr "¡Entramos en ritmo, tú y yo!"

#. STRINGS.SHADOW_BATTLEAXE_TALK.chopping_l3.4
msgctxt "STRINGS.SHADOW_BATTLEAXE_TALK.chopping_l3.4"
msgid "Chop'em down. Chop'em all down."
msgstr "¡Tálalos! Tálalos todos..."

#. STRINGS.SHADOW_BATTLEAXE_TALK.chopping_l3.5
msgctxt "STRINGS.SHADOW_BATTLEAXE_TALK.chopping_l3.5"
msgid "I was meant for greater things... fleshier things."
msgstr "Estoy destinada a mejores cosas... cosas de carne."

#. STRINGS.SHADOW_BATTLEAXE_TALK.chopping_l3.6
msgctxt "STRINGS.SHADOW_BATTLEAXE_TALK.chopping_l3.6"
msgid "Only flesh will sustain me."
msgstr "Solo la carne me sustentará."

#. STRINGS.SHADOW_BATTLEAXE_TALK.chopping_l3.7
msgctxt "STRINGS.SHADOW_BATTLEAXE_TALK.chopping_l3.7"
msgid "Where's the challenge?"
msgstr "¿Dónde está el desafío?"

#. STRINGS.SHADOW_BATTLEAXE_TALK.chopping_l4.1
msgctxt "STRINGS.SHADOW_BATTLEAXE_TALK.chopping_l4.1"
msgid "Every tree shall fall before us."
msgstr "¡Que cada árbol caiga ante nosotros!"

#. STRINGS.SHADOW_BATTLEAXE_TALK.chopping_l4.2
msgctxt "STRINGS.SHADOW_BATTLEAXE_TALK.chopping_l4.2"
msgid "Trees feel pain... but not enough."
msgstr "Los árboles sienten dolor... pero no lo suficiente."

#. STRINGS.SHADOW_BATTLEAXE_TALK.chopping_l4.3
msgctxt "STRINGS.SHADOW_BATTLEAXE_TALK.chopping_l4.3"
msgid "I prefer the mobile variety."
msgstr "Personalmente prefiero el portátil."

#. STRINGS.SHADOW_BATTLEAXE_TALK.chopping_woodie_l2.1
msgctxt "STRINGS.SHADOW_BATTLEAXE_TALK.chopping_woodie_l2.1"
msgid "Yes."
msgstr "Sí."

#. STRINGS.SHADOW_BATTLEAXE_TALK.chopping_woodie_l2.2
msgctxt "STRINGS.SHADOW_BATTLEAXE_TALK.chopping_woodie_l2.2"
msgid "All... m-mine."
msgstr "Todo... m-mío."

#. STRINGS.SHADOW_BATTLEAXE_TALK.chopping_woodie_l2.3
msgctxt "STRINGS.SHADOW_BATTLEAXE_TALK.chopping_woodie_l2.3"
msgid "Wo... W-Woodie... i-is... mine!"
msgstr "¡Woo... W-Woodie... e-es... mío!"

#. STRINGS.SHADOW_BATTLEAXE_TALK.chopping_woodie_l3.1
msgctxt "STRINGS.SHADOW_BATTLEAXE_TALK.chopping_woodie_l3.1"
msgid "Forget her."
msgstr "Olvídala."

#. STRINGS.SHADOW_BATTLEAXE_TALK.chopping_woodie_l3.2
msgctxt "STRINGS.SHADOW_BATTLEAXE_TALK.chopping_woodie_l3.2"
msgid "No one will ever split us apart."
msgstr "Nunca nadie nos separará."

#. STRINGS.SHADOW_BATTLEAXE_TALK.chopping_woodie_l3.3
msgctxt "STRINGS.SHADOW_BATTLEAXE_TALK.chopping_woodie_l3.3"
msgid "Hold me tight!"
msgstr "¡Sostenme fuerte!"

#. STRINGS.SHADOW_BATTLEAXE_TALK.chopping_woodie_l4.1
msgctxt "STRINGS.SHADOW_BATTLEAXE_TALK.chopping_woodie_l4.1"
msgid "Hew and me... FOREVER."
msgstr "¡Tala- es decir, tú y yo... PARA SIEMPRE!"

#. STRINGS.SHADOW_BATTLEAXE_TALK.chopping_woodie_l4.2
msgctxt "STRINGS.SHADOW_BATTLEAXE_TALK.chopping_woodie_l4.2"
msgid "Never let me go."
msgstr "Nunca me dejes."

#. STRINGS.SHADOW_BATTLEAXE_TALK.chopping_woodie_l4.3
msgctxt "STRINGS.SHADOW_BATTLEAXE_TALK.chopping_woodie_l4.3"
msgid "I love hew!"
msgstr "¡Me encanta talar!"

#. STRINGS.SHADOW_BATTLEAXE_TALK.creature_killed_l2.1
msgctxt "STRINGS.SHADOW_BATTLEAXE_TALK.creature_killed_l2.1"
msgid "Fun."
msgstr "¡Divertido!"

#. STRINGS.SHADOW_BATTLEAXE_TALK.creature_killed_l2.2
msgctxt "STRINGS.SHADOW_BATTLEAXE_TALK.creature_killed_l2.2"
msgid "I l-like."
msgstr "Me-me gusta."

#. STRINGS.SHADOW_BATTLEAXE_TALK.creature_killed_l2.3
msgctxt "STRINGS.SHADOW_BATTLEAXE_TALK.creature_killed_l2.3"
msgid "Want b-big... meat."
msgstr "Quiero carne... carne carnosa."

#. STRINGS.SHADOW_BATTLEAXE_TALK.creature_killed_l2.4
msgctxt "STRINGS.SHADOW_BATTLEAXE_TALK.creature_killed_l2.4"
msgid "Kill!"
msgstr "¡Matar!"

#. STRINGS.SHADOW_BATTLEAXE_TALK.creature_killed_l3.1
msgctxt "STRINGS.SHADOW_BATTLEAXE_TALK.creature_killed_l3.1"
msgid "That was fun."
msgstr "¡Qué divertido!"

#. STRINGS.SHADOW_BATTLEAXE_TALK.creature_killed_l3.10
msgctxt "STRINGS.SHADOW_BATTLEAXE_TALK.creature_killed_l3.10"
msgid "Good times. Good times had by all."
msgstr "Qué buenos recuerdos... Buenos recuerdos que compartimos."

#. STRINGS.SHADOW_BATTLEAXE_TALK.creature_killed_l3.11
msgctxt "STRINGS.SHADOW_BATTLEAXE_TALK.creature_killed_l3.11"
msgid "What a HACK job."
msgstr "Qué trabajo más cortante."

#. STRINGS.SHADOW_BATTLEAXE_TALK.creature_killed_l3.12
msgctxt "STRINGS.SHADOW_BATTLEAXE_TALK.creature_killed_l3.12"
msgid "It will do for now."
msgstr "Por ahora servirá."

#. STRINGS.SHADOW_BATTLEAXE_TALK.creature_killed_l3.13
msgctxt "STRINGS.SHADOW_BATTLEAXE_TALK.creature_killed_l3.13"
msgid "You're a HACK!"
msgstr "¡Eres un chapucero!"

#. STRINGS.SHADOW_BATTLEAXE_TALK.creature_killed_l3.14
msgctxt "STRINGS.SHADOW_BATTLEAXE_TALK.creature_killed_l3.14"
msgid "Satisfactory."
msgstr "Satisfacción."

#. STRINGS.SHADOW_BATTLEAXE_TALK.creature_killed_l3.15
msgctxt "STRINGS.SHADOW_BATTLEAXE_TALK.creature_killed_l3.15"
msgid "Here's your final SEVERANCE."
msgstr "Aquí tienes tu GOLPE FINAL."

#. STRINGS.SHADOW_BATTLEAXE_TALK.creature_killed_l3.16
msgctxt "STRINGS.SHADOW_BATTLEAXE_TALK.creature_killed_l3.16"
msgid "'Twas but a snack."
msgstr "Eso fue solo un bocadillo."

#. STRINGS.SHADOW_BATTLEAXE_TALK.creature_killed_l3.2
msgctxt "STRINGS.SHADOW_BATTLEAXE_TALK.creature_killed_l3.2"
msgid "Thanks for the meat!"
msgstr "¡Gracias por la carne!"

#. STRINGS.SHADOW_BATTLEAXE_TALK.creature_killed_l3.3
msgctxt "STRINGS.SHADOW_BATTLEAXE_TALK.creature_killed_l3.3"
msgid "Crunchy bones!"
msgstr "¡Huesos crujientes!"

#. STRINGS.SHADOW_BATTLEAXE_TALK.creature_killed_l3.4
msgctxt "STRINGS.SHADOW_BATTLEAXE_TALK.creature_killed_l3.4"
msgid "Time to split!"
msgstr "Hora de compartir."

#. STRINGS.SHADOW_BATTLEAXE_TALK.creature_killed_l3.5
msgctxt "STRINGS.SHADOW_BATTLEAXE_TALK.creature_killed_l3.5"
msgid "Shall we hunt bigger game?"
msgstr "¿Deberíamos ir por algo más grande?"

#. STRINGS.SHADOW_BATTLEAXE_TALK.creature_killed_l3.6
msgctxt "STRINGS.SHADOW_BATTLEAXE_TALK.creature_killed_l3.6"
msgid "A tasty morsel."
msgstr "Un sabroso bocado."

#. STRINGS.SHADOW_BATTLEAXE_TALK.creature_killed_l3.7
msgctxt "STRINGS.SHADOW_BATTLEAXE_TALK.creature_killed_l3.7"
msgid "Shall we murder something of consequence now?"
msgstr "¿Matamos algo importante ahora?"

#. STRINGS.SHADOW_BATTLEAXE_TALK.creature_killed_l3.8
msgctxt "STRINGS.SHADOW_BATTLEAXE_TALK.creature_killed_l3.8"
msgid "Too easy."
msgstr "Muy fácil."

#. STRINGS.SHADOW_BATTLEAXE_TALK.creature_killed_l3.9
msgctxt "STRINGS.SHADOW_BATTLEAXE_TALK.creature_killed_l3.9"
msgid "Nothing sweeter than death delivered by your hand and my face."
msgstr "Nada más dulce que la muerte entregada por tus manos y mi rostro."

#. STRINGS.SHADOW_BATTLEAXE_TALK.creature_killed_l4.1
msgctxt "STRINGS.SHADOW_BATTLEAXE_TALK.creature_killed_l4.1"
msgid "I'm rather insulted."
msgstr "Me siento ofendida."

#. STRINGS.SHADOW_BATTLEAXE_TALK.creature_killed_l4.2
msgctxt "STRINGS.SHADOW_BATTLEAXE_TALK.creature_killed_l4.2"
msgid "That's it?"
msgstr "¿Eso es todo?"

#. STRINGS.SHADOW_BATTLEAXE_TALK.creature_killed_l4.3
msgctxt "STRINGS.SHADOW_BATTLEAXE_TALK.creature_killed_l4.3"
msgid "Playing it safe, wielder?"
msgstr "¿Juegas a lo seguro, tú?"

#. STRINGS.SHADOW_BATTLEAXE_TALK.creature_killed_l4.4
msgctxt "STRINGS.SHADOW_BATTLEAXE_TALK.creature_killed_l4.4"
msgid "Meager."
msgstr "Mísero."

#. STRINGS.SHADOW_BATTLEAXE_TALK.epic_killed_l2.1
msgctxt "STRINGS.SHADOW_BATTLEAXE_TALK.epic_killed_l2.1"
msgid "Yes."
msgstr "Sí."

#. STRINGS.SHADOW_BATTLEAXE_TALK.epic_killed_l2.2
msgctxt "STRINGS.SHADOW_BATTLEAXE_TALK.epic_killed_l2.2"
msgid "More... new... meat."
msgstr "Más... carne... nueva..."

#. STRINGS.SHADOW_BATTLEAXE_TALK.epic_killed_l3.1
msgctxt "STRINGS.SHADOW_BATTLEAXE_TALK.epic_killed_l3.1"
msgid "Sumptuous! We're on the right path, wielder!"
msgstr "¡Magnífico! ¡Estamos en el camino correcto, tú!"

#. STRINGS.SHADOW_BATTLEAXE_TALK.epic_killed_l3.2
msgctxt "STRINGS.SHADOW_BATTLEAXE_TALK.epic_killed_l3.2"
msgid "We're on the cusp, wielder. I FEEL IT."
msgstr "Estamos en la cúspide, tú y yo. LO SIENTO."

#. STRINGS.SHADOW_BATTLEAXE_TALK.epic_killed_l4.1
msgctxt "STRINGS.SHADOW_BATTLEAXE_TALK.epic_killed_l4.1"
msgid "OH YES."
msgstr "OH, SÍ."

#. STRINGS.SHADOW_BATTLEAXE_TALK.epic_killed_l4.10
msgctxt "STRINGS.SHADOW_BATTLEAXE_TALK.epic_killed_l4.10"
msgid "Thank you, wielder."
msgstr "Gracias por estar a mi lado."

#. STRINGS.SHADOW_BATTLEAXE_TALK.epic_killed_l4.11
msgctxt "STRINGS.SHADOW_BATTLEAXE_TALK.epic_killed_l4.11"
msgid "I'm proud of us."
msgstr "Estoy orgullosa de lo que logramos."

#. STRINGS.SHADOW_BATTLEAXE_TALK.epic_killed_l4.2
msgctxt "STRINGS.SHADOW_BATTLEAXE_TALK.epic_killed_l4.2"
msgid "So juicy!"
msgstr "¡Qué jugoso!"

#. STRINGS.SHADOW_BATTLEAXE_TALK.epic_killed_l4.3
msgctxt "STRINGS.SHADOW_BATTLEAXE_TALK.epic_killed_l4.3"
msgid "A satisfying meal."
msgstr "Una comida gratificante."

#. STRINGS.SHADOW_BATTLEAXE_TALK.epic_killed_l4.4
msgctxt "STRINGS.SHADOW_BATTLEAXE_TALK.epic_killed_l4.4"
msgid "Worthy."
msgstr "Respetable."

#. STRINGS.SHADOW_BATTLEAXE_TALK.epic_killed_l4.5
msgctxt "STRINGS.SHADOW_BATTLEAXE_TALK.epic_killed_l4.5"
msgid "Beautiful!"
msgstr "Una belleza."

#. STRINGS.SHADOW_BATTLEAXE_TALK.epic_killed_l4.6
msgctxt "STRINGS.SHADOW_BATTLEAXE_TALK.epic_killed_l4.6"
msgid "A delight!"
msgstr "¡Una delicia!"

#. STRINGS.SHADOW_BATTLEAXE_TALK.epic_killed_l4.7
msgctxt "STRINGS.SHADOW_BATTLEAXE_TALK.epic_killed_l4.7"
msgid "I am satiated."
msgstr "Estoy saciada."

#. STRINGS.SHADOW_BATTLEAXE_TALK.epic_killed_l4.8
msgctxt "STRINGS.SHADOW_BATTLEAXE_TALK.epic_killed_l4.8"
msgid "A fine feast of flesh."
msgstr "Un festín de carne."

#. STRINGS.SHADOW_BATTLEAXE_TALK.epic_killed_l4.9
msgctxt "STRINGS.SHADOW_BATTLEAXE_TALK.epic_killed_l4.9"
msgid "Gluttonous!"
msgstr "¡Insaciable!"

#. STRINGS.SHADOW_BATTLEAXE_TALK.hungry_l2.1
msgctxt "STRINGS.SHADOW_BATTLEAXE_TALK.hungry_l2.1"
msgid "Hungry!"
msgstr "¡Tengo hambre!"

#. STRINGS.SHADOW_BATTLEAXE_TALK.hungry_l2.2
msgctxt "STRINGS.SHADOW_BATTLEAXE_TALK.hungry_l2.2"
msgid "F-feed me!"
msgstr "¡Aliméntame!"

#. STRINGS.SHADOW_BATTLEAXE_TALK.hungry_l2.3
msgctxt "STRINGS.SHADOW_BATTLEAXE_TALK.hungry_l2.3"
msgid "M-must... k-kill."
msgstr "De-debo... ma-matar."

#. STRINGS.SHADOW_BATTLEAXE_TALK.hungry_l2.4
msgctxt "STRINGS.SHADOW_BATTLEAXE_TALK.hungry_l2.4"
msgid "Me-meat!"
msgstr "¡Yo carne!"

#. STRINGS.SHADOW_BATTLEAXE_TALK.hungry_l2.5
msgctxt "STRINGS.SHADOW_BATTLEAXE_TALK.hungry_l2.5"
msgid "Fl... fl-flesh!"
msgstr "¡Pellejo!"

#. STRINGS.SHADOW_BATTLEAXE_TALK.hungry_l3.1
msgctxt "STRINGS.SHADOW_BATTLEAXE_TALK.hungry_l3.1"
msgid "So hungry."
msgstr "Tanta hambre."

#. STRINGS.SHADOW_BATTLEAXE_TALK.hungry_l3.2
msgctxt "STRINGS.SHADOW_BATTLEAXE_TALK.hungry_l3.2"
msgid "I need to fleshen up."
msgstr "Necesito más."

#. STRINGS.SHADOW_BATTLEAXE_TALK.hungry_l3.3
msgctxt "STRINGS.SHADOW_BATTLEAXE_TALK.hungry_l3.3"
msgid "Find us something to kill."
msgstr "Encuentra algo para que podamos matar."

#. STRINGS.SHADOW_BATTLEAXE_TALK.hungry_l3.4
msgctxt "STRINGS.SHADOW_BATTLEAXE_TALK.hungry_l3.4"
msgid "How about some pork chops?"
msgstr "¿Qué tal unas chuletas de cerdo?"

#. STRINGS.SHADOW_BATTLEAXE_TALK.hungry_l3.5
msgctxt "STRINGS.SHADOW_BATTLEAXE_TALK.hungry_l3.5"
msgid "GASH, I'm so hungry!"
msgstr "¡Aaah! ¡Tengo mucha hambre!"

#. STRINGS.SHADOW_BATTLEAXE_TALK.hungry_l3.6
msgctxt "STRINGS.SHADOW_BATTLEAXE_TALK.hungry_l3.6"
msgid "You need to MEAT me halfway."
msgstr "Hay que encontrar un punto medio. De esa carne que anhelo."

#. STRINGS.SHADOW_BATTLEAXE_TALK.hungry_l3.7
msgctxt "STRINGS.SHADOW_BATTLEAXE_TALK.hungry_l3.7"
msgid "I crave beast flesh!"
msgstr "¡Ansío carne de bestia!"

#. STRINGS.SHADOW_BATTLEAXE_TALK.hungry_l3.8
msgctxt "STRINGS.SHADOW_BATTLEAXE_TALK.hungry_l3.8"
msgid "When do we eat?"
msgstr "¿Cuándo comemos?"

#. STRINGS.SHADOW_BATTLEAXE_TALK.hungry_l3.9
msgctxt "STRINGS.SHADOW_BATTLEAXE_TALK.hungry_l3.9"
msgid "I need meat."
msgstr "Necesito carne."

#. STRINGS.SHADOW_BATTLEAXE_TALK.hungry_l4.1
msgctxt "STRINGS.SHADOW_BATTLEAXE_TALK.hungry_l4.1"
msgid "You dare neglect me, mortal?"
msgstr "¿Te atreves a ignorarme, mortal?"

#. STRINGS.SHADOW_BATTLEAXE_TALK.hungry_l4.2
msgctxt "STRINGS.SHADOW_BATTLEAXE_TALK.hungry_l4.2"
msgid "Death gives me life."
msgstr "La muerte me da vida."

#. STRINGS.SHADOW_BATTLEAXE_TALK.hungry_l4.3
msgctxt "STRINGS.SHADOW_BATTLEAXE_TALK.hungry_l4.3"
msgid "Wielder, you've changed."
msgstr "Ey, tú. Has cambiado."

#. STRINGS.SHADOW_BATTLEAXE_TALK.level_up_l2.1
msgctxt "STRINGS.SHADOW_BATTLEAXE_TALK.level_up_l2.1"
msgid "F-feel... str-strange..."
msgstr "Me-me... me siento... extraña."

#. STRINGS.SHADOW_BATTLEAXE_TALK.level_up_l2.2
msgctxt "STRINGS.SHADOW_BATTLEAXE_TALK.level_up_l2.2"
msgid "Some... thing... ha-happening."
msgstr "Algo... está... pa-pasando."

#. STRINGS.SHADOW_BATTLEAXE_TALK.level_up_l2.3
msgctxt "STRINGS.SHADOW_BATTLEAXE_TALK.level_up_l2.3"
msgid "Stro... str-stronger!"
msgstr "¡Más... más fuerte!"

#. STRINGS.SHADOW_BATTLEAXE_TALK.level_up_l2.4
msgctxt "STRINGS.SHADOW_BATTLEAXE_TALK.level_up_l2.4"
msgid "Aw... awa- awake."
msgstr "D-des... pierta."

#. STRINGS.SHADOW_BATTLEAXE_TALK.level_up_l3.1
msgctxt "STRINGS.SHADOW_BATTLEAXE_TALK.level_up_l3.1"
msgid "I'm changing."
msgstr "Estoy cambiando."

#. STRINGS.SHADOW_BATTLEAXE_TALK.level_up_l3.2
msgctxt "STRINGS.SHADOW_BATTLEAXE_TALK.level_up_l3.2"
msgid "My strength grows!"
msgstr "¡Mi fuerza crece!"

#. STRINGS.SHADOW_BATTLEAXE_TALK.level_up_l3.3
msgctxt "STRINGS.SHADOW_BATTLEAXE_TALK.level_up_l3.3"
msgid "I'm evolving!"
msgstr "¡Estoy evolucionando!"

#. STRINGS.SHADOW_BATTLEAXE_TALK.level_up_l4.1
msgctxt "STRINGS.SHADOW_BATTLEAXE_TALK.level_up_l4.1"
msgid "RAAAAAAAAAAAAAAAAAAAAR!"
msgstr "¡RAAAAAAAAAAAAAAAAAAAAR!"

#. STRINGS.SHADOW_BATTLEAXE_TALK.level_up_l4.2
msgctxt "STRINGS.SHADOW_BATTLEAXE_TALK.level_up_l4.2"
msgid "Nothing can stop us now, wielder!"
msgstr "¡Ahora nada nos podrá detener!"

#. STRINGS.SHADOW_BATTLEAXE_TALK.level_up_l4.3
msgctxt "STRINGS.SHADOW_BATTLEAXE_TALK.level_up_l4.3"
msgid "AXE-IMUM POWER!!!"
msgstr "¡DESTRUIRÉ DE UN HACHAZO TODO!"

#. STRINGS.SHADOW_BATTLEAXE_TALK.overtime_l2.1
msgctxt "STRINGS.SHADOW_BATTLEAXE_TALK.overtime_l2.1"
msgid "Sh-sharp."
msgstr "Fi-filosa."

#. STRINGS.SHADOW_BATTLEAXE_TALK.overtime_l2.2
msgctxt "STRINGS.SHADOW_BATTLEAXE_TALK.overtime_l2.2"
msgid "We k-kill n-now?"
msgstr "¿Lo ma-matamos ah-ahora?"

#. STRINGS.SHADOW_BATTLEAXE_TALK.overtime_l2.3
msgctxt "STRINGS.SHADOW_BATTLEAXE_TALK.overtime_l2.3"
msgid "Ch-chop."
msgstr "Co-cortar."

#. STRINGS.SHADOW_BATTLEAXE_TALK.overtime_l2.4
msgctxt "STRINGS.SHADOW_BATTLEAXE_TALK.overtime_l2.4"
msgid "H-hack... ha-ack? HACK!"
msgstr "Co-cortar... ¿Cortar a tajos? ¡CORTAR A TAJOS!"

#. STRINGS.SHADOW_BATTLEAXE_TALK.overtime_l3.1
msgctxt "STRINGS.SHADOW_BATTLEAXE_TALK.overtime_l3.1"
msgid "Let me axe you a question. Why aren't we killing something?"
msgstr "¡Matar o matar! Espero que hachas entendido que no queda otra."

#. STRINGS.SHADOW_BATTLEAXE_TALK.overtime_l3.2
msgctxt "STRINGS.SHADOW_BATTLEAXE_TALK.overtime_l3.2"
msgid "What shall we destroy next, wielder?"
msgstr "¿Qué destruimos ahora, tú y yo?"

#. STRINGS.SHADOW_BATTLEAXE_TALK.overtime_l3.3
msgctxt "STRINGS.SHADOW_BATTLEAXE_TALK.overtime_l3.3"
msgid "I know I have a rough edge. But I can still cut it."
msgstr "Sé que soy un poco cuadrada. Pero igual puedo cortar eso."

#. STRINGS.SHADOW_BATTLEAXE_TALK.overtime_l3.4
msgctxt "STRINGS.SHADOW_BATTLEAXE_TALK.overtime_l3.4"
msgid "Can you hack it?"
msgstr "¿Puedes cortarlo de un hachazo?"

#. STRINGS.SHADOW_BATTLEAXE_TALK.overtime_l3.5
msgctxt "STRINGS.SHADOW_BATTLEAXE_TALK.overtime_l3.5"
msgid "What are you waiting for, wielder?"
msgstr "¿Qué esperas?"

#. STRINGS.SHADOW_BATTLEAXE_TALK.overtime_l3.6
msgctxt "STRINGS.SHADOW_BATTLEAXE_TALK.overtime_l3.6"
msgid "We haven't murdered something in forever."
msgstr "Hace tiempo que no matamos algo."

#. STRINGS.SHADOW_BATTLEAXE_TALK.overtime_l3.7
msgctxt "STRINGS.SHADOW_BATTLEAXE_TALK.overtime_l3.7"
msgid "We shall commit unspeakable acts of savagery!"
msgstr "¡Cometamos actos salvajes incalificables!"

#. STRINGS.SHADOW_BATTLEAXE_TALK.overtime_l3.8
msgctxt "STRINGS.SHADOW_BATTLEAXE_TALK.overtime_l3.8"
msgid "Mortal, do you realize what we are capable of together?"
msgstr "Escúchame, ¿te das cuenta de lo que somos capaces?"

#. STRINGS.SHADOW_BATTLEAXE_TALK.overtime_l4.1
msgctxt "STRINGS.SHADOW_BATTLEAXE_TALK.overtime_l4.1"
msgid "It's been a journey, wielder."
msgstr "Hemos recorrido un largo camino."

#. STRINGS.SHADOW_BATTLEAXE_TALK.overtime_l4.2
msgctxt "STRINGS.SHADOW_BATTLEAXE_TALK.overtime_l4.2"
msgid "I reflect on our path of destruction with fondness."
msgstr "Recuerdo nuestro camino de destrucción con cariño."

#. STRINGS.SHADOW_BATTLEAXE_TALK.overtime_l4.3
msgctxt "STRINGS.SHADOW_BATTLEAXE_TALK.overtime_l4.3"
msgid "Remember how much fun we had killing things?"
msgstr "¿Recuerdas lo mucho que nos divertimos matando cosas?"

#. STRINGS.SHADOW_BATTLEAXE_TALK.overtime_woodie_l2.1
msgctxt "STRINGS.SHADOW_BATTLEAXE_TALK.overtime_woodie_l2.1"
msgid "Fo-for...get... forget h-her..."
msgstr "Ol-olví... da... Olvída...la."

#. STRINGS.SHADOW_BATTLEAXE_TALK.overtime_woodie_l2.2
msgctxt "STRINGS.SHADOW_BATTLEAXE_TALK.overtime_woodie_l2.2"
msgid "M-mi... mine."
msgstr "M-mío... mío."

#. STRINGS.SHADOW_BATTLEAXE_TALK.overtime_woodie_l2.3
msgctxt "STRINGS.SHADOW_BATTLEAXE_TALK.overtime_woodie_l2.3"
msgid "He's... m-mine."
msgstr "Él es... M-mío."

#. STRINGS.SHADOW_BATTLEAXE_TALK.overtime_woodie_l2.4
msgctxt "STRINGS.SHADOW_BATTLEAXE_TALK.overtime_woodie_l2.4"
msgid "Wo... Woo... Woodie."
msgstr "Wo... Woo... Woodie."

#. STRINGS.SHADOW_BATTLEAXE_TALK.overtime_woodie_l3.1
msgctxt "STRINGS.SHADOW_BATTLEAXE_TALK.overtime_woodie_l3.1"
msgid "Heard you're an axe man."
msgstr "Me contaron que eres un hombre que le gustan las hachas."

#. STRINGS.SHADOW_BATTLEAXE_TALK.overtime_woodie_l3.2
msgctxt "STRINGS.SHADOW_BATTLEAXE_TALK.overtime_woodie_l3.2"
msgid "Forget your crazy axe."
msgstr "Olvida tu antigua hacha loca."

#. STRINGS.SHADOW_BATTLEAXE_TALK.overtime_woodie_l3.3
msgctxt "STRINGS.SHADOW_BATTLEAXE_TALK.overtime_woodie_l3.3"
msgid "Sever your ties with that old battle axe."
msgstr "Corta lazos con esa hacha vieja."

#. STRINGS.SHADOW_BATTLEAXE_TALK.overtime_woodie_l3.4
msgctxt "STRINGS.SHADOW_BATTLEAXE_TALK.overtime_woodie_l3.4"
msgid "Just me and hew."
msgstr "Somos solo tú y yo afilada..."

#. STRINGS.SHADOW_BATTLEAXE_TALK.overtime_woodie_l3.5
msgctxt "STRINGS.SHADOW_BATTLEAXE_TALK.overtime_woodie_l3.5"
msgid "I fell for you."
msgstr "Me enamoré de ti."

#. STRINGS.SHADOW_BATTLEAXE_TALK.overtime_woodie_l4.1
msgctxt "STRINGS.SHADOW_BATTLEAXE_TALK.overtime_woodie_l4.1"
msgid "I just want a simple wielding."
msgstr "Solo quiero que me sostengas."

#. STRINGS.SHADOW_BATTLEAXE_TALK.overtime_woodie_l4.2
msgctxt "STRINGS.SHADOW_BATTLEAXE_TALK.overtime_woodie_l4.2"
msgid "I'll never cleave you."
msgstr "Solo quiero aferrarme a ti."

#. STRINGS.SHADOW_BATTLEAXE_TALK.overtime_woodie_l4.3
msgctxt "STRINGS.SHADOW_BATTLEAXE_TALK.overtime_woodie_l4.3"
msgid "Let's carve our names in a tree."
msgstr "Tallemos nuestros nombres en este árbol."

#. STRINGS.SHADOW_BATTLEAXE_TALK.starving_l2.1
msgctxt "STRINGS.SHADOW_BATTLEAXE_TALK.starving_l2.1"
msgid "Starv... starving!"
msgstr "C-con mucha hambre."

#. STRINGS.SHADOW_BATTLEAXE_TALK.starving_l2.2
msgctxt "STRINGS.SHADOW_BATTLEAXE_TALK.starving_l2.2"
msgid "D-dying!"
msgstr "Me- me muero."

#. STRINGS.SHADOW_BATTLEAXE_TALK.starving_l2.3
msgctxt "STRINGS.SHADOW_BATTLEAXE_TALK.starving_l2.3"
msgid "F-find... fl-flesh... now!"
msgstr "¡En-encuentra... ca-carne... ahora!"

#. STRINGS.SHADOW_BATTLEAXE_TALK.starving_l2.4
msgctxt "STRINGS.SHADOW_BATTLEAXE_TALK.starving_l2.4"
msgid "Must h-have mmm-MEAT!"
msgstr "D-debo... tener... ¡carrrne!"

#. STRINGS.SHADOW_BATTLEAXE_TALK.starving_l3.1
msgctxt "STRINGS.SHADOW_BATTLEAXE_TALK.starving_l3.1"
msgid "Feed me, NOW."
msgstr "Aliméntame. AHORA."

#. STRINGS.SHADOW_BATTLEAXE_TALK.starving_l3.2
msgctxt "STRINGS.SHADOW_BATTLEAXE_TALK.starving_l3.2"
msgid "Why do you starve me, cruel mortal?"
msgstr "¿Por qué me matas de hambre, cruel mortal?"

#. STRINGS.SHADOW_BATTLEAXE_TALK.starving_l3.3
msgctxt "STRINGS.SHADOW_BATTLEAXE_TALK.starving_l3.3"
msgid "Are you trying to kill me, wretched mortal?"
msgstr "¿Intentas matarme, cruel mortal?"

#. STRINGS.SHADOW_BATTLEAXE_TALK.starving_l3.4
msgctxt "STRINGS.SHADOW_BATTLEAXE_TALK.starving_l3.4"
msgid "Feed me before it's too late!"
msgstr "¡Aliméntame antes de que sea demasiado tarde!"

#. STRINGS.SHADOW_BATTLEAXE_TALK.starving_l3.5
msgctxt "STRINGS.SHADOW_BATTLEAXE_TALK.starving_l3.5"
msgid "We need to murder something, now!"
msgstr "Tenemos que asesinar algo ya mismo."

#. STRINGS.SHADOW_BATTLEAXE_TALK.starving_l3.6
msgctxt "STRINGS.SHADOW_BATTLEAXE_TALK.starving_l3.6"
msgid "Getting... weaker."
msgstr "Me estoy... debilitando."

#. STRINGS.SHADOW_BATTLEAXE_TALK.starving_l3.7
msgctxt "STRINGS.SHADOW_BATTLEAXE_TALK.starving_l3.7"
msgid "If I'm not killing, I'm dying!"
msgstr "Si no mato, me muero."

#. STRINGS.SHADOW_BATTLEAXE_TALK.starving_l3.8
msgctxt "STRINGS.SHADOW_BATTLEAXE_TALK.starving_l3.8"
msgid "Not to be dramatic, but... I'M STARVING TO DEATH!"
msgstr "No quiero ser dramática, pero... ¡ME ESTOY MURIENDO DE HAMBRE!"

#. STRINGS.SHADOW_BATTLEAXE_TALK.starving_l4.1
msgctxt "STRINGS.SHADOW_BATTLEAXE_TALK.starving_l4.1"
msgid "Cursed mortal."
msgstr "Maldito mortal."

#. STRINGS.SHADOW_BATTLEAXE_TALK.starving_l4.2
msgctxt "STRINGS.SHADOW_BATTLEAXE_TALK.starving_l4.2"
msgid "Is this the end?"
msgstr "¿Este es el fin?"

#. STRINGS.SHADOW_BATTLEAXE_TALK.starving_l4.3
msgctxt "STRINGS.SHADOW_BATTLEAXE_TALK.starving_l4.3"
msgid "It can't end like this."
msgstr "Esto no puede terminar así."

#. STRINGS.SHADOW_BATTLEAXE_TALK.starving_l4.4
msgctxt "STRINGS.SHADOW_BATTLEAXE_TALK.starving_l4.4"
msgid "Come too far... tasted too much..."
msgstr "Llegamos tan lejos... saboreamos tanto..."

#. STRINGS.SHARD.MIGRATION_FAILED.DST_SHARD_DESTINATION_FULL
