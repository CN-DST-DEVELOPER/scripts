msgstr "Tal vez Maxwell nos enseñará a jugar."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.TRINKET_29
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.TRINKET_29"
msgid "Maybe Maxwell will teach us how to play."
msgstr "Tal vez Maxwell nos enseñará a jugar."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.TRINKET_3
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.TRINKET_3"
