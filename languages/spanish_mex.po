#. STRINGS.CHARACTERS.WINONA.DESCRIBE.QUAGMIRE_PIGEON.GENERIC
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.QUAGMIRE_PIGEON.GENERIC"
msgid "You seen one, you seen'em all."
msgstr "Has visto uno y los has visto todos."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.QUAGMIRE_PIGEON.SLEEPING
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.QUAGMIRE_PIGEON.SLEEPING"
