msgstr "Un trozo de tierra."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.TURF_WOODFLOOR
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.TURF_WOODFLOOR"
msgid "Some floorboards."
msgstr "Tablones."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.TURKEYDINNER
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.TURKEYDINNER"
msgid "If you're good I'll give you a drumstick, Woby."
msgstr "Si te portas bien, te daré un palillo, Woby."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.TURNIP
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.TURNIP"
msgid "Huh... Turnip would be a good name for a dog."
msgstr "Ja... «Nabo» sería un buen nombre para un perro."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.TURNIP_COOKED
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.TURNIP_COOKED"
msgid "Tasty turnips."
msgstr "Nabos sabrosos."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.TURNIP_SEEDS
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.TURNIP_SEEDS"
msgid "Where should we plant them, Woby?"
msgstr "¿Dónde las plantamos, Woby?"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.TURTILLUS
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.TURTILLUS"
msgid "Its shell is so spiky!"
msgstr "Tiene el caparazón lleno de púas."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.TWIGGYTREE.BURNING
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.TWIGGYTREE.BURNING"
msgid "You're supposed to chop the tree first, THEN build the fire!"
msgstr "¡Se supone que debes cortar el árbol primero y LUEGO hacer la fogata!"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.TWIGGYTREE.BURNT
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.TWIGGYTREE.BURNT"
msgid "That tree just couldn't wait to be a campfire..."
msgstr "Ese árbol tenía muchas ganas de convertirse en fogata."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.TWIGGYTREE.CHOPPED
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.TWIGGYTREE.CHOPPED"
msgid "This tree looks stumped. Heh, nice one Walter."
msgstr "Este árbol parece que to-cón fondo. Je, muy bueno, Walter."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.TWIGGYTREE.DISEASED
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.TWIGGYTREE.DISEASED"
msgid "Maybe it's infested with beetles. I should check!"
msgstr "Quizás esté infectado con escarabajos. ¡A ver!"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.TWIGGYTREE.GENERIC
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.TWIGGYTREE.GENERIC"
msgid "It's more like a big stick than a tree."
msgstr "Más que un árbol parece una rama gigante."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.TWIGGY_NUT
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.TWIGGY_NUT"
msgid "Hey Woby, you dig a hole and I'll plant it."
msgstr "¡Ey, Woby! ¡Tú haz un agujero y yo lo planto!"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.TWIGGY_NUT_SAPLING
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.TWIGGY_NUT_SAPLING"
msgid "It'll grow up into a big tree someday."
msgstr "Algún día será un árbol muy alto."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.TWIGGY_OLD
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.TWIGGY_OLD"
msgid "It's barely holding together."
msgstr "Apenas se sostiene."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.TWIGS
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.TWIGS"
msgid "A handful of useful twigs."
msgstr "Un puñado de ramitas."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.TWINOFTERROR1
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.TWINOFTERROR1"
msgid "Somewhere, some poor giant robot is walking around completely blind..."
msgstr "En algún lado, hay un robot caminando completamente cegado."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.TWINOFTERROR2
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.TWINOFTERROR2"
msgid "Somewhere, some poor giant robot is walking around completely blind..."
msgstr "En algún lado, hay un robot caminando completamente cegado."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.UMBRELLA
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.UMBRELLA"
msgid "It'll stop the raindrops from falling on my head."
msgstr "Evitará que me moje."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.UNAGI
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.UNAGI"
msgid "Bite-sized deliciousness."
msgstr "La exquisitez en un bocado."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.UNIMPLEMENTED
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.UNIMPLEMENTED"
msgid "It's so mysterious!"
msgstr "¡Tanto misterio!"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.VEGGIEOMLET
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.VEGGIEOMLET"
msgid "Wow, it's so... healthy!"
msgstr "¡Guau! Es tan... saludable."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.VEGGIE_OVERSIZED_ROTTEN
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.VEGGIE_OVERSIZED_ROTTEN"
msgid "It's all rotten!"
msgstr "¡Se pudrió!"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.VEGSTINGER
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.VEGSTINGER"
msgid "I've never had a spicy drink before."
msgstr "Nunca había bebido algo picante antes."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.VICTORIAN_BLUEPRINT
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.VICTORIAN_BLUEPRINT"
msgid "This seems unnecessarily fancy."
msgstr "Parece innecesariamente elegante."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.VOIDCLOTH
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.VOIDCLOTH"
msgid "All that's left of that poor shadow monster."
msgstr "Todo lo que quedó de ese pobre monstruo de las sombras."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.VOIDCLOTHHAT
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.VOIDCLOTHHAT"
msgid "Woby doesn't like it when I wear that."
msgstr "A Woby no le gusta cuando me lo pongo."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.VOIDCLOTH_BOOMERANG
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.VOIDCLOTH_BOOMERANG"
msgid "You don't fetch this one, Woby."
msgstr "Este no lo traigas, Woby."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.VOIDCLOTH_KIT
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.VOIDCLOTH_KIT"
msgid "I hope this goes toward my sewing badge."
msgstr "Espero que esto sirva para mi insignia de confección."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.VOIDCLOTH_SCYTHE
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.VOIDCLOTH_SCYTHE"
msgid "I think it just blinked!"
msgstr "¡Pestañó!"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.VOIDCLOTH_UMBRELLA
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.VOIDCLOTH_UMBRELLA"
msgid "An umbrella that comes with its own lightning!"
msgstr "Un paraguas que viene con su propia iluminación."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.VOLTGOATJELLY
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.VOLTGOATJELLY"
msgid "It definitely has a zing to it."
msgstr "Definitivamente tiene una chispa."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.WAFFLES
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.WAFFLES"
msgid "Breakfast!"
msgstr "¡Para el desayuno!"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.WAGPUNKBITS_KIT
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.WAGPUNKBITS_KIT"
msgid "Cool! A thingamajigy!"
msgstr "¡Excelente! El coso del cosito."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.WAGPUNKHAT
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.WAGPUNKHAT"
msgid "It's going to suck out my brain! Ha ha, probably not."
msgstr "¡Me succionará el cerebro! Ja, ja, o no..."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.WAGPUNK_BITS
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.WAGPUNK_BITS"
msgid "Oooh, nice! Wonder what we can do with these."
msgstr "¡Oooh, me gusta! ¿Para qué servirán?"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.WAGSTAFF_MACHINERY
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.WAGSTAFF_MACHINERY"
msgid "Don't you just love junk, Woby? Never know what we'll find!"
msgstr "¿También te encanta la chatarra, Woby? ¡Siempre encuentras de todo!"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.WAGSTAFF_MUTATIONS_NOTE
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.WAGSTAFF_MUTATIONS_NOTE"
msgid "These notes contain important clues to a mystery, Woby."
msgstr "Notas con información importante para resolver un misterio, Woby."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.WAGSTAFF_NPC
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.WAGSTAFF_NPC"
msgid "Hey Mister, are you okay? You're uh... flickering...?"
msgstr "Señor, ¿está bien? Ehh, ¿está parpadeando?"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.WAGSTAFF_NPC_MUTATIONS
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.WAGSTAFF_NPC_MUTATIONS"
msgid "Maybe this is my chance to earn my Helping the Elderly badge!"
msgstr "¡Mi oportunidad para ganarme la insignia de Ayudar a los mayores!"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.WAGSTAFF_NPC_WAGPUNK
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.WAGSTAFF_NPC_WAGPUNK"
msgid "Gee Mister, you move fast for a senior!"
msgstr "¡Guau, señor! ¡Camina muy rápido para su edad!"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.WAGSTAFF_TOOL_1
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.WAGSTAFF_TOOL_1"
msgid "Maybe this is what he's looking for?"
msgstr "Quizás esto es lo que busca."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.WAGSTAFF_TOOL_2
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.WAGSTAFF_TOOL_2"
msgid "Um... yeah, this one looks right!"
msgstr "Mmm... sí. Esta parece que va bien."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.WAGSTAFF_TOOL_3
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.WAGSTAFF_TOOL_3"
msgid "What do you think, Woby? Is this the tool we're looking for?"
msgstr "¿Qué piensas, Woby? ¿Esta es la herramienta que buscamos?"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.WAGSTAFF_TOOL_4
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.WAGSTAFF_TOOL_4"
msgid "It's definitely a tool of some kind... hope it's the right one!"
msgstr "Es toda una herramienta... ¡Espero que funcione!"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.WAGSTAFF_TOOL_5
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.WAGSTAFF_TOOL_5"
msgid "That one looks about right... I think?"
msgstr "Esa podría ser... ¿no?"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.WALKINGPLANK
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.WALKINGPLANK"
msgid "Oh, I'm good at diving! I got a badge for it!"
msgstr "¡Se me da bien el buceo! ¡Tengo mi insignia!"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.WALKINGPLANK_ANCIENT
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.WALKINGPLANK_ANCIENT"
msgid "Oh, I'm good at diving! I got a badge for it!"
msgstr "¡Se me da bien el buceo! ¡Tengo mi insignia!"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.WALKINGPLANK_GRASS
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.WALKINGPLANK_GRASS"
msgid "Oh, I'm good at diving! I got a badge for it!"
msgstr "¡Se me da bien el buceo! ¡Tengo mi insignia!"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.WALKINGPLANK_YOTD
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.WALKINGPLANK_YOTD"
msgid "Oh, I'm good at diving! I got a badge for it!"
msgstr "¡Se me da bien el buceo! ¡Tengo mi insignia!"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.WALKING_STICK
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.WALKING_STICK"
msgid "Sorry Woby, maybe we can play fetch later."
msgstr "Perdona, Woby. Podremos jugar luego."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.WALL_DREADSTONE
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.WALL_DREADSTONE"
msgid "Spooky!"
msgstr "¡Espeluznante!"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.WALL_DREADSTONE_ITEM
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.WALL_DREADSTONE_ITEM"
msgid "It's gonna be a real nightmare to set it up! Get it?"
msgstr "¡Será una verdadera pesadilla armarlo! Je."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.WALL_HAY.BURNT
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.WALL_HAY.BURNT"
msgid "That's what I get for making a wall out of kindling..."
msgstr "Me lo merezco por hacer una pared de leña..."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.WALL_HAY.GENERIC
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.WALL_HAY.GENERIC"
msgid "You make do with what you have when you're in the wilderness."
msgstr "Te las arreglas como puedes en la naturaleza."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.WALL_HAY_ITEM
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.WALL_HAY_ITEM"
msgid "It's better than nothing!"
msgstr "Es mejor que nada."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.WALL_MOONROCK
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.WALL_MOONROCK"
msgid "It came from another world!"
msgstr "¡Vino de otro mundo!"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.WALL_MOONROCK_ITEM
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.WALL_MOONROCK_ITEM"
msgid "I can't believe we're making walls out of real moon rock!"
msgstr "¡No puedo creer que estemos haciendo paredes con roca lunar!"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.WALL_RUINS
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.WALL_RUINS"
msgid "I like the spooky atmosphere."
msgstr "Me gusta el ambiente tenebroso."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.WALL_RUINS_2
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.WALL_RUINS_2"
msgid "I like the spooky atmosphere."
msgstr "Me gusta el ambiente tenebroso."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.WALL_RUINS_ITEM
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.WALL_RUINS_ITEM"
msgid "Want to give me a hand with these, Woby?"
msgstr "¿Me das una mano con esto, Woby?"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.WALL_SCRAP
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.WALL_SCRAP"
msgid "What a neat use of trash!"
msgstr "Muy buen uso de la chatarra."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.WALL_SCRAP_ITEM
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.WALL_SCRAP_ITEM"
msgid "What a neat use of trash!"
msgstr "Muy buen uso de la chatarra."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.WALL_STONE
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.WALL_STONE"
msgid "Looks pretty sturdy."
msgstr "Se ve bastante resistente."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.WALL_STONE_2
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.WALL_STONE_2"
msgid "Looks pretty sturdy."
msgstr "Se ve bastante resistente."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.WALL_STONE_ITEM
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.WALL_STONE_ITEM"
msgid "This will make a swell wall for our camp."
msgstr "Servirá para hacer una pared en nuestro campamento."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.WALL_WOOD.BURNT
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.WALL_WOOD.BURNT"
msgid "Our camp!!"
msgstr "¡¡Nuestro campamento!!"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.WALL_WOOD.GENERIC
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.WALL_WOOD.GENERIC"
msgid "Hope nobody hurts themselves if they try to climb over."
msgstr "Espero que nadie se lastime si intenta trepar."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.WALL_WOOD_ITEM
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.WALL_WOOD_ITEM"
msgid "Looks sharp."
msgstr "Parece puntiagudo."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.WALRUS
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.WALRUS"
msgid "I need a closer look at those tusks!"
msgstr "¡Tengo que ver esos colmillos de cerca!"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.WALRUSHAT
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.WALRUSHAT"
msgid "It's very... plaid?"
msgstr "Tiene muchos... ¿cuadros?"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.WALRUS_CAMP.EMPTY
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.WALRUS_CAMP.EMPTY"
msgid "An abandoned campsite... I wonder who was here?"
msgstr "Un campamento abandonado... ¿Quién habrá estado aquí?"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.WALRUS_CAMP.GENERIC
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.WALRUS_CAMP.GENERIC"
msgid "I've heard of houses like this, but I've never seen one!"
msgstr "¡Oí hablar de casas como esta, pero nunca había visto una!"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.WALRUS_TUSK
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.WALRUS_TUSK"
msgid "Oof... I don't think he brushed."
msgstr "Mmm... No creo que se haya cepillado."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.WALTER.ATTACKER
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.WALTER.ATTACKER"
msgid "Hey, that's not how a Pinetree Pioneer acts!"
msgstr "¡Ey! ¡Eso no es digno de un pionero del pinar!"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.WALTER.FIRESTARTER
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.WALTER.FIRESTARTER"
msgid "%s! Did you not get your fire safety badge yet?"
msgstr "¡%s! ¿Aún no obtuviste tu insignia de prevención de incendios?"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.WALTER.GENERIC
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.WALTER.GENERIC"
msgid "Hi %s! You kind of remind me of someone..."
msgstr "¡Hola, %s! Me recuerdas un poco a alguien."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.WALTER.GHOST
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.WALTER.GHOST"
msgid "I'll get you fixed up lickety-split!"
msgstr "Te arreglaré en un santiamén."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.WALTER.MURDERER
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.WALTER.MURDERER"
msgid "You'll be kicked out of the Pioneers for this, %s!"
msgstr "¡Te echarán de los pioneros del pinar por esto, %s!"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.WALTER.REVIVER
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.WALTER.REVIVER"
msgid "I knew I could count on a fellow Pinetree Pioneer."
msgstr "Sabía que podía contar con un camarada de los pioneros."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.WALTERHAT
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.WALTERHAT"
msgid "A Pinetree Pioneer should always wear appropriate headgear."
msgstr "Un pionero del pinar siempre debe usar un casco adecuado."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.WANDA.ATTACKER
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.WANDA.ATTACKER"
msgid "Ms. %s is acting pretty suspiciously..."
msgstr "La señora %s actúa de manera sospechosa..."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.WANDA.FIRESTARTER
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.WANDA.FIRESTARTER"
msgid "It really doesn't take that long to build an actual campfire Ms. %s!"
msgstr "No lleva tanto tiempo hacer una fogata, señora %s."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.WANDA.GENERIC
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.WANDA.GENERIC"
msgid "Oh, sorry Ms. %s! I was just, uh... checking."
msgstr "Perdón, señora %s. Solo estaba... mirando."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.WANDA.GHOST
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.WANDA.GHOST"
msgid "Don't worry Ms. %s, we'll have you back to your old self in a jiffy!"
msgstr "No se preocupe, señora %s. ¡Volverá a ser la misma en un periquete!"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.WANDA.MURDERER
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.WANDA.MURDERER"
msgid "I knew it! She IS the killer!"
msgstr "¡Lo sabía! ¡Ella SÍ es la asesina!"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.WANDA.REVIVER
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.WANDA.REVIVER"
msgid "Thanks Ms. %s! I promise I'll be more careful."
msgstr "Gracias, señora %s. Prometo que tendré más cuidado."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.WARDROBE.BURNING
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.WARDROBE.BURNING"
msgid "My bugs!!"
msgstr "¡Mis insectos!"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.WARDROBE.BURNT
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.WARDROBE.BURNT"
msgid "Poor little guys..."
msgstr "Pobrecitos..."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.WARDROBE.GENERIC
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.WARDROBE.GENERIC"
msgid "I've been keeping my bugs in there when I run out of room in my pockets."
msgstr "Empecé a guardar algunos insectos allí cuando se me llenaron los bolsillos."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.WARG
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.WARG"
msgid "Are they a friend of yours, Woby?"
msgstr "¿Una de tus amistades, Woby?"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.WARGCORPSE.BURNING
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.WARGCORPSE.BURNING"
msgid "D-don't look, Woby..."
msgstr "N-No mires, Woby..."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.WARGCORPSE.GENERIC
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.WARGCORPSE.GENERIC"
msgid "Why couldn't we be friends?"
msgstr "¿Por qué no pudimos ser amigos?"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.WARGCORPSE.REVIVING
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.WARGCORPSE.REVIVING"
msgid "Hey, they're getting up!"
msgstr "¡Ey! ¡Se está levantando!"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.WARGLET
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.WARGLET"
msgid "Look Woby, another dog for you to play with!"
msgstr "Mira, Woby. ¡Otro perro con el que puedes jugar!"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.WARGSHRINE.BURNING
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.WARGSHRINE.BURNING"
msgid "Who left the torch unattended?!"
msgstr "¿Quién se olvidó de apagar la antorcha?"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.WARGSHRINE.BURNT
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.WARGSHRINE.BURNT"
msgid "Well... that's that I guess."
msgstr "Bueno... se acabó."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.WARGSHRINE.EMPTY
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.WARGSHRINE.EMPTY"
msgid "It seems to respond to torchlight."
msgstr "Parece que reacciona con la antorcha."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.WARGSHRINE.GENERIC
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.WARGSHRINE.GENERIC"
msgid "What should we make, Woby?"
msgstr "¿Qué hacemos, Woby?"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.WARLY.ATTACKER
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.WARLY.ATTACKER"
msgid "You seem kind of cranky Mr. %s, maybe you should eat something?"
msgstr "Está un poco irritable, señor %s. ¿Por qué no come algo?"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.WARLY.FIRESTARTER
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.WARLY.FIRESTARTER"
msgid "You're burning it, Mr. %s!"
msgstr "¡Lo está quemando, señor %s!"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.WARLY.GENERIC
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.WARLY.GENERIC"
msgid "Hey Mr. %s!"
msgstr "¡Ey, señor %s!"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.WARLY.GHOST
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.WARLY.GHOST"
msgid "Hang on Mr. %s! You'll be back to cooking fancy food in no time."
msgstr "¡Un momento, señor %s! Volverá a cocinar comida sofisticada pronto."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.WARLY.MURDERER
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.WARLY.MURDERER"
msgid "How long have you been cooking up this murderous scheme, Mr. %s?"
msgstr "¿Hace cuanto está planificando este asesinato, señor %s?"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.WARLY.REVIVER
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.WARLY.REVIVER"
msgid "Thanks Mr. %s! That really hit the spot."
msgstr "¡Gracias, señor %s! Dio justo en el clavo."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.WAR_BLUEPRINT
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.WAR_BLUEPRINT"
msgid "I wonder if the beefalo actually like wearing these."
msgstr "Me pregunto si al bífalo le gustará."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.WASPHIVE
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.WASPHIVE"
msgid "E-everyone stay calm... we'll be on our way..."
msgstr "¡No pierdan la calma! Ya llegamos..."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.WATERBALLOON
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.WATERBALLOON"
msgid "Don't worry, I have great aim! Or maybe you should be worried..."
msgstr "No te preocupes. Tengo buena puntería. O quizás sí, preocúpate..."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.WATERINGCAN.EMPTY
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.WATERINGCAN.EMPTY"
msgid "Maybe I can find a pond around here somewhere..."
msgstr "Tal vez por aquí haya un estanque..."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.WATERINGCAN.GENERIC
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.WATERINGCAN.GENERIC"
msgid "Come on Woby, let's see if the plants need some water."
msgstr "Vamos a ver si las plantas necesitan agua, Woby."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.WATERMELON
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.WATERMELON"
msgid "A sweet, refreshing snack!"
msgstr "¡Un bocadillo dulce y refrescante!"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.WATERMELONHAT
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.WATERMELONHAT"
msgid "This feels silly..."
msgstr "Me siento ridículo..."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.WATERMELONICLE
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.WATERMELONICLE"
msgid "Further proof that all food is better on a stick!"
msgstr "¡Otra prueba de que la comida en un palito sabe mejor!"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.WATERMELON_COOKED
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.WATERMELON_COOKED"
msgid "It's still sweet, but not as refreshing..."
msgstr "Sigue dulce, pero no tan refrescante..."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.WATERMELON_OVERSIZED
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.WATERMELON_OVERSIZED"
msgid "We'll have watermelon slices for days!"
msgstr "¡Tenemos rodajas de sandía para rato!"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.WATERMELON_SEEDS
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.WATERMELON_SEEDS"
msgid "Yep, those are seeds!"
msgstr "Sí, son semillas."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.WATERPLANT
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.WATERPLANT"
msgid "Woah! That flower is huge!"
msgstr "¡Guau! ¡Esa flor es gigante!"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.WATERPLANT_BABY
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.WATERPLANT_BABY"
msgid "I think I'm getting better at gardening!"
msgstr "¡Estoy mejorando en la jardinería!"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.WATERPLANT_BOMB
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.WATERPLANT_BOMB"
msgid "Hey! Careful with those!"
msgstr "¡Ey! ¡Cuidado con eso!"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.WATERPLANT_PLANTER
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.WATERPLANT_PLANTER"
msgid "Don't worry, we'll find a nice rock to plant you on."
msgstr "Descuida, te buscaremos un buen lugar donde plantarte."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.WATERPUMP
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.WATERPUMP"
msgid "It's always good to have proper safety precautions in place."
msgstr "Siempre es bueno respetar todas las medidas de seguridad."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.WATERTREE_PILLAR
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.WATERTREE_PILLAR"
msgid "Woah, would you look at the size of that tree!"
msgstr "¡Guau! Fíjate en el tamaño de ese árbol."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.WATERTREE_ROOT
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.WATERTREE_ROOT"
msgid "Watch out for water hazards!"
msgstr "¡Cuidado con los peligros del agua!"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.WATHGRITHR.ATTACKER
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.WATHGRITHR.ATTACKER"
msgid "Ms. %s seems even more combative than usual..."
msgstr "A la señora %s se la ve más agresiva..."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.WATHGRITHR.FIRESTARTER
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.WATHGRITHR.FIRESTARTER"
msgid "Not everything needs to have a Viking funeral, Ms. %s!"
msgstr "¡No todo tiene que ser un funeral vikingo, señora %s!"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.WATHGRITHR.GENERIC
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.WATHGRITHR.GENERIC"
msgid "Hey Ms. %s!"
msgstr "¡Ey, señora %s!"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.WATHGRITHR.GHOST
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.WATHGRITHR.GHOST"
msgid "Don't worry Ms. %s! Woby and I will get a heart for you in no time."
msgstr "No se preocupe, señora %s. Con Woby le conseguiremos un corazón ya mismo."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.WATHGRITHR.MURDERER
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.WATHGRITHR.MURDERER"
msgid "Ms. %s went into a Viking rage!"
msgstr "¡A la señora %s le dio una rabia vikinga!"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.WATHGRITHR.REVIVER
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.WATHGRITHR.REVIVER"
msgid "Thanks Ms. %s! You're the only Viking I know, but also the best one!"
msgstr "¡Gracias, señora %s! ¡Es la única vikinga que conozco, pero también la mejor!"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.WATHGRITHRHAT
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.WATHGRITHRHAT"
msgid "Maybe Pinetree Pioneers should start wearing helmets instead."
msgstr "A lo mejor los pioneros del pinar deberían empezar a usar cascos."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.WATHGRITHR_IMPROVEDHAT
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.WATHGRITHR_IMPROVEDHAT"
msgid "Woah, that's a lot of wings for one hat!"
msgstr "¡Guau! ¡Cuántas alas para un solo sombrero!"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.WATHGRITHR_SHIELD
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.WATHGRITHR_SHIELD"
msgid "I feel safer already!"
msgstr "¡Ya me siento más seguro!"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.WAXED_PLANT
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.WAXED_PLANT"
msgid "It's still alive... I think."
msgstr "Sigue con vida... Creo."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.WAXPAPER
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.WAXPAPER"
msgid "Mom used to use something like this for baking."
msgstr "Mamá usaba algo así para la repostería."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.WAXWELL.ATTACKER
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.WAXWELL.ATTACKER"
msgid "Your dark side is showing, Mr. %s."
msgstr "Veo su lado oscuro, señor %s."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.WAXWELL.FIRESTARTER
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.WAXWELL.FIRESTARTER"
msgid "Doesn't anyone care about fire safety?"
msgstr "¿A nadie le importa la prevención de incendios?"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.WAXWELL.GENERIC
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.WAXWELL.GENERIC"
msgid "Hey Mr. %s! Woby, stop growling at him!"
msgstr "¡Ey, señor %s! ¡Woby, deja de gruñirle!"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.WAXWELL.GHOST
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.WAXWELL.GHOST"
msgid "Don't worry, a Pinetree Pioneer doesn't leave anyone behind!"
msgstr "Descuida, un pionero del pinar nunca deja a nadie atrás."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.WAXWELL.MURDERER
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.WAXWELL.MURDERER"
msgid "You're a monster, and not the fun kind."
msgstr "Eres un monstruo, y no de los divertidos."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.WAXWELL.REVIVER
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.WAXWELL.REVIVER"
msgid "I was kind of having fun being a ghost..."
msgstr "Estaba bastante divertido ser un fantasma..."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.WAXWELLJOURNAL.GENERIC
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.WAXWELLJOURNAL.GENERIC"
msgid "Maybe you could teach me some magic tricks? I'm a quick learner!"
msgstr "¿Me enseñarías algunos trucos de magia? ¡Aprendo rápido!"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.WEBBER.ATTACKER
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.WEBBER.ATTACKER"
msgid "I guess he IS a monster... it's only natural."
msgstr "Supongo que SÍ es un monstruo... se le nota."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.WEBBER.FIRESTARTER
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.WEBBER.FIRESTARTER"
msgid "We need to have a group meeting about fire safety."
msgstr "Deberíamos tener una reunión sobre prevención de incendios."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.WEBBER.GENERIC
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.WEBBER.GENERIC"
msgid "Hi %s!"
msgstr "¡Hola, %s!"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.WEBBER.GHOST
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.WEBBER.GHOST"
msgid "Don't worry little guy, Woby and I will take care of it."
msgstr "No te preocupes, pequeñín. Woby y yo nos ocuparemos."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.WEBBER.MURDERER
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.WEBBER.MURDERER"
msgid "Hey %s! That's going too far!"
msgstr "¡Ey, %s! Esto ya es demasiado."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.WEBBER.REVIVER
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.WEBBER.REVIVER"
msgid "Thanks for the help! You'll make a great Pinetree Pioneer someday!"
msgstr "¡Gracias por tu ayuda! Serás un excelente pionero del pinar."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.WEBBERSKULL
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.WEBBERSKULL"
msgid "No Woby, these bones aren't for chewing on!"
msgstr "No, Woby. Esos huesos no son para masticar."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.WEBBER_SPIDER_MINION
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.WEBBER_SPIDER_MINION"
msgid "I guess they're fighting for us."
msgstr "Supongo que luchan por nosotros."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.WEED_IVY
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.WEED_IVY"
msgid "It looks like it has a little monster claw, ready to grab you!"
msgstr "Parece que tiene una pequeña garra. ¡Lista para capturarte!"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.WENDY.ATTACKER
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.WENDY.ATTACKER"
msgid "You can't scare me... okay, maybe a little."
msgstr "No puedes asustarme... O quizás un poquito."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.WENDY.FIRESTARTER
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.WENDY.FIRESTARTER"
msgid "Fire safety isn't that hard!!"
msgstr "¡La prevención de incendios no es tan difícil!"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.WENDY.GENERIC
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.WENDY.GENERIC"
msgid "Hey %s!"
msgstr "¡Ey, %s!"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.WENDY.GHOST
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.WENDY.GHOST"
msgid "Oh, it's... kind of hard to tell you two apart."
msgstr "Ah, es... bastante difícil diferenciarlas a ambas."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.WENDY.MURDERER
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.WENDY.MURDERER"
msgid "You... how could you do that?"
msgstr "Tú... ¿Cómo pudiste hacer eso?"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.WENDY.REVIVER
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.WENDY.REVIVER"
msgid "Being a ghost isn't so bad, I can see why Abigail likes it!"
msgstr "No es tan malo ser un fantasma. ¡Ahora entiendo a Abigail!"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.WENDY_RESURRECTIONGRAVE
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.WENDY_RESURRECTIONGRAVE"
msgid "Hope I never have to use it, Woby!"
msgstr ""

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.WEREITEM_BEAVER
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.WEREITEM_BEAVER"
msgid "I knew the Werebeaver was real! Nobody believed me!"
msgstr "¡Sabía que el hombre-castor era real! ¡Nadie me creía!"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.WEREITEM_GOOSE
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.WEREITEM_GOOSE"
msgid "Yeah that... definitely looks cursed."
msgstr "Sí... Eso definitivamente parece embrujado."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.WEREITEM_MOOSE
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.WEREITEM_MOOSE"
msgid "So how does the curse work? When did it start?"
msgstr "¿Cómo funciona la maldición? ¿Cuándo empezó?"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.WES.ATTACKER
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.WES.ATTACKER"
msgid "This is why I don't trust clowns!"
msgstr "¡Por eso no confío en los payasos!"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.WES.FIRESTARTER
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.WES.FIRESTARTER"
msgid "That's not a proper campfire, %s!"
msgstr "Esa no es una buena fogata, %s."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.WES.GENERIC
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.WES.GENERIC"
msgid "Uh... hi %s."
msgstr "Eh... Hola, %s."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.WES.GHOST
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.WES.GHOST"
msgid "A Pinetree Pioneer leaves no one behind! Even if they're a clown!"
msgstr "Un pionero del pinar nunca deja a nadie atrás. ¡Aunque sea un payaso!"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.WES.MURDERER
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.WES.MURDERER"
msgid "%s is a killer clown!"
msgstr "¡%s es un payaso asesino!"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.WES.REVIVER
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.WES.REVIVER"
msgid "I guess some clowns are okay."
msgstr "Supongo que algunos payasos no son malos."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.WETGOOP
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.WETGOOP"
msgid "Er... maybe Woby will want it..."
msgstr "Eh... quizás Woby lo quiera..."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.WETPAPER
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.WETPAPER"
msgid "Better than a wet blanket! Heh... good one Walter."
msgstr "¡Mejor que una manta mojada! Je."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.WETPOUCH
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.WETPOUCH"
msgid "Ugh, it's falling apart!"
msgstr "¡Se cae a pedazos!"

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.WHIP
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.WHIP"
msgid "I know how you feel about cats Woby, but it still seems pretty mean."
msgstr "Sé lo que piensas de los gatos, Woby. Pero este parece malo."

#. STRINGS.CHARACTERS.WALTER.DESCRIBE.WICKERBOTTOM.ATTACKER
msgctxt "STRINGS.CHARACTERS.WALTER.DESCRIBE.WICKERBOTTOM.ATTACKER"
msgid "Is this because I said the radio will make books obsolete?"
msgstr "¿Es porque dije que la radio reemplazaría a los libros?"

