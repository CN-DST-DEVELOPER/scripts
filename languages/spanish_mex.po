#. STRINGS.CHARACTERS.WINONA.DESCRIBE.BEARGERFUR_SACK
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.BEARGERFUR_SACK"
msgid "Weirdest lunch bucket I've ever seen."
msgstr "El cubo para almuerzo más extraño que he visto."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.BEARGERVEST
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.BEARGERVEST"
msgid "One seriously cozy vest."
msgstr "Un chaleco realmente cómodo."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.BEARGER_FUR
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.BEARGER_FUR"
msgid "Real soothing to run your fingers through."
msgstr "Relaja mucho pasar los dedos por encima."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.BEAST_BLUEPRINT
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.BEAST_BLUEPRINT"
msgid "Hope it gives me some luck in the contest."
msgstr "Espero que me dé suerte en la competencia."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.BEDROLL_FURRY
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.BEDROLL_FURRY"
msgid "Better to hit the fur than the hay."
msgstr "Para planchar la oreja calentita."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.BEDROLL_STRAW
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.BEDROLL_STRAW"
msgid "Gonna hit the hay. Literally."
msgstr "No hay nada como acostarse en el heno."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.BEE.GENERIC
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.BEE.GENERIC"
msgid "She's an incredible worker."
msgstr "Es una trabajadora increíble."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.BEE.HELD
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.BEE.HELD"
msgid "Workers gotta look out for one another."
msgstr "Los trabajadores tienen que cuidarse unos a otros."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.BEEBOX.BURNT
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.BEEBOX.BURNT"
msgid "Factory fire!"
msgstr "¡Un incendio en la fábrica!"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.BEEBOX.FULLHONEY
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.BEEBOX.FULLHONEY"
msgid "Excellent work, bees!"
msgstr "¡Un trabajo excelente, abejas!"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.BEEBOX.GENERIC
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.BEEBOX.GENERIC"
msgid "It's like an assembly line in there. Busy!"
msgstr "Es como una cadena de montaje. ¡Qué ocupadas están!"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.BEEBOX.NOHONEY
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.BEEBOX.NOHONEY"
msgid "Where's that stellar work ethic, bees?!"
msgstr "¿¡Dónde está esa ética laboral estelar, abejas!?"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.BEEBOX.READY
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.BEEBOX.READY"
msgid "Excellent work, bees!"
msgstr "¡Un trabajo excelente, abejas!"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.BEEBOX.SOMEHONEY
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.BEEBOX.SOMEHONEY"
msgid "You've been working hard."
msgstr "Trabajaron mucho."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.BEEBOX_HERMIT.BURNT
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.BEEBOX_HERMIT.BURNT"
msgid "Factory fire!"
msgstr "¡Un incendio en la fábrica!"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.BEEBOX_HERMIT.FULLHONEY
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.BEEBOX_HERMIT.FULLHONEY"
msgid "Excellent work, bees!"
msgstr "¡Un trabajo excelente, abejas!"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.BEEBOX_HERMIT.GENERIC
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.BEEBOX_HERMIT.GENERIC"
msgid "Huh. Interestin' construction."
msgstr "Ah. Interesante construcción."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.BEEBOX_HERMIT.NOHONEY
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.BEEBOX_HERMIT.NOHONEY"
msgid "Where's that stellar work ethic, bees?!"
msgstr "¿¡Dónde está esa ética laboral estelar, abejas!?"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.BEEBOX_HERMIT.READY
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.BEEBOX_HERMIT.READY"
msgid "Excellent work, bees!"
msgstr "¡Un trabajo excelente, abejas!"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.BEEBOX_HERMIT.SOMEHONEY
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.BEEBOX_HERMIT.SOMEHONEY"
msgid "You've been working hard."
msgstr "Trabajaron mucho."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.BEEFALO.DEAD
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.BEEFALO.DEAD"
msgid "That's unfortunate."
msgstr "Qué mala suerte."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.BEEFALO.DEAD_MYPARTNER
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.BEEFALO.DEAD_MYPARTNER"
msgid "It wasn't its time."
msgstr "No era su hora."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.BEEFALO.DOMESTICATED
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.BEEFALO.DOMESTICATED"
msgid "We're friends now."
msgstr "Ahora somos amigos."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.BEEFALO.FOLLOWER
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.BEEFALO.FOLLOWER"
msgid "Looks like I made a friend."
msgstr "Parece que me hice un amigo."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.BEEFALO.GENERIC
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.BEEFALO.GENERIC"
msgid "Heh. Big lug."
msgstr "Je. Pedazo de bicho."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.BEEFALO.MYPARTNER
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.BEEFALO.MYPARTNER"
msgid "We're buddies!"
msgstr "¡Somos compas!"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.BEEFALO.NAKED
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.BEEFALO.NAKED"
msgid "Ha! That's just vulgar."
msgstr "¡Ja! Qué vulgar."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.BEEFALO.ORNERY
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.BEEFALO.ORNERY"
msgid "Rein in that attitude before I rein in you!"
msgstr "¡Detén esa actitud antes de que yo te detenga!"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.BEEFALO.PUDGY
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.BEEFALO.PUDGY"
msgid "You're getting soft!"
msgstr "¡Te estás ablandando!"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.BEEFALO.RIDER
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.BEEFALO.RIDER"
msgid "Wow! You're in top form!"
msgstr "¡Guau! ¡Estás en plena forma!"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.BEEFALO.SLEEPING
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.BEEFALO.SLEEPING"
msgid "Lazy."
msgstr "Qué perezoso."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.BEEFALOFEED
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.BEEFALOFEED"
msgid "Feedin' time!"
msgstr "¡Hora de comer!"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.BEEFALOHAT
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.BEEFALOHAT"
msgid "Seem secretive."
msgstr "Parece reservado."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.BEEFALOTREAT
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.BEEFALOTREAT"
msgid "My beefalo's been pulling her weight, she should get a reward."
msgstr "Mi bífalo trabajó muy duro, debería obtener una recompensa."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.BEEFALOWOOL
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.BEEFALOWOOL"
msgid "Smelly, but warm."
msgstr "Huele, pero da calor."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.BEEFALO_GROOMER.BURNT
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.BEEFALO_GROOMER.BURNT"
msgid "Guess I'll have to build another one."
msgstr "Supongo que tendré que fabricar otro."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.BEEFALO_GROOMER.GENERIC
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.BEEFALO_GROOMER.GENERIC"
msgid "Awfully fancy for a beefalo."
msgstr "Bastante elegante para un bífalo."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.BEEFALO_GROOMER.OCCUPIED
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.BEEFALO_GROOMER.OCCUPIED"
msgid "Let's get this beefalo spiffed up."
msgstr "Vamos a poner a este bífalo más presentable."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.BEEFALO_GROOMER_ITEM
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.BEEFALO_GROOMER_ITEM"
msgid "Better get building!"
msgstr "¡Hora de construir!"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.BEEF_BELL
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.BEEF_BELL"
msgid "The beefalo sure do like that bell!"
msgstr "¡Seguro que al bífalo le gusta esa campana!"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.BEEGUARD
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.BEEGUARD"
msgid "Monarchy is an outdated ruling system!"
msgstr "¡La monarquía es un sistema de gobierno anticuado!"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.BEEHAT
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.BEEHAT"
msgid "Respecting bees means respecting stingers."
msgstr "Respetar a las abejas significa respetar los aguijones."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.BEEHIVE
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.BEEHIVE"
msgid "Hard at work."
msgstr "Están trabajando."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.BEEMINE
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.BEEMINE"
msgid "Sounds like the hum of an engine."
msgstr "Suena como el zumbido de un motor."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.BEEMINE_MAXWELL
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.BEEMINE_MAXWELL"
msgid "That guy's got no concern for others. Pfft."
msgstr "A ese tipo no le preocupan los demás. Uf."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.BEEQUEEN
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.BEEQUEEN"
msgid "It's the queen of bees!"
msgstr "¡Es la reina de las abejas!"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.BEEQUEENHIVE.GENERIC
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.BEEQUEENHIVE.GENERIC"
msgid "Sticky. I'd rather not walk on it."
msgstr "Qué pegajoso. Será mejor no andar por encima."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.BEEQUEENHIVE.GROWING
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.BEEQUEENHIVE.GROWING"
msgid "I swear that thing's gotten bigger."
msgstr "Juro que esa cosa ha crecido."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.BEEQUEENHIVEGROWN
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.BEEQUEENHIVEGROWN"
msgid "Yeesh! I'd take a hammer to that."
msgstr "¡Sí! Le daría un martillazo."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.BEESWAX
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.BEESWAX"
msgid "It smells kinda alright."
msgstr "Huele bastante bien."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.BEESWAX_SPRAY
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.BEESWAX_SPRAY"
msgid "I never liked perfume. Now I like it even less"
msgstr "Nunca me gustó el perfume. Y ahora me gusta menos."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.BEETLETAUR
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.BEETLETAUR"
msgid "Go back to your cage."
msgstr "Vuelve a tu jaula."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.BELL
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.BELL"
msgid "There's always a stampede when the quittin' bell rings."
msgstr "Siempre hay una estampida cuando suena la alarma para irse a casa."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.BERNIE_ACTIVE
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.BERNIE_ACTIVE"
msgid "Is he clockwork? Can I peek inside?"
msgstr "¿Es un mecanismo de relojería? ¿Puedo mirar dentro?"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.BERNIE_BIG
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.BERNIE_BIG"
msgid "That girl knows how to put on a show."
msgstr "Esa chica sabe bien cómo actuar."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.BERNIE_INACTIVE.BROKEN
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.BERNIE_INACTIVE.BROKEN"
msgid "He's a bit of a fixer-upper."
msgstr "Parece que hay que repararlo."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.BERNIE_INACTIVE.GENERIC
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.BERNIE_INACTIVE.GENERIC"
msgid "This little guy's been well loved."
msgstr "Este chiquitín es muy querido."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.BERRIES
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.BERRIES"
msgid "A handful of loose berries."
msgstr "Un puñado de bayas sueltas."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.BERRIES_COOKED
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.BERRIES_COOKED"
msgid "A bit charred in places, but I don't mind."
msgstr "Está un poco quemado en algunas partes, pero me da igual."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.BERRIES_JUICY
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.BERRIES_JUICY"
msgid "They're so juicy!"
msgstr "¡Qué jugosas!"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.BERRIES_JUICY_COOKED
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.BERRIES_JUICY_COOKED"
msgid "They're still pretty darn juicy."
msgstr "Aún están bastante jugosas."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.BERRYBUSH.BARREN
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.BERRYBUSH.BARREN"
msgid "Needs something from a beast's backside."
msgstr "Necesita algo del trasero de una bestia."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.BERRYBUSH.BURNING
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.BERRYBUSH.BURNING"
msgid "Not much I can do now."
msgstr "No hay mucho que pueda hacer ahora."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.BERRYBUSH.DISEASED
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.BERRYBUSH.DISEASED"
msgid "Maybe you oughta take a sick day..."
msgstr "Tal vez deberías tomarte un día de descanso por enfermedad..."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.BERRYBUSH.DISEASING
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.BERRYBUSH.DISEASING"
