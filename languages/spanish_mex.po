msgstr "¡Vamos, pedazo de bicho!"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.BEARGERCORPSE.BURNING
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.BEARGERCORPSE.BURNING"
msgid "He'll be smokin' for days."
msgstr "Se estará quemando durante días."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.BEARGERCORPSE.GENERIC
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.BEARGERCORPSE.GENERIC"
