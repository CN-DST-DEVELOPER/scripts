#. STRINGS.SKIN_DESCRIPTIONS.round_table_western
msgctxt "STRINGS.SKIN_DESCRIPTIONS.round_table_western"
msgid "A perfect table for cheating at cards, after a long day spent cheating death."
msgstr "Una mesa perfecta jugar a las cartas y hacer trampa tras un día largo de engañar a la muerte."

#. STRINGS.SKIN_DESCRIPTIONS.ruins_bat_an
msgctxt "STRINGS.SKIN_DESCRIPTIONS.ruins_bat_an"
msgid "Beauty can be found everywhere, even in blunt force."
msgstr "La belleza está en todas partes, incluso en la fuerza bruta."

#. STRINGS.SKIN_DESCRIPTIONS.ruins_bat_arcane
msgctxt "STRINGS.SKIN_DESCRIPTIONS.ruins_bat_arcane"
msgid "A weapon favored by forgotten warriors of old."
msgstr "Un arma que preferían los guerreros olvidados de antaño."

#. STRINGS.SKIN_DESCRIPTIONS.ruins_bat_heavy
msgctxt "STRINGS.SKIN_DESCRIPTIONS.ruins_bat_heavy"
msgid "Lacerate with a cursed blade."
msgstr "Corta con una hoja maldita."

#. STRINGS.SKIN_DESCRIPTIONS.ruinshat_an
msgctxt "STRINGS.SKIN_DESCRIPTIONS.ruinshat_an"
msgid "Give your head the royal treatment in this finely crafted crown."
msgstr "Dale a tu cabeza un tratamiento real con esta corona de elaboración refinada."

#. STRINGS.SKIN_DESCRIPTIONS.ruinshat_arcane
msgctxt "STRINGS.SKIN_DESCRIPTIONS.ruinshat_arcane"
msgid "The ancient secrets it holds have been lost to time."
msgstr "Los secretos antiguos que contiene se perdieron en el tiempo."

#. STRINGS.SKIN_DESCRIPTIONS.ruinsrelic_chair_toilet
msgctxt "STRINGS.SKIN_DESCRIPTIONS.ruinsrelic_chair_toilet"
msgid "Loo, loo, skip to my loo!"
msgstr "¡Ea, ea, aquí tengo un excusado!"

#. STRINGS.SKIN_DESCRIPTIONS.saddle_basic_yotb
msgctxt "STRINGS.SKIN_DESCRIPTIONS.saddle_basic_yotb"
msgid "The best seat in the house for beefalo-related festivities."
msgstr "El mejor asiento de la casa para festividades relacionadas con el bífalo."

#. STRINGS.SKIN_DESCRIPTIONS.saddle_basic_yotbalt
msgctxt "STRINGS.SKIN_DESCRIPTIONS.saddle_basic_yotbalt"
msgid "The best seat in the house for beefalo-related festivities."
msgstr "El mejor asiento de la casa para festividades relacionadas con el bífalo."

#. STRINGS.SKIN_DESCRIPTIONS.saltbox_kitchen
msgctxt "STRINGS.SKIN_DESCRIPTIONS.saltbox_kitchen"
msgid "A sweet design for salty storage."
msgstr "Un diseño dulce para un almacenamiento salado."

#. STRINGS.SKIN_DESCRIPTIONS.saltbox_nautical
msgctxt "STRINGS.SKIN_DESCRIPTIONS.saltbox_nautical"
msgid "This shell encrusted container utilizes sea salt as a natural preservative."
msgstr "Este recipiente con incrustaciones de caracola usa sal marina como conservante natural."

#. STRINGS.SKIN_DESCRIPTIONS.saltbox_shaker
msgctxt "STRINGS.SKIN_DESCRIPTIONS.saltbox_shaker"
msgid "Why not shake things up a bit?"
msgstr "¿Por qué no darle sabor a la vida?"

#. STRINGS.SKIN_DESCRIPTIONS.saltbox_victorian
msgctxt "STRINGS.SKIN_DESCRIPTIONS.saltbox_victorian"
msgid "Stylish and practical food storage."
msgstr "Conserva alimentos de forma práctica y elegante."

#. STRINGS.SKIN_DESCRIPTIONS.sanityrock_fantasy
msgctxt "STRINGS.SKIN_DESCRIPTIONS.sanityrock_fantasy"
msgid "This mysterious pillar seems to grow and shrink, as if by magic."
msgstr "Esta columna misteriosa parece crecer y encogerse como por arte de magia."

#. STRINGS.SKIN_DESCRIPTIONS.sanityrock_gothic
msgctxt "STRINGS.SKIN_DESCRIPTIONS.sanityrock_gothic"
msgid "Was that pillar there before? Have you finally gone mad?"
msgstr "¿Esa columna ya estaba ahí? ¿Al fin perdiste la cabeza?"

#. STRINGS.SKIN_DESCRIPTIONS.sculptingtable_gothic
msgctxt "STRINGS.SKIN_DESCRIPTIONS.sculptingtable_gothic"
msgid "Sculpt intricate stonework to your heart's content."
msgstr "Esculpe obras intricadas de piedra a tu antojo."

#. STRINGS.SKIN_DESCRIPTIONS.seafaring_prototyper_lighthouse
msgctxt "STRINGS.SKIN_DESCRIPTIONS.seafaring_prototyper_lighthouse"
msgid "A beacon of nautical knowledge."
msgstr "Un faro de conocimiento náutico."

#. STRINGS.SKIN_DESCRIPTIONS.seedpouch_garden
msgctxt "STRINGS.SKIN_DESCRIPTIONS.seedpouch_garden"
msgid "A pretty purse for all your seed-carrying needs."
msgstr "Una bolsa bonita para todas tus necesidades de transporte de semillas."

#. STRINGS.SKIN_DESCRIPTIONS.seedpouch_rustic
msgctxt "STRINGS.SKIN_DESCRIPTIONS.seedpouch_rustic"
msgid "Sturdily hand-stitched for rambunctious gardeners."
msgstr "Cosida a mano y resistente para jardineros revoltosos."

#. STRINGS.SKIN_DESCRIPTIONS.sewing_mannequin_an
msgctxt "STRINGS.SKIN_DESCRIPTIONS.sewing_mannequin_an"
msgid "A fashion idol."
msgstr "Un ídolo de la moda."

#. STRINGS.SKIN_DESCRIPTIONS.shovel_feathered
msgctxt "STRINGS.SKIN_DESCRIPTIONS.shovel_feathered"
msgid "A shovel for the self-reliant adventurer."
msgstr "Una pala para aventureros independientes."

#. STRINGS.SKIN_DESCRIPTIONS.shovel_heart
msgctxt "STRINGS.SKIN_DESCRIPTIONS.shovel_heart"
msgid "Just the thing to help bury those pesky feelings."
msgstr "Justo lo que necesitas para enterrar esos sentimientos molestos."

#. STRINGS.SKIN_DESCRIPTIONS.shovel_invisible
msgctxt "STRINGS.SKIN_DESCRIPTIONS.shovel_invisible"
msgid "Convey an incredibly convincing impression of a shovel."
msgstr "Es una imitación muy convincente de una pala."

#. STRINGS.SKIN_DESCRIPTIONS.shovel_northern
msgctxt "STRINGS.SKIN_DESCRIPTIONS.shovel_northern"
msgid "A rustic, sturdy shovel."
msgstr "Una pala rústica y resistente."

#. STRINGS.SKIN_DESCRIPTIONS.shovel_victorian
msgctxt "STRINGS.SKIN_DESCRIPTIONS.shovel_victorian"
msgid "A lovely shovel with decorative silver engravings."
msgstr "Una pala preciosa con grabados decorativos en plata."

#. STRINGS.SKIN_DESCRIPTIONS.siestahut_cawnival
msgctxt "STRINGS.SKIN_DESCRIPTIONS.siestahut_cawnival"
msgid "Between all those Cawnival games, a quick siesta might be just the ticket."
msgstr "Entre todos esos juegos de Graznaval, una siesta rápida puede ser lo que necesitas."

#. STRINGS.SKIN_DESCRIPTIONS.skeletonhat_shadowhelmet
msgctxt "STRINGS.SKIN_DESCRIPTIONS.skeletonhat_shadowhelmet"
msgid "Thick shadows for thick skulls."
msgstr "Sombras gruesas para cabezas duras."

#. STRINGS.SKIN_DESCRIPTIONS.spear_bee
msgctxt "STRINGS.SKIN_DESCRIPTIONS.spear_bee"
msgid "It doesn't hit harder than a regular spear, although it certainly still stings."
msgstr "No golpea más fuerte que una lanza normal, pero pica como un aguijón."

#. STRINGS.SKIN_DESCRIPTIONS.spear_forge_gungnir
msgctxt "STRINGS.SKIN_DESCRIPTIONS.spear_forge_gungnir"
msgid "Jagged and sharp are fine qualities for a weapon in battle."
msgstr "Los dientes y el filo son buenas cualidades para un arma de combate."

#. STRINGS.SKIN_DESCRIPTIONS.spear_forge_lance
msgctxt "STRINGS.SKIN_DESCRIPTIONS.spear_forge_lance"
msgid "Keep the drill pointed toward your foes and you'll be triumphant."
msgstr "Mantén el taladro apuntado hacia los enemigos y triunfarás."

#. STRINGS.SKIN_DESCRIPTIONS.spear_hockey
msgctxt "STRINGS.SKIN_DESCRIPTIONS.spear_hockey"
msgid "The Canadian weapon of choice."
msgstr "El arma preferida de Canadá."

#. STRINGS.SKIN_DESCRIPTIONS.spear_northern
msgctxt "STRINGS.SKIN_DESCRIPTIONS.spear_northern"
msgid "A rustic, sturdy spear."
msgstr "Una lanza rústica y resistente."

#. STRINGS.SKIN_DESCRIPTIONS.spear_ragged
msgctxt "STRINGS.SKIN_DESCRIPTIONS.spear_ragged"
msgid "This spear has seen more than its fair share of battles."
msgstr "Esta lanza vio una gran cantidad de batallas."

#. STRINGS.SKIN_DESCRIPTIONS.spear_rose
msgctxt "STRINGS.SKIN_DESCRIPTIONS.spear_rose"
msgid "No sharper than any other spear, though much lovelier."
msgstr "No más afilada que una lanza común, pero mucho más hermosa."

#. STRINGS.SKIN_DESCRIPTIONS.spear_simple
msgctxt "STRINGS.SKIN_DESCRIPTIONS.spear_simple"
msgid "A rudimentary weapon, sharp and ready for a quarrel."
msgstr "Un arma rudimentaria, afilada y preparada para el combate."

#. STRINGS.SKIN_DESCRIPTIONS.spear_wathgrithr_lightning_charged_lunar
msgctxt "STRINGS.SKIN_DESCRIPTIONS.spear_wathgrithr_lightning_charged_lunar"
msgid "A shining spear weilded by only the most powerful of the moon's chosen warriors."
msgstr "Una lanza brillante que empuñan solo los más poderosos entre los guerreros elegidos de la Luna."

#. STRINGS.SKIN_DESCRIPTIONS.spear_wathgrithr_lightning_charged_northern
msgctxt "STRINGS.SKIN_DESCRIPTIONS.spear_wathgrithr_lightning_charged_northern"
msgid "A weapon imbued with the ferocity of a storm."
msgstr "Un arma que porta la ferocidad de una tormenta."

#. STRINGS.SKIN_DESCRIPTIONS.spear_wathgrithr_lightning_charged_valkyrie
msgctxt "STRINGS.SKIN_DESCRIPTIONS.spear_wathgrithr_lightning_charged_valkyrie"
msgid "Swoop in and strike your foes as quick as lightning."
msgstr "Precipítate y golpea a los enemigos rápido como el rayo."

#. STRINGS.SKIN_DESCRIPTIONS.spear_wathgrithr_lightning_charged_wrestle
msgctxt "STRINGS.SKIN_DESCRIPTIONS.spear_wathgrithr_lightning_charged_wrestle"
msgid "The weilder of this weapon is sure to receive thunderous applause in the ring."
msgstr "Quien use esta arma recibirá un aplauso atronador en el cuadrilátero."

#. STRINGS.SKIN_DESCRIPTIONS.spear_wathgrithr_lightning_lunar
