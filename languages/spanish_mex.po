msgstr "Un puñado de semillas raras."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.GAZPACHO
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.GAZPACHO"
msgid "How in science does it taste so good?"
msgstr "¿Cómo se explica que sea tan delicioso?"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.GEARS
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.GEARS"
msgid "A pile of mechanical parts."
msgstr "Un montón de piezas mecánicas."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.GELBLOB.GENERIC
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.GELBLOB.GENERIC"
msgid "'Ick' is right!"
msgstr "«Guácale» es la palabra correcta."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.GELBLOB.HAS_CHARACTER
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.GELBLOB.HAS_CHARACTER"
