msgstr "No. Yo NO canto."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BATWING
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BATWING"
msgid "I'm not eating that."
msgstr "No pienso comerme eso."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BATWING_COOKED
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BATWING_COOKED"
msgid "I'm still not eating that."
msgstr "Sigo sosteniendo que no voy a comer eso."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BEARDHAIR
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BEARDHAIR"
msgid "Hirsute."
msgstr "Hirsuto."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BEARGER
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BEARGER"
msgid "Take whatever you want."
msgstr "Llévate lo que quieras."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BEARGERCORPSE.BURNING
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BEARGERCORPSE.BURNING"
msgid "That's one problem solved."
msgstr "Un problema resuelto."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BEARGERCORPSE.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BEARGERCORPSE.GENERIC"
msgid "Ugh. I can't just leave that lying around."
msgstr "Agh. No puedo dejar eso ahí."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BEARGERCORPSE.REVIVING
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BEARGERCORPSE.REVIVING"
msgid "The \"moon's\" influence is growing..."
msgstr "La influencia de la «luna» se intensifica..."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BEARGERFUR_SACK
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BEARGERFUR_SACK"
msgid "Portable indeed. Wilson can carry it."
msgstr "Portátil. Wilson la puede llevar."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BEARGERVEST
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BEARGERVEST"
msgid "See my vest."
msgstr "Mira mi chaleco."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BEARGER_FUR
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BEARGER_FUR"
msgid "This would make a nice rug."
msgstr "Esto haría una bonita alfombra."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BEAST_BLUEPRINT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BEAST_BLUEPRINT"
msgid "I'd say luck is in rather short supply around here."
msgstr "Diría que nos falta suerte por aquí."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BEDROLL_FURRY
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BEDROLL_FURRY"
msgid "At least they're good for something."
msgstr "Al menos, son buenos para algo."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BEDROLL_STRAW
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BEDROLL_STRAW"
msgid "I don't like sleeping rough."
msgstr "No me gusta dormir sin comodidades."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BEE.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BEE.GENERIC"
msgid "They work so hard, the fools."
msgstr "Trabajan muy duro, las pobres."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BEE.HELD
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BEE.HELD"
msgid "Now what do I do with it?"
msgstr "¿Ahora qué hago con ella?"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BEEBOX.BURNT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BEEBOX.BURNT"
msgid "Honey roasted."
msgstr "Miel asada."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BEEBOX.FULLHONEY
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BEEBOX.FULLHONEY"
msgid "So tempting, but so full of bees."
msgstr "Muy tentadora, pero tan llena de abejas."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BEEBOX.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BEEBOX.GENERIC"
msgid "It holds the bees."
msgstr "Guarda las abejas."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BEEBOX.NOHONEY
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BEEBOX.NOHONEY"
msgid "Why do the bees not serve me?"
msgstr "¿Por qué las abejas no están a mi servicio?"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BEEBOX.READY
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BEEBOX.READY"
msgid "So tempting, but so full of bees."
msgstr "Muy tentadora, pero tan llena de abejas."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BEEBOX.SOMEHONEY
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BEEBOX.SOMEHONEY"
msgid "I should wait a bit longer."
msgstr "Debería esperar un poco más."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BEEBOX_HERMIT.BURNT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BEEBOX_HERMIT.BURNT"
msgid "Honey roasted."
msgstr "Miel asada."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BEEBOX_HERMIT.FULLHONEY
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BEEBOX_HERMIT.FULLHONEY"
msgid "I've done enough, the old woman can brave the bees herself."
msgstr "Ya hice suficiente; que esa anciana se ocupe de las abejas sola."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BEEBOX_HERMIT.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BEEBOX_HERMIT.GENERIC"
msgid "I think she made this herself."
msgstr "Creo que lo ha hecho ella misma."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BEEBOX_HERMIT.NOHONEY
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BEEBOX_HERMIT.NOHONEY"
msgid "Why do the bees not serve me?"
msgstr "¿Por qué las abejas no están a mi servicio?"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BEEBOX_HERMIT.READY
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BEEBOX_HERMIT.READY"
msgid "I've done enough, the old woman can brave the bees herself."
msgstr "Ya hice suficiente; que esa anciana se ocupe de las abejas sola."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BEEBOX_HERMIT.SOMEHONEY
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BEEBOX_HERMIT.SOMEHONEY"
msgid "I should wait a bit longer."
msgstr "Debería esperar un poco más."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BEEFALO.DEAD
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BEEFALO.DEAD"
msgid "They smell even worse when they're dead."
msgstr "Muertos apestan aún más."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BEEFALO.DEAD_MYPARTNER
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BEEFALO.DEAD_MYPARTNER"
msgid "How dare you die on me!"
msgstr "¿Cómo te atreves a morírteme?"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BEEFALO.DOMESTICATED
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BEEFALO.DOMESTICATED"
msgid "I like a creature that knows its place."
msgstr "Me gustan las criaturas que conocen su lugar."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BEEFALO.FOLLOWER
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BEEFALO.FOLLOWER"
msgid "Aw nuts, it's following me."
msgstr "Ay, rayos, me está siguiendo."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BEEFALO.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BEEFALO.GENERIC"
msgid "Just look at that stupid beast."
msgstr "Fíjate en esa bestia estúpida."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BEEFALO.MYPARTNER
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BEEFALO.MYPARTNER"
msgid "I suppose I'm saddled with this creature now."
msgstr "Supongo que ahora debo cargar con esta criatura."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BEEFALO.NAKED
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BEEFALO.NAKED"
msgid "Now it looks dumb AND pathetic."
msgstr "Ahora parece estúpido Y patético."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BEEFALO.ORNERY
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BEEFALO.ORNERY"
msgid "Yes, you understand how this works."
msgstr "Sí, entiendes cómo funciona."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BEEFALO.PUDGY
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BEEFALO.PUDGY"
msgid "I suppose some people might find that charming."
msgstr "Supongo que algunas personas lo encontrarían encantador."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BEEFALO.RIDER
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BEEFALO.RIDER"
msgid "I'd only ride you if I was desperate."
msgstr "Solo me montaría en ti si estuviera desesperado."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BEEFALO.SLEEPING
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BEEFALO.SLEEPING"
msgid "It's only marginally less stupid when it's asleep."
msgstr "Es solo un poco menos estúpido cuando está dormido."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BEEFALOFEED
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BEEFALOFEED"
msgid "I suppose I'd better keep the stupid beast fed."
msgstr "Supongo que conviene mantener a la estúpida bestia alimentada."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BEEFALOHAT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BEEFALOHAT"
msgid "How unfashionable."
msgstr "Qué pasado de moda."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BEEFALOTREAT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BEEFALOTREAT"
msgid "Best to keep the beast placated for now."
msgstr "Supongo que conviene mantener a la bestia apaciguada."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BEEFALOWOOL
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BEEFALOWOOL"
msgid "It smells like a barn."
msgstr "Huele a establo."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BEEFALO_GROOMER.BURNT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BEEFALO_GROOMER.BURNT"
msgid "What a shame."
msgstr "Qué lástima."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BEEFALO_GROOMER.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BEEFALO_GROOMER.GENERIC"
msgid "How ridiculous."
msgstr "Una ridiculez."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BEEFALO_GROOMER.OCCUPIED
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BEEFALO_GROOMER.OCCUPIED"
msgid "I suppose I'll have to try to make this creature less homely."
msgstr "Supongo de tendré que intentar que esta criatura parezca menos fea."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BEEFALO_GROOMER_ITEM
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BEEFALO_GROOMER_ITEM"
msgid "Do I look like a common construction worker? Oh very well..."
msgstr "¿Tengo pinta de constructor? Ay, bien..."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BEEF_BELL
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BEEF_BELL"
msgid "It appears to have some kind of hypnotic effect on beefalo."
msgstr "Parece que tiene una especie de efecto hipnótico sobre los bífalos."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BEEGUARD
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BEEGUARD"
msgid "Keep your backside to yourself, madam!"
msgstr "¡No me interesa su trasero, señora!"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BEEHAT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BEEHAT"
msgid "I'll wear it if I have to."
msgstr "Lo usaré si es necesario."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BEEHIVE
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BEEHIVE"
msgid "Not the bees!"
msgstr "¡Las abejas no!"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BEEMINE
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BEEMINE"
msgid "They wait so patiently."
msgstr "Esperan tan pacientemente."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BEEMINE_MAXWELL
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BEEMINE_MAXWELL"
msgid "Maybe I shouldn't have put that there."
msgstr "Tal vez no debería haber puesto eso ahí."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BEEQUEEN
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BEEQUEEN"
msgid "I didn't make that one! Really!"
msgstr "¡Yo no fui! ¡Lo juro!"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BEEQUEENHIVE.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BEEQUEENHIVE.GENERIC"
msgid "I am not getting that on my shoes."
msgstr "No pienso ponerme eso en los zapatos."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BEEQUEENHIVE.GROWING
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BEEQUEENHIVE.GROWING"
msgid "Now what are those bees up to?"
msgstr "¿Qué traman esas abejas?"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BEEQUEENHIVEGROWN
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BEEQUEENHIVEGROWN"
msgid "I don't see what all the buzz is about."
msgstr "No sé a qué viene tanto revuelo."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BEESWAX
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BEESWAX"
msgid "I miss sealing a good letter."
msgstr "Extraño sellar una buena carta."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BEESWAX_SPRAY
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BEESWAX_SPRAY"
msgid "I'm picking up notes of terror, with a hint of dread."
msgstr "Noto una pizca de terror con un toque de espanto."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BEETLETAUR
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BEETLETAUR"
msgid "Back to the dungeons with you!"
msgstr "¡Vuelve a las mazmorras!"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BELL
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BELL"
msgid "More bell."
msgstr "Otra campana."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BERNIE_ACTIVE
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BERNIE_ACTIVE"
msgid "Just what am I looking at here?"
msgstr "¿Qué es lo que estoy mirando aquí?"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BERNIE_BIG
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BERNIE_BIG"
msgid "How truly unnerving."
msgstr "Es francamente desconcertante."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BERNIE_INACTIVE.BROKEN
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BERNIE_INACTIVE.BROKEN"
msgid "It's seen better days."
msgstr "Ha tenido mejores días."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BERNIE_INACTIVE.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BERNIE_INACTIVE.GENERIC"
msgid "It makes me a little nostalgic."
msgstr "Me da un poco de nostalgia."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BERRIES
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BERRIES"
msgid "Sigh. If I have to."
msgstr "Ay. Si tengo que hacerlo..."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BERRIES_COOKED
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BERRIES_COOKED"
msgid "A little more refined, at least."
msgstr "Un poco más refinada, por lo menos."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BERRIES_JUICY
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BERRIES_JUICY"
msgid "Delightfully sweet with a subtle hint of tartness."
msgstr "Deliciosamente dulce con un sutil toque de acidez."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BERRIES_JUICY_COOKED
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BERRIES_JUICY_COOKED"
msgid "They're quite delicious, actually."
msgstr "Están bastante deliciosas, la verdad."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BERRYBUSH.BARREN
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BERRYBUSH.BARREN"
msgid "It needs manure."
msgstr "Necesita estiércol."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BERRYBUSH.BURNING
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BERRYBUSH.BURNING"
msgid "It better not start talking to me."
msgstr "Será mejor que no me empiece a hablar."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BERRYBUSH.DISEASED
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BERRYBUSH.DISEASED"
msgid "What has brought this blight upon my world?"
msgstr "¿Qué ha traído esta aflicción a mi mundo?"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BERRYBUSH.DISEASING
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BERRYBUSH.DISEASING"
msgid "Looks a little off, if you ask me."
msgstr "Parece que está un poco pasada, la verdad."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BERRYBUSH.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BERRYBUSH.GENERIC"
msgid "Reduced to eating berries. Sigh."
msgstr "Obligado a comer bayas. Ay."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BERRYBUSH.PICKED
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BERRYBUSH.PICKED"
msgid "And now we wait."
msgstr "Y ahora a esperar."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BERRYBUSH.WITHERED
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BERRYBUSH.WITHERED"
msgid "Too hot for that little bush."
msgstr "Demasiado calor para un arbusto tan pequeño."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BERRYBUSH_JUICY.BARREN
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BERRYBUSH_JUICY.BARREN"
msgid "It looks to be in need of assistance. Fertilizer, perhaps?"
msgstr "Parece necesitar ayuda. ¿Fertilizante, tal vez?"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BERRYBUSH_JUICY.BURNING
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BERRYBUSH_JUICY.BURNING"
msgid "It better not start talking to me."
msgstr "Será mejor que no me empiece a hablar."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BERRYBUSH_JUICY.DISEASED
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BERRYBUSH_JUICY.DISEASED"
msgid "What has brought this blight upon my world?"
msgstr "¿Qué ha traído esta aflicción a mi mundo?"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BERRYBUSH_JUICY.DISEASING
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BERRYBUSH_JUICY.DISEASING"
msgid "Looks a little off, if you ask me."
msgstr "Parece que está un poco pasada, la verdad."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BERRYBUSH_JUICY.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BERRYBUSH_JUICY.GENERIC"
msgid "The berries will stay fresh as long as I leave them there."
msgstr "Las bayas se mantendrán frescas siempre y cuando las deje allí."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BERRYBUSH_JUICY.PICKED
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BERRYBUSH_JUICY.PICKED"
msgid "I fear I'll have to wait."
msgstr "Me temo que tendré que esperar."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BERRYBUSH_JUICY.WITHERED
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BERRYBUSH_JUICY.WITHERED"
msgid "I know the feeling."
msgstr "Conozco la sensación."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BERRYSAUCE
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BERRYSAUCE"
msgid "This seems like a lot of fuss for some mashed berries."
msgstr "Parece mucho alboroto por lo que vienen siendo bayas machacadas."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BIBINGKA
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BIBINGKA"
msgid "It has a unique spongy texture."
msgstr "Tiene una textura esponjosa única."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BIGFOOT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BIGFOOT"
msgid "Now that is surely fuel for nightmares."
msgstr "Sin duda, es material para pesadillas."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BIRCHNUTDRAKE
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BIRCHNUTDRAKE"
msgid "A nut with legs! How terrifying!"
msgstr "¡Una nuez con patas! ¡Aterrador!"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BIRDCAGE.DEAD
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BIRDCAGE.DEAD"
msgid "That's a deep sleep."
msgstr "Eso sí que es un sueño profundo."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BIRDCAGE.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BIRDCAGE.GENERIC"
msgid "You'll never get me behind bars again."
msgstr "Nunca volveré a estar entre rejas."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BIRDCAGE.HUNGRY
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BIRDCAGE.HUNGRY"
msgid "What's all the fuss about, feathers?"
msgstr "¿A qué viene tanto revuelo, plumas?"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BIRDCAGE.OCCUPIED
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BIRDCAGE.OCCUPIED"
msgid "I feel for ya, feathers."
msgstr "Lo siento tanto, plumas."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BIRDCAGE.SKELETON
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BIRDCAGE.SKELETON"
msgid "Maybe he wasn't sleeping."
msgstr "Quizás no estaba durmiendo."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BIRDCAGE.SLEEPING
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BIRDCAGE.SLEEPING"
msgid "You'll still be in there when you wake up."
msgstr "Aún estarás ahí cuando despiertes."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BIRDCAGE.STARVING
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BIRDCAGE.STARVING"
msgid "Oh, come on. I fed you last week."
msgstr "¿En serio? Te di de comer la semana pasada."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BIRDTRAP
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BIRDTRAP"
msgid "They keep falling for it!"
msgstr "¡Siguen cayendo en la trampa!"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BIRD_EGG
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BIRD_EGG"
msgid "I like to think of it as baby bird prison."
msgstr "Me gusta pensar en esto como una prisión para pajaritos."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BIRD_EGG_COOKED
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BIRD_EGG_COOKED"
msgid "Sunny side up."
msgstr "La parte amarilla hacia arriba."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BIRD_MUTANT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BIRD_MUTANT"
msgid "That creature has seen better days."
msgstr "Esa criatura ha tenido mejores días."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BIRD_MUTANT_SPITTER
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BIRD_MUTANT_SPITTER"
msgid "You dare spit at me?!"
msgstr "¿Osas escupirme?"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BISHOP
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BISHOP"
msgid "I'm especially proud of that piece."
msgstr "Estoy especialmente orgulloso de esa pieza."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BISHOP_CHARGE_HIT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BISHOP_CHARGE_HIT"
msgid "How DARE you!"
msgstr "¡Cómo te ATREVES!"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BISHOP_NIGHTMARE
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BISHOP_NIGHTMARE"
msgid "They degrade without proper upkeep."
msgstr "Se degradan sin un mantenimiento adecuado."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BLACKFLAG
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BLACKFLAG"
msgid "Black never goes out of style."
msgstr "El negro nunca pasa de moda."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BLOWDART_FIRE
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BLOWDART_FIRE"
msgid "Just make sure to breathe out."
msgstr "Solo asegúrate de exhalar."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BLOWDART_LAVA
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BLOWDART_LAVA"
msgid "That is not my style."
msgstr "No es mi estilo."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BLOWDART_LAVA2
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BLOWDART_LAVA2"
msgid "I'm no blowhard."
msgstr "No soy ningún fanfarrón."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BLOWDART_PIPE
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BLOWDART_PIPE"
msgid "A glorious tube of pain!"
msgstr "¡Un tubo glorioso de dolor!"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BLOWDART_SLEEP
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BLOWDART_SLEEP"
msgid "Call me \"Mr. Sandman\"."
msgstr "Díganme «Mr. Sandman»."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BLOWDART_YELLOW
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BLOWDART_YELLOW"
msgid "Never strikes the same place twice, except when it does."
msgstr "Nunca golpea dos veces en el mismo sitio, excepto cuando lo hace."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BLUEAMULET
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BLUEAMULET"
msgid "It's frosted over."
msgstr "Está gélido."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BLUEGEM
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BLUEGEM"
msgid "Blue brings ice."
msgstr "El azul atrae al hielo."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BLUEMOONEYE
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BLUEMOONEYE"
msgid "That reminds me, I must practice my cold glare tonight!"
msgstr "¡Eso me recuerda que debo practicar mi mirada fría esta noche!"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BLUEPRINT.COMMON
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BLUEPRINT.COMMON"
msgid "I know all about that. I... just forgot."
msgstr "Sé todo sobre eso. Pero... me lo olvidé."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BLUEPRINT.RARE
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BLUEPRINT.RARE"
msgid "A rare blueprint, indeed."
msgstr "Un plano raro, sí."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BLUE_CAP
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BLUE_CAP"
msgid "What could go wrong?"
msgstr "¿Qué podría salir mal?"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BLUE_CAP_COOKED
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BLUE_CAP_COOKED"
msgid "Umami!"
msgstr "¡Umami!"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BLUE_MUSHROOM.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BLUE_MUSHROOM.GENERIC"
msgid "The blue ones are good for, uh, something."
msgstr "Los azules son buenos para, eh, algo."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BLUE_MUSHROOM.INGROUND
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BLUE_MUSHROOM.INGROUND"
msgid "It's not ready."
msgstr "No está listo."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BLUE_MUSHROOM.PICKED
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BLUE_MUSHROOM.PICKED"
msgid "Another time, maybe?"
msgstr "¿En otro momento, tal vez?"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BOARDS
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BOARDS"
msgid "Roughly hewn."
msgstr "Ásperamente tallados."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BOARON
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BOARON"
msgid "Begone, swine."
msgstr "Largo, cerdo."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BOARRIOR
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BOARRIOR"
msgid "Well he's certainly no slouch."
msgstr "Bueno, tampoco está encorvado."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BOATFRAGMENT03
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BOATFRAGMENT03"
msgid "Merely smithereens."
msgstr "Meros añicos."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BOATFRAGMENT04
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BOATFRAGMENT04"
msgid "Merely smithereens."
msgstr "Meros añicos."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BOATFRAGMENT05
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BOATFRAGMENT05"
msgid "Merely smithereens."
msgstr "Meros añicos."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BOATPATCH
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BOATPATCH"
msgid "I detest such work."
msgstr "Detesto ese trabajo."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BOATPATCH_KELP
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BOATPATCH_KELP"
msgid "That won't keep the water at bay for long."
msgstr "Eso no solucionará el problema por mucho tiempo."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BOATRACE_CHECKPOINT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BOATRACE_CHECKPOINT"
msgid "Are we there yet?"
msgstr "¿Ya llegamos?"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BOATRACE_CHECKPOINT_THROWABLE_DEPLOYKIT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BOATRACE_CHECKPOINT_THROWABLE_DEPLOYKIT"
msgid "Whatever."
msgstr "Lo que sea."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BOATRACE_PRIMEMATE
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BOATRACE_PRIMEMATE"
msgid "Are you supposed to be intimidating?"
msgstr "¿Se supone que eres intimidante?"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BOATRACE_SEASTACK
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BOATRACE_SEASTACK"
msgid "Out of my way!"
msgstr "¡Apártate de mi camino!"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BOATRACE_SEASTACK_MONKEY
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BOATRACE_SEASTACK_MONKEY"
msgid "Hm. Someone's feeling prickly."
msgstr "Mmm... Alguien está irritable."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BOATRACE_SEASTACK_MONKEY_THROWABLE_DEPLOYKIT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BOATRACE_SEASTACK_MONKEY_THROWABLE_DEPLOYKIT"
msgid "A waypoint. Or perhaps a well-timed obstacle..."
msgstr "Un punto de paso. O quizás un obstáculo oportuno..."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BOATRACE_SEASTACK_THROWABLE_DEPLOYKIT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BOATRACE_SEASTACK_THROWABLE_DEPLOYKIT"
msgid "A waypoint. Or perhaps a well-timed obstacle..."
msgstr "Un punto de paso. O quizás un obstáculo oportuno..."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BOATRACE_SPECTATOR_DRAGONLING
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BOATRACE_SPECTATOR_DRAGONLING"
msgid "Enjoying the show, pal?"
msgstr "¿Disfrutas del espectáculo, camarada?"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BOATRACE_START
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BOATRACE_START"
msgid "Can I just wait here for everyone to be done?"
msgstr "¿Puedo esperar aquí mientras todos terminan?"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BOATRACE_START_THROWABLE_DEPLOYKIT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BOATRACE_START_THROWABLE_DEPLOYKIT"
msgid "Wherever."
msgstr "Donde sea."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BOAT_ANCIENT_CONTAINER
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BOAT_ANCIENT_CONTAINER"
msgid "Now those apes won't get their grubby hands on my loot."
msgstr "Esos simios no pondrán sus asquerosas manos en mi botín."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BOAT_ANCIENT_ITEM
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BOAT_ANCIENT_ITEM"
msgid "It's not old, it's \"classic.\""
msgstr "No es antiguo, es «clásico»"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BOAT_BUMPER_CRABKING
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BOAT_BUMPER_CRABKING"
msgid "Looks heavy enough to sink us."
msgstr "Parece tan pesado como para hundirnos."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BOAT_BUMPER_CRABKING_KIT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BOAT_BUMPER_CRABKING_KIT"
msgid "Ugh. These menial tasks do not suit me."
msgstr "Agh. Estas tareas insignificantes no son dignas de mí."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BOAT_BUMPER_KELP
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BOAT_BUMPER_KELP"
msgid "I don't know if the smell is worth the protection it offers."
msgstr "No sé si la protección que ofrece compensa su olor."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BOAT_BUMPER_KELP_KIT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BOAT_BUMPER_KELP_KIT"
msgid "Ugh. These menial tasks do not suit me."
msgstr "Agh. Estas tareas insignificantes no son dignas de mí."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BOAT_BUMPER_SHELL
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BOAT_BUMPER_SHELL"
msgid "Seashells. The sturdiest building material known to man."
msgstr "Caracolas. El material de construcción más robusto que conoce el hombre."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BOAT_BUMPER_SHELL_KIT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BOAT_BUMPER_SHELL_KIT"
msgid "Ugh. These menial tasks do not suit me."
msgstr "Agh. Estas tareas insignificantes no son dignas de mí."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BOAT_BUMPER_YOTD
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BOAT_BUMPER_YOTD"
msgid "I always thought boats could use more teeth."
msgstr "Siempre pensé que a los barcos les vendría bien más potencia."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BOAT_BUMPER_YOTD_KIT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BOAT_BUMPER_YOTD_KIT"
msgid "Ugh. These menial tasks do not suit me."
msgstr "Agh. Estas tareas insignificantes no son dignas de mí."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BOAT_CANNON.AMMOLOADED
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BOAT_CANNON.AMMOLOADED"
msgid "Don't test me."
msgstr "No me provoques."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BOAT_CANNON.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BOAT_CANNON.GENERIC"
msgid "It's useless if it isn't loaded."
msgstr "Es inútil si no está cargado."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BOAT_CANNON.NOAMMO
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BOAT_CANNON.NOAMMO"
msgid "Tragically, I can't just summon cannonballs out of thin air."
msgstr "Por desgracia, no puedo invocar balas de cañón de la nada."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BOAT_CANNON_KIT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BOAT_CANNON_KIT"
msgid "Fine. I suppose the task of building it is left to me."
msgstr "Bien. Supongo que me toca construirlo a mí."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BOAT_GRASS_ITEM
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BOAT_GRASS_ITEM"
msgid "Am I building a boat or weaving a basket?"
msgstr "¿Estoy construyendo un bote o tejiendo una canasta?"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BOAT_ITEM
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BOAT_ITEM"
msgid "I've been reduced to a common shipyard laborer."
msgstr "Fui reducido a un mero peón de astillero."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BOAT_LEAK
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BOAT_LEAK"
msgid "Oh, great. Now we're going to drown."
msgstr "Ah, magnífico. Ahora vamos a ahogarnos."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BOAT_MAGNET.ACTIVATED
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BOAT_MAGNET.ACTIVATED"
msgid "Shockingly, it seems to work."
msgstr "Sorpresivamente, parece que funciona."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BOAT_MAGNET.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BOAT_MAGNET.GENERIC"
msgid "If it saves me from having to row myself, I'll give it a chance."
msgstr "Si me salva de hacer un escándalo, pues lo voy a intentar."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BOAT_MAGNET_BEACON.ACTIVATED
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BOAT_MAGNET_BEACON.ACTIVATED"
msgid "Somehow, it's working."
msgstr "Sorprendentemente, funciona."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BOAT_MAGNET_BEACON.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BOAT_MAGNET_BEACON.GENERIC"
msgid "This feels ridiculous."
msgstr "Esto me parece una ridiculez."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BOAT_MAGNET_KIT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BOAT_MAGNET_KIT"
msgid "Blast it Higgsbury, I can barely read these scribbled instructions."
msgstr "Maldición, Higgsbury. Apenas puedo leer estos garabatos con instrucciones."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BOAT_ROTATOR
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BOAT_ROTATOR"
msgid "If I hear one word of complaint, I'm turning this boat around."
msgstr "Si llego a oír una queja más, voy a dar vuelta este barco."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BOAT_ROTATOR_KIT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BOAT_ROTATOR_KIT"
msgid "Do I look like a common shipwright? Oh, very well..."
msgstr "¿Tengo pinta de constructor de barcos? Ay, bien..."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BODYPILLOW_BEEFALOWOOL
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BODYPILLOW_BEEFALOWOOL"
msgid "What is the thread count on this?"
msgstr "¿Cuántos hilos tiene esto?"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BODYPILLOW_KELP
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BODYPILLOW_KELP"
msgid "Looking at it is making me seasick."
msgstr "Ya con solo mirarla me da náuseas..."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BODYPILLOW_PETALS
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BODYPILLOW_PETALS"
msgid "Can you rightfully call a sack of potpourri a pillow?"
msgstr "¿Se puede llamar almohada a una bolsa de popurrí?"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BODYPILLOW_STEELWOOL
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BODYPILLOW_STEELWOOL"
msgid "It will either protect me or cut me to ribbons."
msgstr "Dos opciones: o me protege o me hace trizas."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BOMB_LUNARPLANT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BOMB_LUNARPLANT"
msgid "Someone's about to have a very bad day."
msgstr "Alguien está por tener un muy mal día."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BOMB_LUNARPLANT_WORMWOOD
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BOMB_LUNARPLANT_WORMWOOD"
msgid "Its power has been amplified..."
msgstr "Se intensificó su poder..."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BONESHARD
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BONESHARD"
msgid "Grind them bones."
msgstr "Muele los huesos."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BONESOUP
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BONESOUP"
msgid "It's hearty and filling."
msgstr "Es contundente y saciante."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BONESTEW
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BONESTEW"
msgid "Leave no scrap unused."
msgstr "Hay que aprovechar cada parte."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BOOKSTATION.BURNT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BOOKSTATION.BURNT"
msgid "History repeats itself."
msgstr "La historia se repite."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BOOKSTATION.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BOOKSTATION.GENERIC"
msgid "Rebuilding her library, is she?"
msgstr "Está reconstruyendo su biblioteca, ¿no?"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BOOK_BEES
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BOOK_BEES"
msgid "Perhaps now the bees will serve me."
msgstr "A lo mejor ahora las abejas me responderán a mí."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BOOK_BIRDS
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BOOK_BIRDS"
msgid "What a wasteful misuse of magic."
msgstr "Qué desmedido abuso de magia."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BOOK_BRIMSTONE
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BOOK_BRIMSTONE"
msgid "I've had enough fire and brimstone for one eternity."
msgstr "Ya he tenido suficiente fuego y azufre por una eternidad."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BOOK_ELEMENTAL
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BOOK_ELEMENTAL"
msgid "The words within evoke an unknown force."
msgstr "Las palabras que contiene evocan una fuerza desconocida."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BOOK_FIRE
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BOOK_FIRE"
msgid "Ah. Based on the librarian's own observations, I take it?"
msgstr "Oh. Según los comentarios de la bibliotecaria, ¿me lo llevo?"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BOOK_FISH
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BOOK_FISH"
msgid "I suppose I'll eat for a lifetime, then? Somehow I doubt it."
msgstr "Supongo que comeré toda mi vida, ¿entonces? Lo dudo."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BOOK_FOSSIL
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BOOK_FOSSIL"
msgid "I could stop a fiend in its tracks with this."
msgstr "Podría detener a un demonio con esto."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BOOK_GARDENING
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BOOK_GARDENING"
msgid "It's not wise to toy with forces beyond your comprehension."
msgstr "No es aconsejable jugar con fuerzas que están más allá de tu comprensión."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BOOK_HORTICULTURE
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BOOK_HORTICULTURE"
msgid "Hopefully this version is less wordy."
msgstr "Espero que esta versión sea menos verbosa."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BOOK_HORTICULTURE_UPGRADED
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BOOK_HORTICULTURE_UPGRADED"
msgid "Hopefully this will mean less time relegated to the garden."
msgstr "Espero que esto se traduzca en menos tiempo en el jardín."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BOOK_LIGHT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BOOK_LIGHT"
msgid "Taking some inspiration from the Codex, are we? I'm flattered."
msgstr "¿Te inspiraste en el Códice, cierto? Me halagas."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BOOK_LIGHT_UPGRADED
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BOOK_LIGHT_UPGRADED"
msgid "Now she's just showing off."
msgstr "Ahora solo está presumiendo."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BOOK_MOON
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BOOK_MOON"
msgid "We've come this far, no point in stopping our meddling now."
msgstr "Hemos llegado tan lejos, no tiene sentido dejar de entrometernos ahora."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BOOK_RAIN
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BOOK_RAIN"
msgid "What's a ritual without a little showmanship? Surely a prop or two?"
msgstr "¿Un ritual es un ritual sin la teatralidad? ¿Uno o dos accesorios?"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BOOK_RESEARCH_STATION
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BOOK_RESEARCH_STATION"
msgid "Hmph. It doesn't hold a candle to the secret knowledge I possess."
msgstr "Mmm. No se compara ni un poco con el conocimiento secreto que yo poseo."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BOOK_SILVICULTURE
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BOOK_SILVICULTURE"
msgid "It's not wise to toy with forces beyond your comprehension."
msgstr "No es aconsejable jugar con fuerzas que están más allá de tu comprensión."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BOOK_SLEEP
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BOOK_SLEEP"
msgid "I haven't had a real sleep in... ages."
msgstr "No duermo como debería hace... siglos."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BOOK_TEMPERATURE
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BOOK_TEMPERATURE"
msgid "I'm always cool and collected."
msgstr "Siempre fresco y tranquilo."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BOOK_TENTACLES
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BOOK_TENTACLES"
msgid "What horrors shall be summoned from the depths?"
msgstr "¿Qué horrores saldrán de las profundidades?"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BOOK_WEB
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BOOK_WEB"
msgid "As if spiders are what you should be worried about here."
msgstr "Ojalá solo fueran las arañas de lo que deberíamos preocuparnos aquí."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BOOMERANG
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BOOMERANG"
msgid "Beats getting your hands dirty."
msgstr "Es mejor que ensuciarse las manos."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BOOTLEG
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BOOTLEG"
msgid "Best not to think about where it's been."
msgstr "Mejor no pensar en dónde ha estado."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BROKEN_FORGEDITEM
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BROKEN_FORGEDITEM"
msgid "It's of no use to me like this."
msgstr "Así no me sirve de nada."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BRUSH
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BRUSH"
msgid "It's like showing affection, without actually touching it."
msgstr "Es como mostrar afecto, sin realmente tocarlo."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BUGNET
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BUGNET"
msgid "Good for capturing defenseless insects."
msgstr "Útil para capturar insectos indefensos."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BULLKELP_PLANT.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BULLKELP_PLANT.GENERIC"
msgid "Disgusting. I'll have someone else pick it."
msgstr "Qué asco. Mandaré a otro a recogerla."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BULLKELP_PLANT.PICKED
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BULLKELP_PLANT.PICKED"
msgid "We already took the food parts."
msgstr "Ya tomamos lo que sirve de alimento."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BULLKELP_ROOT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BULLKELP_ROOT"
msgid "For keeping the peasantry in line."
msgstr "Para mantener bajo control a los campesinos."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BUNDLE
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BUNDLE"
msgid "Nice and snug."
msgstr "Cómodo y acogedor."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BUNDLEWRAP
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BUNDLEWRAP"
msgid "I guess we could wrap a few things up."
msgstr "Supongo que podría envolver algunas cosas."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BUNNYMAN
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BUNNYMAN"
msgid "It reminds me of my old act."
msgstr "Me recuerda a mí antes."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BUNNYSTEW
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BUNNYSTEW"
msgid "Good until the last hop."
msgstr "Excelente hasta el último salto."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BURNT_MARSH_BUSH
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BURNT_MARSH_BUSH"
msgid "Utterly destroyed."
msgstr "Completamente destruido."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BUSHHAT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BUSHHAT"
msgid "There's room in there for me."
msgstr "Hay espacio ahí para mí."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BUTTER
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BUTTER"
msgid "Some puns are irresistible."
msgstr "Algunos juegos de palabras son irresistibles."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BUTTERFLY.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BUTTERFLY.GENERIC"
msgid "It's a flying flower."
msgstr "Es una flor voladora."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BUTTERFLY.HELD
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BUTTERFLY.HELD"
msgid "It would be a shame if someone ripped the wings off of it."
msgstr "Sería una pena si alguien le arrancara las alas."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BUTTERFLYMUFFIN
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BUTTERFLYMUFFIN"
msgid "That should stop its incessant flapping."
msgstr "Eso debería detener su incesante aleteo."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BUTTERFLYWINGS
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BUTTERFLYWINGS"
msgid "Ha ha ha. I got him!"
msgstr "Ja, ja, ja. ¡La atrapé!"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BUZZARD
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BUZZARD"
msgid "Carrion connoisseur."
msgstr "Conocedor de la carroña."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CABBAGEROLLS
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CABBAGEROLLS"
msgid "Meat rolled in cabbage. How exciting."
msgstr "Carne envuelta en col. Apasionante."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CACTUS.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CACTUS.GENERIC"
msgid "Puffer plant."
msgstr "Planta hinchada."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CACTUS.PICKED
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CACTUS.PICKED"
msgid "Cactus? More like flat-tus!"
msgstr "¿Cactus? ¡Más bien planitus!"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CACTUS_FLOWER
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CACTUS_FLOWER"
msgid "This part of the cactus is always nice."
msgstr "Esta parte del cactus es siempre bonita."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CACTUS_MEAT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CACTUS_MEAT"
msgid "It would be unwise to put that in my mouth."
msgstr "Sería imprudente metérmelo en la boca."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CACTUS_MEAT_COOKED
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CACTUS_MEAT_COOKED"
msgid "Cactus comestible."
msgstr "Cactus comestible."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CALIFORNIAROLL
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CALIFORNIAROLL"
msgid "I don't think I truly appreciated those sunny shores."
msgstr "Creo que no aprecié de verdad estas costas soleadas."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CAMPFIRE.EMBERS
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CAMPFIRE.EMBERS"
msgid "I'm going to lose it."
msgstr "Voy a perderlo."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CAMPFIRE.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CAMPFIRE.GENERIC"
msgid "How comforting."
msgstr "Qué reconfortante."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CAMPFIRE.HIGH
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CAMPFIRE.HIGH"
msgid "That will keep Charlie away for now."
msgstr "Eso mantendrá a Charlie lejos por ahora."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CAMPFIRE.LOW
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CAMPFIRE.LOW"
msgid "It needs fuel."
msgstr "Necesita combustible."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CAMPFIRE.NORMAL
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CAMPFIRE.NORMAL"
msgid "Fiery."
msgstr "Ardiente."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CAMPFIRE.OUT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CAMPFIRE.OUT"
msgid "That's not coming back."
msgstr "No regresará."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CANARY.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CANARY.GENERIC"
msgid "How do these things keep getting into my world?"
msgstr "¿Cómo siguen apareciendo estos bichos en mi mundo?"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CANARY.HELD
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CANARY.HELD"
msgid "Bait."
msgstr "Carnada."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CANARY_POISONED
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CANARY_POISONED"
msgid "You look atrocious."
msgstr "Tienes una pinta atroz."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CANDYBAG
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CANDYBAG"
msgid "That's our sugar-sack."
msgstr "La bolsa de azúcar."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CANE
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CANE"
msgid "It has pictures of fast things carved into it."
msgstr "Tiene imágenes de cosas talladas en él."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CANNONBALL_ROCK_ITEM
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CANNONBALL_ROCK_ITEM"
msgid "That looks heavy. Someone should load it into the cannon."
msgstr "Se ve pesada. Alguien debería cargarla en el cañón."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CARNIVALCANNON.COOLDOWN
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CARNIVALCANNON.COOLDOWN"
msgid "That's more than enough cheer for one day."
msgstr "Suficiente alegría por hoy."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CARNIVALCANNON.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CARNIVALCANNON.GENERIC"
msgid "This place is turning into a circus."
msgstr "Este lugar parece cada vez más un circo."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CARNIVALCANNON_KIT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CARNIVALCANNON_KIT"
msgid "Must I do everything around here?"
msgstr "¿Lo tengo que hacer todo yo?"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CARNIVALDECOR_BANNER
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CARNIVALDECOR_BANNER"
msgid "Oh good. Wouldn't want anyone thinking we've got taste around here, would we?"
msgstr "Ah, bien. No quiero que nadie piense que aquí tenemos buen gusto, ¿eh?"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CARNIVALDECOR_BANNER_KIT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CARNIVALDECOR_BANNER_KIT"
msgid "There's no end to the work around here, it seems."
msgstr "Parece que el trabajo aquí no tiene fin."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CARNIVALDECOR_EGGRIDE
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CARNIVALDECOR_EGGRIDE"
msgid "Wonderful. It's even tackier than I imagined it would be."
msgstr "Espléndido. Más vulgar de lo que me imaginé."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CARNIVALDECOR_EGGRIDE_KIT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CARNIVALDECOR_EGGRIDE_KIT"
msgid "There's no end to the work around here, it seems."
msgstr "Parece que el trabajo aquí no tiene fin."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CARNIVALDECOR_FIGURE.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CARNIVALDECOR_FIGURE.GENERIC"
msgid "One more thing to clutter the ground."
msgstr "Una cosa más para acumular."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CARNIVALDECOR_FIGURE.RARE
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CARNIVALDECOR_FIGURE.RARE"
msgid "What exactly is so fantastic about it?"
msgstr "¿Qué tiene de fantástico?"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CARNIVALDECOR_FIGURE.UNCOMMON
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CARNIVALDECOR_FIGURE.UNCOMMON"
msgid "Measly things. In my time I made proper statues..."
msgstr "Cosa miserable. En mi época, hacía estatuas como la gente..."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CARNIVALDECOR_FIGURE_KIT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CARNIVALDECOR_FIGURE_KIT"
msgid "Curiosity always seems to get the better of me."
msgstr "La curiosidad saca lo mejor de mí."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CARNIVALDECOR_FIGURE_KIT_SEASON2
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CARNIVALDECOR_FIGURE_KIT_SEASON2"
msgid "Curiosity always seems to get the better of me."
msgstr "La curiosidad saca lo mejor de mí."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CARNIVALDECOR_LAMP
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CARNIVALDECOR_LAMP"
msgid "A paltry light source. But it will do."
msgstr "Una fuente de luz mediocre, pero servirá."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CARNIVALDECOR_LAMP_KIT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CARNIVALDECOR_LAMP_KIT"
msgid "There's no end to the work around here, it seems."
msgstr "Parece que el trabajo aquí no tiene fin."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CARNIVALDECOR_PLANT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CARNIVALDECOR_PLANT"
msgid "At least it's small and somewhat manageable."
msgstr "Al menos es pequeña y fácil de cuidar."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CARNIVALDECOR_PLANT_KIT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CARNIVALDECOR_PLANT_KIT"
msgid "There's no end to the work around here, it seems."
msgstr "Parece que el trabajo aquí no tiene fin."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CARNIVALFOOD_CORNTEA
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CARNIVALFOOD_CORNTEA"
msgid "Surely you're not serious?"
msgstr "¿No hablas en serio, cierto?"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CARNIVALGAME_FEEDCHICKS_FOOD
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CARNIVALGAME_FEEDCHICKS_FOOD"
msgid "These props leave something to be desired."
msgstr "Este decorado deja mucho que desear."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CARNIVALGAME_FEEDCHICKS_KIT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CARNIVALGAME_FEEDCHICKS_KIT"
msgid "I suppose I'm expected to set this up myself?"
msgstr "¿Se supone que debo armarlo yo mismo?"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CARNIVALGAME_FEEDCHICKS_NEST
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CARNIVALGAME_FEEDCHICKS_NEST"
msgid "What are they hiding down there..."
msgstr "¿De qué se esconden?"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CARNIVALGAME_FEEDCHICKS_STATION.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CARNIVALGAME_FEEDCHICKS_STATION.GENERIC"
msgid "It requires payment."
msgstr "Requiere un pago."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CARNIVALGAME_FEEDCHICKS_STATION.PLAYING
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CARNIVALGAME_FEEDCHICKS_STATION.PLAYING"
msgid "I'll play it, but I won't enjoy it."
msgstr "Lo jugaré, pero no lo disfrutaré."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CARNIVALGAME_HERDING_CHICK
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CARNIVALGAME_HERDING_CHICK"
msgid "Get back here, you blasted contraption!"
msgstr "¡Vuelve aquí, maldito artilugio!"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CARNIVALGAME_HERDING_KIT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CARNIVALGAME_HERDING_KIT"
msgid "I suppose I'm expected to set this up myself?"
msgstr "¿Se supone que debo armarlo yo mismo?"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CARNIVALGAME_HERDING_STATION.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CARNIVALGAME_HERDING_STATION.GENERIC"
msgid "It requires payment."
msgstr "Requiere un pago."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CARNIVALGAME_HERDING_STATION.PLAYING
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CARNIVALGAME_HERDING_STATION.PLAYING"
msgid "Such pointless frivolity..."
msgstr "Una frivolidad inútil."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CARNIVALGAME_MEMORY_CARD.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CARNIVALGAME_MEMORY_CARD.GENERIC"
msgid "What are they hiding down there..."
msgstr "¿De qué se esconden?"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CARNIVALGAME_MEMORY_CARD.PLAYING
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CARNIVALGAME_MEMORY_CARD.PLAYING"
msgid "I'm almost certain it was this one..."
msgstr "Estoy casi seguro de que era esta..."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CARNIVALGAME_MEMORY_KIT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CARNIVALGAME_MEMORY_KIT"
msgid "I suppose I'm expected to set this up myself?"
msgstr "¿Se supone que debo armarlo yo mismo?"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CARNIVALGAME_MEMORY_STATION.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CARNIVALGAME_MEMORY_STATION.GENERIC"
msgid "It requires payment."
msgstr "Requiere un pago."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CARNIVALGAME_MEMORY_STATION.PLAYING
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CARNIVALGAME_MEMORY_STATION.PLAYING"
msgid "A simple matter of memorization. I'll show you just how easy it is."
msgstr "Es cuestión de memorizarlo. Mira qué fácil."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CARNIVALGAME_PUCKDROP_KIT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CARNIVALGAME_PUCKDROP_KIT"
msgid "I suppose I'm expected to set this up myself?"
msgstr "¿Se supone que debo armarlo yo mismo?"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CARNIVALGAME_PUCKDROP_STATION.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CARNIVALGAME_PUCKDROP_STATION.GENERIC"
msgid "It requires payment."
msgstr "Requiere un pago."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CARNIVALGAME_PUCKDROP_STATION.PLAYING
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CARNIVALGAME_PUCKDROP_STATION.PLAYING"
msgid "I imagine some people might find this amusing."
msgstr "Supongo que a algunas personas le divierte esto."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CARNIVALGAME_SHOOTING_BUTTON.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CARNIVALGAME_SHOOTING_BUTTON.GENERIC"
msgid "It requires payment."
msgstr "Requiere un pago."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CARNIVALGAME_SHOOTING_BUTTON.PLAYING
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CARNIVALGAME_SHOOTING_BUTTON.PLAYING"
msgid "Well, I suppose a bit of destruction might be relaxing."
msgstr "Bueno, supongo que un poco de destrucción me va a relajar."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CARNIVALGAME_SHOOTING_KIT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CARNIVALGAME_SHOOTING_KIT"
msgid "I suppose I'm expected to set this up myself?"
msgstr "¿Se supone que debo armarlo yo mismo?"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CARNIVALGAME_SHOOTING_STATION.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CARNIVALGAME_SHOOTING_STATION.GENERIC"
msgid "It requires payment."
msgstr "Requiere un pago."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CARNIVALGAME_SHOOTING_STATION.PLAYING
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CARNIVALGAME_SHOOTING_STATION.PLAYING"
msgid "Another mindless diversion."
msgstr "Una distracción absurda."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CARNIVALGAME_SHOOTING_TARGET.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CARNIVALGAME_SHOOTING_TARGET.GENERIC"
msgid "What are they hiding down there..."
msgstr "¿De qué se esconden?"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CARNIVALGAME_SHOOTING_TARGET.PLAYING
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CARNIVALGAME_SHOOTING_TARGET.PLAYING"
msgid "I'm certain it's rigged."
msgstr "Estoy seguro de que está arreglado."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CARNIVALGAME_WHEELSPIN_KIT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CARNIVALGAME_WHEELSPIN_KIT"
msgid "I suppose I'm expected to set this up myself?"
msgstr "¿Se supone que debo armarlo yo mismo?"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CARNIVALGAME_WHEELSPIN_STATION.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CARNIVALGAME_WHEELSPIN_STATION.GENERIC"
msgid "It requires payment."
msgstr "Requiere un pago."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CARNIVALGAME_WHEELSPIN_STATION.PLAYING
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CARNIVALGAME_WHEELSPIN_STATION.PLAYING"
msgid "A meaningless victory."
msgstr "Una victoria insignificante."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CARNIVAL_BALL
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CARNIVAL_BALL"
msgid "How novel."
msgstr "Innovador."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CARNIVAL_CROWKID
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CARNIVAL_CROWKID"
msgid "We're being overrun."
msgstr "Nos están superando."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CARNIVAL_GAMETOKEN
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CARNIVAL_GAMETOKEN"
msgid "Fine. I'll play your silly little games."
msgstr "Bien. Jugaré a tus estúpidos juegos."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CARNIVAL_HOST
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CARNIVAL_HOST"
msgid "Just look at him, strutting around like he owns the place."
msgstr "Mira cómo se pavonea, camina como si fuera el dueño de todo."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CARNIVAL_PLAZA.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CARNIVAL_PLAZA.GENERIC"
msgid "It's about as festive as I like it. Which is not at all."
msgstr "Es tan festivo como me gusta. O sea, cero festivo."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CARNIVAL_PLAZA.LEVEL_2
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CARNIVAL_PLAZA.LEVEL_2"
msgid "The birds seem to enjoy it. Some creatures just lack any taste."
msgstr "Parece que los pájaros lo disfrutan. Algunas criaturas no tienen criterio."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CARNIVAL_PLAZA.LEVEL_3
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CARNIVAL_PLAZA.LEVEL_3"
msgid "I think that's about as much clutter as one could possibly throw on a tree."
msgstr "Creo que este es el límite que puedes colgarle a un árbol."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CARNIVAL_PLAZA_KIT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CARNIVAL_PLAZA_KIT"
msgid "It's so... ugh... whimsical."
msgstr "Es tan... extravagante."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CARNIVAL_PRIZEBOOTH.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CARNIVAL_PRIZEBOOTH.GENERIC"
msgid "I somehow doubt they'd have anything I want."
msgstr "Dudo que tengan algo que me interese."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CARNIVAL_PRIZEBOOTH_KIT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CARNIVAL_PRIZEBOOTH_KIT"
msgid "Must I do everything around here?"
msgstr "¿Lo tengo que hacer todo yo?"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CARNIVAL_PRIZETICKET.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CARNIVAL_PRIZETICKET.GENERIC"
msgid "A prize ticket. How exciting."
msgstr "Un billete ganador. Emocionante."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CARNIVAL_PRIZETICKET.GENERIC_LARGESTACK
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CARNIVAL_PRIZETICKET.GENERIC_LARGESTACK"
msgid "Oh good. Now I can get some useless trinket from the Prize Booth."
msgstr "Ah, genial. Ahora podré obtener una chuchería del puesto de premios."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CARNIVAL_PRIZETICKET.GENERIC_SMALLSTACK
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CARNIVAL_PRIZETICKET.GENERIC_SMALLSTACK"
msgid "I don't know why I'm dedicating so much time to this."
msgstr "No sé por qué le estoy dedicando tanto tiempo a esto."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CARNIVAL_SEEDPACKET
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CARNIVAL_SEEDPACKET"
msgid "About as pleasant as you'd expect."
msgstr "Tan placentero como esperarías."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CARNIVAL_VEST_A
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CARNIVAL_VEST_A"
msgid "Far too jaunty for my taste."
msgstr "Demasiado alegre para mi gusto."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CARNIVAL_VEST_B
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CARNIVAL_VEST_B"
msgid "At least it will give me some respite from this wretched heat."
msgstr "Al menos me aliviará un poco de este maldito calor."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CARNIVAL_VEST_C
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CARNIVAL_VEST_C"
msgid "It affords some protection from the sun's burning rays."
msgstr "Te otorga un poco de protección de los rayos abrasadores del sol."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CARPENTRY_BLADE_MOONGLASS
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CARPENTRY_BLADE_MOONGLASS"
msgid "Fancy... for a laborer's tool."
msgstr "Es elegante... para ser una herramienta de trabajadores."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CARPENTRY_STATION.BURNT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CARPENTRY_STATION.BURNT"
msgid "Too bad."
msgstr "Qué lástima."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CARPENTRY_STATION.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CARPENTRY_STATION.GENERIC"
msgid "I never cared for woodworking. The sawdust gets everywhere."
msgstr "Nunca me interesó la carpintería. El aserrín vuela por todos lados."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CARRAT.DEAD
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CARRAT.DEAD"
msgid "Disgusting."
msgstr "Qué asco."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CARRAT.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CARRAT.GENERIC"
msgid "That carrot is revolting!"
msgstr "¡Esa zanahoria es repugnante!"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CARRAT.HELD
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CARRAT.HELD"
msgid "You thought you could fool me?"
msgstr "¿Pensabas que podías engañarme?"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CARRAT.SLEEPING
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CARRAT.SLEEPING"
msgid "I'm sure it is diseased."
msgstr "Seguro tiene alguna enfermedad."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CARRAT_GHOSTRACER
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CARRAT_GHOSTRACER"
msgid "Starting to feel left out?"
msgstr "¿Sientes que te excluyen?"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CARROT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CARROT"
msgid "I'm not a fan of vegetables."
msgstr "No me gustan las verduras."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CARROT_COOKED
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CARROT_COOKED"
msgid "A little more refined, at least."
msgstr "Un poco más refinada, por lo menos."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CARROT_OVERSIZED
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CARROT_OVERSIZED"
msgid "A ludicrously oversized carrot."
msgstr "Una zanahoria ridículamente enorme."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CARROT_PLANTED
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CARROT_PLANTED"
msgid "How mundane."
msgstr "Qué mundano."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CARROT_SEEDS
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CARROT_SEEDS"
msgid "Such labor is beneath me."
msgstr "Este trabajo es indigno para mí."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CARTOGRAPHYDESK.BURNING
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CARTOGRAPHYDESK.BURNING"
msgid "Such directionless destruction."
msgstr "Qué destrucción sin sentido."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CARTOGRAPHYDESK.BURNT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CARTOGRAPHYDESK.BURNT"
msgid "Useless."
msgstr "Inútil."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CARTOGRAPHYDESK.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CARTOGRAPHYDESK.GENERIC"
msgid "Mapmaking is a soothing pastime. Methodical."
msgstr "La cartografía es un pasatiempo relajante. Metódico."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CATCOON
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CATCOON"
msgid "Catty vermin."
msgstr "Alimaña felina."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CATCOONDEN.EMPTY
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CATCOONDEN.EMPTY"
msgid "Well, I guess that's that."
msgstr "Bueno, creo que eso es todo."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CATCOONDEN.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CATCOONDEN.GENERIC"
msgid "Vermin housing."
msgstr "Vivienda de alimañas."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CATCOONHAT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CATCOONHAT"
msgid "Dead head."
msgstr "Cabeza muerta."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CATTOY_MOUSE
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CATTOY_MOUSE"
msgid "The classic game of catcoon and mechanical mouse."
msgstr "El clásico juego del gatache y el ratón mecánico."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CAVEIN_BOULDER.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CAVEIN_BOULDER.GENERIC"
msgid "Well it's not going to move itself."
msgstr "Bueno, no se va a mover sola."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CAVEIN_BOULDER.RAISED
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CAVEIN_BOULDER.RAISED"
msgid "We must deal with the others first."
msgstr "Primero debemos ocuparnos de las demás."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CAVE_BANANA
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CAVE_BANANA"
msgid "Ashes in one's mouth."
msgstr "Cenizas en la boca."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CAVE_BANANA_BURNT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CAVE_BANANA_BURNT"
msgid "I refuse to be held responsible for that."
msgstr "Me niego a ser responsable de eso."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CAVE_BANANA_COOKED
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CAVE_BANANA_COOKED"
msgid "Even worse than raw."
msgstr "Aún peor que crudo."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CAVE_BANANA_TREE
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CAVE_BANANA_TREE"
msgid "It looks like a banana, but I'm not buying it."
msgstr "Parece una banana, pero no me engaña."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CAVE_ENTRANCE
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CAVE_ENTRANCE"
msgid "I plugged it a long time ago."
msgstr "La tapé hace mucho tiempo."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CAVE_ENTRANCE_OPEN.FULL
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CAVE_ENTRANCE_OPEN.FULL"
msgid "When it's less claustrophobic, perhaps."
msgstr "Cuando sea menos claustrofóbico, tal vez."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CAVE_ENTRANCE_OPEN.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CAVE_ENTRANCE_OPEN.GENERIC"
msgid "That was not a good idea!"
msgstr "¡Esa no fue una buena idea!"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CAVE_ENTRANCE_OPEN.OPEN
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CAVE_ENTRANCE_OPEN.OPEN"
msgid "Off to plunder the depths."
msgstr "A saquear las profundidades."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CAVE_ENTRANCE_RUINS
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CAVE_ENTRANCE_RUINS"
msgid "Probably shouldn't venture any deeper."
msgstr "Probablemente no debería avanzar más."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CAVE_EXIT.FULL
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CAVE_EXIT.FULL"
msgid "I'd rather stay here than mingle with the crowds above."
msgstr "Prefiero quedarme aquí que mezclarme con la muchedumbre de arriba."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CAVE_EXIT.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CAVE_EXIT.GENERIC"
msgid "Get me out of here!"
msgstr "¡Sáquenme de aquí!"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CAVE_EXIT.OPEN
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CAVE_EXIT.OPEN"
msgid "Onward to the next thing."
msgstr "Hacia la próxima aventura."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CAVE_FERN
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CAVE_FERN"
msgid "I'd like to step on it."
msgstr "Me gustaría entrar."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CEVICHE
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CEVICHE"
msgid "A delightful, cultured dish."
msgstr "Un plato delicioso y culto."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CHARCOAL
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CHARCOAL"
msgid "Nothing will steal my carbon!"
msgstr "¡Nada robará mi carbón!"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CHARLIERESIDUE
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CHARLIERESIDUE"
msgid "only_used_by_winona"
msgstr "only_used_by_winona"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CHARLIEROSE
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CHARLIEROSE"
msgid "only_used_by_winona"
msgstr "only_used_by_winona"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CHARLIE_HAND
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CHARLIE_HAND"
msgid "I'll... see to it."
msgstr "Yo... me encargo."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CHARLIE_HECKLER
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CHARLIE_HECKLER"
msgid "Tough crowd."
msgstr "Público difícil."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CHARLIE_LECTURN
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CHARLIE_LECTURN"
msgid "Misdirection, the oldest trick in the book. Well played, Charlie."
msgstr "Una distracción. El truco más viejo del libro. Buena jugada, Charlie."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CHARLIE_NPC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CHARLIE_NPC"
msgid "Charlie..."
msgstr "Charlie..."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CHARLIE_STAGE_POST
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CHARLIE_STAGE_POST"
msgid "Just like the old days."
msgstr "Como en los viejos tiempos."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CHESSJUNK1
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CHESSJUNK1"
msgid "There's a reason I never finished that."
msgstr "Hay una razón por la que nunca terminé eso."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CHESSJUNK2
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CHESSJUNK2"
msgid "That one was a jerk."
msgstr "Ese era un idiota."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CHESSJUNK3
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CHESSJUNK3"
msgid "Didn't like that one's face."
msgstr "No me gustaba su cara."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CHESSPIECE_ANCHOR
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CHESSPIECE_ANCHOR"
msgid "How kitsch."
msgstr "Qué kitsch."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CHESSPIECE_ANTLION
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CHESSPIECE_ANTLION"
msgid "Is there a sinkhole I can bury this in?"
msgstr "¿Habrá un pozo donde puedo enterrar esto?"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CHESSPIECE_BEARGER
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CHESSPIECE_BEARGER"
msgid "A brute."
msgstr "Un bruto."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CHESSPIECE_BEARGER_MUTATED
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CHESSPIECE_BEARGER_MUTATED"
msgid "It'll scare away anyone with good taste."
msgstr "Ahuyentará a cualquiera que tenga buen gusto."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CHESSPIECE_BEEFALO
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CHESSPIECE_BEEFALO"
msgid "At least this version doesn't shed all over my poor suit."
msgstr "Por lo menos esta versión no babea todo mi traje."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CHESSPIECE_BEEQUEEN
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CHESSPIECE_BEEQUEEN"
msgid "Does she really need a statue?"
msgstr "¿En serio necesita una estatua?"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CHESSPIECE_BISHOP.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CHESSPIECE_BISHOP.GENERIC"
msgid "Could use a few more mechanical bits in my opinion."
msgstr "Le harían falta algunas piezas mecánicas más, en mi opinión."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CHESSPIECE_BISHOP.STRUGGLE
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CHESSPIECE_BISHOP.STRUGGLE"
msgid "The pieces are in motion!"
msgstr "¡Las piezas se están moviendo!"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CHESSPIECE_BUTTERFLY
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CHESSPIECE_BUTTERFLY"
msgid "Rather elegant, I'd say."
msgstr "Bastante elegante, diría yo."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CHESSPIECE_CARRAT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CHESSPIECE_CARRAT"
msgid "If only I had a mantle to set it on."
msgstr "Si tuviera una repisa para poner esto encima..."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CHESSPIECE_CATCOON
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CHESSPIECE_CATCOON"
msgid "This animal commands respect through violence."
msgstr "Este animal se impone mediante la violencia."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CHESSPIECE_CLAYHOUND
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CHESSPIECE_CLAYHOUND"
msgid "It's quite fetching."
msgstr "Es bastante irresistible."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CHESSPIECE_CLAYWARG
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CHESSPIECE_CLAYWARG"
msgid "What a gruesome maw."
msgstr "Qué fauces tan horribles."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CHESSPIECE_CRABKING
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CHESSPIECE_CRABKING"
msgid "I am not that crabby!"
msgstr "¡No me encantan los cangrejos!"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CHESSPIECE_DAYWALKER
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CHESSPIECE_DAYWALKER"
msgid "Seems like anyone can get a statue these days."
msgstr "Parece que cualquiera puede tener una estatua hoy en día."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CHESSPIECE_DAYWALKER2
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CHESSPIECE_DAYWALKER2"
msgid "Ah yes, the rummaging hog."
msgstr ""

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CHESSPIECE_DEERCLOPS
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CHESSPIECE_DEERCLOPS"
msgid "I don't like winters."
msgstr "No me gusta el invierno."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CHESSPIECE_DEERCLOPS_MUTATED
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CHESSPIECE_DEERCLOPS_MUTATED"
msgid "I take great offense to anyone trying to improve on my designs."
msgstr "Me ofende mucho que alguien quiera intentar mejorar mis diseños."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CHESSPIECE_DRAGONFLY
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CHESSPIECE_DRAGONFLY"
msgid "It never stood a chance."
msgstr "Nunca tuvo ninguna posibilidad."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CHESSPIECE_EYEOFTERROR
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CHESSPIECE_EYEOFTERROR"
msgid "An eye could never best a master of illusion such as I."
msgstr "Un ojo jamás podrá dominar el arte de la ilusión como yo."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CHESSPIECE_FORMAL
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CHESSPIECE_FORMAL"
msgid "What a well-dressed figure!"
msgstr "¡Qué figura tan bien vestida!"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CHESSPIECE_GUARDIANPHASE3
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CHESSPIECE_GUARDIANPHASE3"
msgid "How could I not have seen..."
msgstr "¿Cómo no pude haber visto...?"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CHESSPIECE_HORNUCOPIA
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CHESSPIECE_HORNUCOPIA"
msgid "This seems cruel."
msgstr "Parece cruel."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CHESSPIECE_KITCOON
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CHESSPIECE_KITCOON"
msgid "This is a rather precarious design."
msgstr "Un diseño bastante mediocre."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CHESSPIECE_KLAUS
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CHESSPIECE_KLAUS"
msgid "Why bother?"
msgstr "¿Para qué molestarse?"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CHESSPIECE_KNIGHT.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CHESSPIECE_KNIGHT.GENERIC"
msgid "A dreadful lack of accordions."
msgstr "Qué pena que le falte el lomo."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CHESSPIECE_KNIGHT.STRUGGLE
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CHESSPIECE_KNIGHT.STRUGGLE"
msgid "And I thought chivalry was dead!"
msgstr "¡Creí que la caballería ya no existía!"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CHESSPIECE_MALBATROSS
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CHESSPIECE_MALBATROSS"
msgid "Such a fowl-tempered bird."
msgstr "Más que un ave, es un pajarraco."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CHESSPIECE_MANRABBIT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CHESSPIECE_MANRABBIT"
msgid "Who put this ridiculous thing here?"
msgstr "¿Quién puso esta ridiculez aquí?"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CHESSPIECE_MINOTAUR
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CHESSPIECE_MINOTAUR"
msgid "Always keep things close to the chest, right pal?"
msgstr "Siempre hay que estar cerca del cofre, ¿no crees?"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CHESSPIECE_MOON
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CHESSPIECE_MOON"
msgid "I'm fairly partial to this one."
msgstr "En parte simpatizo con esta."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CHESSPIECE_MOOSEGOOSE.1
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CHESSPIECE_MOOSEGOOSE.1"
msgid "What an imbecilic expression."
msgstr "Qué expresión tan imbécil."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CHESSPIECE_MUSE
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CHESSPIECE_MUSE"
msgid "Must everything be about my shortcomings?"
msgstr "¿Tendrá todo que ver con mis defectos?"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CHESSPIECE_PAWN
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CHESSPIECE_PAWN"
msgid "I have no idea what that is."
msgstr "No tengo ni idea de lo que es esto."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CHESSPIECE_PIPE
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CHESSPIECE_PIPE"
msgid "Ceci n'est pas une pipe. Pity."
msgstr "Ceci n'est pas une pipe. Lástima."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CHESSPIECE_ROOK.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CHESSPIECE_ROOK.GENERIC"
msgid "It's nice, but where's the rust? The exhaust pipes?"
msgstr "Me gusta, pero ¿dónde está la oxidación? ¿Los tubos de escape?"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CHESSPIECE_ROOK.STRUGGLE
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CHESSPIECE_ROOK.STRUGGLE"
msgid "The pieces are in motion!"
msgstr "¡Las piezas se están moviendo!"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CHESSPIECE_SHARKBOI
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CHESSPIECE_SHARKBOI"
msgid "Bottom feeding lone shark."
msgstr "Tiburón solitario del fondo."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CHESSPIECE_STALKER
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CHESSPIECE_STALKER"
msgid "I do like this one."
msgstr "Esta me gusta."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CHESSPIECE_TOADSTOOL
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CHESSPIECE_TOADSTOOL"
msgid "At least the statue doesn't smell as bad as the original."
msgstr "Al menos la estatua no huele como el original."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CHESSPIECE_TWINSOFTERROR
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CHESSPIECE_TWINSOFTERROR"
msgid "The most troublesome pair I've ever seen."
msgstr "La pareja más problemática que he conocido."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CHESSPIECE_WARG_MUTATED
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CHESSPIECE_WARG_MUTATED"
msgid "It was a bad dog."
msgstr "Fue un perro malo."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CHESSPIECE_WORMBOSS
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CHESSPIECE_WORMBOSS"
msgid "I can still smell it's breath."
msgstr ""

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CHESSPIECE_YOTD
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CHESSPIECE_YOTD"
msgid "Always nice to be reminded of my victories."
msgstr "Siempre se siente bien recordar mis victorias."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CHESTER
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CHESTER"
msgid "Annoying little monster. Has his uses, though."
msgstr "Pequeño monstruo fastidioso. Aunque es útil."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CHESTER_EYEBONE.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CHESTER_EYEBONE.GENERIC"
msgid "Stop looking at me!"
msgstr "¡Deja de mirarme!"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CHESTER_EYEBONE.WAITING
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CHESTER_EYEBONE.WAITING"
msgid "What is it waiting for?"
msgstr "¿Qué está esperando?"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CHESTUPGRADE_STACKSIZE
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CHESTUPGRADE_STACKSIZE"
msgid "Hmph. Dress it up with wires and gears, but I know magic when I see it."
msgstr "Mm. Puedes adornarlo con cables y engranajes, pero reconozco la magia dentro."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CHEST_MIMIC_REVEALED
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CHEST_MIMIC_REVEALED"
msgid "It's a trap!"
msgstr "¡Es una trampa!"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CHUM
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CHUM"
msgid "Say, that chum doesn't look so good."
msgstr "Huy, ese cebo tiene mal aspecto."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CLAYHOUND.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CLAYHOUND.GENERIC"
msgid "I was wise to be suspicious."
msgstr "Tuve razón al sospechar."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CLAYHOUND.STATUE
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CLAYHOUND.STATUE"
msgid "I don't trust it."
msgstr "No me da confianza."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CLAYWARG.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CLAYWARG.GENERIC"
msgid "This earthen beast's all fired up."
msgstr "Esta bestia terrenal está encendida."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CLAYWARG.STATUE
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CLAYWARG.STATUE"
msgid "How delightfully disconcerting."
msgstr "Qué deliciosamente desconcertante."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.COLDFIRE.EMBERS
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.COLDFIRE.EMBERS"
msgid "I'm going to lose it."
msgstr "Voy a perderlo."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.COLDFIRE.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.COLDFIRE.GENERIC"
msgid "How comforting."
msgstr "Qué reconfortante."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.COLDFIRE.HIGH
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.COLDFIRE.HIGH"
msgid "That will keep Charlie away for now."
msgstr "Eso mantendrá a Charlie lejos por ahora."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.COLDFIRE.LOW
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.COLDFIRE.LOW"
msgid "It needs fuel."
msgstr "Necesita combustible."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.COLDFIRE.NORMAL
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.COLDFIRE.NORMAL"
msgid "Cold and fiery."
msgstr "Frío y ardiente."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.COLDFIRE.OUT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.COLDFIRE.OUT"
msgid "That's not coming back."
msgstr "No regresará."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.COLDFIREPIT.EMBERS
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.COLDFIREPIT.EMBERS"
msgid "Someone should attend to that."
msgstr "Alguien debería ocuparse de eso."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.COLDFIREPIT.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.COLDFIREPIT.GENERIC"
msgid "A fire pit."
msgstr "Una hoguera."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.COLDFIREPIT.HIGH
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.COLDFIREPIT.HIGH"
msgid "A roaring, cold fire."
msgstr "Un fuego frío y crepitante."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.COLDFIREPIT.LOW
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.COLDFIREPIT.LOW"
msgid "It's getting low."
msgstr "Se está apagando."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.COLDFIREPIT.NORMAL
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.COLDFIREPIT.NORMAL"
msgid "It's cold."
msgstr "Está frío."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.COLDFIREPIT.OUT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.COLDFIREPIT.OUT"
msgid "It's gone warm."
msgstr "Se entibió."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.COLLAPSEDCHEST
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.COLLAPSEDCHEST"
msgid "Do you really expect me to dig through that?"
msgstr "¿De verdad esperas que cave ahí?"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.COMPASS.E
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.COMPASS.E"
msgid "East."
msgstr "Este."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.COMPASS.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.COMPASS.GENERIC"
msgid "I've lost my way."
msgstr "Me perdí."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.COMPASS.N
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.COMPASS.N"
msgid "North."
msgstr "Norte."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.COMPASS.NE
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.COMPASS.NE"
msgid "Northeast."
msgstr "Noreste."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.COMPASS.NW
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.COMPASS.NW"
msgid "Northwest."
msgstr "Noroeste."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.COMPASS.S
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.COMPASS.S"
msgid "South."
msgstr "Sur."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.COMPASS.SE
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.COMPASS.SE"
msgid "Southeast."
msgstr "Sureste."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.COMPASS.SW
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.COMPASS.SW"
msgid "Southwest."
msgstr "Suroeste."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.COMPASS.W
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.COMPASS.W"
msgid "West."
msgstr "Oeste."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.COMPOST
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.COMPOST"
msgid "I'd rather not get my hands dirty."
msgstr "Preferiría no ensuciarme las manos."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.COMPOSTINGBIN.BALANCED
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.COMPOSTINGBIN.BALANCED"
msgid "This should suffice."
msgstr "Así está bien."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.COMPOSTINGBIN.BURNT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.COMPOSTINGBIN.BURNT"
msgid "It smells about as bad as you'd imagine."
msgstr "Huele tan mal como te imaginas."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.COMPOSTINGBIN.DRY
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.COMPOSTINGBIN.DRY"
msgid "Positively arid."
msgstr "Afirmativamente árido."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.COMPOSTINGBIN.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.COMPOSTINGBIN.GENERIC"
msgid "Disgusting."
msgstr "Qué asco."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.COMPOSTINGBIN.WET
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.COMPOSTINGBIN.WET"
msgid "It's nothing but foul wet slop."
msgstr "Es solo basura mojada."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.COMPOSTWRAP
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.COMPOSTWRAP"
msgid "I'm utterly dung with all of this."
msgstr "Estoy empantanado hasta arriba con esto."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CONSTRUCTION_PLANS
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CONSTRUCTION_PLANS"
msgid "I suppose I should build this."
msgstr "Supongo que debería construir esto."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.COOKBOOK
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.COOKBOOK"
msgid "Very well. If I can master the dark arts, how hard could cooking be?"
msgstr "Bien. Si puedo dominar las artes oscuras, ¿qué tan difícil será cocinar?"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.COOKEDMANDRAKE
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.COOKEDMANDRAKE"
msgid "It has lost a lot of its power."
msgstr "Perdió gran parte de su poder."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.COOKEDMEAT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.COOKEDMEAT"
msgid "It smells less like barnyard, now."
msgstr "Ahora huele menos a corral."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.COOKEDMONSTERMEAT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.COOKEDMONSTERMEAT"
msgid "It's still filthy."
msgstr "Todavía sabe asquerosa."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.COOKEDSMALLMEAT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.COOKEDSMALLMEAT"
msgid "Well, at least it's not moving anymore."
msgstr "Bueno, al menos ya no volverá a moverse."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.COOKIECUTTER
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.COOKIECUTTER"
msgid "Stay back, you!"
msgstr "¡Atrás, te digo!"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.COOKIECUTTERHAT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.COOKIECUTTERHAT"
msgid "This doesn't look dapper at all."
msgstr "Esto no se ve nada elegante."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.COOKIECUTTERSHELL
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.COOKIECUTTERSHELL"
msgid "Hmph. I suppose this could be useful."
msgstr "Mmm, supongo que podría ser útil."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.COOKINGRECIPECARD.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.COOKINGRECIPECARD.GENERIC"
msgid "The writing is too faint to read."
msgstr "La escritura está muy tenue y no se lee."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.COOKPOT.BURNT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.COOKPOT.BURNT"
msgid "A bit overdone for my tastes."
msgstr "Demasiado cocido para mi gusto."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.COOKPOT.COOKING_LONG
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.COOKPOT.COOKING_LONG"
msgid "Wait for it..."
msgstr "Espera un poco..."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.COOKPOT.COOKING_SHORT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.COOKPOT.COOKING_SHORT"
msgid "Here it comes!"
msgstr "¡Ya está!"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.COOKPOT.DONE
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.COOKPOT.DONE"
msgid "Finally, some quality grub."
msgstr "Por fin un poco de comida de calidad."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.COOKPOT.EMPTY
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.COOKPOT.EMPTY"
msgid "Just the thought makes my mouth water."
msgstr "Con solo pensarlo se me hace agua la boca."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.COONTAIL
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.COONTAIL"
msgid "Tale of tails."
msgstr "La cola."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CORN
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CORN"
msgid "High in fructose."
msgstr "Rico en fructosa."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CORN_COOKED
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CORN_COOKED"
msgid "A little more refined, at least."
msgstr "Un poco más refinada, por lo menos."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CORN_OVERSIZED
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CORN_OVERSIZED"
msgid "That's far too much corn for any reasonable person."
msgstr "Demasiado maíz para cualquier persona normal."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CORN_SEEDS
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CORN_SEEDS"
msgid "Such labor is beneath me."
msgstr "Este trabajo es indigno para mí."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.COSTUME_BLACKSMITH_BODY
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.COSTUME_BLACKSMITH_BODY"
msgid "It seems the costumes are provided."
msgstr "Parece que otorgan los disfraces."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.COSTUME_DOLL_BODY
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.COSTUME_DOLL_BODY"
msgid "It seems the costumes are provided."
msgstr "Parece que otorgan los disfraces."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.COSTUME_FOOL_BODY
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.COSTUME_FOOL_BODY"
msgid "It seems the costumes are provided."
msgstr "Parece que otorgan los disfraces."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.COSTUME_KING_BODY
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.COSTUME_KING_BODY"
msgid "I think that one will fit me nicely."
msgstr "Creo que este me quedará bien."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.COSTUME_MIRROR_BODY
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.COSTUME_MIRROR_BODY"
msgid "It seems the costumes are provided."
msgstr "Parece que otorgan los disfraces."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.COSTUME_QUEEN_BODY
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.COSTUME_QUEEN_BODY"
msgid "It seems the costumes are provided."
msgstr "Parece que otorgan los disfraces."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.COSTUME_TREE_BODY
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.COSTUME_TREE_BODY"
msgid "It seems the costumes are provided."
msgstr "Parece que otorgan los disfraces."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.COTL_TABERNACLE_LEVEL1.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.COTL_TABERNACLE_LEVEL1.GENERIC"
msgid "Let's add a little fire for dramatic effect."
msgstr "¿Y si le agregamos un poco de fuego para un efecto dramático?"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.COTL_TABERNACLE_LEVEL1.LIT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.COTL_TABERNACLE_LEVEL1.LIT"
msgid "A homely statue. Perhaps it can be improved."
msgstr "Una estatua hogareña. Se puede mejorar."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.COTL_TABERNACLE_LEVEL2.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.COTL_TABERNACLE_LEVEL2.GENERIC"
msgid "Let's add a little fire for dramatic effect."
msgstr "¿Y si le agregamos un poco de fuego para un efecto dramático?"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.COTL_TABERNACLE_LEVEL2.LIT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.COTL_TABERNACLE_LEVEL2.LIT"
msgid "How delightfully ominous."
msgstr "Exquisitamente siniestro."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.COTL_TABERNACLE_LEVEL3.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.COTL_TABERNACLE_LEVEL3.GENERIC"
msgid "Let's add a little fire for dramatic effect."
msgstr "¿Y si le agregamos un poco de fuego para un efecto dramático?"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.COTL_TABERNACLE_LEVEL3.LIT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.COTL_TABERNACLE_LEVEL3.LIT"
msgid "There's something captivating about it."
msgstr "Hay algo que me captiva de ello."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.COTL_TRINKET
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.COTL_TRINKET"
msgid "Not my size, sadly."
msgstr "No es de mi talle, desafortunadamente."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.COZY_BUNNYMAN
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.COZY_BUNNYMAN"
msgid "I could have sworn I left you all underground."
msgstr "Estaba convencido de que los dejé a todos bajo tierra."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CRABKING.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CRABKING.GENERIC"
msgid "Say, pal, why don't we try to work this out?"
msgstr "A ver, camarada, ¿por qué no tratamos de solucionar esto?"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CRABKING.INERT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CRABKING.INERT"
msgid "I suppose we can't just leave well enough alone, can we?"
msgstr "Supongo que no podemos dejarlo estar, ¿no?"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CRABKING_CANNONTOWER
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CRABKING_CANNONTOWER"
msgid "Watch it where you shoot those things!"
msgstr "¡Mira bien adónde tiras esos!"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CRABKING_CLAW
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CRABKING_CLAW"
msgid "Best to avoid that."
msgstr "Mejor evitemos eso."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CRABKING_ICEWALL
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CRABKING_ICEWALL"
msgid "Always something in the way."
msgstr "Siempre hay algo en el camino."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CRABKING_MOB
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CRABKING_MOB"
msgid "I'd kill for a crab cake."
msgstr "Mataría por un pastel de cangrejo."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CRABKING_MOB_KNIGHT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CRABKING_MOB_KNIGHT"
msgid "Middle management."
msgstr "Gerencia media."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CRITTERLAB
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CRITTERLAB"
msgid "Am I being watched by that rock?"
msgstr "¿Esa roca en serio me está observando?"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CRITTER_DRAGONLING
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CRITTER_DRAGONLING"
msgid "Just like old times."
msgstr "Como en los viejos tiempos."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CRITTER_EYEOFTERROR
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CRITTER_EYEOFTERROR"
msgid "Tell me, what is it you see, little one?"
msgstr "¿Qué es lo que ves, pequeño?"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CRITTER_GLOMLING
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CRITTER_GLOMLING"
msgid "You are much too trusting, friend."
msgstr "Eres demasiado confiado, amigo."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CRITTER_KITTEN
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CRITTER_KITTEN"
msgid "A wholly agreeable animal."
msgstr "Un animal muy simpático."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CRITTER_LAMB
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CRITTER_LAMB"
msgid "Quit nibbling my coattails."
msgstr "Deja de mordisquearme la ropa."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CRITTER_LUNARMOTHLING
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CRITTER_LUNARMOTHLING"
msgid "You had better not chew holes in my suit."
msgstr "Espero que no hayas agujereado mi traje."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CRITTER_PERDLING
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CRITTER_PERDLING"
msgid "You're as fowl as I am!"
msgstr "¡Eres tan rapaz como yo!"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CRITTER_PUPPY
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CRITTER_PUPPY"
msgid "You're a slobbery little chap, aren't you?"
msgstr "Eres una criaturita babosa, ¿verdad?"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CROW.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CROW.GENERIC"
msgid "I don't know how they got here."
msgstr "No sé cómo llegaron aquí."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CROW.HELD
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CROW.HELD"
msgid "Shhhh... My pretty."
msgstr "Shhhh... Mi precioso."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CRUMBS
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CRUMBS"
msgid "It's falling apart."
msgstr "Se está cayendo a pedazos."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CURSED_MONKEY_TOKEN
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CURSED_MONKEY_TOKEN"
msgid "Disgusting!"
msgstr "¡Desagradable!"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CUTGRASS
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CUTGRASS"
msgid "The mundane stuff of the earth."
msgstr "Las cosas mundanas de la tierra."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CUTLESS
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CUTLESS"
msgid "Very funny."
msgstr "Muy gracioso."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CUTLICHEN
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CUTLICHEN"
msgid "Dry, crumbly, sustaining."
msgstr "Seco, desmenuzable, nutritivo."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CUTREEDS
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CUTREEDS"
msgid "I think I could build something useful from this."
msgstr "Creo que puedo construir algo útil con esto."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CUTSTONE
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.CUTSTONE"
msgid "The building blocks of civilization."
msgstr "Los pilares de la civilización."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DAYWALKER.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DAYWALKER.GENERIC"
msgid "Say pal, why don't we talk this out?"
msgstr "A ver, camarada, ¿por qué no tratamos de charlarlo?"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DAYWALKER.IMPRISONED
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DAYWALKER.IMPRISONED"
msgid "You went nosing around places you shouldn't have, didn't you?"
msgstr "Estuviste husmeando donde no debías, ¿cierto?"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DAYWALKER2.BURIED
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DAYWALKER2.BURIED"
msgid "He seems fine to me."
msgstr "A mí me parece que está bien."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DAYWALKER2.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DAYWALKER2.GENERIC"
msgid "Someone needs a bath."
msgstr "Alguien necesita un baño."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DAYWALKER2.HOSTILE
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DAYWALKER2.HOSTILE"
msgid "What's his problem?"
msgstr "¿Cuál es su problema?"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DAYWALKER_PILLAR.EXPOSED
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DAYWALKER_PILLAR.EXPOSED"
msgid "That stone would be useful, if only it could be broken."
msgstr "Esa piedra podría ser útil, si tan solo pudiera romperla."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DAYWALKER_PILLAR.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DAYWALKER_PILLAR.GENERIC"
msgid "I can just make out something dark within."
msgstr "Presiento algo oscuro dentro."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DEADLYFEAST
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DEADLYFEAST"
msgid "It smells... noxious."
msgstr "Huele... a tóxico."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DEAD_SEA_BONES
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DEAD_SEA_BONES"
msgid "Adapt or perish."
msgstr "Adaptarse o perecer."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DECIDUOUSTREE.BURNING
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DECIDUOUSTREE.BURNING"
msgid "Oops."
msgstr "Ups."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DECIDUOUSTREE.BURNT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DECIDUOUSTREE.BURNT"
msgid "Bathed in fire."
msgstr "Regado en fuego."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DECIDUOUSTREE.CHOPPED
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DECIDUOUSTREE.CHOPPED"
msgid "That's not about to grow back."
msgstr "No volverá a crecer."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DECIDUOUSTREE.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DECIDUOUSTREE.GENERIC"
msgid "An acquaintance of mine describes them as \"leafy\"."
msgstr "Un conocido mío los describe como «frondosos»."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DECIDUOUSTREE.POISON
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DECIDUOUSTREE.POISON"
msgid "Shut your maw!"
msgstr "¡Cierra tus fauces!"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DECOR_CENTERPIECE
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DECOR_CENTERPIECE"
msgid "Bland."
msgstr "Soso."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DECOR_FLOWERVASE.EMPTY
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DECOR_FLOWERVASE.EMPTY"
msgid "An empty vessel awaiting decoration or light."
msgstr "Un recipiente vacío que espera a ser decorado."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DECOR_FLOWERVASE.FRESHLIGHT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DECOR_FLOWERVASE.FRESHLIGHT"
msgid "A temporary reprieve from the shadow."
msgstr "Un descanso temporal de las sombras."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DECOR_FLOWERVASE.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DECOR_FLOWERVASE.GENERIC"
msgid "Purely decorative."
msgstr "Puramente decorativo."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DECOR_FLOWERVASE.OLDLIGHT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DECOR_FLOWERVASE.OLDLIGHT"
msgid "I believe it is Wilson's turn to fetch bulbs."
msgstr "Creo que le toca a Wilson cambiar las bombillas."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DECOR_FLOWERVASE.WILTED
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DECOR_FLOWERVASE.WILTED"
msgid "Every lovely flower must one day wilt."
msgstr "Cada flor hermosa se marchitará algún día."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DECOR_LAMP
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DECOR_LAMP"
msgid "Who's afraid of the dark?"
msgstr "¿Quién le tiene miedo a la oscuridad?"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DECOR_PICTUREFRAME.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DECOR_PICTUREFRAME.GENERIC"
msgid "Uninspired."
msgstr "Sin inspiración."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DECOR_PICTUREFRAME.UNDRAWN
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DECOR_PICTUREFRAME.UNDRAWN"
msgid "If only life were that simple."
msgstr "Si la vida fuese tan simple..."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DECOR_PORTRAITFRAME
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DECOR_PORTRAITFRAME"
msgid "My my, aren't we special."
msgstr "Oh, qué bonitos."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DEER.ANTLER
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DEER.ANTLER"
msgid "What a staggering sight!"
msgstr "¡Qué visión más asombrosa!"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DEER.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DEER.GENERIC"
msgid "Well it's certainly not deer to me."
msgstr "Espero que no me dé una cornada."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DEERCLOPS
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DEERCLOPS"
msgid "Even I'm afraid of that guy."
msgstr "Incluso yo tengo miedo de ese tipo."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DEERCLOPSCORPSE.BURNING
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DEERCLOPSCORPSE.BURNING"
msgid "It's best to be rid of it."
msgstr "Mejor deshacerse de ese cuerpo."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DEERCLOPSCORPSE.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DEERCLOPSCORPSE.GENERIC"
msgid "Disgusting."
msgstr "Qué asco."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DEERCLOPSCORPSE.REVIVING
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DEERCLOPSCORPSE.REVIVING"
msgid "The wretch is being puppeteered!"
msgstr "¡Están controlando al desgraciado!"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DEERCLOPSEYEBALL_SENTRYWARD.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DEERCLOPSEYEBALL_SENTRYWARD.GENERIC"
msgid "Keeps it cold like my heart."
msgstr "Lo mantiene frío como mi corazón."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DEERCLOPSEYEBALL_SENTRYWARD.NOEYEBALL
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DEERCLOPSEYEBALL_SENTRYWARD.NOEYEBALL"
msgid "Don't say I didn't warn you when it all goes up in flames."
msgstr "Cuando todo esté en llamas, no digas que no te avisé."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DEERCLOPSEYEBALL_SENTRYWARD_KIT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DEERCLOPSEYEBALL_SENTRYWARD_KIT"
msgid "Do I have to do everything around here?"
msgstr "¿Tengo que hacer todo yo?"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DEERCLOPS_EYEBALL
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DEERCLOPS_EYEBALL"
msgid "Deerclops are so myopic."
msgstr "Los ciérclopes son muy miopes."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DEER_ANTLER
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DEER_ANTLER"
msgid "Filthy."
msgstr "Asqueroso."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DEER_GEMMED
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DEER_GEMMED"
msgid "The gem imbues its attacks with a fearsome power."
msgstr "La gema infunde sus ataques de un poder temible."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DEPLETED_GRASS.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DEPLETED_GRASS.GENERIC"
msgid "That's not doing anyone any good."
msgstr "Esto no está haciendo ningún bien a nadie."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DESERTHAT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DESERTHAT"
msgid "Function over form."
msgstr "Funcionalidad antes que forma."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DIRTPILE
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DIRTPILE"
msgid "That looks out-of-place."
msgstr "Eso parece fuera de lugar."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DIVININGROD.COLD
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DIVININGROD.COLD"
msgid "Mostly just background noise."
msgstr "Principalmente solo ruido de fondo."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DIVININGROD.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DIVININGROD.GENERIC"
msgid "I can use this to find my missing parts."
msgstr "Puedo usarlo para encontrar las piezas que me faltan."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DIVININGROD.HOT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DIVININGROD.HOT"
msgid "It must be right under my nose!"
msgstr "¡Debe de estar justo debajo de mis narices!"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DIVININGROD.WARM
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DIVININGROD.WARM"
msgid "This is the right direction."
msgstr "Esta es la dirección correcta."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DIVININGROD.WARMER
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DIVININGROD.WARMER"
msgid "I should keep my eyes peeled."
msgstr "Debo mantener mis ojos bien abiertos."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DIVININGRODBASE.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DIVININGRODBASE.GENERIC"
msgid "It's the starting mechanism."
msgstr "Es el mecanismo de arranque."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DIVININGRODBASE.READY
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DIVININGRODBASE.READY"
msgid "I need to insert the divining rod."
msgstr "Tengo que insertar la vara adivinadora."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DIVININGRODBASE.UNLOCKED
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DIVININGRODBASE.UNLOCKED"
msgid "Progress!"
msgstr "¡Progreso!"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DIVININGRODSTART
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DIVININGRODSTART"
msgid "The portals lead to the next rod."
msgstr "Los portales conducen a la siguiente vara."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DOCK_KIT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DOCK_KIT"
msgid "So I'm to be a dock builder now, am I?"
msgstr "Así que ahora soy un fabricante de muelles, ¿no?"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DOCK_WOODPOSTS_ITEM
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DOCK_WOODPOSTS_ITEM"
msgid "Do I look like a common laborer to you?"
msgstr "¿Tengo pinta de trabajador?"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DOLL_BLUEPRINT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DOLL_BLUEPRINT"
msgid "I can only imagine how grotesque this will look..."
msgstr "Ya me imagino qué grotesco va a quedar esto."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DRAGONBOAT_KIT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DRAGONBOAT_KIT"
msgid "I'm not the roll-up-your-sleeves type. Ask the handywoman."
msgstr "No soy el tipo que se arremanga. Pregúntale a ella."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DRAGONBOAT_PACK
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DRAGONBOAT_PACK"
msgid "Here I am, toiling away for a frivolous diversion."
msgstr "Así que aquí estoy, trabajando duro para una distracción frívola."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DRAGONBODYHAT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DRAGONBODYHAT"
msgid "I'm no middleman."
msgstr "No soy ningún intermediario."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DRAGONCHILISALAD
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DRAGONCHILISALAD"
msgid "I'll permit him to stay so long as he keeps cooking."
msgstr "Le permitiré quedarse mientras siga cocinando."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DRAGONFLY
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DRAGONFLY"
msgid "A fiery fly."
msgstr "Una mosca de fuego."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DRAGONFLYCHEST.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DRAGONFLYCHEST.GENERIC"
msgid "Those scales sure are nifty."
msgstr "Esas escamas son ingeniosas."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DRAGONFLYCHEST.UPGRADED_STACKSIZE
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DRAGONFLYCHEST.UPGRADED_STACKSIZE"
msgid "Spacious and stylish."
msgstr "Espacioso y con estilo."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DRAGONFLYFURNACE.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DRAGONFLYFURNACE.GENERIC"
msgid "Such a spiffy design!"
msgstr "¡Qué diseño tan sensacional!"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DRAGONFLYFURNACE.HAMMERED
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DRAGONFLYFURNACE.HAMMERED"
msgid "How undignified."
msgstr "Qué poco decoroso."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DRAGONFLYFURNACE.HIGH
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DRAGONFLYFURNACE.HIGH"
msgid "The red gems are producing a sweltering heat."
msgstr "Las gemas rojas están produciendo un calor sofocante."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DRAGONFLYFURNACE.NORMAL
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DRAGONFLYFURNACE.NORMAL"
msgid "With only one gem it is only moderately scorching."
msgstr "Con solo una gema, arde de forma moderada."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DRAGONFRUIT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DRAGONFRUIT"
msgid "Exotic and delicious."
msgstr "Exótica y deliciosa."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DRAGONFRUIT_COOKED
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DRAGONFRUIT_COOKED"
msgid "A little more refined, at least."
msgstr "Un poco más refinada, por lo menos."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DRAGONFRUIT_OVERSIZED
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DRAGONFRUIT_OVERSIZED"
msgid "Utterly enormous."
msgstr "Extremadamente gigante."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DRAGONFRUIT_SEEDS
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DRAGONFRUIT_SEEDS"
msgid "Such labor is beneath me."
msgstr "Este trabajo es indigno para mí."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DRAGONHEADHAT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DRAGONHEADHAT"
msgid "Quite formidable looking."
msgstr "Un aspecto bastante formidable."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DRAGONPIE
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DRAGONPIE"
msgid "Simply exquisite."
msgstr "Simplemente exquisito."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DRAGONTAILHAT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DRAGONTAILHAT"
msgid "The back end of a terrible beast."
msgstr "El lomo de una terrible bestia."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DRAGON_SCALES
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DRAGON_SCALES"
msgid "Fiery."
msgstr "Ardiente."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DREADSTONE
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DREADSTONE"
msgid "Petrified nightmares."
msgstr "Pesadillas petrificadas."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DREADSTONEHAT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DREADSTONEHAT"
msgid "Darkness is never far from my mind."
msgstr "La oscuridad nunca se aleja de mi mente."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DREADSTONE_STACK
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DREADSTONE_STACK"
msgid "It comes from the depths below."
msgstr "Viene de las profundidades."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DRIFTWOOD_LOG
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DRIFTWOOD_LOG"
msgid "Oh good. More wood."
msgstr "Oh, bien. Más madera."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DRIFTWOOD_TREE.BURNING
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DRIFTWOOD_TREE.BURNING"
msgid "It seems to be burning."
msgstr "Parece que se está quemando."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DRIFTWOOD_TREE.BURNT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DRIFTWOOD_TREE.BURNT"
msgid "It's in utter ruin."
msgstr "En las ruinas totales."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DRIFTWOOD_TREE.CHOPPED
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DRIFTWOOD_TREE.CHOPPED"
msgid "We've chopped it up already."
msgstr "Ya lo cortamos."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DRIFTWOOD_TREE.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DRIFTWOOD_TREE.GENERIC"
msgid "It appears to be a piece of drifted wood."
msgstr "Parece ser un trozo de madera de un naufragio."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DRUMSTICK
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DRUMSTICK"
msgid "It tastes strangely like berries."
msgstr "Sabe extraño, como a bayas."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DRUMSTICK_COOKED
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DRUMSTICK_COOKED"
msgid "Still tastes like berries."
msgstr "Aún sabe a bayas."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DUG_BANANABUSH
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DUG_BANANABUSH"
msgid "Bananas that don't grow in caves? Preposterous."
msgstr "¿Bananas que no crecen en cuevas? Qué absurdo."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DUG_BERRYBUSH
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DUG_BERRYBUSH"
msgid "Do I look like a gardener?"
msgstr "¿Me parezco a un jardinero?"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DUG_BERRYBUSH_JUICY
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DUG_BERRYBUSH_JUICY"
msgid "I could find a much better place for it."
msgstr "Puedo encontrar un lugar mucho mejor para él."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DUG_GRASS
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DUG_GRASS"
msgid "Do I look like a gardener?"
msgstr "¿Me parezco a un jardinero?"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DUG_MARSH_BUSH
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DUG_MARSH_BUSH"
msgid "Do I look like a gardener?"
msgstr "¿Me parezco a un jardinero?"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DUG_MONKEYTAIL
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DUG_MONKEYTAIL"
msgid "I still don't trust it."
msgstr "Todavía no confío."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DUG_SAPLING
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DUG_SAPLING"
msgid "I can't believe I'm reduced to this."
msgstr "No puedo creer que haya quedado reducido a esto."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DUG_TRAP_STARFISH
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DUG_TRAP_STARFISH"
msgid "What would be the most devilish place to put it?"
msgstr "¿Cuál sería el lugar más diabólico para ponerlo?"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DUMBBELL
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DUMBBELL"
msgid "I have no interest in such things."
msgstr "Estas cosas no me interesan."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DUMBBELL_BLUEGEM
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DUMBBELL_BLUEGEM"
msgid "It has all the grace and subtlety I'd expect from the strongman."
msgstr "Tiene la gracia y la sutileza que espero del forzudo."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DUMBBELL_GEM
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DUMBBELL_GEM"
msgid "It's not that impressive."
msgstr "No es tan sorprendente."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DUMBBELL_GOLDEN
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DUMBBELL_GOLDEN"
msgid "It's not that impressive."
msgstr "No es tan sorprendente."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DUMBBELL_HEAT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DUMBBELL_HEAT"
msgid "You won't catch me lugging it around."
msgstr "No me verás cargándolo por todos lados."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DUMBBELL_MARBLE
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DUMBBELL_MARBLE"
msgid "It's not that impressive."
msgstr "No es tan sorprendente."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DUMBBELL_REDGEM
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DUMBBELL_REDGEM"
msgid "It has all the grace and subtlety I'd expect from the strongman."
msgstr "Tiene la gracia y la sutileza que espero del forzudo."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DURIAN
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DURIAN"
msgid "It's an acquired taste."
msgstr "Es un gusto que se adquiere con el tiempo."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DURIAN_COOKED
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DURIAN_COOKED"
msgid "A little more refined, at least."
msgstr "Un poco más refinada, por lo menos."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DURIAN_OVERSIZED
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DURIAN_OVERSIZED"
msgid "Far more than I'd like to have, quite honestly."
msgstr "Mucho más de lo que me gustaría tener, la verdad."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DURIAN_SEEDS
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DURIAN_SEEDS"
msgid "Such labor is beneath me."
msgstr "Este trabajo es indigno para mí."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DUSTMERINGUE
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DUSTMERINGUE"
msgid "I'll pass."
msgstr "Yo paso."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DUSTMOTH
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DUSTMOTH"
msgid "Hmph. Just stay away from my suit, pal."
msgstr "Mm. Solo aléjate de mi traje, camarada."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DUSTMOTHDEN
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.DUSTMOTHDEN"
msgid "So this is the source of the Thulecite... I must say, I'm underwhelmed."
msgstr "Esta es la fuente de la thulecita... Debo decir que estoy abrumado."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.EARMUFFSHAT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.EARMUFFSHAT"
msgid "They are at least warm."
msgstr "Por lo menos están abrigados."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.EEL
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.EEL"
msgid "It slithers all the way down."
msgstr "Se desliza reptando."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.EEL_COOKED
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.EEL_COOKED"
msgid "Still rather grotesque."
msgstr "Sigue siendo bastante grotesca."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.EGGPLANT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.EGGPLANT"
msgid "Just another boring plant."
msgstr "Otra planta aburrida."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.EGGPLANT_COOKED
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.EGGPLANT_COOKED"
msgid "A little more refined, at least."
msgstr "Un poco más refinada, por lo menos."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.EGGPLANT_OVERSIZED
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.EGGPLANT_OVERSIZED"
msgid "An absurdly large eggplant."
msgstr "Una berenjena de tamaño absurdo."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.EGGPLANT_SEEDS
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.EGGPLANT_SEEDS"
msgid "Such labor is beneath me."
msgstr "Este trabajo es indigno para mí."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ELIXIR_CONTAINER
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ELIXIR_CONTAINER"
msgid "Don't think I'm fooled by its innocent appearance."
msgstr ""

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.EMBERLIGHT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.EMBERLIGHT"
msgid "Neat trick."
msgstr "Buen truco."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ENDTABLE.BURNT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ENDTABLE.BURNT"
msgid "That was uncalled for."
msgstr "Innecesario."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ENDTABLE.EMPTY
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ENDTABLE.EMPTY"
msgid "An empty vessel awaiting decoration or light."
msgstr "Un recipiente vacío que espera a ser decorado."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ENDTABLE.FRESHLIGHT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ENDTABLE.FRESHLIGHT"
msgid "A temporary reprieve from the shadow."
msgstr "Un descanso temporal de las sombras."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ENDTABLE.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ENDTABLE.GENERIC"
msgid "Purely decorative."
msgstr "Puramente decorativo."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ENDTABLE.OLDLIGHT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ENDTABLE.OLDLIGHT"
msgid "I believe it is Wilson's turn to fetch bulbs."
msgstr "Creo que le toca a Wilson cambiar las bombillas."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ENDTABLE.WILTED
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ENDTABLE.WILTED"
msgid "Every lovely flower must one day wilt."
msgstr "Cada flor hermosa se marchitará algún día."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.EVERGREEN.BURNING
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.EVERGREEN.BURNING"
msgid "Oops."
msgstr "Ups."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.EVERGREEN.BURNT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.EVERGREEN.BURNT"
msgid "Bathed in fire."
msgstr "Regado en fuego."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.EVERGREEN.CHOPPED
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.EVERGREEN.CHOPPED"
msgid "That's not about to grow back."
msgstr "No volverá a crecer."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.EVERGREEN.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.EVERGREEN.GENERIC"
msgid "An acquaintance of mine describes them as \"piney\"."
msgstr "Un conocido mío dice que son tipo «pinoso»."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.EVERGREEN_SPARSE.BURNING
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.EVERGREEN_SPARSE.BURNING"
msgid "Oops."
msgstr "Ups."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.EVERGREEN_SPARSE.BURNT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.EVERGREEN_SPARSE.BURNT"
msgid "Dust to dust."
msgstr "Y en polvo te convertirás."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.EVERGREEN_SPARSE.CHOPPED
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.EVERGREEN_SPARSE.CHOPPED"
msgid "I put it out of its misery."
msgstr "He terminado con su miseria."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.EVERGREEN_SPARSE.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.EVERGREEN_SPARSE.GENERIC"
msgid "It looks sickly."
msgstr "Parece enfermo."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.EYEBRELLAHAT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.EYEBRELLAHAT"
msgid "Eye to the sky."
msgstr "Ojo al cielo."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.EYEMASKHAT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.EYEMASKHAT"
msgid "How deliciously macabre."
msgstr "Deliciosamente macabro."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.EYEOFTERROR
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.EYEOFTERROR"
msgid "Don't look at me, it's definitely not one of mine."
msgstr "No me mires a mí. Eso no es mío, definitivamente."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.EYEOFTERROR_MINI
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.EYEOFTERROR_MINI"
msgid "We're going to be up to our eyeballs in... eyeballs."
msgstr "Vamos a estar hasta los ojos... con los ojos."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.EYEOFTERROR_MINI_GROUNDED
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.EYEOFTERROR_MINI_GROUNDED"
msgid "I should dispose of it before it hatches."
msgstr "Creo que debería deshacerme de eso antes de que nazca."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.EYEPLANT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.EYEPLANT"
msgid "The Meat Bulb's pawns."
msgstr "Los peones del bulbo de carne."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.EYETURRET
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.EYETURRET"
msgid "Some of my better work."
msgstr "Una de mis mejores creaciones."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.EYETURRET_ITEM
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.EYETURRET_ITEM"
msgid "Now it just needs to be set up."
msgstr "Ahora solo hay que configurarlo."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FARMPLOT.BURNT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FARMPLOT.BURNT"
msgid "A harvest of ashes."
msgstr "Una cosecha de cenizas."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FARMPLOT.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FARMPLOT.GENERIC"
msgid "Do I look like a farmer?"
msgstr "¿Tengo pinta de granjero?"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FARMPLOT.GROWING
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FARMPLOT.GROWING"
msgid "I have better things to do than watch plants grow."
msgstr "Tengo mejores cosas que hacer que ver plantas crecer."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FARMPLOT.NEEDSFERTILIZER
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FARMPLOT.NEEDSFERTILIZER"
msgid "It needs to be... refreshed."
msgstr "Tiene que ser... refrescado."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FARM_HOE
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FARM_HOE"
msgid "Am I to be reduced to a common farmhand?"
msgstr "¿Voy a ser rebajado a un mero granjero?"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FARM_PLANT.BURNING
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FARM_PLANT.BURNING"
msgid "Not the garden!"
msgstr "¡El jardín no!"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FARM_PLANT.FULL
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FARM_PLANT.FULL"
msgid "It's time to reap what I've sown."
msgstr "Es hora de cosechar las siembras."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FARM_PLANT.FULL_OVERSIZED
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FARM_PLANT.FULL_OVERSIZED"
msgid "At last, my efforts are rewarded."
msgstr "Por fin, mis esfuerzos son retribuidos."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FARM_PLANT.FULL_WEED
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FARM_PLANT.FULL_WEED"
msgid "Not another blasted weed!"
msgstr "¿Otra vez la maldita maleza?"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FARM_PLANT.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FARM_PLANT.GENERIC"
msgid "Merely a plant."
msgstr "Simplemente una planta."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FARM_PLANT.GROWING
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FARM_PLANT.GROWING"
msgid "Nearly there."
msgstr "Casi está."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FARM_PLANT.ROTTEN
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FARM_PLANT.ROTTEN"
msgid "Rotten."
msgstr "Se pudrió."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FARM_PLANT.ROTTEN_OVERSIZED
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FARM_PLANT.ROTTEN_OVERSIZED"
msgid "It's no good to anyone now."
msgstr "Ahora ya no le sirve a nadie."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FARM_PLANT.SEED
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FARM_PLANT.SEED"
msgid "I'll have to be patient."
msgstr "Tendré que tener paciencia."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FARM_PLOW
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FARM_PLOW"
msgid "Thankfully it seems capable of doing the work itself."
msgstr "Parece que es capaz de hacer el trabajo solo."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FARM_PLOW_ITEM
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FARM_PLOW_ITEM"
msgid "Some kind of farming implement? I've no interest in such things."
msgstr "¿Algún instrumento para cosechar? No me interesan esas cosas."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FARM_SOIL_DEBRIS
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FARM_SOIL_DEBRIS"
msgid "The blasted things spring up again just as fast as I can remove them."
msgstr "Estas cosas crecen tan rápido; apenas las quito, vuelven a crecer."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FEATHERFAN
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FEATHERFAN"
msgid "Is it windy out or is it just this fan?"
msgstr "¿Está ventoso hoy o es solo este abanico?"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FEATHERHAT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FEATHERHAT"
msgid "I always considered myself the peacock of people."
msgstr "Siempre me consideré el pavo real de la gente."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FEATHERPENCIL
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FEATHERPENCIL"
msgid "Not as elegant as a quill and inkwell, but it'll do."
msgstr "No es tan elegante como una pluma y un tintero, pero servirá."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FEATHER_CANARY
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FEATHER_CANARY"
msgid "Yellow is the color of naivety."
msgstr "El amarillo es el color de la ingenuidad."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FEATHER_CROW
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FEATHER_CROW"
msgid "Black is the color of sleep."
msgstr "El negro es el color del sueño."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FEATHER_ROBIN
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FEATHER_ROBIN"
msgid "Red is the color of fire."
msgstr "El rojo es el color del fuego."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FEATHER_ROBIN_WINTER
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FEATHER_ROBIN_WINTER"
msgid "Grey is the color of pain."
msgstr "El gris es el color del dolor."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FEM_PUPPET
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FEM_PUPPET"
msgid "Better her than me."
msgstr "Mejor ella que yo."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FENCE
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FENCE"
msgid "My life is one obstacle after another."
msgstr "Mi vida es un obstáculo tras otro."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FENCE_GATE
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FENCE_GATE"
msgid "When one gate closes..."
msgstr "Cuando una puerta se cierra..."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FENCE_GATE_ITEM
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FENCE_GATE_ITEM"
msgid "A gate for your pocket."
msgstr "Una puerta para el bolsillo."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FENCE_ITEM
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FENCE_ITEM"
msgid "A fence for your pocket."
msgstr "Una valla para el bolsillo."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FENCE_JUNK
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FENCE_JUNK"
msgid "Hmph. It'll certainly repel anyone with taste."
msgstr "Mm. Ciertamente, repele a cualquiera con buen gusto."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FENCE_ROTATOR
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FENCE_ROTATOR"
msgid "What insidious magic. It draws power from eye rolls and groans."
msgstr "Qué magia traicionera. Atrae el poder de los ojos en blanco y se queja."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FERTILIZER
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FERTILIZER"
msgid "It's not gentlemanly to carry manure in one's hands."
msgstr "Un caballero no debe llevar estiércol en las manos."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FESTIVEFISH
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FESTIVEFISH"
msgid "I don't know what's so festive about it."
msgstr "No sé qué tiene de festivo."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FESTIVE_BLUEPRINT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FESTIVE_BLUEPRINT"
msgid "Positively garish."
msgstr "Afirmativamente chillón."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FIG
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FIG"
msgid "A fruit for more refined tastes."
msgstr "Una fruta para los paladares refinados."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FIGATONI
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FIGATONI"
msgid "Exquisite."
msgstr "Exquisito."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FIGKABAB
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FIGKABAB"
msgid "Pleasantly sweet."
msgstr "Agradablemente dulce."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FIG_COOKED
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FIG_COOKED"
msgid "Quite decadent."
msgstr "Bastante decadente."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FIREBALLSTAFF
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FIREBALLSTAFF"
msgid "A staff after my own heart!"
msgstr "¡Un báculo tras mi propio corazón!"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FIRECRACKERS
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FIRECRACKERS"
msgid "Great for magic tricks."
msgstr "Excelente para trucos de magia."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FIREFLIES.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FIREFLIES.GENERIC"
msgid "How pretty."
msgstr "Qué bonitas."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FIREFLIES.HELD
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FIREFLIES.HELD"
msgid "I could squish them if I wanted to."
msgstr "Podría aplastarlas si quisiera."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FIREHOUND
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FIREHOUND"
msgid "I put fire gems in there as a joke."
msgstr "Le coloqué gemas de fuego como broma."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FIRENETTLES
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FIRENETTLES"
msgid "Blasted nettles!"
msgstr "¡Condenadas ortigas!"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FIREPEN
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FIREPEN"
msgid "Words hold power. Pens too, apparently."
msgstr "La palabra es poder. Y las plumas también, aparentemente."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FIREPIT.EMBERS
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FIREPIT.EMBERS"
msgid "I should attend to that."
msgstr "Debería ocuparme de eso."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FIREPIT.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FIREPIT.GENERIC"
msgid "A fire pit."
msgstr "Una hoguera."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FIREPIT.HIGH
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FIREPIT.HIGH"
msgid "A roaring fire."
msgstr "Un fuego crepitante."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FIREPIT.LOW
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FIREPIT.LOW"
msgid "It's getting low."
msgstr "Se está apagando."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FIREPIT.NORMAL
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FIREPIT.NORMAL"
msgid "It's hot."
msgstr "Está caliente."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FIREPIT.OUT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FIREPIT.OUT"
msgid "It's gone cold."
msgstr "Se enfrió."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FIRESTAFF
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FIRESTAFF"
msgid "A basic enchantment, but effective."
msgstr "Un hechizo básico, pero eficaz."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FIRESUPPRESSOR.LOWFUEL
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FIRESUPPRESSOR.LOWFUEL"
msgid "Not much fuel left."
msgstr "No queda mucho combustible."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FIRESUPPRESSOR.OFF
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FIRESUPPRESSOR.OFF"
msgid "Quiet before the storm."
msgstr "La calma antes de la tormenta."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FIRESUPPRESSOR.ON
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FIRESUPPRESSOR.ON"
msgid "Begone, fire!"
msgstr "¡Vete, fuego!"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FISH
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FISH"
msgid "Fresh from the murky depths."
msgstr "Recién salido de las profundidades oscuras."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FISHINGNET
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FISHINGNET"
msgid "Not my preferred way to ensnare enemies."
msgstr "No es mi forma favorita de engatusar a mis enemigos."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FISHINGROD
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FISHINGROD"
msgid "I will eat for a lifetime."
msgstr "Con esto obtendré comida para toda la vida."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FISHMEAT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FISHMEAT"
msgid "Ugh, it's still twitching."
msgstr "Agh, aún se retuerce."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FISHMEAT_COOKED
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FISHMEAT_COOKED"
msgid "Bland... but acceptable."
msgstr "Soso... pero aceptable."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FISHMEAT_SMALL
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FISHMEAT_SMALL"
msgid "I'm reduced to scavenging scraps."
msgstr "Me veo reducido a recolectar lo que pueda."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FISHMEAT_SMALL_COOKED
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FISHMEAT_SMALL_COOKED"
msgid "That was barely an appetizer."
msgstr "Eso fue solo un bocadillo."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FISHSTICKS
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FISHSTICKS"
msgid "These should tide me over."
msgstr "Por el momento me salvan."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FISHTACOS
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FISHTACOS"
msgid "Cooked fish in a crunchy shell."
msgstr "Pescado en una costra crujiente."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FISH_BOX
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FISH_BOX"
msgid "Ugh, the smell... the things I do for a decent meal."
msgstr "Puf, qué olor. Lo que hago por una comida decente."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FISH_COOKED
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FISH_COOKED"
msgid "It still stinks."
msgstr "Todavía apesta."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FLINT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FLINT"
msgid "Ow! I cut my finger!"
msgstr "¡Ay! ¡Me corté el dedo!"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FLOWER.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FLOWER.GENERIC"
msgid "I am filled with the irrational urge to stomp upon it."
msgstr "Tengo la necesidad irracional de pisotearla."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FLOWER.ROSE
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FLOWER.ROSE"
msgid "This is wrong."
msgstr "Esto no está bien."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FLOWERHAT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FLOWERHAT"
msgid "Definitely not my style."
msgstr "Definitivamente no es mi estilo."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FLOWERSALAD
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FLOWERSALAD"
msgid "Leafy goodness."
msgstr "Bondad frondosa."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FLOWER_CAVE
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FLOWER_CAVE"
msgid "It's so dark down here."
msgstr "Está muy oscuro aquí abajo."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FLOWER_EVIL
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FLOWER_EVIL"
msgid "I like that flower."
msgstr "Me gusta esa flor."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FLOWER_WITHERED
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FLOWER_WITHERED"
msgid "It got what it deserved."
msgstr "Tuvo lo que merecía."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FOLIAGE
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FOLIAGE"
msgid "A meal fit for a peasant."
msgstr "Una comida digna de un campesino."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FOOTBALLHAT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FOOTBALLHAT"
msgid "Ready for the scrimmage."
msgstr "Listo para la lucha."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FORGETMELOTS
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FORGETMELOTS"
msgid "Nothing but a common weed."
msgstr "Solo una hierba normal."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FORMAL_BLUEPRINT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FORMAL_BLUEPRINT"
msgid "These garments are absolutely wasted on such base creatures."
msgstr "Es un desperdicio que estas criaturas tengan estos trajes."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FOSSIL_PIECE
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FOSSIL_PIECE"
msgid "Perhaps it is best left in pieces."
msgstr "Tal vez sea mejor dejar las piezas como están."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FOSSIL_STALKER.COMPLETE
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FOSSIL_STALKER.COMPLETE"
msgid "Was it wise to unleash this upon the world?"
msgstr "¿Fue sensato liberar esta criatura en el mundo?"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FOSSIL_STALKER.FUNNY
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FOSSIL_STALKER.FUNNY"
msgid "It will be the laughingstock of the demon community."
msgstr "Será el hazmerreír de la comunidad demoníaca."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FOSSIL_STALKER.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FOSSIL_STALKER.GENERIC"
msgid "The beginnings of some demonic beast."
msgstr "Los orígenes de una bestia demoníaca."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FRESHFRUITCREPES
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FRESHFRUITCREPES"
msgid "Deserves to be eaten with fine silverware. Sadly, I've just my hands."
msgstr "Merece comerse con cubiertos de plata. Por desgracia, solo tengo las manos."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FRIENDLYFRUITFLY
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FRIENDLYFRUITFLY"
msgid "As long as it tends to the garden I'll leave it be."
msgstr "Mientras no salga del jardín, lo dejaré ser."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FROG.DEAD
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FROG.DEAD"
msgid "It croaked."
msgstr "Palmó."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FROG.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FROG.GENERIC"
msgid "It jumps and licks things."
msgstr "Salta y lame cosas."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FROG.SLEEPING
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FROG.SLEEPING"
msgid "It looks tired."
msgstr "Parece cansada."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FROGFISHBOWL
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FROGFISHBOWL"
msgid "At the end of the day, it's still frog."
msgstr "A fin de cuentas, sigue siendo rana."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FROGGLEBUNWICH
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FROGGLEBUNWICH"
msgid "Has a bit of a kick to it."
msgstr "Esto sí que es comida rápida."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FROGLEGS
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FROGLEGS"
msgid "Muscular."
msgstr "Muscular."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FROGLEGS_COOKED
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FROGLEGS_COOKED"
msgid "Stringy."
msgstr "Qué viscosas."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FROGNEWTON
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FROGNEWTON"
msgid "This recipe has legs."
msgstr "La receta tiene patas."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FROZENBANANADAIQUIRI
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FROZENBANANADAIQUIRI"
msgid "There are better beverages to make."
msgstr "Hay mejores bebidas para hacer."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FRUITDRAGON.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FRUITDRAGON.GENERIC"
msgid "They aren't very sociable."
msgstr "No son muy sociables."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FRUITDRAGON.RIPE
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FRUITDRAGON.RIPE"
msgid "I bet it's delicious."
msgstr "Apuesto a que es delicioso."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FRUITDRAGON.SLEEPING
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FRUITDRAGON.SLEEPING"
msgid "Sleep is only a temporary escape."
msgstr "Dormir es solo un escape temporal."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FRUITFLY
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FRUITFLY"
msgid "Begone, pest!"
msgstr "¡Vete, plaga!"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FRUITFLYFRUIT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FRUITFLYFRUIT"
msgid "So this is all it takes to lead."
msgstr "Así que esto es lo que se necesita para liderar."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FRUITMEDLEY
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FRUITMEDLEY"
msgid "This would be great with a simple cheese plate."
msgstr "Estaría bueno junto con un buen plato de quesos."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FURTUFT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FURTUFT"
msgid "Not quite enough for a rug."
msgstr "No es suficiente para una alfombra."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FUSED_SHADELING
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FUSED_SHADELING"
msgid "They grow up so fast."
msgstr "Crecen muy rápido."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FUSED_SHADELING_BOMB
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FUSED_SHADELING_BOMB"
msgid "That is one persistent tail."
msgstr "Es una cola persistente."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.GARGOYLE_HOUND
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.GARGOYLE_HOUND"
msgid "Try and get me now. Ha!"
msgstr "Intenta atraparme ahora. ¡Ja!"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.GARGOYLE_WEREPIG
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.GARGOYLE_WEREPIG"
msgid "Not so tough."
msgstr "No es tan dura."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.GARLIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.GARLIC"
msgid "I suppose that's why there are no vampires around."
msgstr "Supongo que por eso no hay vampiros por aquí."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.GARLIC_COOKED
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.GARLIC_COOKED"
msgid "I wonder if it still wards away the undead."
msgstr "Me pregunto si todavía ahuyenta a los zombis."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.GARLIC_OVERSIZED
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.GARLIC_OVERSIZED"
msgid "An unreasonably enormous clump of garlic."
msgstr "Un trozo de ajo ridículamente enorme."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.GARLIC_SEEDS
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.GARLIC_SEEDS"
msgid "Am I supposed to plant these?"
msgstr "¿Se supone que debo plantarlas?"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.GAZPACHO
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.GAZPACHO"
msgid "It smells much nicer going in than coming back out."
msgstr "Huele mucho mejor entrando que saliendo."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.GEARS
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.GEARS"
msgid "My pets! What has become of you?"
msgstr "¡Mis mascotas! ¿Qué les ha pasado?"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.GELBLOB.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.GELBLOB.GENERIC"
msgid "Blegh."
msgstr "Blegh."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.GELBLOB.HAS_CHARACTER
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.GELBLOB.HAS_CHARACTER"
msgid "This one is occupied."
msgstr "Esta está ocupada."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.GELBLOB.HAS_ITEM
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.GELBLOB.HAS_ITEM"
msgid "Don't expect me to reach in there."
msgstr "No esperes que meta la mano ahí."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.GELBLOB_BOTTLE
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.GELBLOB_BOTTLE"
msgid "Wilson can take it on a picnic."
msgstr "Wilson puede llevarlo a un picnic."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.GELBLOB_STORAGE.FULL
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.GELBLOB_STORAGE.FULL"
msgid "Somebody taste it first!"
msgstr "¡Que alguien la prueba primero!"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.GELBLOB_STORAGE.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.GELBLOB_STORAGE.GENERIC"
msgid "I don't trust that infernal jelly."
msgstr "No confío en esa gelatina infernal."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.GELBLOB_STORAGE_KIT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.GELBLOB_STORAGE_KIT"
msgid "Pass. I don't do sticky."
msgstr "Paso. No me gustan las cosas pegajosas."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.GEMSOCKET.GEMS
