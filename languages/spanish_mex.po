msgstr "Esto llevará todo en la dirección correcta."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.YOTC_CARRAT_GYM_DIRECTION.RAT
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.YOTC_CARRAT_GYM_DIRECTION.RAT"
