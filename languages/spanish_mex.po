msgstr "Qué pegote."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.GELBLOB.HAS_ITEM
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.GELBLOB.HAS_ITEM"
