msgstr "¿Cuánto tarda esto en secarse?"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.MEATRACK.GENERIC
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.MEATRACK.GENERIC"
msgid "I want to hang some meat!"
msgstr "¡Quiero colgar un poco de carne!"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.MEATRACK_HERMIT.BURNT
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.MEATRACK_HERMIT.BURNT"
