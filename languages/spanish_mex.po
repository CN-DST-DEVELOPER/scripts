msgstr "Es un asunto céreo."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.BEESWAX_SPRAY
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.BEESWAX_SPRAY"
