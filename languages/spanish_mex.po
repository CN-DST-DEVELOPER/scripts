msgstr "Solo necesito una multitud furiosa a la cual unirme."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.PLANTMEAT
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.PLANTMEAT"
