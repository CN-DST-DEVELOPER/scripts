msgstr "¡Guau! Qué fácil es hacer amigos."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.BEEGUARD
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.BEEGUARD"
msgid "Puffy flying jerk!"
msgstr "¡Bicho volador gordo y maldito!"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.BEEHAT
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.BEEHAT"
msgid "This will keep the pokeys off of me."
msgstr "Así esos bichos no me picarán."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.BEEHIVE
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.BEEHIVE"
msgid "It's full of bees!"
msgstr "¡Está llena de abejas!"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.BEEMINE
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.BEEMINE"
msgid "Bees inside. Should've put some fire in there for good measure."
msgstr "Tiene abejas dentro. Además debería haberle agregado fuego."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.BEEMINE_MAXWELL
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.BEEMINE_MAXWELL"
msgid "Mosquitoes inside. They don't sound happy."
msgstr "Tiene mosquitos dentro. No parecen muy felices."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.BEEQUEEN
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.BEEQUEEN"
msgid "No amount of honey is worth THAT!"
msgstr "¡Ninguna cantidad de miel vale ESO!"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.BEEQUEENHIVE.GENERIC
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.BEEQUEENHIVE.GENERIC"
