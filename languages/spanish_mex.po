#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.QUAGMIRE_ONION_SEEDS
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.QUAGMIRE_ONION_SEEDS"
msgid "Looks like new crop seeds to me."
msgstr "Parecen semillas de una cosecha nueva."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.QUAGMIRE_OVEN
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.QUAGMIRE_OVEN"
