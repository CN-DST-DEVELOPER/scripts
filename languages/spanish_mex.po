msgid "All my joints... are cracking!"
msgstr "¡Todas las articulaciones... me crujen!"

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_ENCUMBERED.7
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_ENCUMBERED.7"
msgid "I... was a king, you know..!"
msgstr "Fui... rey... ¡ya sabes!"

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_ENCUMBERED.8
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_ENCUMBERED.8"
msgid "Oof... huff..."
msgstr "Uf... Buf..."

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_ENCUMBERED.9
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_ENCUMBERED.9"
msgid "This... better not ruin... my suit."
msgstr "Espero que... no me arruine... el traje."

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_ENGINEERING_CAN_DOWNGRADE
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_ENGINEERING_CAN_DOWNGRADE"
msgid "only_used_by_winona"
msgstr "only_used_by_winona"

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_ENGINEERING_CAN_SIDEGRADE
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_ENGINEERING_CAN_SIDEGRADE"
msgid "only_used_by_winona"
msgstr "only_used_by_winona"

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_ENGINEERING_CAN_UPGRADE
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_ENGINEERING_CAN_UPGRADE"
msgid "only_used_by_winona"
msgstr "only_used_by_winona"

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_ENTER_DARK
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_ENTER_DARK"
msgid "That smell... both nostalgic and terrifying!"
msgstr "¡Ese olor... es nostálgico y aterrador!"

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_ENTER_LIGHT
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_ENTER_LIGHT"
msgid "Thank goodness for the light."
msgstr "Gracias al cielo por la luz."

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_EQUIP_SHADOWLEVEL_T1
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_EQUIP_SHADOWLEVEL_T1"
msgid "What's this? My shadow puppets feel just a bit stronger..."
msgstr "¿Qué es esto? Mis marionetas sombrías se sienten más fuertes."

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_EQUIP_SHADOWLEVEL_T2
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_EQUIP_SHADOWLEVEL_T2"
msgid "I can feel the strength of my shadow puppets growing."
msgstr "¡Puedo sentir la fuerza que crece de mis marionetas sombrías!"

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_EQUIP_SHADOWLEVEL_T3
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_EQUIP_SHADOWLEVEL_T3"
msgid "Go, my shadow puppets! With this power, nothing will stand in our way."
msgstr "¡Adelante, marionetas sombrías! Gracias a su poder, seremos invencibles."

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_EQUIP_SHADOWLEVEL_T4
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_EQUIP_SHADOWLEVEL_T4"
msgid "The shadow puppets I summon will be unstoppable!"
msgstr "¡Las marionetas sombrías que invoque serán imparables!"

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_EXIT_GELBLOB
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_EXIT_GELBLOB"
msgid "Gaah! The horror!"
msgstr "¡Aaaaaah! ¡Qué horror!"

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_EXLIIR_TOO_SUPER
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_EXLIIR_TOO_SUPER"
msgid "That's too stiff a drink."
msgstr ""

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_EYEOFTERROR_ARRIVE
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_EYEOFTERROR_ARRIVE"
msgid "Oh, what a magnificent horror."
msgstr "¡Ohh, magnífico terror!"

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_EYEOFTERROR_FLYAWAY
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_EYEOFTERROR_FLYAWAY"
msgid "It'll be back."
msgstr "Volverá."

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_EYEOFTERROR_FLYBACK
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_EYEOFTERROR_FLYBACK"
msgid "I've been awaiting your return. Let's end this."
msgstr "¡Te estaba esperando! Acabemos con esto."

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_FAN_OUT
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_FAN_OUT"
msgid "There goes my respite."
msgstr "Bueno, adiós a mi alivio."

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_FERTILIZER_RESEARCHED
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_FERTILIZER_RESEARCHED"
msgid "I'm growing more knowledgeable than I'd care to be about this stuff."
msgstr "Estoy aprendiendo más sobre este tema de lo que realmente quisiera."

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_FIRENETTLE_TOXIN.1
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_FIRENETTLE_TOXIN.1"
msgid "Ack, those infernal nettles!"
msgstr "¡Agh, estas ortigas infernales!"

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_FIRENETTLE_TOXIN.2
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_FIRENETTLE_TOXIN.2"
msgid "The nettle's poison is burning in my veins!"
msgstr "¡El veneno de la ortiga me está quemando fuerte!"

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_FIRENETTLE_TOXIN_DONE
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_FIRENETTLE_TOXIN_DONE"
msgid "The worst has passed."
msgstr "Ya pasó lo peor."

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_FLARE_SEEN
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_FLARE_SEEN"
msgid "Am I supposed to come running every time I spot a flare?"
msgstr "¿Se supone que debo venir corriendo cada vez que veo una bengala?"

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_FOODMEMORY
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_FOODMEMORY"
msgid "only_used_by_warly"
msgstr "only_used_by_warly"

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_FREEDOM
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_FREEDOM"
msgid "Freedom, at last!"
msgstr "¡Libre, al fin!"

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_GATHER_MERM
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_GATHER_MERM"
msgid "only_used_by_wurt"
msgstr "only_used_by_wurt"

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_GHOSTDRAIN
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_GHOSTDRAIN"
msgid "They're whispering through the core of my mind...!"
msgstr "¡Susurran hasta el centro de mi mente...!"

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_GHOST_QUEST
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_GHOST_QUEST"
msgid "only_used_by_wendy"
msgstr "only_used_by_wendy"

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_HEALINGSALVE_ACIDBUFF_DONE
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_HEALINGSALVE_ACIDBUFF_DONE"
msgid "I'd better not take a stroll in the acid rain anytime soon."
msgstr "Mejor si me mantengo lejos de la lluvia ácida por un tiempo."

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_HIGHRESEARCH
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_HIGHRESEARCH"
msgid "My brain swells with power!"
msgstr "¡Mi cerebro crece con el poder!"

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_HOT
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_HOT"
msgid "My heart can't stand the heat!"
msgstr "¡Mi corazón no puede soportar el calor!"

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_HOUNDS
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_HOUNDS"
msgid "The hounds are growing restless."
msgstr "Los sabuesos están cada vez más agitados."

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_HUNGRY
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_HUNGRY"
msgid "I am empty inside."
msgstr "Estoy vacío por dentro."

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_HUNT_AVOID_FORK
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_HUNT_AVOID_FORK"
msgid "I'll stick to hunting less dangerous game."
msgstr "Intentaré cazar menos cosas peligrosas."

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_HUNT_BEAST_NEARBY
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_HUNT_BEAST_NEARBY"
msgid "I smell dung and beast sweat."
msgstr "Huelo el estiércol y el sudor de la bestia."

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_HUNT_LOST_TRAIL
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_HUNT_LOST_TRAIL"
msgid "Drat! It got away."
msgstr "¡Maldición! Se me ha escapado."

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_HUNT_LOST_TRAIL_SPRING
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_HUNT_LOST_TRAIL_SPRING"
msgid "I can't follow it in these conditions!"
msgstr "¡No puedo seguirlo en estas condiciones!"

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_HUNT_START_FORK
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_HUNT_START_FORK"
msgid "Those vicious claw marks do not bode well..."
msgstr "Estas marcas de garras no son un buen augurio."

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_HUNT_SUCCESSFUL_FORK
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_HUNT_SUCCESSFUL_FORK"
msgid "The creature is unaware it's being pursued. Now, to strike."
msgstr "La criatura no sabe que la estamos siguiendo. Ahora, al ataque."

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_HUNT_WRONG_FORK
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_HUNT_WRONG_FORK"
msgid "I fear I might have underestimated my prey..."
msgstr "Me temo que subestimé a mi presa..."

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_INSUFFICIENTFERTILIZER
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_INSUFFICIENTFERTILIZER"
msgid "It perked up just a tiny bit."
msgstr "Ha crecido solo un poquito."

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_INV_FULL
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_INV_FULL"
msgid "My pockets are full."
msgstr "Tengo los bolsillos llenos."

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_IS_FEASTING
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_IS_FEASTING"
msgid "At last, a decent meal."
msgstr "Por fin, una comida decente."

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_KITCOON_FOUND_IN_THE_WILD
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_KITCOON_FOUND_IN_THE_WILD"
msgid "So you're the source of that pathetic mewling. I'll have to apologize to the strongman."
msgstr "Así que tú eres el culpable del patético lloriqueo. Tendré que disculparme con el forzudo."

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_KITCOON_HIDANDSEEK_FOUND.1
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_KITCOON_HIDANDSEEK_FOUND.1"
msgid "A-ha! Not sneaky enough!"
msgstr "¡Ajá! ¡No tan astuto!"

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_KITCOON_HIDANDSEEK_FOUND.2
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_KITCOON_HIDANDSEEK_FOUND.2"
msgid "Found you!"
msgstr "¡Te encontré!"

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_KITCOON_HIDANDSEEK_FOUND.3
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_KITCOON_HIDANDSEEK_FOUND.3"
msgid "You were not clever enough to best the great Maxwell!!"
msgstr "¡Te falto perspicacia para superar al gran Maxwell!"

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_KITCOON_HIDANDSEEK_FOUND.4
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_KITCOON_HIDANDSEEK_FOUND.4"
msgid "Your attempt to escape me has been thwarted, child!"
msgstr "¡Has perdido tu oportunidad de escapar, pequeño!"

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_KITCOON_HIDANDSEEK_FOUND_LAST_ONE
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_KITCOON_HIDANDSEEK_FOUND_LAST_ONE"
msgid "A-ha! That was the last one! I win!!!"
msgstr "¡Ajá! ¡Ese fue el último! ¡¡Gane!!"

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_KITCOON_HIDANDSEEK_FOUND_LAST_ONE_TEAM
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_KITCOON_HIDANDSEEK_FOUND_LAST_ONE_TEAM"
msgid "I had seen it already, but {name} got to it first, I suppose."
msgstr "Yo ya lo había visto, pero {name} llegó antes, supongo."

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_KITCOON_HIDANDSEEK_FOUND_ONE_MORE
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_KITCOON_HIDANDSEEK_FOUND_ONE_MORE"
msgid "Only one remains."
msgstr "Solo me queda uno."

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_KITCOON_HIDANDSEEK_LOSEGAME
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_KITCOON_HIDANDSEEK_LOSEGAME"
msgid "Blast it!"
msgstr "¡Maldita sea!"

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_KITCOON_HIDANDSEEK_TIME_ALMOST_UP
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_KITCOON_HIDANDSEEK_TIME_ALMOST_UP"
msgid "Where are those blasted kittens!"
msgstr "¿Dónde están esos gatitos detestables?"

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_KITCOON_HIDANDSEEK_TOOFAR
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_KITCOON_HIDANDSEEK_TOOFAR"
msgid "I doubt those tiny, pathetic legs would carry them this far."
msgstr "Dudo que hayan ido muy lejos con sus patéticas patitas."

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_KITCOON_HIDANDSEEK_TOOFAR_RETURN
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_KITCOON_HIDANDSEEK_TOOFAR_RETURN"
msgid "This seems much more likely an area to find the kitcoons."
msgstr "Esta parece una zona donde sí podría encontrar gataches."

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_KITCOON_HIDEANDSEEK_JOIN
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_KITCOON_HIDEANDSEEK_JOIN"
msgid "Of course you need my help."
msgstr "Es obvio que necesitas mi ayuda."

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_KITCOON_HIDEANDSEEK_START
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_KITCOON_HIDEANDSEEK_START"
msgid "I suppose we shall begin this ridiculous game."
msgstr "Supongo que tendremos que empezar este juego ridículo."

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_KLAUS_CALLFORHELP
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_KLAUS_CALLFORHELP"
msgid "The coward has summoned its minions."
msgstr "El cobarde invocó a sus súbditos."

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_KLAUS_ENRAGE
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_KLAUS_ENRAGE"
msgid "Time to beat a hasty retreat!"
msgstr "¡Hora de batirse en rápida retirada!"

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_KLAUS_UNCHAINED
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_KLAUS_UNCHAINED"
msgid "Its true power has been unlocked!"
msgstr "¡Se desbloqueó su verdadero poder!"

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_KNOCKEDOUT
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_KNOCKEDOUT"
msgid "Ugh. My head hurts."
msgstr "Uf. Me duele la cabeza."

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_LIGHTNING_DAMAGE_AVOIDED
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_LIGHTNING_DAMAGE_AVOIDED"
msgid "Can't touch this!"
msgstr "¡No toques esto!"

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_LOWRESEARCH
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_LOWRESEARCH"
msgid "That wasn't very informative."
msgstr "Eso no fue muy informativo."

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_LUNAR_RIFT_MAX
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_LUNAR_RIFT_MAX"
msgid "Something has changed..."
msgstr "Algo ha cambiado..."

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_MEGA_FLARE_SEEN
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_MEGA_FLARE_SEEN"
msgid "That flare's going to send some poor fool into a world of trouble."
msgstr "Esa bengala le traerá muchos problemas a algún pobre idiota."

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_MONKEY_CURSE_1
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_MONKEY_CURSE_1"
msgid "I've just had the most unpleasant feeling..."
msgstr "Acabo de tener una muy mala sensación..."

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_MONKEY_CURSE_CHANGE
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_MONKEY_CURSE_CHANGE"
msgid "A monkey? Have I not suffered enough humiliation already?!"
msgstr "¿Un mono? ¿Acaso no sufrí ya demasiada humillación?"

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_MONKEY_CURSE_CHANGEBACK
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_MONKEY_CURSE_CHANGEBACK"
msgid "Nobody. Bring this up. Again."
msgstr "Nadie. Tráelo de vuelta."

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_MOONALTAR_MINE.GLASS_LOW
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_MOONALTAR_MINE.GLASS_LOW"
msgid "I must have your knowledge."
msgstr "Debo hacerme con tus conocimientos."

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_MOONALTAR_MINE.GLASS_MED
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_MOONALTAR_MINE.GLASS_MED"
msgid "I hear you in there."
msgstr "Te oigo ahí dentro."

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_MOONALTAR_MINE.GLASS_REVEAL
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_MOONALTAR_MINE.GLASS_REVEAL"
msgid "A-ha!"
msgstr "¡Ajá!"

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_MOONALTAR_MINE.IDOL_LOW
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_MOONALTAR_MINE.IDOL_LOW"
msgid "I must have your knowledge."
msgstr "Debo hacerme con tus conocimientos."

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_MOONALTAR_MINE.IDOL_MED
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_MOONALTAR_MINE.IDOL_MED"
msgid "I hear you in there."
msgstr "Te oigo ahí dentro."

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_MOONALTAR_MINE.IDOL_REVEAL
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_MOONALTAR_MINE.IDOL_REVEAL"
msgid "A-ha!"
msgstr "¡Ajá!"

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_MOONALTAR_MINE.SEED_LOW
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_MOONALTAR_MINE.SEED_LOW"
msgid "I must have your knowledge."
msgstr "Debo hacerme con tus conocimientos."

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_MOONALTAR_MINE.SEED_MED
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_MOONALTAR_MINE.SEED_MED"
msgid "I hear you in there."
msgstr "Te oigo ahí dentro."

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_MOONALTAR_MINE.SEED_REVEAL
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_MOONALTAR_MINE.SEED_REVEAL"
msgid "A-ha!"
msgstr "¡Ajá!"

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_MOONPOTION_FAILED
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_MOONPOTION_FAILED"
msgid "How disappointing."
msgstr "Qué decepcionante."

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_MOSQUITOS
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_MOSQUITOS"
msgid "What annoying little bugs."
msgstr "Que bichitos más molestos."

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_MOUNT_LOWHEALTH
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_MOUNT_LOWHEALTH"
msgid "Say, pal, you don't look so good."
msgstr "Camarada, no luces muy bien."

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_NODANGERGIFT
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_NODANGERGIFT"
msgid "That's a terrible idea right now."
msgstr "Esa es una idea terrible ahora mismo."

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_NODANGERSIESTA
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_NODANGERSIESTA"
msgid "They're hot on my heels!"
msgstr "¡Me están pisando los talones!"

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_NODANGERSLEEP
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_NODANGERSLEEP"
msgid "Not while there's danger afoot!"
msgstr "¡No mientras haya peligro cerca!"

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_NODAYSLEEP
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_NODAYSLEEP"
msgid "I can't sleep during daylight hours."
msgstr "No puedo dormir durante el día."

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_NODAYSLEEP_CAVE
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_NODAYSLEEP_CAVE"
msgid "Sleeping now would mess up my sleep schedule!"
msgstr "¡Si duermo ahora, arruinaré mi patrón de sueño!"

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_NOHUNGERSIESTA
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_NOHUNGERSIESTA"
msgid "Traditionally, a siesta comes after eating, not before."
msgstr "Por costumbre, una siesta viene después de comer, no antes."

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_NOHUNGERSLEEP
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_NOHUNGERSLEEP"
msgid "I'm too hungry. I can't sleep."
msgstr "Tengo mucha hambre. No puedo dormir."

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_NOMOUNTEDGIFT
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_NOMOUNTEDGIFT"
msgid "I'm not opening that on top of this thing."
msgstr "No voy a abrir eso sobre esta cosa."

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_NONIGHTSIESTA
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_NONIGHTSIESTA"
msgid "It's sleep time, not siesta time."
msgstr "Es hora de dormir, no hora de la siesta."

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_NONIGHTSIESTA_CAVE
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_NONIGHTSIESTA_CAVE"
msgid "It's a bit creepy out for that."
msgstr "Está un poco espeluznante ahí afuera."

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_NOPUMPKINCARVINGONFIRE
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_NOPUMPKINCARVINGONFIRE"
msgid "That's what I get for engaging in foolery."
msgstr ""

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_NOSLEEPHASPERMANENTLIGHT
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_NOSLEEPHASPERMANENTLIGHT"
msgid "Oh for... would you turn that blasted light off?!"
msgstr "Por todos los... ¿Podrías apagar esa condenada luz?"

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_NOSLEEPONFIRE
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_NOSLEEPONFIRE"
msgid "That might not be the best idea."
msgstr "Quizá no sea la mejor idea."

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_NOWARDROBEONFIRE
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_NOWARDROBEONFIRE"
msgid "You're kidding right?"
msgstr "Estás bromeando, ¿verdad?"

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_NO_ABIGAIL_FLOWER
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_NO_ABIGAIL_FLOWER"
msgid "only_used_by_wendy"
msgstr "only_used_by_wendy"

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_NO_TRAP
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_NO_TRAP"
msgid "Odd. They forgot to set it."
msgstr "Qué raro. Se olvidaron de activarla."

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_OCEANFISHING_BADCAST
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_OCEANFISHING_BADCAST"
msgid "That was, of course, just a warm up..."
msgstr "Eso, por supuesto, era un mero calentamiento."

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_OCEANFISHING_GOTAWAY
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_OCEANFISHING_GOTAWAY"
msgid "We will meet again, mark my words..."
msgstr "Volveremos a encontrarnos, recuerda lo que te digo."

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_OCEANFISHING_IDLE_QUOTE.1
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_OCEANFISHING_IDLE_QUOTE.1"
msgid "I must exercise patience."
msgstr "Debo ejercitar la paciencia."

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_OCEANFISHING_IDLE_QUOTE.2
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_OCEANFISHING_IDLE_QUOTE.2"
msgid "I daresay, this is almost relaxing."
msgstr "Me atrevo a decir que esto es casi relajante."

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_OCEANFISHING_IDLE_QUOTE.3
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_OCEANFISHING_IDLE_QUOTE.3"
msgid "Why won't they take the bait? Perhaps I should offer secret knowledge..."
msgstr "¿Por qué no muerden el anzuelo? Quizás debería ofrecerles conocimientos secretos..."

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_OCEANFISHING_IDLE_QUOTE.4
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_OCEANFISHING_IDLE_QUOTE.4"
msgid "I am beginning to tire of all this waiting."
msgstr "Me estoy empezando a cansar de tanto esperar."

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_OCEANFISHING_LINESNAP
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_OCEANFISHING_LINESNAP"
msgid "Blast! That cad-fish got away with my tackle!"
msgstr "¡Maldición! ¡Ese sinvergüenza se escapó con mis aparejos!"

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_OCEANFISHING_LINETOOLOOSE
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_OCEANFISHING_LINETOOLOOSE"
msgid "The line needs more tension."
msgstr "La tanza tiene que estar más tensa."

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_OCEAN_SILHOUETTE_INCOMING
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_OCEAN_SILHOUETTE_INCOMING"
msgid "We're in for some trouble."
msgstr "Vamos a tener problemas."

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_OFF_SCRIPT
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_OFF_SCRIPT"
msgid "She won't like that."
msgstr "No le gustará eso."

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_OTTERBOAT_DENBROKEN
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_OTTERBOAT_DENBROKEN"
msgid "Those accursed creatures! The den was all that held this platform together!"
msgstr "¡Criaturas detestables! ¡Ese cubil era el que sostenía todo!"

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_OTTERBOAT_OUTOFSHALLOWS
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_OTTERBOAT_OUTOFSHALLOWS"
msgid "Ah. So it's not seaworthy after all."
msgstr "Ah, así que no es digno del mar, después de todo."

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_PECKED
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_PECKED"
msgid "Have patience!"
msgstr "¡Ten paciencia!"

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_PETRIFED_TREES
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_PETRIFED_TREES"
msgid "Oh, this should be good."
msgstr "Oh, esto debe ser bueno."

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_PICK_DISEASE_WARNING
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_PICK_DISEASE_WARNING"
msgid "How putrid!"
msgstr "¡Qué putrefacción!"

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_PIRATES_ARRIVE
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_PIRATES_ARRIVE"
msgid "I don't like the sound of that..."
msgstr "No me gusta cómo suena eso."

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_PLANT_RANDOMSEED
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_PLANT_RANDOMSEED"
msgid "It had better grow into something worthwhile."
msgstr "Más le vale que haya crecido en algo que valga la pena."

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_PLANT_RESEARCHED.1
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_PLANT_RESEARCHED.1"
msgid "This plant's secrets are revealing themselves to me."
msgstr "Los secretos de esta planta se están revelando ante mí."

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_POCKETWATCH_PORTAL
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_POCKETWATCH_PORTAL"
msgid "Oh ha-ha, laugh it up. I wouldn't have landed on my rump if the witch knew how to navigate!"
msgstr "¡Ah, ja, ja! ¡Ustedes ríanse, pero no hubiera aterrizado de cabeza si la bruja supiera navegar!"

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_PREFALLINVOID
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_PREFALLINVOID"
msgid "That's not good."
msgstr "Eso no es bueno."

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_QUAKE
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_QUAKE"
msgid "That rumbling can't be good."
msgstr "Ese ruido no puede ser bueno."

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_RABBITKINGHORN_BADSPAWNPOINT
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_RABBITKINGHORN_BADSPAWNPOINT"
msgid "Typical rabbit. Never there when you need them."
msgstr "Típico de los conejos. Nunca están cuando uno los necesita."

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_RABBITKING_AGGRESSIVE
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_RABBITKING_AGGRESSIVE"
msgid "A frenzy of activity underfoot."
msgstr "Abajo hay un hervidero de actividad."

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_RABBITKING_LUCKY
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_RABBITKING_LUCKY"
msgid "Simon, you rapscallion!"
msgstr "¡Simon, eres un granuja!"

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_RABBITKING_LUCKYCAUGHT
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_RABBITKING_LUCKYCAUGHT"
msgid "I've got you now, Simon!"
msgstr "¡Te tengo, Simon!"

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_RABBITKING_PASSIVE
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_RABBITKING_PASSIVE"
msgid "Some crawling creature beneath us, no doubt."
msgstr "Abajo de nosotros se arrastran criaturas, sin duda."

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_REPELLED
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_REPELLED"
msgid "What trickery is this!"
msgstr "¡Qué clase de artimaña es esta!"

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_RESEARCH
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_RESEARCH"
msgid "Knowledge is power. And power is... well, power."
msgstr "El conocimiento es poder. Y el poder es... poder."

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_REVIVED_FROM_CORPSE
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_REVIVED_FROM_CORPSE"
msgid "That was simply undignified."
msgstr "Eso fue simplemente indigno."

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_REVIVED_OTHER_CORPSE
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_REVIVED_OTHER_CORPSE"
msgid "No need to thank me."
msgstr "No hace falta que me agradezcas."

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_REVIVING_CORPSE
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_REVIVING_CORPSE"
msgid "Allow me to assist."
msgstr "Deja que te ayude."

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_RUINS_RESET
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_RUINS_RESET"
msgid "The cycle begins again."
msgstr "El ciclo comienza de nuevo."

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_SACREDCHEST_NO
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_SACREDCHEST_NO"
msgid "It's deemed me unworthy."
msgstr "Me considera indigno."

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_SACREDCHEST_YES
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_SACREDCHEST_YES"
msgid "Was there ever a doubt?"
msgstr "¿Hubo una pizca de duda alguna vez?"

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_SCRAPBOOK_FULL
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_SCRAPBOOK_FULL"
msgid "I know all I need to already."
msgstr "Ya sé todo lo que necesito saber."

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_SHADOWLEVEL_ITEM
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_SHADOWLEVEL_ITEM"
msgid "\nMy shadow puppets should be able to draw from its power..."
msgstr "\nLas marionetas sombrías deberían poder extraer su poder..."

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_SHADOWTHRALL_STEALTH
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_SHADOWTHRALL_STEALTH"
msgid "Who bit me? Show yourself, coward!"
msgstr "¿Quién me mordió? ¡Muéstrate, cobarde!"

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_SHADOW_RIFT_MAX
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_SHADOW_RIFT_MAX"
msgid "Something's stirring..."
msgstr "Hay algo moviéndose..."

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_SHELTER
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_SHELTER"
msgid "Protect me, cursed tree!"
msgstr "¡Protégeme, árbol maldito!"

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_SISTURN_FULL_BLOSSOM
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_SISTURN_FULL_BLOSSOM"
msgid "only_used_by_wendy"
msgstr "only_used_by_wendy"

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_SISTURN_FULL_EVIL
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_SISTURN_FULL_EVIL"
msgid "only_used_by_wendy"
msgstr "only_used_by_wendy"

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_SNARED
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_SNARED"
msgid "How dare you!"
msgstr "¡Cómo te atreves!"

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_SNARED_IVY
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_SNARED_IVY"
msgid "Wretched greenery! Release me at once!"
msgstr "¡Perversa vegetación! ¡Suéltame ahora mismo!"

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_SNOWBALL_NO_SNOW
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_SNOWBALL_NO_SNOW"
msgid "There's no snow here."
msgstr ""

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_SNOWBALL_TOO_BIG
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_SNOWBALL_TOO_BIG"
msgid "Useless! It won't get any bigger."
msgstr ""

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_SOAKED
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_SOAKED"
msgid "Wetter than water itself."
msgstr "Más húmedo que el agua misma."

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_SPOOKED
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_SPOOKED"
msgid "Quite an expert illusion."
msgstr "Una ilusión bastante exquisita."

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_TALK_TO_PLANTS.1
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_TALK_TO_PLANTS.1"
msgid "I feel ridiculous. Is this really supposed to help it grow?"
msgstr "Me siento ridículo. ¿En serio las ayuda a crecer?"

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_TALK_TO_PLANTS.2
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_TALK_TO_PLANTS.2"
msgid "Grow faster, you blasted thing! There, did that help?"
msgstr "¡Crece más rápido, planta miserable! Ya ves, ¿sirvió de algo?"

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_TALK_TO_PLANTS.3
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_TALK_TO_PLANTS.3"
msgid "You know, I ruled over this entire world once. Now I'm talking to a plant."
msgstr "Alguna vez dominé el planeta entero. Hoy, le hablo a una planta."

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_TALK_TO_PLANTS.4
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_TALK_TO_PLANTS.4"
msgid "Say pal, do you like magic tricks? This is the one where I talk and you grow."
msgstr "¡Hola! ¿Te gustan los trucos de magia? Perfecto, entonces yo te hablo y tú creces."

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_TALK_TO_PLANTS.5
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_TALK_TO_PLANTS.5"
msgid "Here I am, chatting it up with the vegetation."
msgstr "Así estoy, charlando con las frutas y verduras."

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_THORNS
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_THORNS"
msgid "I scratched my arms up doing that."
msgstr "Me arañé los brazos haciendo eso."

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_THURIBLE_OUT
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_THURIBLE_OUT"
msgid "A shame."
msgstr "Una pena."

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_TICOON_ABANDONED
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_TICOON_ABANDONED"
msgid "Fine! Begone! The Great Maxwell doesn't need help for a simple child's game."
msgstr "¡Bien! ¡Lárgate! ¡El gran Maxwell no necesita ayuda para un juego de niños!"

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_TICOON_DEAD
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_TICOON_DEAD"
msgid "That foolish creature! This may prove to be a setback..."
msgstr "¡Criatura idiota! Esto puede ser un contratiempo."

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_TICOON_GET_LEADER_ATTENTION
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_TICOON_GET_LEADER_ATTENTION"
msgid "Can't you see I'm busy, rodent!? ...My apologies. Where were we?"
msgstr "¿No ves que estoy ocupado, roedor? Disculpa, ¿dónde estábamos?"

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_TICOON_LOST_KITCOON
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_TICOON_LOST_KITCOON"
msgid "Drat, someone found this kitcoon before us."
msgstr "Maldición, alguien encontró este gatache antes que nosotros."

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_TICOON_NEAR_KITCOON
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_TICOON_NEAR_KITCOON"
msgid "Ah, we must be near a kitcoon..."
msgstr "Ahh, debemos estar cerca de un gatache..."

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_TICOON_NOTHING_TO_TRACK
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_TICOON_NOTHING_TO_TRACK"
msgid "Nothing??? Useless animal!"
msgstr "¿Nada? ¡Animal inútil!"

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_TICOON_START_TRACKING
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_TICOON_START_TRACKING"
msgid "Yes, good... lead me to the kitcoons."
msgstr "Sí, muy bien... Llévame a los gataches."

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_TICOON_WAITING_FOR_LEADER
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_TICOON_WAITING_FOR_LEADER"
msgid "Even a creature of your stature knows to wait for its superiors."
msgstr "Incluso una criatura de tu estatura sabe esperar a sus superiores."

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_TOADESCAPED
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_TOADESCAPED"
msgid "It fled back into the earth."
msgstr "Se ha escondido de nuevo en la tierra."

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_TOADESCAPING
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_TOADESCAPING"
msgid "Now is the time to strike!"
msgstr "¡Ahora es momento de atacar!"

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_TOOL_SLIP
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_TOOL_SLIP"
msgid "Drat."
msgstr "Maldición."

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_TOOL_TOOWEAK
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_TOOL_TOOWEAK"
msgid "I'll need a more powerful tool."
msgstr "Necesitaré una herramienta más potente."

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_TORCH_OUT
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_TORCH_OUT"
msgid "Curses. Another light down."
msgstr "Maldita sea. Otra antorcha apagada."

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_TOWNPORTALTELEPORT
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_TOWNPORTALTELEPORT"
msgid "It's about time."
msgstr "Ya es hora."

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_TRAP_WENT_OFF
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_TRAP_WENT_OFF"
msgid "Ack!"
msgstr "¡Agh!"

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_UNIMPLEMENTED
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_UNIMPLEMENTED"
msgid "Hmm, not quite done."
msgstr "Hmm, aún no está terminado."

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_WASHED_ASHORE
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_WASHED_ASHORE"
msgid "My suit is drenched in salt water."
msgstr "Tengo el traje empapado en agua salada."

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_WEAK_RAT
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_WEAK_RAT"
msgid "The creature is past its prime."
msgstr "La criatura ya no está en su mejor momento."

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_WEIGHT
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_WEIGHT"
msgid "Weight: {weight}"
msgstr "Peso: {weight}"

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_WEIGHT_HEAVY
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_WEIGHT_HEAVY"
msgid "Weight: {weight}\nEr... I don't suppose anyone would help me carry this?"
msgstr "Peso: {weight}\nEm... ¿Me ayudaría alguien a cargar con esto?"

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_WENDY_BABYSITTER_SET
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_WENDY_BABYSITTER_SET"
msgid "only_used_by_wendy"
msgstr "only_used_by_wendy"

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_WENDY_BABYSITTER_STOP
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_WENDY_BABYSITTER_STOP"
msgid "only_used_by_wendy"
msgstr "only_used_by_wendy"

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_WET
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_WET"
msgid "Water'll ruin a good suit, you know?"
msgstr "El agua arruina un buen traje, ¿sabes?"

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_WETTER
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_WETTER"
msgid "I don't think I'll ever be dry again."
msgstr "No creo que me vaya a secar nunca."

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_WINCH_CLAW_MISS
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_WINCH_CLAW_MISS"
msgid "Foiled again!"
msgstr "¡Otro fiasco!"

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_WINCH_CLAW_NO_ITEM
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_WINCH_CLAW_NO_ITEM"
msgid "I don't know what I expected."
msgstr "No sé qué esperaba."

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_WINTERS_FEAST_BUFF
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_WINTERS_FEAST_BUFF"
msgid "That food seems to have had an odd affect on me..."
msgstr "Parece que esa comida tuvo extraño efecto sobre mí."

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_WINTERS_FEAST_BUFF_OVER
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_WINTERS_FEAST_BUFF_OVER"
msgid "Its power was short-lived."
msgstr "Su energía duró poco."

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_WOLFGANG_BEGIN_COACHING
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_WOLFGANG_BEGIN_COACHING"
msgid "only_used_by_wolfgang"
msgstr "only_used_by_wolfgang"

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_WOLFGANG_END_COACHING
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_WOLFGANG_END_COACHING"
msgid "only_used_by_wolfgang"
msgstr "only_used_by_wolfgang"

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_WOLFGANG_MIGHTY_COACHING
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_WOLFGANG_MIGHTY_COACHING"
msgid "only_used_by_wolfgang"
msgstr "only_used_by_wolfgang"

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_WOLFGANG_NOTEAM.1
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_WOLFGANG_NOTEAM.1"
msgid "only_used_by_wolfgang"
msgstr "only_used_by_wolfgang"

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_WOLFGANG_NOTEAM.2
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_WOLFGANG_NOTEAM.2"
msgid "only_used_by_wolfgang"
msgstr "only_used_by_wolfgang"

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_WOLFGANG_NOTEAM.3
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_WOLFGANG_NOTEAM.3"
msgid "only_used_by_wolfgang"
msgstr "only_used_by_wolfgang"

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_WOLFGANG_WIMPY_COACHING
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_WOLFGANG_WIMPY_COACHING"
msgid "only_used_by_wolfgang"
msgstr "only_used_by_wolfgang"

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_WORMHOLE
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_WORMHOLE"
msgid "Yech. It's horrible in there."
msgstr "Ay. Qué horrible es estar ahí."

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_WORMS
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_WORMS"
msgid "Oh dear. I know what's making that sound."
msgstr "Ay, no. Sé lo que significa ese sonido."

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_WORMS_BOSS
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_WORMS_BOSS"
msgid "Curses. I know that sound."
msgstr "Rayos. Conozco ese sonido."

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_WORTOX_REVIVER_FAILTELEPORT
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_WORTOX_REVIVER_FAILTELEPORT"
msgid "Surprise, surprise."
msgstr "Sorpresa."

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_WX_SCANNER_NEW_FOUND
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_WX_SCANNER_NEW_FOUND"
msgid "only_used_by_wx78"
msgstr "only_used_by_wx78"

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_YOTB_LEARN_NEW_PATTERN
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_YOTB_LEARN_NEW_PATTERN"
msgid "At last, something new."
msgstr "Por fin, algo nuevo."

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_YOTD_NOBOATS
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_YOTD_NOBOATS"
msgid "Oh, I'm not close enough to the starting point? Well maybe it should come to me!"
msgstr "¿Ah? ¿Así que no estoy cerca del punto de partida? ¡Entonces que se me acerque!"

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_YOTD_NOCHECKPOINTS
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_YOTD_NOCHECKPOINTS"
msgid "I think you're forgetting something, pal."
msgstr "Creo que te olvidas de algo, camarada."

#. STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_YOTD_NOTENOUGHBOATS
msgctxt "STRINGS.CHARACTERS.WAXWELL.ANNOUNCE_YOTD_NOTENOUGHBOATS"
msgid "Perhaps some space should be cleared around the Start Tower."
msgstr "A lo mejor deberíamos hacer espacio cerca de la torre de salida."

#. STRINGS.CHARACTERS.WAXWELL.BATTLECRY.DEER
msgctxt "STRINGS.CHARACTERS.WAXWELL.BATTLECRY.DEER"
msgid "You do not belong in MY world!"
msgstr "¡No perteneces a MI mundo!"

#. STRINGS.CHARACTERS.WAXWELL.BATTLECRY.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.BATTLECRY.GENERIC"
msgid "To arms!"
msgstr "¡A pelear!"

#. STRINGS.CHARACTERS.WAXWELL.BATTLECRY.PIG
msgctxt "STRINGS.CHARACTERS.WAXWELL.BATTLECRY.PIG"
msgid "Brains over brawn!"
msgstr "¡Más vale maña que fuerza!"

#. STRINGS.CHARACTERS.WAXWELL.BATTLECRY.PREY
msgctxt "STRINGS.CHARACTERS.WAXWELL.BATTLECRY.PREY"
msgid "Sacrifice yourself for my comfort!"
msgstr "¡Sacrifícate por mi comodidad!"

#. STRINGS.CHARACTERS.WAXWELL.BATTLECRY.SPIDER
msgctxt "STRINGS.CHARACTERS.WAXWELL.BATTLECRY.SPIDER"
msgid "I'll not be made a fool of!"
msgstr "¡No haré el ridículo!"

#. STRINGS.CHARACTERS.WAXWELL.BATTLECRY.SPIDER_WARRIOR
msgctxt "STRINGS.CHARACTERS.WAXWELL.BATTLECRY.SPIDER_WARRIOR"
msgid "You've forced my hand!"
msgstr "¡Has provocado a mi mano!"

#. STRINGS.CHARACTERS.WAXWELL.COMBAT_QUIT.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.COMBAT_QUIT.GENERIC"
msgid "And stay away!"
msgstr "¡Y no te acerques!"

#. STRINGS.CHARACTERS.WAXWELL.COMBAT_QUIT.PIG
msgctxt "STRINGS.CHARACTERS.WAXWELL.COMBAT_QUIT.PIG"
msgid "Next time, pig!"
msgstr "¡La próxima vez, cerdo!"

#. STRINGS.CHARACTERS.WAXWELL.COMBAT_QUIT.PREY
msgctxt "STRINGS.CHARACTERS.WAXWELL.COMBAT_QUIT.PREY"
msgid "You're not worth my time!"
msgstr "¡No eres digno de mi tiempo!"

#. STRINGS.CHARACTERS.WAXWELL.COMBAT_QUIT.SPIDER
msgctxt "STRINGS.CHARACTERS.WAXWELL.COMBAT_QUIT.SPIDER"
msgid "I won't be made a fool of... next time!"
msgstr "¡La próxima vez... no me dejarás en ridículo!"

#. STRINGS.CHARACTERS.WAXWELL.COMBAT_QUIT.SPIDER_WARRIOR
msgctxt "STRINGS.CHARACTERS.WAXWELL.COMBAT_QUIT.SPIDER_WARRIOR"
msgid "Next time the gloves come off!"
msgstr "¡La próxima vez me quitaré los guantes!"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ABIGAIL.LEVEL1.1
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ABIGAIL.LEVEL1.1"
msgid "Quite the precocious poltergeist, aren't you?"
msgstr "Un espectro bastante precoz, ¿no crees?"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ABIGAIL.LEVEL1.2
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ABIGAIL.LEVEL1.2"
msgid "Quite the precocious poltergeist, aren't you?"
msgstr "Un espectro bastante precoz, ¿no crees?"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ABIGAIL.LEVEL2.1
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ABIGAIL.LEVEL2.1"
msgid "Quite the precocious poltergeist, aren't you?"
msgstr "Un espectro bastante precoz, ¿no crees?"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ABIGAIL.LEVEL2.2
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ABIGAIL.LEVEL2.2"
msgid "Quite the precocious poltergeist, aren't you?"
msgstr "Un espectro bastante precoz, ¿no crees?"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ABIGAIL.LEVEL3.1
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ABIGAIL.LEVEL3.1"
msgid "Quite the precocious poltergeist, aren't you?"
msgstr "Un espectro bastante precoz, ¿no crees?"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ABIGAIL.LEVEL3.2
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ABIGAIL.LEVEL3.2"
msgid "Quite the precocious poltergeist, aren't you?"
msgstr "Un espectro bastante precoz, ¿no crees?"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ABIGAIL_FLOWER.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ABIGAIL_FLOWER.GENERIC"
msgid "Hm? What a familiar presence."
msgstr "¿Hmm? Qué presencia tan familiar."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ABIGAIL_FLOWER.HAUNTED_GROUND
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ABIGAIL_FLOWER.HAUNTED_GROUND"
msgid "It demands a sacrifice."
msgstr "Exige un sacrificio."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ABIGAIL_FLOWER.HAUNTED_POCKET
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ABIGAIL_FLOWER.HAUNTED_POCKET"
msgid "I should quit toying with this now."
msgstr "Debería dejar de jugar con esto."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ABIGAIL_FLOWER.LEVEL1
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ABIGAIL_FLOWER.LEVEL1"
msgid "I can sense strong magic within it."
msgstr "Noto una fuerte presencia de magia."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ABIGAIL_FLOWER.LEVEL2
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ABIGAIL_FLOWER.LEVEL2"
msgid "A powerful bond tethers this spirit to our world."
msgstr "Un poderoso vínculo ata este espíritu a nuestro mundo."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ABIGAIL_FLOWER.LEVEL3
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ABIGAIL_FLOWER.LEVEL3"
msgid "...I wonder how my brother is doing."
msgstr "Me pregunto cómo estará mi hermano."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ABIGAIL_FLOWER.LONG
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ABIGAIL_FLOWER.LONG"
msgid "I can sense strong magic within it."
msgstr "Noto una fuerte presencia de magia."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ABIGAIL_FLOWER.MEDIUM
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ABIGAIL_FLOWER.MEDIUM"
msgid "This enchantment is not of my doing."
msgstr "Este encantamiento no es cosa mía."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ABIGAIL_FLOWER.SOON
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ABIGAIL_FLOWER.SOON"
msgid "Whatever it is will be arriving soon."
msgstr "Sea lo que sea, llegará pronto."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ACCOMPLISHMENT_SHRINE
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ACCOMPLISHMENT_SHRINE"
msgid "Even They couldn't build something so devious."
msgstr "Ni siquiera Ellos podrían construir algo tan retorcido."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ACORN
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ACORN"
msgid "A more outdoorsy type might be able to make something of this."
msgstr "Un tipo al que le guste más la naturaleza podría hacer algo con esto."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ACORN_COOKED
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ACORN_COOKED"
msgid "Over an open fire."
msgstr "Sobre el fuego."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ACORN_SAPLING
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ACORN_SAPLING"
msgid "Huh, it seems to belong in the ground."
msgstr "Ah, parece que pertenece a la tierra."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ADVENTURE_PORTAL
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ADVENTURE_PORTAL"
msgid "So that's where I left that thing!"
msgstr "¡Así que ahí es donde dejé esa cosa!"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ALTERGUARDIANHAT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ALTERGUARDIANHAT"
msgid "It makes me uneasy... but I can't deny its power."
msgstr "Es bastante inquietante... pero no niego su poder."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ALTERGUARDIANHATSHARD
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ALTERGUARDIANHATSHARD"
msgid "Even shattered, it holds power."
msgstr "Incluso hecho pedazos, mantiene su poder."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ALTERGUARDIAN_CONTAINED
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ALTERGUARDIAN_CONTAINED"
msgid "Ah, now I see..."
msgstr "Ah, ahora entiendo..."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ALTERGUARDIAN_PHASE1.DEAD
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ALTERGUARDIAN_PHASE1.DEAD"
msgid "Something doesn't feel right..."
msgstr "Hay algo que no está bien..."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ALTERGUARDIAN_PHASE1.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ALTERGUARDIAN_PHASE1.GENERIC"
msgid "It seems our actions have been noticed."
msgstr "Parece que notaron nuestra presencia."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ALTERGUARDIAN_PHASE2.DEAD
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ALTERGUARDIAN_PHASE2.DEAD"
msgid "Come on now. You're not fooling anyone."
msgstr "Vamos. No engañas a nadie."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ALTERGUARDIAN_PHASE2.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ALTERGUARDIAN_PHASE2.GENERIC"
msgid "It toys with us."
msgstr "Está jugando con nosotros."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ALTERGUARDIAN_PHASE2SPIKE
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ALTERGUARDIAN_PHASE2SPIKE"
msgid "It's trying to ensnare us."
msgstr "Está intentando enredarnos."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ALTERGUARDIAN_PHASE3
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ALTERGUARDIAN_PHASE3"
msgid "At last you reveal your true self."
msgstr "Por fin muestras tu verdadero ser."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ALTERGUARDIAN_PHASE3DEAD
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ALTERGUARDIAN_PHASE3DEAD"
msgid "I don't know what to believe. All this time, I thought that They were..."
msgstr "Ya no sé qué creer. Todo este tiempo, creí que Ellos eran..."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ALTERGUARDIAN_PHASE3DEADORB
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ALTERGUARDIAN_PHASE3DEADORB"
msgid "This power, it feels like... but it couldn't be..."
msgstr "Este poder se siente como... Pero no puede ser..."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ALTERGUARDIAN_PHASE3TRAP
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ALTERGUARDIAN_PHASE3TRAP"
msgid "I'd do well to avoid those."
msgstr "Si fuera yo, evitaría eso."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.AMULET
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.AMULET"
msgid "It channels the darkest energies of the universe."
msgstr "Canaliza las energías más oscuras del universo."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ANCHOR
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ANCHOR"
msgid "I can drop it to keep the boat in place."
msgstr "Puedo soltarla para mantener el barco inmóvil."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ANCHOR_ITEM
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ANCHOR_ITEM"
msgid "Can't someone else assemble it?"
msgstr "¿No podría armarla otro?"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ANCIENTFRUIT_GEM
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ANCIENTFRUIT_GEM"
msgid "I sense magic at its core. Now, how to get it out..."
msgstr "Presiento magia en su interior. Ahora, ¿cómo se la quitamos?"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ANCIENTFRUIT_NIGHTVISION
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ANCIENTFRUIT_NIGHTVISION"
msgid "Hm. Tangy."
msgstr "Hmm. Intensa."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ANCIENTFRUIT_NIGHTVISION_COOKED
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ANCIENTFRUIT_NIGHTVISION_COOKED"
msgid "I prefer them raw."
msgstr "Las prefiero crudas."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ANCIENTTREE_GEM.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ANCIENTTREE_GEM.GENERIC"
msgid "I'm sure it will burn out eventually."
msgstr "Seguro que se agotará."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ANCIENTTREE_GEM.STUMP
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ANCIENTTREE_GEM.STUMP"
msgid "Close enough."
msgstr "Casi."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ANCIENTTREE_NIGHTVISION.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ANCIENTTREE_NIGHTVISION.GENERIC"
msgid "It provides a lovely ambiance of dread, don't you think?"
msgstr "Da una atmósfera de terror divina, ¿no crees?"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ANCIENTTREE_NIGHTVISION.STUMP
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ANCIENTTREE_NIGHTVISION.STUMP"
msgid "A pity."
msgstr "Qué pena."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ANCIENTTREE_SAPLING.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ANCIENTTREE_SAPLING.GENERIC"
msgid "It's coming along nicely."
msgstr "Está creciendo bien."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ANCIENTTREE_SAPLING.WRONG_SEASON
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ANCIENTTREE_SAPLING.WRONG_SEASON"
msgid "Patience. It's time will come."
msgstr "Paciencia. Ya llegará tu momento."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ANCIENTTREE_SAPLING.WRONG_TILE
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ANCIENTTREE_SAPLING.WRONG_TILE"
msgid "Impudent plant. This patch of ground isn't good enough for you?"
msgstr "Qué planta imprudente. ¿Así que este trozo de tierra no te gusta?"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ANCIENTTREE_SAPLING_ITEM
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ANCIENTTREE_SAPLING_ITEM"
msgid "I suppose I have no choice but to get my hands dirty."
msgstr "Supongo que no tengo opción; debo ensuciarme las manos."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ANCIENTTREE_SEED
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ANCIENTTREE_SEED"
msgid "How mysterious."
msgstr "Qué misterio."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ANCIENT_ALTAR
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ANCIENT_ALTAR"
msgid "Where are their gods now?"
msgstr "¿Dónde están sus dioses ahora?"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ANCIENT_ALTAR_BROKEN
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ANCIENT_ALTAR_BROKEN"
msgid "This can be partially restored."
msgstr "Esto puede ser restaurado parcialmente."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ANCIENT_STATUE
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ANCIENT_STATUE"
msgid "A once proud race."
msgstr "Un pueblo orgulloso de otra época."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ANIMAL_TRACK
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ANIMAL_TRACK"
msgid "Some dumb beast passed through here."
msgstr "Alguna bestia tonta pasó por aquí."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ANTCHOVIES
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ANTCHOVIES"
msgid "What a miserable thing."
msgstr "Qué cosa más miserable."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ANTLION.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ANTLION.GENERIC"
msgid "Have you no pride?"
msgstr "¿Es que no tienes orgullo?"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ANTLION.UNHAPPY
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ANTLION.UNHAPPY"
msgid "It's going to wreak havoc on my world."
msgstr "Va a causar el caos en mi mundo."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ANTLION.VERYHAPPY
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ANTLION.VERYHAPPY"
msgid "We've placated it for now."
msgstr "Lo hemos apaciguado, por ahora."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ANTLIONHAT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ANTLIONHAT"
msgid "If the ground displeases me, I'll pull it up by the roots."
msgstr "Si la tierra me molesta, lo colgaré de las raíces."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ANTLIONTRINKET
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ANTLIONTRINKET"
msgid "I'll cross it off my bucket list."
msgstr "Lo tacharé de mi lista de deseos."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ARCHIVE_CENTIPEDE
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ARCHIVE_CENTIPEDE"
msgid "I get the sensation that we are not welcome here."
msgstr "Me da la sensación de que no somos bienvenidos aquí."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ARCHIVE_CENTIPEDE_HUSK
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ARCHIVE_CENTIPEDE_HUSK"
msgid "A pile of worthless parts."
msgstr "Un montón de partes inútiles."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ARCHIVE_COOKPOT.BURNT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ARCHIVE_COOKPOT.BURNT"
msgid "A bit overdone for my tastes."
msgstr "Demasiado cocido para mi gusto."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ARCHIVE_COOKPOT.COOKING_LONG
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ARCHIVE_COOKPOT.COOKING_LONG"
msgid "Wait for it..."
msgstr "Espera un poco..."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ARCHIVE_COOKPOT.COOKING_SHORT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ARCHIVE_COOKPOT.COOKING_SHORT"
msgid "Here it comes!"
msgstr "¡Ya está!"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ARCHIVE_COOKPOT.DONE
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ARCHIVE_COOKPOT.DONE"
msgid "Finally, some quality grub."
msgstr "Por fin un poco de comida de calidad."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ARCHIVE_COOKPOT.EMPTY
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ARCHIVE_COOKPOT.EMPTY"
msgid "They didn't always live off of the fuel."
msgstr "No siempre vivieron de la leña."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ARCHIVE_LOCKBOX
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ARCHIVE_LOCKBOX"
msgid "Impossible... I thought I was privy to all of Their secrets."
msgstr "Imposible... creí que me habían confiado todos Sus secretos."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ARCHIVE_LOCKBOX_DISPENCER.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ARCHIVE_LOCKBOX_DISPENCER.GENERIC"
msgid "Ah. I suppose I misinterpreted the original design."
msgstr "Ah. Supongo que malinterpreté el diseño original."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ARCHIVE_LOCKBOX_DISPENCER.POWEROFF
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ARCHIVE_LOCKBOX_DISPENCER.POWEROFF"
msgid "I always wondered where those parts came from."
msgstr "Siempre me pregunté el origen de esas partes."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ARCHIVE_MOON_STATUE
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ARCHIVE_MOON_STATUE"
msgid "How did I not know of this place? Did They know?"
msgstr "¿Cómo es que no conocía este lugar? ¿Estaban al tanto Ellos?"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ARCHIVE_ORCHESTRINA_MAIN
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ARCHIVE_ORCHESTRINA_MAIN"
msgid "Rather devious."
msgstr "Bastante engañoso."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ARCHIVE_PORTAL.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ARCHIVE_PORTAL.GENERIC"
msgid "Still inactive. Curious."
msgstr "Sigue inactivo. Qué curioso."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ARCHIVE_PORTAL.POWEROFF
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ARCHIVE_PORTAL.POWEROFF"
msgid "It couldn't be..."
msgstr "No puede ser..."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ARCHIVE_RESONATOR.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ARCHIVE_RESONATOR.GENERIC"
msgid "It's leading us to something..."
msgstr "Nos conduce a algo..."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ARCHIVE_RESONATOR.IDLE
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ARCHIVE_RESONATOR.IDLE"
msgid "It fulfilled its purpose."
msgstr "Cumplió su propósito."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ARCHIVE_RESONATOR_ITEM
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ARCHIVE_RESONATOR_ITEM"
msgid "I have many questions."
msgstr "Tengo muchas preguntas."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ARCHIVE_RUNE_STATUE.LINE_1
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ARCHIVE_RUNE_STATUE.LINE_1"
msgid "These runes are... different."
msgstr "Estas runas... son diferentes."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ARCHIVE_RUNE_STATUE.LINE_2
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ARCHIVE_RUNE_STATUE.LINE_2"
msgid "I can only glean a hint of their meaning."
msgstr "Solo puedo vislumbrar una pizca de su significado."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ARCHIVE_RUNE_STATUE.LINE_3
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ARCHIVE_RUNE_STATUE.LINE_3"
msgid "This symbol here keeps repeating..."
msgstr "Este símbolo se repite en todos lados."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ARCHIVE_RUNE_STATUE.LINE_4
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ARCHIVE_RUNE_STATUE.LINE_4"
msgid "\"To change?\" No. It's a name..."
msgstr "«¿Cambiar?» No. Es un nombre..."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ARCHIVE_RUNE_STATUE.LINE_5
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ARCHIVE_RUNE_STATUE.LINE_5"
msgid "\"Alter\"?"
msgstr "«¿Modificar?»"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ARCHIVE_SECURITY_DESK.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ARCHIVE_SECURITY_DESK.GENERIC"
msgid "Hm. I have a bad feeling..."
msgstr "Mm. Tengo un mal presentimiento..."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ARCHIVE_SECURITY_DESK.POWEROFF
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ARCHIVE_SECURITY_DESK.POWEROFF"
msgid "It's powerless."
msgstr "No sirve."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ARCHIVE_SECURITY_PULSE
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ARCHIVE_SECURITY_PULSE"
msgid "Don't let it escape!"
msgstr "¡Que no escape!"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ARCHIVE_SWITCH.GEMS
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ARCHIVE_SWITCH.GEMS"
msgid "I suppose I'll need to find a suitable gem."
msgstr "Supongo que tendré que encontrar una gema compatible."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ARCHIVE_SWITCH.VALID
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ARCHIVE_SWITCH.VALID"
msgid "It saps power from the gems."
msgstr "Debilita el poder de las gemas."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ARMORDRAGONFLY
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ARMORDRAGONFLY"
msgid "That's some fly mail."
msgstr "Eso sí que es un correo que vuela."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ARMORDREADSTONE
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ARMORDREADSTONE"
msgid "Black never goes out of style."
msgstr "El negro nunca pasa de moda."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ARMORGRASS
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ARMORGRASS"
msgid "Direct confrontation is quite gauche."
msgstr "La confrontación directa es bastante torpe."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ARMORMARBLE
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ARMORMARBLE"
msgid "That really isn't my style."
msgstr "Ese realmente no es mi estilo."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ARMORRUINS
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ARMORRUINS"
msgid "Thulecite meshes so well with nightmare fuel."
msgstr "La thulecita se mezcla muy bien con el combustible de pesadilla."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ARMORSKELETON
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ARMORSKELETON"
msgid "Like all things, it craves the fuel."
msgstr "Como todas las cosas, tiene sed de combustible."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ARMORSLURPER
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ARMORSLURPER"
msgid "Wet, soggy, and oddly filling."
msgstr "Húmedo, empapado y con un relleno extraño."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ARMORSNURTLESHELL
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ARMORSNURTLESHELL"
msgid "That is not dapper at all."
msgstr "No es elegante para nada."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ARMORWAGPUNK
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ARMORWAGPUNK"
msgid "What it lacks in style it almost makes up for in pure, stubborn resilience."
msgstr "Lo que no tiene de estiloso lo tiene de resiliencia pura y resistente."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ARMORWOOD
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ARMORWOOD"
msgid "Ugh. I'm not typically one for vulgar fisticuffs."
msgstr "Uf. A mí estas vulgares armaduras no me van."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ARMOR_BRAMBLE
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ARMOR_BRAMBLE"
msgid "Who's frail now?"
msgstr "¿Quién es frágil ahora?"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ARMOR_CARROTLURE
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ARMOR_CARROTLURE"
msgid "A little obsessed with bunnies, are we?"
msgstr "Estamos un poco obsesionados con los conejos, ¿no?"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ARMOR_LUNARPLANT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ARMOR_LUNARPLANT"
msgid "Does no one else find this armor oddly itchy?"
msgstr "¿Soy el único al que esta armadura le causa picazón?"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ARMOR_LUNARPLANT_HUSK
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ARMOR_LUNARPLANT_HUSK"
msgid "Of course the plant saves the best stuff for himself."
msgstr "Por supuesto que la planta se guarda lo mejor para sí."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ARMOR_SANITY
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ARMOR_SANITY"
msgid "Wrap yourself in the nightmare. Embrace it."
msgstr "Déjate envolver por la pesadilla. Abrázala."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ARMOR_VOIDCLOTH
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ARMOR_VOIDCLOTH"
msgid "The fabric really breathes."
msgstr "La tela es realmente fresca."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ARROWSIGN_PANEL.BURNT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ARROWSIGN_PANEL.BURNT"
msgid "Somehow, it says even less now."
msgstr "De alguna manera, dice incluso menos ahora."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ARROWSIGN_PANEL.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ARROWSIGN_PANEL.GENERIC"
msgid "\"Thataway\"... Ugh!"
msgstr "«Por ahí»... ¡Agh!"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ARROWSIGN_PANEL.UNWRITTEN
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ARROWSIGN_PANEL.UNWRITTEN"
msgid "This requires profundity."
msgstr "Esto requiere profundidad."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ARROWSIGN_POST.BURNT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ARROWSIGN_POST.BURNT"
msgid "Somehow, it says even less now."
msgstr "De alguna manera, dice incluso menos ahora."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ARROWSIGN_POST.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ARROWSIGN_POST.GENERIC"
msgid "\"Thataway\"... Ugh!"
msgstr "«Por ahí»... ¡Agh!"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ARROWSIGN_POST.UNWRITTEN
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ARROWSIGN_POST.UNWRITTEN"
msgid "This requires profundity."
msgstr "Esto requiere profundidad."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ASH.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ASH.GENERIC"
msgid "A fine powder that smells of destruction."
msgstr "Un polvo fino que huele a destrucción."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ASH.REMAINS_EYE_BONE
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ASH.REMAINS_EYE_BONE"
msgid "Don't worry. There will be more Chesters."
msgstr "No te preocupes. Habrá más Chesters."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ASH.REMAINS_GLOMMERFLOWER
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ASH.REMAINS_GLOMMERFLOWER"
msgid "There's always another Glommer."
msgstr "Siempre hay otro Glommer."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ASH.REMAINS_THINGIE
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ASH.REMAINS_THINGIE"
msgid "My trip through the portal made it unrecognizable."
msgstr "Mi viaje a través del portal lo ha hecho irreconocible."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ASPARAGUS
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ASPARAGUS"
msgid "We must always eat our vegetables."
msgstr "Hay que comer siempre verdura."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ASPARAGUSSOUP
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ASPARAGUSSOUP"
msgid "I suppose you can make soup from anything."
msgstr "Supongo que se puede hacer sopa de cualquier cosa."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ASPARAGUS_COOKED
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ASPARAGUS_COOKED"
msgid "Smells terrible."
msgstr "Huele horrible."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ASPARAGUS_OVERSIZED
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ASPARAGUS_OVERSIZED"
msgid "What am I supposed to do with all this asparagus?"
msgstr "¿Qué hago con todo este espárrago?"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ASPARAGUS_SEEDS
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ASPARAGUS_SEEDS"
msgid "Such labor is beneath me."
msgstr "Este trabajo es indigno para mí."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ATRIUM_GATE.CHARGING
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ATRIUM_GATE.CHARGING"
msgid "It is feeding off the dark energy."
msgstr "Se está alimentando de la energía oscura."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ATRIUM_GATE.COOLDOWN
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ATRIUM_GATE.COOLDOWN"
msgid "Best not to overuse this power."
msgstr "Será mejor no abusar de su poder."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ATRIUM_GATE.DESTABILIZING
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ATRIUM_GATE.DESTABILIZING"
msgid "Now we've gone and done it."
msgstr "Lo echamos a perder."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ATRIUM_GATE.OFF
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ATRIUM_GATE.OFF"
msgid "It lacks a key."
msgstr "Le hace falta una llave."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ATRIUM_GATE.ON
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ATRIUM_GATE.ON"
msgid "This is a most wretched idea."
msgstr "Es la peor idea del mundo."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ATRIUM_KEY
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ATRIUM_KEY"
msgid "It's strange to see it."
msgstr "Es extraño verla."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ATRIUM_LIGHT.OFF
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ATRIUM_LIGHT.OFF"
msgid "No fuel, no power."
msgstr "Sin combustible, no hay luz."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ATRIUM_LIGHT.ON
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ATRIUM_LIGHT.ON"
msgid "It feeds off the nightmare."
msgstr "Se alimenta de la pesadilla."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ATRIUM_OVERGROWTH
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ATRIUM_OVERGROWTH"
msgid "I can't believe I've forgotten how to read this."
msgstr "No puedo creer que me haya olvidado cómo leerlo."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ATRIUM_RUBBLE.LINE_1
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ATRIUM_RUBBLE.LINE_1"
msgid "A picture of the city, before the fuel."
msgstr "Una pintura de la ciudad antes de la llegada del combustible."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ATRIUM_RUBBLE.LINE_2
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ATRIUM_RUBBLE.LINE_2"
msgid "We all know what happens next."
msgstr "Todos sabemos lo que va a pasar."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ATRIUM_RUBBLE.LINE_3
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ATRIUM_RUBBLE.LINE_3"
msgid "They gained such an enviable power..."
msgstr "Han ganado un poder envidiable..."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ATRIUM_RUBBLE.LINE_4
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ATRIUM_RUBBLE.LINE_4"
msgid "I know why you led me back here."
msgstr "Sé por qué me trajiste de nuevo hasta aquí."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ATRIUM_RUBBLE.LINE_5
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ATRIUM_RUBBLE.LINE_5"
msgid "But it won't work."
msgstr "Pero no funcionará."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ATRIUM_STATUE
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.ATRIUM_STATUE"
msgid "There's a dreamlike quality to the material."
msgstr "El material tiene una cualidad irreal."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.AXE
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.AXE"
msgid "Sometimes the direct approach is best."
msgstr "A veces, el método directo es el mejor."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BABYBEEFALO.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BABYBEEFALO.GENERIC"
msgid "They're even ugly as infants."
msgstr "Son feos hasta de bebés."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BABYBEEFALO.SLEEPING
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BABYBEEFALO.SLEEPING"
msgid "Seems we've a few hours of reprieve."
msgstr "Parece que tenemos algunas horas de tregua."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BACKPACK
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BACKPACK"
msgid "I wish there were porters around here."
msgstr "Ojalá hubiera maleteros por aquí."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BACONEGGS
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BACONEGGS"
msgid "Now that is a proper breakfast."
msgstr "Esto sí que es un desayuno."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BALLOON
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BALLOON"
msgid "This seems out of place here. Too cheery."
msgstr "Parece fuera de lugar aquí. Demasiado alegre."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BALLOONHAT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BALLOONHAT"
msgid "Would I really stoop so low as to wear such a thing?"
msgstr "¿Crees que caería tan bajo como para usar algo así?"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BALLOONPARTY
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BALLOONPARTY"
msgid "Oh no... he's managed to make them even more cheerful."
msgstr "Ay, no. Se las arregló para hacerlos todavía más alegres."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BALLOONSPEED.DEFLATED
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BALLOONSPEED.DEFLATED"
msgid "Its power is spent. Now it's just garishly cheery."
msgstr "Su poder se ha agotado. Ahora es solo chillón y alegre."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BALLOONSPEED.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BALLOONSPEED.GENERIC"
msgid "The mime's power unsettles me."
msgstr "El poder del mimo me inquieta."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BALLOONS_EMPTY
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BALLOONS_EMPTY"
msgid "Those look much too jovial for my liking."
msgstr "Son demasiado alegres para mi gusto."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BALLOONVEST
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BALLOONVEST"
msgid "I think I'd rather drown."
msgstr "Creo que preferiría morir."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BANANABUSH
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BANANABUSH"
msgid "Bananas that don't grow in caves? Preposterous."
msgstr "¿Bananas que no crecen en cuevas? Qué absurdo."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BANANAJUICE
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BANANAJUICE"
msgid "It doesn't do much for my refined palate."
msgstr "No le agrada mucho a mi paladar refinado."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BANANAPOP
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BANANAPOP"
msgid "Hm... I don't know what I was expecting."
msgstr "Hmm... No sé lo que estaba esperando."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BANDAGE
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BANDAGE"
msgid "Sticky and gooey and good for putting on booboos."
msgstr "Pegajosa, babosa y sirve para poner en las heridas."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BARNACLE
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BARNACLE"
msgid "I wish they were oysters."
msgstr "Ojalá fueran ostras."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BARNACLEPITA
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BARNACLEPITA"
msgid "I suppose I'll eat it if there's nothing else."
msgstr "Supongo que, si no tengo otra opción, me la comeré."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BARNACLESTUFFEDFISHHEAD
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BARNACLESTUFFEDFISHHEAD"
msgid "I suppose anything is \"food\" now."
msgstr "Supongo que ahora cualquier cosa es «comida»."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BARNACLESUSHI
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BARNACLESUSHI"
msgid "At least it's an attempt at sophistication."
msgstr "Al menos es un intento de sofisticación."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BARNACLE_COOKED
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BARNACLE_COOKED"
msgid "It's an acquired taste."
msgstr "Es un gusto que se adquiere con el tiempo."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BARNACLINGUINE
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BARNACLINGUINE"
msgid "It's surprisingly delicious."
msgstr "Sorprendentemente delicioso."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BASALT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BASALT"
msgid "I made a rock so heavy that even I can't lift it."
msgstr "Hice una roca tan pesada que ni siquiera yo puedo levantarla."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BAT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BAT"
msgid "Ugh. Ugly beasts."
msgstr "Uf. Bestias feas."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BATBAT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BATBAT"
msgid "Violence has never felt better."
msgstr "La violencia nunca se sintió mejor."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BATCAVE
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BATCAVE"
msgid "Ugh. It stinks."
msgstr "Agh. Apesta."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BATHBOMB
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BATHBOMB"
msgid "It smells quite nice, if I'm honest."
msgstr "Huele bastante bien, a decir verdad."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BATNOSE
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BATNOSE"
msgid "It smells."
msgstr "Huele feo."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BATNOSEHAT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BATNOSEHAT"
msgid "Do I have no dignity left?"
msgstr "¿Pues no tengo dignidad?"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BATNOSE_COOKED
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BATNOSE_COOKED"
msgid "The things I must do to survive..."
msgstr "Lo que tengo que hacer para sobrevivir..."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BATTLESONG_CONTAINER
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BATTLESONG_CONTAINER"
msgid "As good a place as any to stash sheet music away."
msgstr "Un buen lugar para guardar partituras."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BATTLESONG_DURABILITY
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.BATTLESONG_DURABILITY"
msgid "No. I do NOT sing."
msgstr "No. Yo NO canto."

