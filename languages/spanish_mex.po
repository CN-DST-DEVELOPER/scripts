msgstr "Es una paloma sucia."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.QUAGMIRE_PIGEON.SLEEPING
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.QUAGMIRE_PIGEON.SLEEPING"
