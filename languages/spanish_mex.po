msgstr "Aquí pasó algo."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.QUAGMIRE_RUBBLE_HOUSE.2
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.QUAGMIRE_RUBBLE_HOUSE.2"
