msgstr "Tiene sabor a pollo."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.FROGNEWTON
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.FROGNEWTON"
