msgstr "¡Arrear cosas nos sale muy bien!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.CARNIVALGAME_MEMORY_CARD.GENERIC
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.CARNIVALGAME_MEMORY_CARD.GENERIC"
