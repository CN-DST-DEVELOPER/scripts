msgstr "¡Puaj! ¿Esto se supone que huele así?"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.BERRYBUSH.GENERIC
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.BERRYBUSH.GENERIC"
msgid "Can I eat those?"
msgstr "¿Me las puedo comer?"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.BERRYBUSH.PICKED
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.BERRYBUSH.PICKED"
msgid "Picked it right clean."
msgstr "Las recolecté bien maduras."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.BERRYBUSH.WITHERED
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.BERRYBUSH.WITHERED"
msgid "You've obviously never worked a boiler room."
msgstr "Obviamente nunca trabajaste en la sala de calderas."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.BERRYBUSH_JUICY.BARREN
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.BERRYBUSH_JUICY.BARREN"
msgid "Totally pooped. Or unpooped?"
msgstr "Esto ya no da sus frutos."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.BERRYBUSH_JUICY.BURNING
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.BERRYBUSH_JUICY.BURNING"
msgid "Not much I can do now."
msgstr "No hay mucho que pueda hacer ahora."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.BERRYBUSH_JUICY.DISEASED
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.BERRYBUSH_JUICY.DISEASED"
msgid "Maybe you oughta take a sick day..."
msgstr "Tal vez deberías tomarte un día de descanso por enfermedad..."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.BERRYBUSH_JUICY.DISEASING
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.BERRYBUSH_JUICY.DISEASING"
msgid "Yeuch! Is it supposed to smell like that?"
msgstr "¡Puaj! ¿Esto se supone que huele así?"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.BERRYBUSH_JUICY.GENERIC
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.BERRYBUSH_JUICY.GENERIC"
msgid "Looks tasty. Hope they're not poison."
msgstr "Parece sabrosa. Espero que no sea venenosa."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.BERRYBUSH_JUICY.PICKED
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.BERRYBUSH_JUICY.PICKED"
msgid "Picked it right clean."
msgstr "Las recolecté bien maduras."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.BERRYBUSH_JUICY.WITHERED
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.BERRYBUSH_JUICY.WITHERED"
msgid "Pssh. This heat's nothing."
msgstr "Bah. Este calor no es nada."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.BERRYSAUCE
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.BERRYSAUCE"
msgid "Pass it over here!"
msgstr "¡Pásame eso!"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.BIBINGKA
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.BIBINGKA"
msgid "I'll give it a try!"
msgstr "¡La probaré!"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.BIGFOOT
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.BIGFOOT"
msgid "At least it doesn't have steel-toed workboots!"
msgstr "¡Al menos no tiene botas de trabajo con punta de acero!"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.BIRCHNUTDRAKE
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.BIRCHNUTDRAKE"
