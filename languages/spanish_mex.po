msgstr "Huele a zanahorias asadas."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.YOTC_CARRATSHRINE.EMPTY
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.YOTC_CARRATSHRINE.EMPTY"
msgid "Hm... what does a carrat like to eat?"
msgstr "Mmm... ¿qué comen las zanarratas?"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.YOTC_CARRATSHRINE.GENERIC
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.YOTC_CARRATSHRINE.GENERIC"
msgid "What to make..."
msgstr "¿Qué hago?"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.YOTC_CARRAT_GYM_DIRECTION.BURNT
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.YOTC_CARRAT_GYM_DIRECTION.BURNT"
msgid "My training regimen crashed and burned."
msgstr "Mi rutina de entrenamiento se hizo humo."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.YOTC_CARRAT_GYM_DIRECTION.GENERIC
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.YOTC_CARRAT_GYM_DIRECTION.GENERIC"
