msgstr "Ah, así que había dejado eso ahí."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.GELBLOB_BOTTLE
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.GELBLOB_BOTTLE"
msgid "I tend to keep things bottled up."
msgstr "A veces me enfrasco en la ciencia."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.GELBLOB_STORAGE.FULL
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.GELBLOB_STORAGE.FULL"
msgid "It's keeping it... fresh?"
msgstr "Lo está... ¿conservando?"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.GELBLOB_STORAGE.GENERIC
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.GELBLOB_STORAGE.GENERIC"
msgid "Looks empty."
msgstr "Parece vacío."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.GELBLOB_STORAGE_KIT
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.GELBLOB_STORAGE_KIT"
msgid "I'll preserve my judgement."
msgstr "Voy a conservar la razón."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.GEMSOCKET.GEMS
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.GEMSOCKET.GEMS"
msgid "It needs a gem."
msgstr "Necesita una gema."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.GEMSOCKET.VALID
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.GEMSOCKET.VALID"
msgid "Looks ready."
msgstr "Parece listo."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.GESTALT
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.GESTALT"
