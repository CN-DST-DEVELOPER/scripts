msgstr "Debería ser una buena prueba de reflejos."

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.YOTC_CARRAT_GYM_REACTION.RAT
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.YOTC_CARRAT_GYM_REACTION.RAT"
msgid "I do believe its reaction time is improving!"
msgstr "¡Creo que su tiempo de reacción está mejorando!"

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.YOTC_CARRAT_GYM_REACTION_ITEM
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.YOTC_CARRAT_GYM_REACTION_ITEM"
