msgstr "Qué raro, nunca lo vi entrar ni salir..."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.YOTB_STAGE_ITEM
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.YOTB_STAGE_ITEM"
