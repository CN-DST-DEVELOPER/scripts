msgstr "¡Ah, no! ¡Ah, no!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.TROPHYSCALE_FISH.BURNT
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.TROPHYSCALE_FISH.BURNT"
