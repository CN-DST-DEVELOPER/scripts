msgstr "¡Pero qué dulce eres!"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.WOBY_BADGE_STATION
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.WOBY_BADGE_STATION"
