msgstr "Intoxicación alimentaria y media."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.DEAD_SEA_BONES
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.DEAD_SEA_BONES"
msgid "They're picked clean dry."
msgstr "Se llevaron hasta el último pedazo."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.DECIDUOUSTREE.BURNING
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.DECIDUOUSTREE.BURNING"
msgid "That's an impressive blaze."
msgstr "Un fuego impresionante."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.DECIDUOUSTREE.BURNT
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.DECIDUOUSTREE.BURNT"
msgid "Completely charred."
msgstr "Completamente carbonizado."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.DECIDUOUSTREE.CHOPPED
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.DECIDUOUSTREE.CHOPPED"
msgid "Done and done."
msgstr "Talado por completo."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.DECIDUOUSTREE.GENERIC
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.DECIDUOUSTREE.GENERIC"
msgid "Another tree."
msgstr "Otro árbol."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.DECIDUOUSTREE.POISON
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.DECIDUOUSTREE.POISON"
msgid "Why does a tree need a mouth?!"
msgstr "¿¡Para qué necesita un árbol una boca!?"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.DECOR_CENTERPIECE
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.DECOR_CENTERPIECE"
msgid "Looks like some frou-frou clutter to me."
msgstr "Solo un montón de adornos innecesarios."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.DECOR_FLOWERVASE.EMPTY
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.DECOR_FLOWERVASE.EMPTY"
msgid "Looks nice enough, but it feels kinda empty."
msgstr "Se ve bonito, pero está vacío."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.DECOR_FLOWERVASE.FRESHLIGHT
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.DECOR_FLOWERVASE.FRESHLIGHT"
msgid "It ain't a lamp, but it'll work."
msgstr "No es una lámpara, pero funcionará."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.DECOR_FLOWERVASE.GENERIC
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.DECOR_FLOWERVASE.GENERIC"
msgid "Lookin' fresh as a daisy!"
msgstr "¡Fresco como una rosa!"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.DECOR_FLOWERVASE.OLDLIGHT
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.DECOR_FLOWERVASE.OLDLIGHT"
msgid "That's not gonna last much longer."
msgstr "No durará mucho más."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.DECOR_FLOWERVASE.WILTED
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.DECOR_FLOWERVASE.WILTED"
msgid "I think it's time to retire this one."
msgstr "Creo que es hora de retirarla."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.DECOR_LAMP
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.DECOR_LAMP"
msgid "A good lamp will keep ya workin' through the night!"
msgstr "¡Con una buena lámpara, también puedes trabajar de noche!"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.DECOR_PICTUREFRAME.GENERIC
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.DECOR_PICTUREFRAME.GENERIC"
msgid "One of them highbrow \"still life\" pieces, huh?"
msgstr "Una de esas «naturalezas muertas» para los entendidos, ¿eh?"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.DECOR_PICTUREFRAME.UNDRAWN
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.DECOR_PICTUREFRAME.UNDRAWN"
msgid "That frame looks kinda plain with nothin' in it."
msgstr "Ese marco se ve bastante soso, sin ningún contenido."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.DECOR_PORTRAITFRAME
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.DECOR_PORTRAITFRAME"
msgid "It's a pretty good likeness."
msgstr "Se parece bastante."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.DEER.ANTLER
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.DEER.ANTLER"
msgid "Looks like she has a new addition."
msgstr "Parece que tiene una nueva incorporación."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.DEER.GENERIC
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.DEER.GENERIC"
msgid "A bouncy fluffster."
msgstr "Una bola de pelo saltarina."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.DEERCLOPS
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.DEERCLOPS"
msgid "Don't even think about it, you dumb lug!"
msgstr "¡Ni lo pienses, pedazo de bicho!"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.DEERCLOPSCORPSE.BURNING
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.DEERCLOPSCORPSE.BURNING"
msgid "There's no comin' back from that."
msgstr "Para eso no hay remedio."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.DEERCLOPSCORPSE.GENERIC
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.DEERCLOPSCORPSE.GENERIC"
msgid "She's the deerly departed."
msgstr "Una sierva del señor que partió."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.DEERCLOPSCORPSE.REVIVING
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.DEERCLOPSCORPSE.REVIVING"
msgid "That just ain't right."
msgstr "Eso no está bien."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.DEERCLOPSEYEBALL_SENTRYWARD.GENERIC
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.DEERCLOPSEYEBALL_SENTRYWARD.GENERIC"
msgid "That is one creepy refrigeration unit."
msgstr "Una unidad de refrigeración espeluznante."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.DEERCLOPSEYEBALL_SENTRYWARD.NOEYEBALL
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.DEERCLOPSEYEBALL_SENTRYWARD.NOEYEBALL"
msgid "It needs that spooky ol' eye to work."
msgstr "Necesita ese viejo ojo aterrador para funcionar."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.DEERCLOPSEYEBALL_SENTRYWARD_KIT
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.DEERCLOPSEYEBALL_SENTRYWARD_KIT"
msgid "Time to roll up the ol' sleeves!"
msgstr "¡Hora de arremangarse!"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.DEERCLOPS_EYEBALL
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.DEERCLOPS_EYEBALL"
msgid "You lookin' at me? Are YOU lookin' at ME?"
msgstr "¿Me estás mirando a mí? ¿Me estás mirando a MÍ?"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.DEER_ANTLER
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.DEER_ANTLER"
msgid "What am I supposed to do with this?"
msgstr "¿Qué se supone que tengo que hacer con esto?"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.DEER_GEMMED
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.DEER_GEMMED"
msgid "Looks dangerous!"
msgstr "¡Parece peligroso!"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.DEPLETED_GRASS.GENERIC
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.DEPLETED_GRASS.GENERIC"
msgid "It's closed for business."
msgstr "El negocio está cerrado."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.DESERTHAT
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.DESERTHAT"
msgid "Helps you see, see?"
msgstr "Te ayuda a ver, ¿ves?"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.DEVTOOL
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.DEVTOOL"
msgid "What an incredible tool!"
msgstr "¡Qué herramienta tan increíble!"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.DEVTOOL_NODEV
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.DEVTOOL_NODEV"
msgid "Lazy builders."
msgstr "Constructores vagos."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.DIRTPILE
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.DIRTPILE"
msgid "Time to get my hands dirty."
msgstr "Hora de ensuciarme las manos."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.DIVININGROD.COLD
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.DIVININGROD.COLD"
msgid "S'not picking anything up."
msgstr "No está captando nada."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.DIVININGROD.GENERIC
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.DIVININGROD.GENERIC"
msgid "I'm probably one of the few left that knows how to use these."
msgstr "Probablemente soy una de las pocas que sabe cómo usar esto."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.DIVININGROD.HOT
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.DIVININGROD.HOT"
msgid "I'm sitting right on top of... something."
msgstr "Estoy sentada justo encima de... algo."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.DIVININGROD.WARM
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.DIVININGROD.WARM"
msgid "It's getting something."
msgstr "Está recibiendo algo."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.DIVININGROD.WARMER
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.DIVININGROD.WARMER"
msgid "Gonna hit paydirt any second now."
msgstr "Va a dar con una mina de oro en cualquier momento."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.DIVININGRODBASE.GENERIC
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.DIVININGRODBASE.GENERIC"
msgid "Just like in the bossman's workshop."
msgstr "Como en el taller del jefe."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.DIVININGRODBASE.READY
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.DIVININGRODBASE.READY"
msgid "I guess it wants the Voxola?"
msgstr "Me imagino que quiere la Voxola."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.DIVININGRODBASE.UNLOCKED
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.DIVININGRODBASE.UNLOCKED"
msgid "At least I assembled it right."
msgstr "Por lo menos lo monté bien."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.DIVININGRODSTART
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.DIVININGRODSTART"
msgid "That's a Voxola! What's it doing here?"
msgstr "¡Una Voxola! ¿Qué está haciendo aquí?"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.DOCK_KIT
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.DOCK_KIT"
msgid "Leave the dock buildin' to me."
msgstr "Yo me ocupo de construir el muelle."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.DOCK_WOODPOSTS_ITEM
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.DOCK_WOODPOSTS_ITEM"
msgid "I don't like seeing \"spare\" parts lyin' around..."
msgstr "No me gusta ver partes «sobrantes» tiradas por ahí..."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.DOLL_BLUEPRINT
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.DOLL_BLUEPRINT"
msgid "That's a lot of ruffles to sew on..."
msgstr "Demasiados volados para coser..."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.DRAGONBOAT_KIT
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.DRAGONBOAT_KIT"
msgid "It's not gonna build itself."
msgstr "No se construirá sola."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.DRAGONBOAT_PACK
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.DRAGONBOAT_PACK"
msgid "This baby's got everything you need!"
msgstr "¡Este bebé tiene todo lo que necesitas!"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.DRAGONBODYHAT
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.DRAGONBODYHAT"
msgid "It's the beast's tummy!"
msgstr "¡Es la tripa de la bestia!"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.DRAGONCHILISALAD
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.DRAGONCHILISALAD"
msgid "Can't believe Warly's got me eatin' salads."
msgstr "No me puedo creer que Warly me tenga comiendo ensaladas."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.DRAGONFLY
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.DRAGONFLY"
msgid "Get a load of this flying welding torch!"
msgstr "¡Fíjate en este soplete volador!"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.DRAGONFLYCHEST.GENERIC
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.DRAGONFLYCHEST.GENERIC"
msgid "For the snootiest of snoots."
msgstr "Para los más presumidos."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.DRAGONFLYCHEST.UPGRADED_STACKSIZE
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.DRAGONFLYCHEST.UPGRADED_STACKSIZE"
msgid "Snooty, but durable."
msgstr "Liviana, pero no muy resistente."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.DRAGONFLYFURNACE.GENERIC
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.DRAGONFLYFURNACE.GENERIC"
msgid "Pretty fancy for a heater."
msgstr "Bastante elegante para una estufa."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.DRAGONFLYFURNACE.HAMMERED
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.DRAGONFLYFURNACE.HAMMERED"
msgid "We oughta fix that."
msgstr "Deberíamos arreglarlo."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.DRAGONFLYFURNACE.HIGH
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.DRAGONFLYFURNACE.HIGH"
msgid "That's a proper furnace."
msgstr "Eso sí que es un horno."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.DRAGONFLYFURNACE.NORMAL
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.DRAGONFLYFURNACE.NORMAL"
msgid "Could use a bit more kick."
msgstr "Le hace falta un poco más de potencia."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.DRAGONFRUIT
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.DRAGONFRUIT"
msgid "Snooty fruit."
msgstr "Fruta presumida."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.DRAGONFRUIT_COOKED
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.DRAGONFRUIT_COOKED"
msgid "Cooked the snoot right out of it."
msgstr "Ahora ya no es tan presumida."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.DRAGONFRUIT_OVERSIZED
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.DRAGONFRUIT_OVERSIZED"
msgid "We'll be eating this stuff for days!"
msgstr "¡Comeremos esto durante semanas!"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.DRAGONFRUIT_SEEDS
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.DRAGONFRUIT_SEEDS"
msgid "A handful of seeds."
msgstr "Un puñado de semillas."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.DRAGONHEADHAT
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.DRAGONHEADHAT"
msgid "Front and center!"
msgstr "¡Dando la cara!"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.DRAGONPIE
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.DRAGONPIE"
msgid "Where's the beef?"
msgstr "¿Dónde está la carne?"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.DRAGONTAILHAT
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.DRAGONTAILHAT"
msgid "That's the business end."
msgstr "Ese gorro traerá cola."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.DRAGON_SCALES
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.DRAGON_SCALES"
msgid "Showy."
msgstr "Llamativo."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.DREADSTONE
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.DREADSTONE"
msgid "It's evil-lookin', but tough as nails."
msgstr "Da miedo, pero es duro como el acero."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.DREADSTONEHAT
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.DREADSTONEHAT"
msgid "Lookin' sharp! Literally."
msgstr "¡Podrías ser pinchadiscos!"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.DREADSTONE_STACK
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.DREADSTONE_STACK"
msgid "Must be a lot of the stuff growing down there."
msgstr "Deben ser las cosas que crecen aquí."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.DRIFTWOOD_LOG
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.DRIFTWOOD_LOG"
msgid "Oof. Kitschy."
msgstr "Uf. Cursi."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.DRIFTWOOD_TREE.BURNING
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.DRIFTWOOD_TREE.BURNING"
msgid "Yeesh, that thing's on fire!"
msgstr "Uuy, ¡esta cosa está en llamas!"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.DRIFTWOOD_TREE.BURNT
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.DRIFTWOOD_TREE.BURNT"
msgid "Looks like there was an accident here."
msgstr "Parece que aquí hubo un accidente."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.DRIFTWOOD_TREE.CHOPPED
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.DRIFTWOOD_TREE.CHOPPED"
msgid "Wonder if driftwood's a good buildin' material?"
msgstr "Me pregunto si la madera a la deriva es buena para construir."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.DRIFTWOOD_TREE.GENERIC
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.DRIFTWOOD_TREE.GENERIC"
msgid "This tree's seen better days."
msgstr "Este árbol ha visto días mejores."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.DRUMSTICK
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.DRUMSTICK"
msgid "Can't say a raw drumstick sounds too appealing."
msgstr "No se puede decir que un muslo crudo sea muy atractivo."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.DRUMSTICK_COOKED
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.DRUMSTICK_COOKED"
msgid "Can't be beat."
msgstr "No hay nada mejor."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.DUG_BANANABUSH
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.DUG_BANANABUSH"
msgid "Sure beats goin' down to the caves."
msgstr "Mucho mejor que bajar a las cuevas."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.DUG_BERRYBUSH
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.DUG_BERRYBUSH"
msgid "I love getting my hands dirty."
msgstr "Me encanta ensuciarme las manos."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.DUG_BERRYBUSH_JUICY
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.DUG_BERRYBUSH_JUICY"
msgid "I'll replant that if no one else wants to."
msgstr "Lo volveré a plantar si nadie más quiere."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.DUG_GRASS
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.DUG_GRASS"
msgid "Looks like some gardening's in order."
msgstr "Parece que hay que hacer algo de jardinería."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.DUG_MARSH_BUSH
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.DUG_MARSH_BUSH"
msgid "Well it's not gonna replant itself."
msgstr "Bueno, no se va a replantar solo."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.DUG_MONKEYTAIL
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.DUG_MONKEYTAIL"
msgid "Those are some tall tails, I tell ya!"
msgstr "¡Qué colas tan largas, eh!"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.DUG_SAPLING
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.DUG_SAPLING"
msgid "Needs replanting."
msgstr "Hay que replantarlo."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.DUG_TRAP_STARFISH
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.DUG_TRAP_STARFISH"
msgid "Can't fool me, ha!"
msgstr "No me engañas, ¡ja!"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.DUMBBELL
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.DUMBBELL"
msgid "Why not do some real work instead of just liftin' these things?"
msgstr "¿Por qué no haces un trabajo de verdad en lugar de solo levantar estas cosas?"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.DUMBBELL_BLUEGEM
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.DUMBBELL_BLUEGEM"
msgid "Better get some ice on that!"
msgstr "¡Hay que ponerle hielo!"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.DUMBBELL_GEM
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.DUMBBELL_GEM"
msgid "Awful fancy for something you just pick up and put down over and over."
msgstr "Muy lujoso para algo que solo levantas y bajas sin parar."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.DUMBBELL_GOLDEN
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.DUMBBELL_GOLDEN"
msgid "Awful fancy for something you just pick up and put down over and over."
msgstr "Muy lujoso para algo que solo levantas y bajas sin parar."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.DUMBBELL_HEAT
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.DUMBBELL_HEAT"
msgid "Is that what he uses for a warm-up?"
msgstr "¿Eso es lo que usa para precalentar?"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.DUMBBELL_MARBLE
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.DUMBBELL_MARBLE"
msgid "Awful fancy for something you just pick up and put down over and over."
msgstr "Muy lujoso para algo que solo levantas y bajas sin parar."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.DUMBBELL_REDGEM
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.DUMBBELL_REDGEM"
msgid "You'll really be feelin' the burn! Ha!"
msgstr "Sentirás cómo quemas, ¡ja!"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.DURIAN
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.DURIAN"
msgid "Powerful stench! I respect that."
msgstr "¡Un olor potente! Lo respeto."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.DURIAN_COOKED
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.DURIAN_COOKED"
msgid "Whew! That'll put some hair on your hair."
msgstr "¡Uf! Con eso te crece el pelo."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.DURIAN_OVERSIZED
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.DURIAN_OVERSIZED"
msgid "It sure is making a big stink."
msgstr "Sin duda va a tener mucho olor."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.DURIAN_SEEDS
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.DURIAN_SEEDS"
msgid "A handful of seeds."
msgstr "Un puñado de semillas."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.DUSTMERINGUE
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.DUSTMERINGUE"
msgid "Ugh. Maybe one of those little moth guys will clean this mess up."
msgstr "Agh. A lo mejor algún día esas polillas arreglen este desastre."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.DUSTMOTH
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.DUSTMOTH"
msgid "Quite the tenacious little worker."
msgstr "Un pequeño trabajador tenaz."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.DUSTMOTHDEN
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.DUSTMOTHDEN"
msgid "Sorry little fellas, but you've got some material I need."
msgstr "Perdonen, compañeras, pero tienen algo que yo necesito."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.EARMUFFSHAT
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.EARMUFFSHAT"
msgid "I hate cold weather."
msgstr "Odio el frío."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.EEL
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.EEL"
msgid "You're looking a little eel. Ha!"
msgstr "Estás un poco flacucho. ¡Ja!"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.EEL_COOKED
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.EEL_COOKED"
msgid "I'll eat anything once."
msgstr "Lo probaré todo al menos una vez."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.EGGPLANT
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.EGGPLANT"
msgid "Look how weird it is! Ha!"
msgstr "¡Fíjate qué rara es! ¡Ja!"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.EGGPLANT_COOKED
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.EGGPLANT_COOKED"
msgid "Did that make it better? I don't know."
msgstr "¿Está así mejor? No lo sé."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.EGGPLANT_OVERSIZED
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.EGGPLANT_OVERSIZED"
msgid "It sure makes a big impression. Ha!"
msgstr "Sí que da una gran impresión, ¡ja!"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.EGGPLANT_SEEDS
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.EGGPLANT_SEEDS"
msgid "A handful of seeds."
msgstr "Un puñado de semillas."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.ELIXIR_CONTAINER
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.ELIXIR_CONTAINER"
msgid "Ain't no picnic for the livin' round here."
msgstr ""

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.EMBERLIGHT
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.EMBERLIGHT"
msgid "Nice and toasty."
msgstr "Agradable y tostada."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.ENDTABLE.BURNT
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.ENDTABLE.BURNT"
msgid "That's a shame."
msgstr "Qué pena."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.ENDTABLE.EMPTY
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.ENDTABLE.EMPTY"
msgid "Sturdily built."
msgstr "Una construcción robusta."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.ENDTABLE.FRESHLIGHT
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.ENDTABLE.FRESHLIGHT"
msgid "I miss lamps."
msgstr "Extraño las lámparas."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.ENDTABLE.GENERIC
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.ENDTABLE.GENERIC"
msgid "Pretty sure this one won't move."
msgstr "Estoy segura de que esta no se moverá."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.ENDTABLE.OLDLIGHT
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.ENDTABLE.OLDLIGHT"
msgid "That's not gonna last much longer."
msgstr "No durará mucho más."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.ENDTABLE.WILTED
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.ENDTABLE.WILTED"
msgid "That bouquet's seen better days."
msgstr "Ese ramo ha visto días mejores."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.EVERGREEN.BURNING
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.EVERGREEN.BURNING"
msgid "That's an impressive blaze."
msgstr "Un fuego impresionante."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.EVERGREEN.BURNT
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.EVERGREEN.BURNT"
msgid "Completely charred."
msgstr "Completamente carbonizado."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.EVERGREEN.CHOPPED
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.EVERGREEN.CHOPPED"
msgid "As long as the job's done."
msgstr "Lo importante es que se haga el trabajo."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.EVERGREEN.GENERIC
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.EVERGREEN.GENERIC"
msgid "Just a tree."
msgstr "Es solo un árbol."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.EVERGREEN_SPARSE.BURNING
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.EVERGREEN_SPARSE.BURNING"
msgid "Impressive blaze."
msgstr "Un fuego impresionante."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.EVERGREEN_SPARSE.BURNT
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.EVERGREEN_SPARSE.BURNT"
msgid "Completely charred."
msgstr "Completamente carbonizado."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.EVERGREEN_SPARSE.CHOPPED
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.EVERGREEN_SPARSE.CHOPPED"
msgid "Glad that's over with."
msgstr "Me alegro de que se haya terminado."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.EVERGREEN_SPARSE.GENERIC
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.EVERGREEN_SPARSE.GENERIC"
msgid "Yep. Definitely a tree."
msgstr "Sí. Sin duda es un árbol."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.EYEBRELLAHAT
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.EYEBRELLAHAT"
msgid "Nice and dry underneath."
msgstr "Debajo, a gusto y seca."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.EYEMASKHAT
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.EYEMASKHAT"
msgid "Guess I'll really be seein' the world through different eyes."
msgstr "Supongo que veré el mundo a través de otros ojos."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.EYEOFTERROR
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.EYEOFTERROR"
msgid "Yeesh, what an eyesore."
msgstr "Uuy, qué monstruosidad."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.EYEOFTERROR_MINI
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.EYEOFTERROR_MINI"
msgid "Can't fault them for doing their job with the big overseer right there."
msgstr "No se les puede criticar por hacer su trabajo con el gran jefe justo allí."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.EYEOFTERROR_MINI_GROUNDED
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.EYEOFTERROR_MINI_GROUNDED"
msgid "You'd think I'd be used to this kind of thing by now."
msgstr "Seguro crees que ya me acostumbré a esta altura."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.EYEPLANT
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.EYEPLANT"
msgid "Y'know? I'm not even gonna ask."
msgstr "¿Sabes? Ni siquiera te lo voy a preguntar."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.EYETURRET
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.EYETURRET"
msgid "That's a fine piece of work."
msgstr "Se nota un muy buen trabajo."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.EYETURRET_ITEM
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.EYETURRET_ITEM"
msgid "Lemme assemble it."
msgstr "Déjame armarlo."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.FARMPLOT.BURNT
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.FARMPLOT.BURNT"
msgid "I hate seeing hard work wasted."
msgstr "Odio que se eche a perder el trabajo duro."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.FARMPLOT.GENERIC
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.FARMPLOT.GENERIC"
msgid "You reap whatcha sow."
msgstr "Uno cosecha lo que siembra."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.FARMPLOT.GROWING
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.FARMPLOT.GROWING"
msgid "Our hard work is paying off."
msgstr "Nuestro trabajo duro está dando sus frutos."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.FARMPLOT.NEEDSFERTILIZER
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.FARMPLOT.NEEDSFERTILIZER"
msgid "It needs a bit of a kick."
msgstr "Necesita un poco de abono."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.FARM_HOE
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.FARM_HOE"
msgid "Let's get to planting, then!"
msgstr "Vaya. Manos a la obra."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.FARM_PLANT.BURNING
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.FARM_PLANT.BURNING"
msgid "Not the crops!"
msgstr "¡Las huertas no!"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.FARM_PLANT.FULL
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.FARM_PLANT.FULL"
msgid "Time to harvest!"
msgstr "¡Hora de cosechar!"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.FARM_PLANT.FULL_OVERSIZED
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.FARM_PLANT.FULL_OVERSIZED"
msgid "Woo-wee, that's a big one!"
msgstr "Guau, ¡ese sí salió grandote!"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.FARM_PLANT.FULL_WEED
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.FARM_PLANT.FULL_WEED"
msgid "Looks like I'd better get to weeding."
msgstr "¡Mejor me pongo a desmalezar!"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.FARM_PLANT.GENERIC
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.FARM_PLANT.GENERIC"
msgid "A plant."
msgstr "Una planta."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.FARM_PLANT.GROWING
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.FARM_PLANT.GROWING"
msgid "Seems to be coming along."
msgstr "Parece que está creciendo bien."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.FARM_PLANT.ROTTEN
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.FARM_PLANT.ROTTEN"
msgid "Should've picked it sooner."
msgstr "Debería haberla cosechado antes."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.FARM_PLANT.ROTTEN_OVERSIZED
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.FARM_PLANT.ROTTEN_OVERSIZED"
msgid "Such a waste."
msgstr "Qué desperdicio."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.FARM_PLANT.SEED
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.FARM_PLANT.SEED"
msgid "It has a lot of work ahead of it."
msgstr "Necesitará mucho trabajo."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.FARM_PLOW
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.FARM_PLOW"
msgid "Now that's handy!"
msgstr "¡Eso sí que es útil!"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.FARM_PLOW_ITEM
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.FARM_PLOW_ITEM"
msgid "This gizmo will get us gardening in no time flat!"
msgstr "¡Esta cosa nos ayudará con el jardín!"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.FARM_SOIL_DEBRIS
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.FARM_SOIL_DEBRIS"
msgid "Let's clear out that clutter."
msgstr "Despejemos todo este desorden."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.FEATHERFAN
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.FEATHERFAN"
msgid "Too fancy."
msgstr "Demasiado elegante."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.FEATHERHAT
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.FEATHERHAT"
msgid "Well la-dee-da."
msgstr "Oh la la."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.FEATHERPENCIL
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.FEATHERPENCIL"
msgid "I've got ugly handwriting."
msgstr "Mi caligrafía es fea."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.FEATHER_CANARY
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.FEATHER_CANARY"
msgid "That's not a good sign."
msgstr "No es una buena señal."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.FEATHER_CROW
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.FEATHER_CROW"
msgid "Not a whole lotta use for that."
msgstr "No sirve para mucho."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.FEATHER_ROBIN
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.FEATHER_ROBIN"
