msgstr "食べ物のムダだよ！"

#. STRINGS.CHARACTERS.WINONA.QUAGMIRE_ANNOUNCE_NOTRECIPE
msgctxt "STRINGS.CHARACTERS.WINONA.QUAGMIRE_ANNOUNCE_NOTRECIPE"
msgid "The ingredients didn't assemble right."
msgstr "調味料がうまく組み立てられなかったんだ。"

#. STRINGS.CHARACTERS.WINONA.QUAGMIRE_ANNOUNCE_WIN
msgctxt "STRINGS.CHARACTERS.WINONA.QUAGMIRE_ANNOUNCE_WIN"
