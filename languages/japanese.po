msgstr "眩しく光るボウル。"

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.QUAGMIRE_CARROT_SEEDS
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.QUAGMIRE_CARROT_SEEDS"
