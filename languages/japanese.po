msgstr "最初は成功しなくても…"

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.SUPPORT_PILLAR_DREADSTONE_COMPLETE
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.SUPPORT_PILLAR_DREADSTONE_COMPLETE"
