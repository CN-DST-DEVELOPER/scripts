msgstr "ちょっとは健康に気を使わないと！"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.HERMITCRAB_LIGHTPOST.ABANDONED
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.HERMITCRAB_LIGHTPOST.ABANDONED"
