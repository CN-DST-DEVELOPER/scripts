msgstr "鍵がかかっているね。"

#. STRINGS.CHARACTERS.WALTER.ACTIONFAIL.ACTIVATE.MANNEQUIN_EQUIPSWAPFAILED
msgctxt "STRINGS.CHARACTERS.WALTER.ACTIONFAIL.ACTIVATE.MANNEQUIN_EQUIPSWAPFAILED"
msgid "Sorry, I guess you can't wear that."
msgstr "ごめんね、これ着れないよね。"

#. STRINGS.CHARACTERS.WALTER.ACTIONFAIL.ACTIVATE.NOCARNIVAL
msgctxt "STRINGS.CHARACTERS.WALTER.ACTIONFAIL.ACTIVATE.NOCARNIVAL"
msgid "Aw, looks like they all left..."
msgstr "あーあ。みんないなくなっちゃった…"

#. STRINGS.CHARACTERS.WALTER.ACTIONFAIL.ACTIVATE.NOKELP
msgctxt "STRINGS.CHARACTERS.WALTER.ACTIONFAIL.ACTIVATE.NOKELP"
