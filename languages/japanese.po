msgstr "なんかピリピリする。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.HALLOWEENCANDY_14
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.HALLOWEENCANDY_14"
msgid "Mmm! It burns my mouth so good!"
msgstr "んーー！舌が焼けそう！"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.HALLOWEENCANDY_2
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.HALLOWEENCANDY_2"
msgid "Do people actually eat these or are they just a bad joke?"
msgstr "本当にこれって食べ物？それとも悪い冗談？"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.HALLOWEENCANDY_3
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.HALLOWEENCANDY_3"
msgid "Ewwww it's corn flavored!"
msgstr "げー、トウモロコシ味だ！"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.HALLOWEENCANDY_4
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.HALLOWEENCANDY_4"
msgid "Eww! I hate black licorice!"
msgstr "うわ！ブラックリコリスは嫌い！"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.HALLOWEENCANDY_5
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.HALLOWEENCANDY_5"
msgid "These are a meow-uthful."
msgstr "ニャンて使えるの。"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.HALLOWEENCANDY_6
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.HALLOWEENCANDY_6"
msgid "Hey Wolfgang, eat one and tell us what it is!"
msgstr "ねぇウルフガング。これを食べて何だったか教えて！"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.HALLOWEENCANDY_7
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.HALLOWEENCANDY_7"
