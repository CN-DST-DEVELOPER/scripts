msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.WX78MODULE_CHESS"
msgid "WX, you gotta stop leavin' this stuff lying around!"
msgstr "WX、あちこちに物を散らかすのはやめな！"

