msgstr "サーフィン仲間にピッタリ！"

#. STRINGS.SKIN_DESCRIPTIONS.stonetable_round_victorianblack
msgctxt "STRINGS.SKIN_DESCRIPTIONS.stonetable_round_victorianblack"
msgid "There's a place at this table for everyone... of a certain status."
msgstr "誰もがこのテーブルにつくことができる…当然、一定の地位は必要だが。"

