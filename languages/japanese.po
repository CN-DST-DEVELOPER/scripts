msgstr "ル・シェ。使われてるネ。"

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.STONE_TABLE.GENERIC
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.STONE_TABLE.GENERIC"
