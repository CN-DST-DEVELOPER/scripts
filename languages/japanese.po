msgstr "串に刺さった甘味だな。"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.YOTR_RABBITSHRINE.BURNT
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.YOTR_RABBITSHRINE.BURNT"
