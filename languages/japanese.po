#. STRINGS.RECIPE_DESC.ABIGAIL_FLOWER
msgctxt "STRINGS.RECIPE_DESC.ABIGAIL_FLOWER"
msgid "A magical keepsake."
msgstr "魔力をたたえた、形見の品。"

#. STRINGS.RECIPE_DESC.ACCOMPLISHMENT_SHRINE
msgctxt "STRINGS.RECIPE_DESC.ACCOMPLISHMENT_SHRINE"
msgid "Prove your worth as a human being."
msgstr "人間としての価値を証明しよう。"

#. STRINGS.RECIPE_DESC.AMULET
msgctxt "STRINGS.RECIPE_DESC.AMULET"
msgid "Protects you from death."
msgstr "死から君を守る。"

#. STRINGS.RECIPE_DESC.ANCHOR
msgctxt "STRINGS.RECIPE_DESC.ANCHOR"
msgid "Boat brakes."
msgstr "船のブレーキ。"

#. STRINGS.RECIPE_DESC.ANCHOR_ITEM
msgctxt "STRINGS.RECIPE_DESC.ANCHOR_ITEM"
msgid "Boat brakes."
msgstr "船のブレーキ。"

#. STRINGS.RECIPE_DESC.ANCHOR_SKETCH
msgctxt "STRINGS.RECIPE_DESC.ANCHOR_SKETCH"
msgid "The moon and sea will be your inspirations."
msgstr "月と海がインスピレーションをもたらすだろう。"

#. STRINGS.RECIPE_DESC.ANTLIONHAT
msgctxt "STRINGS.RECIPE_DESC.ANTLIONHAT"
msgid "Shake things up by getting rid of old turf."
msgstr "芝を取り除き、感動で震えるほどの変化を起こす。"

#. STRINGS.RECIPE_DESC.ARCHIVE_RESONATOR_ITEM
msgctxt "STRINGS.RECIPE_DESC.ARCHIVE_RESONATOR_ITEM"
msgid "What secrets will it unearth?"
msgstr "どんな秘密を掘り起こしてくれるのだろうか？"

#. STRINGS.RECIPE_DESC.ARMORDRAGONFLY
msgctxt "STRINGS.RECIPE_DESC.ARMORDRAGONFLY"
msgid "Armor with a fiery temper."
msgstr "炎のように熱くなる気質の装甲。"

#. STRINGS.RECIPE_DESC.ARMORDREADSTONE
msgctxt "STRINGS.RECIPE_DESC.ARMORDREADSTONE"
msgid "Have no fear, the darkness will protect you."
msgstr "恐れることなかれ。暗闇が守ってくれる。"

#. STRINGS.RECIPE_DESC.ARMORGRASS
msgctxt "STRINGS.RECIPE_DESC.ARMORGRASS"
msgid "Provides a small amount of protection."
msgstr "プロテクション効果がほんの少しある。"

#. STRINGS.RECIPE_DESC.ARMORMARBLE
msgctxt "STRINGS.RECIPE_DESC.ARMORMARBLE"
msgid "It's heavy, but it will protect you."
msgstr "重いが、君を守ってくれる。"

#. STRINGS.RECIPE_DESC.ARMORRUINS
msgctxt "STRINGS.RECIPE_DESC.ARMORRUINS"
msgid "Flashy AND protective."
msgstr "派手な上に防御効果あり。"

#. STRINGS.RECIPE_DESC.ARMORSLURPER
msgctxt "STRINGS.RECIPE_DESC.ARMORSLURPER"
msgid "Keep that belly full."
msgstr "満腹状態をキープしよう。"

#. STRINGS.RECIPE_DESC.ARMORWAGPUNK
msgctxt "STRINGS.RECIPE_DESC.ARMORWAGPUNK"
msgid "Kick it into high gear, full steam ahead!"
msgstr "ギアを上げて、全速力で進め！"

#. STRINGS.RECIPE_DESC.ARMORWOOD
msgctxt "STRINGS.RECIPE_DESC.ARMORWOOD"
msgid "Protects you from some damage."
msgstr "ダメージから身をある程度守ってくれる。"

#. STRINGS.RECIPE_DESC.ARMOR_BRAMBLE
msgctxt "STRINGS.RECIPE_DESC.ARMOR_BRAMBLE"
msgid "Nature's way of saying \"keep away\"."
msgstr "「近寄るな」を自然に表現できる。"

#. STRINGS.RECIPE_DESC.ARMOR_CARROTLURE
msgctxt "STRINGS.RECIPE_DESC.ARMOR_CARROTLURE"
msgid "Don this coat, and the Bunnymen shall hop to it."
msgstr "このコートに身を包めば、バニーマンがピョンピョンと寄ってくるだろう。"

#. STRINGS.RECIPE_DESC.ARMOR_LUNARPLANT
msgctxt "STRINGS.RECIPE_DESC.ARMOR_LUNARPLANT"
msgid "Surround yourself in formidable lunar leaves."
msgstr "恐るべき月の木の葉で身を包もう。"

#. STRINGS.RECIPE_DESC.ARMOR_LUNARPLANT_HUSK
msgctxt "STRINGS.RECIPE_DESC.ARMOR_LUNARPLANT_HUSK"
msgid "Become the prickliest of them all."
msgstr "誰よりも尖った存在に。"

#. STRINGS.RECIPE_DESC.ARMOR_SANITY
msgctxt "STRINGS.RECIPE_DESC.ARMOR_SANITY"
msgid "Protects your body, but not your mind."
msgstr "体は守るけれど、精神はその限りにあらず。"

#. STRINGS.RECIPE_DESC.ARMOR_VOIDCLOTH
msgctxt "STRINGS.RECIPE_DESC.ARMOR_VOIDCLOTH"
msgid "A nightmarish cloak to keep the light at bay."
msgstr "光を寄せ付けない悪夢のようなマント。"

#. STRINGS.RECIPE_DESC.ARROWSIGN_POST
msgctxt "STRINGS.RECIPE_DESC.ARROWSIGN_POST"
msgid "Point fingers at the world. Or signs."
msgstr "あっちこっちを指し示す看板。"

#. STRINGS.RECIPE_DESC.AXE
msgctxt "STRINGS.RECIPE_DESC.AXE"
msgid "Chop down trees!"
msgstr "木を切り倒せ！"

#. STRINGS.RECIPE_DESC.BACKPACK
msgctxt "STRINGS.RECIPE_DESC.BACKPACK"
msgid "Carry more stuff."
msgstr "運べる荷物が増える。"

#. STRINGS.RECIPE_DESC.BALLOON
msgctxt "STRINGS.RECIPE_DESC.BALLOON"
msgid "Who doesn't like balloons?"
msgstr "風船が嫌いな人なんているの？"

#. STRINGS.RECIPE_DESC.BALLOONHAT
msgctxt "STRINGS.RECIPE_DESC.BALLOONHAT"
