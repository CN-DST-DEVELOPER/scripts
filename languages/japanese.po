msgstr "あの岩、生きてるぞ！"

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.QUAGMIRE_PIGEON.DEAD
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.QUAGMIRE_PIGEON.DEAD"
