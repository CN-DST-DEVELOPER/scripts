msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.FUMAROLESHOVEL.LUKEWARM"
msgid "What's the harm? It's barely warm!"
msgstr "ポカポカだけど、ポカはしないようにしないとね！"

