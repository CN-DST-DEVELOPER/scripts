msgstr "パーティーの明かりか？うーん…"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.YOTS_SNAKESHRINE.BURNT
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.YOTS_SNAKESHRINE.BURNT"
msgid "What a shame."
msgstr "残念ね…"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.YOTS_SNAKESHRINE.EMPTY
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.YOTS_SNAKESHRINE.EMPTY"
