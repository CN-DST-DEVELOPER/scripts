msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.SLINGSHOT_FRAME_WAGPUNK_0"
msgid "The young scout doth come into his own."
msgstr "あの若いスカウトは、本領を発揮したな。"

