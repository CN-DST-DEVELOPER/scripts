msgstr "やっべ。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.GESTALT
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.GESTALT"
msgid "We're all connected, eh?"
msgstr "オレたちは、みんなつながっているんだろ？"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.GESTALT_CAGE.FILLED
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.GESTALT_CAGE.FILLED"
