msgstr "ブタか何かにあげるよ。"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.YOTP_FOOD3
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.YOTP_FOOD3"
