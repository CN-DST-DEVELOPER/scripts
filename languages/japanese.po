msgstr "寝ている。"

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.CHESTUPGRADE_STACKSIZE
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.CHESTUPGRADE_STACKSIZE"
