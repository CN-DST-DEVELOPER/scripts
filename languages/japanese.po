msgstr "うわ～、こりゃすごいごちそうだ！"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.YOTP_FOOD2
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.YOTP_FOOD2"
