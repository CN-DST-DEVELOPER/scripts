msgstr "さあ、入るぞ。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.QUAGMIRE_PARK_GATE.LOCKED
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.QUAGMIRE_PARK_GATE.LOCKED"
msgid "We need a key to open it."
msgstr "開けるにはカギがいるな。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.QUAGMIRE_PARK_OBELISK
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.QUAGMIRE_PARK_OBELISK"
