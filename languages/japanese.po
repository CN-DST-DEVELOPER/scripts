msgstr "栄光に続く道の中間地点。"

#. STRINGS.RECIPE_DESC.YOTC_CARRAT_RACE_FINISH
msgctxt "STRINGS.RECIPE_DESC.YOTC_CARRAT_RACE_FINISH"
