#. STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.POCKETWATCH_PORTAL_ENTRANCE.GENERIC
msgctxt "STRINGS.CHARACTERS.WATHGRITHR.DESCRIBE.POCKETWATCH_PORTAL_ENTRANCE.GENERIC"
