msgstr "なかなかイケるゼ"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.YOTS_LANTERN_POST_ITEM
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.YOTS_LANTERN_POST_ITEM"
