msgstr "塩は掘削の準備ができてるよ。"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.QUAGMIRE_SALT_RACK_ITEM
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.QUAGMIRE_SALT_RACK_ITEM"
msgid "Let's set'er up proper."
msgstr "さあ、ちゃんとセットアップしよう。"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.QUAGMIRE_SAP
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.QUAGMIRE_SAP"
msgid "Alright, it's pretty good."
msgstr "うん。上出来だ。"

