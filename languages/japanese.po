msgstr "何かの種。"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.YOTC_SEEDPACKET_RARE
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.YOTC_SEEDPACKET_RARE"
