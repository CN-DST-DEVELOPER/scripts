msgstr "あの男は嫌いだ。"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.MAXWELLHEAD
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.MAXWELLHEAD"
