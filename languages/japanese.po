msgstr "私は手を汚したくないんだよ。"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.COMPOSTINGBIN.BALANCED
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.COMPOSTINGBIN.BALANCED"
