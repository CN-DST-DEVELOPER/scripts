msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.QUAGMIRE_POT_HANGER_ITEM"
msgid "For suspension-based cookery."
msgstr "宙に浮かせて料理するためのもの。"

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.QUAGMIRE_POT_SMALL
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.QUAGMIRE_POT_SMALL"
msgid "Let's get cooking!"
msgstr "よし、料理しよう！"

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.QUAGMIRE_POT_SYRUP
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.QUAGMIRE_POT_SYRUP"
msgid "I need to sweeten this pot."
msgstr "この鍋に甘さを加えないと。"

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.QUAGMIRE_ROTTEN_CROP
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.QUAGMIRE_ROTTEN_CROP"
msgid "I don't think the altar will want that."
msgstr "祭壇が求めているものとは思えない。"

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.QUAGMIRE_RUBBLE_BIKE
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.QUAGMIRE_RUBBLE_BIKE"
msgid "Must have mis-spoke."
msgstr "スポークが折れたに違いない。"

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.QUAGMIRE_RUBBLE_CARRIAGE
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.QUAGMIRE_RUBBLE_CARRIAGE"
msgid "On the road to nowhere."
msgstr "どこにも通じていない道。"

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.QUAGMIRE_RUBBLE_CATHEDRAL
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.QUAGMIRE_RUBBLE_CATHEDRAL"
msgid "Preyed upon."
msgstr "蹂躙されている。"

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.QUAGMIRE_RUBBLE_CHIMNEY
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.QUAGMIRE_RUBBLE_CHIMNEY"
msgid "Something put a damper on that chimney."
msgstr "煙突に何かが詰まってるみたいだ。"

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.QUAGMIRE_RUBBLE_CHIMNEY2
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.QUAGMIRE_RUBBLE_CHIMNEY2"
msgid "Something put a damper on that chimney."
msgstr "煙突に何かが詰まってるみたいだ。"

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.QUAGMIRE_RUBBLE_CLOCK
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.QUAGMIRE_RUBBLE_CLOCK"
msgid "Someone beat the clock. Literally."
msgstr "誰かが時計を壊したんだな。"

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.QUAGMIRE_RUBBLE_CLOCKTOWER
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.QUAGMIRE_RUBBLE_CLOCKTOWER"
msgid "That clock's been punched."
msgstr "時計が壊されているね。"

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.QUAGMIRE_RUBBLE_HOUSE.1
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.QUAGMIRE_RUBBLE_HOUSE.1"
msgid "No one's here."
msgstr "誰もいない。"

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.QUAGMIRE_RUBBLE_HOUSE.2
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.QUAGMIRE_RUBBLE_HOUSE.2"
msgid "Something destroyed this town."
msgstr "この街は何かに破壊されたんだ。"

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.QUAGMIRE_RUBBLE_HOUSE.3
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.QUAGMIRE_RUBBLE_HOUSE.3"
msgid "I wonder who they angered."
msgstr "一体何者を怒らせてしまったんだろう。"

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.QUAGMIRE_RUBBLE_PUBDOOR
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.QUAGMIRE_RUBBLE_PUBDOOR"
msgid "No longer a-door-able."
msgstr "もうドアとは呼べない。"

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.QUAGMIRE_RUBBLE_ROOF
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.QUAGMIRE_RUBBLE_ROOF"
msgid "Someone hit the roof."
msgstr "誰かが屋根を壊したんだ。"

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.QUAGMIRE_SAFE.GENERIC
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.QUAGMIRE_SAFE.GENERIC"
msgid "It's a safe. For keeping things safe."
msgstr "金庫だ。中のものを守れる。"

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.QUAGMIRE_SAFE.LOCKED
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.QUAGMIRE_SAFE.LOCKED"
msgid "It won't open without the key."
msgstr "鍵がないと開かないな。"

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.QUAGMIRE_SALMON
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.QUAGMIRE_SALMON"
msgid "Mm, fresh fish."
msgstr "んー、新鮮な魚だ。"

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.QUAGMIRE_SALMON_COOKED
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.QUAGMIRE_SALMON_COOKED"
msgid "Ready for the dinner table."
msgstr "食卓に並べる準備ができた。"

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.QUAGMIRE_SALT
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.QUAGMIRE_SALT"
msgid "It's full of salt."
msgstr "塩でいっぱいだ。"

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.QUAGMIRE_SALTROCK
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.QUAGMIRE_SALTROCK"
msgid "Salt. The tastiest mineral."
msgstr "塩。世界一美味しい無機質。"

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.QUAGMIRE_SALT_RACK.GENERIC
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.QUAGMIRE_SALT_RACK.GENERIC"
msgid "Science takes time."
msgstr "科学には時間が掛かる。"

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.QUAGMIRE_SALT_RACK.READY
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.QUAGMIRE_SALT_RACK.READY"
msgid "Salt has gathered on the rope."
msgstr "塩がロープの上に結晶化している。"

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.QUAGMIRE_SALT_RACK_ITEM
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.QUAGMIRE_SALT_RACK_ITEM"
msgid "For harvesting salt from the pond."
msgstr "池から塩を収穫するための道具。"

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.QUAGMIRE_SAP
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.QUAGMIRE_SAP"
msgid "It tastes sweet."
msgstr "甘い味がする。"

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.QUAGMIRE_SAPBUCKET
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.QUAGMIRE_SAPBUCKET"
msgid "We can use it to gather sap from the trees."
msgstr "これを使って木から樹液を集められる。"

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.QUAGMIRE_SAPLING
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.QUAGMIRE_SAPLING"
msgid "I can't get anything else out of that."
msgstr "そこからは他に何も得られない。"

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.QUAGMIRE_SAP_SPOILED
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.QUAGMIRE_SAP_SPOILED"
msgid "Might as well toss it on the fire."
msgstr "火に投げ込んでもいいな。"

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.QUAGMIRE_SEEDPACKET
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.QUAGMIRE_SEEDPACKET"
msgid "Sow what?"
msgstr "で、どんな種をまく？"

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.QUAGMIRE_SLAUGHTERTOOL
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.QUAGMIRE_SLAUGHTERTOOL"
msgid "Laboratory tools for surgical butchery."
msgstr "外科的に解体するための研究室用の道具。"

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.QUAGMIRE_SPOTSPICE_GROUND
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.QUAGMIRE_SPOTSPICE_GROUND"
msgid "Flavorful."
msgstr "風味豊か。"

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.QUAGMIRE_SPOTSPICE_SHRUB.GENERIC
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.QUAGMIRE_SPOTSPICE_SHRUB.GENERIC"
msgid "It reminds me of those tentacle monsters."
msgstr "触手の生えたモンスターを思い出させる。"

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.QUAGMIRE_SPOTSPICE_SHRUB.PICKED
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.QUAGMIRE_SPOTSPICE_SHRUB.PICKED"
msgid "I can't get anymore out of that shrub."
msgstr "その茂みからは他に何も得られない。"

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.QUAGMIRE_SPOTSPICE_SPRIG
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.QUAGMIRE_SPOTSPICE_SPRIG"
msgid "I could grind it up to make a spice."
msgstr "すりつぶせばスパイスになる。"

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.QUAGMIRE_SUGARWOODTREE.GENERIC
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.QUAGMIRE_SUGARWOODTREE.GENERIC"
msgid "It's full of delicious, delicious sap."
msgstr "とっても美味しい樹液でいっぱいだ。"

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.QUAGMIRE_SUGARWOODTREE.STUMP
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.QUAGMIRE_SUGARWOODTREE.STUMP"
msgid "Where'd the tree go? I'm stumped."
msgstr "木はどこだ？参ったな。"

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.QUAGMIRE_SUGARWOODTREE.TAPPED_BUGS
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.QUAGMIRE_SUGARWOODTREE.TAPPED_BUGS"
msgid "That's how you get ants."
msgstr "アリを捕まえるにはいいね。"

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.QUAGMIRE_SUGARWOODTREE.TAPPED_EMPTY
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.QUAGMIRE_SUGARWOODTREE.TAPPED_EMPTY"
msgid "Here sappy, sappy, sap."
msgstr "ここにたっぷりと樹液が。"

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.QUAGMIRE_SUGARWOODTREE.TAPPED_READY
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.QUAGMIRE_SUGARWOODTREE.TAPPED_READY"
msgid "Sweet golden sap."
msgstr "甘くて金色の樹液だ。"

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.QUAGMIRE_SUGARWOODTREE.WOUNDED
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.QUAGMIRE_SUGARWOODTREE.WOUNDED"
msgid "It looks ill."
msgstr "病気のようだ。"

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.QUAGMIRE_SWAMPIG
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.QUAGMIRE_SWAMPIG"
msgid "It's a super hairy pig."
msgstr "すごく毛深いブタだ。"

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.QUAGMIRE_SWAMPIGELDER.GENERIC
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.QUAGMIRE_SWAMPIGELDER.GENERIC"
msgid "I guess you're in charge around here?"
msgstr "ここら辺の責任者みたいに見えるね。"

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.QUAGMIRE_SWAMPIGELDER.SLEEPING
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.QUAGMIRE_SWAMPIGELDER.SLEEPING"
msgid "It's sleeping, for now."
msgstr "寝ている。今のところはね。"

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.QUAGMIRE_SWAMPIG_HOUSE
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.QUAGMIRE_SWAMPIG_HOUSE"
msgid "It's seen better days."
msgstr "ずいぶんとみすぼらしい人形だ"

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.QUAGMIRE_SWAMPIG_HOUSE_RUBBLE
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.QUAGMIRE_SWAMPIG_HOUSE_RUBBLE"
msgid "Some pig's house was ruined."
msgstr "ブタの家がいくつか壊されてる。"

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.QUAGMIRE_SYRUP
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.QUAGMIRE_SYRUP"
msgid "Adds sweetness to the mixture."
msgstr "混合物に甘さを加えられる。"

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.QUAGMIRE_TOMATO
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.QUAGMIRE_TOMATO"
msgid "It's red because it's full of science."
msgstr "赤いのは科学が詰まってるからさ。"

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.QUAGMIRE_TOMATO_COOKED
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.QUAGMIRE_TOMATO_COOKED"
msgid "Cooking's easy if you understand chemistry."
msgstr "化学を理解すれば、料理なんて簡単さ。"

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.QUAGMIRE_TOMATO_SEEDS
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.QUAGMIRE_TOMATO_SEEDS"
msgid "A handful of odd seeds."
msgstr "一握りの変な種。"

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.QUAGMIRE_TRADER_MERM
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.QUAGMIRE_TRADER_MERM"
msgid "Maybe they'd be willing to trade."
msgstr "喜んで取引に応じてくれるんじゃないかな。"

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.QUAGMIRE_TRADER_MERM2
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.QUAGMIRE_TRADER_MERM2"
msgid "Maybe they'd be willing to trade."
msgstr "喜んで取引に応じてくれるんじゃないかな。"

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.QUAGMIRE_TURNIP
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.QUAGMIRE_TURNIP"
msgid "It's a raw turnip."
msgstr "生のカブだ。"

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.QUAGMIRE_TURNIP_COOKED
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.QUAGMIRE_TURNIP_COOKED"
msgid "Cooking is science in practice."
msgstr "料理は実践的な科学だよ。"

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.QUAGMIRE_TURNIP_SEEDS
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.QUAGMIRE_TURNIP_SEEDS"
msgid "A handful of odd seeds."
msgstr "一握りの変な種。"

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.QUAGMIRE_WHEAT
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.QUAGMIRE_WHEAT"
msgid "It looks a bit grainy."
msgstr "粒々してる。"

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.QUAGMIRE_WHEAT_SEEDS
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.QUAGMIRE_WHEAT_SEEDS"
msgid "A handful of odd seeds."
msgstr "一握りの変な種。"

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.RABBIT.GENERIC
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.RABBIT.GENERIC"
msgid "A rabbit... or is it?"
msgstr "あ、ウサギ…ちがう？"

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.RABBIT.HELD
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.RABBIT.HELD"
msgid "What am I supposed to do with it now?"
msgstr "これをどうすればいいの？"

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.RABBITHAT
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.RABBITHAT"
msgid "A fashion statement?"
msgstr "ファッションを通して自己主張かい？"

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.RABBITHOLE.GENERIC
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.RABBITHOLE.GENERIC"
msgid "I'd better watch my step, wouldn't want to fall down a rabbit hole."
msgstr "足元に気を付けないと。ウサギの穴に落ちるのはごめんだわ。"

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.RABBITHOLE.SPRING
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.RABBITHOLE.SPRING"
msgid "No more rabbit hole, for now."
msgstr "もうウサギの穴はない。少なくとも今は。"

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.RABBITHOUSE.BURNT
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.RABBITHOUSE.BURNT"
msgid "Something smells good!"
msgstr "何か良い匂いがするわ！"

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.RABBITHOUSE.GENERIC
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.RABBITHOUSE.GENERIC"
msgid "These carrots stuff themselves full of rabbits."
msgstr "あのニンジンはウサギでお腹がいっぱいなのね。"

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.RABBITKINGHORN
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.RABBITKINGHORN"
msgid "It plays a familiar tune."
msgstr "聞いたことのある音を奏でるんだね。"

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.RABBITKINGHORN_CHEST
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.RABBITKINGHORN_CHEST"
