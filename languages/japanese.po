msgstr "小さな普通の卵。"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.BIRD_EGG_COOKED
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.BIRD_EGG_COOKED"
