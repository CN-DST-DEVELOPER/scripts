msgid "n/a"
msgstr "n/a"

#. STRINGS.SKIN_DESCRIPTIONS.fence_rose
msgctxt "STRINGS.SKIN_DESCRIPTIONS.fence_rose"
msgid "Rose thorns are nature's barbed wire."
msgstr "バラのトゲは自然界の有刺鉄線。"

#. STRINGS.SKIN_DESCRIPTIONS.fence_rose_item
msgctxt "STRINGS.SKIN_DESCRIPTIONS.fence_rose_item"
