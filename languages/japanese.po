msgstr "異音を発する時計仕掛けの騎士に捧げものをしよう。"

#. STRINGS.RECIPE_DESC.YOTH_KNIGHTSTICK
msgctxt "STRINGS.RECIPE_DESC.YOTH_KNIGHTSTICK"
