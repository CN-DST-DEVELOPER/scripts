msgstr "ああ、煩わしい。またこの時期がもう来たの？"

#. STRINGS.CHARACTERS.WANDA.ANNOUNCE_DESPAWN
msgctxt "STRINGS.CHARACTERS.WANDA.ANNOUNCE_DESPAWN"
msgid "Wait, stop! I need more time--!"
msgstr "待って、止めて！もっと時間が必要なの！"

#. STRINGS.CHARACTERS.WANDA.ANNOUNCE_DETACH_BUFF_ATTACK
msgctxt "STRINGS.CHARACTERS.WANDA.ANNOUNCE_DETACH_BUFF_ATTACK"
msgid "Whew, I don't know what came over me..."
msgstr "はー、何があったのかわからないわ…"

#. STRINGS.CHARACTERS.WANDA.ANNOUNCE_DETACH_BUFF_ELECTRICATTACK
msgctxt "STRINGS.CHARACTERS.WANDA.ANNOUNCE_DETACH_BUFF_ELECTRICATTACK"
msgid "I'll miss having electricity at my fingertips."
msgstr "ピピっとリモコン使える電気のある生活が懐かしい。"

#. STRINGS.CHARACTERS.WANDA.ANNOUNCE_DETACH_BUFF_MOISTUREIMMUNITY
msgctxt "STRINGS.CHARACTERS.WANDA.ANNOUNCE_DETACH_BUFF_MOISTUREIMMUNITY"
