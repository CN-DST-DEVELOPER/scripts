msgstr "どこかで聞いたことがあるネ。"

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.RECORD_BALATRO
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.RECORD_BALATRO"
msgid "Reminds me of fun times."
msgstr "楽しかったあの頃を思い出すネ。"

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.RECORD_CREEPYFOREST
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.RECORD_CREEPYFOREST"
