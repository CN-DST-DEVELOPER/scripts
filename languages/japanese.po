msgstr "セ・ラ・ヴィ、人生そんなものヨ。"

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.CARPENTRY_STATION.GENERIC
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.CARPENTRY_STATION.GENERIC"
