msgstr "灰は灰に。"

#. STRINGS.CHARACTERS.WANDA.DESCRIBE.QUAGMIRE_PEBBLECRAB
msgctxt "STRINGS.CHARACTERS.WANDA.DESCRIBE.QUAGMIRE_PEBBLECRAB"
