msgstr "準備万端みたい。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.GENERIC_CORPSE.BURNING
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.GENERIC_CORPSE.BURNING"
