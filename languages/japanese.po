msgstr "逃げられるうちに逃げたほうがいいさ！"

#. STRINGS.CHARACTERS.WINONA.WENDY_SKILLTREE_EASTEREGG
msgctxt "STRINGS.CHARACTERS.WINONA.WENDY_SKILLTREE_EASTEREGG"
msgid "only_used_by_wendy"
msgstr "only_used_by_wendy"

#. STRINGS.CHARACTERS.WOLFGANG.ACTIONFAIL.ACTIVATE.CARNIVAL_HOST_HERE
msgctxt "STRINGS.CHARACTERS.WOLFGANG.ACTIONFAIL.ACTIVATE.CARNIVAL_HOST_HERE"
