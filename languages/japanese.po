msgstr "キャラットのスタミナを強化する。"

#. STRINGS.RECIPE_DESC.YOTC_CARRAT_RACE_CHECKPOINT
msgctxt "STRINGS.RECIPE_DESC.YOTC_CARRAT_RACE_CHECKPOINT"
