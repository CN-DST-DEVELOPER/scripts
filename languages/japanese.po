msgstr "ペンがあったら、なんか書けるけどなー"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.ARROWSIGN_POST.UNWRITTEN
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.ARROWSIGN_POST.UNWRITTEN"
msgid "Ooooh, what should we say?"
msgstr "なんて書く？なんて書く！？"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.ASH.GENERIC
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.ASH.GENERIC"
msgid "Funk to funky."
msgstr "ファンクからファンキーへ。"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.ASH.REMAINS_EYE_BONE
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.ASH.REMAINS_EYE_BONE"
msgid "The eyebone didn't survive the trip."
msgstr "アイボーンは旅に堪えられなかった。"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.ASH.REMAINS_GLOMMERFLOWER
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.ASH.REMAINS_GLOMMERFLOWER"
msgid "The flower didn't make it."
msgstr "お花は生き延びなかった。"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.ASH.REMAINS_THINGIE
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.ASH.REMAINS_THINGIE"
msgid "Whatever it was, it's gone back to the earth."
msgstr "何だったにしろ、大地に還った。"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.ASPARAGUS
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.ASPARAGUS"
msgid "Mom said we should eat our vegetables."
msgstr "ママが野菜を食べろって。"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.ASPARAGUSSOUP
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.ASPARAGUSSOUP"
msgid "Mmmm...warms our tummy."
msgstr "ん～…お腹がポカポカになる。"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.ASPARAGUS_COOKED
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.ASPARAGUS_COOKED"
msgid "Asparagus makes our pee smell funny."
msgstr "これを食べるとおしっこが変な匂いになる。"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.ASPARAGUS_OVERSIZED
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.ASPARAGUS_OVERSIZED"
msgid "Oh... that's a lot of asparagus..."
msgstr "あーぁ…すごい量のアスパラガスだよー…"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.ASPARAGUS_SEEDS
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.ASPARAGUS_SEEDS"
msgid "Do we have a garden to plant this?"
msgstr "植えられる庭があるかな？"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.ATRIUM_GATE.CHARGING
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.ATRIUM_GATE.CHARGING"
msgid "What's it doing?"
msgstr "なになに？どうなってんの？"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.ATRIUM_GATE.COOLDOWN
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.ATRIUM_GATE.COOLDOWN"
msgid "It wasn't a way home, anyway."
msgstr "ま、どうせおうちには帰れないしね"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.ATRIUM_GATE.DESTABILIZING
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.ATRIUM_GATE.DESTABILIZING"
msgid "It looks like it's gonna blow up!"
msgstr "え…爆発しそうなんだけど！"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.ATRIUM_GATE.OFF
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.ATRIUM_GATE.OFF"
msgid "We need another piece to turn it on."
msgstr "パーツが1つ足んないみたいだね"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.ATRIUM_GATE.ON
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.ATRIUM_GATE.ON"
msgid "Does this mean we get to go home?"
msgstr "これって…おうちに帰れるってこと？"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.ATRIUM_KEY
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.ATRIUM_KEY"
msgid "This key is REALLY old."
msgstr "このカギ…すーーーっごく古そう"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.ATRIUM_LIGHT.OFF
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.ATRIUM_LIGHT.OFF"
msgid "No light."
msgstr "明かり、ついてないね"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.ATRIUM_LIGHT.ON
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.ATRIUM_LIGHT.ON"
