msgstr "斧で叩き割ってやりたくなるな。"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.RECORD_DANGER
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.RECORD_DANGER"
