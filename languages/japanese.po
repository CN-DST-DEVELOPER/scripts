msgstr "万が一の時のためにとっておこう。"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.QUAGMIRE_COIN3
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.QUAGMIRE_COIN3"
msgid "Gotta watch I don't turn into a rich dope."
msgstr "あたいはアホな金持ちにならないように気を付けないと。"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.QUAGMIRE_COIN4
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.QUAGMIRE_COIN4"
msgid "We could bust outta here with enough of these."
msgstr "これがいっぱいあったら、あたいら全員、ここから脱出することもできる。"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.QUAGMIRE_CRABMEAT
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.QUAGMIRE_CRABMEAT"
msgid "I get crabby when I'm hungry. Ha!"
msgstr "あたい、おなかすいてると無性にハサミでちょん切りたくなるんだよ、ハハ！"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.QUAGMIRE_CRABMEAT_COOKED
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.QUAGMIRE_CRABMEAT_COOKED"
msgid "It's a big lump of cooked crab."
msgstr "すご～く大きいカニの料理だね。"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.QUAGMIRE_CRABTRAP
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.QUAGMIRE_CRABTRAP"
msgid "Here lil crabby crab."
msgstr "こっちは小さいカニ。"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.QUAGMIRE_FERN
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.QUAGMIRE_FERN"
msgid "Fresh roughage."
msgstr "新鮮な食物繊維。"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.QUAGMIRE_FLOUR
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.QUAGMIRE_FLOUR"
msgid "I ain't much of a baker."
msgstr "あたいは、あんまりパン焼き得意じゃない。"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.QUAGMIRE_FOLIAGE_COOKED
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.QUAGMIRE_FOLIAGE_COOKED"
msgid "Cooked roughage."
msgstr "料理した食物繊維。"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.QUAGMIRE_FOOD.GENERIC
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.QUAGMIRE_FOOD.GENERIC"
msgid "Let's throw it up on that altar, hey?"
msgstr "これをあの祭壇に放り投げよう。"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.QUAGMIRE_FOOD.MATCH
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.QUAGMIRE_FOOD.MATCH"
msgid "Perfect."
msgstr "完璧。"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.QUAGMIRE_FOOD.MATCH_BUT_SNACK
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.QUAGMIRE_FOOD.MATCH_BUT_SNACK"
msgid "It's the right food, but it don't look too filling."
msgstr "これは良い食事だけど、おなかいっぱいにはならなそう。"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.QUAGMIRE_FOOD.MISMATCH
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.QUAGMIRE_FOOD.MISMATCH"
msgid "Well this ain't right."
msgstr "んー、これは正しくない。"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.QUAGMIRE_FOOD_BURNT
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.QUAGMIRE_FOOD_BURNT"
msgid "It's a little toastier than normal."
msgstr "いつもよりカリッとしてるね。"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.QUAGMIRE_GARLIC
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.QUAGMIRE_GARLIC"
msgid "Makes everything taste better."
msgstr "なんでももっとおいしくするね。"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.QUAGMIRE_GARLIC_COOKED
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.QUAGMIRE_GARLIC_COOKED"
msgid "Bet that brought out the flavor."
msgstr "これで風味豊かになったことは間違いないよ。"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.QUAGMIRE_GARLIC_SEEDS
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.QUAGMIRE_GARLIC_SEEDS"
msgid "I got no idea what they'd grow into."
msgstr "これが育つと何になるのか想像もつかないな。"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.QUAGMIRE_GOATKID
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.QUAGMIRE_GOATKID"
msgid "What's goin' on, squirt?"
msgstr "何してるんだい？でしゃばりさん？"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.QUAGMIRE_GOATMILK
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.QUAGMIRE_GOATMILK"
msgid "I try to support local artisans."
msgstr "あたいは地元の生産者を助けるよ。"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.QUAGMIRE_GOATMUM
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.QUAGMIRE_GOATMUM"
msgid "Got anything for me?"
msgstr "あたいピッタリなものある？"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.QUAGMIRE_GRILL
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.QUAGMIRE_GRILL"
msgid "Time for a cookout!"
msgstr "さあ、外で料理の時間だ！"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.QUAGMIRE_GRILL_ITEM
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.QUAGMIRE_GRILL_ITEM"
msgid "I need to to find a firepit for this to work."
msgstr "これを使える炉を見つけないと。"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.QUAGMIRE_GRILL_SMALL
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.QUAGMIRE_GRILL_SMALL"
msgid "Big enough for a small cookout."
msgstr "ちょっと焼く分には十分。 "

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.QUAGMIRE_GRILL_SMALL_ITEM
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.QUAGMIRE_GRILL_SMALL_ITEM"
msgid "Now where can I put this..."
msgstr "さて、これをどこに置けばいいかな..."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.QUAGMIRE_HOE
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.QUAGMIRE_HOE"
msgid "I never done farmwork."
msgstr "あたい、農場での仕事はしたことないんだ。"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.QUAGMIRE_KEY
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.QUAGMIRE_KEY"
msgid "Hmmm... looks like the key to a safe."
msgstr "んー。金庫の鍵みたいだね。"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.QUAGMIRE_KEY_PARK
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.QUAGMIRE_KEY_PARK"
msgid "It's a gate key."
msgstr "これはゲートの鍵だ。"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.QUAGMIRE_LAMP_POST
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.QUAGMIRE_LAMP_POST"
msgid "That'd be a street lamp. Yep."
msgstr "これは街路灯になるね。良かった！"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.QUAGMIRE_LAMP_SHORT
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.QUAGMIRE_LAMP_SHORT"
msgid "That's a light."
msgstr "灯りだ。"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.QUAGMIRE_MEALINGSTONE
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.QUAGMIRE_MEALINGSTONE"
msgid "Ah! A job that could use some elbow grease!"
msgstr "ああ！汗水垂らせる仕事がきた！"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.QUAGMIRE_MERMHOUSE
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.QUAGMIRE_MERMHOUSE"
msgid "Zero form, zero function."
msgstr "形もなければ、機能もない。"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.QUAGMIRE_MERM_CART1
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.QUAGMIRE_MERM_CART1"
msgid "Anything good in there?"
msgstr "何か良い物ある？"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.QUAGMIRE_MERM_CART2
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.QUAGMIRE_MERM_CART2"
msgid "It's full of stuff I could use."
msgstr "使える物がいっぱいだよ。"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.QUAGMIRE_MUSHROOMS
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.QUAGMIRE_MUSHROOMS"
msgid "Wouldn't mind popping these suckers into the pot."
msgstr "あれを鍋に入れても問題ない。"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.QUAGMIRE_MUSHROOMSTUMP.GENERIC
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.QUAGMIRE_MUSHROOMSTUMP.GENERIC"
msgid "Well, they don't LOOK poisonous."
msgstr "あれは、見かけは毒じゃない。見かけはね。"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.QUAGMIRE_MUSHROOMSTUMP.PICKED
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.QUAGMIRE_MUSHROOMSTUMP.PICKED"
msgid "It's just a stump."
msgstr "ただの切り株だ。"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.QUAGMIRE_ONION
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.QUAGMIRE_ONION"
msgid "I hate chopping vegetables."
msgstr "野菜刻むのって大嫌いさ。"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.QUAGMIRE_ONION_COOKED
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.QUAGMIRE_ONION_COOKED"
msgid "Done and done."
msgstr "完成ったら完成。"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.QUAGMIRE_ONION_SEEDS
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.QUAGMIRE_ONION_SEEDS"
msgid "I got no idea what they'd grow into."
msgstr "これが育つと何になるのか想像もつかないな。"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.QUAGMIRE_OVEN
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.QUAGMIRE_OVEN"
msgid "It's a regular ol' oven."
msgstr "これは普通のオーブンだ。"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.QUAGMIRE_OVEN_ITEM
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.QUAGMIRE_OVEN_ITEM"
msgid "Welp. Another day, another project."
msgstr "おぉ。新しい一日、新しいプロジェクト。"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.QUAGMIRE_PARKSPIKE
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.QUAGMIRE_PARKSPIKE"
msgid "Nice metalwork."
msgstr "素晴らしい金細工。"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.QUAGMIRE_PARK_ANGEL
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.QUAGMIRE_PARK_ANGEL"
msgid "Gives me the heebie jeebies."
msgstr "なんか、気味が悪いな～"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.QUAGMIRE_PARK_ANGEL2
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.QUAGMIRE_PARK_ANGEL2"
msgid "Kinda creepy."
msgstr "薄気味悪いね。"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.QUAGMIRE_PARK_FOUNTAIN
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.QUAGMIRE_PARK_FOUNTAIN"
