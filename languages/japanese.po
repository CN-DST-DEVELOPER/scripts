msgstr "うわあ！でっかい鳥！"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.MALBATROSS_BEAK
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.MALBATROSS_BEAK"
