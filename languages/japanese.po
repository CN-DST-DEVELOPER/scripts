msgid "only_used_by_wendy"
msgstr "only_used_by_wendy"

#. STRINGS.CHARACTERS.WALTER.ACTIONFAIL.ACTIVATE.CARNIVAL_HOST_HERE
msgctxt "STRINGS.CHARACTERS.WALTER.ACTIONFAIL.ACTIVATE.CARNIVAL_HOST_HERE"
msgid "I thought I saw him around here somewhere..."
msgstr "この辺で見たことがあるような気がしたんだけどな…"

#. STRINGS.CHARACTERS.WALTER.ACTIONFAIL.ACTIVATE.EMPTY_CATCOONDEN
msgctxt "STRINGS.CHARACTERS.WALTER.ACTIONFAIL.ACTIVATE.EMPTY_CATCOONDEN"
msgid "It's empty? Well now I feel kind of bad..."
msgstr "空っぽ？なんか申し訳なくなってきたなぁ…"

#. STRINGS.CHARACTERS.WALTER.ACTIONFAIL.ACTIVATE.HOSTBUSY
msgctxt "STRINGS.CHARACTERS.WALTER.ACTIONFAIL.ACTIVATE.HOSTBUSY"
