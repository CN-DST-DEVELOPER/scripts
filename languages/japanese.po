msgstr "この像は破損してしまったようです。"

#. STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.COTL_TABERNACLE_LEVEL2.GENERIC
msgctxt "STRINGS.CHARACTERS.WICKERBOTTOM.DESCRIBE.COTL_TABERNACLE_LEVEL2.GENERIC"
