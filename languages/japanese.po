msgstr "何が隠れているのかな？"

#. STRINGS.RECIPE_DESC.YOTP_FOOD3
msgctxt "STRINGS.RECIPE_DESC.YOTP_FOOD3"
msgid "Prosperity on a stick."
msgstr "繁栄の串刺し。"

#. STRINGS.RECIPE_DESC.YOTR_DECOR_1_ITEM
msgctxt "STRINGS.RECIPE_DESC.YOTR_DECOR_1_ITEM"
