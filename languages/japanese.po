msgstr "ワーッ！輝いている！"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.HALLOWEENCANDY_1
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.HALLOWEENCANDY_1"
