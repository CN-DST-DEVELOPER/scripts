msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.MILKYWHITES"
msgid "That's not appetizing.."
msgstr "食欲をそそられないな…"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.MINERHAT
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.MINERHAT"
msgid "I put that behind me."
msgstr "あれにはもうおさらばだ。"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.MINIBOATLANTERN
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.MINIBOATLANTERN"
msgid "Nice to have some more light out here on the water."
msgstr "水の中がもっと明るいなんてすてきだね。"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.MINIFAN
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.MINIFAN"
msgid "Swirly."
msgstr "グルグルだ。"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.MINIFLARE
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.MINIFLARE"
msgid "Safety in numbers, hey?"
msgstr "数字上の安全性ってか？"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.MINISIGN.GENERIC
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.MINISIGN.GENERIC"
msgid "Cutesy little drawing."
msgstr "小さいかわいいお絵描き。"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.MINISIGN.UNDRAWN
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.MINISIGN.UNDRAWN"
msgid "What good's a blank sign?"
msgstr "何も書いてない看板なんて意味ないだろ？"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.MINISIGN_ITEM
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.MINISIGN_ITEM"
msgid "I hate handmade stuff."
msgstr "あたい、いかにもお手製ってやつが嫌いなんだ。"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.MINOTAUR
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.MINOTAUR"
msgid "I've had about enough of terrible beasts!"
msgstr "あたい、不気味な獣はもうたくさんだよ。"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.MINOTAURCHEST
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.MINOTAURCHEST"
msgid "Maybe there's loot inside."
msgstr "中に略奪品があるかもね。"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.MINOTAURHORN
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.MINOTAURHORN"
msgid "That's a doozy!"
msgstr "こいつぁ、たまげたぜ！"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.MITEGLAND.COLD
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.MITEGLAND.COLD"
msgid "It ran outta heat."
msgstr "熱切れだ。"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.MITEGLAND.GENERIC
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.MITEGLAND.GENERIC"
msgid "You've heard of a warm heart, how 'bout a hot spleen?"
msgstr "温かな心ってのは聞いたことあるだろうが、温かな内臓は聞いたことがないだろ？"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.MITEGLAND_COOKED
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.MITEGLAND_COOKED"
msgid "Smells like it packs a punch."
msgstr "こりゃガツンとくる匂いだな。"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.MOLE.ABOVEGROUND
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.MOLE.ABOVEGROUND"
msgid "Taking a break from the mines?"
msgstr "鉱山から少し離れるようかな？"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.MOLE.HELD
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.MOLE.HELD"
msgid "I love it."
msgstr "こりゃ最高だ。"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.MOLE.UNDERGROUND
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.MOLE.UNDERGROUND"
msgid "Dutiful little miner."
msgstr "従順な小さい鉱夫。"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.MOLEBAT
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.MOLEBAT"
msgid "I think it nose a thing or two. Ha!"
msgstr "こりゃまた鼻やかな生き物じゃないか。なんちゃって！"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.MOLEBATHILL
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.MOLEBATHILL"
msgid "Might be some good materials stuck in that gunk."
msgstr "このクソ溜めの中にいい素材が入ってるかもしれないよ。"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.MOLEHAT
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.MOLEHAT"
msgid "A real strange contraption."
msgstr "すごくおかしな装置だ。"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.MOLEHILL
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.MOLEHILL"
msgid "The excavation crew's down there."
msgstr "発掘要員は下の方にいる。"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.MONKEY
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.MONKEY"
msgid "No monkeying around on the job."
msgstr "仕事中はおふざけはなしだよ。"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.MONKEYBARREL
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.MONKEYBARREL"
msgid "Ha! Smells like me after a full shift!"
msgstr "うわ！あたいが一日中働いた後の臭いと同じだ。"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.MONKEYHUT.BURNT
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.MONKEYHUT.BURNT"
msgid "I don't think it was up to code."
msgstr "建築法に違反してたんだと思うよ。"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.MONKEYHUT.GENERIC
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.MONKEYHUT.GENERIC"
msgid "Looks pretty rickety to me."
msgstr "あたいにはガタガタに見えるね。"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.MONKEYISLAND_PORTAL
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.MONKEYISLAND_PORTAL"
msgid "Something ain't right about it."
msgstr "何かがおかしいな。"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.MONKEYISLAND_PORTAL_DEBRIS
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.MONKEYISLAND_PORTAL_DEBRIS"
msgid "This looks like the bossman's... but what was he doing out here?"
msgstr "上司のもののようだけど...こんなところで何をしていたんだ？"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.MONKEYPILLAR
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.MONKEYPILLAR"
msgid "Looks shoddy, but it's stable somehow."
msgstr "手抜きに見えるけれど、なぜかしっかりとしているんだ。"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.MONKEYQUEEN
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.MONKEYQUEEN"
msgid "She must be one of the higher-ups."
msgstr "きっと彼女はお偉方だよ。"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.MONKEYTAIL
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.MONKEYTAIL"
msgid "Those are some tall tails, I tell ya!"
msgstr "まさに尾に尾が付いたような存在だな！"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.MONKEY_MEDIUMHAT
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.MONKEY_MEDIUMHAT"
msgid "Dress for the job you want."
msgstr "やりたい仕事に合った服装をしな。"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.MONKEY_SMALLHAT
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.MONKEY_SMALLHAT"
msgid "Keeps the sun off your head and the hair outta your face."
msgstr "直射日光から頭を守れるし、顔に髪がかかることもなくなるよ。"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.MONSTERLASAGNA
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.MONSTERLASAGNA"
msgid "Not sure meat's supposed to be that color."
msgstr "肉の色がそんなんで大丈夫なのかな。"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.MONSTERMEAT
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.MONSTERMEAT"
msgid "Hooboy! Is that even meat?"
msgstr "うぇー！ちょっと、これって本当に肉なのかい？"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.MONSTERMEAT_DRIED
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.MONSTERMEAT_DRIED"
msgid "Drying didn't help none."
msgstr "乾燥でマシになることなんてない。"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.MONSTERTARTARE
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.MONSTERTARTARE"
msgid "I'm all for getting my daily iron but this goes too far."
msgstr "今日の分の鉄分を摂るっていう点は大賛成だけど、これはやりすぎ。"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.MOONBASE.BROKEN
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.MOONBASE.BROKEN"
msgid "In need of a good fixin'!"
msgstr "徹底的に修理しないと！"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.MOONBASE.GENERIC
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.MOONBASE.GENERIC"
msgid "I don't think it's done yet."
msgstr "これ、もう完成してるとは思えない。"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.MOONBASE.MOONSTAFF
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.MOONBASE.MOONSTAFF"
msgid "Moonlight's good for the complexion, hey?"
msgstr "月光は体にいいよ！"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.MOONBASE.STAFFED
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.MOONBASE.STAFFED"
msgid "Job well done! Now what?"
msgstr "上出来、上出来！で、次は？"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.MOONBASE.WRONGSTAFF
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.MOONBASE.WRONGSTAFF"
msgid "Hm. This wasn't assembled right."
msgstr "あぁ。これは正しく組み立てられてなかったんだよ。"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.MOONBUTTERFLY.GENERIC
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.MOONBUTTERFLY.GENERIC"
msgid "Cute little fella, aintcha?"
msgstr "あんたは小さくてかわいいね。"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.MOONBUTTERFLY.HELD
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.MOONBUTTERFLY.HELD"
msgid "So... you like engineerin'?"
msgstr "で...あんた、工業は好きかい？"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.MOONBUTTERFLYWINGS
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.MOONBUTTERFLYWINGS"
msgid "They ain't flyin' no more."
msgstr "あいつらはもう飛ばないよ。"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.MOONBUTTERFLY_SAPLING
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.MOONBUTTERFLY_SAPLING"
msgid "It'll be a nice tree someday."
msgstr "これはいつか立派な木になるんだ。"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.MOONDIAL.CAVE
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.MOONDIAL.CAVE"
msgid "It was impractical to build this here."
msgstr "これをここに建てるなんて、頭おかしいよ。"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.MOONDIAL.GENERIC
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.MOONDIAL.GENERIC"
msgid "Must be broke. I can still see the moon."
msgstr "壊れてるに違いない。まだ月が見えるもん。"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.MOONDIAL.GLASSED
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.MOONDIAL.GLASSED"
msgid "Why do I get the feeling something's watchin' me..."
msgstr "なんか、誰かに見られてる気がするな…"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.MOONDIAL.NIGHT_FULL
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.MOONDIAL.NIGHT_FULL"
msgid "Full as can be."
msgstr "これ以上ないくらい満月。"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.MOONDIAL.NIGHT_NEW
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.MOONDIAL.NIGHT_NEW"
msgid "Brand spanking new moon."
msgstr "すごく元気な新しい月。"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.MOONDIAL.NIGHT_WANE
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.MOONDIAL.NIGHT_WANE"
msgid "It's waning."
msgstr "だんだん欠けてる。"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.MOONDIAL.NIGHT_WAX
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.MOONDIAL.NIGHT_WAX"
msgid "It's waxing."
msgstr "だんだん満ちてる。"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.MOONGLASS
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.MOONGLASS"
msgid "Can't wait to try this out."
msgstr "これを試す日が待ちきれないよ。"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.MOONGLASSAXE
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.MOONGLASSAXE"
msgid "Anything to make gettin' firewood easier."
msgstr "薪木を簡単に作れるなら何でも。"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.MOONGLASS_CHARGED
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.MOONGLASS_CHARGED"
msgid "I'd better hustle, the energy's not gonna last long."
msgstr "急がねえと。このエネルギーはそう長くは持たないよ。"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.MOONGLASS_ROCK
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.MOONGLASS_ROCK"
msgid "Wonder if it's got any special properties."
msgstr "これに特性はあるのかな？"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.MOONGLASS_WOBSTER_DEN
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.MOONGLASS_WOBSTER_DEN"
msgid "Wonder what lives in there?"
msgstr "あそこには何が住んでるんだろう。"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.MOONROCKCRATER
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.MOONROCKCRATER"
msgid "A rock with a hole in it."
msgstr "この岩、穴が開いてる。"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.MOONROCKIDOL
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.MOONROCKIDOL"
msgid "Do I gotta offer it up to something?"
msgstr "何か捧げるべき？"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.MOONROCKNUGGET
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.MOONROCKNUGGET"
msgid "Woah! What an odd texture."
msgstr "うわっ！こりゃすごく奇妙な生地だ。"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.MOONROCKSEED
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.MOONROCKSEED"
msgid "I could learn a thing or two from this."
msgstr "これから何かしら学べたかもね。"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.MOONROCK_PIECES
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.MOONROCK_PIECES"
msgid "That's... strange."
msgstr "あれは...おかしいぞ。"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.MOONSPIDERDEN
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.MOONSPIDERDEN"
msgid "I don't wanna see whatever's in there."
msgstr "あそこに何があるとしても、あたいは見たくないわ。"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.MOONSTORM_GLASS.GENERIC
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.MOONSTORM_GLASS.GENERIC"
msgid "That's some good, workable material there."
msgstr "ずいぶんと立派で加工しやすそうな素材があるじゃないか。"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.MOONSTORM_GLASS.INFUSED
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.MOONSTORM_GLASS.INFUSED"
msgid "It's been powered up."
msgstr "動き始めたね。"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.MOONSTORM_GOGGLESHAT
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.MOONSTORM_GOGGLESHAT"
msgid "You work with the materials you've got out here."
msgstr "ここいらで手に入る素材でやりくりするしかないんだよ。"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.MOONSTORM_SPARK
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.MOONSTORM_SPARK"
msgid "Not quite electricity, but it could still work..."
msgstr "電力みてえには見えないけど、なんとか使えるかもしれないね…"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.MOONSTORM_STATIC
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.MOONSTORM_STATIC"
msgid "Looks like an electrical fire waiting to happen."
msgstr "漏電して火事が発生しそうな見た目だね。"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.MOONSTORM_STATIC_CATCHER
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.MOONSTORM_STATIC_CATCHER"
msgid "Ain't nothin' in there."
msgstr "何も入ってない。"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.MOONSTORM_STATIC_ITEM
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.MOONSTORM_STATIC_ITEM"
msgid "The boss really does have a gadget for everything."
msgstr "旦那はマジでどんな機械でも持ってるんだね。"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.MOONSTORM_STATIC_ROAMER
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.MOONSTORM_STATIC_ROAMER"
msgid "Hope it don't short somethin' or someone out!"
msgstr "何かをショートさせたり、誰かを感電させないことを祈ってるぞ！"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.MOON_ALTAR.GENERIC
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.MOON_ALTAR.GENERIC"
msgid "Inventions? What sort of inventions?"
msgstr "発明？どんな種類の発明？"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.MOON_ALTAR.MOON_ALTAR_WIP
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.MOON_ALTAR.MOON_ALTAR_WIP"
msgid "Don't worry, we're nearly done."
msgstr "心配しないで。あと少しで終わりだから。"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.MOON_ALTAR_ASTRAL
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.MOON_ALTAR_ASTRAL"
msgid "All the pieces are finally in their proper place."
msgstr "ようやく全ての部品が元の場所に収まったよ。"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.MOON_ALTAR_COSMIC
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.MOON_ALTAR_COSMIC"
msgid "Can't shake the feeling that this is all building up to somethin'..."
msgstr "あたい、これ全部が何かにつながってる...って考えを拭い去れないんだ。"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.MOON_ALTAR_CROWN
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.MOON_ALTAR_CROWN"
msgid "Don't worry, I'll get you where you need to go."
msgstr "心配しないで。あたいがどこでも必要なとこに連れてってあげる。"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.MOON_ALTAR_GLASS
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.MOON_ALTAR_GLASS"
msgid "Huh? You talkin' to me?"
msgstr "え？あたいに話してるの？"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.MOON_ALTAR_ICON
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.MOON_ALTAR_ICON"
msgid "Now what were you doin' hiding underground?"
msgstr "あんた、地下に隠れて何やってたんだい？"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.MOON_ALTAR_IDOL
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.MOON_ALTAR_IDOL"
msgid "I'll fix ya up right proper!"
msgstr "あたいがちゃーんと直してやるからね！"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.MOON_ALTAR_LINK
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.MOON_ALTAR_LINK"
msgid "Looks like it's still under construction."
msgstr "まだ建設中みたいだな。"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.MOON_ALTAR_ROCK_GLASS
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.MOON_ALTAR_ROCK_GLASS"
msgid "Somethin' inside is itching to get out."
msgstr "中にいるなんかが、出たがってるみたいだ。"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.MOON_ALTAR_ROCK_IDOL
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.MOON_ALTAR_ROCK_IDOL"
msgid "Somethin' inside is itching to get out."
msgstr "中にいるなんかが、出たがってるみたいだ。"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.MOON_ALTAR_ROCK_SEED
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.MOON_ALTAR_ROCK_SEED"
msgid "Somethin' inside is itching to get out."
msgstr "中にいるなんかが、出たがってるみたいだ。"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.MOON_ALTAR_SEED
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.MOON_ALTAR_SEED"
msgid "You're a pretty lil fella."
msgstr "あんたすごく調子悪そうだよ。"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.MOON_ALTAR_WARD
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.MOON_ALTAR_WARD"
msgid "Let's getcha fixed up."
msgstr "修理してやるよ。"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.MOON_CAP
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.MOON_CAP"
msgid "Anyone wanna volunteer to try it?"
msgstr "だれか被ってみたい人はいるかい？"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.MOON_CAP_COOKED
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.MOON_CAP_COOKED"
msgid "Wouldn't have minded having some of these around when I was pulling overtime."
msgstr "残業してるとき、こいつがあったら結構便利だったろうね。"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.MOON_DEVICE.CONSTRUCTION1
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.MOON_DEVICE.CONSTRUCTION1"
msgid "Feels kinda like old times back at the factory."
msgstr "工場で働いてたときに戻ったみたいだよ。"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.MOON_DEVICE.CONSTRUCTION2
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.MOON_DEVICE.CONSTRUCTION2"
msgid "Well, it's not shaping up to be a portal. I was hopin' the boss had figured out a way back..."
msgstr "うーん、ポータルを作ってくれてる感じじゃないね。旦那が戻れる方法を見つけてくれないけね…"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.MOON_DEVICE.GENERIC
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.MOON_DEVICE.GENERIC"
msgid "Wonder what the boss is gonna use all this energy for?"
msgstr "旦那はこんだけのエネルギーを使って何するつもりなのかね？"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.MOON_FISSURE.GENERIC
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.MOON_FISSURE.GENERIC"
msgid "Hm, wonder if I could use this energy somehow."
msgstr "んー。このエネルギーをどうにか有効活用できないかな。"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.MOON_FISSURE.NOLIGHT
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.MOON_FISSURE.NOLIGHT"
msgid "Wonder how far down it goes."
msgstr "どんぐらい奥まで続いてるんだろう。"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.MOON_FISSURE_PLUGGED
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.MOON_FISSURE_PLUGGED"
msgid "That old lady's more resourceful than I gave her credit for."
msgstr "あのお年寄り、思ったより色々知ってるね。"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.MOON_TREE.BURNING
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.MOON_TREE.BURNING"
msgid "Yeesh, that thing's on fire!"
msgstr "うわー、あれが燃えてる！"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.MOON_TREE.BURNT
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.MOON_TREE.BURNT"
msgid "Looks like there was an accident here."
msgstr "ここで事故があったみたいだ。"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.MOON_TREE.CHOPPED
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.MOON_TREE.CHOPPED"
msgid "Don't worry, we'll put it to good use."
msgstr "心配しないで。あたいら、うまく使うから。"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.MOON_TREE.GENERIC
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.MOON_TREE.GENERIC"
msgid "Sure is pretty, ain't it?"
msgstr "これすっごいかわいいよね？"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.MOON_TREE_BLOSSOM
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.MOON_TREE_BLOSSOM"
msgid "The trees sure are pretty 'round here."
msgstr "この辺の木は見栄えがいい。"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.MOON_TREE_BLOSSOM_DRIED
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.MOON_TREE_BLOSSOM_DRIED"
msgid "These are nice and dry."
msgstr "乾燥具合は上々だよ。"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.MOOSE
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.MOOSE"
msgid "Oh, mama!"
msgstr "あ、ママだ！"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.MOOSEEGG
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.MOOSEEGG"
msgid "Animals don't build things well."
msgstr "動物は上手く物は作れないよ。"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.MOOSE_NESTING_GROUND
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.MOOSE_NESTING_GROUND"
msgid "That's where the mom keeps her babies."
msgstr "あそこに赤ちゃんが隠れてるんだ。"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.MOQUECA
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.MOQUECA"
msgid "What's this fancy stuff? I like it!"
msgstr "この素敵な物は何？すごくいいね。"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.MOSQUITO.GENERIC
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.MOSQUITO.GENERIC"
msgid "Once you've dealt with bedbugs, mosquitoes aren't so bad."
msgstr "一回ナンキン虫を経験すると、蚊はさして悪くないと思えるよ。"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.MOSQUITO.HELD
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.MOSQUITO.HELD"
msgid "Stop wriggling, it's gross."
msgstr "もじもじするのやめなよ。気持ち悪いね。"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.MOSQUITOBOMB
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.MOSQUITOBOMB"
msgid "Talk about a buzz-kill. Ha!"
msgstr "これが文字通りの殺虫剤ってな！"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.MOSQUITOFERTILIZER
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.MOSQUITOFERTILIZER"
msgid "Just throw a healthy dollop on the ground."
msgstr "地面に優しい量だけを使おう。"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.MOSQUITOMERMSALVE
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.MOSQUITOMERMSALVE"
msgid "I almost feel sorry for the bloodsucker. Almost."
msgstr "蚊に同情しちまいそうだ。してないけどな。"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.MOSQUITOMUSK
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.MOSQUITOMUSK"
msgid "Somehow it's still not the creepiest doll I've seen."
msgstr "どういうわけか、これまで見た中で一番不気味な人形じゃねえんだ。"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.MOSQUITOSACK
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.MOSQUITOSACK"
msgid "Ha. That's real gross."
msgstr "うわっ。あれは本当に気持ち悪い。"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.MOSSLING
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.MOSSLING"
msgid "Don'tcha just wanna noogie it?"
msgstr "ぐりぐりしたくならない？"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.MOUND.DUG
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.MOUND.DUG"
msgid "Just a hole now."
msgstr "今じゃただの穴だ。"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.MOUND.GENERIC
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.MOUND.GENERIC"
msgid "Anything good in there, ya think?"
msgstr "あそこに何か良い物あると思う？"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.MULLEDDRINK
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.MULLEDDRINK"
msgid "I ain't one to pull my punches... but I'll mull them! Ha!"
msgstr "あたいは手加減はしないけど...温めて飲むよ！"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.MULTIPLAYER_PORTAL
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.MULTIPLAYER_PORTAL"
msgid "That was a one-way ticket."
msgstr "あれ、片道切符だったね。"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.MULTIPLAYER_PORTAL_MOONROCK
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.MULTIPLAYER_PORTAL_MOONROCK"
msgid "Wow. Can't even see the weld joints."
msgstr "うわー。溶接継手が見えもしない。"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.MULTITOOL_AXE_PICKAXE
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.MULTITOOL_AXE_PICKAXE"
msgid "That's really not my forte."
msgstr "あれはあたい本当に苦手なんだ。"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.MUSHGNOME
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.MUSHGNOME"
msgid "Strange, no matter how you spin it."
msgstr "なんど回してもおかしなヤツだよ。"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.MUSHROOMBOMB
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.MUSHROOMBOMB"
msgid "Fire in the hole!"
msgstr "爆発するわ！"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.MUSHROOMHAT
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.MUSHROOMHAT"
msgid "Really?"
msgstr "本当？"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.MUSHROOMSPROUT.BURNT
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.MUSHROOMSPROUT.BURNT"
msgid "That seemed like a waste."
msgstr "あれは無駄遣いに思えたよ。"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.MUSHROOMSPROUT.GENERIC
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.MUSHROOMSPROUT.GENERIC"
msgid "Now that's a big mushroom!"
msgstr "今じゃ大きなキノコだ！"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.MUSHROOM_FARM.BURNT
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.MUSHROOM_FARM.BURNT"
msgid "All burned up."
msgstr "真っ黒焦げだな"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.MUSHROOM_FARM.EMPTY
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.MUSHROOM_FARM.EMPTY"
msgid "Nothing yet."
msgstr "まだ何もないね。"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.MUSHROOM_FARM.LOTS
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.MUSHROOM_FARM.LOTS"
msgid "Looks like a pretty good yield."
msgstr "かなり良い収量のようだね。"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.MUSHROOM_FARM.ROTTEN
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.MUSHROOM_FARM.ROTTEN"
msgid "Not much use with a dead log."
msgstr "死んだ木にはもうあんまり使い道はないよ。"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.MUSHROOM_FARM.SNOWCOVERED
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.MUSHROOM_FARM.SNOWCOVERED"
msgid "It's real cold out."
msgstr "ここの寒さは筋金入りだ。"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.MUSHROOM_FARM.SOME
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.MUSHROOM_FARM.SOME"
msgid "We've got our first mushrooms!"
msgstr "あたいらの最初のキノコができたよ！"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.MUSHROOM_FARM.STUFFED
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.MUSHROOM_FARM.STUFFED"
msgid "Lookit all that fungus."
msgstr "見てよ、この真菌。"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.MUSHROOM_LIGHT.BURNT
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.MUSHROOM_LIGHT.BURNT"
msgid "Roasted."
msgstr "ローストだね。"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.MUSHROOM_LIGHT.OFF
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.MUSHROOM_LIGHT.OFF"
msgid "Where's the plug?"
msgstr "プラグはどこ？"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.MUSHROOM_LIGHT.ON
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.MUSHROOM_LIGHT.ON"
msgid "How's it work without circuitry?"
msgstr "回路なしでどうやって機能するのかな？"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.MUSHROOM_LIGHT2.BURNT
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.MUSHROOM_LIGHT2.BURNT"
msgid "Roasted."
msgstr "ローストだね。"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.MUSHROOM_LIGHT2.OFF
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.MUSHROOM_LIGHT2.OFF"
msgid "Is there an \"on\" switch?"
msgstr "「オン」スイッチはある？"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.MUSHROOM_LIGHT2.ON
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.MUSHROOM_LIGHT2.ON"
msgid "It lights up, even without filament."
msgstr "フィラメントなしで電気が付く。"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.MUSHTREE_MEDIUM.ACIDCOVERED
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.MUSHTREE_MEDIUM.ACIDCOVERED"
msgid "What is that nasty stench?"
msgstr "このひどい臭いはなんだ？"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.MUSHTREE_MEDIUM.BLOOM
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.MUSHTREE_MEDIUM.BLOOM"
msgid "Stink."
msgstr "臭うなあ。"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.MUSHTREE_MEDIUM.GENERIC
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.MUSHTREE_MEDIUM.GENERIC"
msgid "That's a big mushroom!"
msgstr "あれはでっかいキノコだね！"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.MUSHTREE_MOON
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.MUSHTREE_MOON"
msgid "Now that's a weird looking mushroom."
msgstr "おかしなキノコがあるじゃないか。"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.MUSHTREE_SMALL.ACIDCOVERED
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.MUSHTREE_SMALL.ACIDCOVERED"
msgid "What is that nasty stench?"
msgstr "このひどい臭いはなんだ？"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.MUSHTREE_SMALL.BLOOM
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.MUSHTREE_SMALL.BLOOM"
msgid "Not a fan of the smell."
msgstr "あの匂いは苦手だな。"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.MUSHTREE_SMALL.GENERIC
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.MUSHTREE_SMALL.GENERIC"
msgid "I guess they grow better down here?"
msgstr "こっちだともっとよく育つかも。"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.MUSHTREE_TALL.ACIDCOVERED
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.MUSHTREE_TALL.ACIDCOVERED"
msgid "What is that nasty stench?"
msgstr "このひどい臭いはなんだ？"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.MUSHTREE_TALL.BLOOM
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.MUSHTREE_TALL.BLOOM"
msgid "Whew. That's an odor."
msgstr "はぁ。嫌な臭い。"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.MUSHTREE_TALL.GENERIC
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.MUSHTREE_TALL.GENERIC"
msgid "It's huge!"
msgstr "特大サイズだ！"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.MUSHTREE_TALL_WEBBED.ACIDCOVERED
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.MUSHTREE_TALL_WEBBED.ACIDCOVERED"
msgid "What is that nasty stench?"
msgstr "このひどい臭いはなんだ？"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.MUSHTREE_TALL_WEBBED.GENERIC
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.MUSHTREE_TALL_WEBBED.GENERIC"
msgid "There's spiders in the crawlspace."
msgstr "クロールスペースにクモがいる。"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.MUTATEDBEARGER
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.MUTATEDBEARGER"
msgid "Grumpy hasn't had his mornin' cup of joe yet."
msgstr "あの気難しいヤツは、まだ朝のコーヒーを飲んでないみたいだ。"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.MUTATEDBIRD
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.MUTATEDBIRD"
msgid "That bird is a bad omen if I ever seen one."
msgstr "これぞまさに凶兆だ！"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.MUTATEDBUZZARD_GESTALT.EATING_CORPSE
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.MUTATEDBUZZARD_GESTALT.EATING_CORPSE"
msgid "I'm gonna lose my lunch soon..."
msgstr "うっぷ…吐きそうだ…"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.MUTATEDBUZZARD_GESTALT.GENERIC
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.MUTATEDBUZZARD_GESTALT.GENERIC"
msgid "As if a regular buzzard weren't bad luck enough..."
msgstr "普通のハゲワシの運は悪くなかったかのように思えてきた…"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.MUTATEDDEERCLOPS
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.MUTATEDDEERCLOPS"
msgid "Shoulda wore safety goggles. Or is it goggle?"
msgstr "安全ボーグルを身につけるべきだったかもね。ゴーグルだっけ？"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.MUTATEDHOUND.DEAD
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.MUTATEDHOUND.DEAD"
msgid "Sorry, Fido."
msgstr "ごめんね、わんこ。"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.MUTATEDHOUND.GENERIC
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.MUTATEDHOUND.GENERIC"
msgid "That pup looks awful!"
msgstr "あの子犬はひどいね！"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.MUTATEDHOUND.SLEEPING
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.MUTATEDHOUND.SLEEPING"
msgid "Well, it looks more peaceful at least."
msgstr "まあ、多少、穏やかな外見にはなったね。"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.MUTATEDWARG
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.MUTATEDWARG"
msgid "Whose yard did you get out of?"
msgstr "誰の庭から逃げ出してきたんだい？"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.MUTATED_PENGUIN.DEAD
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.MUTATED_PENGUIN.DEAD"
msgid "Sorry, fella."
msgstr "ごめんね。"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.MUTATED_PENGUIN.GENERIC
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.MUTATED_PENGUIN.GENERIC"
msgid "Yeeshkabob! What happened to your... everything?"
msgstr "うわーっ！あんた、その...全体的にどうしたの？"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.MUTATED_PENGUIN.SLEEPING
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.MUTATED_PENGUIN.SLEEPING"
msgid "Better than it being awake."
msgstr "起きてるよりはましだね。"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.MUTATOR_DROPPER
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.MUTATOR_DROPPER"
msgid "Hope those spiders have strong stomachs."
msgstr "このクモたち、腹が丈夫だといいんだけどね。"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.MUTATOR_HEALER
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.MUTATOR_HEALER"
msgid "Hope those spiders have strong stomachs."
msgstr "このクモたち、腹が丈夫だといいんだけどね。"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.MUTATOR_HIDER
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.MUTATOR_HIDER"
msgid "I don't think I'll be takin' a bite out of that."
msgstr "あたいは遠慮しておくよ。"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.MUTATOR_MOON
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.MUTATOR_MOON"
msgid "I don't think I'll be takin' a bite out of that."
msgstr "あたいは遠慮しておくよ。"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.MUTATOR_SPITTER
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.MUTATOR_SPITTER"
msgid "Hope those spiders have strong stomachs."
msgstr "このクモたち、腹が丈夫だといいんだけどね。"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.MUTATOR_WARRIOR
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.MUTATOR_WARRIOR"
msgid "I don't think I'll be takin' a bite out of that."
msgstr "あたいは遠慮しておくよ。"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.MUTATOR_WATER
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.MUTATOR_WATER"
msgid "I don't think I'll be takin' a bite out of that."
msgstr "あたいは遠慮しておくよ。"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.NATURE_BLUEPRINT
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.NATURE_BLUEPRINT"
msgid "Good thing I'm not allergic to pollen."
msgstr "花粉症じゃなくて良かったよ。"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.NIGHTCAPHAT
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.NIGHTCAPHAT"
msgid "A solid night's sleep'll help ya do a solid day's work."
msgstr "夜にしっかり寝れば、昼にしっかりと働けるんだ。"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.NIGHTLIGHT
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.NIGHTLIGHT"
msgid "Creepy to the core."
msgstr "何から何まで不気味。"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.NIGHTMAREFUEL
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.NIGHTMAREFUEL"
msgid "I don't trust that stuff."
msgstr "あたい、あれは信用できない。"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.NIGHTMAREGROWTH
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.NIGHTMAREGROWTH"
msgid "Charlie..."
msgstr "チャーリー…"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.NIGHTMARELIGHT
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.NIGHTMARELIGHT"
msgid "I regret poking my nose so far down here."
msgstr "こんな奥まで鼻を突っ込んだこと、あたい後悔してる。"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.NIGHTMAREPIE
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.NIGHTMAREPIE"
msgid "Lookit that, Warly's at it again."
msgstr "うわっ、見て。ワーリーがまた何かやってる。"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.NIGHTMARE_TIMEPIECE.CALM
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.NIGHTMARE_TIMEPIECE.CALM"
msgid "Nothing out of place here."
msgstr "ここにおかしなものは何もないようだけど。"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.NIGHTMARE_TIMEPIECE.DAWN
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.NIGHTMARE_TIMEPIECE.DAWN"
msgid "I'm feeling much better."
msgstr "あたい、だいぶ気分も晴れたよ。"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.NIGHTMARE_TIMEPIECE.NOMAGIC
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.NIGHTMARE_TIMEPIECE.NOMAGIC"
msgid "Things seem pretty normal."
msgstr "まあ、いろいろと普通だよね。"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.NIGHTMARE_TIMEPIECE.STEADY
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.NIGHTMARE_TIMEPIECE.STEADY"
msgid "It can't possibly get worse."
msgstr "これ以上悪くなることはないよ。"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.NIGHTMARE_TIMEPIECE.WANING
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.NIGHTMARE_TIMEPIECE.WANING"
msgid "My head's starting to clear a bit."
msgstr "あたいの頭もすっきりしてきたし。"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.NIGHTMARE_TIMEPIECE.WARN
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.NIGHTMARE_TIMEPIECE.WARN"
msgid "I feel uneasy for some reason."
msgstr "あたい、どうにも落ち着かない気分なんだ。"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.NIGHTMARE_TIMEPIECE.WAXING
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.NIGHTMARE_TIMEPIECE.WAXING"
msgid "The air's all prickly."
msgstr "空気がとげとげしい。"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.NIGHTSTICK
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.NIGHTSTICK"
msgid "Electricity at my fingertips."
msgstr "指先に電気が走るし。"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.NIGHTSWORD
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.NIGHTSWORD"
msgid "Not too keen on touching that."
msgstr "あれにはあんまり触りたくないな。"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.NITRE
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.NITRE"
msgid "I got some plans in mind for that."
msgstr "あたい、あれについてはちょっと考えがあるんだ。"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.NITRE_FORMATION
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.NITRE_FORMATION"
msgid "Oh, I've got big plans for that!"
msgstr "これに関する大きな計画があるんだ！"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.NONSLIPGRIT
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.NONSLIPGRIT"
msgid "Better than slipin' and slidin'."
msgstr "ツルっつ滑らせるよりはずっといい。"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.NONSLIPGRITBOOSTED
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.NONSLIPGRITBOOSTED"
msgid "Reminds me of kitty litter."
msgstr "これ猫砂みたいだね。"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.NUTRIENTSGOGGLESHAT
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.NUTRIENTSGOGGLESHAT"
msgid "It's kinda fancy-shmancy for farming, but at least it's useful."
msgstr "野良仕事に使うには高級すぎる気もするけど、使えるから良しとするかね。"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.OAR
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.OAR"
msgid "Remember, back straight, move those arms!"
msgstr "覚えてる？背筋を伸ばし、腕を前に！"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.OAR_DRIFTWOOD
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.OAR_DRIFTWOOD"
msgid "Catch my drift? Ha!"
msgstr "あたいのドリフトゲットした？ハハ！"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.OAR_MONKEY
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.OAR_MONKEY"
msgid "Pretty sure that's not how yer s'posed to use a paddle."
msgstr "あんた、そのパドルの使い方は絶対に間違ってるぞ。"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.OASISLAKE.EMPTY
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.OASISLAKE.EMPTY"
msgid "There used to be water there."
msgstr "前はここに水があったんだ。"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.OASISLAKE.GENERIC
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.OASISLAKE.GENERIC"
msgid "Never seen such a clear lake before."
msgstr "こんなに澄んだ湖見たことないよ。"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.OCEANFISHABLEFLOTSAM
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.OCEANFISHABLEFLOTSAM"
msgid "Ugh, what sorta mess did I reel in?"
msgstr "あぁ。どんな問題に足を突っ込んじゃったんだろ？"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.OCEANFISHINGBOBBER_BALL
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.OCEANFISHINGBOBBER_BALL"
msgid "Bobber's yer uncle! Ha!"
msgstr "全部できた！ウキ！なんて、ハハ！"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.OCEANFISHINGBOBBER_CANARY
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.OCEANFISHINGBOBBER_CANARY"
msgid "This'll do the trick."
msgstr "これでうまくいくはず。"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.OCEANFISHINGBOBBER_CROW
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.OCEANFISHINGBOBBER_CROW"
msgid "It's nothin' to crow about, but it ain't half bad!"
msgstr "自慢するようなもんじゃないけど、悪くないよ！"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.OCEANFISHINGBOBBER_GOOSE
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.OCEANFISHINGBOBBER_GOOSE"
msgid "This thing's so fancy! Am I fishin' for food or compliments?"
msgstr "これってすごいオシャレ！あたいが釣ってるのは食べ物か、賞賛か。"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.OCEANFISHINGBOBBER_MALBATROSS
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.OCEANFISHINGBOBBER_MALBATROSS"
msgid "This thing's so fancy! Am I fishin' for food or compliments?"
msgstr "これってすごいオシャレ！あたいが釣ってるのは食べ物か、賞賛か。"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.OCEANFISHINGBOBBER_NONE
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.OCEANFISHINGBOBBER_NONE"
msgid "I think that line needs something."
msgstr "あのラインはどうにかしなくちゃって思うんだ。"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.OCEANFISHINGBOBBER_OVAL
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.OCEANFISHINGBOBBER_OVAL"
msgid "Bobber's yer uncle! Ha!"
msgstr "全部できた！ウキ！なんて、ハハ！"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.OCEANFISHINGBOBBER_ROBIN
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.OCEANFISHINGBOBBER_ROBIN"
msgid "This'll do the trick."
msgstr "これでうまくいくはずさ。"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.OCEANFISHINGBOBBER_ROBIN_WINTER
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.OCEANFISHINGBOBBER_ROBIN_WINTER"
msgid "This'll do the trick."
msgstr "これでうまくいくはずさ。"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.OCEANFISHINGLURE_HERMIT_DROWSY
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.OCEANFISHINGLURE_HERMIT_DROWSY"
msgid "I'll be extra careful with that one."
msgstr "あれにはいつもより注意しないとね。"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.OCEANFISHINGLURE_HERMIT_HEAVY
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.OCEANFISHINGLURE_HERMIT_HEAVY"
msgid "If I'm gonna catch fish, I may as well catch the biggest one!"
msgstr "魚を釣るんだったら、一番でっかいのを釣らなくちゃ！"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.OCEANFISHINGLURE_HERMIT_RAIN
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.OCEANFISHINGLURE_HERMIT_RAIN"
msgid "Sure wish it rained fish, not just cats and dogs."
msgstr "雨みたいに魚が降ってくればいいのにね。"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.OCEANFISHINGLURE_HERMIT_SNOW
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.OCEANFISHINGLURE_HERMIT_SNOW"
msgid "At least fishing is more productive than taking a snow day."
msgstr "少なくとも釣りは、雪で仕事休んでぶらぶらしてるよりは生産性がある。"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.OCEANFISHINGLURE_SPINNER_BLUE
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.OCEANFISHINGLURE_SPINNER_BLUE"
msgid "Not that lifelike, but it fools the fish."
msgstr "本物とはかけ離れてるけど、魚はだませるよ。"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.OCEANFISHINGLURE_SPINNER_GREEN
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.OCEANFISHINGLURE_SPINNER_GREEN"
msgid "Not that lifelike, but it fools the fish."
msgstr "本物とはかけ離れてるけど、魚はだませるよ。"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.OCEANFISHINGLURE_SPINNER_RED
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.OCEANFISHINGLURE_SPINNER_RED"
msgid "Not that lifelike, but it fools the fish."
msgstr "本物とはかけ離れてるけど、魚はだませるよ。"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.OCEANFISHINGLURE_SPOON_BLUE
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.OCEANFISHINGLURE_SPOON_BLUE"
msgid "Not that lifelike, but it fools the fish."
msgstr "本物とはかけ離れてるけど、魚はだませるよ。"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.OCEANFISHINGLURE_SPOON_GREEN
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.OCEANFISHINGLURE_SPOON_GREEN"
msgid "Not that lifelike, but it fools the fish."
msgstr "本物とはかけ離れてるけど、魚はだませるよ。"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.OCEANFISHINGLURE_SPOON_RED
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.OCEANFISHINGLURE_SPOON_RED"
msgid "Not that lifelike, but it fools the fish."
msgstr "本物とはかけ離れてるけど、魚はだませるよ。"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.OCEANFISHINGROD
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.OCEANFISHINGROD"
msgid "The right tool for the job!"
msgstr "仕事に適した道具！"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.OCEANFISH_MEDIUM_1
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.OCEANFISH_MEDIUM_1"
msgid "Here's hoping it tastes better than it looks."
msgstr "見かけよりおいしいといいな。"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.OCEANFISH_MEDIUM_2
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.OCEANFISH_MEDIUM_2"
msgid "Now that's a nice fat fish!"
msgstr "これは太った良い魚だ！"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.OCEANFISH_MEDIUM_3
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.OCEANFISH_MEDIUM_3"
msgid "Yeesh, I'd better watch the spines on that thing!"
msgstr "あ～ぁ。あれの反り具合をよく見たほうが良いね。"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.OCEANFISH_MEDIUM_4
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.OCEANFISH_MEDIUM_4"
msgid "Never been much for superstition."
msgstr "迷信なんて信じたことなかったよ。"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.OCEANFISH_MEDIUM_5
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.OCEANFISH_MEDIUM_5"
msgid "Never had to shuck a fish before."
msgstr "魚の皮むく機会なんてなかったんだ。"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.OCEANFISH_MEDIUM_6
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.OCEANFISH_MEDIUM_6"
msgid "Looks like one of those fish rich people put in ponds."
msgstr "金持ちが池に泳がせておく魚みたいだね。"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.OCEANFISH_MEDIUM_7
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.OCEANFISH_MEDIUM_7"
msgid "Looks like one of those fish rich people put in ponds."
msgstr "金持ちが池に泳がせておく魚みたいだね。"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.OCEANFISH_MEDIUM_8
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.OCEANFISH_MEDIUM_8"
msgid "It's an ice fish if I do say so myself. Ha!"
msgstr "これはアイスフィッシュ。あたいがそう呼べば、そう名前が付く。"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.OCEANFISH_MEDIUM_9
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.OCEANFISH_MEDIUM_9"
msgid "You'll make a nice dinner!"
msgstr "今晩はご馳走だね！"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.OCEANFISH_SMALL_1
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.OCEANFISH_SMALL_1"
msgid "A little on the puny side, ain't it?"
msgstr "どっちかっていうと小さくないかい？"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.OCEANFISH_SMALL_2
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.OCEANFISH_SMALL_2"
msgid "Not a lot of meat on that one."
msgstr "これにはあんまり肉がついてないね。"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.OCEANFISH_SMALL_3
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.OCEANFISH_SMALL_3"
msgid "It's just a teeny thing!"
msgstr "これはちっちゃすぎ！"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.OCEANFISH_SMALL_4
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.OCEANFISH_SMALL_4"
msgid "My fish dinner might be a bit lean..."
msgstr "あたいの魚ディナーはかる～くなるかも..."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.OCEANFISH_SMALL_5
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.OCEANFISH_SMALL_5"
msgid "Not sure that fish is healthy."
msgstr "あの魚がヘルシーかどうかはわかんないな。"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.OCEANFISH_SMALL_6
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.OCEANFISH_SMALL_6"
msgid "Huh. Never heard a fish rustle before."
msgstr "へー。魚がサラサラ音出すのなんて聞いたことなかったな。"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.OCEANFISH_SMALL_7
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.OCEANFISH_SMALL_7"
msgid "Aww, it's kinda cute!"
msgstr "うわ、かわいいな！"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.OCEANFISH_SMALL_8
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.OCEANFISH_SMALL_8"
msgid "That thing's a fire hazard!"
msgstr "あれは火災の危険ありだ！"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.OCEANFISH_SMALL_9
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.OCEANFISH_SMALL_9"
msgid "That thing sure can spit!"
msgstr "こいつ、唾を吐いたな！"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.OCEANTREE
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.OCEANTREE"
msgid "Must be a really stubborn tree to be able to grow out here."
msgstr "こんなところに生えてくるだなんて、よっぽど頑固な木なんだろうね。"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.OCEANTREENUT
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.OCEANTREENUT"
msgid "Turns out it's not a tough nut to crack."
msgstr "意外とかんたんに割れるんだな。"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.OCEANTREE_PILLAR
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.OCEANTREE_PILLAR"
msgid "It's no industrial ice flinger, but it'll help me beat the heat."
msgstr "工業製の雪玉発射機ってわけじゃないけど、暑さ対策にはなるね。"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.OCEANVINE
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.OCEANVINE"
msgid "That's all vine and dandy. Ha!"
msgstr "蔓は千年、亀は万年ってね。なんちゃって！"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.OCEANVINE_COCOON
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.OCEANVINE_COCOON"
msgid "I'm... trying not to think about how many of those are probably dangling above us."
msgstr "コレが大量にあたいたちの頭上でブラついてる…それを考えないよう全力で頑張ってるところさ。"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.OCEANVINE_COCOON_BURNT
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.OCEANVINE_COCOON_BURNT"
msgid "One less to worry about."
msgstr "これで頭痛の種が一つ消えたよ。"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.OCEANWHIRLBIGPORTALEXIT
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.OCEANWHIRLBIGPORTALEXIT"
msgid "Some good pickins here."
msgstr "こりゃイイモンだ。"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.OCEANWHIRLPORTAL
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.OCEANWHIRLPORTAL"
msgid "Alright, time to sink or swim!"
msgstr "いちかばちか、沈むか泳ぐかだ！"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.OCEAN_TRAWLER.CAUGHT
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.OCEAN_TRAWLER.CAUGHT"
msgid "Looks like we've got fish for dinner!"
msgstr "夕食の魚が手に入ったみたいだな！"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.OCEAN_TRAWLER.ESCAPED
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.OCEAN_TRAWLER.ESCAPED"
msgid "Shoot, guess I should've come back sooner."
msgstr "ちくしょう！もっと早く戻ってくるべきだった。"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.OCEAN_TRAWLER.FIXED
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.OCEAN_TRAWLER.FIXED"
msgid "Fixed up, good as new!"
msgstr "直ったぞ！新品同然だ！"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.OCEAN_TRAWLER.GENERIC
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.OCEAN_TRAWLER.GENERIC"
msgid "It does all the fishin' so I'm free to work on other things."
msgstr "釣りは勝手にやってくれるから、他の仕事を自由にできるな。"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.OCEAN_TRAWLER.LOWERED
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.OCEAN_TRAWLER.LOWERED"
msgid "Ain't technology great?"
msgstr "技術ってのは素晴らしいもんじゃないのかい？"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.OCEAN_TRAWLER_KIT
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.OCEAN_TRAWLER_KIT"
msgid "This'll be ready in a lick."
msgstr "準備なんてあっという間に終わるよ。"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.OFFERING_POT.GENERIC
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.OFFERING_POT.GENERIC"
msgid "Shucks, I can't just leave it empty!"
msgstr "クソ！空のままにしておけねえ！"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.OFFERING_POT.LOTS_OF_KELP
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.OFFERING_POT.LOTS_OF_KELP"
msgid "That should keep'em well fed."
msgstr "これであいつらも満腹だろう。"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.OFFERING_POT.SOME_KELP
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.OFFERING_POT.SOME_KELP"
msgid "I should add a little more, wouldn't want them to run out."
msgstr "もう少し追加しておくか。なくならねえようにな。"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.OFFERING_POT_UPGRADED.GENERIC
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.OFFERING_POT_UPGRADED.GENERIC"
msgid "Shucks, I can't just leave it empty!"
msgstr "クソ！空のままにしておけねえ！"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.OFFERING_POT_UPGRADED.LOTS_OF_KELP
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.OFFERING_POT_UPGRADED.LOTS_OF_KELP"
msgid "That should keep'em well fed."
msgstr "これであいつらも満腹だろう。"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.OFFERING_POT_UPGRADED.SOME_KELP
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.OFFERING_POT_UPGRADED.SOME_KELP"
msgid "I should add a little more, wouldn't want them to run out."
msgstr "もう少し追加しておくか。なくならねえようにな。"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.ONEMANBAND
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.ONEMANBAND"
msgid "I ain't musically inclined."
msgstr "あたい、音楽の才能には欠けるんだ。"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.ONION
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.ONION"
msgid "I hate chopping vegetables."
msgstr "野菜刻むのって大嫌いさ。"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.ONION_COOKED
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.ONION_COOKED"
msgid "Done and done."
msgstr "完成ったら完成。"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.ONION_OVERSIZED
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.ONION_OVERSIZED"
msgid "Who's gonna draw the short straw and have to cut that thing?"
msgstr "貧乏くじを引いてコイツを切ることになるのは誰かね？"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.ONION_SEEDS
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.ONION_SEEDS"
msgid "I got no idea what they'd grow into."
msgstr "これが育つと何になるのか想像もつかないな。"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.OPALPRECIOUSGEM
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.OPALPRECIOUSGEM"
msgid "Pretty! Pretty useless."
msgstr "びっくりだ！びっくりするほど使い物にならないね。"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.OPALSTAFF
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.OPALSTAFF"
msgid "Did it just get chillier?"
msgstr "今、一段と寒くなったかい？"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.ORANGEAMULET
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.ORANGEAMULET"
msgid "For those with a lackluster work ethic."
msgstr "どんよりした労働倫理の奴ら。"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.ORANGEGEM
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.ORANGEGEM"
msgid "I don't like it."
msgstr "あたいはこれ、嫌いだ。"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.ORANGEMOONEYE
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.ORANGEMOONEYE"
msgid "You lookin' at me?"
msgstr "あんた、あたいのこと見てんの？"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.ORANGESTAFF
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.ORANGESTAFF"
msgid "For people who fear good, honest work."
msgstr "良質で正直な仕事を恐れる奴ら。"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.OTTER
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.OTTER"
msgid "Nasty lil hoarder ain't it?"
msgstr "なんて手癖の悪い子なんだ！"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.OTTERDEN.GENERIC
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.OTTERDEN.GENERIC"
msgid "Looks tapped out."
msgstr "この家は文無しだな。"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.OTTERDEN.HAS_LOOT
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.OTTERDEN.HAS_LOOT"
msgid "It might have left us some goodies."
msgstr "おお！あたいたちのために、いいもんを置いてってくれたぞ。"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.OTTERDEN_DEAD
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.OTTERDEN_DEAD"
msgid "It was definitely holding it all together."
msgstr "あれがここをバラバラにならないよう留めてたのは間違いないな。"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.PALMCONETREE
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.PALMCONETREE"
msgid "That's gotta be one of those tropical trees."
msgstr "ここらの熱帯樹みたく育つのかね。"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.PALMCONE_SAPLING
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.PALMCONE_SAPLING"
msgid "Not much of a tree yet, but it'll get there."
msgstr "まだ木と言うには早いね。だけど、すぐに育つはずだよ。"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.PALMCONE_SCALE
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.PALMCONE_SCALE"
msgid "Looks like a durable building material."
msgstr "建材にしたら耐久性がありそうだ。"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.PALMCONE_SEED
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.PALMCONE_SEED"
msgid "This could become a tree with a bit of work."
msgstr "少し手間をかければ木に育つはずだよ。"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.PANDORASCHEST
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.PANDORASCHEST"
msgid "Best not open that."
msgstr "あれは開けないに越したことない。"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.PANETTONE
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.PANETTONE"
msgid "Huh. Some kinda fancy-shmancy holiday bread?"
msgstr "豪勢な祝祭の時に食べるパンの一種だろ？"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.PANFLUTE
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.PANFLUTE"
msgid "Let's see if I can't play a little ditty."
msgstr "一曲吹けるか試してみよう。"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.PAPYRUS
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.PAPYRUS"
msgid "I don't have much use for that, personally."
msgstr "あたい、あれの使い道はあんまりないんだ、個人的に。"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.PAVLOVA
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.PAVLOVA"
msgid "Is cake supposed to crunch? Not that I'm complainin!"
msgstr "ケーキってバリバリするもの？いや、あたい、文句言ってるわけじゃないんだ！"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.PEGHOOK
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.PEGHOOK"
msgid "That acid stuff burns!"
msgstr "あの酸性の物は燃える！"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.PENGUIN
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.PENGUIN"
msgid "I don't mix well with the upper class."
msgstr "あたい、上流階級の人とは馴染めないんだ。"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.PENGUINCORPSE.BURNING
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.PENGUINCORPSE.BURNING"
msgid "That'll do the trick."
msgstr "これでうまくいくはず。"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.PENGUINCORPSE.GENERIC
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.PENGUINCORPSE.GENERIC"
msgid "It ain't the end."
msgstr "終わったわけじゃないみたいだな。"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.PENGUINCORPSE.REVIVING
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.PENGUINCORPSE.REVIVING"
msgid "Great. We missed our chance."
msgstr "なるほど。あたいたちはチャンスを逃したわけだ。"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.PEPPER
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.PEPPER"
msgid "Ye-hooo! They gotta a kick to 'em."
msgstr "やったー！あいつら泣いてるよ。"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.PEPPERPOPPER
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.PEPPERPOPPER"
msgid "My mouth's havin' a party!"
msgstr "口の中がパーティだ！"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.PEPPER_COOKED
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.PEPPER_COOKED"
msgid "Just the smell is making my eyes water."
msgstr "臭いだけで目が潤んでくるよ。"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.PEPPER_OVERSIZED
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.PEPPER_OVERSIZED"
msgid "I'd bet that pepper packs a punch!"
msgstr "このペッパー、絶対に激辛だね！"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.PEPPER_SEEDS
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.PEPPER_SEEDS"
msgid "Wonder what these'll make."
msgstr "これ、何になるんだろう。"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.PERD
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.PERD"
msgid "The light's on but no one's home."
msgstr "電気はついてるけど誰もいないね。"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.PERDFAN
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.PERDFAN"
msgid "It's a big fan made of tailfeathers."
msgstr "尾羽から作ったうちわだね。"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.PERDSHRINE.BURNT
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.PERDSHRINE.BURNT"
msgid "Smells like burnt gobbler."
msgstr "パックンチョウを焦がしたようなにおいがするね。"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.PERDSHRINE.EMPTY
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.PERDSHRINE.EMPTY"
msgid "We oughta put a bush in there."
msgstr "あそこに藪を作らないと。"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.PERDSHRINE.GENERIC
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.PERDSHRINE.GENERIC"
msgid "I feel luckier already."
msgstr "もうツイてる気分になってきたよ。"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.PEROGIES
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.PEROGIES"
msgid "You work up a mighty appetite at the factory."
msgstr "あんたの食欲は工場でさらに磨きがかかるよ。"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.PETALS
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.PETALS"
msgid "Don't see a whole lotta use for these."
msgstr "あんまり使えるようには見えないな。"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.PETALS_DRIED
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.PETALS_DRIED"
msgid "These are nice and dry."
msgstr "乾燥具合は上々だよ。"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.PETALS_EVIL
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.PETALS_EVIL"
msgid "They seem mean-spirited."
msgstr "悪霊がとりついてるみたいだ。"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.PETALS_EVIL_DRIED
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.PETALS_EVIL_DRIED"
msgid "These are nice and dry."
msgstr "乾燥具合は上々だよ。"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.PETRIFIED_TREE
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.PETRIFIED_TREE"
msgid "Solid stone."
msgstr "固い石だ。"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.PHLEGM
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.PHLEGM"
msgid "Please. I hock bigger loogies in my sleep."
msgstr "冗談だろ。あたい、寝てる間にもっと豪快に出してるよ。"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.PHONOGRAPH
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.PHONOGRAPH"
msgid "Nothin' like some music to get through the workday faster."
msgstr "音楽を聴けば、仕事がはかどる。"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.PICKAXE
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.PICKAXE"
msgid "Not my preferred kind of manual labor."
msgstr "あたいが好きなタイプの労働じゃないな。"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.PICKAXE_LUNARPLANT
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.PICKAXE_LUNARPLANT"
msgid "Sure makes mining a breeze."
msgstr "これなら採掘作業も捗るな！"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.PICKLEDHERRING
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.PICKLEDHERRING"
msgid "It's actually not bad!"
msgstr "これ、それほど悪くないよ！"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.PIGELITE1
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.PIGELITE1"
msgid "Swell tattoos you got there."
msgstr "腫れるタトゥー入れたみたいだね。"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.PIGELITE2
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.PIGELITE2"
msgid "Chill out, red."
msgstr "落ち着きなよ、赤。"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.PIGELITE3
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.PIGELITE3"
msgid "He's giving me a dirty look."
msgstr "あいつ、あたいのこといやらしい目で見てるな。"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.PIGELITE4
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.PIGELITE4"
msgid "Stand still so I can hit you with a sign."
msgstr "じっとしてな。看板でなぐってやるから。"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.PIGELITEFIGHTER1
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.PIGELITEFIGHTER1"
msgid "Swell tattoos you got there."
msgstr "腫れるタトゥー入れたみたいだね。"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.PIGELITEFIGHTER2
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.PIGELITEFIGHTER2"
msgid "Chill out, red."
msgstr "落ち着きなよ、赤。"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.PIGELITEFIGHTER3
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.PIGELITEFIGHTER3"
msgid "He's giving me a dirty look."
msgstr "あいつ、あたいのこといやらしい目で見てるな。"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.PIGELITEFIGHTER4
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.PIGELITEFIGHTER4"
msgid "Stand still so I can hit you with a sign."
msgstr "じっとしてな。看板でなぐってやるから。"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.PIGGUARD
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.PIGGUARD"
msgid "You don't look so tough."
msgstr "あんた、強そうには見えないよ。"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.PIGGYBACK
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.PIGGYBACK"
msgid "Makes everything smell like pig."
msgstr "ぜんぶブタの臭いになる。"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.PIGHEAD.BURNT
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.PIGHEAD.BURNT"
msgid "What a waste of materials."
msgstr "なんて材料のムダ。"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.PIGHEAD.GENERIC
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.PIGHEAD.GENERIC"
msgid "I should hammer down that eyesore."
msgstr "あの不細工は打ちのめさなくちゃだめだね。"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.PIGHOUSE.BURNT
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.PIGHOUSE.BURNT"
msgid "That's a shame."
msgstr "ありゃ、残念だ。"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.PIGHOUSE.FULL
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.PIGHOUSE.FULL"
msgid "Fuller than a downtown tenement house."
msgstr "下町の長屋より満員だ。"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.PIGHOUSE.GENERIC
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.PIGHOUSE.GENERIC"
msgid "No way that's up to code."
msgstr "あんなの当然規制違反だよ。"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.PIGHOUSE.LIGHTSOUT
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.PIGHOUSE.LIGHTSOUT"
msgid "Hey! I just want some light!"
msgstr "ねえ！ちょっと明かりが欲しいんだけど！"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.PIGKING
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.PIGKING"
msgid "Those hooves've never seen a day of work."
msgstr "あの蹄は働いたことなんてないんだろうな。"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.PIGMAN.DEAD
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.PIGMAN.DEAD"
msgid "That threw a wrench into his plans."
msgstr "あいつの計画に悪臭が立ち込めるね。"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.PIGMAN.FOLLOWER
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.PIGMAN.FOLLOWER"
msgid "Chummy fellow!"
msgstr "仲良しさん！"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.PIGMAN.GENERIC
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.PIGMAN.GENERIC"
msgid "Hey there, ya lug!"
msgstr "ねえ、そこののろま！"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.PIGMAN.GUARD
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.PIGMAN.GUARD"
msgid "Don't want no trouble."
msgstr "あたい、トラブルは御免だよ。"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.PIGMAN.WEREPIG
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.PIGMAN.WEREPIG"
msgid "I have no idea what's going on!"
msgstr "一体何が起きてるんだか、あたいにはさっぱりだ！"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.PIGSHRINE.BURNT
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.PIGSHRINE.BURNT"
msgid "No good now."
msgstr "もう駄目だね。"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.PIGSHRINE.EMPTY
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.PIGSHRINE.EMPTY"
msgid "I gotta find some meat for it."
msgstr "肉を見つけないと。"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.PIGSHRINE.GENERIC
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.PIGSHRINE.GENERIC"
msgid "A bunch of things to build."
msgstr "作るものがいっぱいだ。"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.PIGSKIN
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.PIGSKIN"
msgid "The backside of an oinker."
msgstr "ブタの後ろ側。"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.PIGTENT
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.PIGTENT"
msgid "Yeesh, smells ripe in there."
msgstr "うわっ！あそこ、熟れた臭いが充満してる。"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.PIGTORCH
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.PIGTORCH"
msgid "Kitschy."
msgstr "下品だこと。"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.PIG_COIN
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.PIG_COIN"
msgid "Not bad payment for a good wrassle."
msgstr "これでいい喧嘩が買えるなら安いもんだよ。"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.PIG_TOKEN
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.PIG_TOKEN"
msgid "Too big for me to wear."
msgstr "大きすぎて着られない。"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.PINECONE
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.PINECONE"
msgid "That's a pine cone."
msgstr "あれは松ぼっくりだ。"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.PINECONE_SAPLING
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.PINECONE_SAPLING"
msgid "It can handle itself from here."
msgstr "ここから自分のこと操作できるんだね。"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.PIRATE_FLAG_POLE
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.PIRATE_FLAG_POLE"
msgid "They're surprisingly artistic for a bunch of monkeys."
msgstr "サルどもにしてはずいぶんと芸術的じゃないか。"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.PIRATE_STASH
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.PIRATE_STASH"
msgid "I think this is the place."
msgstr "どうやらここみたいだ。"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.PITCHFORK
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.PITCHFORK"
msgid "It's so... rural."
msgstr "なんていうか...田舎だね。"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.PLANTMEAT
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.PLANTMEAT"
msgid "This is beyond confusing."
msgstr "紛らわしいどころの話じゃない。"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.PLANTMEAT_COOKED
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.PLANTMEAT_COOKED"
msgid "It cooked up pretty good."
msgstr "ちょうどよくできたみたい。"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.PLANTREGISTRYHAT
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.PLANTREGISTRYHAT"
msgid "Better fill my noggin' with some planting know-how."
msgstr "庭仕事の知識を頭に叩き込まなきゃ。"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.PLANT_NORMAL.GENERIC
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.PLANT_NORMAL.GENERIC"
msgid "It's a plant."
msgstr "植物だ！"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.PLANT_NORMAL.GROWING
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.PLANT_NORMAL.GROWING"
msgid "It's hard at work."
msgstr "仕事熱心だよ。"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.PLANT_NORMAL.READY
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.PLANT_NORMAL.READY"
msgid "Good to go."
msgstr "これで万全だ。"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.PLANT_NORMAL.WITHERED
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.PLANT_NORMAL.WITHERED"
msgid "It's a bit hot out."
msgstr "外は暑すぎるよ。"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.PLAYBILL_THE_DOLL
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.PLAYBILL_THE_DOLL"
msgid "Somehow I think there's more to the story."
msgstr "なぜか物語はこれだけじゃない気がするね。"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.PLAYBILL_THE_PRINCESS_YOTH
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.PLAYBILL_THE_PRINCESS_YOTH"
msgid "A lil' horse drama, huh?"
msgstr "馬のドラマときたもんだ…"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.PLAYBILL_THE_VAULT
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.PLAYBILL_THE_VAULT"
msgid "That was dark."
msgstr "闇が深かったな。"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.PLAYBILL_THE_VEIL
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.PLAYBILL_THE_VEIL"
msgid "Who the heck is Herald?"
msgstr "「シシャ」って誰だ？"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.PLAYER.ATTACKER
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.PLAYER.ATTACKER"
msgid "Hands to yourself, bucko!"
msgstr "触るんじゃないよ！"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.PLAYER.FIRESTARTER
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.PLAYER.FIRESTARTER"
msgid "You better not have singed any of my projects, %s."
msgstr "あんたはあたいのプロジェクトは焼かない方がいいよ、%s。"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.PLAYER.GENERIC
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.PLAYER.GENERIC"
msgid "Hey, %s! How ya doin'?"
msgstr "やあ、%s！元気にしてたかい？"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.PLAYER.GHOST
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.PLAYER.GHOST"
msgid "Stop whinin', %s, it's just a scratch!"
msgstr "文句ばっかり言いなさんな、%s。ちょっとこすっただけだろ？"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.PLAYER.MURDERER
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.PLAYER.MURDERER"
msgid "Murderer! Get'em!"
msgstr "人殺し！捕まえろ！"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.PLAYER.REVIVER
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.PLAYER.REVIVER"
msgid "You're good people, %s."
msgstr "あんたたち、善良だね、%s。"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.PLAYER_HOSTED.GENERIC
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.PLAYER_HOSTED.GENERIC"
msgid "Ain't nothin' right about that."
msgstr "一体どうなっているんだ…"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.PLAYER_HOSTED.ME
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.PLAYER_HOSTED.ME"
msgid "No, thank you."
msgstr "いいや、結構だ。"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.PLAYING_CARD
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.PLAYING_CARD"
msgid "Somebody's not playin' with a full deck."
msgstr "52枚揃ってないデッキで遊んでるやつがいるんじゃない？"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.POCKETWATCH_DISMANTLER
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.POCKETWATCH_DISMANTLER"
msgid "Wish I'd had the chance to grab some of my tools before I got here."
