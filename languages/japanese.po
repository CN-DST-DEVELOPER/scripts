msgstr "すごい！あれが何だかさっぱりだったんだ。"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE_PLANTHAPPY
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE_PLANTHAPPY"
msgid "Healthy as a horse!"
msgstr "元気バリバリだね！"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE_PLANTSTRESSED
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE_PLANTSTRESSED"
msgid "Something's bugging it."
msgstr "なんか上手くいってないみたいだね。"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE_PLANTSTRESSORFAMILY
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE_PLANTSTRESSORFAMILY"
msgid "Guess it's kind of lonely being the only one out here, huh?"
msgstr "さては、ここで一人ぼっちでいるのが辛いんだね？"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE_PLANTSTRESSORHAPPINESS
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE_PLANTSTRESSORHAPPINESS"
msgid "It needs a good talking to."
msgstr "良い話し相手が必要みたいだね。"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE_PLANTSTRESSORKILLJOYS
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE_PLANTSTRESSORKILLJOYS"
msgid "I'd better get back to weeding."
msgstr "草むしりを再開したほうが良さそうだ。"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE_PLANTSTRESSORMOISTURE
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE_PLANTSTRESSORMOISTURE"
msgid "You look like you could use some water."
msgstr "水が欲しいみたいだね。"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE_PLANTSTRESSORNUTRIENTS
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE_PLANTSTRESSORNUTRIENTS"
msgid "Better give it some nutrients."
msgstr "肥料を足したほうが良さそうだ。"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE_PLANTSTRESSOROVERCROWDING
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE_PLANTSTRESSOROVERCROWDING"
