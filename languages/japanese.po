msgid "Use {doodad_count} Spools to weave item: {item_name}?\n\nYou will be left with {doodad_net} Spools.\nSpools are used to weave \"Woven\" rarity curios."
msgstr "{doodad_count}スプールを使ってアイテム：{item_name}を織りますか？\n\n{doodad_net}スプールは残しておきます。\nスプールは「織られた」レアリティのキュリオを織るために使用されます。"

#. STRINGS.UI.BARTERSCREEN.CONFIRM_GRIND_DUPES_FMT
msgctxt "STRINGS.UI.BARTERSCREEN.CONFIRM_GRIND_DUPES_FMT"
msgid "Unravel {count} duplicates into {doodad_count} Spools?\n\nYou will have a total of {doodad_net} Spools."
msgstr "{count}個の重複アイテムをほどいて{doodad_count}個のスプールにしますか？\n\n合計で{doodad_net}個のスプールができます。"

#. STRINGS.UI.BARTERSCREEN.CONFIRM_GRIND_DUPE_FMT
msgctxt "STRINGS.UI.BARTERSCREEN.CONFIRM_GRIND_DUPE_FMT"
msgid "Unravel 1 duplicate into {doodad_count} Spools?\n\nYou will have a total of {doodad_net} Spools."
msgstr "1個の重複アイテムをほどいて{doodad_count}個のスプールにしますか？\n\n合計で{doodad_net}個のスプールができます。"

#. STRINGS.UI.BARTERSCREEN.CONFIRM_GRIND_FMT
msgctxt "STRINGS.UI.BARTERSCREEN.CONFIRM_GRIND_FMT"
msgid "Unravel this {item_name} into {doodad_count} Spools?\n\nYou will have a total of {doodad_net} Spools.\nSpools are used to weave \"Woven\" rarity curios."
msgstr "この{item_name}を{doodad_count} スプールに解きほぐしますか？\n\n{doodad_net} スプールの合計を持つことになります。\nスプールは「織られた」レアリティのキュリオを織るために使用されます。"

#. STRINGS.UI.BARTERSCREEN.FAILED_BODY
msgctxt "STRINGS.UI.BARTERSCREEN.FAILED_BODY"
msgid "Sorry!\nFailed to contact Klei Servers. Please try again."
msgstr "申し訳ありません！\nクレイサーバーとの連絡に失敗しました。もう一度お試しください。"

