msgid "buhrg"
msgstr "バーグ"

#. STRINGS.GIBERISH_PRE.2
msgctxt "STRINGS.GIBERISH_PRE.2"
msgid "grog"
msgstr "グルッグ"

#. STRINGS.GIBERISH_PRE.3
