msgstr "もう十分だろう。"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.YOTR_RABBITSHRINE.EMPTY
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.YOTR_RABBITSHRINE.EMPTY"
