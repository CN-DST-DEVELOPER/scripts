#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.VEGGIE_OVERSIZED_ROTTEN
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.VEGGIE_OVERSIZED_ROTTEN"
