msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.CARNIVALGAME_MEMORY_CARD.PLAYING"
msgid "This one or that one?"
msgstr "これかな？それともあっちかな？"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.CARNIVALGAME_MEMORY_KIT
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.CARNIVALGAME_MEMORY_KIT"
msgid "We're almost ready for the fun to begin!"
msgstr "あとちょっとで楽しい遊びの始まりだ！"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.CARNIVALGAME_MEMORY_STATION.GENERIC
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.CARNIVALGAME_MEMORY_STATION.GENERIC"
