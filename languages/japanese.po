msgstr "建てられるよ！使える手はたくさんあるんだから！"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.LUNAR_GRAZER
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.LUNAR_GRAZER"
