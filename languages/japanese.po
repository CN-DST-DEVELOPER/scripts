msgstr "ずいぶんと交渉上手じゃないか。"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.YOTH_KNIGHTSTICK
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.YOTH_KNIGHTSTICK"
