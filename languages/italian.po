msgstr "Aspetta con pazienza per guardare dove il sottoscritto vuole andare."

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.ABYSSPILLAR_MINION.GENERIC
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.ABYSSPILLAR_MINION.GENERIC"
