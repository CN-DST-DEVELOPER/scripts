msgstr "Sta tentando di riprodursi."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.MUSHTREE_SMALL.GENERIC
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.MUSHTREE_SMALL.GENERIC"
