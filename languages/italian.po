msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.POCKETWATCH_WARP.GENERIC"
msgid "Why worry about the past or future? It'll all go up in flames eventually."
msgstr "Perché preoccuparsi del passato o del futuro? Le fiamme divoreranno ogni cosa, alla fine."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.POCKETWATCH_WARP.RECHARGING
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.POCKETWATCH_WARP.RECHARGING"
msgid "It's not doing much right now."
msgstr "Al momento non sta facendo molto."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.POCKETWATCH_WEAPON.GENERIC
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.POCKETWATCH_WEAPON.GENERIC"
