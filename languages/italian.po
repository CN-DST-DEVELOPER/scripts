msgstr "Un mucchio di strumentini."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.POCKETWATCH_HEAL.GENERIC
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.POCKETWATCH_HEAL.GENERIC"
