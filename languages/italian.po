msgstr "Preferirei non mettermela in faccia."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.MASK_TREEHAT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.MASK_TREEHAT"
msgid "How very dramatic."
msgstr "Molto drammatico."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.MAST
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.MAST"
msgid "Every vessel mast have one."
msgstr "Ogni vascello deve averne uno."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.MASTUPGRADE_LAMP_ITEM
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.MASTUPGRADE_LAMP_ITEM"
msgid "Far more practical than setting a fire on our boat."
msgstr "Molto più pratico che accendere un fuoco sulla nave."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.MASTUPGRADE_LAMP_ITEM_YOTD
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.MASTUPGRADE_LAMP_ITEM_YOTD"
msgid "Far more practical than setting a fire on our boat."
msgstr "Molto più pratico che accendere un fuoco sulla nave."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.MASTUPGRADE_LAMP_YOTD
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.MASTUPGRADE_LAMP_YOTD"
msgid "How dare you look down on me!"
msgstr "Come osi guardarmi dall'alto al basso?!"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.MASTUPGRADE_LIGHTNINGROD_ITEM
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.MASTUPGRADE_LIGHTNINGROD_ITEM"
msgid "Very prudent."
msgstr "Molto prudente."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.MAST_ITEM
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.MAST_ITEM"
msgid "Do I look like a shipyard laborer?"
msgstr "Ti sembro un operaio di un cantiere navale?"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.MAST_MALBATROSS
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.MAST_MALBATROSS"
msgid "A warning to any waterfowl that cross us."
msgstr "Un avvertimento per tutti gli uccelli acquatici."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.MAST_MALBATROSS_ITEM
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.MAST_MALBATROSS_ITEM"
msgid "Must I do everything?"
msgstr "Devo fare tutto da solo?"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.MAST_YOTD
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.MAST_YOTD"
msgid "Those \"wings\" haven't been clipped from a real Dragonfly. A pity."
msgstr "Quelle \"ali\" non sono state strappate a una vera draghellula. Peccato."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.MAST_YOTD_ITEM
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.MAST_YOTD_ITEM"
msgid "Do I look like a shipyard laborer?"
msgstr "Ti sembro un operaio di un cantiere navale?"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.MAXWELL
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.MAXWELL"
msgid "Looking good!"
msgstr "Di bell'aspetto!"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.MAXWELLHEAD
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.MAXWELLHEAD"
msgid "Hey, handsome."
msgstr "Ehi, bello."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.MAXWELLLIGHT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.MAXWELLLIGHT"
msgid "Aw, it remembers me."
msgstr "Oh, mi ricorda di me."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.MAXWELLLOCK
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.MAXWELLLOCK"
msgid "It keeps the master in the chair."
msgstr "Mantiene il maestro in cattedra."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.MAXWELLPHONOGRAPH
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.MAXWELLPHONOGRAPH"
msgid "That accursed thing!"
msgstr "Quel coso maledetto!"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.MAXWELLTHRONE
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.MAXWELLTHRONE"
msgid "It's less painful than it looks. Barely."
msgstr "È meno doloroso di quanto sembri. A mala pena."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.MEAT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.MEAT"
msgid "I'm used to much finer fare."
msgstr "Sono abituato a pietanze più raffinate."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.MEATBALLS
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.MEATBALLS"
msgid "My compliments to the chef!"
msgstr "I miei complimenti allo chef!"

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.MEATRACK.BURNT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.MEATRACK.BURNT"
msgid "It's too brittle to hang meat on now."
msgstr "È troppo fragile per appenderci la carne ora."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.MEATRACK.DONE
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.MEATRACK.DONE"
msgid "Like the desert."
msgstr "Come il deserto."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.MEATRACK.DONE_NOTMEAT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.MEATRACK.DONE_NOTMEAT"
msgid "Like the desert."
msgstr "Come il deserto."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.MEATRACK.DRYING
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.MEATRACK.DRYING"
msgid "Still moist."
msgstr "Ancora umido."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.MEATRACK.DRYINGINRAIN
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.MEATRACK.DRYINGINRAIN"
msgid "Moist and staying that way."
msgstr "Umido e rimane così."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.MEATRACK.DRYINGINRAIN_NOTMEAT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.MEATRACK.DRYINGINRAIN_NOTMEAT"
msgid "Moist and staying that way."
msgstr "Umido e rimane così."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.MEATRACK.DRYING_NOTMEAT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.MEATRACK.DRYING_NOTMEAT"
msgid "Still moist."
msgstr "Ancora umido."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.MEATRACK.GENERIC
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.MEATRACK.GENERIC"
msgid "It can dry meats so they'll last longer."
msgstr "Può seccare le carni così che possano durare più a lungo."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.MEATRACK_HERMIT.BURNT
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.MEATRACK_HERMIT.BURNT"
msgid "It's too brittle to hang meat on now."
msgstr "È troppo fragile per appenderci la carne ora."

