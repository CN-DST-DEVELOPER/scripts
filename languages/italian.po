msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.SPORE_TALL.HELD"
msgid "Never hurts to have extra light."
msgstr "Non fa mai male avere una luce in più."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.SQUID
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.SQUID"
