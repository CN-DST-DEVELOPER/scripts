msgstr "Oh, quanti scherzi potrei fare con questa!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.OCEANFISHINGLURE_HERMIT_HEAVY
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.OCEANFISHINGLURE_HERMIT_HEAVY"
