msgstr "Ancora un altro tipo di terreno."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.TURF_MOSAIC_RED
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.TURF_MOSAIC_RED"
msgid "Yet another ground type."
msgstr "Ancora un altro tipo di terreno."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.TURF_MUD
