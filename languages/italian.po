msgstr "Brucia!"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.ROCK_AVOCADO_BUSH.DISEASED
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.ROCK_AVOCADO_BUSH.DISEASED"
msgid "It looks pretty sick."
msgstr "Sembra piuttosto malato."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.ROCK_AVOCADO_BUSH.DISEASING
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.ROCK_AVOCADO_BUSH.DISEASING"
msgid "Err, something's not right."
msgstr "Ehm, c'è qualcosa che non va."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.ROCK_AVOCADO_BUSH.GENERIC
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.ROCK_AVOCADO_BUSH.GENERIC"
msgid "It's a bush... from the moon!"
msgstr "È un cespuglio... venuto dalla luna!"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.ROCK_AVOCADO_BUSH.PICKED
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.ROCK_AVOCADO_BUSH.PICKED"
msgid "It'll take awhile to grow more fruit."
msgstr "Ci metterà un po' per fare altri frutti."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.ROCK_AVOCADO_BUSH.WITHERED
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.ROCK_AVOCADO_BUSH.WITHERED"
msgid "It's pretty hot out."
msgstr "Fa parecchio caldo."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.ROCK_AVOCADO_FRUIT
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.ROCK_AVOCADO_FRUIT"
msgid "I'd shatter my teeth on that."
msgstr "Non voglio spezzarmi i denti."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.ROCK_AVOCADO_FRUIT_RIPE
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.ROCK_AVOCADO_FRUIT_RIPE"
