msgctxt "STRINGS.CHARACTERS.WORTOX.ACTIONFAIL.SLAUGHTER.TOOFAR"
msgid "Oh ho! Too late, they've made their escape."
msgstr "Oh oh! Troppo tardi, se l'è svignata."

#. STRINGS.CHARACTERS.WORTOX.ACTIONFAIL.SOAKIN.NOSPACE
msgctxt "STRINGS.CHARACTERS.WORTOX.ACTIONFAIL.SOAKIN.NOSPACE"
msgid "Sit? I cannot! For it's a hot spot, just as I thought!"
msgstr "Come avevo immaginato, ogni posto è occupato!"

#. STRINGS.CHARACTERS.WORTOX.ACTIONFAIL.START_CARRAT_RACE.NO_RACERS
msgctxt "STRINGS.CHARACTERS.WORTOX.ACTIONFAIL.START_CARRAT_RACE.NO_RACERS"
