msgstr "Peso: {weight}\nCatturato da: {owner}\nChe bel bocconcino!"

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.TROPHYSCALE_FISH.OWNER
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.TROPHYSCALE_FISH.OWNER"
