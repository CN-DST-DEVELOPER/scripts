msgstr "Uhm, non ricordo di aver mai visto un fiore come quello prima d'ora."

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.FORGETMELOTS_DRIED
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.FORGETMELOTS_DRIED"
msgid "A fine ingredient!"
msgstr "Un ottimo ingrediente!"

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.FORMAL_BLUEPRINT
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.FORMAL_BLUEPRINT"
