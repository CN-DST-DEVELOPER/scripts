msgstr "Un'intagliatrice di zucche è efficace solo quanto i suoi strumenti."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.PUMPKINCOOKIE
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.PUMPKINCOOKIE"
msgid "Gotta indulge sometimes, hey?"
msgstr "Bisogna concedersi dei piaceri qualche volta, ehi?"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.PUMPKINHAT.GENERIC
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.PUMPKINHAT.GENERIC"
msgid "How ya doin, Jack?"
msgstr "Come te la passi, Jack?"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.PUMPKINHAT.UNCARVED
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.PUMPKINHAT.UNCARVED"
msgid "Didn't put on your face yet?"
msgstr "Sei ancora senza faccia?"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.PUMPKINPIE
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.PUMPKINPIE"
msgid "Tis the season for some good eatin'!"
msgstr "È il periodo in cui si può mangiare di tutto!"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.PUMPKIN_COOKED
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.PUMPKIN_COOKED"
msgid "Not bad! Kind of sweet."
msgstr "Niente male. È dolce."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.PUMPKIN_LANTERN
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.PUMPKIN_LANTERN"
msgid "It's childish, but in a nice way."
msgstr "È infantile, ma in un modo carino."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.PUMPKIN_OVERSIZED
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.PUMPKIN_OVERSIZED"
msgid "Hey there, gourd lookin'! Ha!"
msgstr "Ciao, zuccona! Ah ah!"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.PUMPKIN_SEEDS
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.PUMPKIN_SEEDS"
msgid "A handful of seeds."
msgstr "Una manciata di semi."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.PUNCHINGBAG
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.PUNCHINGBAG"
msgid "Whatcha say? Wanna go a few rounds?"
msgstr "Che ne dici? Possiamo azzuffarci un po'?"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.PUREBRILLIANCE
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.PUREBRILLIANCE"
msgid "I ain't dazzled by much, but that'll do it."
msgstr "Non è facile abbagliarmi, ma lui può farlo."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.PURPLEAMULET
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.PURPLEAMULET"
msgid "It's, uh, a purple necklace."
msgstr "È una, uh, collana viola."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.PURPLEGEM
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.PURPLEGEM"
msgid "A little snooty gem."
msgstr "Una piccola gemma altezzosa."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.PURPLEMOONEYE
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.PURPLEMOONEYE"
msgid "That's amore."
msgstr "È amore."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.QUAGMIRE_ALTAR.FULL
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.QUAGMIRE_ALTAR.FULL"
msgid "That should keep it busy fer a bit."
msgstr "Dovrebbe tenerlo impegnato per un po'."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.QUAGMIRE_ALTAR.GENERIC
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.QUAGMIRE_ALTAR.GENERIC"
msgid "Moss has grown over some sorta socket in the base."
msgstr "È spuntato del muschio sopra quella specie di cavità nella base."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.QUAGMIRE_ALTAR_BOLLARD
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.QUAGMIRE_ALTAR_BOLLARD"
msgid "Nice metalwork."
msgstr "Bella lavorazione dei metalli."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.QUAGMIRE_ALTAR_IVY
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.QUAGMIRE_ALTAR_IVY"
msgid "That stuff can ruin good architecture."
msgstr "Quella cosa può rovinare le architetture."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.QUAGMIRE_ALTAR_QUEEN
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.QUAGMIRE_ALTAR_QUEEN"
msgid "Woo-wee. Impress-ive."
msgstr "Ehi ehi. Imponente."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.QUAGMIRE_ALTAR_STATUE1
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.QUAGMIRE_ALTAR_STATUE1"
msgid "It probably looked real nice once."
msgstr "Probabilmente è stata una bella statua una volta."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.QUAGMIRE_ALTAR_STATUE2
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.QUAGMIRE_ALTAR_STATUE2"
msgid "I wonder who chiseled that."
msgstr "Mi chiedo chi lo abbia cesellato."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.QUAGMIRE_BEEFALO
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.QUAGMIRE_BEEFALO"
msgid "Take it easy. You don't looks so good."
msgstr "Rilassati. Non stai molto bene."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.QUAGMIRE_BERRYBUSH
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.QUAGMIRE_BERRYBUSH"
msgid "Nothing in that bush anymore."
msgstr "Niente più in quel cespuglio."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.QUAGMIRE_BOWL_SILVER
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.QUAGMIRE_BOWL_SILVER"
msgid "Fancy lookin' but it still just holds food."
msgstr "Molto raffinato, ma è pur sempre una ciotola."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.QUAGMIRE_CARROT_SEEDS
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.QUAGMIRE_CARROT_SEEDS"
msgid "I got no idea what they'd grow into."
msgstr "Non ho idea di cosa diventeranno."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.QUAGMIRE_CASSEROLEDISH
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.QUAGMIRE_CASSEROLEDISH"
msgid "I'll need to bake it."
msgstr "Devo infornarlo."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.QUAGMIRE_CASSEROLEDISH_SMALL
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.QUAGMIRE_CASSEROLEDISH_SMALL"
msgid "For making little stews and stuff."
msgstr "Per fare piccoli stufati eccetera."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.QUAGMIRE_COIN1
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.QUAGMIRE_COIN1"
msgid "A lucky coin."
msgstr "Una moneta fortunata."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.QUAGMIRE_COIN2
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.QUAGMIRE_COIN2"
msgid "Save this for a rainy day."
msgstr "Lo conservo per i momenti del bisogno."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.QUAGMIRE_COIN3
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.QUAGMIRE_COIN3"
msgid "Gotta watch I don't turn into a rich dope."
msgstr "Meglio fare attenzione a non diventare una riccona incallita."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.QUAGMIRE_COIN4
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.QUAGMIRE_COIN4"
msgid "We could bust outta here with enough of these."
msgstr "Potremmo uscire da qui se ne avessimo abbastanza."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.QUAGMIRE_CRABMEAT
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.QUAGMIRE_CRABMEAT"
msgid "I get crabby when I'm hungry. Ha!"
msgstr "Ho i granchi allo stomaco quando sono affamata. Ah."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.QUAGMIRE_CRABMEAT_COOKED
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.QUAGMIRE_CRABMEAT_COOKED"
msgid "It's a big lump of cooked crab."
msgstr "Un gran pezzo di granchio cotto."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.QUAGMIRE_CRABTRAP
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.QUAGMIRE_CRABTRAP"
msgid "Here lil crabby crab."
msgstr "Vieni qua bel granchietto."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.QUAGMIRE_FERN
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.QUAGMIRE_FERN"
msgid "Fresh roughage."
msgstr "Crusca fresca."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.QUAGMIRE_FLOUR
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.QUAGMIRE_FLOUR"
msgid "I ain't much of a baker."
msgstr "Non sono una panettiera."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.QUAGMIRE_FOLIAGE_COOKED
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.QUAGMIRE_FOLIAGE_COOKED"
msgid "Cooked roughage."
msgstr "Crusca cotta."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.QUAGMIRE_FOOD.GENERIC
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.QUAGMIRE_FOOD.GENERIC"
msgid "Let's throw it up on that altar, hey?"
msgstr "Buttiamolo su quell'altare, ehi?"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.QUAGMIRE_FOOD.MATCH
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.QUAGMIRE_FOOD.MATCH"
msgid "Perfect."
msgstr "Perfetto."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.QUAGMIRE_FOOD.MATCH_BUT_SNACK
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.QUAGMIRE_FOOD.MATCH_BUT_SNACK"
msgid "It's the right food, but it don't look too filling."
msgstr "È il cibo giusto, ma non sembra molto saziante."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.QUAGMIRE_FOOD.MISMATCH
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.QUAGMIRE_FOOD.MISMATCH"
msgid "Well this ain't right."
msgstr "Beh, non va bene."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.QUAGMIRE_FOOD_BURNT
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.QUAGMIRE_FOOD_BURNT"
msgid "It's a little toastier than normal."
msgstr "È un po' più tostato del normale."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.QUAGMIRE_GARLIC
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.QUAGMIRE_GARLIC"
msgid "Makes everything taste better."
msgstr "Rende tutto di sapore migliore."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.QUAGMIRE_GARLIC_COOKED
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.QUAGMIRE_GARLIC_COOKED"
msgid "Bet that brought out the flavor."
msgstr "Scommetto che abbia fatto risaltare il sapore."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.QUAGMIRE_GARLIC_SEEDS
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.QUAGMIRE_GARLIC_SEEDS"
msgid "I got no idea what they'd grow into."
msgstr "Non ho idea di cosa diventeranno."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.QUAGMIRE_GOATKID
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.QUAGMIRE_GOATKID"
msgid "What's goin' on, squirt?"
msgstr "Cosa succede, cosetto?"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.QUAGMIRE_GOATMILK
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.QUAGMIRE_GOATMILK"
msgid "I try to support local artisans."
msgstr "Cerco di sostenere l'artigianato locale."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.QUAGMIRE_GOATMUM
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.QUAGMIRE_GOATMUM"
msgid "Got anything for me?"
msgstr "Hai qualcosa per me?"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.QUAGMIRE_GRILL
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.QUAGMIRE_GRILL"
msgid "Time for a cookout!"
msgstr "È giunta l'ora di una grigliata!"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.QUAGMIRE_GRILL_ITEM
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.QUAGMIRE_GRILL_ITEM"
msgid "I need to to find a firepit for this to work."
msgstr "Devo trovare un focolare per farlo funzionare."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.QUAGMIRE_GRILL_SMALL
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.QUAGMIRE_GRILL_SMALL"
msgid "Big enough for a small cookout."
msgstr "È grande abbastanza per una piccola grigliata."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.QUAGMIRE_GRILL_SMALL_ITEM
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.QUAGMIRE_GRILL_SMALL_ITEM"
msgid "Now where can I put this..."
msgstr "Dove potrei metterla..."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.QUAGMIRE_HOE
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.QUAGMIRE_HOE"
msgid "I never done farmwork."
msgstr "Non ho mai lavorato in una fattoria."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.QUAGMIRE_KEY
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.QUAGMIRE_KEY"
msgid "Hmmm... looks like the key to a safe."
msgstr "Hmmm... sembra la chiave di una cassaforte."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.QUAGMIRE_KEY_PARK
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.QUAGMIRE_KEY_PARK"
msgid "It's a gate key."
msgstr "È la chiave di un cancello."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.QUAGMIRE_LAMP_POST
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.QUAGMIRE_LAMP_POST"
msgid "That'd be a street lamp. Yep."
msgstr "E quello sarebbe un lampione. Già."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.QUAGMIRE_LAMP_SHORT
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.QUAGMIRE_LAMP_SHORT"
msgid "That's a light."
msgstr "È una luce."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.QUAGMIRE_MEALINGSTONE
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.QUAGMIRE_MEALINGSTONE"
msgid "Ah! A job that could use some elbow grease!"
msgstr "Ah! Un lavoro dove servirebbe olio di gomito!"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.QUAGMIRE_MERMHOUSE
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.QUAGMIRE_MERMHOUSE"
msgid "Zero form, zero function."
msgstr "Nessuna forma, nessuna funzione."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.QUAGMIRE_MERM_CART1
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.QUAGMIRE_MERM_CART1"
msgid "Anything good in there?"
msgstr "C'è qualcosa di buono là dentro?"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.QUAGMIRE_MERM_CART2
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.QUAGMIRE_MERM_CART2"
msgid "It's full of stuff I could use."
msgstr "È pieno di cose che potrei usare."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.QUAGMIRE_MUSHROOMS
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.QUAGMIRE_MUSHROOMS"
msgid "Wouldn't mind popping these suckers into the pot."
msgstr "Non mi dispiacerebbe mettere questi polloni in pentola."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.QUAGMIRE_MUSHROOMSTUMP.GENERIC
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.QUAGMIRE_MUSHROOMSTUMP.GENERIC"
msgid "Well, they don't LOOK poisonous."
msgstr "Beh, non sembrano velenosi."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.QUAGMIRE_MUSHROOMSTUMP.PICKED
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.QUAGMIRE_MUSHROOMSTUMP.PICKED"
msgid "It's just a stump."
msgstr "È solo un ceppo."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.QUAGMIRE_ONION
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.QUAGMIRE_ONION"
msgid "I hate chopping vegetables."
msgstr "Odio tagliare le cipolle."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.QUAGMIRE_ONION_COOKED
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.QUAGMIRE_ONION_COOKED"
msgid "Done and done."
msgstr "Fatto a pezzi."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.QUAGMIRE_ONION_SEEDS
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.QUAGMIRE_ONION_SEEDS"
msgid "I got no idea what they'd grow into."
msgstr "Non ho idea di cosa diventeranno."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.QUAGMIRE_OVEN
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.QUAGMIRE_OVEN"
msgid "It's a regular ol' oven."
msgstr "È un forno ordinario."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.QUAGMIRE_OVEN_ITEM
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.QUAGMIRE_OVEN_ITEM"
msgid "Welp. Another day, another project."
msgstr "Un altro giorno, un altro progetto."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.QUAGMIRE_PARKSPIKE
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.QUAGMIRE_PARKSPIKE"
msgid "Nice metalwork."
msgstr "Bella lavorazione dei metalli."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.QUAGMIRE_PARK_ANGEL
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.QUAGMIRE_PARK_ANGEL"
msgid "Gives me the heebie jeebies."
msgstr "Mi fa venire la strizza."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.QUAGMIRE_PARK_ANGEL2
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.QUAGMIRE_PARK_ANGEL2"
msgid "Kinda creepy."
msgstr "Un po' inquietante."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.QUAGMIRE_PARK_FOUNTAIN
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.QUAGMIRE_PARK_FOUNTAIN"
msgid "Under-used 'n overgrown."
msgstr "In disuso e trascurata."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.QUAGMIRE_PARK_GATE.GENERIC
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.QUAGMIRE_PARK_GATE.GENERIC"
msgid "Can't keep me outta nothing."
msgstr "Non posso stare fuori da tutto."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.QUAGMIRE_PARK_GATE.LOCKED
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.QUAGMIRE_PARK_GATE.LOCKED"
msgid "Needs a key."
msgstr "Ha bisogno di una chiave."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.QUAGMIRE_PARK_OBELISK
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.QUAGMIRE_PARK_OBELISK"
msgid "Nice stonework."
msgstr "Bella lavorazione della pietra."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.QUAGMIRE_PARK_URN
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.QUAGMIRE_PARK_URN"
msgid "Oh well. Happens to the best of us."
msgstr "Oh beh. Può succedere anche ai migliori."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.QUAGMIRE_PEBBLECRAB
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.QUAGMIRE_PEBBLECRAB"
msgid "He ain't a threat to no one."
msgstr "Non è una minaccia per nessuno."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.QUAGMIRE_PIGEON.DEAD
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.QUAGMIRE_PIGEON.DEAD"
msgid "Dead as a doornail."
msgstr "Morto stecchito."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.QUAGMIRE_PIGEON.GENERIC
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.QUAGMIRE_PIGEON.GENERIC"
msgid "You seen one, you seen'em all."
msgstr "Ne hai visto uno, hai visto tutto."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.QUAGMIRE_PIGEON.SLEEPING
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.QUAGMIRE_PIGEON.SLEEPING"
msgid "Sleeping on the job."
msgstr "Dorme sul posto di lavoro."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.QUAGMIRE_PLATE_SILVER
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.QUAGMIRE_PLATE_SILVER"
msgid "Little too fancy for my tastes."
msgstr "Un po' troppo lussuoso per i miei gusti."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.QUAGMIRE_POND_SALT
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.QUAGMIRE_POND_SALT"
msgid "It's a bit salty, hey?"
msgstr "È un po' salato, eh?"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.QUAGMIRE_PORTAL
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.QUAGMIRE_PORTAL"
msgid "I might not be good at rescue missions."
msgstr "Non sono brava nelle missioni di salvataggio."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.QUAGMIRE_PORTAL_KEY
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.QUAGMIRE_PORTAL_KEY"
msgid "Looks like it unlocks somethin' big."
msgstr "Sembra che sblocchi qualcosa di grosso."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.QUAGMIRE_POT
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.QUAGMIRE_POT"
msgid "Could make a real big stew in that pot."
msgstr "Potrebbe preparare un grande stufato in quella pentola."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.QUAGMIRE_POTATO
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.QUAGMIRE_POTATO"
msgid "I just think they're neat."
msgstr "Penso solo che siano lisce."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.QUAGMIRE_POTATO_COOKED
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.QUAGMIRE_POTATO_COOKED"
msgid "I've always been a meat and potatoes gal."
msgstr "Sono sempre stata una tipa da carne e patate."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.QUAGMIRE_POTATO_SEEDS
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.QUAGMIRE_POTATO_SEEDS"
msgid "I got no idea what they'd grow into."
msgstr "Non ho idea di cosa diventeranno."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.QUAGMIRE_POT_HANGER
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.QUAGMIRE_POT_HANGER"
msgid "Needs a pot in there or somethin'."
msgstr "C'è bisogno di una pentola o qualcosa del genere."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.QUAGMIRE_POT_HANGER_ITEM
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.QUAGMIRE_POT_HANGER_ITEM"
msgid "Ready for assembly."
msgstr "Pronto per il montaggio."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.QUAGMIRE_POT_SMALL
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.QUAGMIRE_POT_SMALL"
msgid "I only ever made stew before this."
msgstr "So solo fare lo stufato."

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.QUAGMIRE_POT_SYRUP
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.QUAGMIRE_POT_SYRUP"
msgid "Syrup makes me sappy. Ha!"
msgstr "Lo sciroppo mi rende sdolcinata. Ah!"

#. STRINGS.CHARACTERS.WINONA.DESCRIBE.QUAGMIRE_ROTTEN_CROP
msgctxt "STRINGS.CHARACTERS.WINONA.DESCRIBE.QUAGMIRE_ROTTEN_CROP"
