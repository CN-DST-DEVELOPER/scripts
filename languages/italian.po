msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.RECORD_DUSK"
msgid "It's always nice to have some music while you're busy burning stuff."
msgstr "È bello avere un sottofondo musicale mentre si brucia la roba."

