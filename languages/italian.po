msgstr "Ci brucia il pancino!"

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_MITEGLAND_DEBUFF.2
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_MITEGLAND_DEBUFF.2"
