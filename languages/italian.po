msgstr "Posso farlo solo mentre dorme."

#. STRINGS.CHARACTERS.WORTOX.ACTIONFAIL.SHAVE.GENERIC
msgctxt "STRINGS.CHARACTERS.WORTOX.ACTIONFAIL.SHAVE.GENERIC"
