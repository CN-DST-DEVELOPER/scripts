msgid "Warly won't let me peek inside. He's no fun."
msgstr "A Warly non piacerebbe. Non ha molto senso dell'umorismo."

#. STRINGS.CHARACTERS.WORTOX.ACTIONFAIL.OPEN_CRAFTING.SHADOWMAGIC
msgctxt "STRINGS.CHARACTERS.WORTOX.ACTIONFAIL.OPEN_CRAFTING.SHADOWMAGIC"
msgid "I don't think he knows how to use it."
msgstr "Non credo che sappia usarlo."

#. STRINGS.CHARACTERS.WORTOX.ACTIONFAIL.PICK.NOTHING_INSIDE
msgctxt "STRINGS.CHARACTERS.WORTOX.ACTIONFAIL.PICK.NOTHING_INSIDE"
msgid "Rather annoyed with this void."
msgstr "Che scoperta deludente, qui dentro non c'è niente."

#. STRINGS.CHARACTERS.WORTOX.ACTIONFAIL.PICK.STUCK
msgctxt "STRINGS.CHARACTERS.WORTOX.ACTIONFAIL.PICK.STUCK"
msgid "Just my luck, it's stuck."
msgstr "Sono iellato, è bloccato."

#. STRINGS.CHARACTERS.WORTOX.ACTIONFAIL.PICKUP.FULL_OF_CURSES
msgctxt "STRINGS.CHARACTERS.WORTOX.ACTIONFAIL.PICKUP.FULL_OF_CURSES"
msgid "I've had enough of this monkey stuff."
msgstr "Ne ho avuto abbastanza di fare la scimmia."

#. STRINGS.CHARACTERS.WORTOX.ACTIONFAIL.PICKUP.INUSE
msgctxt "STRINGS.CHARACTERS.WORTOX.ACTIONFAIL.PICKUP.INUSE"
msgid "Another soul has use of it."
msgstr "Un'altra anima ne sta facendo uso."

#. STRINGS.CHARACTERS.WORTOX.ACTIONFAIL.PICKUP.NOTMINE_YOTC.1
msgctxt "STRINGS.CHARACTERS.WORTOX.ACTIONFAIL.PICKUP.NOTMINE_YOTC.1"
msgid "What's the matter? I won't bite."
msgstr "Che importa? Non mi morderà."

#. STRINGS.CHARACTERS.WORTOX.ACTIONFAIL.PICKUP.NOTMINE_YOTC.2
msgctxt "STRINGS.CHARACTERS.WORTOX.ACTIONFAIL.PICKUP.NOTMINE_YOTC.2"
msgid "This soul is already bound to someone else."
msgstr "Quest'anima è già promessa a qualcun altro."

#. STRINGS.CHARACTERS.WORTOX.ACTIONFAIL.PICKUP.RESTRICTION
msgctxt "STRINGS.CHARACTERS.WORTOX.ACTIONFAIL.PICKUP.RESTRICTION"
msgid "I am cautious about touching it."
msgstr "Sono cauto nel toccarlo."

#. STRINGS.CHARACTERS.WORTOX.ACTIONFAIL.PLANTREGISTRY_RESEARCH_FAIL.FERTILIZER
msgctxt "STRINGS.CHARACTERS.WORTOX.ACTIONFAIL.PLANTREGISTRY_RESEARCH_FAIL.FERTILIZER"
msgid "That's all I need to know to make my garden grow."
msgstr "È tutto ciò che ho bisogno di sapere per far crescere il mio orto."

#. STRINGS.CHARACTERS.WORTOX.ACTIONFAIL.PLANTREGISTRY_RESEARCH_FAIL.GENERIC
msgctxt "STRINGS.CHARACTERS.WORTOX.ACTIONFAIL.PLANTREGISTRY_RESEARCH_FAIL.GENERIC"
msgid "I already know all its tricks, hyuyu!"
msgstr "Conosco già tutti i suoi trucchi, hiuuù!"

#. STRINGS.CHARACTERS.WORTOX.ACTIONFAIL.POUNCECAPTURE.MISSED
msgctxt "STRINGS.CHARACTERS.WORTOX.ACTIONFAIL.POUNCECAPTURE.MISSED"
msgid "Miss! Boo and hiss!"
msgstr "Mancato! Che peccato!"

#. STRINGS.CHARACTERS.WORTOX.ACTIONFAIL.POUR_WATER.OUT_OF_WATER
msgctxt "STRINGS.CHARACTERS.WORTOX.ACTIONFAIL.POUR_WATER.OUT_OF_WATER"
msgid "Oh my, the water's run dry!"
msgstr "Per tutti i diavoli, non ne è rimasta neanche una goccia!"

#. STRINGS.CHARACTERS.WORTOX.ACTIONFAIL.POUR_WATER_GROUNDTILE.OUT_OF_WATER
msgctxt "STRINGS.CHARACTERS.WORTOX.ACTIONFAIL.POUR_WATER_GROUNDTILE.OUT_OF_WATER"
msgid "Goodness me, it's dry as can be!"
msgstr "Dannazione, è proprio a secco!"

#. STRINGS.CHARACTERS.WORTOX.ACTIONFAIL.REMOTE_TELEPORT.NODEST
msgctxt "STRINGS.CHARACTERS.WORTOX.ACTIONFAIL.REMOTE_TELEPORT.NODEST"
msgid "only_used_by_winona"
msgstr "only_used_by_winona"

#. STRINGS.CHARACTERS.WORTOX.ACTIONFAIL.REMOTE_TELEPORT.NOSKILL
msgctxt "STRINGS.CHARACTERS.WORTOX.ACTIONFAIL.REMOTE_TELEPORT.NOSKILL"
msgid "only_used_by_winona"
msgstr "only_used_by_winona"

#. STRINGS.CHARACTERS.WORTOX.ACTIONFAIL.REMOVEMODULES.NO_MODULES
msgctxt "STRINGS.CHARACTERS.WORTOX.ACTIONFAIL.REMOVEMODULES.NO_MODULES"
msgid "only_used_by_wx78"
msgstr "only_used_by_wx78"

#. STRINGS.CHARACTERS.WORTOX.ACTIONFAIL.REPAIR.WRONGPIECE
msgctxt "STRINGS.CHARACTERS.WORTOX.ACTIONFAIL.REPAIR.WRONGPIECE"
msgid "That is incorrect!"
msgstr "Non è corretto!"

#. STRINGS.CHARACTERS.WORTOX.ACTIONFAIL.REPLATE.MISMATCH
msgctxt "STRINGS.CHARACTERS.WORTOX.ACTIONFAIL.REPLATE.MISMATCH"
msgid "Hyuyu! They all look the same to me!"
msgstr "Hiuuù! Mi sembrano tutti uguali!"

#. STRINGS.CHARACTERS.WORTOX.ACTIONFAIL.REPLATE.SAMEDISH
msgctxt "STRINGS.CHARACTERS.WORTOX.ACTIONFAIL.REPLATE.SAMEDISH"
msgid "I cannot redo what's already been done!"
msgstr "Non posso rifare quello che è già fatto!"

#. STRINGS.CHARACTERS.WORTOX.ACTIONFAIL.ROW_FAIL.BAD_TIMING0
msgctxt "STRINGS.CHARACTERS.WORTOX.ACTIONFAIL.ROW_FAIL.BAD_TIMING0"
msgid "Time to sync or swim, hyuyu!"
msgstr "O vado a tempo o nuoto, hiuuù!"

#. STRINGS.CHARACTERS.WORTOX.ACTIONFAIL.ROW_FAIL.BAD_TIMING1
msgctxt "STRINGS.CHARACTERS.WORTOX.ACTIONFAIL.ROW_FAIL.BAD_TIMING1"
msgid "If I time it just right, the end is in sight!"
msgstr "Se vado al ritmo giusto, mi divertirò di gusto!"

#. STRINGS.CHARACTERS.WORTOX.ACTIONFAIL.ROW_FAIL.BAD_TIMING2
msgctxt "STRINGS.CHARACTERS.WORTOX.ACTIONFAIL.ROW_FAIL.BAD_TIMING2"
msgid "I mustn't rock the boat!"
msgstr "Non devo far oscillare la barca!"

#. STRINGS.CHARACTERS.WORTOX.ACTIONFAIL.RUMMAGE.GENERIC
msgctxt "STRINGS.CHARACTERS.WORTOX.ACTIONFAIL.RUMMAGE.GENERIC"
msgid "Oh I simply couldn't."
msgstr "Semplicemente, non ho potuto."

#. STRINGS.CHARACTERS.WORTOX.ACTIONFAIL.RUMMAGE.INUSE
msgctxt "STRINGS.CHARACTERS.WORTOX.ACTIONFAIL.RUMMAGE.INUSE"
msgid "It is making a pact with another."
msgstr "Sta facendo il patto con un altro."

#. STRINGS.CHARACTERS.WORTOX.ACTIONFAIL.RUMMAGE.NOTAMERM
msgctxt "STRINGS.CHARACTERS.WORTOX.ACTIONFAIL.RUMMAGE.NOTAMERM"
msgid "Not for me, I see."
msgstr "Non mi pare appropriato: questo posto è riservato."

#. STRINGS.CHARACTERS.WORTOX.ACTIONFAIL.RUMMAGE.NOTAROBOT
msgctxt "STRINGS.CHARACTERS.WORTOX.ACTIONFAIL.RUMMAGE.NOTAROBOT"
msgid "I'm a non-automaton."
msgstr "Non comprende il mio idioma: non sono un automa."

#. STRINGS.CHARACTERS.WORTOX.ACTIONFAIL.RUMMAGE.NOTMASTERCHEF
msgctxt "STRINGS.CHARACTERS.WORTOX.ACTIONFAIL.RUMMAGE.NOTMASTERCHEF"
msgid "Warly won't let me peek inside. He's no fun."
msgstr "A Warly non piacerebbe. Non ha molto senso dell'umorismo."

#. STRINGS.CHARACTERS.WORTOX.ACTIONFAIL.RUMMAGE.NOTSOULJARHANDLER
msgctxt "STRINGS.CHARACTERS.WORTOX.ACTIONFAIL.RUMMAGE.NOTSOULJARHANDLER"
msgid "These aren't my souls."
msgstr "Quelle anime non sono mie."

#. STRINGS.CHARACTERS.WORTOX.ACTIONFAIL.RUMMAGE.RESTRICTED
msgctxt "STRINGS.CHARACTERS.WORTOX.ACTIONFAIL.RUMMAGE.RESTRICTED"
msgid "I can't! I shan't!"
msgstr "Non posso! E non lo farò!"

#. STRINGS.CHARACTERS.WORTOX.ACTIONFAIL.SADDLE.TARGETINCOMBAT
msgctxt "STRINGS.CHARACTERS.WORTOX.ACTIONFAIL.SADDLE.TARGETINCOMBAT"
