#. STRINGS.GOATKID_TALK_CLOSED.1
msgctxt "STRINGS.GOATKID_TALK_CLOSED.1"
msgid "I'll only talk to you if Mumsy says it's okay."
msgstr "Ti parlo solo se mammina dice che va bene."

#. STRINGS.GOATKID_TALK_CLOSED.2
msgctxt "STRINGS.GOATKID_TALK_CLOSED.2"
msgid "Go talk to my mum. Baa."
msgstr "Vai a parlare con la mia mamma. Bee."

#. STRINGS.GOATKID_TALK_CLOSED.3
msgctxt "STRINGS.GOATKID_TALK_CLOSED.3"
msgid "Can you ask my mum before we play?"
msgstr "Puoi chiedere alla mia mamma prima che giochiamo?"

#. STRINGS.GOATKID_TALK_CLOSED.4
msgctxt "STRINGS.GOATKID_TALK_CLOSED.4"
msgid "Go ask Mumsy if we can play. Baa."
msgstr "Vai a chiedere a mammina se possiamo giocare. Bee."

#. STRINGS.GOATKID_TALK_GREETING.1
msgctxt "STRINGS.GOATKID_TALK_GREETING.1"
msgid "Pipton lets me have sweets, when Mumsy says it's okay."
msgstr "Pipton mi dà un dolcetto, quando mammina dice che va bene."

#. STRINGS.GOATKID_TALK_GREETING.2
msgctxt "STRINGS.GOATKID_TALK_GREETING.2"
msgid "I like playing with the pebble crabs."
msgstr "Mi piace giocare con i granchi pietra."

#. STRINGS.GOATKID_TALK_GREETING.3
msgctxt "STRINGS.GOATKID_TALK_GREETING.3"
msgid "Our house used to be around here, baa."
msgstr "La nostra casa era da queste parti, bee."

#. STRINGS.GOATKID_TALK_GREETING.4
msgctxt "STRINGS.GOATKID_TALK_GREETING.4"
msgid "Mumsy says my friends can't come out to play."
msgstr "Mammina dice che i miei amici non possono uscire a giocare."

#. STRINGS.GOATKID_TALK_GREETING.5
msgctxt "STRINGS.GOATKID_TALK_GREETING.5"
msgid "I wish my bike still worked, baa."
msgstr "Vorrei che la mia bici non fosse rotta, bee."

#. STRINGS.GOATKID_TALK_GREETING.6
msgctxt "STRINGS.GOATKID_TALK_GREETING.6"
msgid "Sammy was a goat before, like mum and I."
msgstr "Sammy era una capra, come mamma e io."

#. STRINGS.GOATKID_TALK_GREETING.7
msgctxt "STRINGS.GOATKID_TALK_GREETING.7"
msgid "Mumsy tells me not to look at the sky."
msgstr "Mammina mi dice di non guardare al cielo."

#. STRINGS.GOATKID_TALK_TRADE.1
msgctxt "STRINGS.GOATKID_TALK_TRADE.1"
msgid "Baaaa! My favorite!"
msgstr "Beeee! Il mio preferito!"

#. STRINGS.GOATKID_TALK_TRADE.2
msgctxt "STRINGS.GOATKID_TALK_TRADE.2"
msgid "Oh, thanks!"
msgstr "Oh, grazie!"

#. STRINGS.GOATKID_TALK_TRADE.3
msgctxt "STRINGS.GOATKID_TALK_TRADE.3"
msgid "We're friends now, right?"
msgstr "Siamo amici adesso, giusto?"

#. STRINGS.GOATKID_TALK_TRADE.4
msgctxt "STRINGS.GOATKID_TALK_TRADE.4"
msgid "Baa!"
msgstr "Bee!"

#. STRINGS.GOATKID_TALK_TRADE.5
msgctxt "STRINGS.GOATKID_TALK_TRADE.5"
msgid "Mumsy says always to say \"thank-you\"."
msgstr "Mammina dice sempre di dire \"grazie\"."

#. STRINGS.GOATKID_TALK_TRADE.6
msgctxt "STRINGS.GOATKID_TALK_TRADE.6"
msgid "Tradesies are fun."
msgstr "Gli scambi sono divertenti."

#. STRINGS.GOATKID_TALK_TRADE.7
msgctxt "STRINGS.GOATKID_TALK_TRADE.7"
msgid "Baa, thanks!"
msgstr "Bee, grazie!"

#. STRINGS.GOATMUM_CRAVING_HINTS.1
msgctxt "STRINGS.GOATMUM_CRAVING_HINTS.1"
msgid "The Gnaw craves {craving}... {part2}"
msgstr "Il Masticatore brama {craving}... {part2}"

#. STRINGS.GOATMUM_CRAVING_HINTS.2
msgctxt "STRINGS.GOATMUM_CRAVING_HINTS.2"
msgid "The Gnaw hungers for {craving}... {part2}"
msgstr "Il masticatore ha fame di {craving}... {part2}"

#. STRINGS.GOATMUM_CRAVING_HINTS.3
msgctxt "STRINGS.GOATMUM_CRAVING_HINTS.3"
msgid "The Gnaw desires {craving}... {part2}"
msgstr "Il Masticatore desidera {craving}... {part2}"

#. STRINGS.GOATMUM_CRAVING_HINTS.4
msgctxt "STRINGS.GOATMUM_CRAVING_HINTS.4"
msgid "The Gnaw wants {craving}... {part2}"
msgstr "Il Masticatore vuole {craving}... {part2}"

#. STRINGS.GOATMUM_CRAVING_HINTS.5
msgctxt "STRINGS.GOATMUM_CRAVING_HINTS.5"
msgid "The Gnaw craves {craving}!"
msgstr "Il Masticatore brama {craving}!"

#. STRINGS.GOATMUM_CRAVING_HINTS.6
msgctxt "STRINGS.GOATMUM_CRAVING_HINTS.6"
msgid "The Gnaw desires {craving}!"
msgstr "Il Masticatore desidera {craving}!"

#. STRINGS.GOATMUM_CRAVING_HINTS.7
msgctxt "STRINGS.GOATMUM_CRAVING_HINTS.7"
msgid "The Gnaw hungers for {craving}!"
msgstr "Il Masticatore ha fame di {craving}!"

#. STRINGS.GOATMUM_CRAVING_HINTS_PART2.1
msgctxt "STRINGS.GOATMUM_CRAVING_HINTS_PART2.1"
msgid "I can tell, baa."
msgstr "Posso dire, bee."

#. STRINGS.GOATMUM_CRAVING_HINTS_PART2.2
msgctxt "STRINGS.GOATMUM_CRAVING_HINTS_PART2.2"
msgid "I feel it."
msgstr "Lo sento."

#. STRINGS.GOATMUM_CRAVING_HINTS_PART2.3
msgctxt "STRINGS.GOATMUM_CRAVING_HINTS_PART2.3"
msgid "It's time to cook."
msgstr "È il momento di cucinare."

#. STRINGS.GOATMUM_CRAVING_HINTS_PART2.4
msgctxt "STRINGS.GOATMUM_CRAVING_HINTS_PART2.4"
msgid "baa."
msgstr "bee."

#. STRINGS.GOATMUM_CRAVING_HINTS_PART2.5
msgctxt "STRINGS.GOATMUM_CRAVING_HINTS_PART2.5"
msgid "I'm certain of it."
msgstr "Ne sono sicuro."

#. STRINGS.GOATMUM_CRAVING_HINTS_PART2.6
msgctxt "STRINGS.GOATMUM_CRAVING_HINTS_PART2.6"
msgid "You must oblige."
msgstr "Devi obbedire."

#. STRINGS.GOATMUM_CRAVING_HINTS_PART2_IMPATIENT.1
msgctxt "STRINGS.GOATMUM_CRAVING_HINTS_PART2_IMPATIENT.1"
msgid "or anything! Hurry, BAAA!"
msgstr "o qualsiasi cosa! In fretta, BEEE!"

#. STRINGS.GOATMUM_CRAVING_HINTS_PART2_IMPATIENT.2
msgctxt "STRINGS.GOATMUM_CRAVING_HINTS_PART2_IMPATIENT.2"
msgid "or whatever! Quick, BAAA!"
msgstr "o qualunque cosa! Presto, BEEE!"

#. STRINGS.GOATMUM_CRAVING_HINTS_PART2_IMPATIENT.3
msgctxt "STRINGS.GOATMUM_CRAVING_HINTS_PART2_IMPATIENT.3"
msgid "BAAA! Hurry!"
msgstr "BEEE! Sbrigati!"

#. STRINGS.GOATMUM_CRAVING_HINTS_PART2_IMPATIENT.4
msgctxt "STRINGS.GOATMUM_CRAVING_HINTS_PART2_IMPATIENT.4"
msgid "there's no time!"
msgstr "non c'è tempo!"

#. STRINGS.GOATMUM_CRAVING_HINTS_PART2_IMPATIENT.5
msgctxt "STRINGS.GOATMUM_CRAVING_HINTS_PART2_IMPATIENT.5"
msgid "give it something! Anything!"
msgstr "dagli qualcosa! Qualunque cosa!"

#. STRINGS.GOATMUM_CRAVING_MAP.BREAD
msgctxt "STRINGS.GOATMUM_CRAVING_MAP.BREAD"
msgid "a meal on BREAD"
msgstr "un pasto con il PANE"

#. STRINGS.GOATMUM_CRAVING_MAP.CHEESE
msgctxt "STRINGS.GOATMUM_CRAVING_MAP.CHEESE"
msgid "a meal with CHEESE"
msgstr "un pasto con il FORMAGGIO"

#. STRINGS.GOATMUM_CRAVING_MAP.FISH
msgctxt "STRINGS.GOATMUM_CRAVING_MAP.FISH"
msgid "FISH"
msgstr "PESCE"

#. STRINGS.GOATMUM_CRAVING_MAP.MEAT
msgctxt "STRINGS.GOATMUM_CRAVING_MAP.MEAT"
msgid "MEAT"
msgstr "CARNE"

#. STRINGS.GOATMUM_CRAVING_MAP.PASTA
msgctxt "STRINGS.GOATMUM_CRAVING_MAP.PASTA"
msgid "PASTA"
msgstr "PASTA"

#. STRINGS.GOATMUM_CRAVING_MAP.SNACK
msgctxt "STRINGS.GOATMUM_CRAVING_MAP.SNACK"
msgid "a SNACK"
msgstr "uno SPUNTINO"

#. STRINGS.GOATMUM_CRAVING_MAP.SOUP
msgctxt "STRINGS.GOATMUM_CRAVING_MAP.SOUP"
msgid "SOUP"
msgstr "ZUPPA"

#. STRINGS.GOATMUM_CRAVING_MAP.SWEET
msgctxt "STRINGS.GOATMUM_CRAVING_MAP.SWEET"
msgid "a DESSERT"
msgstr "un DOLCE"

#. STRINGS.GOATMUM_CRAVING_MAP.VEGGIE
msgctxt "STRINGS.GOATMUM_CRAVING_MAP.VEGGIE"
msgid "a VEGETABLE dish"
msgstr "un piatto di VERDURE"

#. STRINGS.GOATMUM_CRAVING_MATCH.1
msgctxt "STRINGS.GOATMUM_CRAVING_MATCH.1"
msgid "Oh yes, {craving}! That'll buy you some time."
msgstr "Oh sì, {craving}! Ti farà guadagnare tempo."

#. STRINGS.GOATMUM_CRAVING_MATCH.2
msgctxt "STRINGS.GOATMUM_CRAVING_MATCH.2"
msgid "Yes, yes, {craving}! That should sate the beast."
msgstr "Oh sì, {craving}! Dovrebbe saziare la bestia."

#. STRINGS.GOATMUM_CRAVING_MATCH.3
msgctxt "STRINGS.GOATMUM_CRAVING_MATCH.3"
msgid "You found what the Gnaw craved!"
msgstr "Hai trovato quello che brama il Masticatore!"

#. STRINGS.GOATMUM_CRAVING_MATCH.4
msgctxt "STRINGS.GOATMUM_CRAVING_MATCH.4"
msgid "The Gnaw's pleased with your offering."
msgstr "Il Masticatore è soddisfatto della tua offerta."

#. STRINGS.GOATMUM_CRAVING_MATCH.5
msgctxt "STRINGS.GOATMUM_CRAVING_MATCH.5"
msgid "Mighty Gnaw! Feast now upon on {craving}!"
msgstr "Grande Masticatore! Banchetta adesso con {craving}!"

#. STRINGS.GOATMUM_CRAVING_MISMATCH.1
msgctxt "STRINGS.GOATMUM_CRAVING_MISMATCH.1"
msgid "Well, it wasn't {craving}. But better than nothing!"
msgstr "Ecco, non era {craving}. Ma meglio di niente!"

#. STRINGS.GOATMUM_CRAVING_MISMATCH.2
msgctxt "STRINGS.GOATMUM_CRAVING_MISMATCH.2"
msgid "That wasn't what the Gnaw craved, but we'll make do."
msgstr "Non era quello che il Masticatore bramava, ma andrà bene lo stesso."

#. STRINGS.GOATMUM_CRAVING_MISMATCH.3
msgctxt "STRINGS.GOATMUM_CRAVING_MISMATCH.3"
msgid "I wouldn't call that {craving}, but oh well."
msgstr "Non lo chiamerei proprio {craving}, ma pazienza."

#. STRINGS.GOATMUM_LOST.1
msgctxt "STRINGS.GOATMUM_LOST.1"
msgid "It's over."
msgstr "È finita."

#. STRINGS.GOATMUM_LOST.2
msgctxt "STRINGS.GOATMUM_LOST.2"
msgid "The Gnaw's plague is upon you."
msgstr "La piaga del Masticatore è su di noi."

#. STRINGS.GOATMUM_LOST.3
msgctxt "STRINGS.GOATMUM_LOST.3"
msgid "I'm sorry I couldn't help more."
msgstr "Mi dispiace di non aver potuto essere di aiuto."

#. STRINGS.GOATMUM_LOST.4
msgctxt "STRINGS.GOATMUM_LOST.4"
msgid "Goodbye."
msgstr "Addio."

#. STRINGS.GOATMUM_TALK_GREETING.1
msgctxt "STRINGS.GOATMUM_TALK_GREETING.1"
msgid "If you can earn the Gnaw's favor... you might escape."
msgstr "Se puoi guadagnare il favore del Masticatore... potresti riuscire a scappare."

#. STRINGS.GOATMUM_TALK_GREETING.2
msgctxt "STRINGS.GOATMUM_TALK_GREETING.2"
msgid "The Gnaw's been around since I was just a lamb."
msgstr "Il Masticatore è in giro da quando ero un agnellino."

#. STRINGS.GOATMUM_TALK_GREETING.3
msgctxt "STRINGS.GOATMUM_TALK_GREETING.3"
msgid "Another of your kind passed through here once."
msgstr "Un altro della tua specie è passato da qua una volta."

#. STRINGS.GOATMUM_TALK_GREETING.4
msgctxt "STRINGS.GOATMUM_TALK_GREETING.4"
msgid "Favor from the Gnaw might recharge the old key."
msgstr "Un favore del Masticatore potrebbe ricaricare la vecchia chiave."

#. STRINGS.GOATMUM_TALK_GREETING.5
msgctxt "STRINGS.GOATMUM_TALK_GREETING.5"
msgid "You must cook, or you will perish."
msgstr "Devi cucinare, o perirai."

#. STRINGS.GOATMUM_TALK_GREETING.6
msgctxt "STRINGS.GOATMUM_TALK_GREETING.6"
msgid "Your presence here distracts it from Billy and I."
msgstr "La tua presenza lo distrae da me e Billy."

#. STRINGS.GOATMUM_TALK_GREETING.7
msgctxt "STRINGS.GOATMUM_TALK_GREETING.7"
msgid "Are you... Gatekeepers, by chance?"
msgstr "Siete… guardiani per caso?"

#. STRINGS.GOATMUM_TALK_GREETING_URGENT.1
msgctxt "STRINGS.GOATMUM_TALK_GREETING_URGENT.1"
msgid "Hurry, please!"
msgstr "Sbrigatevi, per favore!"

#. STRINGS.GOATMUM_TALK_GREETING_URGENT.2
msgctxt "STRINGS.GOATMUM_TALK_GREETING_URGENT.2"
msgid "The Gnaw is growing impatient!"
msgstr "Il Masticatore sta diventando impaziente."

#. STRINGS.GOATMUM_TALK_GREETING_URGENT.3
msgctxt "STRINGS.GOATMUM_TALK_GREETING_URGENT.3"
msgid "It must be fed, at all costs."
msgstr "Deve essere nutrito ad ogni costo."

#. STRINGS.GOATMUM_TALK_GREETING_URGENT.4
msgctxt "STRINGS.GOATMUM_TALK_GREETING_URGENT.4"
msgid "The Gnaw's demands know no end."
msgstr "Le richieste del Masticatore non hanno fine."

#. STRINGS.GOATMUM_TALK_GREETING_URGENT.5
msgctxt "STRINGS.GOATMUM_TALK_GREETING_URGENT.5"
msgid "I believe in you. You can do this."
msgstr "Credo in te. Ce la puoi fare."

#. STRINGS.GOATMUM_TALK_GREETING_URGENT.6
msgctxt "STRINGS.GOATMUM_TALK_GREETING_URGENT.6"
msgid "Don't give up."
msgstr "Non arrenderti."

#. STRINGS.GOATMUM_TALK_GREETING_URGENT.7
msgctxt "STRINGS.GOATMUM_TALK_GREETING_URGENT.7"
msgid "The Gnaw will cast down its plague if not fed!"
msgstr "Il Masticatore lancerà la sua piaga se non viene nutrito!"

#. STRINGS.GOATMUM_TALK_START_BECKON.1
msgctxt "STRINGS.GOATMUM_TALK_START_BECKON.1"
msgid "Come a little closer."
msgstr "Vieni un po' più vicino."

#. STRINGS.GOATMUM_TALK_START_BECKON.2
msgctxt "STRINGS.GOATMUM_TALK_START_BECKON.2"
msgid "Yoo-hoo, over here! Baa."
msgstr "Iuu-huu, laggiù! Bee."

#. STRINGS.GOATMUM_TALK_START_BECKON.3
msgctxt "STRINGS.GOATMUM_TALK_START_BECKON.3"
msgid "Over here, dear!"
msgstr "Da questa parte, caro!"

#. STRINGS.GOATMUM_TALK_START_BECKON.4
msgctxt "STRINGS.GOATMUM_TALK_START_BECKON.4"
msgid "Wait! You need cookware!"
msgstr "Aspetta! Hai bisogno degli utensili da cucina!"

#. STRINGS.GOATMUM_TALK_START_BECKON.5
msgctxt "STRINGS.GOATMUM_TALK_START_BECKON.5"
msgid "My dear, come closer."
msgstr "Mio caro, avvicinati."

#. STRINGS.GOATMUM_TALK_START_BECKON.6
msgctxt "STRINGS.GOATMUM_TALK_START_BECKON.6"
msgid "There's no time to waste!"
msgstr "Non c'è tempo da perdere!"

#. STRINGS.GOATMUM_TALK_START_BECKON.7
msgctxt "STRINGS.GOATMUM_TALK_START_BECKON.7"
msgid "Where are you going?"
msgstr "Dove stai andando?"

#. STRINGS.GOATMUM_TALK_START_CHOICE.1
msgctxt "STRINGS.GOATMUM_TALK_START_CHOICE.1"
msgid "You'll need one of my cookware kits."
msgstr "Avrai bisogno dei miei utensili da cucina."

#. STRINGS.GOATMUM_TALK_START_CHOICE.2
msgctxt "STRINGS.GOATMUM_TALK_START_CHOICE.2"
msgid "Baa. Let's trade."
msgstr "Bee. Facciamo uno scambio."

#. STRINGS.GOATMUM_TALK_START_CHOICE.3
msgctxt "STRINGS.GOATMUM_TALK_START_CHOICE.3"
msgid "I have some spare cookware for trade."
msgstr "Ho degli utensili da cucina da vendere."

#. STRINGS.GOATMUM_TALK_START_CHOICE.4
msgctxt "STRINGS.GOATMUM_TALK_START_CHOICE.4"
msgid "Would you like a pot, an oven or a grill?"
msgstr "Vuoi una pentola, un forno o una griglia?"

#. STRINGS.GOATMUM_TALK_START_CHOICE.5
msgctxt "STRINGS.GOATMUM_TALK_START_CHOICE.5"
msgid "Use those coins to trade with me, okay?"
msgstr "Usa quelle monete per fare scambi con me, va bene?"

#. STRINGS.GOATMUM_TALK_START_CHOICE.6
msgctxt "STRINGS.GOATMUM_TALK_START_CHOICE.6"
msgid "Let's trade. I'll get you set up."
msgstr "Iniziamo lo scambio. Ti metterò in condizione di farlo."

#. STRINGS.GOATMUM_TALK_START_CHOICE.7
msgctxt "STRINGS.GOATMUM_TALK_START_CHOICE.7"
msgid "I hope you're good in the kitchen, dear."
msgstr "Spero tu sia bravo in cucina, caro."

#. STRINGS.GOATMUM_TALK_START_PURCHASE.1
msgctxt "STRINGS.GOATMUM_TALK_START_PURCHASE.1"
msgid "Wonderful choice, baa! Now, let's see..."
msgstr "Ottima scelta, bee! Adesso vediamo..."

#. STRINGS.GOATMUM_TALK_TRADE.1
msgctxt "STRINGS.GOATMUM_TALK_TRADE.1"
msgid "Thank-you, dear."
msgstr "Grazie, caro."

#. STRINGS.GOATMUM_TALK_TRADE.2
msgctxt "STRINGS.GOATMUM_TALK_TRADE.2"
msgid "I hope it helps."
msgstr "Spero sia d'aiuto."

#. STRINGS.GOATMUM_TALK_TRADE.3
msgctxt "STRINGS.GOATMUM_TALK_TRADE.3"
msgid "You're welcome, baa."
msgstr "Non c'è di che, bee."

#. STRINGS.GOATMUM_TALK_TRADE.4
msgctxt "STRINGS.GOATMUM_TALK_TRADE.4"
msgid "Good luck, dear."
msgstr "Buona fortuna, caro."

#. STRINGS.GOATMUM_TALK_TRADE.5
msgctxt "STRINGS.GOATMUM_TALK_TRADE.5"
msgid "Take care, baa."
msgstr "Abbia cura di te, bee."

#. STRINGS.GOATMUM_TALK_TRADE.6
msgctxt "STRINGS.GOATMUM_TALK_TRADE.6"
msgid "Thank-you."
msgstr "Grazie."

#. STRINGS.GOATMUM_TALK_TRADE.7
msgctxt "STRINGS.GOATMUM_TALK_TRADE.7"
msgid "Anything you need, dear."
msgstr "Qualsiasi cosa di cui tu abbia bisogno, caro."

#. STRINGS.GOATMUM_VICTORY.1
msgctxt "STRINGS.GOATMUM_VICTORY.1"
msgid "Baa! The way is open!"
msgstr "Bee! La via è aperta!"

#. STRINGS.GOATMUM_VICTORY.2
msgctxt "STRINGS.GOATMUM_VICTORY.2"
msgid "Quickly, make haste to your world."
msgstr "Presto, metti fretta al tuo mondo."

#. STRINGS.GOATMUM_VICTORY.3
msgctxt "STRINGS.GOATMUM_VICTORY.3"
msgid "Billy and I'll follow soon behind."
msgstr "Io e Billy ti seguiremo."

#. STRINGS.GOATMUM_VICTORY.4
msgctxt "STRINGS.GOATMUM_VICTORY.4"
msgid "May we all leave this plague behind us."
msgstr "Lasciamoci questa piaga alle spalle."

#. STRINGS.GOATMUM_VICTORY.5
msgctxt "STRINGS.GOATMUM_VICTORY.5"
msgid "Good luck, kind strangers!"
msgstr "Buona fortuna, gentili stranieri!"

#. STRINGS.GOATMUM_WELCOME_INTRO.1
msgctxt "STRINGS.GOATMUM_WELCOME_INTRO.1"
msgid "BAAA! Who are you?"
msgstr "BEEE! Tu chi sei?"

#. STRINGS.GOATMUM_WELCOME_INTRO.2
msgctxt "STRINGS.GOATMUM_WELCOME_INTRO.2"
msgid "No, there's no time for pleasantries!"
msgstr "No, non c'è tempo per i convenevoli!"

#. STRINGS.GOATMUM_WELCOME_INTRO.3
msgctxt "STRINGS.GOATMUM_WELCOME_INTRO.3"
msgid "You've got to get cooking, or you'll anger the beast!"
msgstr "Devi cucinare, o farai arrabbiare la bestia!"

#. STRINGS.GOATMUM_WELCOME_INTRO.4
msgctxt "STRINGS.GOATMUM_WELCOME_INTRO.4"
msgid "I'll help how I can."
msgstr "Aiuterò come posso."

#. STRINGS.GOATMUM_WELCOME_INTRO.5
msgctxt "STRINGS.GOATMUM_WELCOME_INTRO.5"
msgid "Take these coins and see me when you're ready."
msgstr "Prendi queste monete e vieni da me quando sei pronto."

#. STRINGS.GREENAMULET_TOOLTIP
msgctxt "STRINGS.GREENAMULET_TOOLTIP"
msgid "Reduced Material Cost"
msgstr "Costo del materiale ridotto"

#. STRINGS.HECKLERS_OFF_SCRIPT.1
msgctxt "STRINGS.HECKLERS_OFF_SCRIPT.1"
msgid "You're going off script!"
msgstr "Stai uscendo dal personaggio!"

#. STRINGS.HECKLERS_OFF_SCRIPT.2
msgctxt "STRINGS.HECKLERS_OFF_SCRIPT.2"
msgid "Off script! Off script!"
msgstr "Sbagliato! Sbagliato!"

#. STRINGS.HECKLERS_OFF_SCRIPT.3
msgctxt "STRINGS.HECKLERS_OFF_SCRIPT.3"
msgid "It's all gone wrong!"
msgstr "È tutto sbagliato!"

#. STRINGS.HECKLERS_YOTH.SHRINE_ARRIVE.1
msgctxt "STRINGS.HECKLERS_YOTH.SHRINE_ARRIVE.1"
msgid "Here we go!"
msgstr "Ci siamo!"

#. STRINGS.HECKLERS_YOTH.SHRINE_ARRIVE.2
msgctxt "STRINGS.HECKLERS_YOTH.SHRINE_ARRIVE.2"
msgid "Were you all just waiting for me?"
msgstr "Mi stavate tutti aspettando?"

#. STRINGS.HECKLERS_YOTH.SHRINE_ARRIVE.3
msgctxt "STRINGS.HECKLERS_YOTH.SHRINE_ARRIVE.3"
msgid "Hiya, chump!"
msgstr "Salve, testa di legno!"

#. STRINGS.HECKLERS_YOTH.SHRINE_BURN.1
msgctxt "STRINGS.HECKLERS_YOTH.SHRINE_BURN.1"
msgid "Bunch of ashes!"
msgstr "Un mucchietto di cenere!"

#. STRINGS.HECKLERS_YOTH.SHRINE_GIVE_PLAYBILL.1
msgctxt "STRINGS.HECKLERS_YOTH.SHRINE_GIVE_PLAYBILL.1"
msgid "Here's my bill!"
msgstr "Ecco la mia locandina!"

#. STRINGS.HECKLERS_YOTH.SHRINE_HIT.1
msgctxt "STRINGS.HECKLERS_YOTH.SHRINE_HIT.1"
msgid "Was it something I said? HA HA HA HA!"
msgstr "È per qualcosa che ho detto? AH AH AH AH!"

#. STRINGS.HECKLERS_YOTH.SHRINE_IDLE.1
msgctxt "STRINGS.HECKLERS_YOTH.SHRINE_IDLE.1"
msgid "Do something already!"
msgstr "Avanti, fa' qualcosa!"

#. STRINGS.HECKLERS_YOTH.SHRINE_IDLE.2
msgctxt "STRINGS.HECKLERS_YOTH.SHRINE_IDLE.2"
msgid "What now?"
msgstr "Che vuoi?"

#. STRINGS.HECKLERS_YOTH.SHRINE_IDLE.3
msgctxt "STRINGS.HECKLERS_YOTH.SHRINE_IDLE.3"
msgid "Whatdya got?"
msgstr "Che hai lì?"

#. STRINGS.HECKLERS_YOTH.SHRINE_LEAVE.1
msgctxt "STRINGS.HECKLERS_YOTH.SHRINE_LEAVE.1"
msgid "Boring!"
msgstr "Noioso!"

#. STRINGS.HECKLERS_YOTH.SHRINE_LEAVE_PLAY.1
msgctxt "STRINGS.HECKLERS_YOTH.SHRINE_LEAVE_PLAY.1"
msgid "That's my cue!"
msgstr "È il mio momento!"

#. STRINGS.HECKLERS_YOTH.SHRINE_USE.1
msgctxt "STRINGS.HECKLERS_YOTH.SHRINE_USE.1"
msgid "There's a sucker born every minute!"
msgstr "Il mondo è pieno di babbei!"

#. STRINGS.HECKLERS_YOTH.SHRINE_USE.2
msgctxt "STRINGS.HECKLERS_YOTH.SHRINE_USE.2"
msgid "Hope it was worth it!"
msgstr "Spero ne sia valsa la pena!"

#. STRINGS.HERMITCRAB_ANNOUNCE_ADDED_RELOCATION_KIT.HIGH.1
msgctxt "STRINGS.HERMITCRAB_ANNOUNCE_ADDED_RELOCATION_KIT.HIGH.1"
msgid "Oh dear, that junk collector tricked us with a bad map."
msgstr "Accidenti, quel collezionista di rottami ci ha rifilato una mappa sbagliata."

#. STRINGS.HERMITCRAB_ANNOUNCE_ADDED_RELOCATION_KIT.HIGH.2
msgctxt "STRINGS.HERMITCRAB_ANNOUNCE_ADDED_RELOCATION_KIT.HIGH.2"
msgid "Please help me find a better home?"
msgstr "Mi aiuteresti a trovare una casa migliore?"

#. STRINGS.HERMITCRAB_ANNOUNCE_ADDED_RELOCATION_KIT.HIGH.3
msgctxt "STRINGS.HERMITCRAB_ANNOUNCE_ADDED_RELOCATION_KIT.HIGH.3"
msgid "I've got a little something that might help you help me!"
msgstr "Ho qualcosa che potrebbe aiutarti ad aiutarmi!"

#. STRINGS.HERMITCRAB_ANNOUNCE_ADDED_RELOCATION_KIT.LOW.1
msgctxt "STRINGS.HERMITCRAB_ANNOUNCE_ADDED_RELOCATION_KIT.LOW.1"
msgid "Hmph! You tricked me! This island is the worst!"
msgstr "Umpf! Mi hai ingannata! Quest'isola è orribile!"

#. STRINGS.HERMITCRAB_ANNOUNCE_ADDED_RELOCATION_KIT.LOW.2
msgctxt "STRINGS.HERMITCRAB_ANNOUNCE_ADDED_RELOCATION_KIT.LOW.2"
msgid "You'd better fix this..."
msgstr "Vedi di rimediare..."

#. STRINGS.HERMITCRAB_ANNOUNCE_ADDED_RELOCATION_KIT.LOW.3
msgctxt "STRINGS.HERMITCRAB_ANNOUNCE_ADDED_RELOCATION_KIT.LOW.3"
msgid "...or you're no better than that junk collector!"
msgstr "... altrimenti non sei meglio di quel collezionista di rottami!"

#. STRINGS.HERMITCRAB_ANNOUNCE_ADDED_RELOCATION_KIT.LOW.4
msgctxt "STRINGS.HERMITCRAB_ANNOUNCE_ADDED_RELOCATION_KIT.LOW.4"
msgid "I've got something you can use - if you actually plan on helping me."
msgstr "Ho qualcosa che puoi usare, se hai davvero intenzione di aiutarmi."

#. STRINGS.HERMITCRAB_ANNOUNCE_ADDED_RELOCATION_KIT.MED.1
msgctxt "STRINGS.HERMITCRAB_ANNOUNCE_ADDED_RELOCATION_KIT.MED.1"
msgid "Ack! That map was no good."
msgstr "Bah! Quella mappa non andava per niente bene."

#. STRINGS.HERMITCRAB_ANNOUNCE_ADDED_RELOCATION_KIT.MED.2
msgctxt "STRINGS.HERMITCRAB_ANNOUNCE_ADDED_RELOCATION_KIT.MED.2"
msgid "Maybe that junk collector tricked you too."
msgstr "Forse quel collezionista di rottami ha ingannato anche te."

#. STRINGS.HERMITCRAB_ANNOUNCE_ADDED_RELOCATION_KIT.MED.3
msgctxt "STRINGS.HERMITCRAB_ANNOUNCE_ADDED_RELOCATION_KIT.MED.3"
msgid "I need a better place to live."
msgstr "Ho bisogno di un posto migliore dove vivere."

#. STRINGS.HERMITCRAB_ANNOUNCE_ADDED_RELOCATION_KIT.MED.4
msgctxt "STRINGS.HERMITCRAB_ANNOUNCE_ADDED_RELOCATION_KIT.MED.4"
msgid "I have something you can use to help me."
msgstr "Ho qualcosa che puoi usare per aiutarmi."

#. STRINGS.HERMITCRAB_ANNOUNCE_GOING_TEASHOP.1
msgctxt "STRINGS.HERMITCRAB_ANNOUNCE_GOING_TEASHOP.1"
msgid "Hold your seahorses, dearie!"
msgstr "Calma, tesoro!"

#. STRINGS.HERMITCRAB_ANNOUNCE_GOING_TEASHOP.2
msgctxt "STRINGS.HERMITCRAB_ANNOUNCE_GOING_TEASHOP.2"
msgid "I'll be there in just a minute."
msgstr "Un minutino e arrivo."

#. STRINGS.HERMITCRAB_ANNOUNCE_GOING_TEASHOP.3
msgctxt "STRINGS.HERMITCRAB_ANNOUNCE_GOING_TEASHOP.3"
msgid "Patience, dearie. On my way."
msgstr "Pazienta, tesoro. Ora vengo."

#. STRINGS.HERMITCRAB_ANNOUNCE_LEFT_TEASHOP.1
msgctxt "STRINGS.HERMITCRAB_ANNOUNCE_LEFT_TEASHOP.1"
msgid "Tell your friends to come by, dearie!"
msgstr "Parla di me ai tuoi amichetti, tesoro!"

#. STRINGS.HERMITCRAB_ANNOUNCE_LEFT_TEASHOP.2
msgctxt "STRINGS.HERMITCRAB_ANNOUNCE_LEFT_TEASHOP.2"
msgid "Thank you for visiting!"
msgstr "Grazie per la visita!"

#. STRINGS.HERMITCRAB_ANNOUNCE_LEFT_TEASHOP.3
msgctxt "STRINGS.HERMITCRAB_ANNOUNCE_LEFT_TEASHOP.3"
msgid "Come back soon, dearie!"
msgstr "Torna presto, tesoro!"

#. STRINGS.HERMITCRAB_ANNOUNCE_OCEANFISHING_BADCAST.1
msgctxt "STRINGS.HERMITCRAB_ANNOUNCE_OCEANFISHING_BADCAST.1"
msgid "I'm not quite as good at this as I used to be..."
msgstr "Una volta mi riusciva meglio..."

#. STRINGS.HERMITCRAB_ANNOUNCE_OCEANFISHING_BOTHERED.HIGH.1
msgctxt "STRINGS.HERMITCRAB_ANNOUNCE_OCEANFISHING_BOTHERED.HIGH.1"
msgid "I can always make time for you, dearie."
msgstr "Posso sempre ritagliare un po' di tempo per te, tesoro."

#. STRINGS.HERMITCRAB_ANNOUNCE_OCEANFISHING_BOTHERED.LOW.1
msgctxt "STRINGS.HERMITCRAB_ANNOUNCE_OCEANFISHING_BOTHERED.LOW.1"
msgid "Ack! You made me lose my fish!"
msgstr "Argh! Mi hai fatto perdere il pesce!"

#. STRINGS.HERMITCRAB_ANNOUNCE_OCEANFISHING_BOTHERED.MED.1
msgctxt "STRINGS.HERMITCRAB_ANNOUNCE_OCEANFISHING_BOTHERED.MED.1"
msgid "You couldn't wait for a better time?"
msgstr "Non potevi aspettare un momento migliore?"

#. STRINGS.HERMITCRAB_ANNOUNCE_OCEANFISHING_GOTAWAY.1
msgctxt "STRINGS.HERMITCRAB_ANNOUNCE_OCEANFISHING_GOTAWAY.1"
msgid "Why you slippery little nincompoop!"
msgstr "Piccolo sfacciatello sgusciante!"

#. STRINGS.HERMITCRAB_ANNOUNCE_OCEANFISHING_GOTAWAY.2
msgctxt "STRINGS.HERMITCRAB_ANNOUNCE_OCEANFISHING_GOTAWAY.2"
msgid "Get back on my hook!"
msgstr "Torna sul mio amo!"

#. STRINGS.HERMITCRAB_ANNOUNCE_OCEANFISHING_IDLE_QUOTE.1
msgctxt "STRINGS.HERMITCRAB_ANNOUNCE_OCEANFISHING_IDLE_QUOTE.1"
msgid "Hmph. The fish aren't biting today..."
msgstr "Uhm. Oggi i pesci non abboccano..."

#. STRINGS.HERMITCRAB_ANNOUNCE_OCEANFISHING_IDLE_QUOTE.2
msgctxt "STRINGS.HERMITCRAB_ANNOUNCE_OCEANFISHING_IDLE_QUOTE.2"
msgid "Don't be so fussy, get on my hook!"
msgstr "Non fare lo schizzinoso, abbocca al mio amo!"

#. STRINGS.HERMITCRAB_ANNOUNCE_OCEANFISHING_IDLE_QUOTE.3
msgctxt "STRINGS.HERMITCRAB_ANNOUNCE_OCEANFISHING_IDLE_QUOTE.3"
msgid "\"I often look from the highest hill, that I might see my boatman...\""
msgstr "\"Ma che bello andare a pesca, con la lenza, l'amo e l'esca...\""

#. STRINGS.HERMITCRAB_ANNOUNCE_OCEANFISHING_IDLE_QUOTE.4
msgctxt "STRINGS.HERMITCRAB_ANNOUNCE_OCEANFISHING_IDLE_QUOTE.4"
msgid "Hmm-de-dmm..."
msgstr "Dan-da-dan..."

#. STRINGS.HERMITCRAB_ANNOUNCE_OCEANFISHING_IDLE_QUOTE.5
msgctxt "STRINGS.HERMITCRAB_ANNOUNCE_OCEANFISHING_IDLE_QUOTE.5"
msgid "Never seem to catch anything..."
msgstr "Non sto pescando niente..."

#. STRINGS.HERMITCRAB_ANNOUNCE_OCEANFISHING_LINESNAP.1
msgctxt "STRINGS.HERMITCRAB_ANNOUNCE_OCEANFISHING_LINESNAP.1"
msgid "Ack! Stupid thing!"
msgstr "Argh! stupida creaturina!"

#. STRINGS.HERMITCRAB_ANNOUNCE_OCEANFISHING_LINETOOLOOSE.1
msgctxt "STRINGS.HERMITCRAB_ANNOUNCE_OCEANFISHING_LINETOOLOOSE.1"
msgid "Oooh, these tired old claws!"
msgstr "Oooh, le mie pinze sono stanche!"

#. STRINGS.HERMITCRAB_ANNOUNCE_ROYALTY.1
msgctxt "STRINGS.HERMITCRAB_ANNOUNCE_ROYALTY.1"
msgid "Well, don't you look all high and mighty."
msgstr "Ma guardati, hai un aspetto altezzoso e arrogante."

#. STRINGS.HERMITCRAB_ANNOUNCE_ROYALTY.2
msgctxt "STRINGS.HERMITCRAB_ANNOUNCE_ROYALTY.2"
msgid "I didn't realize I was in the presence of \"royalty\"."
msgstr "Non avevo capito che avevo davanti un membro della famiglia reale."

#. STRINGS.HERMITCRAB_ANNOUNCE_ROYALTY.3
msgctxt "STRINGS.HERMITCRAB_ANNOUNCE_ROYALTY.3"
msgid "It takes more than a hoity-toity hat to impress me."
msgstr "Un cappello snob non basta per sorprendermi."

#. STRINGS.HERMITCRAB_ANNOUNCE_SPOOKED
msgctxt "STRINGS.HERMITCRAB_ANNOUNCE_SPOOKED"
msgid "Did you see that?!"
msgstr "Hai visto?!"

#. STRINGS.HERMITCRAB_ANNOUNCE_TOOL_SLIP
msgctxt "STRINGS.HERMITCRAB_ANNOUNCE_TOOL_SLIP"
msgid "Wow, that tool is slippery!"
msgstr "Wow, quello strumento è scivoloso!"

#. STRINGS.HERMITCRAB_ATTEMPT_TRADE.HIGH.1
msgctxt "STRINGS.HERMITCRAB_ATTEMPT_TRADE.HIGH.1"
msgid "My favorite customer!"
msgstr "Uno dei miei clienti preferiti!"

#. STRINGS.HERMITCRAB_ATTEMPT_TRADE.HIGH.2
msgctxt "STRINGS.HERMITCRAB_ATTEMPT_TRADE.HIGH.2"
msgid "What do you need today, dearie?"
msgstr "Di che cosa hai bisogno, oggi, tesoro?"

#. STRINGS.HERMITCRAB_ATTEMPT_TRADE.LOW.1
msgctxt "STRINGS.HERMITCRAB_ATTEMPT_TRADE.LOW.1"
msgid "Don't talk to me if you have nothing to trade."
msgstr "Non rivolgermi la parola se non vuoi comprare niente."

#. STRINGS.HERMITCRAB_ATTEMPT_TRADE.MED.1
msgctxt "STRINGS.HERMITCRAB_ATTEMPT_TRADE.MED.1"
msgid "Have anything to trade today?"
msgstr "Vuoi comprare qualcosa, oggi?"

#. STRINGS.HERMITCRAB_COMPLAIN.FILL_MEATRACKS.HIGH.1
msgctxt "STRINGS.HERMITCRAB_COMPLAIN.FILL_MEATRACKS.HIGH.1"
msgid "Could you dry some meat for me, dearie?"
msgstr "Potresti farmi essiccare della carne, tesoro?"

#. STRINGS.HERMITCRAB_COMPLAIN.FILL_MEATRACKS.LOW.1
msgctxt "STRINGS.HERMITCRAB_COMPLAIN.FILL_MEATRACKS.LOW.1"
msgid "Hmph... never any meat around here for drying..."
msgstr "Uhm... Da queste parti non si trova mai carne da essiccare..."

#. STRINGS.HERMITCRAB_COMPLAIN.FILL_MEATRACKS.MED.1
msgctxt "STRINGS.HERMITCRAB_COMPLAIN.FILL_MEATRACKS.MED.1"
msgid "My drying racks are empty again?"
msgstr "Il mio essiccatore è tornato a essere vuoto?"

#. STRINGS.HERMITCRAB_COMPLAIN.FILL_MEATRACKS.MED.2
msgctxt "STRINGS.HERMITCRAB_COMPLAIN.FILL_MEATRACKS.MED.2"
msgid "So much work for these old claws..."
msgstr "Troppo lavoro per queste vecchie chele..."

#. STRINGS.HERMITCRAB_COMPLAIN.GIVE_FISH_AUTUM.HIGH.1
msgctxt "STRINGS.HERMITCRAB_COMPLAIN.GIVE_FISH_AUTUM.HIGH.1"
msgid "Would you bring me a Fallounder, dearie?"
msgstr "Potresti portarmi un autunnino, tesoro?"

#. STRINGS.HERMITCRAB_COMPLAIN.GIVE_FISH_AUTUM.LOW.1
msgctxt "STRINGS.HERMITCRAB_COMPLAIN.GIVE_FISH_AUTUM.LOW.1"
msgid "I think Fallounders are in season."
msgstr "Ormai è stagione degli autunnini, se non sbaglio."

#. STRINGS.HERMITCRAB_COMPLAIN.GIVE_FISH_AUTUM.MED.1
msgctxt "STRINGS.HERMITCRAB_COMPLAIN.GIVE_FISH_AUTUM.MED.1"
msgid "Nothing says autumn like some tasty Fallounder..."
msgstr "Non c'è nulla di più autunnale di un buon autunnino..."

#. STRINGS.HERMITCRAB_COMPLAIN.GIVE_FISH_SPRING.HIGH.1
msgctxt "STRINGS.HERMITCRAB_COMPLAIN.GIVE_FISH_SPRING.HIGH.1"
msgid "Let me know if you catch a Bloomfin Tuna, dearie!"
msgstr "Fammi sapere se riesci a prendere un tonno pinna fiorita, tesoro!"

#. STRINGS.HERMITCRAB_COMPLAIN.GIVE_FISH_SPRING.LOW.1
msgctxt "STRINGS.HERMITCRAB_COMPLAIN.GIVE_FISH_SPRING.LOW.1"
msgid "Thought I saw some Bloomfin Tuna yesterday..."
msgstr "Proprio ieri pensavo di aver visto dei tonni pinna fiorita..."

#. STRINGS.HERMITCRAB_COMPLAIN.GIVE_FISH_SPRING.MED.1
msgctxt "STRINGS.HERMITCRAB_COMPLAIN.GIVE_FISH_SPRING.MED.1"
msgid "This weather is perfect for Bloomfin Tuna..."
msgstr "Queste sono le condizioni atmosferiche perfette per il tonno pinna fiorita..."

#. STRINGS.HERMITCRAB_COMPLAIN.GIVE_FISH_SUMMER.HIGH.1
msgctxt "STRINGS.HERMITCRAB_COMPLAIN.GIVE_FISH_SUMMER.HIGH.1"
msgid "I would love a Scorching Sunfish, if you have it."
msgstr "Mi piacerebbe un buon pesce sole rovente, se ce l'hai."

#. STRINGS.HERMITCRAB_COMPLAIN.GIVE_FISH_SUMMER.LOW.1
msgctxt "STRINGS.HERMITCRAB_COMPLAIN.GIVE_FISH_SUMMER.LOW.1"
msgid "The Scorching Sunfish should be migrating now."
msgstr "La migrazione dei pesci sole rovente dovrebbe essere già iniziata."

#. STRINGS.HERMITCRAB_COMPLAIN.GIVE_FISH_SUMMER.MED.1
msgctxt "STRINGS.HERMITCRAB_COMPLAIN.GIVE_FISH_SUMMER.MED.1"
msgid "Nothing says summer like some Scorching Sunfish..."
msgstr "Non c'è niente di più estivo di un buon pesce sole rovente..."

#. STRINGS.HERMITCRAB_COMPLAIN.GIVE_FISH_WINTER.HIGH.1
msgctxt "STRINGS.HERMITCRAB_COMPLAIN.GIVE_FISH_WINTER.HIGH.1"
msgid "Dearie, could you catch an Ice Bream for me?"
msgstr "Tesoro, potresti prendermi un buon pagello gelato?"

#. STRINGS.HERMITCRAB_COMPLAIN.GIVE_FISH_WINTER.LOW.1
msgctxt "STRINGS.HERMITCRAB_COMPLAIN.GIVE_FISH_WINTER.LOW.1"
msgid "Hmph. Should be Ice Bream season right about now."
msgstr "Uhm. La stagione dei pagelli gelato dovrebbe già essere cominciata."

#. STRINGS.HERMITCRAB_COMPLAIN.GIVE_FISH_WINTER.MED.1
msgctxt "STRINGS.HERMITCRAB_COMPLAIN.GIVE_FISH_WINTER.MED.1"
msgid "I used to catch Ice Bream all through the winter..."
msgstr "Un tempo riuscivo a pescare pagelli gelato per tutto l'inverno..."

#. STRINGS.HERMITCRAB_COMPLAIN.GIVE_FLOWER_SALAD.HIGH.1
msgctxt "STRINGS.HERMITCRAB_COMPLAIN.GIVE_FLOWER_SALAD.HIGH.1"
msgid "Flower salad brings back such memories..."
msgstr "L'insalata di fiori mi riporta alla memoria ricordi tanto belli..."

#. STRINGS.HERMITCRAB_COMPLAIN.GIVE_FLOWER_SALAD.HIGH.2
msgctxt "STRINGS.HERMITCRAB_COMPLAIN.GIVE_FLOWER_SALAD.HIGH.2"
msgid "Could you make some for me?"
msgstr "Potresti prepararmene una?"

#. STRINGS.HERMITCRAB_COMPLAIN.GIVE_FLOWER_SALAD.LOW.1
msgctxt "STRINGS.HERMITCRAB_COMPLAIN.GIVE_FLOWER_SALAD.LOW.1"
msgid "Hmph. No ingredients for flower salad around..."
msgstr "Uhm. Qui attorno non ci sono gli ingredienti per l'insalata di fiori..."

#. STRINGS.HERMITCRAB_COMPLAIN.GIVE_FLOWER_SALAD.MED.1
msgctxt "STRINGS.HERMITCRAB_COMPLAIN.GIVE_FLOWER_SALAD.MED.1"
msgid "My sweetie used to make my favorite... flower salad..."
msgstr "Il mio tesoro mi preparava sempre la mia preferita... L'insalata di fiori..."

#. STRINGS.HERMITCRAB_COMPLAIN.GIVE_HEAVY_FISH.HIGH.1
msgctxt "STRINGS.HERMITCRAB_COMPLAIN.GIVE_HEAVY_FISH.HIGH.1"
msgid "If you could bring me some big fish..."
msgstr "Se potessi portarmi dei bei pescioni..."

#. STRINGS.HERMITCRAB_COMPLAIN.GIVE_HEAVY_FISH.HIGH.2
msgctxt "STRINGS.HERMITCRAB_COMPLAIN.GIVE_HEAVY_FISH.HIGH.2"
msgid "I'd be so happy!"
msgstr "Ne sarei felicissima!"

#. STRINGS.HERMITCRAB_COMPLAIN.GIVE_HEAVY_FISH.LOW.1
msgctxt "STRINGS.HERMITCRAB_COMPLAIN.GIVE_HEAVY_FISH.LOW.1"
msgid "(Grumble)... only ever catch minnows..."
msgstr "(Borbotta)... Prendi sempre e solo saraghi..."

#. STRINGS.HERMITCRAB_COMPLAIN.GIVE_HEAVY_FISH.LOW.2
msgctxt "STRINGS.HERMITCRAB_COMPLAIN.GIVE_HEAVY_FISH.LOW.2"
msgid "Never a nice big fish..."
msgstr "Mai un bel pesce grosso..."

#. STRINGS.HERMITCRAB_COMPLAIN.GIVE_HEAVY_FISH.MED.1
msgctxt "STRINGS.HERMITCRAB_COMPLAIN.GIVE_HEAVY_FISH.MED.1"
msgid "If only SOMEONE could bring me some big, juicy fish..."
msgstr "Se QUALCUNO potesse portarmi un bel pescione succulento..."

#. STRINGS.HERMITCRAB_COMPLAIN.GIVE_PUFFY_VEST.HIGH.1
msgctxt "STRINGS.HERMITCRAB_COMPLAIN.GIVE_PUFFY_VEST.HIGH.1"
msgid "Ooooh, I do wish I had something warm to wear."
msgstr "Ooooh, mi piacerebbe avere qualcosa di caldo da indossare."

#. STRINGS.HERMITCRAB_COMPLAIN.GIVE_PUFFY_VEST.LOW.1
msgctxt "STRINGS.HERMITCRAB_COMPLAIN.GIVE_PUFFY_VEST.LOW.1"
msgid "(Grumble) It's freezing out here!"
msgstr "(Borbotta) Qui fuori si gela!"

#. STRINGS.HERMITCRAB_COMPLAIN.GIVE_PUFFY_VEST.MED.1
msgctxt "STRINGS.HERMITCRAB_COMPLAIN.GIVE_PUFFY_VEST.MED.1"
msgid "Brrr, this cold weather is terrible for my rheumatism."
msgstr "Brrr, questo freddo è inclemente con i miei reumatismi."

#. STRINGS.HERMITCRAB_COMPLAIN.GIVE_UMBRELLA.HIGH.1
msgctxt "STRINGS.HERMITCRAB_COMPLAIN.GIVE_UMBRELLA.HIGH.1"
msgid "What terrible weather."
msgstr "Che tempo da lupi."

#. STRINGS.HERMITCRAB_COMPLAIN.GIVE_UMBRELLA.HIGH.2
msgctxt "STRINGS.HERMITCRAB_COMPLAIN.GIVE_UMBRELLA.HIGH.2"
msgid "Do you have an umbrella, dearie?"
msgstr "Hai un ombrello, tesoro?"

#. STRINGS.HERMITCRAB_COMPLAIN.GIVE_UMBRELLA.LOW.1
msgctxt "STRINGS.HERMITCRAB_COMPLAIN.GIVE_UMBRELLA.LOW.1"
msgid "Miserable rain..."
msgstr "Pioggia incessante..."

#. STRINGS.HERMITCRAB_COMPLAIN.GIVE_UMBRELLA.LOW.2
msgctxt "STRINGS.HERMITCRAB_COMPLAIN.GIVE_UMBRELLA.LOW.2"
msgid "I'll catch my death..."
msgstr "Ci lascerò le chele..."

#. STRINGS.HERMITCRAB_COMPLAIN.GIVE_UMBRELLA.MED.1
msgctxt "STRINGS.HERMITCRAB_COMPLAIN.GIVE_UMBRELLA.MED.1"
msgid "I'm getting soaked to the chitin!"
msgstr "Sono zuppa fino alla chitina!"

#. STRINGS.HERMITCRAB_COMPLAIN.GIVE_UMBRELLA.MED.2
msgctxt "STRINGS.HERMITCRAB_COMPLAIN.GIVE_UMBRELLA.MED.2"
msgid "If only I had an umbrella..."
msgstr "Se solo avessi un ombrello..."

#. STRINGS.HERMITCRAB_COMPLAIN.MAKE_CHAIR.HIGH.1
msgctxt "STRINGS.HERMITCRAB_COMPLAIN.MAKE_CHAIR.HIGH.1"
msgid "What this place really needs is a nice place to sit and chat."
msgstr "Ciò di cui questo posto ha davvero bisogno, è un bell'angolo dove sedersi e chiacchierare."

#. STRINGS.HERMITCRAB_COMPLAIN.MAKE_CHAIR.LOW.1
msgctxt "STRINGS.HERMITCRAB_COMPLAIN.MAKE_CHAIR.LOW.1"
msgid "(Grumble) my shell is killing me..."
msgstr "(Borbotta) Questo guscio mi uccide..."

#. STRINGS.HERMITCRAB_COMPLAIN.MAKE_CHAIR.LOW.2
msgctxt "STRINGS.HERMITCRAB_COMPLAIN.MAKE_CHAIR.LOW.2"
msgid "Nowhere to sit around here..."
msgstr "Non ci sono posti per sedersi qui attorno..."

#. STRINGS.HERMITCRAB_COMPLAIN.MAKE_CHAIR.MED.1
msgctxt "STRINGS.HERMITCRAB_COMPLAIN.MAKE_CHAIR.MED.1"
msgid "There's nowhere to sit and rest this old chitin..."
msgstr "Non ci sono posti per sedersi e far riposare questa vecchia e stanca chitina..."

#. STRINGS.HERMITCRAB_COMPLAIN.PLANT_BERRIES.HIGH.1
msgctxt "STRINGS.HERMITCRAB_COMPLAIN.PLANT_BERRIES.HIGH.1"
msgid "Care to help me with some gardening?"
msgstr "Potresti aiutarmi a fare un po' di giardinaggio?"

#. STRINGS.HERMITCRAB_COMPLAIN.PLANT_BERRIES.HIGH.2
msgctxt "STRINGS.HERMITCRAB_COMPLAIN.PLANT_BERRIES.HIGH.2"
msgid "I need some new berry bushes."
msgstr "Mi servirebbero dei nuovi cespugli di bacche."

#. STRINGS.HERMITCRAB_COMPLAIN.PLANT_BERRIES.LOW.1
msgctxt "STRINGS.HERMITCRAB_COMPLAIN.PLANT_BERRIES.LOW.1"
msgid "All of my berry bushes died."
msgstr "Tutti i miei cespugli di bacche sono morti."

#. STRINGS.HERMITCRAB_COMPLAIN.PLANT_BERRIES.MED.1
msgctxt "STRINGS.HERMITCRAB_COMPLAIN.PLANT_BERRIES.MED.1"
msgid "I miss my garden... I used to grow berries..."
msgstr "Il mio giardino mi manca... Un tempo coltivavo le bacche..."

#. STRINGS.HERMITCRAB_COMPLAIN.PLANT_FLOWERS.HIGH.1
msgctxt "STRINGS.HERMITCRAB_COMPLAIN.PLANT_FLOWERS.HIGH.1"
msgid "Dearie, would you..."
msgstr "Tesoro, potresti..."

#. STRINGS.HERMITCRAB_COMPLAIN.PLANT_FLOWERS.HIGH.2
msgctxt "STRINGS.HERMITCRAB_COMPLAIN.PLANT_FLOWERS.HIGH.2"
msgid "Help me plant some flowers?"
msgstr "Aiutarmi a piantare dei fiori?"

#. STRINGS.HERMITCRAB_COMPLAIN.PLANT_FLOWERS.LOW.1
msgctxt "STRINGS.HERMITCRAB_COMPLAIN.PLANT_FLOWERS.LOW.1"
msgid "Useless lazy bees... not a drop of honey..."
msgstr "Api lazzarone... Nemmeno una goccia di miele..."

#. STRINGS.HERMITCRAB_COMPLAIN.PLANT_FLOWERS.MED.1
msgctxt "STRINGS.HERMITCRAB_COMPLAIN.PLANT_FLOWERS.MED.1"
msgid "When I had my flower garden, the bees made honey all the time."
msgstr "Quando avevo il mio giardino fiorito, le api facevano tonnellate di miele."

#. STRINGS.HERMITCRAB_COMPLAIN.REMOVE_JUNK.HIGH.1
msgctxt "STRINGS.HERMITCRAB_COMPLAIN.REMOVE_JUNK.HIGH.1"
msgid "You look spry! Could you get rid of that junk in the water?"
msgstr "Hai un sacco di energie, si vede! Puoi ripulire l'acqua da tutta quell'immondizia?"

#. STRINGS.HERMITCRAB_COMPLAIN.REMOVE_JUNK.LOW.1
msgctxt "STRINGS.HERMITCRAB_COMPLAIN.REMOVE_JUNK.LOW.1"
msgid "(Grumble)... water's all full of junk..."
msgstr "(Borbotta)... L'acqua è piena di immondizia..."

#. STRINGS.HERMITCRAB_COMPLAIN.REMOVE_JUNK.MED.1
msgctxt "STRINGS.HERMITCRAB_COMPLAIN.REMOVE_JUNK.MED.1"
msgid "The water's so full of junk, I can't even see the fish!"
msgstr "L'acqua è così piena di immondizia che non riesco nemmeno a vedere i pesci!"

#. STRINGS.HERMITCRAB_COMPLAIN.REMOVE_LUREPLANT.HIGH.1
msgctxt "STRINGS.HERMITCRAB_COMPLAIN.REMOVE_LUREPLANT.HIGH.1"
msgid "Would you be a dear?"
msgstr "Saresti così gentile?"

#. STRINGS.HERMITCRAB_COMPLAIN.REMOVE_LUREPLANT.HIGH.2
msgctxt "STRINGS.HERMITCRAB_COMPLAIN.REMOVE_LUREPLANT.HIGH.2"
msgid "Take care of that awful plant for me."
msgstr "Ti occuperesti di quella pianta inguardabile?"

#. STRINGS.HERMITCRAB_COMPLAIN.REMOVE_LUREPLANT.LOW.1
msgctxt "STRINGS.HERMITCRAB_COMPLAIN.REMOVE_LUREPLANT.LOW.1"
msgid "That horrible plant..."
msgstr "Quella pianta orribile..."

#. STRINGS.HERMITCRAB_COMPLAIN.REMOVE_LUREPLANT.LOW.2
msgctxt "STRINGS.HERMITCRAB_COMPLAIN.REMOVE_LUREPLANT.LOW.2"
msgid "Such an eyesore..."
msgstr "È un pugno in un occhio..."

#. STRINGS.HERMITCRAB_COMPLAIN.REMOVE_LUREPLANT.MED.1
msgctxt "STRINGS.HERMITCRAB_COMPLAIN.REMOVE_LUREPLANT.MED.1"
msgid "That lureplant is going to take over my whole yard!"
msgstr "Quella pianta adescatrice si espanderà per tutto il mio giardino!"

#. STRINGS.HERMITCRAB_CRITTER_BANTER.1
msgctxt "STRINGS.HERMITCRAB_CRITTER_BANTER.1"
msgid "Hello, precious little one."
msgstr "Ciao, tesoruccio."

#. STRINGS.HERMITCRAB_CRITTER_BANTER.2
msgctxt "STRINGS.HERMITCRAB_CRITTER_BANTER.2"
msgid "Aren't you the cutest?"
msgstr "Sei proprio adorabile."

#. STRINGS.HERMITCRAB_CRITTER_BANTER.3
msgctxt "STRINGS.HERMITCRAB_CRITTER_BANTER.3"
msgid "You are just the sweetest little thing."
msgstr "Sei un affarino adorabile."

#. STRINGS.HERMITCRAB_CRITTER_BANTER.4
msgctxt "STRINGS.HERMITCRAB_CRITTER_BANTER.4"
msgid "Too cute!"
msgstr "Che amore!"

#. STRINGS.HERMITCRAB_CRITTER_BANTER.5
msgctxt "STRINGS.HERMITCRAB_CRITTER_BANTER.5"
msgid "I'll take good care of you."
msgstr "Mi prenderò io cura di te."

#. STRINGS.HERMITCRAB_CRITTER_BANTER.6
msgctxt "STRINGS.HERMITCRAB_CRITTER_BANTER.6"
msgid "You make me so happy!"
msgstr "Sei la mia gioia!"

#. STRINGS.HERMITCRAB_CRITTER_BANTER.7
msgctxt "STRINGS.HERMITCRAB_CRITTER_BANTER.7"
msgid "Awwww..."
msgstr "Oooh..."

#. STRINGS.HERMITCRAB_CRITTER_FEED.1
msgctxt "STRINGS.HERMITCRAB_CRITTER_FEED.1"
msgid "You must be hungry!"
msgstr "Devi avere fame!"

#. STRINGS.HERMITCRAB_CRITTER_FEED.2
msgctxt "STRINGS.HERMITCRAB_CRITTER_FEED.2"
msgid "Eat up now, precious."
msgstr "Mangia pure, tesoruccio."

#. STRINGS.HERMITCRAB_CRITTER_FEED.3
msgctxt "STRINGS.HERMITCRAB_CRITTER_FEED.3"
msgid "Yummy, isn't it?"
msgstr "Buono, vero?"

#. STRINGS.HERMITCRAB_DECOR_ALL_TROPHY_FISH.1
msgctxt "STRINGS.HERMITCRAB_DECOR_ALL_TROPHY_FISH.1"
msgid "How did you ever manage to catch all of them? Incredible, dearie!"
msgstr "Come hai fatto a prenderli tutti? Straordinario, tesoro!"

#. STRINGS.HERMITCRAB_DECOR_ALL_TROPHY_FISH.2
msgctxt "STRINGS.HERMITCRAB_DECOR_ALL_TROPHY_FISH.2"
msgid "Now I have every fish, dearie! Amazing!"
msgstr "Ora ho ogni tipo di pesce, tesoro! Magnifico!"

#. STRINGS.HERMITCRAB_DECOR_ALL_TROPHY_FISH.3
msgctxt "STRINGS.HERMITCRAB_DECOR_ALL_TROPHY_FISH.3"
msgid "My collection is complete! You're the best, dearie!"
msgstr "La mia collezione è completa! Grazie di cuore, tesoro!"

#. STRINGS.HERMITCRAB_DECOR_ALL_TROPHY_FISH.4
msgctxt "STRINGS.HERMITCRAB_DECOR_ALL_TROPHY_FISH.4"
msgid "What an astounding feat! You've caught them all, dearie!"
msgstr "Che impresa straordinaria! Li hai presi tutti, tesoro!"

#. STRINGS.HERMITCRAB_DECOR_COMPLAIN.BEE_BOXES.LOW.1
msgctxt "STRINGS.HERMITCRAB_DECOR_COMPLAIN.BEE_BOXES.LOW.1"
msgid "My bees need more homes to live in. Will you build them some, dearie?"
msgstr "Alle mie api servono più casette. Puoi costruirne qualcuna, tesoro?"

#. STRINGS.HERMITCRAB_DECOR_COMPLAIN.BEE_BOXES.LOW.2
msgctxt "STRINGS.HERMITCRAB_DECOR_COMPLAIN.BEE_BOXES.LOW.2"
msgid "Dearie, I need more houses for my bees. Please help!"
msgstr "Tesoro, mi servono più casette per le api. Dammi una chela!"

#. STRINGS.HERMITCRAB_DECOR_COMPLAIN.BEE_BOXES.MED.1
msgctxt "STRINGS.HERMITCRAB_DECOR_COMPLAIN.BEE_BOXES.MED.1"
msgid "My bees love their houses, but a few more would be nice, dearie!"
msgstr "Le mie api adorano le loro casette, ma qualcuna in più non guasterebbe, tesoro!"

#. STRINGS.HERMITCRAB_DECOR_COMPLAIN.BEE_BOXES.MED.2
msgctxt "STRINGS.HERMITCRAB_DECOR_COMPLAIN.BEE_BOXES.MED.2"
msgid "Dearie, would you please build a few more houses for my bees?"
msgstr "Tesoro, potresti costruire qualche casetta in più per le mie api?"

#. STRINGS.HERMITCRAB_DECOR_COMPLAIN.DECORATION_TAKER.LOW.1
msgctxt "STRINGS.HERMITCRAB_DECOR_COMPLAIN.DECORATION_TAKER.LOW.1"
msgid "Dearie, could you please build me a few tables?"
msgstr "Tesoro, mi costruiresti qualche tavolo?"

#. STRINGS.HERMITCRAB_DECOR_COMPLAIN.DECORATION_TAKER.LOW.2
msgctxt "STRINGS.HERMITCRAB_DECOR_COMPLAIN.DECORATION_TAKER.LOW.2"
msgid "I need a few tables for my home, dearie!"
msgstr "Mi servirebbe qualche tavolo per casa mia, tesoro!"

#. STRINGS.HERMITCRAB_DECOR_COMPLAIN.DECORATION_TAKER.MED.1
msgctxt "STRINGS.HERMITCRAB_DECOR_COMPLAIN.DECORATION_TAKER.MED.1"
msgid "Thank you for the tables, but I'd love a few more."
msgstr "Grazie per i tavoli. Ne accetterei volentieri qualcuno in più."

#. STRINGS.HERMITCRAB_DECOR_COMPLAIN.DECORATION_TAKER.MED.2
msgctxt "STRINGS.HERMITCRAB_DECOR_COMPLAIN.DECORATION_TAKER.MED.2"
msgid "A few more tables would be perfect, dearie!"
msgstr "Non disdegnerei qualche tavolo in più, tesoro."

#. STRINGS.HERMITCRAB_DECOR_COMPLAIN.DOCK_POSTS.LOW.1
msgctxt "STRINGS.HERMITCRAB_DECOR_COMPLAIN.DOCK_POSTS.LOW.1"
msgid "Dearie, would you please build me some dock pilings?"
msgstr "Tesoro, mi costruiresti dei pali per molo?"

#. STRINGS.HERMITCRAB_DECOR_COMPLAIN.DOCK_POSTS.MED.1
msgctxt "STRINGS.HERMITCRAB_DECOR_COMPLAIN.DOCK_POSTS.MED.1"
msgid "I love the dock pilings you built, dearie. A few more would be so nice!"
msgstr "Adoro i pali per molo che hai costruito, tesoro. Sarebbe bello averne qualcuno in più!"

#. STRINGS.HERMITCRAB_DECOR_COMPLAIN.DOCK_POSTS.MED.2
msgctxt "STRINGS.HERMITCRAB_DECOR_COMPLAIN.DOCK_POSTS.MED.2"
msgid "I would just love a few more dock pilings, dearie!"
msgstr "Sarei ben lieta di avere qualche palo per molo in più, tesoro!"

#. STRINGS.HERMITCRAB_DECOR_COMPLAIN.FACED_CHAIR.LOW.1
msgctxt "STRINGS.HERMITCRAB_DECOR_COMPLAIN.FACED_CHAIR.LOW.1"
msgid "There's nowhere to sit, dearie! Please help me build some chairs."
msgstr "Non c'è posto dove sedersi, tesoro! Aiutami a costruire delle sedie."

#. STRINGS.HERMITCRAB_DECOR_COMPLAIN.FACED_CHAIR.LOW.2
msgctxt "STRINGS.HERMITCRAB_DECOR_COMPLAIN.FACED_CHAIR.LOW.2"
msgid "I would love some chairs for my home, dearie."
msgstr "Mi piacerebbe avere qualche sedia per la casa, tesoro."

#. STRINGS.HERMITCRAB_DECOR_COMPLAIN.FACED_CHAIR.MED.1
msgctxt "STRINGS.HERMITCRAB_DECOR_COMPLAIN.FACED_CHAIR.MED.1"
msgid "The chairs you built are lovely, dearie. A few more would be lovely."
msgstr "Le sedie che hai costruito sono adorabili, tesoro. Sarebbe bello averne altre."

#. STRINGS.HERMITCRAB_DECOR_COMPLAIN.FACED_CHAIR.MED.2
msgctxt "STRINGS.HERMITCRAB_DECOR_COMPLAIN.FACED_CHAIR.MED.2"
msgid "Could you please build me just a few more chairs, dearie?"
msgstr "Mi costruiresti qualche altra sedia, tesoro?"

#. STRINGS.HERMITCRAB_DECOR_COMPLAIN.FISHING_MARKERS.HIGH.1
msgctxt "STRINGS.HERMITCRAB_DECOR_COMPLAIN.FISHING_MARKERS.HIGH.1"
msgid "Dearie, there's simply no where for me to fish!"
msgstr "Tesoro, non ho posto dove pescare!"

#. STRINGS.HERMITCRAB_DECOR_COMPLAIN.FISHING_MARKERS.HIGH.2
msgctxt "STRINGS.HERMITCRAB_DECOR_COMPLAIN.FISHING_MARKERS.HIGH.2"
msgid "I have no where to fish! Please help me, my dearie!"
msgstr "Non ho dove pescare! Aiutami, pesciolino!"

#. STRINGS.HERMITCRAB_DECOR_COMPLAIN.FISHING_MARKERS.LOW.1
msgctxt "STRINGS.HERMITCRAB_DECOR_COMPLAIN.FISHING_MARKERS.LOW.1"
msgid "There's more room for me to fish except for a few spots, dearie."
msgstr "Ci sono ancora punti dove non si può pescare, tesoro."

#. STRINGS.HERMITCRAB_DECOR_COMPLAIN.FISHING_MARKERS.LOW.2
msgctxt "STRINGS.HERMITCRAB_DECOR_COMPLAIN.FISHING_MARKERS.LOW.2"
msgid "Dearie, there are just a few more of my favorite fishing spots I can't reach."
msgstr "Tesoro, non riesco a raggiungere alcuni dei miei posti di pesca preferiti."

#. STRINGS.HERMITCRAB_DECOR_COMPLAIN.FISHING_MARKERS.MED.1
msgctxt "STRINGS.HERMITCRAB_DECOR_COMPLAIN.FISHING_MARKERS.MED.1"
msgid "It's better, but I could still use more fishing spots!"
msgstr "Ora va meglio, ma non mi dispiacerebbero più posti in cui pescare!"

#. STRINGS.HERMITCRAB_DECOR_COMPLAIN.FISHING_MARKERS.MED.2
msgctxt "STRINGS.HERMITCRAB_DECOR_COMPLAIN.FISHING_MARKERS.MED.2"
msgid "I can't get to half of my favorite fishing spots, dearie."
msgstr "Non riesco a raggiungere metà dei miei posti di pesca preferiti, tesoro."

#. STRINGS.HERMITCRAB_DECOR_COMPLAIN.FLOWERS.LOW.1
msgctxt "STRINGS.HERMITCRAB_DECOR_COMPLAIN.FLOWERS.LOW.1"
msgid "I do miss my flowers, dearie. Would you please plant some for me?"
msgstr "Mi mancano i fiori, tesoro. Ne pianteresti qualcuno per me?"

#. STRINGS.HERMITCRAB_DECOR_COMPLAIN.FLOWERS.LOW.2
msgctxt "STRINGS.HERMITCRAB_DECOR_COMPLAIN.FLOWERS.LOW.2"
msgid "Some flowers would make my home so much prettier. Could you plant me some, dearie?"
msgstr "Qualche fiorellino farebbe miracoli per questa casa. Potresti piantarne alcuni, tesoro?"

#. STRINGS.HERMITCRAB_DECOR_COMPLAIN.FLOWERS.MED.1
msgctxt "STRINGS.HERMITCRAB_DECOR_COMPLAIN.FLOWERS.MED.1"
msgid "I love the flowers you've planted, dearie. A few more would be wonderful."
msgstr "Adoro i fiori che hai piantato, tesoro. Aggiungine pure qualcuno in più."

#. STRINGS.HERMITCRAB_DECOR_COMPLAIN.FLOWERS.MED.2
msgctxt "STRINGS.HERMITCRAB_DECOR_COMPLAIN.FLOWERS.MED.2"
msgid "Just a few more flowers would be absolutely perfect, dearie."
msgstr "Non disdegnerei affatto qualche fiorellino in più, tesoro."

#. STRINGS.HERMITCRAB_DECOR_COMPLAIN.JUNK.HIGH.1
msgctxt "STRINGS.HERMITCRAB_DECOR_COMPLAIN.JUNK.HIGH.1"
msgid "Dearie, my home is surrounded by junk! Please help me clear it?"
msgstr "Tesoro, ho la casa circondata dal ciarpame! Mi aiuteresti a rimuoverlo?"

#. STRINGS.HERMITCRAB_DECOR_COMPLAIN.JUNK.HIGH.2
msgctxt "STRINGS.HERMITCRAB_DECOR_COMPLAIN.JUNK.HIGH.2"
msgid "There's junk everywhere! I need your help to clear it, dearie!"
msgstr "C'è ciarpame ovunque! Ho bisogno del tuo aiuto per rimuoverlo, tesoro!"

#. STRINGS.HERMITCRAB_DECOR_COMPLAIN.JUNK.LOW.1
msgctxt "STRINGS.HERMITCRAB_DECOR_COMPLAIN.JUNK.LOW.1"
msgid "My house is almost clear of junk! Just a few more pieces to go."
msgstr "Abbiamo quasi liberato la casa dal ciarpame! Ancora qualche pezzo e ci siamo."

#. STRINGS.HERMITCRAB_DECOR_COMPLAIN.JUNK.LOW.2
msgctxt "STRINGS.HERMITCRAB_DECOR_COMPLAIN.JUNK.LOW.2"
msgid "We're just about there! Would you help me clean up a bit more junk, dearie?"
msgstr "Ormai è quasi pulito! Mi aiuteresti a liberarci del poco ciarpame che rimane, tesoro?"

#. STRINGS.HERMITCRAB_DECOR_COMPLAIN.JUNK.MED.1
msgctxt "STRINGS.HERMITCRAB_DECOR_COMPLAIN.JUNK.MED.1"
msgid "My place is still cluttered with some junk. Could you please help me clean up?"
msgstr "C'è ancora del ciarpame attorno alla casa. Mi aiuteresti a pulire?"

#. STRINGS.HERMITCRAB_DECOR_COMPLAIN.JUNK.MED.2
msgctxt "STRINGS.HERMITCRAB_DECOR_COMPLAIN.JUNK.MED.2"
msgid "My dearie, I would be so grateful for your help in clearing some junk around here."
msgstr "Tesoro, ti sarei grata se mi aiutassi a rimuovere il poco ciarpame che c'è qui attorno."

#. STRINGS.HERMITCRAB_DECOR_COMPLAIN.LIGHT_POSTS.LOW.1
msgctxt "STRINGS.HERMITCRAB_DECOR_COMPLAIN.LIGHT_POSTS.LOW.1"
msgid "It's still rather dim, dearie!"
msgstr "È ancora piuttosto buio, tesoro!"

#. STRINGS.HERMITCRAB_DECOR_COMPLAIN.LIGHT_POSTS.LOW.2
msgctxt "STRINGS.HERMITCRAB_DECOR_COMPLAIN.LIGHT_POSTS.LOW.2"
msgid "More light would be lovely, my dearie."
msgstr "Sarebbe bello avere più luce, pesciolino."

#. STRINGS.HERMITCRAB_DECOR_COMPLAIN.LIGHT_POSTS.MED.1
msgctxt "STRINGS.HERMITCRAB_DECOR_COMPLAIN.LIGHT_POSTS.MED.1"
msgid "The lights are lovely! Just one or two more should do."
msgstr "Le luci sono splendide! Ancora qualcuna e saremo a posto."

#. STRINGS.HERMITCRAB_DECOR_COMPLAIN.LIGHT_POSTS.MED.2
msgctxt "STRINGS.HERMITCRAB_DECOR_COMPLAIN.LIGHT_POSTS.MED.2"
msgid "Dearie, just a little more light please!"
msgstr "Tesoro, aggiungiamo qualche lucina in più!"

#. STRINGS.HERMITCRAB_DECOR_COMPLAIN.MEAT_RACKS.LOW.1
msgctxt "STRINGS.HERMITCRAB_DECOR_COMPLAIN.MEAT_RACKS.LOW.1"
msgid "Dearie, would you please build me some larger drying racks?"
msgstr "Tesoro, mi costruiresti degli essiccatori più grandi?"

#. STRINGS.HERMITCRAB_DECOR_COMPLAIN.MEAT_RACKS.LOW.2
msgctxt "STRINGS.HERMITCRAB_DECOR_COMPLAIN.MEAT_RACKS.LOW.2"
msgid "I would love some more drying racks, my dearie."
msgstr "Sarebbe bello avere qualche altro essiccatore, pesciolino."

#. STRINGS.HERMITCRAB_DECOR_COMPLAIN.MEAT_RACKS.MED.1
msgctxt "STRINGS.HERMITCRAB_DECOR_COMPLAIN.MEAT_RACKS.MED.1"
msgid "Wonderful! Perhaps one or two more large drying racks, dearie?"
msgstr "Magnifico! Che ne diresti di aggiungere uno o due essiccatori grandi, tesoro?"

#. STRINGS.HERMITCRAB_DECOR_COMPLAIN.MEAT_RACKS.MED.2
msgctxt "STRINGS.HERMITCRAB_DECOR_COMPLAIN.MEAT_RACKS.MED.2"
msgid "Almost, dearie! Just one or two more large drying racks!"
msgstr "Ci siamo quasi, tesoro! Ancora uno o due essiccatori grandi e saremo a posto!"

#. STRINGS.HERMITCRAB_DECOR_COMPLAIN.ORNAMENTS.LOW.1
msgctxt "STRINGS.HERMITCRAB_DECOR_COMPLAIN.ORNAMENTS.LOW.1"
msgid "Oh I love these wind charms. Perhaps a few more?"
msgstr "Oh, adoro questi sonagli a vento. Ne aggiungiamo qualcuno?"

#. STRINGS.HERMITCRAB_DECOR_COMPLAIN.ORNAMENTS.LOW.2
msgctxt "STRINGS.HERMITCRAB_DECOR_COMPLAIN.ORNAMENTS.LOW.2"
msgid "Dearie, these wind charms are lovely! More, please!"
msgstr "Tesoro, questi sonagli a vento sono incantevoli! Aggiungiamone altri!"

#. STRINGS.HERMITCRAB_DECOR_COMPLAIN.ORNAMENTS.MED.1
msgctxt "STRINGS.HERMITCRAB_DECOR_COMPLAIN.ORNAMENTS.MED.1"
msgid "Just a one or two more wind charms should do it!"
msgstr "Ancora uno o due sonagli a vento e saremo a posto!"

#. STRINGS.HERMITCRAB_DECOR_COMPLAIN.ORNAMENTS.MED.2
msgctxt "STRINGS.HERMITCRAB_DECOR_COMPLAIN.ORNAMENTS.MED.2"
msgid "We almost have enough wind charms, dearie!"
msgstr "Ci siamo quasi con i sonagli a vento, tesoro!"

#. STRINGS.HERMITCRAB_DECOR_COMPLAIN.PICKABLE_PLANTS.LOW.1
msgctxt "STRINGS.HERMITCRAB_DECOR_COMPLAIN.PICKABLE_PLANTS.LOW.1"
msgid "We will need more plants than this, dearie."
msgstr "Ci serviranno più piante di queste, tesoro."

#. STRINGS.HERMITCRAB_DECOR_COMPLAIN.PICKABLE_PLANTS.LOW.2
msgctxt "STRINGS.HERMITCRAB_DECOR_COMPLAIN.PICKABLE_PLANTS.LOW.2"
msgid "More plants would be lovely, dearie!"
msgstr "Mi piacerebbe essere immersa nel verde, tesoro!"

#. STRINGS.HERMITCRAB_DECOR_COMPLAIN.PICKABLE_PLANTS.MED.1
msgctxt "STRINGS.HERMITCRAB_DECOR_COMPLAIN.PICKABLE_PLANTS.MED.1"
msgid "I love all these plants! Perhaps one or two more?"
msgstr "Quante belle piante! Che ne dici, ne aggiungiamo ancora qualcuna?"

#. STRINGS.HERMITCRAB_DECOR_COMPLAIN.PICKABLE_PLANTS.MED.2
msgctxt "STRINGS.HERMITCRAB_DECOR_COMPLAIN.PICKABLE_PLANTS.MED.2"
msgid "It's almost perfect, dearie! Just a few more plants!"
msgstr "Ci siamo quasi, tesoro! Ancora qualche piantina e saremo a posto!"

#. STRINGS.HERMITCRAB_DECOR_COMPLAIN.POTTED_PLANTS.LOW.1
msgctxt "STRINGS.HERMITCRAB_DECOR_COMPLAIN.POTTED_PLANTS.LOW.1"
msgid "Dearie, would you please build me some pots for my plants?"
msgstr "Tesoro, mi costruiresti dei vasi per le mie piante?"

#. STRINGS.HERMITCRAB_DECOR_COMPLAIN.POTTED_PLANTS.LOW.2
msgctxt "STRINGS.HERMITCRAB_DECOR_COMPLAIN.POTTED_PLANTS.LOW.2"
msgid "I would love some pots for my plants, dearie!"
msgstr "Mi piacerebbe avere qualche vaso per le mie piante, tesoro!"

#. STRINGS.HERMITCRAB_DECOR_COMPLAIN.POTTED_PLANTS.MED.1
msgctxt "STRINGS.HERMITCRAB_DECOR_COMPLAIN.POTTED_PLANTS.MED.1"
msgid "These pots are wonderful, but I would love a few more."
msgstr "Questi vasi sono incantevoli: non ne disdegnerei qualcuno in più."

#. STRINGS.HERMITCRAB_DECOR_COMPLAIN.POTTED_PLANTS.MED.2
msgctxt "STRINGS.HERMITCRAB_DECOR_COMPLAIN.POTTED_PLANTS.MED.2"
msgid "Just a few more pots for my plants would be enough, my dearie."
msgstr "Alle mie piante basterebbe solo qualche vaso in più, pesciolino."

#. STRINGS.HERMITCRAB_DECOR_COMPLAIN.SPAWNER.HIGH.1
msgctxt "STRINGS.HERMITCRAB_DECOR_COMPLAIN.SPAWNER.HIGH.1"
msgid "Oh dearie, there are so many places here the beasties creep out from!"
msgstr "Oh, tesoro, ci sono un mare di punti da cui potrebbero sbucare le creature!"

#. STRINGS.HERMITCRAB_DECOR_COMPLAIN.SPAWNER.HIGH.2
msgctxt "STRINGS.HERMITCRAB_DECOR_COMPLAIN.SPAWNER.HIGH.2"
msgid "The beasties come from every direction here! Please rid the area of them for me, dearie!"
msgstr "Qui le creature arrivano da ogni direzione! Aiutami a fare piazza pulita, tesoro!"

#. STRINGS.HERMITCRAB_DECOR_COMPLAIN.SPAWNER.LOW.1
msgctxt "STRINGS.HERMITCRAB_DECOR_COMPLAIN.SPAWNER.LOW.1"
msgid "Just a few more beastie hiding places left!"
msgstr "È rimasto ancora qualche nascondiglio per le creature!"

#. STRINGS.HERMITCRAB_DECOR_COMPLAIN.SPAWNER.LOW.2
msgctxt "STRINGS.HERMITCRAB_DECOR_COMPLAIN.SPAWNER.LOW.2"
msgid "Dearie, could you please help me get rid of just a few more nasty neighbors?"
msgstr "Tesoro, mi aiuteresti a sbarazzarmi di qualche altro vicino fastidioso?"

#. STRINGS.HERMITCRAB_DECOR_COMPLAIN.SPAWNER.MED.1
msgctxt "STRINGS.HERMITCRAB_DECOR_COMPLAIN.SPAWNER.MED.1"
msgid "There are still a number of spots for the beasties to hide!"
msgstr "Ci sono ancora diversi punti in cui le creature potrebbero nascondersi!"

#. STRINGS.HERMITCRAB_DECOR_COMPLAIN.SPAWNER.MED.2
msgctxt "STRINGS.HERMITCRAB_DECOR_COMPLAIN.SPAWNER.MED.2"
msgid "I still have quite a few unfriendly neighbors. Please help, dearie!"
msgstr "Mi è rimasto ancora qualche vicino scontroso. Aiutami, tesoro!"

#. STRINGS.HERMITCRAB_DECOR_COMPLAIN.TILES.LOW.1
msgctxt "STRINGS.HERMITCRAB_DECOR_COMPLAIN.TILES.LOW.1"
msgid "Dearie, I miss the beach so much. This place is nothing like it."
msgstr "Tesoro, mi manca moltissimo la spiaggia. Non c'è niente che la eguagli."

#. STRINGS.HERMITCRAB_DECOR_COMPLAIN.TILES.LOW.2
msgctxt "STRINGS.HERMITCRAB_DECOR_COMPLAIN.TILES.LOW.2"
msgid "I don't feel like I belong here. I wish it was more like the beach."
msgstr "Non mi sento a mio agio. Vorrei che questo posto assomigliasse più a una spiaggia."

#. STRINGS.HERMITCRAB_DECOR_COMPLAIN.TILES.MED.1
msgctxt "STRINGS.HERMITCRAB_DECOR_COMPLAIN.TILES.MED.1"
msgid "It's starting to feel like the beach, but perhaps needs a little more, dearie."
msgstr "Sta iniziando ad assomigliare a una spiaggia, ma forse manca ancora qualcosa, tesoro."

#. STRINGS.HERMITCRAB_DECOR_COMPLAIN.TILES.MED.2
msgctxt "STRINGS.HERMITCRAB_DECOR_COMPLAIN.TILES.MED.2"
msgid "Oh dearie, it needs just a little more to feel like my beach."
msgstr "Oh, tesoro, ancora qualche modifica e questa spiaggia mi sembrerà mia."

#. STRINGS.HERMITCRAB_DECOR_COMPLAIN.TROPHY_FISH.LOW.1
msgctxt "STRINGS.HERMITCRAB_DECOR_COMPLAIN.TROPHY_FISH.LOW.1"
msgid "I would love more big fish to display!"
msgstr "Sarei lieta di poter esporre altri pesci grossi!"

#. STRINGS.HERMITCRAB_DECOR_COMPLAIN.TROPHY_FISH.LOW.2
msgctxt "STRINGS.HERMITCRAB_DECOR_COMPLAIN.TROPHY_FISH.LOW.2"
msgid "A few more big fish would be wonderful, dearie!"
msgstr "Sarebbe magnifico avere qualche altro pesce grosso, tesoro!"

#. STRINGS.HERMITCRAB_DECOR_COMPLAIN_AREA.MOON_ISLAND.1
msgctxt "STRINGS.HERMITCRAB_DECOR_COMPLAIN_AREA.MOON_ISLAND.1"
msgid "This place gives me a terrible headache!"
msgstr "Questo posto mi fa venire l'emicrania!"

#. STRINGS.HERMITCRAB_DECOR_COMPLAIN_AREA.MOON_ISLAND.2
msgctxt "STRINGS.HERMITCRAB_DECOR_COMPLAIN_AREA.MOON_ISLAND.2"
msgid "Those weird little spooks are all around here!"
msgstr "Quegli strani spauracchi sono ovunque!"

#. STRINGS.HERMITCRAB_DECOR_COMPLAIN_AREA.MOON_ISLAND.3
msgctxt "STRINGS.HERMITCRAB_DECOR_COMPLAIN_AREA.MOON_ISLAND.3"
msgid "Please help me find a new place to live, dearie."
msgstr "Aiutami a trovare una nuova casa, tesoro."

#. STRINGS.HERMITCRAB_DECOR_COMPLAIN_AREA.MOON_ISLAND.4
msgctxt "STRINGS.HERMITCRAB_DECOR_COMPLAIN_AREA.MOON_ISLAND.4"
msgid "Oh, dearie. I really don't like it here. Help me move, please!"
msgstr "Oh, tesoro. Qui proprio non mi piace. Aiutami a trasferirmi, ti imploro!"

#. STRINGS.HERMITCRAB_DECOR_CONTENT.BEE_BOXES.1
msgctxt "STRINGS.HERMITCRAB_DECOR_CONTENT.BEE_BOXES.1"
msgid "Thank you for all the bee boxes, dearie!"
msgstr "Grazie per tutte le scatole delle api, tesoro!"

#. STRINGS.HERMITCRAB_DECOR_CONTENT.BEE_BOXES.2
msgctxt "STRINGS.HERMITCRAB_DECOR_CONTENT.BEE_BOXES.2"
msgid "My bees love their new homes! Thank you, dearie!"
msgstr "Le mie apine adorano le loro nuove casette! Grazie, tesoro!"

#. STRINGS.HERMITCRAB_DECOR_CONTENT.BEE_BOXES.3
msgctxt "STRINGS.HERMITCRAB_DECOR_CONTENT.BEE_BOXES.3"
msgid "All these bee boxes! Now I'll have plenty of honey for my tea!"
msgstr "Quante scatole delle api! Ora avrò miele a sufficienza per i miei infusi!"

#. STRINGS.HERMITCRAB_DECOR_CONTENT.CRITTER_PET.1
msgctxt "STRINGS.HERMITCRAB_DECOR_CONTENT.CRITTER_PET.1"
msgid "I don't much take to company, dearie... except yours and now this sweet little one's."
msgstr "Non amo la compagnia, tesoro... A eccezione della tua e di questa dolce creaturina."

#. STRINGS.HERMITCRAB_DECOR_CONTENT.CRITTER_PET.2
msgctxt "STRINGS.HERMITCRAB_DECOR_CONTENT.CRITTER_PET.2"
msgid "Thank you for bringing me this perfect little companion, dearie."
msgstr "Grazie per avermi portato questo meraviglioso animaletto, tesoro."

#. STRINGS.HERMITCRAB_DECOR_CONTENT.DECORATION_TAKER.1
msgctxt "STRINGS.HERMITCRAB_DECOR_CONTENT.DECORATION_TAKER.1"
msgid "Thank you for the wonderful tables, dearie."
msgstr "Grazie per i tavoli, tesoro. Sono splendidi."

#. STRINGS.HERMITCRAB_DECOR_CONTENT.DECORATION_TAKER.2
msgctxt "STRINGS.HERMITCRAB_DECOR_CONTENT.DECORATION_TAKER.2"
msgid "I simply adore these beautiful tables you've made for me, dearie."
msgstr "Vado matta per i tavoli che mi hai costruito, tesoro. Sono un incanto."

#. STRINGS.HERMITCRAB_DECOR_CONTENT.DOCK_POSTS.1
msgctxt "STRINGS.HERMITCRAB_DECOR_CONTENT.DOCK_POSTS.1"
msgid "The dock pilings are really great, dearie!"
msgstr "Che bei pali per molo, tesoro!"

#. STRINGS.HERMITCRAB_DECOR_CONTENT.DOCK_POSTS.2
msgctxt "STRINGS.HERMITCRAB_DECOR_CONTENT.DOCK_POSTS.2"
msgid "I love my dock pilings, my dearie!"
msgstr "Adoro i miei pali per molo, pesciolino!"

#. STRINGS.HERMITCRAB_DECOR_CONTENT.FACED_CHAIR.1
msgctxt "STRINGS.HERMITCRAB_DECOR_CONTENT.FACED_CHAIR.1"
msgid "Now I can sit down in one of these chairs, rest my legs and enjoy a cup of tea!"
msgstr "Ora posso sedermi su una di queste sedie, riposare le zampe e godermi un bell'infuso!"

#. STRINGS.HERMITCRAB_DECOR_CONTENT.FACED_CHAIR.2
msgctxt "STRINGS.HERMITCRAB_DECOR_CONTENT.FACED_CHAIR.2"
msgid "Now I have chairs for when you come to visit!"
msgstr "Ora ho sedie anche per quando verrai a visitarmi!"

#. STRINGS.HERMITCRAB_DECOR_CONTENT.FLOWERS.1
msgctxt "STRINGS.HERMITCRAB_DECOR_CONTENT.FLOWERS.1"
msgid "Oh dearie, I love all the flowers you've planted for me!"
msgstr "Oh, tesoro, adoro i fiori che hai piantato per me!"

#. STRINGS.HERMITCRAB_DECOR_CONTENT.FLOWERS.2
msgctxt "STRINGS.HERMITCRAB_DECOR_CONTENT.FLOWERS.2"
msgid "My garden is full of beautiful flowers thanks to you, dearie!"
msgstr "È merito tuo se il mio giardino è pieno di fiori incantevoli, tesoro!"

#. STRINGS.HERMITCRAB_DECOR_CONTENT.FLOWERS.3
msgctxt "STRINGS.HERMITCRAB_DECOR_CONTENT.FLOWERS.3"
msgid "All these flowers make me so happy! Thank you, my dearie."
msgstr "Tutti questi fiori mi rendono felice! Grazie, pesciolino."

#. STRINGS.HERMITCRAB_DECOR_CONTENT.HOT_SPRING.1
msgctxt "STRINGS.HERMITCRAB_DECOR_CONTENT.HOT_SPRING.1"
msgid "Now I can have a soak and rest my old shell."
msgstr "Un bel bagno caldo farà miracoli per il mio vecchio guscio."

#. STRINGS.HERMITCRAB_DECOR_CONTENT.HOT_SPRING.2
msgctxt "STRINGS.HERMITCRAB_DECOR_CONTENT.HOT_SPRING.2"
msgid "What a lovely hot spring, dearie! Come by anytime for a soak."
msgstr "Che meravigliosa sorgente calda, tesoro! Usala quando vuoi."

#. STRINGS.HERMITCRAB_DECOR_CONTENT.HOT_SPRING.3
msgctxt "STRINGS.HERMITCRAB_DECOR_CONTENT.HOT_SPRING.3"
msgid "Thank you for the wonderful hot spring, dearie."
msgstr "Grazie per la sorgente calda, tesoro. È un incanto."

#. STRINGS.HERMITCRAB_DECOR_CONTENT.LIGHT_POSTS.1
msgctxt "STRINGS.HERMITCRAB_DECOR_CONTENT.LIGHT_POSTS.1"
msgid "My home is so bright and beautiful now!"
msgstr "Com'è bella e luminosa la mia casa, ora!"

#. STRINGS.HERMITCRAB_DECOR_CONTENT.LIGHT_POSTS.2
msgctxt "STRINGS.HERMITCRAB_DECOR_CONTENT.LIGHT_POSTS.2"
msgid "All these lights really liven the mood!"
msgstr "Tutte queste luci rallegrano l'atmosfera!"

#. STRINGS.HERMITCRAB_DECOR_CONTENT.LIGHT_POSTS.3
msgctxt "STRINGS.HERMITCRAB_DECOR_CONTENT.LIGHT_POSTS.3"
msgid "The lights look give such a warm and cozy glow. It's perfect."
msgstr "Le luci emanano un bagliore caldo e accogliente. È perfetto."

#. STRINGS.HERMITCRAB_DECOR_CONTENT.MEAT_RACKS.1
msgctxt "STRINGS.HERMITCRAB_DECOR_CONTENT.MEAT_RACKS.1"
msgid "I love my new drying racks!"
msgstr "Adoro i miei nuovi essiccatori!"

#. STRINGS.HERMITCRAB_DECOR_CONTENT.MEAT_RACKS.2
msgctxt "STRINGS.HERMITCRAB_DECOR_CONTENT.MEAT_RACKS.2"
msgid "Thank you dearie! Now I have so much room for drying!"
msgstr "Grazie, tesoro! Ora ho un mare di spazio dove essiccare!"

#. STRINGS.HERMITCRAB_DECOR_CONTENT.MEAT_RACKS.3
msgctxt "STRINGS.HERMITCRAB_DECOR_CONTENT.MEAT_RACKS.3"
msgid "I'll never run out of drying space again!"
msgstr "Lo spazio dove essiccare non sarà più un problema!"

#. STRINGS.HERMITCRAB_DECOR_CONTENT.ORNAMENTS.1
msgctxt "STRINGS.HERMITCRAB_DECOR_CONTENT.ORNAMENTS.1"
msgid "Wonderful! I love how they dance in the wind."
msgstr "Magnifico! Amo come danzano al vento."

#. STRINGS.HERMITCRAB_DECOR_CONTENT.ORNAMENTS.2
msgctxt "STRINGS.HERMITCRAB_DECOR_CONTENT.ORNAMENTS.2"
msgid "They're splendid, dearie."
msgstr "Sono splendidi, tesoro."

#. STRINGS.HERMITCRAB_DECOR_CONTENT.ORNAMENTS.3
msgctxt "STRINGS.HERMITCRAB_DECOR_CONTENT.ORNAMENTS.3"
msgid "Absolutely lovely, my dearie."
msgstr "Sono un amore, pesciolino."

#. STRINGS.HERMITCRAB_DECOR_CONTENT.PICKABLE_PLANTS.1
msgctxt "STRINGS.HERMITCRAB_DECOR_CONTENT.PICKABLE_PLANTS.1"
msgid "It all looks so lush!"
msgstr "Adoro tutto questo verde!"

#. STRINGS.HERMITCRAB_DECOR_CONTENT.PICKABLE_PLANTS.2
msgctxt "STRINGS.HERMITCRAB_DECOR_CONTENT.PICKABLE_PLANTS.2"
msgid "Dearie, you certainly have a green thumb!"
msgstr "Tesoro, hai davvero il pollice verde!"

#. STRINGS.HERMITCRAB_DECOR_CONTENT.PICKABLE_PLANTS.3
msgctxt "STRINGS.HERMITCRAB_DECOR_CONTENT.PICKABLE_PLANTS.3"
msgid "Every plant I need is at my clawtips! How thoughtful, dearie."
msgstr "Tutte le piante di cui ho bisogno sono a portata di chela! Sei un tesoro."

#. STRINGS.HERMITCRAB_DECOR_CONTENT.POTTED_PLANTS.1
msgctxt "STRINGS.HERMITCRAB_DECOR_CONTENT.POTTED_PLANTS.1"
msgid "These potted plants are lovely, dearie."
msgstr "Queste piante in vaso sono un incanto, tesoro."

#. STRINGS.HERMITCRAB_DECOR_CONTENT.POTTED_PLANTS.2
msgctxt "STRINGS.HERMITCRAB_DECOR_CONTENT.POTTED_PLANTS.2"
msgid "I really enjoy these potted plants. Thank you, dearie."
msgstr "Vado matta per queste piante in vaso. Grazie, tesoro."

#. STRINGS.HERMITCRAB_DECOR_CONTENT.TEA_SHOP.1
msgctxt "STRINGS.HERMITCRAB_DECOR_CONTENT.TEA_SHOP.1"
msgid "Oh, dearie! I can't wait for you to taste all my different teas!"
msgstr "Oh, tesoro! Non vedo l'ora di farti assaggiare tutti i miei infusi!"

#. STRINGS.HERMITCRAB_DECOR_CONTENT.TEA_SHOP.2
msgctxt "STRINGS.HERMITCRAB_DECOR_CONTENT.TEA_SHOP.2"
msgid "Finally, Pearl's Tea Shop can open for business!"
msgstr "Finalmente il chiosco degli infusi di Perla può aprire!"

#. STRINGS.HERMITCRAB_DECOR_CONTENT.TEA_SHOP.3
msgctxt "STRINGS.HERMITCRAB_DECOR_CONTENT.TEA_SHOP.3"
msgid "Thank you for helping me set up my tea shop, dearie."
msgstr "Grazie per avermi aiutata con il chioso degli infusi, tesoro."

#. STRINGS.HERMITCRAB_DECOR_CONTENT.TILES.1
msgctxt "STRINGS.HERMITCRAB_DECOR_CONTENT.TILES.1"
msgid "It's my very own beach! I love it, dearie!"
msgstr "Ho una spiaggia tutta mia! La adoro, tesoro!"

#. STRINGS.HERMITCRAB_DECOR_CONTENT.TILES.2
msgctxt "STRINGS.HERMITCRAB_DECOR_CONTENT.TILES.2"
msgid "Thank you, dearie. You've brought the beach to me!"
msgstr "Grazie, tesoro. Mi hai portato la spiaggia!"

#. STRINGS.HERMITCRAB_DECOR_CONTENT.TILES.3
msgctxt "STRINGS.HERMITCRAB_DECOR_CONTENT.TILES.3"
msgid "It's perfect, dearie! My home on the beach!"
msgstr "È perfetta, tesoro! La mia casa sulla spiaggia!"

#. STRINGS.HERMITCRAB_DECOR_CONTENT.WATER_TREE.1
msgctxt "STRINGS.HERMITCRAB_DECOR_CONTENT.WATER_TREE.1"
msgid "What a wonderful tree you planted for me, dearie!"
msgstr "Che albero meraviglioso hai piantato, tesoro!"

#. STRINGS.HERMITCRAB_DECOR_CONTENT.WATER_TREE.2
msgctxt "STRINGS.HERMITCRAB_DECOR_CONTENT.WATER_TREE.2"
msgid "I love my tree, dearie! It protects me from the hot sun and cold rain!"
msgstr "Adoro il mio alberello, tesoro! Mi protegge dalla pioggia e dal calore del sole!"

#. STRINGS.HERMITCRAB_DECOR_CONTENT.WATER_TREE.3
msgctxt "STRINGS.HERMITCRAB_DECOR_CONTENT.WATER_TREE.3"
msgid "Thank you for planting the beautiful tree for me, dearie."
msgstr "Grazie per aver piantato quello splendido albero, tesoro."

#. STRINGS.HERMITCRAB_DECOR_PRAISES.1
msgctxt "STRINGS.HERMITCRAB_DECOR_PRAISES.1"
msgid "My dearie! I love what you've done with my place!"
msgstr "Pesciolino! Adoro come hai decorato questo posto!"

#. STRINGS.HERMITCRAB_DECOR_PRAISES.2
msgctxt "STRINGS.HERMITCRAB_DECOR_PRAISES.2"
msgid "Thank you, dearie! It truly feels like home now!"
msgstr "Grazie, tesoro! Mi sento proprio a casa!"

#. STRINGS.HERMITCRAB_DECOR_PRAISES.3
msgctxt "STRINGS.HERMITCRAB_DECOR_PRAISES.3"
msgid "Oh my, you have such an eye for decorating!"
msgstr "Per tutti i mari! Hai proprio occhio per le decorazioni!"

#. STRINGS.HERMITCRAB_DECOR_PRAISES.4
msgctxt "STRINGS.HERMITCRAB_DECOR_PRAISES.4"
msgid "Dearie, you've done it! My place looks wonderful!"
msgstr "Tesoro, ce l'hai fatta! Questo posto è magnifico!"

#. STRINGS.HERMITCRAB_DECOR_PRAISES.5
msgctxt "STRINGS.HERMITCRAB_DECOR_PRAISES.5"
msgid "I love it, my dearie! Thank you for your help!"
msgstr "Lo adoro, pesciolino! Grazie per l'aiuto!"

#. STRINGS.HERMITCRAB_DECOR_PRAISES.6
msgctxt "STRINGS.HERMITCRAB_DECOR_PRAISES.6"
msgid "Oh dearie, it's become a real home sweet home! Thank you."
msgstr "Oh, tesoro, è diventata una casa proprio accogliente! Grazie."

#. STRINGS.HERMITCRAB_DECOR_PRAISES.7
msgctxt "STRINGS.HERMITCRAB_DECOR_PRAISES.7"
msgid "You've done such a lovely job decorating my home, dearie!"
msgstr "Hai fatto davvero un ottimo lavoro nel decorare questa casa, tesoro!"

#. STRINGS.HERMITCRAB_DEFAULT_REWARD.HIGH.1
msgctxt "STRINGS.HERMITCRAB_DEFAULT_REWARD.HIGH.1"
msgid "Such a big help! Thank you."
msgstr "Mi hai dato una grossa mano! Grazie."

#. STRINGS.HERMITCRAB_DEFAULT_REWARD.LOW.1
msgctxt "STRINGS.HERMITCRAB_DEFAULT_REWARD.LOW.1"
msgid "I guess you want something for helping me out?"
msgstr "Immagino tu voglia qualcosa per avermi dato una mano?"

#. STRINGS.HERMITCRAB_DEFAULT_REWARD.LOW.2
msgctxt "STRINGS.HERMITCRAB_DEFAULT_REWARD.LOW.2"
msgid "Fine."
msgstr "Va bene."

#. STRINGS.HERMITCRAB_DEFAULT_REWARD.MED.1
msgctxt "STRINGS.HERMITCRAB_DEFAULT_REWARD.MED.1"
msgid "I guess it's not so bad having you around."
msgstr "Non è poi così male averti tra i piedi."

#. STRINGS.HERMITCRAB_FIGHT.1.1
msgctxt "STRINGS.HERMITCRAB_FIGHT.1.1"
msgid "You louse!"
msgstr "Canaglia!"

#. STRINGS.HERMITCRAB_FIGHT.1.2
msgctxt "STRINGS.HERMITCRAB_FIGHT.1.2"
msgid "Bullying a sweet, innocent old lady like myself!"
msgstr "Come puoi prenderti gioco di un'anziana, innocente signora come me!"

#. STRINGS.HERMITCRAB_GETFISH_BIG.1
msgctxt "STRINGS.HERMITCRAB_GETFISH_BIG.1"
msgid "Now that's a proper-sized fish!"
msgstr "Questo sì che è un pesce degno di questo nome!"

#. STRINGS.HERMITCRAB_GIVE_PEARL.1
msgctxt "STRINGS.HERMITCRAB_GIVE_PEARL.1"
msgid "If you find my sweetie on your travels..."
msgstr "Se trovi il mio tesorino durante uno dei tuoi viaggi..."

#. STRINGS.HERMITCRAB_GIVE_PEARL.2
msgctxt "STRINGS.HERMITCRAB_GIVE_PEARL.2"
msgid "Could you... give him that pearl?"
msgstr "Potresti... dargli quella perla?"

#. STRINGS.HERMITCRAB_GIVE_PEARL.3
msgctxt "STRINGS.HERMITCRAB_GIVE_PEARL.3"
msgid "He'll recognize it."
msgstr "Lui la riconoscerà."

#. STRINGS.HERMITCRAB_GOT_MAPSCROLL_BAD.1
msgctxt "STRINGS.HERMITCRAB_GOT_MAPSCROLL_BAD.1"
msgid "This map is no good to me."
msgstr "Questa mappa non fa per me."

#. STRINGS.HERMITCRAB_GOT_MAPSCROLL_BAD.2
msgctxt "STRINGS.HERMITCRAB_GOT_MAPSCROLL_BAD.2"
msgid "It doesn't take me anywhere special."
msgstr "Non mi porta in un luogo speciale."

#. STRINGS.HERMITCRAB_GOT_MAPSCROLL_GOOD.1
msgctxt "STRINGS.HERMITCRAB_GOT_MAPSCROLL_GOOD.1"
msgid "The island on this map seems nice..."
msgstr "L'isola su questa mappa sembra bella..."

#. STRINGS.HERMITCRAB_GOT_MAPSCROLL_GOOD.2
msgctxt "STRINGS.HERMITCRAB_GOT_MAPSCROLL_GOOD.2"
msgid "At least it's away from that junk collector."
msgstr "Se non altro, è lontana da quel collezionista di rottami."

#. STRINGS.HERMITCRAB_GOT_MAPSCROLL_GOOD.3
msgctxt "STRINGS.HERMITCRAB_GOT_MAPSCROLL_GOOD.3"
msgid "I would go but..."
msgstr "Ci andrei, ma..."

#. STRINGS.HERMITCRAB_GOT_MAPSCROLL_GOOD.4
msgctxt "STRINGS.HERMITCRAB_GOT_MAPSCROLL_GOOD.4"
msgid "No. I'm going."
msgstr "No. Ho deciso che ci vado."

#. STRINGS.HERMITCRAB_GOT_MAPSCROLL_GOOD.5
msgctxt "STRINGS.HERMITCRAB_GOT_MAPSCROLL_GOOD.5"
msgid "I'm done waiting for him."
msgstr "Sono stufa di aspettarlo."

#. STRINGS.HERMITCRAB_GOT_PEARL.1
msgctxt "STRINGS.HERMITCRAB_GOT_PEARL.1"
msgid "Oh..."
msgstr "Oh..."

#. STRINGS.HERMITCRAB_GOT_PEARL.2
msgctxt "STRINGS.HERMITCRAB_GOT_PEARL.2"
msgid "...I think I understand now."
msgstr "... Ora penso di capire."

#. STRINGS.HERMITCRAB_GOT_PEARL.3
msgctxt "STRINGS.HERMITCRAB_GOT_PEARL.3"
msgid "Thank you for bringing this back to me."
msgstr "Grazie per avermela riportata."

#. STRINGS.HERMITCRAB_GOT_PEARL.4
msgctxt "STRINGS.HERMITCRAB_GOT_PEARL.4"
msgid "I'm so glad you kept coming back."
msgstr "Sono così felice che tu sia di nuovo qui."

#. STRINGS.HERMITCRAB_GOT_PEARL.5
msgctxt "STRINGS.HERMITCRAB_GOT_PEARL.5"
msgid "My friend."
msgstr "Ti ringrazio molto."

#. STRINGS.HERMITCRAB_GOT_PEARL.6
msgctxt "STRINGS.HERMITCRAB_GOT_PEARL.6"
msgid "As a small token of my appreciation, I'd like to share my special creation with you."
msgstr "Non è molto, ma voglio ringraziarti condividendo la mia speciale creazione con te."

#. STRINGS.HERMITCRAB_GO_HOME.1
msgctxt "STRINGS.HERMITCRAB_GO_HOME.1"
msgid "Time to rest this old chitin."
msgstr "È ora di riposare questa chitina stanca."

#. STRINGS.HERMITCRAB_GREETING.0.1
msgctxt "STRINGS.HERMITCRAB_GREETING.0.1"
msgid "Go away!"
msgstr "Vattene!"

#. STRINGS.HERMITCRAB_GREETING.0.2
msgctxt "STRINGS.HERMITCRAB_GREETING.0.2"
msgid "Shoo!"
msgstr "Sciò!"

#. STRINGS.HERMITCRAB_GREETING.0.3
msgctxt "STRINGS.HERMITCRAB_GREETING.0.3"
msgid "Leave me alone!"
msgstr "Lasciami stare!"

#. STRINGS.HERMITCRAB_GREETING.0.4
msgctxt "STRINGS.HERMITCRAB_GREETING.0.4"
msgid "No trespassing!"
msgstr "Vietato l'ingresso!"

#. STRINGS.HERMITCRAB_GREETING.0.5
msgctxt "STRINGS.HERMITCRAB_GREETING.0.5"
msgid "Get off my beach!"
msgstr "Via dalla mia spiaggia!"

#. STRINGS.HERMITCRAB_GREETING.1.1
msgctxt "STRINGS.HERMITCRAB_GREETING.1.1"
msgid "Hmph."
msgstr "Uhm."

#. STRINGS.HERMITCRAB_GREETING.1.2
msgctxt "STRINGS.HERMITCRAB_GREETING.1.2"
msgid "Go find someone else to bother!"
msgstr "Vai a trovare qualcun altro a cui dare fastidio!"

#. STRINGS.HERMITCRAB_GREETING.10.1
msgctxt "STRINGS.HERMITCRAB_GREETING.10.1"
msgid "How have you been, dearie?"
msgstr "Come stai, tesoro?"

#. STRINGS.HERMITCRAB_GREETING.10.2
msgctxt "STRINGS.HERMITCRAB_GREETING.10.2"
msgid "If it isn't my favorite visitor!"
msgstr "Sei proprio la mia persona preferita!"

#. STRINGS.HERMITCRAB_GREETING.10.3
msgctxt "STRINGS.HERMITCRAB_GREETING.10.3"
msgid "Are you eating enough?"
msgstr "Mangi abbastanza?"

#. STRINGS.HERMITCRAB_GREETING.2.1
msgctxt "STRINGS.HERMITCRAB_GREETING.2.1"
msgid "What are you doing here?"
msgstr "Che ci fai qui?"

#. STRINGS.HERMITCRAB_GREETING.2.2
msgctxt "STRINGS.HERMITCRAB_GREETING.2.2"
msgid "What do you want?"
msgstr "Che cosa vuoi?"

#. STRINGS.HERMITCRAB_GREETING.3.1
msgctxt "STRINGS.HERMITCRAB_GREETING.3.1"
msgid "You're back?"
msgstr "Di nuovo qui?"

#. STRINGS.HERMITCRAB_GREETING.3.2
msgctxt "STRINGS.HERMITCRAB_GREETING.3.2"
msgid "Don't you have anything better to do?"
msgstr "Non hai niente di meglio da fare?"

#. STRINGS.HERMITCRAB_GREETING.3.3
msgctxt "STRINGS.HERMITCRAB_GREETING.3.3"
msgid "Troublesome whipper-snapper..."
msgstr "Combinaguai che non sei altro..."

#. STRINGS.HERMITCRAB_GREETING.4.1.1
msgctxt "STRINGS.HERMITCRAB_GREETING.4.1.1"
msgid "You're persistent"
msgstr "La tenacia è una delle tue qualità."

#. STRINGS.HERMITCRAB_GREETING.4.1.2
msgctxt "STRINGS.HERMITCRAB_GREETING.4.1.2"
msgid "I'll give you that."
msgstr "Te lo concedo."

#. STRINGS.HERMITCRAB_GREETING.4.2
msgctxt "STRINGS.HERMITCRAB_GREETING.4.2"
msgid "Hmph. Just don't make a nuisance of yourself."
msgstr "Ma vedi di non approfittare di me."

#. STRINGS.HERMITCRAB_GREETING.5.1
msgctxt "STRINGS.HERMITCRAB_GREETING.5.1"
msgid "Just can't get enough of my sparkling personality, hmm?"
msgstr "Non riesci a fare a meno della mia personalità scoppiettante, eh?"

#. STRINGS.HERMITCRAB_GREETING.5.2.1
msgctxt "STRINGS.HERMITCRAB_GREETING.5.2.1"
msgid "Well, if it isn't... hm..."
msgstr "Guarda un po' chi arriva!"

#. STRINGS.HERMITCRAB_GREETING.5.2.2
msgctxt "STRINGS.HERMITCRAB_GREETING.5.2.2"
msgid "What was your name?"
msgstr "Com'è che ti chiami?"

#. STRINGS.HERMITCRAB_GREETING.6.1
msgctxt "STRINGS.HERMITCRAB_GREETING.6.1"
msgid "Why are you helping me?"
msgstr "Perché mi stai aiutando?"

#. STRINGS.HERMITCRAB_GREETING.7.1
msgctxt "STRINGS.HERMITCRAB_GREETING.7.1"
msgid "It's been hard taking care of this old place by myself."
msgstr "Da sola è stata dura prendersi cura di questo posto."

#. STRINGS.HERMITCRAB_GREETING.7.2
msgctxt "STRINGS.HERMITCRAB_GREETING.7.2"
msgid "I think I forgot how nice it is to have visitors."
msgstr "Mi ero dimenticata com'è bello avere gente in visita."

#. STRINGS.HERMITCRAB_GREETING.7.3
msgctxt "STRINGS.HERMITCRAB_GREETING.7.3"
msgid "I've been awfully hard on you, haven't I?"
msgstr "Sono stata un po' dura con te, vero?"

#. STRINGS.HERMITCRAB_GREETING.8.1
msgctxt "STRINGS.HERMITCRAB_GREETING.8.1"
msgid "Hello again!"
msgstr "Guarda un po' chi si rivede!"

#. STRINGS.HERMITCRAB_GREETING.8.2
msgctxt "STRINGS.HERMITCRAB_GREETING.8.2"
msgid "Well, if it isn't %s!"
msgstr "Ecco che arriva %s!"

#. STRINGS.HERMITCRAB_GREETING.9.1
msgctxt "STRINGS.HERMITCRAB_GREETING.9.1"
msgid "It's so nice to see you, dearie!"
msgstr "È bello vederti, tesoro!"

#. STRINGS.HERMITCRAB_GREETING.9.2.1
msgctxt "STRINGS.HERMITCRAB_GREETING.9.2.1"
msgid "This world is so full of dangers..."
msgstr "Questo mondo è pieno di pericoli..."

#. STRINGS.HERMITCRAB_GREETING.9.2.2
msgctxt "STRINGS.HERMITCRAB_GREETING.9.2.2"
msgid "You be careful out there, alright?"
msgstr "Cerca di fare attenzione là fuori, ok?"

#. STRINGS.HERMITCRAB_GROUP_REWARD.HIGH.1
msgctxt "STRINGS.HERMITCRAB_GROUP_REWARD.HIGH.1"
msgid "You've done such a wonderful job!"
msgstr "Hai fatto davvero un ottimo lavoro!"

#. STRINGS.HERMITCRAB_GROUP_REWARD.HIGH.2
msgctxt "STRINGS.HERMITCRAB_GROUP_REWARD.HIGH.2"
msgid "Here, it's the least I can do."
msgstr "Ecco a te, è il meno che io possa fare."

#. STRINGS.HERMITCRAB_GROUP_REWARD.LOW.1
msgctxt "STRINGS.HERMITCRAB_GROUP_REWARD.LOW.1"
msgid "I don't know what you're playing at"
msgstr "Non so cosa ti aspettassi."

#. STRINGS.HERMITCRAB_GROUP_REWARD.LOW.2
msgctxt "STRINGS.HERMITCRAB_GROUP_REWARD.LOW.2"
msgid "but don't think I owe you now!"
msgstr "Così dovremmo essere a posto!"

#. STRINGS.HERMITCRAB_GROUP_REWARD.MED.1
msgctxt "STRINGS.HERMITCRAB_GROUP_REWARD.MED.1"
msgid "You've been busy! I suppose I should repay you."
msgstr "Hai avuto parecchio da fare! Immagino di doverti ripagare."

#. STRINGS.HERMITCRAB_HARVESTMEAT.HIGH.1
msgctxt "STRINGS.HERMITCRAB_HARVESTMEAT.HIGH.1"
msgid "Oooh, I do love some tasty dried meats!"
msgstr "Oooh, sì, avrei proprio voglia di un po' di buona carne secca!"

#. STRINGS.HERMITCRAB_HARVESTMEAT.LOW.1
msgctxt "STRINGS.HERMITCRAB_HARVESTMEAT.LOW.1"
msgid "Hmph... looks pretty stringy."
msgstr "Uhm... Sembra un po' troppo fibrosa."

#. STRINGS.HERMITCRAB_HARVESTMEAT.MED.1
msgctxt "STRINGS.HERMITCRAB_HARVESTMEAT.MED.1"
msgid "Hm... doesn't look too bad."
msgstr "Mmmm... Non sembra male."

#. STRINGS.HERMITCRAB_INTRODUCE.1
msgctxt "STRINGS.HERMITCRAB_INTRODUCE.1"
msgid "You've done so much for me."
msgstr "Hai fatto molto per me."

#. STRINGS.HERMITCRAB_INTRODUCE.2
msgctxt "STRINGS.HERMITCRAB_INTRODUCE.2"
msgid "Please, call me Pearl."
msgstr "Chiamami Perla."

#. STRINGS.HERMITCRAB_INVESTIGATE.ALREADY_KNOWS_CARPENTRY.HIGH.1
msgctxt "STRINGS.HERMITCRAB_INVESTIGATE.ALREADY_KNOWS_CARPENTRY.HIGH.1"
msgid "You already know everything I can teach you, dearie."
msgstr "Sai già tutto quello che posso insegnarti, tesoro."

#. STRINGS.HERMITCRAB_INVESTIGATE.ALREADY_KNOWS_CARPENTRY.LOW.1
msgctxt "STRINGS.HERMITCRAB_INVESTIGATE.ALREADY_KNOWS_CARPENTRY.LOW.1"
msgid "I already gave you my blueprint, quit pestering me!"
msgstr "Ti ho già dato il mio progetto, smettila di infastidirmi!"

#. STRINGS.HERMITCRAB_INVESTIGATE.ALREADY_KNOWS_CARPENTRY.MED.1
msgctxt "STRINGS.HERMITCRAB_INVESTIGATE.ALREADY_KNOWS_CARPENTRY.MED.1"
msgid "Didn't I already give you my blueprint?"
msgstr "Non ti ho già dato il mio progetto?"

#. STRINGS.HERMITCRAB_INVESTIGATE.ALREADY_KNOWS_CARPENTRY.MED.2
msgctxt "STRINGS.HERMITCRAB_INVESTIGATE.ALREADY_KNOWS_CARPENTRY.MED.2"
msgid "Trying to take advantage of a sweet old lady, are you?"
msgstr "E così, stai cercando di approfittarti di una dolce vecchietta?"

#. STRINGS.HERMITCRAB_INVESTIGATE.CARPENTRY_BLUEPRINT_ININVENTORY.HIGH.1
msgctxt "STRINGS.HERMITCRAB_INVESTIGATE.CARPENTRY_BLUEPRINT_ININVENTORY.HIGH.1"
msgid "Have you had a chance to give that blueprint a read, dearie?"
msgstr "Hai già avuto modo di dare un'occhiata a quel progetto, tesoro?"

#. STRINGS.HERMITCRAB_INVESTIGATE.CARPENTRY_BLUEPRINT_ININVENTORY.LOW.1
msgctxt "STRINGS.HERMITCRAB_INVESTIGATE.CARPENTRY_BLUEPRINT_ININVENTORY.LOW.1"
msgid "Leave me alone, I already gave away my blueprint!"
msgstr "Lasciami in pace, ti ho già dato il mio progetto!"

#. STRINGS.HERMITCRAB_INVESTIGATE.CARPENTRY_BLUEPRINT_ININVENTORY.MED.1
msgctxt "STRINGS.HERMITCRAB_INVESTIGATE.CARPENTRY_BLUEPRINT_ININVENTORY.MED.1"
msgid "Still haven't gotten around to reading that blueprint, hm?"
msgstr "Non hai ancora avuto tempo di leggere quel progetto, eh?"

#. STRINGS.HERMITCRAB_INVESTIGATE.CARPENTRY_BLUEPRINT_ONGROUND.HIGH.1
msgctxt "STRINGS.HERMITCRAB_INVESTIGATE.CARPENTRY_BLUEPRINT_ONGROUND.HIGH.1"
msgid "Isn't that my blueprint over there?"
msgstr "Non è il mio progetto quello laggiù?"

#. STRINGS.HERMITCRAB_INVESTIGATE.CARPENTRY_BLUEPRINT_ONGROUND.LOW.1
msgctxt "STRINGS.HERMITCRAB_INVESTIGATE.CARPENTRY_BLUEPRINT_ONGROUND.LOW.1"
msgid "Hmph. Leaving my blueprint lying around like that..."
msgstr "Uhm. Vi sembra il caso di lasciare il mio progetto incustodito?"

#. STRINGS.HERMITCRAB_INVESTIGATE.CARPENTRY_BLUEPRINT_ONGROUND.LOW.2
msgctxt "STRINGS.HERMITCRAB_INVESTIGATE.CARPENTRY_BLUEPRINT_ONGROUND.LOW.2"
msgid "Ungrateful whipper-snappers!"
msgstr "Sbarbatelli ingrati e impertinenti!"

#. STRINGS.HERMITCRAB_INVESTIGATE.CARPENTRY_BLUEPRINT_ONGROUND.MED.1
msgctxt "STRINGS.HERMITCRAB_INVESTIGATE.CARPENTRY_BLUEPRINT_ONGROUND.MED.1"
msgid "If I'd known it would get tossed on the ground,"
msgstr "Se avessi saputo che sarebbe stato gettato per terra..."

#. STRINGS.HERMITCRAB_INVESTIGATE.CARPENTRY_BLUEPRINT_ONGROUND.MED.2
msgctxt "STRINGS.HERMITCRAB_INVESTIGATE.CARPENTRY_BLUEPRINT_ONGROUND.MED.2"
msgid "I wouldn't have bothered giving up that blueprint!"
msgstr "Non mi sarei presa il disturbo di rinunciare a quel progetto!"

#. STRINGS.HERMITCRAB_INVESTIGATE.FILL_MEATRACKS.HIGH.1
msgctxt "STRINGS.HERMITCRAB_INVESTIGATE.FILL_MEATRACKS.HIGH.1"
msgid "Hoo-hoo! That's some tasty jerky in the making!"
msgstr "Ohhhhh! Quella sì che è della buona carne secca quasi pronta!"

#. STRINGS.HERMITCRAB_INVESTIGATE.FILL_MEATRACKS.LOW.1
msgctxt "STRINGS.HERMITCRAB_INVESTIGATE.FILL_MEATRACKS.LOW.1"
msgid "You don't want it anymore? Has it gone off?"
msgstr "Tu non la vuoi più? È andata a male?"

#. STRINGS.HERMITCRAB_INVESTIGATE.FILL_MEATRACKS.MED.1
msgctxt "STRINGS.HERMITCRAB_INVESTIGATE.FILL_MEATRACKS.MED.1"
msgid "I'll never say no to free meat!"
msgstr "Non dico mai di no a della carne gratis!"

#. STRINGS.HERMITCRAB_INVESTIGATE.GIVE_CARPENTRY_BLUEPRINT.HIGH.1
msgctxt "STRINGS.HERMITCRAB_INVESTIGATE.GIVE_CARPENTRY_BLUEPRINT.HIGH.1"
msgid "Here, let me give you a few pointers."
msgstr "Ecco, lascia che ti dia qualche dritta."

#. STRINGS.HERMITCRAB_INVESTIGATE.GIVE_CARPENTRY_BLUEPRINT.LOW.1
msgctxt "STRINGS.HERMITCRAB_INVESTIGATE.GIVE_CARPENTRY_BLUEPRINT.LOW.1"
msgid "Here. Learn how to build a proper chair."
msgstr "Guarda. Impara a costruire una sedia come si deve."

#. STRINGS.HERMITCRAB_INVESTIGATE.GIVE_CARPENTRY_BLUEPRINT.MED.1
msgctxt "STRINGS.HERMITCRAB_INVESTIGATE.GIVE_CARPENTRY_BLUEPRINT.MED.1"
msgid "I give you credit for trying, but next time get it right."
msgstr "Devo riconoscere che ci hai provato, ma la prossima volta fallo come si deve."

#. STRINGS.HERMITCRAB_INVESTIGATE.MAKE_CHAIR.HIGH.1
msgctxt "STRINGS.HERMITCRAB_INVESTIGATE.MAKE_CHAIR.HIGH.1"
msgid "It's lovely, dearie! The perfect place to rest my aching shell."
msgstr "È uno splendore, tesoro! Il posto perfetto per far riposare il mio guscio dolorante."

#. STRINGS.HERMITCRAB_INVESTIGATE.MAKE_CHAIR.LOW.1
msgctxt "STRINGS.HERMITCRAB_INVESTIGATE.MAKE_CHAIR.LOW.1"
msgid "Hmph. Well, at least it looks like it won't fall apart."
msgstr "Umpf. Beh, se non altro, sembra che non andrà in pezzi."

#. STRINGS.HERMITCRAB_INVESTIGATE.MAKE_CHAIR.MED.1
msgctxt "STRINGS.HERMITCRAB_INVESTIGATE.MAKE_CHAIR.MED.1"
msgid "I didn't take you for a carpenter, much less a half-competent one!"
msgstr "Non pensavo ti occupassi di carpenteria, né che avessi un briciolo di talento!"

#. STRINGS.HERMITCRAB_INVESTIGATE.MAKE_UNCOMFORTABLE_CHAIR.HIGH.1
msgctxt "STRINGS.HERMITCRAB_INVESTIGATE.MAKE_UNCOMFORTABLE_CHAIR.HIGH.1"
msgid "Oh. Well... I can tell you worked hard on it, dearie!"
msgstr "Oh. Beh... Vedo che hai lavorato sodo, tesoro!"

#. STRINGS.HERMITCRAB_INVESTIGATE.MAKE_UNCOMFORTABLE_CHAIR.LOW.1
msgctxt "STRINGS.HERMITCRAB_INVESTIGATE.MAKE_UNCOMFORTABLE_CHAIR.LOW.1"
msgid "You expect me to sit on that rickety thing?"
msgstr "Ti aspetti che mi sieda su quella cosa traballante?"

#. STRINGS.HERMITCRAB_INVESTIGATE.MAKE_UNCOMFORTABLE_CHAIR.MED.1
msgctxt "STRINGS.HERMITCRAB_INVESTIGATE.MAKE_UNCOMFORTABLE_CHAIR.MED.1"
msgid "Is that a chair, or an art project gone wrong?"
msgstr "È una sedia o un progetto artistico andato male?"

#. STRINGS.HERMITCRAB_INVESTIGATE.PLANT_BERRIES.HIGH.1
msgctxt "STRINGS.HERMITCRAB_INVESTIGATE.PLANT_BERRIES.HIGH.1"
msgid "You are quite the gardener, dearie!"
msgstr "Tu sì che hai il pollice verde, tesoro!"

#. STRINGS.HERMITCRAB_INVESTIGATE.PLANT_BERRIES.LOW.1
msgctxt "STRINGS.HERMITCRAB_INVESTIGATE.PLANT_BERRIES.LOW.1"
msgid "Well. At least you're doing something useful."
msgstr "Beh, almeno stai facendo qualcosa di utile."

#. STRINGS.HERMITCRAB_INVESTIGATE.PLANT_BERRIES.MED.1
msgctxt "STRINGS.HERMITCRAB_INVESTIGATE.PLANT_BERRIES.MED.1"
msgid "Maybe another one over there?"
msgstr "Magari un'altra pianta laggiù?"

#. STRINGS.HERMITCRAB_INVESTIGATE.PLANT_FLOWERS.HIGH.1
msgctxt "STRINGS.HERMITCRAB_INVESTIGATE.PLANT_FLOWERS.HIGH.1"
msgid "How pretty!"
msgstr "Come sono belli!"

#. STRINGS.HERMITCRAB_INVESTIGATE.PLANT_FLOWERS.LOW.1
msgctxt "STRINGS.HERMITCRAB_INVESTIGATE.PLANT_FLOWERS.LOW.1"
msgid "Huh? What are you doing?"
msgstr "Eh? Cosa stai facendo?"

#. STRINGS.HERMITCRAB_INVESTIGATE.PLANT_FLOWERS.MED.1
msgctxt "STRINGS.HERMITCRAB_INVESTIGATE.PLANT_FLOWERS.MED.1"
msgid "Hm... those look nice."
msgstr "Mmmm... Sono proprio belli."

#. STRINGS.HERMITCRAB_INVESTIGATE.REMOVE_LUREPLANT.HIGH.1
msgctxt "STRINGS.HERMITCRAB_INVESTIGATE.REMOVE_LUREPLANT.HIGH.1"
msgid "You really showed that awful plant!"
msgstr "Gliel'hai fatta vedere a quella pianta terribile!"

#. STRINGS.HERMITCRAB_INVESTIGATE.REMOVE_LUREPLANT.LOW.1
msgctxt "STRINGS.HERMITCRAB_INVESTIGATE.REMOVE_LUREPLANT.LOW.1"
msgid "Fantastic. My old pest was removed by my new pest."
msgstr "Fantastico. Il parassita vecchio è stato eliminato da quello nuovo."

#. STRINGS.HERMITCRAB_INVESTIGATE.REMOVE_LUREPLANT.MED.1
msgctxt "STRINGS.HERMITCRAB_INVESTIGATE.REMOVE_LUREPLANT.MED.1"
msgid "Well, glad that's taken care of."
msgstr "Bene, sono felice che il problema sia stato risolto."

#. STRINGS.HERMITCRAB_LEVEL10_LOWHEALTH.1.1
msgctxt "STRINGS.HERMITCRAB_LEVEL10_LOWHEALTH.1.1"
msgid "Goodness, what happened to you?"
msgstr "Santo cielo, cosa ti è successo?"

#. STRINGS.HERMITCRAB_LEVEL10_LOWHEALTH.1.2
msgctxt "STRINGS.HERMITCRAB_LEVEL10_LOWHEALTH.1.2"
msgid "You need to be more careful!"
msgstr "Devi fare più attenzione!"

#. STRINGS.HERMITCRAB_LEVEL10_LOWHUNGER.1.1
msgctxt "STRINGS.HERMITCRAB_LEVEL10_LOWHUNGER.1.1"
msgid "Hmph... you look skinny."
msgstr "Uhm... Mi sembra che tu abbia perso peso."

#. STRINGS.HERMITCRAB_LEVEL10_LOWHUNGER.1.2
msgctxt "STRINGS.HERMITCRAB_LEVEL10_LOWHUNGER.1.2"
msgid "Have you been eating well?"
msgstr "Ma mangi abbastanza?"

#. STRINGS.HERMITCRAB_LEVEL10_LOWSANITY.1.1
msgctxt "STRINGS.HERMITCRAB_LEVEL10_LOWSANITY.1.1"
msgid "You look like something's troubling you."
msgstr "Sembra che ci sia qualcosa che ti preoccupa."

#. STRINGS.HERMITCRAB_LEVEL10_LOWSANITY.1.2
msgctxt "STRINGS.HERMITCRAB_LEVEL10_LOWSANITY.1.2"
msgid "Is everything alright, dearie?"
msgstr "Va tutto bene, tesoro?"

#. STRINGS.HERMITCRAB_LEVEL10_PLAYERGOOD.1
msgctxt "STRINGS.HERMITCRAB_LEVEL10_PLAYERGOOD.1"
msgid "Glad to see you looking well, dearie."
msgstr "Sono felice di vedere che stai bene, tesoro."

#. STRINGS.HERMITCRAB_MOON_FISSURE_VENT.HIGH.1
msgctxt "STRINGS.HERMITCRAB_MOON_FISSURE_VENT.HIGH.1"
msgid "I didn't notice those weird spooks until I'd settled in."
msgstr "Finché non mi sono trasferita non avevo notato quegli strani fantasmi."

#. STRINGS.HERMITCRAB_MOON_FISSURE_VENT.HIGH.2
msgctxt "STRINGS.HERMITCRAB_MOON_FISSURE_VENT.HIGH.2"
msgid "They were awful, made my shell crawl..."
msgstr "Erano terribili, mi facevano accapponare il carapace..."

#. STRINGS.HERMITCRAB_MOON_FISSURE_VENT.HIGH.3
msgctxt "STRINGS.HERMITCRAB_MOON_FISSURE_VENT.HIGH.3"
msgid "One of us had to go, and it wasn't going to be me!"
msgstr "Uno di noi avrebbe dovuto andarsene e quella non sarei stata io!"

#. STRINGS.HERMITCRAB_MOON_FISSURE_VENT.LOW.1
msgctxt "STRINGS.HERMITCRAB_MOON_FISSURE_VENT.LOW.1"
msgid "Took me forever to plug up those darn fissures..."
msgstr "Mi ci è voluta una vita a tappare quelle dannate fessure..."

#. STRINGS.HERMITCRAB_MOON_FISSURE_VENT.LOW.2
msgctxt "STRINGS.HERMITCRAB_MOON_FISSURE_VENT.LOW.2"
msgid "Don't go messing with those!"
msgstr "Tu non andare a immischiarti!"

#. STRINGS.HERMITCRAB_MOON_FISSURE_VENT.MED.1
msgctxt "STRINGS.HERMITCRAB_MOON_FISSURE_VENT.MED.1"
msgid "Not the best lawn ornaments, but they keep the head clear."
msgstr "Non sono le migliori decorazioni da giardino, ma almeno mi permettono di tenere la testa occupata."

#. STRINGS.HERMITCRAB_PANIC.1
msgctxt "STRINGS.HERMITCRAB_PANIC.1"
msgid "I can't see a darn thing!"
msgstr "Non vedo a un palmo dalle mie chele!"

#. STRINGS.HERMITCRAB_PANICFIRE.1
msgctxt "STRINGS.HERMITCRAB_PANICFIRE.1"
msgid "Aaah! I will NOT be broiled!"
msgstr "Aaah! NON finirò grigliata!"

#. STRINGS.HERMITCRAB_PANICHAUNT.1
msgctxt "STRINGS.HERMITCRAB_PANICHAUNT.1"
msgid "You're not taking me yet, spirits!"
msgstr "Non è ancora arrivato il momento di portarmi via, spiriti!"

#. STRINGS.HERMITCRAB_PLANTED_LUREPLANT_DIED.HIGH.1
msgctxt "STRINGS.HERMITCRAB_PLANTED_LUREPLANT_DIED.HIGH.1"
msgid "Dearie, I know you planted that.\nYou don't need to impress me."
msgstr "Tesoro, so che l'hai piantata tu.\nNon devi stupirmi."

#. STRINGS.HERMITCRAB_PLANTED_LUREPLANT_DIED.LOW.1
msgctxt "STRINGS.HERMITCRAB_PLANTED_LUREPLANT_DIED.LOW.1"
msgid "Nice try.\nYou don't get anything for cleaning up your own messes."
msgstr "Ci hai provato.\nQuando si rimedia ai propri sbagli non si ricevono premi."

#. STRINGS.HERMITCRAB_PLANTED_LUREPLANT_DIED.MED.1
msgctxt "STRINGS.HERMITCRAB_PLANTED_LUREPLANT_DIED.MED.1"
msgid "Do you want a reward that bad?"
msgstr "Hai disperatamente bisogno di una ricompensa?"

#. STRINGS.HERMITCRAB_REFUSE_COAT.1
msgctxt "STRINGS.HERMITCRAB_REFUSE_COAT.1"
msgid "You keep it, I'm not chilly."
msgstr "Tienilo pure, non ho freddo."

#. STRINGS.HERMITCRAB_REFUSE_COAT_HASONE.1
msgctxt "STRINGS.HERMITCRAB_REFUSE_COAT_HASONE.1"
msgid "I like the coat I have, thank you very much."
msgstr "Mi piace il cappotto che ho già, grazie mille."

#. STRINGS.HERMITCRAB_REFUSE_ICE_HAD.1
msgctxt "STRINGS.HERMITCRAB_REFUSE_ICE_HAD.1"
msgid "I don't need any more ice."
msgstr "Non mi serve dell'altro ghiaccio."

#. STRINGS.HERMITCRAB_REFUSE_ICE_HOT.1
msgctxt "STRINGS.HERMITCRAB_REFUSE_ICE_HOT.1"
msgid "Don't be silly, it's already freezing out here!"
msgstr "Non dire sciocchezze, fa già freddo là fuori!"

#. STRINGS.HERMITCRAB_REFUSE_MAPSCROLL.1
msgctxt "STRINGS.HERMITCRAB_REFUSE_MAPSCROLL.1"
msgid "I don't need that, my house is here!"
msgstr "Non ne ho bisogno, questa è la mia casa!"

#. STRINGS.HERMITCRAB_REFUSE_SALAD.1
msgctxt "STRINGS.HERMITCRAB_REFUSE_SALAD.1"
msgid "I don't want that right now..."
msgstr "Adesso non ne ho voglia..."

#. STRINGS.HERMITCRAB_REFUSE_SALAD.2
msgctxt "STRINGS.HERMITCRAB_REFUSE_SALAD.2"
msgid "it makes me too sad..."
msgstr "Mi fa troppa tristezza..."

#. STRINGS.HERMITCRAB_REFUSE_SMALL_FISH.1
msgctxt "STRINGS.HERMITCRAB_REFUSE_SMALL_FISH.1"
msgid "You think {weight} is impressive?\nWhat is that, a minnow?"
msgstr "Pensi che {weight} sia molto?\nChe cos'è, una sanguinerola?"

#. STRINGS.HERMITCRAB_REFUSE_SMALL_FISH.2
msgctxt "STRINGS.HERMITCRAB_REFUSE_SMALL_FISH.2"
msgid "Wow, {weight}...\nI've never caught a fish this small."
msgstr "Wow, {weight}...\nNon ho mai preso un pesce così piccolo."

#. STRINGS.HERMITCRAB_REFUSE_SMALL_FISH.3
msgctxt "STRINGS.HERMITCRAB_REFUSE_SMALL_FISH.3"
msgid "Only {weight}?\nYou should have put it back."
msgstr "Solo {weight}?\nSarebbe meglio ributtarlo nell'acqua."

#. STRINGS.HERMITCRAB_REFUSE_UMBRELLA.1
msgctxt "STRINGS.HERMITCRAB_REFUSE_UMBRELLA.1"
msgid "It's not even raining..."
msgstr "Non piove neanche..."

#. STRINGS.HERMITCRAB_REFUSE_UMBRELLA_HASONE.1
msgctxt "STRINGS.HERMITCRAB_REFUSE_UMBRELLA_HASONE.1"
msgid "My own umbrella will do just fine, thank you."
msgstr "L'ombrello che ho già va benissimo, grazie."

#. STRINGS.HERMITCRAB_REFUSE_VEST.1
msgctxt "STRINGS.HERMITCRAB_REFUSE_VEST.1"
msgid "I'd boil if I wore that in this heat!"
msgstr "Se indossassi una cosa del genere con questo caldo, mi scioglierei!"

#. STRINGS.HERMITCRAB_REWARD.FILL_MEATRACKS.HIGH.1
msgctxt "STRINGS.HERMITCRAB_REWARD.FILL_MEATRACKS.HIGH.1"
msgid "I hope it wasn't too much trouble..."
msgstr "Spero che non sia stato troppo disturbo..."

#. STRINGS.HERMITCRAB_REWARD.FILL_MEATRACKS.LOW.1
msgctxt "STRINGS.HERMITCRAB_REWARD.FILL_MEATRACKS.LOW.1"
msgid "Let me guess, you want something in return? Fine..."
msgstr "Fammi indovinare, vuoi qualcosa in cambio? Va bene..."

#. STRINGS.HERMITCRAB_REWARD.FILL_MEATRACKS.MED.1
msgctxt "STRINGS.HERMITCRAB_REWARD.FILL_MEATRACKS.MED.1"
msgid "Thanks... but don't think this means we're friends!"
msgstr "Grazie. Ma non pensare che questo significhi che ora sia tua amica!"

#. STRINGS.HERMITCRAB_REWARD.FIX_HOUSE_1.HIGH.1
msgctxt "STRINGS.HERMITCRAB_REWARD.FIX_HOUSE_1.HIGH.1"
msgid "My goodness, it looks good as new!"
msgstr "Santo cielo, sembra come nuova!"

#. STRINGS.HERMITCRAB_REWARD.FIX_HOUSE_1.LOW.1
msgctxt "STRINGS.HERMITCRAB_REWARD.FIX_HOUSE_1.LOW.1"
msgid "Oh good, you didn't completely ruin my house."
msgstr "Ah bene, non l'hai rovinata completamente, la mia casa."

#. STRINGS.HERMITCRAB_REWARD.FIX_HOUSE_1.MED.1
msgctxt "STRINGS.HERMITCRAB_REWARD.FIX_HOUSE_1.MED.1"
msgid "I'd been meaning to fix the place up for a while..."
msgstr "Era da un po' che avevo intenzione di sistemare casa..."

#. STRINGS.HERMITCRAB_REWARD.FIX_HOUSE_2.HIGH.1
msgctxt "STRINGS.HERMITCRAB_REWARD.FIX_HOUSE_2.HIGH.1"
msgid "Oh dearie, I love what you've done with the place!"
msgstr "Oh tesoro! Adoro quello che hai fatto alla mia casetta!"

#. STRINGS.HERMITCRAB_REWARD.FIX_HOUSE_2.LOW.1
msgctxt "STRINGS.HERMITCRAB_REWARD.FIX_HOUSE_2.LOW.1"
msgid "...I suppose that is an improvement."
msgstr "... Immagino che sia da annoverare tra le migliorie."

#. STRINGS.HERMITCRAB_REWARD.FIX_HOUSE_2.MED.1
msgctxt "STRINGS.HERMITCRAB_REWARD.FIX_HOUSE_2.MED.1"
msgid "You... did this for me...?"
msgstr "Lo hai... fatto per me?"

#. STRINGS.HERMITCRAB_REWARD.FIX_HOUSE_3.HIGH.1
msgctxt "STRINGS.HERMITCRAB_REWARD.FIX_HOUSE_3.HIGH.1"
msgid "Oh, it's wonderful!"
msgstr "Oh, ma è una delizia per gli occhi!"

#. STRINGS.HERMITCRAB_REWARD.FIX_HOUSE_3.HIGH.2
msgctxt "STRINGS.HERMITCRAB_REWARD.FIX_HOUSE_3.HIGH.2"
msgid "I feel like a Queen in her palace"
msgstr "Mi sento come la regina nel suo palazzo."

#. STRINGS.HERMITCRAB_REWARD.FIX_HOUSE_3.HIGH.3
msgctxt "STRINGS.HERMITCRAB_REWARD.FIX_HOUSE_3.HIGH.3"
msgid "Hoo-hoo!"
msgstr "Ohhhh!"

#. STRINGS.HERMITCRAB_REWARD.FIX_HOUSE_3.LOW.1
msgctxt "STRINGS.HERMITCRAB_REWARD.FIX_HOUSE_3.LOW.1"
msgid "Oh. That does look a bit better."
msgstr "Oh. Così va un po' meglio."

#. STRINGS.HERMITCRAB_REWARD.FIX_HOUSE_3.MED.1
msgctxt "STRINGS.HERMITCRAB_REWARD.FIX_HOUSE_3.MED.1"
msgid "I barely recognize the place!"
msgstr "Stento a riconoscerlo, questo posto!"

#. STRINGS.HERMITCRAB_REWARD.FIX_HOUSE_3.MED.2
msgctxt "STRINGS.HERMITCRAB_REWARD.FIX_HOUSE_3.MED.2"
msgid "Oh don't look worried, that's a good thing."
msgstr "Oh, non ti preoccuparti, non è una cosa negativa."

#. STRINGS.HERMITCRAB_REWARD.GIVE_FISH_AUTUM.HIGH.1
msgctxt "STRINGS.HERMITCRAB_REWARD.GIVE_FISH_AUTUM.HIGH.1"
msgid "Thank you dearie! Here, why don't you take one of these."
msgstr "Grazie, tesoro! Ecco, tieni. Perché non prendi uno di questi?"

#. STRINGS.HERMITCRAB_REWARD.GIVE_FISH_AUTUM.LOW.1
msgctxt "STRINGS.HERMITCRAB_REWARD.GIVE_FISH_AUTUM.LOW.1"
msgid "Hmph. You could've caught it faster if you used this."
msgstr "Uhm. Avresti potuto prenderli più velocemente se avessi usato questo."

#. STRINGS.HERMITCRAB_REWARD.GIVE_FISH_AUTUM.MED.1
msgctxt "STRINGS.HERMITCRAB_REWARD.GIVE_FISH_AUTUM.MED.1"
msgid "Oh... thanks. Here, take this for your trouble."
msgstr "Oh... grazie. Ecco a te, per il disturbo."

#. STRINGS.HERMITCRAB_REWARD.GIVE_FISH_SPRING.HIGH.1
msgctxt "STRINGS.HERMITCRAB_REWARD.GIVE_FISH_SPRING.HIGH.1"
msgid "Thank you dearie! Here, why don't you take one of these."
msgstr "Grazie, tesoro! Ecco, tieni. Perché non prendi uno di questi?"

#. STRINGS.HERMITCRAB_REWARD.GIVE_FISH_SPRING.LOW.1
msgctxt "STRINGS.HERMITCRAB_REWARD.GIVE_FISH_SPRING.LOW.1"
msgid "Hmph. You could've caught it faster if you used this."
msgstr "Uhm. Avresti potuto prenderli più velocemente se avessi usato questo."

#. STRINGS.HERMITCRAB_REWARD.GIVE_FISH_SPRING.MED.1
msgctxt "STRINGS.HERMITCRAB_REWARD.GIVE_FISH_SPRING.MED.1"
msgid "Oh... thanks. Here, take this for your trouble."
msgstr "Oh... grazie. Ecco a te, per il disturbo."

#. STRINGS.HERMITCRAB_REWARD.GIVE_FISH_SUMMER.HIGH.1
msgctxt "STRINGS.HERMITCRAB_REWARD.GIVE_FISH_SUMMER.HIGH.1"
msgid "Thank you dearie! Here, why don't you take one of these."
msgstr "Grazie, tesoro! Ecco, tieni. Perché non prendi uno di questi?"

#. STRINGS.HERMITCRAB_REWARD.GIVE_FISH_SUMMER.LOW.1
msgctxt "STRINGS.HERMITCRAB_REWARD.GIVE_FISH_SUMMER.LOW.1"
msgid "Hmph. You could've caught it faster if you used this."
msgstr "Uhm. Avresti potuto prenderli più velocemente se avessi usato questo."

#. STRINGS.HERMITCRAB_REWARD.GIVE_FISH_SUMMER.MED.1
msgctxt "STRINGS.HERMITCRAB_REWARD.GIVE_FISH_SUMMER.MED.1"
msgid "Oh... thanks. Here, take this for your trouble."
msgstr "Oh... grazie. Ecco a te, per il disturbo."

#. STRINGS.HERMITCRAB_REWARD.GIVE_FISH_WINTER.HIGH.1
msgctxt "STRINGS.HERMITCRAB_REWARD.GIVE_FISH_WINTER.HIGH.1"
msgid "Thank you dearie! Here, why don't you take one of these."
msgstr "Grazie, tesoro! Ecco, tieni. Perché non prendi uno di questi?"

#. STRINGS.HERMITCRAB_REWARD.GIVE_FISH_WINTER.LOW.1
msgctxt "STRINGS.HERMITCRAB_REWARD.GIVE_FISH_WINTER.LOW.1"
msgid "Hmph. You could've caught it faster if you used this."
msgstr "Uhm. Avresti potuto prenderli più velocemente se avessi usato questo."

#. STRINGS.HERMITCRAB_REWARD.GIVE_FISH_WINTER.MED.1
msgctxt "STRINGS.HERMITCRAB_REWARD.GIVE_FISH_WINTER.MED.1"
msgid "Oh... thanks. Here, take this for your trouble."
msgstr "Oh... grazie. Ecco a te, per il disturbo."

#. STRINGS.HERMITCRAB_REWARD.GIVE_FLOWER_SALAD.HIGH.1
msgctxt "STRINGS.HERMITCRAB_REWARD.GIVE_FLOWER_SALAD.HIGH.1"
msgid "Thank you dearie..."
msgstr "Grazie, tesoro..."

#. STRINGS.HERMITCRAB_REWARD.GIVE_FLOWER_SALAD.HIGH.2
msgctxt "STRINGS.HERMITCRAB_REWARD.GIVE_FLOWER_SALAD.HIGH.2"
msgid "Have you seen any other crabs on your travels?"
msgstr "Durante i tuoi viaggi hai visto altri granchi?"

#. STRINGS.HERMITCRAB_REWARD.GIVE_FLOWER_SALAD.LOW.1
msgctxt "STRINGS.HERMITCRAB_REWARD.GIVE_FLOWER_SALAD.LOW.1"
msgid "..."
msgstr "..."

#. STRINGS.HERMITCRAB_REWARD.GIVE_FLOWER_SALAD.MED.1
msgctxt "STRINGS.HERMITCRAB_REWARD.GIVE_FLOWER_SALAD.MED.1"
msgid "...Thank you. It's been a long time."
msgstr "... Grazie. Ne è passato, di tempo."

#. STRINGS.HERMITCRAB_REWARD.GIVE_FLOWER_SALAD_POST_RELOCATION.1
msgctxt "STRINGS.HERMITCRAB_REWARD.GIVE_FLOWER_SALAD_POST_RELOCATION.1"
msgid "Thank you dearie, I used to love this flower salad."
msgstr "Grazie, tesoro, mi è sempre piaciuta questa insalata di fiori."

#. STRINGS.HERMITCRAB_REWARD.GIVE_HEAVY_FISH.HIGH.1
msgctxt "STRINGS.HERMITCRAB_REWARD.GIVE_HEAVY_FISH.HIGH.1"
msgid "Hoo-hoo!"
msgstr "Ohhhh!"

#. STRINGS.HERMITCRAB_REWARD.GIVE_HEAVY_FISH.HIGH.2
msgctxt "STRINGS.HERMITCRAB_REWARD.GIVE_HEAVY_FISH.HIGH.2"
msgid "That's some pretty impressive fish, dearie!"
msgstr "Oh tesoro! È un pesce che lascia tutti a bocca aperta!"

#. STRINGS.HERMITCRAB_REWARD.GIVE_HEAVY_FISH.LOW.1
msgctxt "STRINGS.HERMITCRAB_REWARD.GIVE_HEAVY_FISH.LOW.1"
msgid "Why are you giving me this?"
msgstr "Perché me lo dai?"

#. STRINGS.HERMITCRAB_REWARD.GIVE_HEAVY_FISH.LOW.2
msgctxt "STRINGS.HERMITCRAB_REWARD.GIVE_HEAVY_FISH.LOW.2"
msgid "Wait, I never said I wouldn't take it!"
msgstr "Aspetta, non ti ho mai detto che non l'avrei preso!"

#. STRINGS.HERMITCRAB_REWARD.GIVE_HEAVY_FISH.MED.1
msgctxt "STRINGS.HERMITCRAB_REWARD.GIVE_HEAVY_FISH.MED.1"
msgid "Ooooh, that's a hefty pile of fish!"
msgstr "Ooooh, questo sì che è un bel mucchio di pesce!"

#. STRINGS.HERMITCRAB_REWARD.GIVE_PUFFY_VEST.HIGH.1
msgctxt "STRINGS.HERMITCRAB_REWARD.GIVE_PUFFY_VEST.HIGH.1"
msgid "Oh dearie, you're so thoughtful!"
msgstr "Oh tesoro, che bel pensiero!"

#. STRINGS.HERMITCRAB_REWARD.GIVE_PUFFY_VEST.LOW.1
msgctxt "STRINGS.HERMITCRAB_REWARD.GIVE_PUFFY_VEST.LOW.1"
msgid "Hmph. At least I won't freeze to death."
msgstr "Uhm. Almeno non morirò congelata."

#. STRINGS.HERMITCRAB_REWARD.GIVE_PUFFY_VEST.MED.1
msgctxt "STRINGS.HERMITCRAB_REWARD.GIVE_PUFFY_VEST.MED.1"
msgid "That's... very nice of you."
msgstr "È... molto gentile da parte tua."

#. STRINGS.HERMITCRAB_REWARD.GIVE_UMBRELLA.HIGH.1
msgctxt "STRINGS.HERMITCRAB_REWARD.GIVE_UMBRELLA.HIGH.1"
msgid "What would I do without you, dearie?"
msgstr "Cosa farei senza di te, tesoro?"

#. STRINGS.HERMITCRAB_REWARD.GIVE_UMBRELLA.LOW.1
msgctxt "STRINGS.HERMITCRAB_REWARD.GIVE_UMBRELLA.LOW.1"
msgid "I guess this will do."
msgstr "Suppongo che questo vada bene."

#. STRINGS.HERMITCRAB_REWARD.GIVE_UMBRELLA.MED.1
msgctxt "STRINGS.HERMITCRAB_REWARD.GIVE_UMBRELLA.MED.1"
msgid "Why are you being so nice to me?"
msgstr "Perché sei così gentile con me?"

#. STRINGS.HERMITCRAB_REWARD.MAKE_CHAIR.HIGH.1
msgctxt "STRINGS.HERMITCRAB_REWARD.MAKE_CHAIR.HIGH.1"
msgid "It's lovely, dearie! The perfect place to rest my aching shell."
msgstr "È uno splendore, tesoro! Il posto perfetto per far riposare il mio guscio dolorante."

#. STRINGS.HERMITCRAB_REWARD.MAKE_CHAIR.LOW.1
msgctxt "STRINGS.HERMITCRAB_REWARD.MAKE_CHAIR.LOW.1"
msgid "Hmph. Well, at least it looks like it won't fall apart."
msgstr "Umpf. Beh, se non altro, sembra che non andrà in pezzi."

#. STRINGS.HERMITCRAB_REWARD.MAKE_CHAIR.MED.1
msgctxt "STRINGS.HERMITCRAB_REWARD.MAKE_CHAIR.MED.1"
msgid "I didn't take you for a carpenter, much less a half-competent one!"
msgstr "Non pensavo ti occupassi di carpenteria, né che avessi un briciolo di talento!"

#. STRINGS.HERMITCRAB_REWARD.PLANT_BERRIES.HIGH.1
msgctxt "STRINGS.HERMITCRAB_REWARD.PLANT_BERRIES.HIGH.1"
msgid "Ooooh, such a thoughtful young whipper-snapper!"
msgstr "Ooooh, che gentile combinaguai!"

#. STRINGS.HERMITCRAB_REWARD.PLANT_BERRIES.HIGH.2
msgctxt "STRINGS.HERMITCRAB_REWARD.PLANT_BERRIES.HIGH.2"
msgid "Let me pinch your cheeks!"
msgstr "Lasciati dare dei pizzicotti sulle guance!"

#. STRINGS.HERMITCRAB_REWARD.PLANT_BERRIES.LOW.1
msgctxt "STRINGS.HERMITCRAB_REWARD.PLANT_BERRIES.LOW.1"
msgid "You could've planted them in neater rows..."
msgstr "Le avresti potute piantare su file più ordinate..."

#. STRINGS.HERMITCRAB_REWARD.PLANT_BERRIES.LOW.2
msgctxt "STRINGS.HERMITCRAB_REWARD.PLANT_BERRIES.LOW.2"
msgid "But I guess it'll do."
msgstr "Ma credo che così vadano bene lo stesso."

#. STRINGS.HERMITCRAB_REWARD.PLANT_BERRIES.MED.1
msgctxt "STRINGS.HERMITCRAB_REWARD.PLANT_BERRIES.MED.1"
msgid "I can't remember the last time I had fresh berries!"
msgstr "Non ricordo l'ultima volta che ho mangiato bacche fresche."

#. STRINGS.HERMITCRAB_REWARD.PLANT_FLOWERS.HIGH.1
msgctxt "STRINGS.HERMITCRAB_REWARD.PLANT_FLOWERS.HIGH.1"
msgid "My bees haven't looked this happy in years!"
msgstr "Erano anni che le mie api non erano così felici!"

#. STRINGS.HERMITCRAB_REWARD.PLANT_FLOWERS.LOW.1
msgctxt "STRINGS.HERMITCRAB_REWARD.PLANT_FLOWERS.LOW.1"
msgid "Well, at least my bees are happy now."
msgstr "Beh, almeno le mie api adesso sono felici."

#. STRINGS.HERMITCRAB_REWARD.PLANT_FLOWERS.MED.1
msgctxt "STRINGS.HERMITCRAB_REWARD.PLANT_FLOWERS.MED.1"
msgid "My bees are buzzing with excitement!"
msgstr "Le mie api ronzano di felicità!"

#. STRINGS.HERMITCRAB_REWARD.REMOVE_JUNK.HIGH.1
msgctxt "STRINGS.HERMITCRAB_REWARD.REMOVE_JUNK.HIGH.1"
msgid "Ahhh..."
msgstr "Ahhh..."

#. STRINGS.HERMITCRAB_REWARD.REMOVE_JUNK.HIGH.2
msgctxt "STRINGS.HERMITCRAB_REWARD.REMOVE_JUNK.HIGH.2"
msgid "It's such a weight off my mind to have that junk gone."
msgstr "Togliendo di torno quella spazzatura, mi sono levata un peso."

#. STRINGS.HERMITCRAB_REWARD.REMOVE_JUNK.LOW.1
msgctxt "STRINGS.HERMITCRAB_REWARD.REMOVE_JUNK.LOW.1"
msgid "Hmph. Took you long enough."
msgstr "Uhm. Ce n'è voluto di tempo."

#. STRINGS.HERMITCRAB_REWARD.REMOVE_JUNK.MED.1
msgctxt "STRINGS.HERMITCRAB_REWARD.REMOVE_JUNK.MED.1"
msgid "Should be easier to fish with all that junk gone!"
msgstr "Ora che quella spazzatura è sparita, dovrebbe essere più facile pescare!"

#. STRINGS.HERMITCRAB_REWARD.REMOVE_LUREPLANT.HIGH.1
msgctxt "STRINGS.HERMITCRAB_REWARD.REMOVE_LUREPLANT.HIGH.1"
msgid "What a relief!"
msgstr "Che sollievo!"

#. STRINGS.HERMITCRAB_REWARD.REMOVE_LUREPLANT.HIGH.2
msgctxt "STRINGS.HERMITCRAB_REWARD.REMOVE_LUREPLANT.HIGH.2"
msgid "That plant's been side-eying me for some time."
msgstr "È un po' di tempo che quella pianta mi guarda storto."

#. STRINGS.HERMITCRAB_REWARD.REMOVE_LUREPLANT.LOW.1
msgctxt "STRINGS.HERMITCRAB_REWARD.REMOVE_LUREPLANT.LOW.1"
msgid "You think you deserve a reward or something?"
msgstr "Pensi di meritare una ricompensa o qualcosa del genere?"

#. STRINGS.HERMITCRAB_REWARD.REMOVE_LUREPLANT.LOW.2
msgctxt "STRINGS.HERMITCRAB_REWARD.REMOVE_LUREPLANT.LOW.2"
msgid "Hmph."
msgstr "Uhm."

#. STRINGS.HERMITCRAB_REWARD.REMOVE_LUREPLANT.MED.1
msgctxt "STRINGS.HERMITCRAB_REWARD.REMOVE_LUREPLANT.MED.1"
msgid "Guess you're at least a half decent weed killer."
msgstr "Estirpi le erbacce in maniera quasi accettabile."

#. STRINGS.HERMITCRAB_STORE_UNLOCK_1.1
msgctxt "STRINGS.HERMITCRAB_STORE_UNLOCK_1.1"
msgid "So do you want to trade?"
msgstr "Sei qui per comprare qualcosa?"

#. STRINGS.HERMITCRAB_STORE_UNLOCK_1.2
msgctxt "STRINGS.HERMITCRAB_STORE_UNLOCK_1.2"
msgid "Or are you just wasting my time?"
msgstr "O vuoi solo farmi perdere tempo?"

#. STRINGS.HERMITCRAB_STORE_UNLOCK_2.1
msgctxt "STRINGS.HERMITCRAB_STORE_UNLOCK_2.1"
msgid "I miiight have some lures to trade..."
msgstr "Potrei avere delle cose interessanti da proporti..."

#. STRINGS.HERMITCRAB_STORE_UNLOCK_2.2
msgctxt "STRINGS.HERMITCRAB_STORE_UNLOCK_2.2"
msgid "if you can afford them."
msgstr "Sempre che tu te le possa permettere."

#. STRINGS.HERMITCRAB_STORE_UNLOCK_3.1
msgctxt "STRINGS.HERMITCRAB_STORE_UNLOCK_3.1"
msgid "Alright, you've twisted my claw."
msgstr "Va bene, se proprio insisti..."

#. STRINGS.HERMITCRAB_STORE_UNLOCK_3.2
msgctxt "STRINGS.HERMITCRAB_STORE_UNLOCK_3.2"
msgid " I'll show you my GOOD lures."
msgstr " Ti faccio vedere le cose migliori."

#. STRINGS.HERMITCRAB_STORE_UNLOCK_4.1
msgctxt "STRINGS.HERMITCRAB_STORE_UNLOCK_4.1"
msgid "I've got some new things to trade,"
msgstr "Ho delle cose nuove da proporti,"

#. STRINGS.HERMITCRAB_STORE_UNLOCK_4.2
msgctxt "STRINGS.HERMITCRAB_STORE_UNLOCK_4.2"
msgid "but they don't come cheap!"
msgstr "ma non sono a buon mercato!"

#. STRINGS.HERMITCRAB_STORE_UNLOCK_5.1
msgctxt "STRINGS.HERMITCRAB_STORE_UNLOCK_5.1"
msgid "This old shell must be going soft..."
msgstr "Mi sono ammorbidita un po' troppo..."

#. STRINGS.HERMITCRAB_STORE_UNLOCK_5.2
msgctxt "STRINGS.HERMITCRAB_STORE_UNLOCK_5.2"
msgid "I put something special in the shop."
msgstr "Ho messo in vendita una cosa veramente speciale."

#. STRINGS.HERMITCRAB_TALK_ONPURCHASE.HIGH.1
msgctxt "STRINGS.HERMITCRAB_TALK_ONPURCHASE.HIGH.1"
msgid "Give me a holler if you need anything else!"
msgstr "Dammi una voce se hai bisogno di altro!"

#. STRINGS.HERMITCRAB_TALK_ONPURCHASE.LOW.1
msgctxt "STRINGS.HERMITCRAB_TALK_ONPURCHASE.LOW.1"
msgid "Great. Now leave me alone."
msgstr "Fantastico. Ora lasciami in pace."

#. STRINGS.HERMITCRAB_TALK_ONPURCHASE.MED.1
msgctxt "STRINGS.HERMITCRAB_TALK_ONPURCHASE.MED.1"
msgid "Pleasure doing business."
msgstr "È un piacere fare affari con te."

#. STRINGS.HERMITCRAB_TALK_ONSKINREQUEST.HIGH.1
msgctxt "STRINGS.HERMITCRAB_TALK_ONSKINREQUEST.HIGH.1"
msgid "Oh! More things to try?"
msgstr "Oh? Nuove cose da provare?"

#. STRINGS.HERMITCRAB_TALK_ONSKINREQUEST.LOW.1
msgctxt "STRINGS.HERMITCRAB_TALK_ONSKINREQUEST.LOW.1"
msgid "What now?"
msgstr "Ancora?"

#. STRINGS.HERMITCRAB_TALK_ONSKINREQUEST.MED.1
msgctxt "STRINGS.HERMITCRAB_TALK_ONSKINREQUEST.MED.1"
msgid "These should better than the last ones."
msgstr "Sembrano migliori degli ultimi."

#. STRINGS.HERMITCRAB_TEASHOP_BURN.1
msgctxt "STRINGS.HERMITCRAB_TEASHOP_BURN.1"
msgid "My shop is on fire!"
msgstr "Il mio chiosco va a fuoco!"

#. STRINGS.HERMITCRAB_TEASHOP_BURN.2
msgctxt "STRINGS.HERMITCRAB_TEASHOP_BURN.2"
msgid "Oh it's a disaster!"
msgstr "Oh, che disastro!"

#. STRINGS.HERMITCRAB_TEASHOP_BURN.3
msgctxt "STRINGS.HERMITCRAB_TEASHOP_BURN.3"
msgid "Why?!"
msgstr "Perché?!"

#. STRINGS.HERMITCRAB_TEASHOP_HIT.1
msgctxt "STRINGS.HERMITCRAB_TEASHOP_HIT.1"
msgid "Why are you doing that, dearie?"
msgstr "Cosa ti prende, tesoro?"

#. STRINGS.HERMITCRAB_TEASHOP_HIT.2
msgctxt "STRINGS.HERMITCRAB_TEASHOP_HIT.2"
msgid "Are you helping me move my shop?"
msgstr "Mi aiuti a trasferire il chiosco?"

#. STRINGS.HERMITCRAB_TEASHOP_HIT.3
msgctxt "STRINGS.HERMITCRAB_TEASHOP_HIT.3"
msgid "Careful, dearie!"
msgstr "Fai attenzione, tesoro!"

#. STRINGS.HERMITCRAB_TEASHOP_IDLE.1
msgctxt "STRINGS.HERMITCRAB_TEASHOP_IDLE.1"
msgid "Nothing beats my brew."
msgstr "Non c'è niente di meglio dei miei infusi."

#. STRINGS.HERMITCRAB_TEASHOP_IDLE.2
msgctxt "STRINGS.HERMITCRAB_TEASHOP_IDLE.2"
msgid "You look thirsty, dearie!"
msgstr "Hai sete, tesoro?"

#. STRINGS.HERMITCRAB_TEASHOP_IDLE.3
msgctxt "STRINGS.HERMITCRAB_TEASHOP_IDLE.3"
msgid "Welcome to Pearl's Tea Shop."
msgstr "Il chiosco degli infusi di Perla è a tua disposizione."

#. STRINGS.HERMITCRAB_TEASHOP_IDLE.4
msgctxt "STRINGS.HERMITCRAB_TEASHOP_IDLE.4"
msgid "Hello, dearie. What would you like?"
msgstr "Ciao, tesoro. Cosa ti verso?"

#. STRINGS.HERMITCRAB_TEASHOP_IDLE.5
msgctxt "STRINGS.HERMITCRAB_TEASHOP_IDLE.5"
msgid "What's your favorite tea?"
msgstr "Qual è il tuo infuso preferito?"

#. STRINGS.HERMITCRAB_TEASHOP_IDLE.6
msgctxt "STRINGS.HERMITCRAB_TEASHOP_IDLE.6"
msgid "Would you like some of my tea?"
msgstr "Ti andrebbe uno dei miei infusi?"

#. STRINGS.HERMITCRAB_TEASHOP_PLAYER_BURN.1
msgctxt "STRINGS.HERMITCRAB_TEASHOP_PLAYER_BURN.1"
msgid "Oh, dearie! What have you done?"
msgstr "Oh, tesoro! Cos'hai combinato?"

#. STRINGS.HERMITCRAB_TEASHOP_PLAYER_BURN.2
msgctxt "STRINGS.HERMITCRAB_TEASHOP_PLAYER_BURN.2"
msgid "Why would you do that, dearie?"
msgstr "Cosa ti è preso, tesoro?"

#. STRINGS.HERMITCRAB_TEASHOP_PLAYER_BURN.3
msgctxt "STRINGS.HERMITCRAB_TEASHOP_PLAYER_BURN.3"
msgid "Oh no! You've burned my shop!"
msgstr "Oh, no! Hai bruciato il mio chiosco!"

#. STRINGS.HERMITCRAB_TEASHOP_TRADE.1
msgctxt "STRINGS.HERMITCRAB_TEASHOP_TRADE.1"
msgid "Have a lovely day!"
msgstr "Buona giornata!"

#. STRINGS.HERMITCRAB_TEASHOP_TRADE.2
msgctxt "STRINGS.HERMITCRAB_TEASHOP_TRADE.2"
msgid "Here you go."
msgstr "Ecco a te."

#. STRINGS.HERMITCRAB_TEASHOP_TRADE.3
msgctxt "STRINGS.HERMITCRAB_TEASHOP_TRADE.3"
msgid "Enjoy, dearie!"
msgstr "Goditelo, tesoro!"

#. STRINGS.HERMITCRAB_TEASHOP_TRADE.4
msgctxt "STRINGS.HERMITCRAB_TEASHOP_TRADE.4"
msgid "I hope you like it!"
msgstr "Spero che ti piaccia!"

