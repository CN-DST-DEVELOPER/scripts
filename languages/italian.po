#. STRINGS.UI.TRADESCREEN.WARNING
msgctxt "STRINGS.UI.TRADESCREEN.WARNING"
msgid "You won't be able to wear an item if you give your last one away! Do you really want to trade these items?"
msgstr "Non sarai in grado di indossare un oggetto se rinunci all'ultimo che ti è rimasto! Vuoi davvero scambiare questi oggetti?"

#. STRINGS.UI.TRADESCREEN.WARNING_SINGLE
msgctxt "STRINGS.UI.TRADESCREEN.WARNING_SINGLE"
msgid "You won't be able to wear an item if you give your last one away! Do you really want to trade this item?"
msgstr "Non sarai in grado di indossare un oggetto se rinunci all'ultimo che ti è rimasto! Vuoi davvero scambiare questo oggetto?"

#. STRINGS.UI.UNLOCKMAXWELL.BODY1
msgctxt "STRINGS.UI.UNLOCKMAXWELL.BODY1"
msgid "The key looks like it will fit. You can free "
msgstr "La chiave sembra entrare. Puoi liberare "

#. STRINGS.UI.UNLOCKMAXWELL.BODY2
msgctxt "STRINGS.UI.UNLOCKMAXWELL.BODY2"
msgid ", but I doubt %s captors will be pleased..."
msgstr ", ma dubito che i %s carcerieri ne saranno lieti..."

#. STRINGS.UI.UNLOCKMAXWELL.NO
msgctxt "STRINGS.UI.UNLOCKMAXWELL.NO"
msgid "No"
msgstr "No"

#. STRINGS.UI.UNLOCKMAXWELL.TITLE
msgctxt "STRINGS.UI.UNLOCKMAXWELL.TITLE"
