msgstr "La pianta, per lo meno, sembra stare bene."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE_PLANTSTRESSED
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE_PLANTSTRESSED"
