msgstr "È bello poter mangiare qualcosa di diverso dalle bacche, per una volta."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.WINTER_FOOD6
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.WINTER_FOOD6"
msgid "I'm puddin' that straight in my mouth!"
msgstr "Me lo mangio con un sol boccone!"

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.WINTER_FOOD7
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.WINTER_FOOD7"
