msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.KNIGHT_YOTH.FOLLOWING"
msgid "That's right, you follow me!"
msgstr "Ecco, bravo, seguimi!"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.KNIGHT_YOTH.FOLLOWING_OTHER
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.KNIGHT_YOTH.FOLLOWING_OTHER"
msgid "Who's bossing you around?"
msgstr "Chi è a darti ordini?"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.KNIGHT_YOTH.GENERIC
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.KNIGHT_YOTH.GENERIC"
msgid "What is your problem, horse?"
msgstr "Che problemi hai, asino?!"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.KOALEFANT_CARCASS
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.KOALEFANT_CARCASS"
msgid "It's dead. Shall I do the honors?"
msgstr "È morto. Faccio io gli onori di casa?"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.KOALEFANT_SUMMER
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.KOALEFANT_SUMMER"
msgid "We will be great friends!"
msgstr "Saremo grandi amici!"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.KOALEFANT_WINTER
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.KOALEFANT_WINTER"
msgid "He sure looks warm..."
msgstr "Ha sicuramente un aspetto caldo..."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.KOALEFIG_TRUNK
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.KOALEFIG_TRUNK"
