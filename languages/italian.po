#. STRINGS.CHARACTERS.WENDY.DESCRIBE.WX78_BACKUPBODY.GENERIC
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.WX78_BACKUPBODY.GENERIC"
msgid "Does this mean WX has a soul?"
msgstr "Significa che WX possiede un'anima?"

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.WX78_DRONE_DELIVERY
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.WX78_DRONE_DELIVERY"
msgid "And they say you can't take it with you."
msgstr "E pensare che dicono che lasciamo tutto qui..."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.WX78_DRONE_SCOUT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.WX78_DRONE_SCOUT"
msgid "Are you ever afraid?"
msgstr "Non hai mai paura?"

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.WX78_DRONE_ZAP
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.WX78_DRONE_ZAP"
msgid "Feels impersonal."
msgstr "Così non sembra personale."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.WX78_DRONE_ZAP_REMOTE.GENERIC
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.WX78_DRONE_ZAP_REMOTE.GENERIC"
msgid "Are we all just being controlled?"
msgstr "Forse siamo solo delle marionette."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.WX78_FOODBRICK.GENERIC
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.WX78_FOODBRICK.GENERIC"
msgid "It's impossible to eat like that."
msgstr "Non è possibile mangiarla in questo stato."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.WX78_FOODBRICK.WET
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.WX78_FOODBRICK.WET"
msgid "I've eaten worse."
msgstr "Ho mangiato di peggio."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.WX78_GESTALTTRAPPER
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.WX78_GESTALTTRAPPER"
msgid "I've thought about it too, Abby."
msgstr "Ci ho pensato anch'io, Abby."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.WX78_INVENTORYCONTAINER.GENERIC
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.WX78_INVENTORYCONTAINER.GENERIC"
msgid "I wonder what remains."
msgstr "Chissà cosa rimane."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.WX78_INVENTORYCONTAINER.HELD
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.WX78_INVENTORYCONTAINER.HELD"
msgid "only_used_by_wx78"
msgstr "only_used_by_wx78"

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.WX78_MODULEREMOVER
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.WX78_MODULEREMOVER"
msgid "What must it be like, to lose a piece of oneself and feel nothing?"
msgstr "Come deve essere perdere una parte di sé stessi e non provare nulla?"

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.WX78_POSSESSEDBODY
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.WX78_POSSESSEDBODY"
msgid "Too bad Abby can't do the same."
msgstr "È un peccato che Abby non possa fare altrettanto."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.WX78_SCANNER.GENERIC
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.WX78_SCANNER.GENERIC"
msgid "Oh. Hello."
msgstr "Oh. Ciao."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.WX78_SCANNER.HUNTING
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.WX78_SCANNER.HUNTING"
msgid "It's too busy to bother with me."
msgstr "È troppo impegnato per preoccuparsi di me..."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.WX78_SCANNER.SCANNING
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.WX78_SCANNER.SCANNING"
msgid "It's too busy to bother with me."
msgstr "È troppo impegnato per preoccuparsi di me..."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.WX78_SCANNER_ITEM
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.WX78_SCANNER_ITEM"
msgid "Dead to the world."
msgstr "Morto nel mondo."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.WX78_SCANNER_SUCCEEDED
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.WX78_SCANNER_SUCCEEDED"
msgid "Poor little machine. Is nobody paying attention to you?"
msgstr "Povera macchinina. Non c'è nessuno a prestarti attenzione?"

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.WX78_SHADOWDRONE_DEBUFFER
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.WX78_SHADOWDRONE_DEBUFFER"
msgid "What if the enemy is my own heart?"
msgstr "E se il nemico fosse il mio stesso cuore?"

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.WX78_SHADOWDRONE_HARVESTER
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.WX78_SHADOWDRONE_HARVESTER"
msgid "When will it be enough?"
msgstr "Quando sarà abbastanza?"

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.W_RADIO
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.W_RADIO"
msgid "What does it do?"
msgstr "Qual è il suo scopo?"

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.YELLOWAMULET
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.YELLOWAMULET"
msgid "A brief light in a dark life."
msgstr "Una breve luce nella vita oscura."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.YELLOWGEM
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.YELLOWGEM"
msgid "It reminds me of my mother."
msgstr "Mi ricorda mia madre."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.YELLOWMOONEYE
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.YELLOWMOONEYE"
msgid "What color were mother's eyes?"
msgstr "Di che colore erano gli occhi della madre?"

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.YELLOWSTAFF
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.YELLOWSTAFF"
msgid "The stick is as twisted as my soul."
msgstr "Il bastone è più contorto della mia anima."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.YOTB_BEEFALOSHRINE.BURNT
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.YOTB_BEEFALOSHRINE.BURNT"
msgid "There's nothing left of it."
msgstr "Non è rimasto nulla."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.YOTB_BEEFALOSHRINE.EMPTY
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.YOTB_BEEFALOSHRINE.EMPTY"
msgid "It demands an offering."
msgstr "Pretende un'offerta."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.YOTB_BEEFALOSHRINE.GENERIC
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.YOTB_BEEFALOSHRINE.GENERIC"
msgid "The highest honor this beast of burden will likely ever receive."
msgstr "Il più alto onore che questo animale da soma riceverà mai."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.YOTB_BEEFALO_DOLL_BEAST.GENERIC
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.YOTB_BEEFALO_DOLL_BEAST.GENERIC"
msgid "What a sweet little doll."
msgstr "Che dolce bambolina."

#. STRINGS.CHARACTERS.WENDY.DESCRIBE.YOTB_BEEFALO_DOLL_BEAST.YOTB
msgctxt "STRINGS.CHARACTERS.WENDY.DESCRIBE.YOTB_BEEFALO_DOLL_BEAST.YOTB"
msgid "Mr. Judge might like to see it."
msgstr "Il signor Giudice potrebbe volerla vedere."

