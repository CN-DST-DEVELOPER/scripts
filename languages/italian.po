#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.TRINKET_12
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.TRINKET_12"
msgid "Feels leathery."
msgstr "Sembra coriacea."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.TRINKET_13
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.TRINKET_13"
msgid "It's watching us."
msgstr "Ci sta guardando."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.TRINKET_14
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.TRINKET_14"
msgid "We want some hot cocoa."
msgstr "Vogliamo una cioccolata calda."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.TRINKET_15
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.TRINKET_15"
msgid "We don't know how to play this game."
msgstr "Non sappiamo come giocare a questo gioco."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.TRINKET_16
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.TRINKET_16"
msgid "We don't know how to play this game."
msgstr "Non sappiamo come giocare a questo gioco."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.TRINKET_17
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.TRINKET_17"
msgid "Spork. Spork. Spork. Hahaha!"
msgstr "Forchiaio. Forchiaio. Forchiaio. Ahahah!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.TRINKET_18
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.TRINKET_18"
msgid "We like toys."
msgstr "Ci piacciono i giocattoli."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.TRINKET_19
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.TRINKET_19"
msgid "This toy doesn't work very well."
msgstr "Questo giocattolo non funziona molto bene."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.TRINKET_2
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.TRINKET_2"
msgid "A voiceless instrument."
msgstr "Uno strumento senza voce."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.TRINKET_20
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.TRINKET_20"
msgid "Can we dig in the dirt with this?"
msgstr "Possiamo scavare nel terriccio?"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.TRINKET_21
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.TRINKET_21"
msgid "Mom had one of these."
msgstr "Mamma aveva uno di questi."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.TRINKET_22
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.TRINKET_22"
msgid "It's kinda like our webbing!"
msgstr "È un po' come la nostra ragnatela!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.TRINKET_23
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.TRINKET_23"
msgid "Are we supposed to blow on it?"
msgstr "Dobbiamo soffiarci dentro?"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.TRINKET_24
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.TRINKET_24"
msgid "No cookies. Yet!"
msgstr "Ancora nessun biscotto!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.TRINKET_25
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.TRINKET_25"
msgid "It's stinky."
msgstr "È puzzolente."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.TRINKET_26
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.TRINKET_26"
msgid "You're our cuppy cup!"
msgstr "Sei la nostra tazzina!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.TRINKET_27
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.TRINKET_27"
msgid "This is stupid."
msgstr "Questo è stupido."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.TRINKET_28
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.TRINKET_28"
msgid "Maybe Maxwell will teach us how to play."
msgstr "Forse Maxwell ci insegnerà come giocare."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.TRINKET_29
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.TRINKET_29"
msgid "Maybe Maxwell will teach us how to play."
msgstr "Forse Maxwell ci insegnerà come giocare."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.TRINKET_3
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.TRINKET_3"
msgid "It won't come undone!"
msgstr "Non arriva esaurito!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.TRINKET_30
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.TRINKET_30"
msgid "We can't follow the rules if we don't know them."
msgstr "Non possiamo seguire le regole se non le sappiamo."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.TRINKET_31
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.TRINKET_31"
msgid "We can't follow the rules if we don't know them."
msgstr "Non possiamo seguire le regole se non le sappiamo."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.TRINKET_32
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.TRINKET_32"
msgid "It's not bouncy. What's the point?"
msgstr "Non rimbalza. A che serve?"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.TRINKET_33
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.TRINKET_33"
msgid "It's a friend for our finger!!"
msgstr "È un amico per il nostro dito!!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.TRINKET_34
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.TRINKET_34"
msgid "The monkey probably needed that."
msgstr "La scimmia probabilmente ne aveva bisogno."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.TRINKET_35
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.TRINKET_35"
msgid "I kinda wanna drink what's left, but he won't let me."
msgstr "Voglio bere quello che è rimasto, ma non me lo permetterà."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.TRINKET_36
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.TRINKET_36"
msgid "We've already got some, thanks."
msgstr "Ne abbiamo già, grazie."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.TRINKET_37
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.TRINKET_37"
msgid "Maybe we should hide this before someone gets hurt."
msgstr "Forse dovremmo nasconderlo prima che qualcuno si faccia male."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.TRINKET_38
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.TRINKET_38"
msgid "Haha! Everything looks so small!"
msgstr "Ahah! Sembra tutto così piccolo!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.TRINKET_39
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.TRINKET_39"
msgid "That's boring."
msgstr "È noioso."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.TRINKET_4
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.TRINKET_4"
msgid "It's watching us."
msgstr "Ci sta guardando."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.TRINKET_40
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.TRINKET_40"
msgid "Haha, it looks like a snail shell."
msgstr "Ahah, sembra una conchiglia."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.TRINKET_41
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.TRINKET_41"
msgid "Haha! Weird!"
msgstr "Ahah! Strano!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.TRINKET_42
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.TRINKET_42"
msgid "Neat!!"
msgstr "Troppo forte!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.TRINKET_43
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.TRINKET_43"
msgid "C'mon little croc! Let's adventure!"
msgstr "Forza piccolo coccodrillo! Andiamo all'avventura!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.TRINKET_44
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.TRINKET_44"
msgid "The plant is so pretty!"
msgstr "Ma che bella pianta!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.TRINKET_45
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.TRINKET_45"
msgid "It doesn't get any good channels."
msgstr "Non prende nessun buon canale."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.TRINKET_46
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.TRINKET_46"
msgid "What's it for?"
msgstr "A cosa serve?"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.TRINKET_5
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.TRINKET_5"
msgid "Yay, a new toy!"
msgstr "Alé, un nuovo giocattolo!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.TRINKET_6
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.TRINKET_6"
msgid "Maybe we'll find a use for these."
msgstr "Forse troveremo un uso per questi."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.TRINKET_7
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.TRINKET_7"
msgid "Another toy!"
msgstr "Un altro giocattolo!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.TRINKET_8
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.TRINKET_8"
msgid "I miss bath toys."
msgstr "Mi mancano i giocattoli per il bagno."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.TRINKET_9
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.TRINKET_9"
msgid "None of them match!"
msgstr "Nessuno di loro corrisponde!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.TROPHYSCALE_FISH.BURNING
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.TROPHYSCALE_FISH.BURNING"
msgid "Oh no oh no!"
msgstr "Oh no oh no!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.TROPHYSCALE_FISH.BURNT
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.TROPHYSCALE_FISH.BURNT"
msgid "Aww..."
msgstr "Ohh..."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.TROPHYSCALE_FISH.GENERIC
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.TROPHYSCALE_FISH.GENERIC"
msgid "Woah! We should find a big fish to put in there!"
msgstr "Wow! Dovremmo trovare un grosso pesce da metterci dentro!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.TROPHYSCALE_FISH.HAS_ITEM
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.TROPHYSCALE_FISH.HAS_ITEM"
msgid "Weight: {weight}\nCaught by: {owner}"
msgstr "Peso: {weight}\nCatturato da: {owner}"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.TROPHYSCALE_FISH.HAS_ITEM_HEAVY
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.TROPHYSCALE_FISH.HAS_ITEM_HEAVY"
msgid "Weight: {weight}\nCaught by: {owner}\nWe've never seen such a heavy fish!"
msgstr "Peso: {weight}\nCatturato da: {owner}\nNon abbiamo mai visto un pesce tanto pesante!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.TROPHYSCALE_FISH.OWNER
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.TROPHYSCALE_FISH.OWNER"
msgid "Weight: {weight}\nCaught by: {owner}\nWe did it!"
msgstr "Peso: {weight}\nCatturato da: {owner}\nCe l'abbiamo fatta!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.TROPHYSCALE_FISH.OWNER_HEAVY
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.TROPHYSCALE_FISH.OWNER_HEAVY"
msgid "Weight: {weight}\nCaught by: {owner}\nWe caught it all by ourselves!"
msgstr "Peso: {weight}\nCatturato da: {owner}\nL'abbiamo catturato da soli!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.TROPHYSCALE_OVERSIZEDVEGGIES.BURNING
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.TROPHYSCALE_OVERSIZEDVEGGIES.BURNING"
msgid "Uh oh..."
msgstr "Uh oh..."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.TROPHYSCALE_OVERSIZEDVEGGIES.BURNT
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.TROPHYSCALE_OVERSIZEDVEGGIES.BURNT"
msgid "All burnt up."
msgstr "Tutto bruciato."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.TROPHYSCALE_OVERSIZEDVEGGIES.GENERIC
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.TROPHYSCALE_OVERSIZEDVEGGIES.GENERIC"
msgid "We used to see these at the fair!"
msgstr "Queste si vedevano alla fiera!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.TROPHYSCALE_OVERSIZEDVEGGIES.HAS_ITEM
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.TROPHYSCALE_OVERSIZEDVEGGIES.HAS_ITEM"
msgid "Weight: {weight}\nHarvested on day: {day}\nThat's pretty good!"
msgstr "Peso: {weight}\nRaccolto il giorno: {day}\nNon male!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.TROPHYSCALE_OVERSIZEDVEGGIES.HAS_ITEM_HEAVY
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.TROPHYSCALE_OVERSIZEDVEGGIES.HAS_ITEM_HEAVY"
msgid "Weight: {weight}\nHarvested on day: {day}\nWow, we've never seen one so big!"
msgstr "Peso: {weight}\nRaccolto il giorno: {day}\nWow! Non ne avevamo mai visto uno così grande!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.TROPHYSCALE_OVERSIZEDVEGGIES.HAS_ITEM_LIGHT
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.TROPHYSCALE_OVERSIZEDVEGGIES.HAS_ITEM_LIGHT"
msgid "We guess it's a bit on the small side..."
msgstr "Ci sembra un po' piccolino..."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.TRUNKVEST_SUMMER
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.TRUNKVEST_SUMMER"
msgid "It's so puffy!"
msgstr "È così gonfio!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.TRUNKVEST_WINTER
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.TRUNKVEST_WINTER"
msgid "You're always supposed to wear a jacket!"
msgstr "Si dovrebbe sempre indossare una giacca!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.TRUNK_COOKED
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.TRUNK_COOKED"
msgid "Looks filling!"
msgstr "Sembra saziante!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.TRUNK_SUMMER
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.TRUNK_SUMMER"
msgid "We took his nose!"
msgstr "Abbiamo preso il suo naso!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.TRUNK_WINTER
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.TRUNK_WINTER"
msgid "He blue his nose."
msgstr "Si è soffiato il naso."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.TUMBLEWEED
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.TUMBLEWEED"
msgid "Who knows what that tumbleweed has picked up."
msgstr "Chi lo sa cosa ha raccolto quel rotolacampo."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.TURFCRAFTINGSTATION
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.TURFCRAFTINGSTATION"
msgid "We always liked playing with dirt! Just remember to wash up before dinner."
msgstr "Ci è sempre piaciuto giocare con la terra! L'importante è ricordare di lavarsi le mani prima di cena."

