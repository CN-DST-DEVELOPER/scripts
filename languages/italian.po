msgid "I despise working up a sweat..."
msgstr "Non sopporto di sudare..."

#. STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FUMAROLEHAMMER.LUKEWARM
msgctxt "STRINGS.CHARACTERS.WAXWELL.DESCRIBE.FUMAROLEHAMMER.LUKEWARM"
