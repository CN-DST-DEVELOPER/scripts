msgstr "Hiuuù! Com'è interessante!"

#. STRINGS.CHARACTERS.WORTOX.DESCRIBE.YOTB_STAGE_ITEM
msgctxt "STRINGS.CHARACTERS.WORTOX.DESCRIBE.YOTB_STAGE_ITEM"
