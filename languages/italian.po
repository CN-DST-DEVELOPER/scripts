msgstr "Un solido pavimento di mattoni."

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.TURF_COTL_GOLD
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.TURF_COTL_GOLD"
