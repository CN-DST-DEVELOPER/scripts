msgstr "Hai qualcosa di divertente per noi?"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.YOTC_CARRAT_GYM_DIRECTION.BURNT
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.YOTC_CARRAT_GYM_DIRECTION.BURNT"
