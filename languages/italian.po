msgstr "Piuf!"

#. STRINGS.CHARACTERS.WINONA.ANNOUNCE_ENCUMBERED.2
msgctxt "STRINGS.CHARACTERS.WINONA.ANNOUNCE_ENCUMBERED.2"
msgid "Easy as pie! Hff!"
msgstr "Come bere un bicchier d'acqua! Piuf!"

#. STRINGS.CHARACTERS.WINONA.ANNOUNCE_ENCUMBERED.3
msgctxt "STRINGS.CHARACTERS.WINONA.ANNOUNCE_ENCUMBERED.3"
msgid "Like eggs in coffee!"
msgstr "Liscio come l'olio!"

#. STRINGS.CHARACTERS.WINONA.ANNOUNCE_ENCUMBERED.4
msgctxt "STRINGS.CHARACTERS.WINONA.ANNOUNCE_ENCUMBERED.4"
msgid "Hhngh!"
msgstr "Uhhhg!"

#. STRINGS.CHARACTERS.WINONA.ANNOUNCE_ENCUMBERED.5
msgctxt "STRINGS.CHARACTERS.WINONA.ANNOUNCE_ENCUMBERED.5"
msgid "I... *huff* I got it!"
msgstr "Io... *uff* ce l'ho fatta!"

#. STRINGS.CHARACTERS.WINONA.ANNOUNCE_ENCUMBERED.6
msgctxt "STRINGS.CHARACTERS.WINONA.ANNOUNCE_ENCUMBERED.6"
msgid "Ha! I'm plenty rugged! *huff*"
msgstr "Ah! Sono proprio solida! *Uff*"

#. STRINGS.CHARACTERS.WINONA.ANNOUNCE_ENCUMBERED.7
msgctxt "STRINGS.CHARACTERS.WINONA.ANNOUNCE_ENCUMBERED.7"
