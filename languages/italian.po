#. STRINGS.UI.UPGRADEMODULEDISPLAY.UNPLUG_CIRCUIT
msgctxt "STRINGS.UI.UPGRADEMODULEDISPLAY.UNPLUG_CIRCUIT"
msgid "Unplug Circuit"
msgstr "Scollega il circuito"

#. STRINGS.UI.UPGRADEMODULEDISPLAY.UNPLUG_TOP_CIRCUIT
msgctxt "STRINGS.UI.UPGRADEMODULEDISPLAY.UNPLUG_TOP_CIRCUIT"
msgid "Unplug First Circuit"
msgstr "Scollega il primo circuito"

#. STRINGS.UI.UPGRADEMODULEDISPLAY.UNSOCKET
msgctxt "STRINGS.UI.UPGRADEMODULEDISPLAY.UNSOCKET"
