msgstr "Non tornerà indietro. Forse questa volta è meglio così..."

#. STRINGS.CHARACTERS.WANDA.ACTIONFAIL.GIVE.CARNIVALGAME_ALREADY_PLAYING
msgctxt "STRINGS.CHARACTERS.WANDA.ACTIONFAIL.GIVE.CARNIVALGAME_ALREADY_PLAYING"
msgid "I'll just come back later. Or earlier."
msgstr "Tornerò più tardi. O prima."

#. STRINGS.CHARACTERS.WANDA.ACTIONFAIL.GIVE.CARNIVALGAME_INVALID_ITEM
msgctxt "STRINGS.CHARACTERS.WANDA.ACTIONFAIL.GIVE.CARNIVALGAME_INVALID_ITEM"
