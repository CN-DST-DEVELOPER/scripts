msgstr "Non abbastanza buono per te, pianta?"

#. STRINGS.CHARACTERS.WEBBER.ANNOUNCE_INV_FULL
msgctxt "STRINGS.CHARACTERS.WEBBER.ANNOUNCE_INV_FULL"
