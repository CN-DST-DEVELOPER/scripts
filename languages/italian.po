msgctxt "STRINGS.UI.TRADESCREEN.START"
msgid "Start"
msgstr "Avvia"

#. STRINGS.UI.TRADESCREEN.TEMPORARILY_CLOSED_BODY
msgctxt "STRINGS.UI.TRADESCREEN.TEMPORARILY_CLOSED_BODY"
msgid "The Trade Inn is closed for a bit.\n\nBe back soon, okay?"
msgstr "Il negozio Scambi è chiuso per un po'.\n\nTornerò subito, ok?"

