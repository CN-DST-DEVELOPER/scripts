msgid "We'll slaughter that slurtle."
msgstr "Macelleremo quella bavuga."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.SLURTLEHAT
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.SLURTLEHAT"
msgid "A solid helmet."
msgstr "Un casco solido."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.SLURTLEHOLE
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.SLURTLEHOLE"
msgid "Slimy and rocky."
msgstr "Viscido e roccioso."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.SLURTLESLIME
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.SLURTLESLIME"
msgid "Slime-time!"
msgstr "Viva la bava!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.SLURTLE_SHELLPIECES
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.SLURTLE_SHELLPIECES"
msgid "Maybe that was a little too rough."
msgstr "Forse sono stato troppo brusco."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.SMALLBIRD.GENERIC
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.SMALLBIRD.GENERIC"
msgid "Could this be a friend for us?"
msgstr "Potrebbe essere un amico per noi?"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.SMALLBIRD.HUNGRY
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.SMALLBIRD.HUNGRY"
msgid "I can see its tummy rumble."
msgstr "Posso vedere la sua pancia brontolare."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.SMALLBIRD.SLEEPING
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.SMALLBIRD.SLEEPING"
msgid "Shhh! It's dreaming."
msgstr "Shhh! Sta sognando."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.SMALLBIRD.STARVING
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.SMALLBIRD.STARVING"
msgid "Poor thing. It looks so hungry!"
msgstr "Poveretto. Sembra così affamato!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.SMALLGHOST
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.SMALLGHOST"
msgid "Hey little guy! Wanna play?"
msgstr "Ehi, piccolo! Vuoi giocare?"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.SMALLMEAT
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.SMALLMEAT"
msgid "A couple more'll make a morsel meal!"
msgstr "Un altro paio e diventerà un piccolo pasto!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.SMALLMEAT_DRIED
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.SMALLMEAT_DRIED"
msgid "It'll keep longer this way."
msgstr "Si manterrà più a lungo in questo modo."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.SNAPPER
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.SNAPPER"
msgid "Don't bite us!"
msgstr "Non ci mordere!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.SNOWBALL_ITEM
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.SNOWBALL_ITEM"
msgid "Snowball fight!"
msgstr "Battaglia di palle di neve!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.SNOWMAN.GENERIC
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.SNOWMAN.GENERIC"
msgid "We love it!"
msgstr "Bellissimo!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.SNOWMAN.SNOWBALL
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.SNOWMAN.SNOWBALL"
msgid "It's so... round!"
msgstr "È così... tonda!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.SNURTLE
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.SNURTLE"
msgid "Let's snuff out that snurtle."
msgstr "Facciamo fuori quella sbavuga."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.SOIL_AMENDER.GENERIC
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.SOIL_AMENDER.GENERIC"
msgid "Wendy dared us to drink it..."
msgstr "Wendy ci ha sfidati a berla..."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.SOIL_AMENDER.SPOILED
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.SOIL_AMENDER.SPOILED"
msgid "It's gotten really rotten looking... yay!"
msgstr "Ha assunto un aspetto putrescente... Urrà!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.SOIL_AMENDER.STALE
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.SOIL_AMENDER.STALE"
msgid "Is it going bad? Is that good?"
msgstr "Sta andando a male? È un bene, vero?"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.SOIL_AMENDER_FERMENTED
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.SOIL_AMENDER_FERMENTED"
msgid "It smells done to us!"
msgstr "Dall'odore sembra pronta!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.SPAT
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.SPAT"
msgid "Maybe it just needs a cuddle!"
msgstr "Forse ha solo bisogno di coccole!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.SPEAR
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.SPEAR"
msgid "We should stick things with the pointy part."
msgstr "Dovremmo infilzare le cose con la parte appuntita."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.SPEAR_GUNGNIR
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.SPEAR_GUNGNIR"
msgid "Wigfrid makes it look so cool!"
msgstr "Wigfrid la fa sembrare così giusta!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.SPEAR_LANCE
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.SPEAR_LANCE"
msgid "I don't really want it."
msgstr "Non la voglio davvero."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.SPEAR_WATHGRITHR
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.SPEAR_WATHGRITHR"
msgid "Pointy ouchies!"
msgstr "Punta che fa la bua!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.SPEAR_WATHGRITHR_LIGHTNING
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.SPEAR_WATHGRITHR_LIGHTNING"
msgid "It gets our fur all full of static!"
msgstr "Ci riempie i peli di elettricità statica!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.SPICEPACK
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.SPICEPACK"
msgid "I'm sure Mr. Warly won't mind if we use this!"
msgstr "Sono certo che al signor Warly non spiacerà se lo usiamo!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.SPICE_CHILI
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.SPICE_CHILI"
msgid "Ho! Ha! That's spicy!"
msgstr "Oh! Ah! È piccante!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.SPICE_GARLIC
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.SPICE_GARLIC"
msgid "Our breath will smell stinky. Yay!"
msgstr "Ci puzza l'alito. Evviva!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.SPICE_SALT
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.SPICE_SALT"
msgid "Mmm, salty!"
msgstr "Mmmm... salato!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.SPICE_SUGAR
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.SPICE_SUGAR"
msgid "It turns everything into dessert!"
msgstr "Trasforma ogni cosa in un dessert!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.SPIDER.DEAD
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.SPIDER.DEAD"
msgid "Another lost friend."
msgstr "Un altro amico perduto."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.SPIDER.GENERIC
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.SPIDER.GENERIC"
msgid "Spiders understand us."
msgstr "I ragni ci capiscono."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.SPIDER.SLEEPING
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.SPIDER.SLEEPING"
msgid "Aww! I think it's having a dream."
msgstr "Non credo che si stia divertendo."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.SPIDERCORPSE.BURNING
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.SPIDERCORPSE.BURNING"
msgid "Bye."
msgstr "Addio."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.SPIDERCORPSE.GENERIC
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.SPIDERCORPSE.GENERIC"
msgid "Sorry."
msgstr "Scusa."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.SPIDERCORPSE.REVIVING
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.SPIDERCORPSE.REVIVING"
msgid "Oh no!"
msgstr "Oh no!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.SPIDERDEN
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.SPIDERDEN"
msgid "Looks cozy in there."
msgstr "Sembra accogliente lì dentro."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.SPIDERDEN_BEDAZZLER
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.SPIDERDEN_BEDAZZLER"
msgid "We know what'll make our spiderfriends happy, decorating their house!"
msgstr "Sappiamo come far sorridere i nostri amici ragni: decorando la loro casa!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.SPIDEREGGSACK
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.SPIDEREGGSACK"
msgid "A portable friendship pod!"
msgstr "Un porta-amicizia portatile!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.SPIDERGLAND
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.SPIDERGLAND"
msgid "I won't think about where it came from."
msgstr "Eviterò di pensare da dove provenga."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.SPIDERHAT
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.SPIDERHAT"
msgid "Very upsetting..."
msgstr "Molto sconvolgente..."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.SPIDERHOLE
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.SPIDERHOLE"
msgid "We could stand to live there."
msgstr "Potremmo abituarci a vivere lì."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.SPIDERHOLE_ROCK
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.SPIDERHOLE_ROCK"
msgid "We could stand to live there."
msgstr "Potremmo abituarci a vivere lì."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.SPIDERQUEEN
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.SPIDERQUEEN"
msgid "Mommy-Longlegs?"
msgstr "Mamma-gambelunghe?"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.SPIDERQUEENCORPSE.BURNING
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.SPIDERQUEENCORPSE.BURNING"
msgid "It's going to be okay."
msgstr "Andrà tutto bene."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.SPIDERQUEENCORPSE.GENERIC
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.SPIDERQUEENCORPSE.GENERIC"
msgid "Aw, Mommy-Longlegs."
msgstr "Noo, mamma-gambelunghe..."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.SPIDERQUEENCORPSE.REVIVING
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.SPIDERQUEENCORPSE.REVIVING"
msgid "Uh-oh..."
msgstr "Oh, oh..."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.SPIDER_DROPPER
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.SPIDER_DROPPER"
msgid "Our friends live up there."
msgstr "I nostri amici vivono lì sopra."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.SPIDER_HEALER
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.SPIDER_HEALER"
msgid "We feel better just having them around!"
msgstr "Solo averlo intorno ci fa sentire meglio!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.SPIDER_HEALER_ITEM
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.SPIDER_HEALER_ITEM"
msgid "It's good for fixing spider booboos."
msgstr "Guarisce le bue dei ragni."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.SPIDER_HIDER
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.SPIDER_HIDER"
msgid "Friends!"
msgstr "Amici!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.SPIDER_MOON.DEAD
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.SPIDER_MOON.DEAD"
msgid "Sorry!"
msgstr "Spiacente!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.SPIDER_MOON.GENERIC
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.SPIDER_MOON.GENERIC"
msgid "These friends look... weird."
msgstr "Questi amici hanno un aspetto... strano."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.SPIDER_MOON.SLEEPING
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.SPIDER_MOON.SLEEPING"
msgid "Night-night, scary friend."
msgstr "Notte notte, amico spaventoso."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.SPIDER_REPELLENT
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.SPIDER_REPELLENT"
msgid "Ms. Wickerbottom said our friends need to go home if they don't behave."
msgstr "La signorina Wickerbottom ha detto che i nostri amici dovranno tornare a casa se si comporteranno male."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.SPIDER_SPITTER
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.SPIDER_SPITTER"
msgid "Lay down some web for us."
msgstr "Puoi tessere qualche ragnatela per noi."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.SPIDER_WARRIOR.DEAD
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.SPIDER_WARRIOR.DEAD"
msgid "Forgive us, brother."
msgstr "Perdonaci, fratello."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.SPIDER_WARRIOR.GENERIC
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.SPIDER_WARRIOR.GENERIC"
msgid "He will protect us!"
msgstr "Ci proteggerà!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.SPIDER_WARRIOR.SLEEPING
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.SPIDER_WARRIOR.SLEEPING"
msgid "They're so cute when they sleep."
msgstr "Sono così carini quando dormono."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.SPIDER_WATER
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.SPIDER_WATER"
msgid "Maybe they can teach us how to swim."
msgstr "Forse può insegnarci a nuotare."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.SPIDER_WHISTLE
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.SPIDER_WHISTLE"
msgid "We can call our spider friends!"
msgstr "Possiamo chiamare tutti i nostri amici ragni!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.SPOILED_FISH.GENERIC
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.SPOILED_FISH.GENERIC"
msgid "It's no good to anyone now."
msgstr "Ora non può mangiarlo nessuno."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.SPOILED_FOOD.GENERIC
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.SPOILED_FOOD.GENERIC"
msgid "Blech!"
msgstr "Bleah!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.SPORE_MEDIUM.GENERIC
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.SPORE_MEDIUM.GENERIC"
msgid "Our favorite color! Red!"
msgstr "Il nostro colore preferito! Rosso!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.SPORE_MEDIUM.HELD
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.SPORE_MEDIUM.HELD"
msgid "If we stare at it we'll turn to stone!"
msgstr "Se lo fissiamo, diventeremo pietrificati!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.SPORE_MOON
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.SPORE_MOON"
msgid "They pop like balloons! Not as fun, though."
msgstr "Scoppiano come palloncini! Però non sono altrettanto divertenti."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.SPORE_SMALL.GENERIC
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.SPORE_SMALL.GENERIC"
msgid "That's green, our favoritest color!"
msgstr "È verde, il nostro colore preferito!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.SPORE_SMALL.HELD
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.SPORE_SMALL.HELD"
msgid "If we lick it we'll turn to wood!"
msgstr "Se lo lecchiamo, diventeremo legno!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.SPORE_TALL.GENERIC
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.SPORE_TALL.GENERIC"
msgid "Blue! That's our favorite color!"
msgstr "Blu! Il nostro colore preferito!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.SPORE_TALL.HELD
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.SPORE_TALL.HELD"
msgid "If we eat it we'll turn to water!"
msgstr "Se lo mangiamo, diventeremo acqua!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.SQUID
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.SQUID"
msgid "Wish we had eyes like that!"
msgstr "Sarebbe bello avere occhi come quelli!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.STAFFCOLDLIGHT
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.STAFFCOLDLIGHT"
msgid "Woah! The cold makes all our hairs stand up!"
msgstr "Wow! Il freddo fa rizzare tutti nostri peli!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.STAFFLIGHT
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.STAFFLIGHT"
msgid "Cozy."
msgstr "Accogliente."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.STAFF_LUNARPLANT
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.STAFF_LUNARPLANT"
msgid "We can hit things far away."
msgstr "Possiamo colpire le cose da lontano."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.STAFF_TORNADO
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.STAFF_TORNADO"
msgid "We'll huff and we'll puff."
msgstr "Ansimiamo e sbuffiamo!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.STAGEHAND.AWAKE
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.STAGEHAND.AWAKE"
msgid "Definitely not a spider!"
msgstr "Sicuramente non è un ragno!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.STAGEHAND.HIDING
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.STAGEHAND.HIDING"
msgid "Is there a spider friend rustling beneath?"
msgstr "C'è un amico ragno che fruscia lì sotto?"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.STAGEUSHER.SITTING
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.STAGEUSHER.SITTING"
msgid "Is there a spider friend rustling beneath?"
msgstr "C'è un amico ragno che fruscia lì sotto?"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.STAGEUSHER.STANDING
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.STAGEUSHER.STANDING"
msgid "Definitely not a spider!"
msgstr "Sicuramente non è un ragno!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.STALAGMITE
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.STALAGMITE"
msgid "Rocks, underground?! Shocking."
msgstr "Rocce, sottoterra?! Scioccante."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.STALAGMITE_TALL
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.STALAGMITE_TALL"
msgid "Pointy rocks, underground?! Simply stunning."
msgstr "Rocce appuntite, sotterranee?! Semplicemente sbalorditivo."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.STALKER
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.STALKER"
msgid "I don't think it's friendly."
msgstr "Non credo sia amichevole."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.STALKER_ATRIUM
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.STALKER_ATRIUM"
msgid "We'll defend ourselves if we have to."
msgstr "Ci difenderemo se saremo costretti."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.STALKER_MINION
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.STALKER_MINION"
msgid "Creepy!"
msgstr "Raccapricciante!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.STALKER_NPC
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.STALKER_NPC"
msgid "He seems so sad..."
msgstr "Sembra così triste..."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.STASH_MAP
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.STASH_MAP"
msgid "It's a real treasure map!"
msgstr "È una vera mappa del tesoro!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.STATUEGLOMMER.EMPTY
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.STATUEGLOMMER.EMPTY"
msgid "Take that, rock bug!"
msgstr "Prendi questo, insetto di roccia!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.STATUEGLOMMER.GENERIC
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.STATUEGLOMMER.GENERIC"
msgid "A statue of some weird bug."
msgstr "Una statua di un qualche strano insetto."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.STATUEHARP
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.STATUEHARP"
msgid "Someone took the head."
msgstr "Qualcuno ha preso la testa."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.STATUEHARP_HEDGESPAWNER
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.STATUEHARP_HEDGESPAWNER"
msgid "This place is making our spider-hairs tingle..."
msgstr "Questo posto ci fa rizzare i peli..."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.STATUEMAXWELL
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.STATUEMAXWELL"
msgid "We're still a little mad at him. But only a little."
msgstr "Siamo ancora un po' arrabbiati con lui. Ma solo un po'."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.STATUE_MARBLE.GENERIC
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.STATUE_MARBLE.GENERIC"
msgid "Solid marble!"
msgstr "Marmo solido!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.STATUE_MARBLE.TYPE1
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.STATUE_MARBLE.TYPE1"
msgid "Nice sword!"
msgstr "Bella spada!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.STATUE_MARBLE.TYPE2
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.STATUE_MARBLE.TYPE2"
msgid "It looks real lifelike, but it's all cold to touch."
msgstr "Sembra davvero realistico, ma è tutto freddo al tatto."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.STATUE_MARBLE.TYPE3
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.STATUE_MARBLE.TYPE3"
msgid "I broke mother's vase once... she wasn't happy."
msgstr "Una volta ho rotto un vaso di mia madre... Non era felice."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.STEELWOOL
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.STEELWOOL"
msgid "Scratchy, like father's beard!"
msgstr "Ruvido, come la barba di papà!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.STEERINGWHEEL
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.STEERINGWHEEL"
msgid "Oh, oh, we want to steer!"
msgstr "Oh, oh, vogliamo virare!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.STEERINGWHEEL_ITEM
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.STEERINGWHEEL_ITEM"
msgid "That's for making a steering wheel."
msgstr "Serve a costruire un timone."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.STINGER
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.STINGER"
msgid "We should be careful, we could poke an eye out!"
msgstr "Dobbiamo stare attenti, ci potremmo cavare un occhio!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.STONE_CHAIR.GENERIC
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.STONE_CHAIR.GENERIC"
msgid "Mother said I could never sit still."
msgstr "La mamma diceva che non ero capace di sedermi tranquillo."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.STONE_CHAIR.OCCUPIED
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.STONE_CHAIR.OCCUPIED"
msgid "Mother said I could never sit still."
msgstr "La mamma diceva che non ero capace di sedermi tranquillo."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.STONE_TABLE.GENERIC
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.STONE_TABLE.GENERIC"
msgid "I remember drawing at the table."
msgstr "Ricordo che disegnavo sul tavolo."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.STONE_TABLE.HAS_ITEM
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.STONE_TABLE.HAS_ITEM"
msgid "I remember drawing at the table."
msgstr "Ricordo che disegnavo sul tavolo."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.STORAGE_ROBOT.BROKEN
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.STORAGE_ROBOT.BROKEN"
msgid "Someone fix it so we can play with it."
msgstr "Se qualcuno lo aggiusta, poi noi possiamo giocarci."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.STORAGE_ROBOT.GENERIC
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.STORAGE_ROBOT.GENERIC"
msgid "It works while we play!"
msgstr "Lavora mentre giochiamo!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.STRAWHAT
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.STRAWHAT"
msgid "Keeps the sun out of all eight of your eyes."
msgstr "Mantiene il sole fuori da tutti e otto gli occhi."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.STUFFEDEGGPLANT
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.STUFFEDEGGPLANT"
msgid "We will stuff ourself with eggyplants!"
msgstr "Ci riempiremo di melanzane!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.STUFFING
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.STUFFING"
msgid "It smells so good!"
msgstr "Che profumino!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.SUCCULENT_PICKED
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.SUCCULENT_PICKED"
msgid "It got picked."
msgstr "È stato raccolta."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.SUCCULENT_PICKED_DRIED
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.SUCCULENT_PICKED_DRIED"
msgid "Did we pick these?"
msgstr "L'abbiamo raccolta noi?"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.SUCCULENT_PLANT
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.SUCCULENT_PLANT"
msgid "We think it's a cactus."
msgstr "Crediamo che sia un cactus."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.SUCCULENT_POTTED
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.SUCCULENT_POTTED"
msgid "I wonder if mum's ever seen one."
msgstr "Mi chiedo se mamma ne abbia mai visto uno."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.SUNKENCHEST.GENERIC
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.SUNKENCHEST.GENERIC"
msgid "Whew... we thought there might be an angry clam inside."
msgstr "Fiu... Temevamo che dentro ci fosse una vongola arrabbiata."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.SUNKENCHEST.LOCKED
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.SUNKENCHEST.LOCKED"
msgid "It won't let us in!"
msgstr "Non ci lascia entrare!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.SUPERTACKLECONTAINER
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.SUPERTACKLECONTAINER"
msgid "We can put way more fishing stuff in there!"
msgstr "Qui dentro possiamo metterci molta più roba per la pesca!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.SUPPORT_PILLAR
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.SUPPORT_PILLAR"
msgid "Uh oh, those cracks are looking bigger..."
msgstr "Oh oh, le crepe sembrano più grandi..."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.SUPPORT_PILLAR_BROKEN
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.SUPPORT_PILLAR_BROKEN"
msgid "Oh no, it broke!"
msgstr "Oh, no! Si è rotto!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.SUPPORT_PILLAR_COMPLETE
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.SUPPORT_PILLAR_COMPLETE"
msgid "It'll keep us safe!"
msgstr "Ci tiene al sicuro!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.SUPPORT_PILLAR_DREADSTONE
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.SUPPORT_PILLAR_DREADSTONE"
msgid "Uh oh, those cracks are looking bigger..."
msgstr "Oh oh, le crepe sembrano più grandi..."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.SUPPORT_PILLAR_DREADSTONE_BROKEN
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.SUPPORT_PILLAR_DREADSTONE_BROKEN"
msgid "Aww, poor pillar."
msgstr "Nooo, povero pilastro!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.SUPPORT_PILLAR_DREADSTONE_COMPLETE
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.SUPPORT_PILLAR_DREADSTONE_COMPLETE"
msgid "Thanks for keeping us safe, pillar!"
msgstr "Grazie per tenerci al sicuro, pilastro!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.SUPPORT_PILLAR_DREADSTONE_SCAFFOLD
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.SUPPORT_PILLAR_DREADSTONE_SCAFFOLD"
msgid "What's hiding under there?"
msgstr "Cosa si nasconde là sotto?"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.SUPPORT_PILLAR_SCAFFOLD
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.SUPPORT_PILLAR_SCAFFOLD"
msgid "What's hiding under there?"
msgstr "Cosa si nasconde là sotto?"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.SURFNTURF
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.SURFNTURF"
msgid "Eww, healthy!"
msgstr "Eehh, sano!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.SWEATERVEST
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.SWEATERVEST"
msgid "It itches and fits funny."
msgstr "Prude e calza in modo strano."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.SWEETPOTATO
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.SWEETPOTATO"
msgid "Are those marshmallows on top?"
msgstr "Quelli li sopra sono marshmallow?"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.SWEETTEA
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.SWEETTEA"
msgid "Mother used to make tea for me... at least I think she did..."
msgstr "La mamma mi preparava il tè una volta... Almeno crediamo..."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.SWORD_LUNARPLANT
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.SWORD_LUNARPLANT"
msgid "It's a magic sword!"
msgstr "È una spada magica!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.TABLE_WINTERS_FEAST.BURNT
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.TABLE_WINTERS_FEAST.BURNT"
msgid "Aww, someone ruined it."
msgstr "Oh, qualcuno ha rovinato la festa."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.TABLE_WINTERS_FEAST.GENERIC
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.TABLE_WINTERS_FEAST.GENERIC"
msgid "So big it could fit everyone!"
msgstr "È così grande che c'è posto per tutti!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.TABLE_WINTERS_FEAST.HAS_FOOD
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.TABLE_WINTERS_FEAST.HAS_FOOD"
msgid "Enough food for everyone!"
msgstr "Cibo in abbondanza per tutti!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.TABLE_WINTERS_FEAST.WRONG_TYPE
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.TABLE_WINTERS_FEAST.WRONG_TYPE"
msgid "Not the season for this."
msgstr "Non è la stagione giusta."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.TACKLECONTAINER
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.TACKLECONTAINER"
msgid "It's like a toybox, but for fishing stuff!"
msgstr "È come una scatola dei giocattoli, ma per attrezzi da pesca!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.TACKLESKETCH
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.TACKLESKETCH"
msgid "It has fishing secrets!"
msgstr "Contiene segreti di pesca!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.TACKLESTATION
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.TACKLESTATION"
msgid "Father used to take me fishing sometimes."
msgstr "A volte, mio padre mi portava a pescare."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.TAFFY
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.TAFFY"
msgid "Candy!"
msgstr "Caramella!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.TALLBIRD
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.TALLBIRD"
msgid "Look at those legs!"
msgstr "Guardate che gambe!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.TALLBIRDEGG
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.TALLBIRDEGG"
msgid "Did I hear a meep?"
msgstr "Era uno squittio quello che ho sentito?"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.TALLBIRDEGG_COOKED
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.TALLBIRDEGG_COOKED"
msgid "Smells great!"
msgstr "Ha un ottimo odore!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.TALLBIRDEGG_CRACKED.COLD
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.TALLBIRDEGG_CRACKED.COLD"
msgid "It's shivering!"
msgstr "Sta tremando!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.TALLBIRDEGG_CRACKED.GENERIC
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.TALLBIRDEGG_CRACKED.GENERIC"
msgid "I think it's hatching!"
msgstr "Credo che si stia schiudendo!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.TALLBIRDEGG_CRACKED.HOT
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.TALLBIRDEGG_CRACKED.HOT"
msgid "It'll boil if it doesn't cool down soon."
msgstr "Bollirà se non si raffredda subito."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.TALLBIRDEGG_CRACKED.LONG
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.TALLBIRDEGG_CRACKED.LONG"
msgid "Looks like an egg."
msgstr "Sembra un uovo."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.TALLBIRDEGG_CRACKED.SHORT
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.TALLBIRDEGG_CRACKED.SHORT"
msgid "Did that egg just move?"
msgstr "Quell'uovo si è appena mosso?"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.TALLBIRDNEST.GENERIC
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.TALLBIRDNEST.GENERIC"
msgid "This could feed us for days!"
msgstr "Ci potrebbe nutrire per giorni!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.TALLBIRDNEST.PICKED
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.TALLBIRDNEST.PICKED"
msgid "Where is the egg?"
msgstr "Dove è l'uovo?"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.TALLEGGS
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.TALLEGGS"
msgid "Crunchy!"
msgstr "Croccante!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.TAMALES
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.TAMALES"
msgid "Mmm, spicy!"
msgstr "Mmmm... piccanti!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.TEENBIRD.GENERIC
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.TEENBIRD.GENERIC"
msgid "It's getting old so fast!"
msgstr "Sta diventando vecchio così in fretta!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.TEENBIRD.HUNGRY
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.TEENBIRD.HUNGRY"
msgid "It looks hungry!"
msgstr "Sembra affamato!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.TEENBIRD.SLEEPING
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.TEENBIRD.SLEEPING"
msgid "Must've had a busy day."
msgstr "Deve avere avuto una giornata piena."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.TEENBIRD.STARVING
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.TEENBIRD.STARVING"
msgid "I think it's starving!"
msgstr "Credo che stia morendo di fame!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.TELEBASE.GEMS
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.TELEBASE.GEMS"
msgid "It needs something to focus the power."
msgstr "Ha bisogno di qualcosa per concentrare l'energia."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.TELEBASE.VALID
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.TELEBASE.VALID"
msgid "Seems ready to use."
msgstr "Sembra pronto per l'uso."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.TELEPORTATO_BASE.ACTIVE
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.TELEPORTATO_BASE.ACTIVE"
msgid "We could use this to visit new worlds!"
msgstr "Potremmo usarlo per visitare nuovi mondi!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.TELEPORTATO_BASE.GENERIC
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.TELEPORTATO_BASE.GENERIC"
msgid "I can hear the sounds of another world!"
msgstr "Posso sentire i suoni di un altro mondo!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.TELEPORTATO_BASE.LOCKED
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.TELEPORTATO_BASE.LOCKED"
msgid "It still won't work!"
msgstr "Ancora non funziona!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.TELEPORTATO_BASE.PARTIAL
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.TELEPORTATO_BASE.PARTIAL"
msgid "I don't think we're done yet!"
msgstr "Non credo che abbiamo già finito!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.TELEPORTATO_BOX
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.TELEPORTATO_BOX"
msgid "The power in this box is unimaginable."
msgstr "Il potere in questa scatola è inimmaginabile."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.TELEPORTATO_CRANK
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.TELEPORTATO_CRANK"
msgid "A crank that will stand up to punishment."
msgstr "Una manovella che non teme di essere punita."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.TELEPORTATO_POTATO
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.TELEPORTATO_POTATO"
msgid "It looks like this goes with something..."
msgstr "Sembra che vada con qualcosa..."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.TELEPORTATO_RING
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.TELEPORTATO_RING"
msgid "I think there are more parts."
msgstr "Credo che ci siano più parti."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.TELESTAFF
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.TELESTAFF"
msgid "Just looking at it makes my brain feel fuzzy."
msgstr "Solo a guardarlo mi fa girare la testa."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.TENT.BURNT
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.TENT.BURNT"
msgid "The fire destroyed it."
msgstr "L'incendio l'ha distrutto."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.TENT.GENERIC
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.TENT.GENERIC"
msgid "It's way past our bedtime!"
msgstr "L'ora della nanna è passata da un po'."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.TENTACLE
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.TENTACLE"
msgid "We would be mad if something stepped on us, too."
msgstr "Saremmo anche noi impazziti se qualcosa ci avesse calpestato."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.TENTACLESPIKE
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.TENTACLESPIKE"
msgid "We could hit stuff with the pointy bits!"
msgstr "Potremmo colpire le cose con le parti appuntite!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.TENTACLESPOTS
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.TENTACLESPOTS"
msgid "Spotty!"
msgstr "A chiazze!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.TENTACLE_GARDEN
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.TENTACLE_GARDEN"
msgid "It's huge!"
msgstr "È enorme!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.TENTACLE_PILLAR
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.TENTACLE_PILLAR"
msgid "It's huge!"
msgstr "È enorme!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.TENTACLE_PILLAR_ARM
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.TENTACLE_PILLAR_ARM"
msgid "Aw, it's just a baby!"
msgstr "Oh, è solo un bambino!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.TENTACLE_PILLAR_HOLE
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.TENTACLE_PILLAR_HOLE"
msgid "Oooh let's jump in!"
msgstr "Ooooh, saltiamoci dentro!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.TERRARIUM.COOLDOWN
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.TERRARIUM.COOLDOWN"
msgid "Oh no! Did we lose the little tree somewhere?"
msgstr "Oh, no! Abbiamo perso l'alberello da qualche parte?"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.TERRARIUM.CRIMSON
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.TERRARIUM.CRIMSON"
msgid "Uh oh... is the tree sick?"
msgstr "Oh oh... L'albero è malato?"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.TERRARIUM.ENABLED
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.TERRARIUM.ENABLED"
msgid "WE DIDN'T SHAKE IT, WE PROMISE!!"
msgstr "NON L'ABBIAMO SCOSSO, LO GIURIAMO!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.TERRARIUM.GENERIC
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.TERRARIUM.GENERIC"
msgid "So pretty! We want to shake it!"
msgstr "Com'è bello! Vogliamo scuoterlo!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.TERRARIUM.SPAWN_DISABLED
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.TERRARIUM.SPAWN_DISABLED"
msgid "We think we're done playing with Mr. Eyeball."
msgstr "Pensiamo di aver finito di giocare con il signor Bulbo oculare."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.TERRARIUM.WAITING_FOR_DARK
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.TERRARIUM.WAITING_FOR_DARK"
msgid "We could give it just a little shake, couldn't we?"
msgstr "Non possiamo scuoterlo un pochettino?"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.TERRARIUMCHEST.BURNT
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.TERRARIUMCHEST.BURNT"
msgid "Aww, it was such a pretty chest."
msgstr "Oh, era uno scrigno davvero bello."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.TERRARIUMCHEST.GENERIC
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.TERRARIUMCHEST.GENERIC"
msgid "We didn't find any toys inside."
msgstr "Non abbiamo trovato nessun giocattolo all'interno."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.TERRARIUMCHEST.SHIMMER
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.TERRARIUMCHEST.SHIMMER"
msgid "We bet there are plenty of toys inside!"
msgstr "Scommettiamo che dentro ci sono un sacco di giocattoli!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.THULECITE
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.THULECITE"
msgid "Fancy rocks!"
msgstr "Rocce raffinate!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.THULECITEBUGNET
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.THULECITEBUGNET"
msgid "We can make that with our beard!"
msgstr "Possiamo farlo con la nostra barba!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.THULECITE_PIECES
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.THULECITE_PIECES"
msgid "Small bits of fancy rock."
msgstr "Piccoli frammenti di roccia pregiata."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.THURIBLE
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.THURIBLE"
msgid "It gets really hot."
msgstr "Sta diventando molto caldo."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.TICOON.ABANDONED
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.TICOON.ABANDONED"
msgid "We'll try our best to find them on our own."
msgstr "Faremo del nostro meglio per trovarli da soli."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.TICOON.GENERIC
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.TICOON.GENERIC"
msgid "Your majesty!"
msgstr "Vostra maestà!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.TICOON.LOST_TRACK
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.TICOON.LOST_TRACK"
msgid "Aw, we weren't quick enough."
msgstr "Oh, non siamo stati abbastanza veloci."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.TICOON.NEARBY
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.TICOON.NEARBY"
msgid "Is there a kit nearby, our liege?"
msgstr "C'è un miciorsetto nei paraggi, vostra maestà?"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.TICOON.NOTHING_TO_TRACK
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.TICOON.NOTHING_TO_TRACK"
msgid "It doesn't look like there's anything around here..."
msgstr "Non sembra esserci nulla qui..."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.TICOON.SUCCESS
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.TICOON.SUCCESS"
msgid "Wow! Good work, your highness!"
msgstr "Wow! Ottimo lavoro, vostra altezza!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.TICOON.TARGET_TOO_FAR_AWAY
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.TICOON.TARGET_TOO_FAR_AWAY"
msgid "Maybe the kit's out of his sniffing range?"
msgstr "Forse il miciorsetto è troppo lontano per essere fiutato?"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.TICOON.TRACKING
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.TICOON.TRACKING"
msgid "He's onto something!"
msgstr "Ha trovato una pista!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.TICOON.TRACKING_NOT_MINE
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.TICOON.TRACKING_NOT_MINE"
msgid "He's helping someone else right now."
msgstr "Sta aiutando qualcun altro."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.TILLWEED
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.TILLWEED"
msgid "It likes to make a mess of our garden."
msgstr "Le piace impasticciare il nostro orto."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.TILLWEEDSALVE
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.TILLWEEDSALVE"
msgid "It helps get rid of booboos."
msgstr "Ci aiuta a far passare la bua."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.TILLWEED_DRIED
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.TILLWEED_DRIED"
msgid "Did we pick these?"
msgstr "L'abbiamo raccolta noi?"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.TOADSTOOL.GENERIC
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.TOADSTOOL.GENERIC"
msgid "Yikes! That's a big frog!"
msgstr "Ah! È una rana grandissima!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.TOADSTOOL.RAGE
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.TOADSTOOL.RAGE"
msgid "Toadally terrifying!"
msgstr "Rospaccio terrificante!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.TOADSTOOL_CAP.EMPTY
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.TOADSTOOL_CAP.EMPTY"
msgid "Do you think we'd fit?"
msgstr "Credi che ci possa entrare?"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.TOADSTOOL_CAP.GENERIC
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.TOADSTOOL_CAP.GENERIC"
msgid "Mushroom! It's a mushroom!"
msgstr "Fungo! È un fungo!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.TOADSTOOL_CAP.INGROUND
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.TOADSTOOL_CAP.INGROUND"
msgid "I think it needs help getting out."
msgstr "Penso che abbia bisogno di aiuto per uscire."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.TOMATO
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.TOMATO"
msgid "Is it a fruit or a vegetable?"
msgstr "È un frutto o un ortaggio?"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.TOMATO_COOKED
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.TOMATO_COOKED"
msgid "It's a cooked fregetable. Vruit?"
msgstr "È un fruttaggio cotto. Giusto?"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.TOMATO_OVERSIZED
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.TOMATO_OVERSIZED"
msgid "Big and juicy."
msgstr "Grande e succoso."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.TOMATO_SEEDS
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.TOMATO_SEEDS"
msgid "We can find out what they are by planting them."
msgstr "Se li piantiamo possiamo scoprire cosa siano."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.TOPHAT
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.TOPHAT"
msgid "Like father used to wear."
msgstr "Come quello di mio padre."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.TOPHAT_MAGICIAN
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.TOPHAT_MAGICIAN"
msgid "Not quite like father used to wear."
msgstr "È un po' diverso da quello che indossava papà."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.TORCH
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.TORCH"
msgid "This should keep us safe."
msgstr "Dovrebbe tenerci al sicuro."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.TOURTIERE
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.TOURTIERE"
msgid "We've never had meat in a pie before."
msgstr "Non abbiamo mai mangiato della carne a forma di torta."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.TOWNPORTAL.ACTIVE
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.TOWNPORTAL.ACTIVE"
msgid "I hope no one gets a headache."
msgstr "Spero che non venga il mal di testa a nessuno."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.TOWNPORTAL.GENERIC
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.TOWNPORTAL.GENERIC"
msgid "Floaty and weird."
msgstr "Fluttuante e strano."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.TOWNPORTALTALISMAN.ACTIVE
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.TOWNPORTALTALISMAN.ACTIVE"
msgid "I think it's ready!"
msgstr "Credo sia pronto!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.TOWNPORTALTALISMAN.GENERIC
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.TOWNPORTALTALISMAN.GENERIC"
msgid "We didn't know rocks could smell."
msgstr "Non sapevamo che le rocce avessero un odore."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.TRAILMIX
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.TRAILMIX"
msgid "Crunchy and healthy."
msgstr "Croccante e sano."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.TRAILS
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.TRAILS"
msgid "No monkey business, mister!"
msgstr "Non lo puoi scimmiottare!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.TRANSISTOR
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.TRANSISTOR"
msgid "A very well crafted doodad!"
msgstr "Un coso molto ben fatto!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.TRAP
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.TRAP"
msgid "Now we can catch some food!"
msgstr "Ora possiamo prendere qualcosa da mangiare!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.TRAP_BRAMBLE
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.TRAP_BRAMBLE"
msgid "It's a very pointy planty trap!"
msgstr "È una trappola vegetale molto appuntita!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.TRAP_FUMAROLE.GENERIC
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.TRAP_FUMAROLE.GENERIC"
msgid "Now it's just rocks."
msgstr "Ora sono solo pietre."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.TRAP_FUMAROLE.HELD
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.TRAP_FUMAROLE.HELD"
msgid "If any bullies chase us, we know what to do!"
msgstr "Se qualche cattivone ci insegue, sappiamo cosa fare!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.TRAP_FUMAROLE.HOT
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.TRAP_FUMAROLE.HOT"
msgid "The floor's lava!"
msgstr "Il pavimento è lava!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.TRAP_FUMAROLE.WARM
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.TRAP_FUMAROLE.WARM"
msgid "It's too hot for our feet!"
msgstr "È troppo caldo per le nostre zampette!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.TRAP_STARFISH.CLOSED
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.TRAP_STARFISH.CLOSED"
msgid "Yikes, that thing was hungry!"
msgstr "Cavolo, quella cosa aveva fame!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.TRAP_STARFISH.GENERIC
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.TRAP_STARFISH.GENERIC"
msgid "What a cute starfish!"
msgstr "Che bella stella marina!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.TRAP_TEETH
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.TRAP_TEETH"
msgid "This will hurt our enemies."
msgstr "Farà male ai nostri nemici."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.TRAP_TEETH_MAXWELL
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.TRAP_TEETH_MAXWELL"
msgid "Who would put this here? We could get hurt!"
msgstr "Chi metterebbe una cosa del genere qui? Potremmo farci male!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.TREASURECHEST.BURNT
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.TREASURECHEST.BURNT"
msgid "It won't be very useful to us now."
msgstr "Non ci sarà molto utile adesso."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.TREASURECHEST.GENERIC
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.TREASURECHEST.GENERIC"
msgid "We could keep our toys in it!"
msgstr "Potremmo metterci i nostri giocattoli!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.TREASURECHEST.UPGRADED_STACKSIZE
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.TREASURECHEST.UPGRADED_STACKSIZE"
msgid "Think of all the toys we could fit in there!"
msgstr "Pensa a quanti giochi potrebbero starci!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.TREASURECHEST_TRAP
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.TREASURECHEST_TRAP"
msgid "It couldn't hurt to take a peek inside..."
msgstr "Non dovrebbe far torto a nessuno dare uno sguardo all'interno..."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.TREECLUMP
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.TREECLUMP"
msgid "It's in our way!"
msgstr "È sulla nostra strada."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.TREEGROWTHSOLUTION
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.TREEGROWTHSOLUTION"
msgid "If only we had some peanut butter."
msgstr "Se solo avessimo del burro d'arachidi."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.TREE_ROCK.BURNING
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.TREE_ROCK.BURNING"
msgid "Get out of the way!"
msgstr "Via di qua!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.TREE_ROCK.CHOPPED
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.TREE_ROCK.CHOPPED"
msgid "We'll mine it!"
msgstr "Lo picconiamo!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.TREE_ROCK.GENERIC
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.TREE_ROCK.GENERIC"
msgid "When the bough breaks..."
msgstr "È dentro una culla!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.TREE_ROCK_SAPLING
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.TREE_ROCK_SAPLING"
msgid "They grow up so fast!"
msgstr "Crescono in fretta!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.TREE_ROCK_SEED
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.TREE_ROCK_SEED"
msgid "What a cute little seed!"
msgstr "Che bel semino!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.TRIDENT
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.TRIDENT"
msgid "We don't know how to play, but we can try!"
msgstr "Non sappiamo come giocare a questo gioco, ma possiamo provare."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.TRINKET_1
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.TRINKET_1"
