msgstr "Un luogo sicuro dove i miciorsetti possono riposare dopo aver giocato."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.KITCOONDEN.PLAYING_HIDEANDSEEK
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.KITCOONDEN.PLAYING_HIDEANDSEEK"
msgid "They're hiding..."
msgstr "Si stanno nascondendo..."

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.KITCOONDEN.PLAYING_HIDEANDSEEK_TIME_ALMOST_UP
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.KITCOONDEN.PLAYING_HIDEANDSEEK_TIME_ALMOST_UP"
