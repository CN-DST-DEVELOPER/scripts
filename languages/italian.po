msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.TURF_SHELLBEACH"
msgid "Just some ground, eh?"
msgstr "Solo un po' di terra, eh?"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.TURF_SINKHOLE
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.TURF_SINKHOLE"
msgid "I found this underground."
msgstr "L'ho trovato sottoterra."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.TURF_UNDERROCK
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.TURF_UNDERROCK"
msgid "Rocks. Bleh."
msgstr "Rocce. Bleah."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.TURF_VAULT
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.TURF_VAULT"
msgid "That's some nice stonework!"
msgstr "Che belle pietre!"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.TURF_VENT
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.TURF_VENT"
msgid "Rocks. Bleh."
msgstr "Rocce. Bleah."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.TURF_WOODFLOOR
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.TURF_WOODFLOOR"
msgid "Flooring fit for a king!"
msgstr "Una pavimentazione adatta a un re!"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.TURKEYDINNER
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.TURKEYDINNER"
msgid "Turkey day is here again!"
msgstr "Oggi è nuovamente il giorno del tacchino!"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.TURNIP
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.TURNIP"
msgid "From the community garden."
msgstr "Dai giardini comunali."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.TURNIP_COOKED
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.TURNIP_COOKED"
msgid "Cooked real nice."
msgstr "Cucinato davvero bene."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.TURNIP_SEEDS
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.TURNIP_SEEDS"
msgid "Looks like new crop seeds to me."
msgstr "Mi sembrano semi per un nuovo raccolto."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.TURTILLUS
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.TURTILLUS"
msgid "Gotta keep that one from hiding, eh?"
msgstr "Bisogna evitare che si nasconda, eh?"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.TWIGGYTREE.BURNING
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.TWIGGYTREE.BURNING"
msgid "Sorry!"
msgstr "Spiacente!"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.TWIGGYTREE.BURNT
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.TWIGGYTREE.BURNT"
msgid "How terrible!"
msgstr "Che tragedia!"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.TWIGGYTREE.CHOPPED
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.TWIGGYTREE.CHOPPED"
msgid "Another one!"
msgstr "Un altro!"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.TWIGGYTREE.DISEASED
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.TWIGGYTREE.DISEASED"
msgid "It's caught a bit of a bug."
msgstr "Ha preso un virus."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.TWIGGYTREE.GENERIC
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.TWIGGYTREE.GENERIC"
msgid "Choppin's choppin'."
msgstr "Taglia taglia."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.TWIGGY_NUT
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.TWIGGY_NUT"
msgid "With a little care, this could make fer some good choppin'."
msgstr "Con un po' di attenzione, potrebbe essere buono da tagliare."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.TWIGGY_NUT_SAPLING
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.TWIGGY_NUT_SAPLING"
msgid "One day it'll make good chopping."
msgstr "Un giorno sarà buono da tagliare."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.TWIGGY_OLD
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.TWIGGY_OLD"
msgid "I'd be lucky to get two chops out of that thing."
msgstr "Sarei fortunato a ricavarci due colpi da quella cosa."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.TWIGS
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.TWIGS"
msgid "I should build a tiny axe to chop these."
msgstr "Dovrei costruire una piccola ascia per tagliarli."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.TWINOFTERROR1
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.TWINOFTERROR1"
msgid "Lucy, I think I'm seeing double!"
msgstr "Lucy, credo di vedere doppio!"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.TWINOFTERROR2
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.TWINOFTERROR2"
msgid "Lucy, I think I'm seeing double!"
msgstr "Lucy, credo di vedere doppio!"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.UMBRELLA
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.UMBRELLA"
msgid "Something like that'd keep my beard dry, eh?"
msgstr "Qualcosa del genere che mantenga la mia barba asciutta, eh?"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.UNAGI
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.UNAGI"
msgid "It'll fill ya up."
msgstr "Ti riempirà."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.UNIMPLEMENTED
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.UNIMPLEMENTED"
msgid "It doesn't look safe."
msgstr "Non sembra sicuro."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.VAULT_CHANDELIER_BROKEN
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.VAULT_CHANDELIER_BROKEN"
msgid "Better keep careful around here."
msgstr "Meglio fare attenzione qui."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.VAULT_COMPASS.GENERIC
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.VAULT_COMPASS.GENERIC"
msgid "I don't need directions, right Luce? ...What's that face for?"
msgstr "Non ho bisogno di indicazioni, vero, Lucy? ... Cos'è quella faccia?"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.VAULT_COMPASS.KEYROOM
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.VAULT_COMPASS.KEYROOM"
msgid "Looks like we're already here, eh?"
msgstr "Siamo già arrivati, eh?"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.VAULT_COMPASS.NOTVAULT
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.VAULT_COMPASS.NOTVAULT"
msgid "Huh. Can't seem to get a read on it here."
msgstr "Ah. Qui non sembra funzionare."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.VAULT_CRAWLER.GENERIC
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.VAULT_CRAWLER.GENERIC"
msgid "You're not just here to bug me, eh?"
msgstr "Non sei qui solo per infastidirmi, eh?"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.VAULT_CRAWLER.SOCKETED
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.VAULT_CRAWLER.SOCKETED"
msgid "And stay there!"
msgstr "E restaci!"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.VAULT_CRAWLER_LEVER
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.VAULT_CRAWLER_LEVER"
msgid "What's the worst that could happen, eh?"
msgstr "Cos'è il peggio che potrebbe accadere, eh?"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.VAULT_DECON_DOOR
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.VAULT_DECON_DOOR"
msgid "I don't like feelin' penned in."
msgstr "Non mi piace sentirmi rinchiuso."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.VAULT_DECON_MISTER
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.VAULT_DECON_MISTER"
msgid "Reminds me a bit of a sweat lodge."
msgstr "Mi ricorda vagamente una sauna."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.VAULT_KEY
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.VAULT_KEY"
msgid "Hard to believe this could actually get us home..."
msgstr "Non riesco a credere che potrebbe riportarci a casa..."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.VAULT_KEY_ACTIVATOR
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.VAULT_KEY_ACTIVATOR"
msgid "Hm. Looks like something's meant to go inside."
msgstr "Uhm. Sembra che vada aggiunto qualcosa all'interno."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.VAULT_KEY_EXIT
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.VAULT_KEY_EXIT"
msgid "Can't tie a rope here, eh?"
msgstr "Non c'è nulla a cui legare una fune, eh?"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.VAULT_KEY_PEDESTAL.GENERIC
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.VAULT_KEY_PEDESTAL.GENERIC"
msgid "It's there for the taking."
msgstr "È a portata di mano."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.VAULT_KEY_PEDESTAL.PICKED
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.VAULT_KEY_PEDESTAL.PICKED"
msgid "It's gone."
msgstr "È stata presa."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.VAULT_LOBBY_EXIT
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.VAULT_LOBBY_EXIT"
msgid "Throwin' a line down would make it a lot easier to come back up."
msgstr "Calare una fune renderebbe molto più semplice la risalita."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.VAULT_ORB
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.VAULT_ORB"
msgid "Wonder what it does."
msgstr "Chissà a cosa serve."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.VAULT_ORB_REFINED
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.VAULT_ORB_REFINED"
msgid "It sure cleans up nicely."
msgstr "Pulisce che è un piacere."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.VAULT_PILLAR_GUARD
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.VAULT_PILLAR_GUARD"
msgid "A big stone hoser."
msgstr "Un grande poveretto di pietra."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.VAULT_PILLAR_GUARD_CONSTR
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.VAULT_PILLAR_GUARD_CONSTR"
msgid "It needs work, Luce."
msgstr "Il lavoro non è ancora finito, Lucy."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.VAULT_PILLAR_GUARD_CONSTR_PLANS
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.VAULT_PILLAR_GUARD_CONSTR_PLANS"
msgid "Where shall we put it, Luce?"
msgstr "Dove la mettiamo, Lucy?"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.VAULT_PILLAR_GUARD_CRAFTED
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.VAULT_PILLAR_GUARD_CRAFTED"
msgid "I'm glad it's friendly."
msgstr "Sono felice che sia amichevole."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.VAULT_PILLAR_GUARD_DORMANT
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.VAULT_PILLAR_GUARD_DORMANT"
msgid "No, Luce. I don't think you could."
msgstr "No, Lucy. Temo tu non possa."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.VAULT_PILLAR_GUARD_DORMANT_CRAFTED
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.VAULT_PILLAR_GUARD_DORMANT_CRAFTED"
msgid "It needs some sort of energy, Luce."
msgstr "Ha bisogno di un qualche tipo di energia, Lucy."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.VAULT_PILLAR_GUARD_PIECE
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.VAULT_PILLAR_GUARD_PIECE"
msgid "Must be a part for that stone hoser."
msgstr "Deve far parte di quel poveretto di pietra."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.VAULT_REFINER_PEDESTAL
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.VAULT_REFINER_PEDESTAL"
msgid "I'm sure it's not a table saw."
msgstr "So solo che non è una sega da tavolo."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.VAULT_RUNE
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.VAULT_RUNE"
msgid "Maybe I'm reading them upside-down."
msgstr "Forse le sto leggendo al contrario."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.VAULT_STATUE.LORE1
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.VAULT_STATUE.LORE1"
msgid "Oh geez, he's rotten to the core."
msgstr "Oh, è marcio fino al midollo."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.VAULT_STATUE.LORE2
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.VAULT_STATUE.LORE2"
msgid "Someone... or something did a number on them."
msgstr "Qualcuno... o qualcosa gli ha giocato un brutto tiro."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.VAULT_STATUE.LORE3
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.VAULT_STATUE.LORE3"
msgid "Great. Giant armed termites."
msgstr "Splendido. Termiti giganti armate."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.VAULT_TELEPORTER.BROKEN
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.VAULT_TELEPORTER.BROKEN"
msgid "Looks pretty broken."
msgstr "Sembra decisamente rotto."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.VAULT_TELEPORTER.GENERIC
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.VAULT_TELEPORTER.GENERIC"
msgid "This might feel a little funny, Luce."
msgstr "Ti farà provare una strana sensazione, Lucy."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.VAULT_TELEPORTER.UNPOWERED
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.VAULT_TELEPORTER.UNPOWERED"
msgid "I don't think it's turned on."
msgstr "Non credo sia acceso."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.VAULT_TORCH.BROKEN
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.VAULT_TORCH.BROKEN"
msgid "It's broken."
msgstr "È rotta."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.VAULT_TORCH.GENERIC
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.VAULT_TORCH.GENERIC"
msgid "That's a big oil lamp."
msgstr "È una grande lampada a olio."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.VEGGIEOMLET
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.VEGGIEOMLET"
msgid "Veggies? Did we run outta bacon and potatoes?"
msgstr "Ortaggi? Abbiamo finito pancetta e patate?"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.VEGGIE_OVERSIZED_ROTTEN
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.VEGGIE_OVERSIZED_ROTTEN"
msgid "The only thing it's good for is compost."
msgstr "L'unica cosa per cui può tornare utile è il compost."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.VEGSTINGER
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.VEGSTINGER"
msgid "Hoo! Spicy!"
msgstr "Ohh! Piccante!"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.VICTORIAN_BLUEPRINT
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.VICTORIAN_BLUEPRINT"
msgid "Pretty fancy, eh?"
msgstr "Molto elegante, eh?"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.VOIDCLOTH
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.VOIDCLOTH"
msgid "It ain't flannel, but I can work with it."
msgstr "Non è di flanella, ma può tornarmi utile."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.VOIDCLOTHHAT
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.VOIDCLOTHHAT"
msgid "A dark hood, full of secrets."
msgstr "Un cappuccio scuro, pieno di segreti."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.VOIDCLOTH_BOOMERANG
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.VOIDCLOTH_BOOMERANG"
msgid "Let's huck it at something."
msgstr "Lanciamolo a qualcosa."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.VOIDCLOTH_KIT
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.VOIDCLOTH_KIT"
msgid "That should patch things up easy enough, eh?"
msgstr "Dovrebbe riparare ogni cosa senza difficoltà, eh?"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.VOIDCLOTH_SCYTHE
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.VOIDCLOTH_SCYTHE"
msgid "Luce says she doesn't like him."
msgstr "Lucy dice che non le piace."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.VOIDCLOTH_UMBRELLA
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.VOIDCLOTH_UMBRELLA"
msgid "As long as it works, I won't complain aboot how it looks."
msgstr "Fintanto che funziona, non mi lamenterò del suo aspetto."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.VOLTGOATJELLY
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.VOLTGOATJELLY"
msgid "Can't remember the last time I had dessert."
msgstr "Non ricordo l'ultima volta che ho mangiato un dolce."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.WAFFLES
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.WAFFLES"
msgid "I prefer flapjacks."
msgstr "Preferisco le frittelle."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.WAGBOSS_ROBOT
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.WAGBOSS_ROBOT"
msgid "Aw, Luce. I don't think it chops trees."
msgstr "Oh, Lucy. Non credo che tagli gli alberi."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.WAGBOSS_ROBOT_CONSTRUCTIONSITE
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.WAGBOSS_ROBOT_CONSTRUCTIONSITE"
msgid "That's looking more like it."
msgstr "Ora va meglio."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.WAGBOSS_ROBOT_CONSTRUCTIONSITE_KIT
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.WAGBOSS_ROBOT_CONSTRUCTIONSITE_KIT"
msgid "How does all that fit in here?"
msgstr "Come fa a starci?"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.WAGBOSS_ROBOT_CREATION_PARTS
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.WAGBOSS_ROBOT_CREATION_PARTS"
msgid "Are these the murdery parts?"
msgstr "Sono i pezzi assassini?"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.WAGBOSS_ROBOT_LEG
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.WAGBOSS_ROBOT_LEG"
msgid "No you can't chop it in half, Lucy. It's too tough even for you."
msgstr "No, non puoi tagliarla in due, Lucy. È troppo dura persino per te."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.WAGBOSS_ROBOT_POSSESSED
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.WAGBOSS_ROBOT_POSSESSED"
msgid "Hey, quit tryin' to kill us!"
msgstr "Ehi, smettila di provare a ucciderci!"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.WAGBOSS_ROBOT_SECRET
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.WAGBOSS_ROBOT_SECRET"
msgid "Are you as curious as I am, Luce?"
msgstr "Sei curiosa quanto me, Lucy?"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.WAGDRONE_BEACON
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.WAGDRONE_BEACON"
msgid "No, we can't make a cabin out of these walls, Lucy."
msgstr "No, non possiamo trasformare queste mura in una casetta, Lucy."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.WAGDRONE_FLYING.DAMAGED
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.WAGDRONE_FLYING.DAMAGED"
msgid "We might as well just take the parts from this one."
msgstr "Potremmo recuperare i suoi pezzi."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.WAGDRONE_FLYING.GENERIC
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.WAGDRONE_FLYING.GENERIC"
msgid "They're all around us, Lucy!"
msgstr "Sono tutti intorno a noi, Lucy!"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.WAGDRONE_FLYING.INACTIVE
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.WAGDRONE_FLYING.INACTIVE"
msgid "No, you can't smash it, Lucy."
msgstr "No, non puoi spaccarlo, Lucy."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.WAGDRONE_PARTS
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.WAGDRONE_PARTS"
msgid "Those will come in handy."
msgstr "Ci torneranno utili."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.WAGDRONE_ROLLING.DAMAGED
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.WAGDRONE_ROLLING.DAMAGED"
msgid "We can fix her up or just take the spare parts."
msgstr "Possiamo ripararlo oppure trasformarlo in pezzi di ricambio."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.WAGDRONE_ROLLING.FRIENDLY
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.WAGDRONE_ROLLING.FRIENDLY"
msgid "Let's keep an eye on it, Luce."
msgstr "Teniamolo d'occhio, Lucy."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.WAGDRONE_ROLLING.GENERIC
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.WAGDRONE_ROLLING.GENERIC"
msgid "They just come crawling back!"
msgstr "Continuano a tornare qui!"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.WAGDRONE_ROLLING.INACTIVE
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.WAGDRONE_ROLLING.INACTIVE"
msgid "No, you can't smash it Lucy."
msgstr "No, non puoi spaccarlo, Lucy."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.WAGPUNKBITS_KIT
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.WAGPUNKBITS_KIT"
msgid "A mechanical mechanic, eh? What'll they think up next."
msgstr "Un meccanico meccanico, eh? Che altro s'inventeranno ora?"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.WAGPUNKHAT
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.WAGPUNKHAT"
msgid "Looks like some sorta techie tin toque."
msgstr "Sembra una specie di cappello di stagno per gli amanti della tecnologia."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.WAGPUNK_BITS
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.WAGPUNK_BITS"
msgid "Some odd bits of metal."
msgstr "Strani pezzi di metallo."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.WAGPUNK_CAGEWALL
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.WAGPUNK_CAGEWALL"
msgid "Whatever happened to good ol' fashioned wooden fence posts?"
msgstr "Che fine hanno fatto i bei vecchi pali di legno delle recinzioni?"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.WAGPUNK_FLOOR_KIT
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.WAGPUNK_FLOOR_KIT"
msgid "I prefer wood flooring."
msgstr "Preferisco i pavimenti in legno."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.WAGPUNK_LEVER
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.WAGPUNK_LEVER"
msgid "Lever, Lucy. I said it's a great lever. Sheesh."
msgstr "No, non è un albero, Lucy."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.WAGPUNK_WORKSTATION
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.WAGPUNK_WORKSTATION"
msgid "That's a fancy workbench."
msgstr "È un banco da lavoro davvero raffinato."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.WAGSTAFF_ITEM_1
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.WAGSTAFF_ITEM_1"
msgid "Yeah, Luce. The glove is as real as you or me."
msgstr "Sì, Lucy. Quel guanto è reale quanto me e te."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.WAGSTAFF_ITEM_2
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.WAGSTAFF_ITEM_2"
msgid "That is an actual real live clipboard."
msgstr "È un portablocco in carne e ossa."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.WAGSTAFF_MACHINERY
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.WAGSTAFF_MACHINERY"
msgid "Hey! Someone's littered up the natural landscape!"
msgstr "Ehi! Qualcuno ha insozzato il paesaggio naturale!"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.WAGSTAFF_MUTATIONS_NOTE
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.WAGSTAFF_MUTATIONS_NOTE"
msgid "Can't make heads or tails of it myself, but it seems important."
msgstr "Non ci capisco nulla, ma sembra importante."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.WAGSTAFF_NPC
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.WAGSTAFF_NPC"
msgid "Looks like you're doing somthin' important. How aboot I lend you a hand, eh?"
msgstr "Sembra che tu stia facendo qualcosa di importante. Che ne diresti se ti dessi una mano?"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.WAGSTAFF_NPC_MUTATIONS
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.WAGSTAFF_NPC_MUTATIONS"
msgid "Sounds like he could use our help, eh?"
msgstr "Sembra aver bisogno del nostro aiuto, eh?"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.WAGSTAFF_NPC_WAGPUNK
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.WAGSTAFF_NPC_WAGPUNK"
msgid "Where's that old-timer running off to?"
msgstr "Dove sta correndo quel vecchio?"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.WAGSTAFF_TOOL_1
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.WAGSTAFF_TOOL_1"
msgid "I'd better run it back to that old-timer."
msgstr "Devo portarlo subito a quel vecchio."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.WAGSTAFF_TOOL_2
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.WAGSTAFF_TOOL_2"
msgid "Not really sure what it is, but maybe I'll bring it to that old-timer just in case."
msgstr "Non so bene cosa sia, ma per sicurezza dovrei portarlo a quel vecchio."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.WAGSTAFF_TOOL_3
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.WAGSTAFF_TOOL_3"
msgid "Hey Luce, does that look like a whatever-he-said to you?"
msgstr "Ehi, Lucy, ti sembra l'aggeggio di cui parlava?"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.WAGSTAFF_TOOL_4
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.WAGSTAFF_TOOL_4"
msgid "Wouldn't hurt to see if this is what that old-timer's been looking for."
msgstr "Non sarebbe male scoprire se questo è ciò che stava cercando quel vecchio."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.WAGSTAFF_TOOL_5
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.WAGSTAFF_TOOL_5"
msgid "That might be just the thing I'm lookin' for!"
msgstr "Potrebbe essere proprio quello che stavo cercando!"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.WALKINGPLANK
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.WALKINGPLANK"
msgid "Hopefully we don't have to abandon ship."
msgstr "Speriamo di non dover abbandonare la nave."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.WALKINGPLANK_ANCIENT
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.WALKINGPLANK_ANCIENT"
msgid "Hopefully we don't have to abandon ship."
msgstr "Speriamo di non dover abbandonare la nave."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.WALKINGPLANK_GRASS
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.WALKINGPLANK_GRASS"
msgid "Hopefully we don't have to abandon ship."
msgstr "Speriamo di non dover abbandonare la nave."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.WALKINGPLANK_YOTD
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.WALKINGPLANK_YOTD"
msgid "You can fancy it up, but I still don't want to use it."
msgstr "Puoi abbellirla fin che vuoi, ma non ho alcuna intenzione di usarla."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.WALKING_STICK
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.WALKING_STICK"
msgid "A bird, huh? Real funny, Luce."
msgstr "Un uccello, eh? Divertente, Lucy."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.WALL_DREADSTONE
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.WALL_DREADSTONE"
msgid "Not exactly cozy, eh?"
msgstr "Non si direbbe accogliente, eh?"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.WALL_DREADSTONE_ITEM
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.WALL_DREADSTONE_ITEM"
msgid "I'd rather build walls out of lumber."
msgstr "Preferirei costruire muri con il legname."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.WALL_HAY.BURNT
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.WALL_HAY.BURNT"
msgid "Well, that escalated quickly."
msgstr "Beh, la cosa si è intensificata rapidamente."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.WALL_HAY.GENERIC
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.WALL_HAY.GENERIC"
msgid "You could sneeze it down."
msgstr "Si potrebbe abbatterlo con uno starnuto."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.WALL_HAY_ITEM
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.WALL_HAY_ITEM"
msgid "I could sneeze it apart."
msgstr "Potrei abbatterlo con uno starnuto."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.WALL_MOONROCK
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.WALL_MOONROCK"
msgid "Looks nice'n'sturdy."
msgstr "Sembra bella e robusta."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.WALL_MOONROCK_ITEM
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.WALL_MOONROCK_ITEM"
msgid "It's not much use like that."
msgstr "Non è di grande utilità così."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.WALL_RUINS
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.WALL_RUINS"
msgid "Crumbling, but still secure, eh?"
msgstr "Fatiscente, ma ancora sicuro, eh?"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.WALL_RUINS_2
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.WALL_RUINS_2"
msgid "Crumbling, but still secure, eh?"
msgstr "Fatiscente, ma ancora sicuro, eh?"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.WALL_RUINS_ITEM
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.WALL_RUINS_ITEM"
msgid "Heh, stoned again, eh?"
msgstr "Eh, altre pietre, eh?"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.WALL_SCRAP
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.WALL_SCRAP"
msgid "Are walls supposed to smell?"
msgstr "È normale che un muro puzzi?"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.WALL_SCRAP_ITEM
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.WALL_SCRAP_ITEM"
msgid "Are walls supposed to smell?"
msgstr "È normale che un muro puzzi?"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.WALL_STONE
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.WALL_STONE"
msgid "Safe and secure, eh?"
msgstr "Al salvo e al sicuro, eh?"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.WALL_STONE_2
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.WALL_STONE_2"
msgid "Safe and secure, eh?"
msgstr "Protetto e al sicuro, eh?"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.WALL_STONE_ITEM
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.WALL_STONE_ITEM"
msgid "Safe and secure, eh?"
msgstr "In salvo e al sicuro, eh?"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.WALL_WOOD.BURNT
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.WALL_WOOD.BURNT"
msgid "I miss the old you."
msgstr "Mi manca il vecchio te."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.WALL_WOOD.GENERIC
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.WALL_WOOD.GENERIC"
msgid "I like the look of that!"
msgstr "Mi piace il suo aspetto!"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.WALL_WOOD_ITEM
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.WALL_WOOD_ITEM"
msgid "I like the look of that!"
msgstr "Mi piace il suo aspetto!"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.WALRUS
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.WALRUS"
msgid "Oh no. Walruses again!"
msgstr "Oh no. Altri trichechi!"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.WALRUSHAT
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.WALRUSHAT"
msgid "My granddad wore a hat like that."
msgstr "Mio nonno portava un cappello come questo."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.WALRUS_CAMP.EMPTY
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.WALRUS_CAMP.EMPTY"
msgid "This won't be safe come winter."
msgstr "Non sarà sicuro con l'arrivo dell'inverno."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.WALRUS_CAMP.GENERIC
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.WALRUS_CAMP.GENERIC"
msgid "Walruses are nearby, eh?"
msgstr "I trichechi sono nelle vicinanze, eh?"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.WALRUS_TUSK
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.WALRUS_TUSK"
msgid "He had a cavity, eh?"
msgstr "Aveva una carie, eh?"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.WALTER.ATTACKER
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.WALTER.ATTACKER"
msgid "That wasn't very polite, eh?"
msgstr "Non è stato molto educato, eh?"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.WALTER.FIRESTARTER
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.WALTER.FIRESTARTER"
msgid "I thought you said you knew how to build a campfire?"
msgstr "Pensavo che mi avessi detto che sapevi come si accende un fuoco da campo?"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.WALTER.GENERIC
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.WALTER.GENERIC"
msgid "Hey, %s! Nice seeing someone from my neck of the woods!"
msgstr "Ehi, %s! Sono felice di incontrare qualcuno delle mie parti!"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.WALTER.GHOST
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.WALTER.GHOST"
msgid "C'mon kiddo, let's get you a heart."
msgstr "Forza, ragazzo. Troviamoti un cuore."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.WALTER.MURDERER
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.WALTER.MURDERER"
msgid "\"Sorry\"'s not gonna cut it this time!"
msgstr "Questa volta dire \"mi dispiace\" non sarà sufficiente!"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.WALTER.REVIVER
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.WALTER.REVIVER"
msgid "Thanks for havin' my back, %s!"
msgstr "Grazie per avermi dato una mano, %s!"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.WALTERHAT
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.WALTERHAT"
msgid "Lookit that, it's got a little maple leaf on it!"
msgstr "Ma guarda un po', c'è sopra una piccola foglia d'acero!"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.WANDA.ATTACKER
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.WANDA.ATTACKER"
msgid "Yikes! She's got a suprisingly strong right hook."
msgstr "Accidenti! Ha un gancio destro davvero sorprendente."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.WANDA.FIRESTARTER
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.WANDA.FIRESTARTER"
msgid "Hey, watch where you're burnin'!"
msgstr "Ehi, guarda dove bruci!"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.WANDA.GENERIC
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.WANDA.GENERIC"
msgid "Aboot time you came by for a visit, %s!"
msgstr "Era ora che venissi a farmi visita, %s!"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.WANDA.GHOST
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.WANDA.GHOST"
msgid "I'm lookin' for a heart! Just give me a minute, eh?"
msgstr "Sto cercando un cuore! Dammi solo un minuto!"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.WANDA.MURDERER
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.WANDA.MURDERER"
msgid "Lucy and I think it's time we put a stop to you, %s."
msgstr "Io e Lucy pensiamo che sia ora di fermarti, %s."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.WANDA.REVIVER
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.WANDA.REVIVER"
msgid "I'm sure glad you're here, %s."
msgstr "Sono felice che tu sia qui, %s."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.WANDERINGTRADER.GENERIC
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.WANDERINGTRADER.GENERIC"
msgid "It looks unnatural."
msgstr "Sembra innaturale."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.WANDERINGTRADER.REVEALED
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.WANDERINGTRADER.REVEALED"
msgid "Don't worry, Luce. I could never trade you."
msgstr "Non temere, Lucy. Non ti darei mai via."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.WARDROBE.BURNING
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.WARDROBE.BURNING"
msgid "Wood is the best at burning."
msgstr "Il legno è imbattibile nel bruciare."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.WARDROBE.BURNT
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.WARDROBE.BURNT"
msgid "Not so useful now, eh?"
msgstr "È così utile!"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.WARDROBE.GENERIC
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.WARDROBE.GENERIC"
msgid "It's hard to stay neat and tidy in the woods."
msgstr "È difficile rimanere pulito e ordinato nel bosco."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.WARG
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.WARG"
msgid "That thing could pull a sled by its lonesome."
msgstr "Quel coso potrebbe tirare una slitta in solitudine."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.WARGCORPSE.BURNING
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.WARGCORPSE.BURNING"
msgid "Burnt blacker than a pile o' pucks."
msgstr "È ancora più nero di un mucchio di dischi."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.WARGCORPSE.GENERIC
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.WARGCORPSE.GENERIC"
msgid "Someone punched this pooch's ticket."
msgstr "Qualcuno ha estratto il biglietto di questo cagnetto."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.WARGCORPSE.REVIVING
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.WARGCORPSE.REVIVING"
msgid "Not somethin' you see everyday, eh Luce?"
msgstr "Non è una cosa che si vede tutti i giorni, eh, Lucy?"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.WARGLET
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.WARGLET"
msgid "Think you can mess with me, eh?"
msgstr "Pensi di potermi prendere in giro, eh?"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.WARGSHRINE.BURNT
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.WARGSHRINE.BURNT"
msgid "Burned up."
msgstr "Tutto bruciato."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.WARGSHRINE.EMPTY
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.WARGSHRINE.EMPTY"
msgid "Gotta warm this doghouse up, eh?"
msgstr "Bisogna riscaldare questa cuccia del cane, eh?"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.WARGSHRINE.GENERIC
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.WARGSHRINE.GENERIC"
msgid "Nice and toasty."
msgstr "Bello e caldo."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.WARLY.ATTACKER
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.WARLY.ATTACKER"
msgid "Careful where you're swingin', %s."
msgstr "Attento a dove colpisci, %s."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.WARLY.FIRESTARTER
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.WARLY.FIRESTARTER"
msgid "Watch that fire now, %s."
msgstr "Tieni sotto controllo il fuoco, %s."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.WARLY.GENERIC
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.WARLY.GENERIC"
msgid "%s, buddy! How you doing?"
msgstr "%s, amico! Come va?"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.WARLY.GHOST
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.WARLY.GHOST"
msgid "Welp, that's the way the cookie crumbles."
msgstr "Gulp, è così che si sbriciolano i biscotti."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.WARLY.MURDERER
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.WARLY.MURDERER"
msgid "I'm gonna soufflé you alive!"
msgstr "Ti uso per fare un bel soufflé!"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.WARLY.REVIVER
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.WARLY.REVIVER"
msgid "%s is a stand up kinda guy."
msgstr "%s cade sempre in piedi."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.WAR_BLUEPRINT
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.WAR_BLUEPRINT"
msgid "Pretty intimidating, eh Lucy?"
msgstr "Molto minaccioso, eh, Lucy?"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.WASPHIVE
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.WASPHIVE"
msgid "Why are those bees so angry?"
msgstr "Perché quelle api sono così arrabbiate?"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.WATERBALLOON
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.WATERBALLOON"
msgid "Could be fun times lobbin' these around."
msgstr "Potrebbe essere divertente lanciarli in giro."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.WATERINGCAN.EMPTY
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.WATERINGCAN.EMPTY"
msgid "Out of water."
msgstr "È senza acqua."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.WATERINGCAN.GENERIC
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.WATERINGCAN.GENERIC"
msgid "Better take my turn watering the garden."
msgstr "È il mio turno di annaffiare l'orto."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.WATERMELON
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.WATERMELON"
msgid "How can it be both water and melon?"
msgstr "Come può essere sia acqua che anguria?"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.WATERMELONHAT
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.WATERMELONHAT"
msgid "Well, points for creativity."
msgstr "Beh, complimenti alla creatività."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.WATERMELONICLE
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.WATERMELONICLE"
msgid "Wood AND food?!"
msgstr "Legno e cibo?!"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.WATERMELON_COOKED
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.WATERMELON_COOKED"
msgid "I'm not sure aboot grilled fruit..."
msgstr "Non sono sicuro della frutta alla griglia..."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.WATERMELON_OVERSIZED
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.WATERMELON_OVERSIZED"
msgid "Now that's a big one!"
msgstr "Questa sì che è grossa!"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.WATERMELON_SEEDS
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.WATERMELON_SEEDS"
msgid "Maybe I could plant them?"
msgstr "Forse potrei piantarli."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.WATERPLANT
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.WATERPLANT"
msgid "That flower's tall as a pine tree!"
msgstr "Quel fiore è alto come un pino!"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.WATERPLANT_BABY
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.WATERPLANT_BABY"
msgid "Just a sapling."
msgstr "È solo un alberello."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.WATERPLANT_BOMB
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.WATERPLANT_BOMB"
msgid "You're just asking to be chopped!"
msgstr "Stai chiedendo a gran voce di essere tagliata!"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.WATERPLANT_PLANTER
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.WATERPLANT_PLANTER"
msgid "Where will you cause the least amount of damage..."
msgstr "Almeno così farai meno danni..."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.WATERPUMP
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.WATERPUMP"
msgid "It's a shame wood has to be so flammable."
msgstr "È un peccato che il legno sia così infiammabile."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.WATERTREE_PILLAR
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.WATERTREE_PILLAR"
msgid "Look at all that tree..."
msgstr "Guarda com'è grande quell'albero..."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.WATERTREE_ROOT
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.WATERTREE_ROOT"
msgid "Some stray bits of tree."
msgstr "Alcuni pezzi di albero vaganti."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.WATHGRITHR.ATTACKER
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.WATHGRITHR.ATTACKER"
msgid "%s has raiding and looting on the brain..."
msgstr "%s ha razzie e saccheggi nel cervello..."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.WATHGRITHR.FIRESTARTER
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.WATHGRITHR.FIRESTARTER"
msgid "What's with the fires lately, bud?"
msgstr "Cos'è questo attaccamento ai fuochi ultimamente, amica?"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.WATHGRITHR.GENERIC
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.WATHGRITHR.GENERIC"
msgid "%s! Hey bud!"
msgstr "%s! Ehi, amica!"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.WATHGRITHR.GHOST
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.WATHGRITHR.GHOST"
msgid "With a heart you'll be feelin' like your mighty self in no time."
msgstr "Con un cuore ti sentirai subito di nuovo la potente te stessa."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.WATHGRITHR.MURDERER
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.WATHGRITHR.MURDERER"
msgid "Your spear versus my axe, let's see whatcha got, eh!"
msgstr "La tua lancia contro la mia ascia, vediamo chi la spunta, eh!"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.WATHGRITHR.REVIVER
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.WATHGRITHR.REVIVER"
msgid "I'm glad you're on our side, %s."
msgstr "Sono contento che sei dalla nostra parte, %s."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.WATHGRITHRHAT
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.WATHGRITHRHAT"
msgid "Pretty snappy looking."
msgstr "Sembra piuttosto vivace."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.WATHGRITHR_IMPROVEDHAT
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.WATHGRITHR_IMPROVEDHAT"
msgid "Minus the wings and horn, it's basically a toque."
msgstr "Tolte le ali e il corno, è praticamente un tocco."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.WATHGRITHR_SHIELD
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.WATHGRITHR_SHIELD"
msgid "That'll take a lickin', eh Luce?"
msgstr "Resisterà a lungo, eh, Lucy?"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.WAXED_PLANT
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.WAXED_PLANT"
msgid "It won't wither away, but it also won't be growing anytime soon."
msgstr "Non avvizzirà, ma non crescerà nemmeno."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.WAXPAPER
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.WAXPAPER"
msgid "A good place to spit out your gum."
msgstr "Utile per sputarci la gomma da masticare."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.WAXWELL.ATTACKER
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.WAXWELL.ATTACKER"
msgid "%s'll end up on the wrong end of my axe if he's not careful..."
msgstr "%s finirà dalla parte sbagliata della mia ascia se non fa attenzione..."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.WAXWELL.FIRESTARTER
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.WAXWELL.FIRESTARTER"
msgid "You'll not want to be burning things, bud."
msgstr "Non vorrai metterti a bruciare le cose, amico."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.WAXWELL.GENERIC
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.WAXWELL.GENERIC"
msgid "Hey %s, how you doin' ya big hoser?"
msgstr "Ehi %s, come stai pezzo di gradasso?"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.WAXWELL.GHOST
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.WAXWELL.GHOST"
msgid "Lucy says I have to help you, %s. Let's get goin'."
msgstr "Lucy dice che devo aiutarti, %s. Mettiamoci all'opera."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.WAXWELL.MURDERER
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.WAXWELL.MURDERER"
msgid "Yer still a hoser! Now it's choppin' time!"
msgstr "Sei sempre un gradasso! È il momento di tagliare!"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.WAXWELL.REVIVER
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.WAXWELL.REVIVER"
msgid "You're growin' on me, %s. Like a fungus."
msgstr "La mia stima di te sta crescendo, %s. Come un fungo."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.WAXWELLJOURNAL.GENERIC
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.WAXWELLJOURNAL.GENERIC"
msgid "Trees made into... paper? How unholy!"
msgstr "Gli alberi trasformati in... carta? Che scempio!"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.WEBBER.ATTACKER
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.WEBBER.ATTACKER"
msgid "Hey %s, can't we all just get a-log?"
msgstr "Ehi %s, possiamo provare ad andare d'accordo?"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.WEBBER.FIRESTARTER
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.WEBBER.FIRESTARTER"
msgid "I better not see anymore fires, little buddy."
msgstr "Meglio che non veda più incendi, piccino."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.WEBBER.GENERIC
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.WEBBER.GENERIC"
msgid "%s! Hi little buddy!"
msgstr "%s! Ciao piccino!"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.WEBBER.GHOST
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.WEBBER.GHOST"
msgid "We better get you a heart, hey kiddo?"
msgstr "Faremmo meglio a procurarti un cuore, eh ragazzino?"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.WEBBER.MURDERER
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.WEBBER.MURDERER"
msgid "'Luce gave me the go-ahead! You're in trouble now, %s!"
msgstr "Lucy mi ha dato il via libera! Sei nei guai, %s!"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.WEBBER.REVIVER
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.WEBBER.REVIVER"
msgid "You're an alright spider, kiddo."
msgstr "Sei un buon ragno, ragazzino."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.WEBBERSKULL
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.WEBBERSKULL"
msgid "The skull gives me the willies, too."
msgstr "Anche il cranio mi dà i brividi."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.WEBBER_SPIDER_MINION
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.WEBBER_SPIDER_MINION"
msgid "Better small spiders than big, I suppose."
msgstr "Meglio i ragnetti che i ragni, credo."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.WEED_IVY
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.WEED_IVY"
msgid "It has some nasty looking thorns on it."
msgstr "Ha delle spine davvero minacciose."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.WENDY.ATTACKER
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.WENDY.ATTACKER"
msgid "%s, I can't believe what I just SAW! Wait, no..."
msgstr "%s, non riesco a credere a quello che ho appena visto! Aspetta, no..."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.WENDY.FIRESTARTER
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.WENDY.FIRESTARTER"
msgid "Should you be setting fires, little buddy?"
msgstr "Sei sicura di dover appiccare incendi, piccola amica?"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.WENDY.GENERIC
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.WENDY.GENERIC"
msgid "%s! Hi little buddy!"
msgstr "%s! Ciao piccino!"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.WENDY.GHOST
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.WENDY.GHOST"
msgid "With a heart you'll be tip-top in no time, %s."
msgstr "Con un cuore sarai in piena forma in un baleno, %s."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.WENDY.MURDERER
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.WENDY.MURDERER"
msgid "Hereeee's Woodie!"
msgstr "Eeeeeecco Woodie!"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.WENDY.REVIVER
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.WENDY.REVIVER"
msgid "%s! You're doin' great, little buddy."
msgstr "%s! Te la stai cavando benissimo, piccola amica."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.WENDY_RESURRECTIONGRAVE
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.WENDY_RESURRECTIONGRAVE"
msgid "Of course I'd remember you, Luce."
msgstr "Certo che mi ricorderei di te, Lucy."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.WEREITEM_BEAVER
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.WEREITEM_BEAVER"
msgid "Think I'm finally getting the hang of this, eh Lucy?"
msgstr "Credo di cominciare a capire come funziona, sai, Lucy?"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.WEREITEM_GOOSE
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.WEREITEM_GOOSE"
msgid "If you can't beat 'em, join 'em."
msgstr "Se non riesci a sconfiggerli, unisciti a loro."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.WEREITEM_MOOSE
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.WEREITEM_MOOSE"
msgid "Not bad, if I do say so mooself."
msgstr "Niente maaaale, se posso dirlo."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.WES.ATTACKER
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.WES.ATTACKER"
msgid "%s could learn some manners..."
msgstr "%s potrebbe imparare le buone maniere..."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.WES.FIRESTARTER
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.WES.FIRESTARTER"
msgid "Keep those flames away from my trees!"
msgstr "Tieni quelle fiamme lontano dai miei alberi!"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.WES.GENERIC
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.WES.GENERIC"
msgid "%s! How ya doin', buddy?"
msgstr "%s! Come va, amico?"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.WES.GHOST
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.WES.GHOST"
msgid "First we'll get you a heart, then we'll get you some bacon, eh %s?"
msgstr "Prima ti procureremo un cuore e dopo della pancetta, eh %s?"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.WES.MURDERER
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.WES.MURDERER"
msgid "You're MIME now, %s!"
msgstr "Sei un MIMO adesso, %s!"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.WES.REVIVER
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.WES.REVIVER"
msgid "%s, you're an alright guy."
msgstr "%s, sei un ragazzo a posto."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.WETGOOP
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.WETGOOP"
msgid "Better than some of the things I've eaten!"
msgstr "Meglio di alcune delle cose che ho mangiato!"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.WETPAPER
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.WETPAPER"
msgid "Damp."
msgstr "Umido."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.WETPOUCH
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.WETPOUCH"
msgid "Doesn't look useful, but I could be wrong."
msgstr "Non sembra utile, ma potrei sbagliarmi."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.WHIP
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.WHIP"
msgid "I hope that doesn't end up hurtin' any lil critters."
msgstr "Mi auguro che quella non finisca col fare del male alle bestioline."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.WICKERBOTTOM.ATTACKER
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.WICKERBOTTOM.ATTACKER"
msgid "%s should read an etiquette book once in awhile."
msgstr "%s dovrebbe leggere un libro di galateo ogni tanto."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.WICKERBOTTOM.FIRESTARTER
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.WICKERBOTTOM.FIRESTARTER"
msgid "Careful around those open flames, Ma'am."
msgstr "Attenzione vicino a quelle fiamme, signora."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.WICKERBOTTOM.GENERIC
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.WICKERBOTTOM.GENERIC"
msgid "%s. Ma'am."
msgstr "%s. Signora."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.WICKERBOTTOM.GHOST
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.WICKERBOTTOM.GHOST"
msgid "You know where I can get a heart, %s?"
msgstr "Sai dove posso trovare un cuore, %s?"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.WICKERBOTTOM.MURDERER
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.WICKERBOTTOM.MURDERER"
msgid "This is gonna be a clear cut!"
msgstr "Farò un taglio netto!"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.WICKERBOTTOM.REVIVER
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.WICKERBOTTOM.REVIVER"
msgid "That's some good work ya did, Ma'am."
msgstr "Hai fatto un bel lavoro, signora."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.WILLOW.ATTACKER
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.WILLOW.ATTACKER"
msgid "You're tempting a forest fire, %s..."
msgstr "Stai tentando di appiccare un incendio nella foresta, %s..."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.WILLOW.FIRESTARTER
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.WILLOW.FIRESTARTER"
msgid "Business as usual, I see."
msgstr "Siamo alle solite, vedo."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.WILLOW.GENERIC
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.WILLOW.GENERIC"
msgid "Look who it is! %s!"
msgstr "Guarda chi è! %s!"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.WILLOW.GHOST
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.WILLOW.GHOST"
msgid "Just don't haunt anything while I look for a heart, %s."
msgstr "Non perseguitare niente mentre cerco un cuore, %s."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.WILLOW.MURDERER
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.WILLOW.MURDERER"
msgid "Here comes the wildfire!"
msgstr "Ecco che arriva il fuoco selvaggio!"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.WILLOW.REVIVER
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.WILLOW.REVIVER"
msgid "You're on fire today, %s. No... actually."
msgstr "Oggi sputi fiamme, %s. No... dico sul serio."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.WILLOW_EMBER
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.WILLOW_EMBER"
msgid "only_used_by_willow"
msgstr "only_used_by_willow"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.WILSON.ATTACKER
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.WILSON.ATTACKER"
msgid "You haven't been very gentlemanly lately, %s."
msgstr "Non sei stato molto signorile di recente, %s."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.WILSON.FIRESTARTER
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.WILSON.FIRESTARTER"
msgid "Was that blaze some sort of experiment, %s?"
msgstr "La fiammata è stata una sorta di esperimento, %s?"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.WILSON.GENERIC
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.WILSON.GENERIC"
msgid "%s! Hey buddy!"
msgstr "%s! Ciao amico!"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.WILSON.GHOST
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.WILSON.GHOST"
msgid "Someone should rub a heart on %s."
msgstr "Qualcuno dovrebbe strofinare un cuore su %s."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.WILSON.MURDERER
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.WILSON.MURDERER"
msgid "Enemy of the forest!"
msgstr "Nemico della foresta!"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.WILSON.REVIVER
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.WILSON.REVIVER"
msgid "%s, you're an alright guy."
msgstr "%s, sei un ragazzo a posto."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.WINCH.GENERIC
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.WINCH.GENERIC"
msgid "Let's see what we can find, eh?"
msgstr "Vediamo cosa riusciamo a trovare, eh?"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.WINCH.HOLDING_ITEM
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.WINCH.HOLDING_ITEM"
msgid "Looks like we got something!"
msgstr "Siamo rimasti a mani vuote!"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.WINCH.RETRIEVING_ITEM
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.WINCH.RETRIEVING_ITEM"
msgid "Reel 'er in!"
msgstr "Portiamolo qui!"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.WINONA.ATTACKER
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.WINONA.ATTACKER"
msgid "%s is getting too big for her britches."
msgstr "%s si sta prendendo troppa confidenza."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.WINONA.FIRESTARTER
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.WINONA.FIRESTARTER"
msgid "%s betrays the forest!"
msgstr "%s tradisce la foresta!"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.WINONA.GENERIC
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.WINONA.GENERIC"
msgid "%s! Hey there bud!"
msgstr "%s! Ehilà, amica!"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.WINONA.GHOST
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.WINONA.GHOST"
msgid "Yer looking a little pale, %s."
msgstr "Sembri un tantino pallida, %s."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.WINONA.MURDERER
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.WINONA.MURDERER"
msgid "You're on the chopping block now, %s!"
msgstr "Sei sull'orlo del precipizio, %s!"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.WINONA.REVIVER
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.WINONA.REVIVER"
msgid "I knew we were gonna get along."
msgstr "Sapevo che saremmo andati d'accordo."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.WINONA_BATTERY_HIGH.BURNING
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.WINONA_BATTERY_HIGH.BURNING"
msgid "Woah! Careful, Lucy!"
msgstr "Ehi! Attenta, Lucy!"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.WINONA_BATTERY_HIGH.BURNT
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.WINONA_BATTERY_HIGH.BURNT"
msgid "That's a right shame."
msgstr "È un vero peccato."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.WINONA_BATTERY_HIGH.GENERIC
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.WINONA_BATTERY_HIGH.GENERIC"
msgid "Pretty odd looking gadget there."
msgstr "Un aggeggio piuttosto strano."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.WINONA_BATTERY_HIGH.LOWPOWER
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.WINONA_BATTERY_HIGH.LOWPOWER"
msgid "Just aboot dead."
msgstr "Praticamente morta."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.WINONA_BATTERY_HIGH.OFF
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.WINONA_BATTERY_HIGH.OFF"
msgid "Plum tuckered."
msgstr "Stanca morta."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.WINONA_BATTERY_HIGH.OVERLOADED
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.WINONA_BATTERY_HIGH.OVERLOADED"
msgid "Worked a little too hard, eh?"
msgstr "Ha lavorato un po' troppo, eh?"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.WINONA_BATTERY_LOW.BURNING
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.WINONA_BATTERY_LOW.BURNING"
msgid "Woah! Careful, Lucy!"
msgstr "Ehi! Attenta, Lucy!"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.WINONA_BATTERY_LOW.BURNT
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.WINONA_BATTERY_LOW.BURNT"
msgid "That's a right shame."
msgstr "È un vero peccato."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.WINONA_BATTERY_LOW.GENERIC
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.WINONA_BATTERY_LOW.GENERIC"
msgid "Looks like Winona's work."
msgstr "Sembra l'opera di Winona."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.WINONA_BATTERY_LOW.LOWPOWER
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.WINONA_BATTERY_LOW.LOWPOWER"
msgid "Just aboot dead."
msgstr "Praticamente morta."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.WINONA_BATTERY_LOW.OFF
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.WINONA_BATTERY_LOW.OFF"
msgid "Plum tuckered."
msgstr "Stanca morta."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.WINONA_CATAPULT.BURNING
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.WINONA_CATAPULT.BURNING"
msgid "Woah! Careful, Lucy!"
msgstr "Ehi! Attenta, Lucy!"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.WINONA_CATAPULT.BURNT
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.WINONA_CATAPULT.BURNT"
msgid "That's a right shame."
msgstr "È un vero peccato."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.WINONA_CATAPULT.GENERIC
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.WINONA_CATAPULT.GENERIC"
msgid "Looks kinda fun if I'm honest."
msgstr "Sembra buffa ad essere onesti."

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.WINONA_CATAPULT.OFF
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.WINONA_CATAPULT.OFF"
msgid "Does it look like it's working, Lucy?"
msgstr "Sembra che funzioni, Lucy?"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.WINONA_CATAPULT.SLEEP
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.WINONA_CATAPULT.SLEEP"
msgid "Looks kinda fun if I'm honest."
msgstr "Sembra buffa ad essere onesti."

