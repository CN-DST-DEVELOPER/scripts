msgstr "Non riesco a distogliere lo sguardo!"

#. STRINGS.CHARACTERS.WOODIE.DESCRIBE.SPIDERQUEENCORPSE.GENERIC
msgctxt "STRINGS.CHARACTERS.WOODIE.DESCRIBE.SPIDERQUEENCORPSE.GENERIC"
