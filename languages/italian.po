msgstr "Vinceremo noi di sicuro!"

#. STRINGS.CHARACTERS.WEBBER.DESCRIBE.YOTC_CARRAT_RACE_START_ITEM
msgctxt "STRINGS.CHARACTERS.WEBBER.DESCRIBE.YOTC_CARRAT_RACE_START_ITEM"
