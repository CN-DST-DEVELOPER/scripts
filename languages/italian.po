msgstr "Ci si può salire?"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.MASTUPGRADE_LAMP_ITEM
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.MASTUPGRADE_LAMP_ITEM"
msgid "Alternatively, I could just set the mast on fire."
msgstr "In alternativa, potrei dare fuoco all'albero maestro."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.MASTUPGRADE_LAMP_ITEM_YOTD
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.MASTUPGRADE_LAMP_ITEM_YOTD"
msgid "Alternatively, I could just set the mast on fire."
msgstr "In alternativa, potrei dare fuoco all'albero maestro."

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.MASTUPGRADE_LAMP_YOTD
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.MASTUPGRADE_LAMP_YOTD"
