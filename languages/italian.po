msgstr "Ehi, cosa hai per me?"

#. STRINGS.CHARACTERS.WILLOW.DESCRIBE.QUAGMIRE_TRADER_MERM2
msgctxt "STRINGS.CHARACTERS.WILLOW.DESCRIBE.QUAGMIRE_TRADER_MERM2"
