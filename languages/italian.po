msgstr "È dura come la pietra."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.STONE_CHAIR.OCCUPIED
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.STONE_CHAIR.OCCUPIED"
msgid "Somebody else is sitting on that."
msgstr "Qualcuno la sta già usando."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.STONE_TABLE.GENERIC
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.STONE_TABLE.GENERIC"
msgid "I use tables periodically."
msgstr "Uso le tavole periodicamente."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.STONE_TABLE.HAS_ITEM
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.STONE_TABLE.HAS_ITEM"
msgid "I use tables periodically."
msgstr "Uso le tavole periodicamente."

#. STRINGS.CHARACTERS.GENERIC.DESCRIBE.STORAGE_ROBOT.BROKEN
msgctxt "STRINGS.CHARACTERS.GENERIC.DESCRIBE.STORAGE_ROBOT.BROKEN"
