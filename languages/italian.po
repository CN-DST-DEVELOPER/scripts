msgstr "Un bell'alberello."

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.TREE_ROCK_SEED
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.TREE_ROCK_SEED"
msgid "First we plant, then we harvest."
msgstr "Prima piantiamo, poi raccogliamo."

#. STRINGS.CHARACTERS.WARLY.DESCRIBE.TRIDENT
msgctxt "STRINGS.CHARACTERS.WARLY.DESCRIBE.TRIDENT"
