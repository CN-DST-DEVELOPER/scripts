#. STRINGS.LAVAARENA_CHARACTER_DESCRIPTIONS.walter
msgctxt "STRINGS.LAVAARENA_CHARACTER_DESCRIPTIONS.walter"
msgid "*PLACEHOLDER\n\n\n\nExpertise:\nPLACEHOLDER"
msgstr "*PLACEHOLDER\n\n\n\nSpecialità:\nPLACEHOLDER"

#. STRINGS.LAVAARENA_CHARACTER_DESCRIPTIONS.wanda
msgctxt "STRINGS.LAVAARENA_CHARACTER_DESCRIPTIONS.wanda"
msgid "*PLACEHOLDER\n\n\n\nExpertise:\nPLACEHOLDER"
msgstr "*PLACEHOLDER\n\n\n\nSpecialità:\nPLACEHOLDER"

#. STRINGS.LAVAARENA_CHARACTER_DESCRIPTIONS.warly
msgctxt "STRINGS.LAVAARENA_CHARACTER_DESCRIPTIONS.warly"
msgid "*PLACEHOLDER\n\n\n\nExpertise:\nPLACEHOLDER"
msgstr "*PLACEHOLDER\n\n\n\nSpecialità:\nPLACEHOLDER"

#. STRINGS.LAVAARENA_CHARACTER_DESCRIPTIONS.wathgrithr
msgctxt "STRINGS.LAVAARENA_CHARACTER_DESCRIPTIONS.wathgrithr"
msgid "*Battle cries increase nearby allies' next attack damage by 25%\n*Gains less aggro when attacking\n\nExpertise:\nMelee, Darts"
msgstr "Le grida di battaglia aumentano il danno dell'attacco successivo degli alleati del 25%\n*Ottiene meno aggressività quando attacca\n\n*Specialità:\nAttacchi ravvicinati, dardi"

#. STRINGS.LAVAARENA_CHARACTER_DESCRIPTIONS.waxwell
msgctxt "STRINGS.LAVAARENA_CHARACTER_DESCRIPTIONS.waxwell"
msgid "*Summons Shadow Duelists after focusing attacks on a single target\n\n\nExpertise:\nBooks, Staves"
msgstr "*Evoca i Duellanti d'ombra dopo aver concentrato gli attacchi su un solo obiettivo\n\n\nSpecialità:\nLibri, bastoni"

#. STRINGS.LAVAARENA_CHARACTER_DESCRIPTIONS.webber
msgctxt "STRINGS.LAVAARENA_CHARACTER_DESCRIPTIONS.webber"
msgid "*Accompanied by itsy bitsy spiders\n\n\n\nExpertise:\nDarts"
msgstr "*Accompagnato da ragni minuscoli\n\n\n\nSpecialità:\nDardi"

#. STRINGS.LAVAARENA_CHARACTER_DESCRIPTIONS.wendy
msgctxt "STRINGS.LAVAARENA_CHARACTER_DESCRIPTIONS.wendy"
msgid "*Protected by her twin sister, Abigail\n\n\n\nExpertise:\nDarts, Staves"
msgstr "*Protetta dalla sorella gemella, Abigail\n\n\n\nSpecialità:\nDardi, bastoni"

#. STRINGS.LAVAARENA_CHARACTER_DESCRIPTIONS.wes
msgctxt "STRINGS.LAVAARENA_CHARACTER_DESCRIPTIONS.wes"
msgid "*Can be revived twice as quickly\n*Gains minimal aggro when attacking\n*Less likely to lose aggro once drawn\n\nExpertise:\nMelee, Darts, Staves"
msgstr "*Può essere rianimato in metà del tempo\n*Ottiene un'aggressività minima quando attacca\n*È meno probabile che perda aggressività una volta lanciato\n\nSpecialità:\nAttacchi ravvicinati, dardi, bastoni"

#. STRINGS.LAVAARENA_CHARACTER_DESCRIPTIONS.wickerbottom
msgctxt "STRINGS.LAVAARENA_CHARACTER_DESCRIPTIONS.wickerbottom"
msgid "*Gains a buff after dealing sufficient damage, amplifying her next spell\n\n\nExpertise:\nBooks, Staves"
msgstr "*Ottiene un potenziamento dopo aver inflitto abbastanza danni, amplificando la sua magia successiva\n\n\nSpecialità:\nLibri, bastoni"

#. STRINGS.LAVAARENA_CHARACTER_DESCRIPTIONS.willow
msgctxt "STRINGS.LAVAARENA_CHARACTER_DESCRIPTIONS.willow"
msgid "*Protected by Bernie the Bear\n*Fire and Explosive attack damage increased by 10%\n\nExpertise:\nDarts, Staves"
msgstr "*Protetta dall'orsacchiotto Bernie\n*Danno degli attacchi di fuoco e degli esplosivi aumentato del 10%\n\nSpecialità:\nDardi, bastoni"

#. STRINGS.LAVAARENA_CHARACTER_DESCRIPTIONS.wilson
msgctxt "STRINGS.LAVAARENA_CHARACTER_DESCRIPTIONS.wilson"
msgid "*Revives allies twice as quickly\n*Restores three times more health when reviving allies\n\nExpertise:\nMelee, Darts, Staves"
msgstr "*Resuscita gli alleati al doppio della velocità\n*Ripristina tre volte più salute quando resuscita gli alleati\n\nSpecialità:\nAttacchi ravvicinati, dardi, bastoni"

#. STRINGS.LAVAARENA_CHARACTER_DESCRIPTIONS.winona
msgctxt "STRINGS.LAVAARENA_CHARACTER_DESCRIPTIONS.winona"
msgid "*All ability cooldowns are 10% faster\n\n\n\nExpertise:\nMelee, Darts, Staves"
msgstr "*Il recupero di tutte le abilità è aumentato del 10%\n\n\n\nEsperienza:\nattacchi ravvicinati, dardi, bastoni"

#. STRINGS.LAVAARENA_CHARACTER_DESCRIPTIONS.wolfgang
msgctxt "STRINGS.LAVAARENA_CHARACTER_DESCRIPTIONS.wolfgang"
msgid "*Becomes Mighty when health is low, increasing attack power, defense, and movement speed for 10 seconds\n\nExpertise:\nMelee"
msgstr "*Diventa possente quando la salute è bassa, aumentando il potere di attacco, di difesa e la velocità di movimento per 10 secondi\n\nSpecialità:\nAttacchi ravvicinati"

#. STRINGS.LAVAARENA_CHARACTER_DESCRIPTIONS.wonkey
msgctxt "STRINGS.LAVAARENA_CHARACTER_DESCRIPTIONS.wonkey"
msgid "PLACEHOLDER\n\n\n\nExpertise:\nPLACEHOLDER"
msgstr "PLACEHOLDER\n\n\n\nSpecialità:\nPLACEHOLDER"

